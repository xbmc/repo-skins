<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.majan" version="1.0.23" name="Majan" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional: artwork-background blur service (SPEC section 8). The skin runs without it. -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
		<import addon="script.embuary.helper" version="2.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Majan - an editorial index for your library.</summary>
		<description lang="en_GB">A near-black page, one accent colour, big type and hairlines. Built for movies, TV shows and music on the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#majan</website>
		<news>v1.0.23 - Coming back to a Home section no longer blanks and reloads its rows. Empty pages say so. Series get the Unwatched button. Cleaner settings pages, keyboard, audio panel and playback buttons. All text is now translatable.&#10;v1.0.22 - Counts read "1 season", "1 film", "1 result" instead of the plural. Smaller download: removed images the skin never used.</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
			<screenshot>resources/screenshot-06.jpg</screenshot>
		</assets>
	</extension>
</addon>
