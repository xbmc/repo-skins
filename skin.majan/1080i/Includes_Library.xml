<?xml version="1.0" encoding="UTF-8"?>
<!--
	Library panel and view picker (request docs/requests/library-panel/BRIEF.md, 1.0.9).
	  Custom_1155_LibraryPanel  numbered Index panel (Dlg_IndexListLayout) under the header's OPTIONS word:
	                            Update library, Clean library, View, Sort, Order, Show, Sets (films only), Search,
	                            Library settings
	                            (only what applies). Also Left past the first item / Right past the last one in
	                            every library view.
	  Custom_1156_ViewPicker    the window's views as schematic previews (media/majan/views, generated by
	                            _src/make_view_previews.py), the accent pieces tinted with the chosen accent.
	                            Opened by VIEW: in the header and the panel's View row.
	  Custom_1157_LibraryTask   Update / Clean with the choice of library and the confirmation (Kodi's
	                            CleanLibrary() builtin cleans without asking). Home's System menu opens it too.
	  The three files are written by _src/make_library_dialogs.py.
	Inside a dialog Container.* and Window.IsVisible() read the media window underneath; Control.* reads the
	dialog, so nothing here tests view controls.
	Properties on Window(Home): majan.libtask (update | clean), majan.libtarget (video | music | choose).
-->
<includes>
	<expression name="MJ_LibInMusic">Window.IsVisible(music)</expression>
	<expression name="MJ_LibCanUpdate">!Container.Content(addons) + String.IsEmpty(Container.PluginName)</expression>
	<expression name="MJ_LibScanning">[Window.IsVisible(music) + Library.IsScanningMusic] | [!Window.IsVisible(music) + Library.IsScanningVideo]</expression>
	<!-- Sets row (1.0.10): films in the library (not inside a set already, not a plug-in folder) and the library has sets -->
	<expression name="MJ_LibShowSets">Window.IsVisible(videos) + [Container.Content(movies) | String.IsEqual(Container.FolderPath,videodb://movies/) | String.IsEqual(Container.FolderPath,library://video/movies/)] + !String.StartsWith(Container.FolderPath,videodb://movies/sets/) + String.IsEmpty(Container.PluginName) + Library.HasContent(moviesets)</expression>
	<expression name="MJ_LibHasWatchedFilter">Window.IsVisible(videos) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)] + !String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</expression>

	<variable name="MJ_LibCaption">
		<value condition="$EXP[MJ_LibInMusic]">$LOCALIZE[31318]$INFO[Container.NumItems,  ·  ,]</value>
		<value>[UPPERCASE]$VAR[VidView_Title][/UPPERCASE]$INFO[Container.NumItems,  ·  ,]</value>
	</variable>
	<variable name="MJ_LibUpdateLabel">
		<value condition="$EXP[MJ_LibScanning]">$LOCALIZE[31677]</value>
		<value>$LOCALIZE[31200]</value>
	</variable>
	<variable name="MJ_LibUpdateHint">
		<value condition="$EXP[MJ_LibScanning]">$LOCALIZE[31678]</value>
		<value condition="$EXP[MJ_LibInMusic]">$LOCALIZE[31318]</value>
		<value>$LOCALIZE[31679]</value>
	</variable>
	<variable name="MJ_LibOrderHint">
		<value condition="Container.SortDirection(descending)">$LOCALIZE[31680]</value>
		<value>$LOCALIZE[31681]</value>
	</variable>
	<variable name="MJ_LibShowHint">
		<value condition="System.Setting(hidewatched)">$LOCALIZE[31421]</value>
		<value>$LOCALIZE[31418]</value>
	</variable>

	<!-- task card (1157) -->
	<variable name="MJ_TaskHeading">
		<value condition="String.IsEqual(Window(Home).Property(majan.libtask),clean) + String.IsEqual(Window(Home).Property(majan.libtarget),video)">$LOCALIZE[31682]</value>
		<value condition="String.IsEqual(Window(Home).Property(majan.libtask),clean) + String.IsEqual(Window(Home).Property(majan.libtarget),music)">$LOCALIZE[31683]</value>
		<value condition="String.IsEqual(Window(Home).Property(majan.libtask),clean)">$LOCALIZE[31684]</value>
		<value>$LOCALIZE[31685]</value>
	</variable>
	<variable name="MJ_TaskBody">
		<value condition="String.IsEqual(Window(Home).Property(majan.libtask),clean)">$LOCALIZE[31686]</value>
		<value>$LOCALIZE[31687]</value>
	</variable>
	<variable name="MJ_TaskUpdateVideo">
		<value condition="Library.IsScanningVideo">$LOCALIZE[31688]</value>
		<value>$LOCALIZE[31689]</value>
	</variable>
	<variable name="MJ_TaskUpdateMusic">
		<value condition="Library.IsScanningMusic">$LOCALIZE[31690]</value>
		<value>$LOCALIZE[31691]</value>
	</variable>

	<!-- view picker: the mark on the view on show (ListItem.Property(key) of the static items) -->
	<expression name="MJ_PickIsList">!String.IsEqual(Container.Viewmode,$LOCALIZE[31306]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31307]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31308]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31309]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31310]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31312]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31313]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31322]) + !String.IsEqual(Container.Viewmode,$LOCALIZE[31323])</expression>
	<expression name="MJ_PickCurrent">[String.IsEqual(ListItem.Property(key),showcase) + String.IsEqual(Container.Viewmode,$LOCALIZE[31306])] | [String.IsEqual(ListItem.Property(key),bigposter) + String.IsEqual(Container.Viewmode,$LOCALIZE[31307])] | [String.IsEqual(ListItem.Property(key),tvwall) + String.IsEqual(Container.Viewmode,$LOCALIZE[31308])] | [String.IsEqual(ListItem.Property(key),episodes) + String.IsEqual(Container.Viewmode,$LOCALIZE[31309])] | [String.IsEqual(ListItem.Property(key),posterwall) + String.IsEqual(Container.Viewmode,$LOCALIZE[31310])] | [String.IsEqual(ListItem.Property(key),grid) + String.IsEqual(Container.Viewmode,$LOCALIZE[31312])] | [String.IsEqual(ListItem.Property(key),bigalbum) + String.IsEqual(Container.Viewmode,$LOCALIZE[31313])] | [String.IsEqual(ListItem.Property(key),bigstill) + String.IsEqual(Container.Viewmode,$LOCALIZE[31307])] | [String.IsEqual(ListItem.Property(key),rows) + String.IsEqual(Container.Viewmode,$LOCALIZE[31309])] | [String.IsEqual(ListItem.Property(key),stills) + String.IsEqual(Container.Viewmode,$LOCALIZE[31322])] | [String.IsEqual(ListItem.Property(key),tracklist) + String.IsEqual(Container.Viewmode,$LOCALIZE[31323])] | [String.IsEqual(ListItem.Property(key),list) + $EXP[MJ_PickIsList]]</expression>

	<include name="MJ_PickLayouts">
		<itemlayout width="296" height="236">
			<control type="image">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<texture>$INFO[ListItem.Icon]</texture>
			</control>
			<control type="image">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<texture colordiffuse="$VAR[ColorAccent]">$INFO[ListItem.Property(accent)]</texture>
			</control>
			<control type="label">
				<left>20</left>
				<top>176</top>
				<width>256</width>
				<height>36</height>
				<font>label_25_semibold</font>
				<textcolor>text_secondary</textcolor>
				<selectedcolor>text_secondary</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="image">
				<left>20</left>
				<top>220</top>
				<width>256</width>
				<height>3</height>
				<texture colordiffuse="$VAR[ColorAccent]">common/white.png</texture>
				<visible>$EXP[MJ_PickCurrent]</visible>
			</control>
		</itemlayout>
		<focusedlayout width="296" height="236">
			<control type="image">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<texture>$INFO[ListItem.Icon]</texture>
			</control>
			<control type="image">
				<left>20</left>
				<top>20</top>
				<width>256</width>
				<height>144</height>
				<texture colordiffuse="$VAR[ColorAccent]">$INFO[ListItem.Property(accent)]</texture>
			</control>
			<!-- Majan's focus outline (always on here: the picker has no other focus mark) -->
			<control type="image">
				<left>13</left>
				<top>13</top>
				<width>270</width>
				<height>158</height>
				<texture border="16" colordiffuse="$VAR[ColorAccent]">$VAR[FocusFrameAlways]</texture>
				<visible>Control.HasFocus(100)</visible>
				<include>Anim_FocusFrame</include>
			</control>
			<control type="label">
				<left>20</left>
				<top>176</top>
				<width>256</width>
				<height>36</height>
				<font>label_25_bold</font>
				<textcolor>text_primary</textcolor>
				<selectedcolor>text_primary</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="image">
				<left>20</left>
				<top>220</top>
				<width>256</width>
				<height>3</height>
				<texture colordiffuse="$VAR[ColorAccent]">common/white.png</texture>
				<visible>$EXP[MJ_PickCurrent]</visible>
			</control>
		</focusedlayout>
	</include>
</includes>
