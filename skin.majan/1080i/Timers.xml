<?xml version="1.0" encoding="UTF-8"?>
<!--
	Majan timers (Kodi 21: <start> condition + <onstart> builtins). Conditions are written out in full: timers don't
	expand $EXP. Modal dialogs guarded: timers evaluate against the focused window (LESSONS, Fold 0.9.7).
-->
<timers>
	<!-- A library page that empties while open (Unwatched on, with Kodi's parent-folder item off): the window's onload
	     has already run, so nothing has focus and the view can't take it. Hand focus to the header bar. -->
	<timer>
		<name>majan_page_focus</name>
		<start reset="true">[Window.IsActive(videos) | Window.IsActive(music)] + String.IsEmpty(System.CurrentControlId) + !Container.IsUpdating + !System.HasActiveModalDialog</start>
		<stop>!String.IsEmpty(System.CurrentControlId) | ![Window.IsActive(videos) | Window.IsActive(music)]</stop>
		<onstart>SetFocus(9000)</onstart>
	</timer>
</timers>
