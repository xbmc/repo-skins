<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Focus language everywhere: accent 2px frame (focus/outline_2.png, border 16) or accent fill.
	Colours are names from colors/defaults.xml; $VAR[ColorAccent] = live accent (setting 1).
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>text_primary</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<selectedcolor>text_primary</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>text_primary</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>text_body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="$VAR[ColorAccent]">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[ColorAccent]">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="text_tertiary">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="border_control">common/rect_outline_1.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="disabled">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="10" colordiffuse="disabled">common/rect_outline_1.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="text_tertiary">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="text_tertiary" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ColorAccent]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ColorAccent]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="text_tertiary">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="text_tertiary" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ColorAccent]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ColorAccent]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="hairline_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hairline">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="text_secondary">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ColorAccent]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="hairline_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hairline">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="text_secondary">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ColorAccent]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>text_secondary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="disabled">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>text_primary</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<invalidcolor>accent_signal</invalidcolor>
		<texturefocus border="16" colordiffuse="$VAR[ColorAccent]">focus/outline_2.png</texturefocus>
		<texturenofocus border="10" colordiffuse="border_control">common/rect_outline_1.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="hairline_strong">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="$VAR[ColorAccent]">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="hairline">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="text_tertiary">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="$VAR[ColorAccent]">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
