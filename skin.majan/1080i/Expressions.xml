<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin setting names are documented in docs/skin.majan/SETTINGS.md.
	Rule (SPEC section 7): an empty string / unset bool always means the default.
-->
<includes>
	<!-- Helpers -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting 2: corners -->
	<expression name="IsRounded">Skin.HasSetting(majan.roundedcorners)</expression>

	<!-- Setting 3: focus outline (empty or thin = thin) -->
	<expression name="FocusOutlineOff">String.IsEqual(Skin.String(majan.focusoutline),off)</expression>
	<expression name="FocusOutlineMedium">String.IsEqual(Skin.String(majan.focusoutline),medium)</expression>

	<!-- Setting 4: artwork background (empty = faint). Forced off without TMDb Helper. Wired in M2 (T15). -->
	<expression name="ArtBackgroundOn">!String.IsEqual(Skin.String(majan.artbackground),off) + System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting 5: trailer button -->
	<expression name="ShowTrailerButton">!Skin.HasSetting(majan.hidetrailer)</expression>

	<!-- Setting 6: watched indicators (empty or both = both) -->
	<expression name="ShowUnwatchedMarkers">String.IsEmpty(Skin.String(majan.watchedmarkers)) | String.IsEqual(Skin.String(majan.watchedmarkers),both) | String.IsEqual(Skin.String(majan.watchedmarkers),unwatched)</expression>
	<expression name="ShowWatchedMarkers">String.IsEmpty(Skin.String(majan.watchedmarkers)) | String.IsEqual(Skin.String(majan.watchedmarkers),both) | String.IsEqual(Skin.String(majan.watchedmarkers),watched)</expression>

	<!-- Setting 7: spotlight rotation (empty = 15 s). Wired in M2 (T12). -->
	<expression name="SpotlightRotateOff">String.IsEqual(Skin.String(majan.spotlightrotate),off)</expression>

	<!-- Setting 8: reduce motion -->
	<expression name="ReduceMotion">Skin.HasSetting(majan.reducemotion)</expression>

	<!-- Setting 9 (Omar, 2026-10-18): Home newest row. empty or added = date added, release, both -->
	<expression name="HomeNewestDateAdded">!String.IsEqual(Skin.String(majan.home.newest),release)</expression>
	<expression name="HomeNewestRelease">String.IsEqual(Skin.String(majan.home.newest),release) | String.IsEqual(Skin.String(majan.home.newest),both)</expression>
	<expression name="HomeNewestBoth">String.IsEqual(Skin.String(majan.home.newest),both)</expression>

	<!-- Items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>

	<!-- Windows -->
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>
</includes>
