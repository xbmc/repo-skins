<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml (never hex in windows).
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->

	<!-- Setting 1: accent. Skin.String(majan.accent) stores a keyword; empty = Signal.
	     A raw AARRGGBB value is also accepted (last-but-one line) so a hand-set hex never breaks. -->
	<variable name="ColorAccent">
		<value condition="String.IsEqual(Skin.String(majan.accent),cobalt)">accent_cobalt</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),mint)">accent_mint</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),amber)">accent_amber</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),rose)">accent_rose</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),ice)">accent_ice</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),bone)">accent_bone</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),signal) | String.IsEmpty(Skin.String(majan.accent))">accent_signal</value>
		<value condition="String.StartsWith(Skin.String(majan.accent),ff)">$INFO[Skin.String(majan.accent)]</value>
		<value>accent</value>
	</variable>

	<!-- Display name of the accent (settings stub) -->
	<variable name="AccentName">
		<value condition="String.IsEqual(Skin.String(majan.accent),cobalt)">$LOCALIZE[31061]</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),mint)">$LOCALIZE[31062]</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),amber)">$LOCALIZE[31063]</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),rose)">$LOCALIZE[31064]</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),ice)">$LOCALIZE[31065]</value>
		<value condition="String.IsEqual(Skin.String(majan.accent),bone)">$LOCALIZE[31066]</value>
		<value>$LOCALIZE[31060]</value>
	</variable>

	<!-- Rules: solid greys on the flat page, white-alpha over the artwork background (DESIGN 2.2) -->
	<variable name="ColorRule">
		<value condition="$EXP[ArtBackgroundOn]">hairline_art</value>
		<value>hairline</value>
	</variable>
	<variable name="ColorRuleStrong">
		<value condition="$EXP[ArtBackgroundOn]">hairline_art_strong</value>
		<value>hairline_strong</value>
	</variable>
	<!-- Mono captions: promoted to text_secondary over artwork (DESIGN 2.5) -->
	<variable name="ColorCaption">
		<value condition="$EXP[ArtBackgroundOn]">text_secondary</value>
		<value>text_tertiary</value>
	</variable>

	<!-- ==================================================================== textures -->

	<!-- Focus frame (setting 3 x setting 2). Empty when the outline is Off. 40x40, border 16,
	     placed at item rect +7px each side (constant focus_out). -->
	<variable name="FocusFrame">
		<value condition="$EXP[FocusOutlineOff]"></value>
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>
	<!-- Frames for controls that must ALWAYS show focus (buttons, dialogs): never empty -->
	<variable name="FocusFrameAlways">
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>

	<!-- Button fill / outline (32x32, border 10) -->
	<variable name="ButtonFill">
		<value condition="$EXP[IsRounded]">common/rect_round8.png</value>
		<value>common/rect_square.png</value>
	</variable>
	<variable name="ButtonOutline">
		<value condition="$EXP[IsRounded]">common/rect_outline_1_round8.png</value>
		<value>common/rect_outline_1.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="DateLabel">
		<value>$INFO[System.Date(DDD)] $INFO[System.Date(d MMM)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>

	<!-- Home spotlight (data list 9101) -->
	<variable name="SpotlightArt">
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(fanart))">$INFO[Container(9101).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(landscape))">$INFO[Container(9101).ListItem.Art(landscape)]</value>
		<value>$INFO[Container(9101).ListItem.Art(poster)]</value>
	</variable>
	<variable name="SpotlightRuntime">
		<value condition="Integer.IsGreater(Container(9101).ListItem.Duration(h),0)">$INFO[Container(9101).ListItem.Duration(h),,h ]$INFO[Container(9101).ListItem.Duration(m),,m]</value>
		<value>$INFO[Container(9101).ListItem.Duration(m),,m]</value>
	</variable>

	<!-- Kodi stores US certifications as "Rated PG-13" (DATA.md 4.1): show the bare code -->
	<variable name="SpotlightMPAA">
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(Container(9101).ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value>$INFO[Container(9101).ListItem.MPAA]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- ============================================================ skin settings -->
	<variable name="LabelFocusOutline">
		<value condition="String.IsEqual(Skin.String(majan.focusoutline),medium)">$LOCALIZE[31071]</value>
		<value condition="String.IsEqual(Skin.String(majan.focusoutline),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31070]</value>
	</variable>
	<variable name="LabelWatchedMarkers">
		<value condition="String.IsEqual(Skin.String(majan.watchedmarkers),unwatched)">$LOCALIZE[31081]</value>
		<value condition="String.IsEqual(Skin.String(majan.watchedmarkers),watched)">$LOCALIZE[31082]</value>
		<value condition="String.IsEqual(Skin.String(majan.watchedmarkers),off)">$LOCALIZE[31072]</value>
		<value>$LOCALIZE[31080]</value>
	</variable>
</includes>
