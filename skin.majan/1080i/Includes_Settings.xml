	<!-- Segmented control, DESIGN 7.7: 1px border_control frame; selected option filled bone with
	     bold ink text (accent fill when the row has focus); others regular text_secondary.
	     Dlg_SegOption params: left, width, label, selected (condition), row (row button id)
	     Dlg_SegFrame params: left, width (draw AFTER the options) -->
	<include name="Dlg_SegOption">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>25</top>
				<width>$PARAM[width]</width>
				<height>50</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<texture border="10" colordiffuse="text_primary">$VAR[ButtonFill]</texture>
					<visible>[$PARAM[selected]] + !Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<texture border="10" colordiffuse="$VAR[ColorAccent]">$VAR[ButtonFill]</texture>
					<visible>[$PARAM[selected]] + Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<align>center</align>
					<font>card_21_bold</font>
					<textcolor>ink</textcolor>
					<label>$PARAM[label]</label>
					<visible>$PARAM[selected]</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>50</height>
					<align>center</align>
					<font>card_21</font>
					<textcolor>text_secondary</textcolor>
					<label>$PARAM[label]</label>
					<visible>![$PARAM[selected]]</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="Dlg_SegFrame">
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>25</top>
				<width>$PARAM[width]</width>
				<height>50</height>
				<texture border="10" colordiffuse="border_control">$VAR[ButtonOutline]</texture>
			</control>
		</definition>
	</include>

	<!-- Accent swatch (36px) with a 2px bone ring 4px out when it is the current accent.
	     params: left, color (named colour), selected (condition) -->
	<include name="Dlg_Swatch">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>32</top>
				<width>36</width>
				<height>36</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>36</width>
					<height>36</height>
					<texture border="10" colordiffuse="$PARAM[color]">$VAR[ButtonFill]</texture>
				</control>
				<control type="image">
					<left>focus_out</left>
					<top>focus_out</top>
					<width>50</width>
					<height>50</height>
					<texture border="16" colordiffuse="text_primary">$VAR[FocusFrameAlways]</texture>
					<visible>$PARAM[selected]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ SkinSettings expressions -->
	<expression name="Dlg_AccentSignal">String.IsEmpty(Skin.String(majan.accent)) | String.IsEqual(Skin.String(majan.accent),signal) | [!String.IsEqual(Skin.String(majan.accent),cobalt) + !String.IsEqual(Skin.String(majan.accent),mint) + !String.IsEqual(Skin.String(majan.accent),amber) + !String.IsEqual(Skin.String(majan.accent),rose) + !String.IsEqual(Skin.String(majan.accent),ice) + !String.IsEqual(Skin.String(majan.accent),bone)]</expression>
	<expression name="Dlg_OutlineThin">!String.IsEqual(Skin.String(majan.focusoutline),medium) + !String.IsEqual(Skin.String(majan.focusoutline),off)</expression>
	<expression name="Dlg_ArtOff">!System.AddonIsEnabled(plugin.video.themoviedb.helper) | String.IsEqual(Skin.String(majan.artbackground),off)</expression>
	<expression name="Dlg_ArtFaint">System.AddonIsEnabled(plugin.video.themoviedb.helper) + [String.IsEmpty(Skin.String(majan.artbackground)) | String.IsEqual(Skin.String(majan.artbackground),faint)]</expression>
	<expression name="Dlg_ArtSoft">System.AddonIsEnabled(plugin.video.themoviedb.helper) + String.IsEqual(Skin.String(majan.artbackground),soft)</expression>
	<expression name="Dlg_ArtVisible">System.AddonIsEnabled(plugin.video.themoviedb.helper) + String.IsEqual(Skin.String(majan.artbackground),visible)</expression>
	<expression name="Dlg_WatchedBoth">String.IsEmpty(Skin.String(majan.watchedmarkers)) | String.IsEqual(Skin.String(majan.watchedmarkers),both)</expression>
	<expression name="Dlg_OffsetBottom">String.IsEqual(Skin.String(majan.offsetbar),bottom)</expression>
	<expression name="Dlg_NewestAdded">!String.IsEqual(Skin.String(majan.home.newest),release) + !String.IsEqual(Skin.String(majan.home.newest),both)</expression>
	<expression name="Dlg_OSDHide5">!String.IsEqual(Skin.String(majan.osdhide),off) + !String.IsEqual(Skin.String(majan.osdhide),3) + !String.IsEqual(Skin.String(majan.osdhide),10)</expression>
	<expression name="Dlg_Rotate15">!String.IsEqual(Skin.String(majan.spotlightrotate),off) + !String.IsEqual(Skin.String(majan.spotlightrotate),8) + !String.IsEqual(Skin.String(majan.spotlightrotate),30)</expression>

