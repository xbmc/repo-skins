			<onleft>ActivateWindow(1155)</onleft>
			<onright>ActivateWindow(1155)</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<preloaditems>2</preloaditems>
			<viewtype label="31313">wrap</viewtype>
			<!-- 1.0.18: artists (their photo, fanart stage) and songs (the album cover) too -->
			<visible>Container.Content(albums) | Container.Content(artists) | Container.Content(songs)</visible>
			<include>Anim_FadeVisible</include>
			<itemlayout width="408" height="668">
				<include content="Music_BigItem">
