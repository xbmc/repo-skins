				<control type="label">
					<left>0</left>
					<top>180</top>
					<width>1320</width>
					<height>26</height>
					<font>mono_13</font>
					<textcolor>text_tertiary</textcolor>
					<label>$VAR[Music_BigFootline]</label>
				</control>
			</control>
		</control>
	</include>

	<!-- ================================================================== 50 List -->
