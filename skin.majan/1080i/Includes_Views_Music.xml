<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library views (Builder C, SPEC 6). Listed in MyMusicNav <views>50,504,505</views>.
	  50  List      - songs, genres, years, roots, playlists, files (always valid: generic fallback)
	  504 Grid      - albums, artists (Music.dc.html): 7 columns of square covers + title / artist
	  505 Big album - albums (MusicStage.dc.html): 380 squares, focus fixed in slot 2, zoom 5 %,
	                  passed slot dimmed .45, slots ahead .80 by fixed-slot overlays (covers opaque),
	                  artist fanart stage behind
	The ".." parent item (Omar has filelists.showparentdiritems on) is a hairline back tile labelled Back.
	Each container gates itself with Container.Content so VIEW only cycles valid views.
	Back is Kodi's: up a folder / back through tab history (Container.Update keeps history), and
	out of the window at the start node.
-->
<includes>
	<!-- ================================================================ 504 Grid -->
	<include name="Music_GridItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>music_pad</left>
				<top>music_pad</top>
				<width>music_tile</width>
				<height>music_tile</height>
				<include condition="$PARAM[focused]">Anim_FocusZoom</include>
				<include content="Music_Cover">
					<param name="mask_round" value="masks/square_round8.png"/>
					<param name="parent_icon" value="48"/>
					<param name="parent_caption" value="true"/>
				</include>
				<include content="Majan_FocusFrame" condition="$PARAM[focused]">
					<param name="visible" value="Control.HasFocus(504)"/>
				</include>
			</control>
			<control type="label">
				<left>music_pad</left>
				<top>245</top>
				<width>music_tile</width>
				<height>25</height>
				<font>small_19_bold</font>
				<textcolor>text_primary</textcolor>
				<scroll>$PARAM[focused]</scroll>
				<label>$VAR[Music_ItemLabel]</label>
			</control>
			<control type="label">
				<left>music_pad</left>
				<top>273</top>
				<width>music_tile</width>
				<height>21</height>
				<font>small_16</font>
				<textcolor>text_secondary</textcolor>
				<label>$INFO[ListItem.Artist]</label>
				<visible>!String.IsEqual(ListItem.DBType,artist) + !ListItem.IsParentFolder</visible>
			</control>
			<control type="label">
				<left>music_pad</left>
				<top>273</top>
				<width>music_tile</width>
				<height>21</height>
				<font>small_16</font>
				<textcolor>text_secondary</textcolor>
				<label>$INFO[ListItem.Genre]</label>
				<visible>String.IsEqual(ListItem.DBType,artist) + !ListItem.IsParentFolder</visible>
			</control>
		</definition>
	</include>

	<include name="Music_View_504">
		<control type="panel" id="504">
			<left>music_grid_left</left>
			<top>music_grid_top</top>
			<width>music_grid_w</width>
			<height>music_grid_h</height>
			<orientation>vertical</orientation>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<!-- Left past the first column / Right past the last one: the Library panel (1.0.9) -->
			<onleft>ActivateWindow(1155)</onleft>
			<onright>ActivateWindow(1155)</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<preloaditems>1</preloaditems>
			<viewtype label="31312">icon</viewtype>
			<visible>Container.Content(albums) | Container.Content(artists)</visible>
			<include>Anim_FadeVisible</include>
			<itemlayout width="251" height="310">
				<include content="Music_GridItem">
					<param name="focused" value="false"/>
				</include>
			</itemlayout>
			<focusedlayout width="251" height="310">
				<include content="Music_GridItem">
					<param name="focused" value="true"/>
				</include>
			</focusedlayout>
		</control>
	</include>

	<!-- ============================================================= 505 Big album -->
	<!-- Focused cover only: soft shadow (DESIGN 6, Big Album exception) + halo over Soft/Visible art
	     (DESIGN 2.5). Included conditionally so unfocused items carry no extra controls. -->
	<include name="Music_BigFocusUnderlay">
		<control type="image">
			<left>-128</left>
			<top>-98</top>
			<width>636</width>
			<height>636</height>
			<texture border="128" colordiffuse="shadow">common/shadow_soft.png</texture>
		</control>
		<control type="image">
			<left>-32</left>
			<top>-32</top>
			<width>444</width>
			<height>444</height>
			<texture border="32" colordiffuse="focus_halo">focus/halo.png</texture>
			<visible>$EXP[Music_ArtStrong] + Control.HasFocus(505)</visible>
		</control>
	</include>

	<include name="Music_BigItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>music_big_pad_x</left>
				<top>music_big_pad_y</top>
				<width>music_big</width>
				<height>music_big</height>
				<include condition="$PARAM[focused]">Anim_FocusZoom</include>
				<include condition="$PARAM[focused]">Music_BigFocusUnderlay</include>
				<include content="Music_Cover">
					<param name="mask_round" value="masks/square_round8_large.png"/>
					<param name="title" value="$VAR[Music_SongTitle]"/>
					<param name="parent_icon" value="64"/>
					<param name="parent_caption" value="true"/>
				</include>
				<include content="Majan_FocusFrame" condition="$PARAM[focused]">
					<param name="visible" value="Control.HasFocus(505)"/>
				</include>
			</control>
		</definition>
	</include>

	<include name="Music_View_505">
