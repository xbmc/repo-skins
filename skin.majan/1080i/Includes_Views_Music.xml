			<param name="left" value="912"/>
		</include>
		<include content="Music_SlotDim">
			<param name="offset" value="2"/>
			<param name="left" value="1320"/>
		</include>
		<include content="Music_SlotDim">
			<param name="offset" value="3"/>
			<param name="left" value="1728"/>
		</include>
		<!-- details under the row, aligned to the focused cover (x 504) -->
		<control type="group">
			<visible>Control.IsVisible(505) + Integer.IsGreater(Container(505).NumItems,0)</visible>
			<include>Anim_FadeVisible</include>
			<!-- left column: previous album (hidden at the start of the list) -->
			<control type="group">
				<left>page_margin</left>
				<top>music_details_y</top>
				<width>music_big</width>
				<visible>!String.IsEmpty(Container(505).ListItemNoWrap(-1).Label)</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>music_big</width>
					<height>24</height>
					<font>mono_14</font>
					<textcolor>$VAR[ColorCaption]</textcolor>
					<label>$VAR[Music_PrevCaption]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>32</top>
					<width>music_big</width>
					<height>24</height>
					<font>num_14</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[Music_PrevTitle]</label>
				</control>
			</control>
			<!-- focused ".." item: no details, just what OK does -->
			<control type="group">
				<left>music_details_x</left>
				<top>music_details_y</top>
				<width>1320</width>
				<visible>Container(505).ListItem.IsParentFolder</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1320</width>
					<height>26</height>
					<font>mono_15</font>
					<textcolor>$VAR[ColorAccent]</textcolor>
					<label>$LOCALIZE[31241]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>36</top>
					<width>1320</width>
					<height>84</height>
					<font>display_72</font>
					<textcolor>text_primary</textcolor>
					<label>$LOCALIZE[31242]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>136</top>
					<width>1320</width>
					<height>26</height>
					<font>mono_14</font>
					<textcolor>$VAR[ColorCaption]</textcolor>
					<label>$LOCALIZE[31243]</label>
				</control>
			</control>
			<!-- focused album -->
			<control type="group">
				<left>music_details_x</left>
				<top>music_details_y</top>
				<width>1320</width>
				<visible>!Container(505).ListItem.IsParentFolder</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>1320</width>
					<height>26</height>
					<font>mono_15</font>
					<textcolor>$VAR[ColorAccent]</textcolor>
					<label>$VAR[Music_BigKicker]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>36</top>
					<width>1320</width>
					<height>84</height>
					<font>display_72</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[Music_BigTitle]</label>
				</control>
				<control type="grouplist">
					<left>0</left>
					<top>130</top>
					<width>1320</width>
					<height>40</height>
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width max="1100">auto</width>
						<height>40</height>
						<font>title_28_semibold</font>
						<textcolor>text_primary</textcolor>
						<label>$VAR[Music_BigSubline]</label>
