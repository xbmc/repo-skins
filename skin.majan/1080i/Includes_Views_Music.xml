				</include>
			</focusedlayout>
		</control>
		<!-- fixed-slot dimming: slot 1 (x 96) = previous, slots 3+ = ahead; focused slot 2 (x 504) untouched -->
		<include content="Music_SlotDim">
			<param name="offset" value="-1"/>
			<param name="left" value="96"/>
			<param name="tex" value="vidview/dim_passed.png"/>
		</include>
