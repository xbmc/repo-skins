	<!-- ============================================================== 508 Tracklist -->
	<!-- Tracklist (1.0.18): songs as a full-width table under a mono column head: No. | Title | Artist | Album |
	     Year | Time, 11 rows of 66 (hairlines, the focused row raised with the accent bar, as the list), nothing
	     beside it. The track number is the song's own (a row index would count ".."). -->
	<include name="Music_TrackRow">
		<param name="focused">false</param>
		<definition>
			<control type="label">
				<left>list_text_x</left>
				<top>0</top>
				<width>60</width>
				<height>66</height>
				<font>num_16</font>
				<textcolor>text_tertiary</textcolor>
				<label>[UPPERCASE]$INFO[ListItem.TrackNumber][/UPPERCASE]</label>
				<visible>!ListItem.IsPlaying + !ListItem.IsParentFolder</visible>
			</control>
			<control type="label">
				<left>list_text_x</left>
				<top>0</top>
				<width>60</width>
				<height>66</height>
				<font>num_16</font>
				<textcolor>$VAR[ColorAccent]</textcolor>
				<label>▶</label>
				<visible>ListItem.IsPlaying</visible>
			</control>
			<control type="label">
				<left>100</left>
				<top>0</top>
				<width>600</width>
				<height>66</height>
				<font>label_25_semibold</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[Music_SongTitle]</label>
				<visible>!$PARAM[focused]</visible>
			</control>
			<control type="label">
				<left>100</left>
				<top>0</top>
				<width>600</width>
				<height>66</height>
				<font>label_25_bold</font>
				<textcolor>text_primary</textcolor>
				<scroll>true</scroll>
				<label>$VAR[Music_SongTitle]</label>
				<visible>$PARAM[focused]</visible>
			</control>
			<control type="label">
				<left>724</left>
				<top>0</top>
				<width>380</width>
				<height>66</height>
				<font>credits_21</font>
				<textcolor>text_secondary</textcolor>
				<label>$INFO[ListItem.Artist]</label>
			</control>
			<control type="label">
				<left>1128</left>
				<top>0</top>
				<width>380</width>
				<height>66</height>
				<font>credits_21</font>
				<textcolor>text_tertiary</textcolor>
				<label>$INFO[ListItem.Album]</label>
			</control>
			<control type="label">
				<left>1532</left>
				<top>0</top>
				<width>64</width>
				<height>66</height>
				<font>num_16</font>
				<textcolor>text_tertiary</textcolor>
				<label>$INFO[ListItem.Year]</label>
			</control>
			<control type="label">
				<right>list_text_x</right>
				<top>0</top>
				<width>100</width>
				<height>66</height>
				<align>right</align>
				<font>num_16</font>
				<textcolor>text_tertiary</textcolor>
				<label>$INFO[ListItem.Duration]</label>
			</control>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>page_width</width>
				<height>rule_h</height>
				<texture colordiffuse="hairline">common/hairline.png</texture>
			</control>
		</definition>
	</include>
