<?xml version="1.0" encoding="UTF-8"?>
<!--
	Radio RDS information (SPEC 5: Minimal, Majan_GenericDialog). Builder F, M4.
	Estuary Omega DialogPVRRadioRDSInfo.xml has no Kodi-written control ids: everything is RDS.*
	infolabels. Majan adds one Close button (9000, Action(close)) so the dialog always has a
	visible focus; Back closes too. Empty RDS fields are hidden (Misc_InfoLine).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1640</width>
			<height>920</height>
			<include content="Majan_GenericDialog">
				<param name="width" value="1640"/>
				<param name="height" value="920"/>
				<param name="header_label" value="$LOCALIZE[29900]"/>
			</include>
			<!-- left column: now playing + studio -->
			<include content="Misc_Caption">
				<param name="left" value="dialog_pad"/>
				<param name="top" value="dialog_content_top"/>
				<param name="label" value="$LOCALIZE[31017]"/>
			</include>
			<control type="grouplist">
				<left>dialog_pad</left>
				<top>152</top>
				<width>760</width>
				<height>320</height>
				<orientation>vertical</orientation>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31603]"/><param name="value" value="RDS.Band"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31604]"/><param name="value" value="RDS.Artist"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31605]"/><param name="value" value="RDS.Title"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31606]"/><param name="value" value="RDS.Composer"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31607]"/><param name="value" value="RDS.Conductor"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31608]"/><param name="value" value="RDS.Album"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31609]"/><param name="value" value="RDS.Comment"/><param name="width" value="760"/></include>
			</control>
			<include content="Misc_Caption">
				<param name="left" value="dialog_pad"/>
				<param name="top" value="484"/>
				<param name="label" value="$LOCALIZE[31610]"/>
			</include>
			<control type="grouplist">
				<left>dialog_pad</left>
				<top>524</top>
				<width>760</width>
				<height>230</height>
				<orientation>vertical</orientation>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31611]"/><param name="value" value="RDS.PhoneStudio"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31612]"/><param name="value" value="RDS.EmailStudio"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31613]"/><param name="value" value="RDS.SMSStudio"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31614]"/><param name="value" value="RDS.PhoneHotline"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31615]"/><param name="value" value="RDS.EmailHotline"/><param name="width" value="760"/></include>
			</control>
			<!-- right column: programme + radiotext -->
			<include content="Misc_Caption">
				<param name="left" value="840"/>
				<param name="top" value="dialog_content_top"/>
				<param name="width" value="760"/>
				<param name="label" value="$LOCALIZE[31616]"/>
			</include>
			<control type="grouplist">
				<left>840</left>
				<top>152</top>
				<width>760</width>
				<height>320</height>
				<orientation>vertical</orientation>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31617]"/><param name="value" value="RDS.ProgNow"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31618]"/><param name="value" value="RDS.ProgNext"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31619]"/><param name="value" value="RDS.ProgStyle"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31620]"/><param name="value" value="RDS.ProgStation"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31621]"/><param name="value" value="RDS.ProgHost"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31622]"/><param name="value" value="RDS.ProgEditStaff"/><param name="width" value="760"/></include>
				<include content="Misc_InfoLine"><param name="label" value="$LOCALIZE[31623]"/><param name="value" value="RDS.ProgHomepage"/><param name="width" value="760"/></include>
			</control>
			<include content="Misc_Caption">
				<param name="left" value="840"/>
				<param name="top" value="484"/>
				<param name="width" value="760"/>
				<param name="label" value="$LOCALIZE[31624]"/>
			</include>
			<control type="textbox">
				<left>840</left>
				<top>524</top>
				<width>760</width>
				<height>230</height>
				<font>body_23</font>
				<label>$INFO[RDS.GetLine(0),,[CR]]$INFO[RDS.GetLine(1),,[CR]]$INFO[RDS.GetLine(2),,[CR]]$INFO[RDS.GetLine(3)]$INFO[RDS.InfoNews,[CR][CR]$LOCALIZE[31625]  ,]$INFO[RDS.InfoSport,[CR]$LOCALIZE[31626]  ,]$INFO[RDS.InfoWeather,[CR]$LOCALIZE[31627]  ,]</label>
				<autoscroll time="3000" delay="5000" repeat="8000">true</autoscroll>
			</control>
			<control type="grouplist">
				<left>dialog_pad</left>
				<top>820</top>
				<width>1560</width>
				<height>dialog_row_h</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<include content="Majan_DialogButton">
					<param name="id" value="9000"/>
					<param name="width" value="260"/>
					<param name="label" value="$LOCALIZE[15067]"/>
					<param name="onclick" value="Action(close)"/>
				</include>
			</control>
		</control>
	</controls>
</window>
