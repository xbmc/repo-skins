<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Majan / Movies widget 02 "Newest releases" (pre-filter).
     The DB-side "year" order sorts by year then title only (no premiered date for movies in
     the SQL sort path), so this returns the newest 100 by year and the skin re-sorts them by
     full premiered date with <content sortby="year" sortorder="descending" limit="25">. -->
<smartplaylist type="movies">
    <name>Newest releases</name>
    <match>all</match>
    <limit>100</limit>
    <order direction="descending">year</order>
</smartplaylist>
