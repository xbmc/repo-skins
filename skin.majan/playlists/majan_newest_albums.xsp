<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Majan / Music row 03 fallback "Newest releases" (by album release year), shown while
     "Recently played" is empty. 22 of 229 albums have no year and sort last. -->
<smartplaylist type="albums">
    <name>Newest album releases</name>
    <match>all</match>
    <limit>25</limit>
    <order direction="descending">year</order>
</smartplaylist>
