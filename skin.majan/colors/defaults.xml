<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.majan · "Index" palette. Semantic tokens only; source of truth is
    docs/skin.majan/DESIGN.md (values extracted from the approved mockups).
    Format AARRGGBB. Names are lowercase; refer to them by name in XML.

    The LIVE accent is NOT read from here directly. Use $VAR[ColorAccent]
    (defined by the skin-architect in Includes_Colors.xml), which returns
    $INFO[Skin.String(majan.accent)] and falls back to the `accent` colour below.
-->
<colors>
    <!-- Surfaces -->
    <color name="bg">ff0b0b0b</color>                <!-- page background, Now Playing bar -->
    <color name="bg_raised">ff141414</color>         <!-- focused settings row / list row fill -->
    <color name="bg_ghost">ff1d1d1d</color>          <!-- giant ghost index numerals (Hub "05") -->
    <color name="ink">ff0b0b0b</color>               <!-- text/icons ON accent or bone fills -->

    <!-- Text -->
    <color name="text_primary">ffecebe7</color>      <!-- titles, active menu, values -->
    <color name="text_body">ffc9c7c1</color>         <!-- plot / long-form copy -->
    <color name="text_secondary">ffa3a19b</color>    <!-- inactive menu, meta lines, cast, date -->
    <color name="text_tertiary">ff8d8b85</color>     <!-- mono captions, field labels, "/ 10" -->

    <!-- Lines and control borders -->
    <color name="hairline">ff262626</color>          <!-- header rule, settings dividers (solid bg) -->
    <color name="hairline_strong">ff333333</color>   <!-- row labels rule, progress track, Now Playing rule -->
    <color name="border_control">ff444444</color>    <!-- segmented-control frame -->
    <color name="border_button">ff555555</color>     <!-- secondary button outline (Details / Trailer) -->
    <color name="hairline_art">1affffff</color>      <!-- header rule over artwork background (10%) -->
    <color name="hairline_art_strong">33ffffff</color><!-- stat-grid rules over artwork (20%) -->

    <!-- Default accent + the seven accent options (Skin.String(majan.accent) stores one of these hex values) -->
    <color name="accent">ffff5a1f</color>
    <color name="accent_signal">ffff5a1f</color>
    <color name="accent_cobalt">ff4c7dff</color>
    <color name="accent_mint">ff3ddc97</color>
    <color name="accent_amber">ffffb020</color>
    <color name="accent_rose">ffff5c8a</color>
    <color name="accent_ice">ff9ad8f5</color>
    <color name="accent_bone">ffecebe7</color>

    <!-- Scrims and shadows (tint white gradient/scrim textures with these) -->
    <color name="scrim">ff0b0b0b</color>             <!-- gradient_*.png / scrim_*.png carry their own alpha -->
    <color name="scrim_tab">d90b0b0b</color>         <!-- 85%: count tab over posters (rounded mode) -->
    <color name="scrim_track">cc0b0b0b</color>       <!-- 80%: TV progress track over poster -->
    <color name="shadow">73000000</color>            <!-- 45%: common/shadow_soft.png -->
    <color name="focus_halo">b30b0b0b</color>        <!-- 70%: focus/halo.png behind the outline -->

    <!-- Unfocused artwork dimming (opaque multiply, never transparency) -->
    <color name="dim_passed">ff737373</color>        <!-- brightness .45: item(s) left of focus -->
    <color name="dim_ahead">ffcccccc</color>         <!-- brightness .80: items right of focus -->
    <color name="dim_row">ff737373</color>           <!-- inactive widget rows on Home/Hub -->
    <color name="dim_wall">ff999999</color>          <!-- brightness .60: Poster wall, unselected posters when the border is off -->

    <!-- Artwork background opacity (colordiffuse on the blurred background image) -->
    <color name="art_faint">4dffffff</color>         <!-- 30% -->
    <color name="art_soft">73ffffff</color>          <!-- 45% -->
    <color name="art_visible">a6ffffff</color>       <!-- 65% -->

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
    <color name="disabled">ff555555</color>
    <!-- Added by skin-architect (M1): dialog backdrop dim behind modal dialogs (80% bg) -->
    <color name="dim_dialog">cc0b0b0b</color>
    <!-- integration (round 1): video dim behind OSD side panels (55%), soft row divider -->
    <color name="dim_video">8c0b0b0b</color>
    <color name="hairline_soft">ff1c1c1c</color>
</colors>
