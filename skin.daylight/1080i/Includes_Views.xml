<?xml version="1.0" encoding="UTF-8"?>
<!--
	Generic list window + view 50 for every media window that is not the video/music library
	(programs, pictures, add-ons, files, PVR lists...). Same Daylight layout as Films: a detail panel
	on the left, a soft card with the list on the right, header pills (9000) in the card.
	Kodi media-window ids: 3 sort by, 4 sort order, 10 watched toggle (video windows), views in <views>.
-->
<includes>
	<!-- One list row inside a card (1076 wide, 76 high). params: focused, id -->
	<include name="DL_LibListRow">
		<param name="focused">false</param>
		<param name="id">50</param>
		<definition>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1068</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[DL_Accent]">daylight/card20.png</texture>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1068</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[DL_Raised]">daylight/card20.png</texture>
				<visible>$PARAM[focused] + !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="image">
				<left>22</left>
				<top>14</top>
				<width>48</width>
				<height>48</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture background="true" diffuse="masks/square_round8.png">$VAR[DL_RowIcon]</texture>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>
				<font>ui_24</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>$VAR[DL_RowLabel]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>90</left>
				<top>0</top>
				<width>700</width>
				<height>76</height>
				<font>ui_24_semibold</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$VAR[DL_RowLabel]</label>
				<scroll>true</scroll>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>800</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>small_20</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>!$PARAM[focused] | !Control.HasFocus($PARAM[id])</visible>
			</control>
			<control type="label">
				<left>800</left>
				<top>0</top>
				<width>250</width>
				<height>76</height>
				<align>right</align>
				<font>small_20</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
			</control>
		</definition>
	</include>
	<variable name="DL_RowLabel">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="DL_RowIcon">
		<value condition="ListItem.IsParentFolder">daylight/icons/back.png</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ============================================================ View 50 (generic) -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>702</left>
				<top>262</top>
				<width>1076</width>
				<height>754</height>
				<onup>9000</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<itemlayout width="1076" height="76">
					<include>DL_LibListRow</include>
				</itemlayout>
				<focusedlayout width="1076" height="76">
					<include content="DL_LibListRow"><param name="focused" value="true"/></include>
				</focusedlayout>
			</control>
		</control>
	</include>

	<!-- Detail panel for generic windows: rounded art, title, label2, plot -->
	<include name="DL_GenericDetail">
		<control type="group">
			<left>page_margin</left>
			<top>168</top>
			<width>500</width>
			<height>848</height>
			<visible>Integer.IsGreater(Container.NumItems,0)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>500</width>
				<height>420</height>
				<aspectratio align="left" aligny="top">keep</aspectratio>
				<fadetime>160</fadetime>
				<texture background="true" colordiffuse="$VAR[DL_ArtDim]">$VAR[DL_RowIconLarge]</texture>
			</control>
			<control type="group">
				<left>0</left>
				<top>440</top>
				<width>500</width>
				<include content="T_Generic_Title">
					<param name="label" value="$VAR[DL_RowLabel]"/>
					<param name="color" value="$VAR[DL_Ink]"/>
				</include>
			</control>
			<control type="label">
				<left>0</left>
				<top>588</top>
				<width>500</width>
				<height>30</height>
				<font>ui_22</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>632</top>
				<width>500</width>
				<height>180</height>
				<font>body_24</font>
				<textcolor>$VAR[DL_Body]</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="3000" repeat="10000">!Container.Scrolling</autoscroll>
			</control>
		</control>
	</include>
	<variable name="DL_RowIconLarge">
		<value condition="ListItem.IsParentFolder"></value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- ===================================================== header pills (generic) -->

	<!-- ========================================== generic list window -->
</includes>
