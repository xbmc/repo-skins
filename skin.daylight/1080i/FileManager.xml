<?xml version="1.0" encoding="UTF-8"?>
<!--
	File manager (Daylight): two soft cards side by side, each with its path, a count and a list.
	Copy / move / delete come from the context menu (Kodi's own items); marked items show the check
	(ListItem.IsSelected).
	Kodi id contract (Estuary Omega FileManager.xml): left list 20 + scrollbar 60, right list 21 +
	scrollbar 61, current-path labels 101 (left) / 102 (right).
	Focus map: Left/Right move between the two lists; Up/Down wrap inside a list. Back is Kodi's.
-->
<window>
	<defaultcontrol always="true">20</defaultcontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include content="DL_TopBar">
			<param name="index" value="12"/>
			<param name="title" value="$LOCALIZE[7]"/>
		</include>
		<include content="FM_Side">
			<param name="x" value="120"/>
			<param name="list" value="20"/>
			<param name="path" value="101"/>
			<param name="scroll" value="60"/>
			<param name="onleft" value="noop"/>
			<param name="onright" value="21"/>
		</include>
		<include content="FM_Side">
			<param name="x" value="980"/>
			<param name="list" value="21"/>
			<param name="path" value="102"/>
			<param name="scroll" value="61"/>
			<param name="onleft" value="20"/>
			<param name="onright" value="noop"/>
		</include>
	</controls>
</window>
