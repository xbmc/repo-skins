<?xml version="1.0" encoding="UTF-8"?>
<!--
	Dialog building blocks (owner: Builder E · Settings + core dialogs, M4 styling pass).
	Daylight vocabulary: soft rounded card with a pre-rendered shadow, Fraunces heading, no rules;
	focused list row = raised rounded fill + accent ring; buttons = soft raised pill at rest, accent
	fill + on-accent text on focus. Right-hand playback sheet floats with rounded corners.

	Shared names other builders may use (params unchanged from M1, look restyled):
	  DL_GenericDialog, DL_DialogButton, DL_ListLayout, DL_Scrollbar,
	  DL_ToastFrame, DL_KeyboardKey, DL_KeyboardFunc
	Builder E's own: Dlg_* (constants dlg_*).
-->
<includes>
	<!-- ============================================================ constants -->
	<constant name="dlg_panel_x">1200</constant>          <!-- right-hand playback panel (mockups/Tracks, AVSettings) -->
	<constant name="dlg_panel_w">720</constant>
	<constant name="dlg_panel_pad">72</constant>          <!-- inner left/right padding -->
	<constant name="dlg_panel_in_w">576</constant>        <!-- 720 - 2 x 72 -->
	<constant name="dlg_panel_top">64</constant>
	<constant name="dlg_track_row_h">58</constant>
	<constant name="dlg_osd_row_h">76</constant>
	<constant name="dlg_row_pad">16</constant>            <!-- text inset inside a list row -->
	<constant name="dlg_check">22</constant>              <!-- current-item check -->
	<constant name="dlg_check_gutter">56</constant>       <!-- label x when a check column precedes it -->
	<constant name="dlg_btn_h">60</constant>

	<!-- ============================================================ expressions -->
	<!-- DialogSelect shows the right-hand track panel only over fullscreen video -->
	<expression name="Dlg_IsTrackPanel">Player.HasVideo + Window.IsActive(fullscreenvideo)</expression>
	<!-- the select list was opened from the OSD subtitle settings (subtitle stream list) -->
	<expression name="Dlg_FromSubtitleSettings">Window.IsVisible(osdsubtitlesettings)</expression>
	<!-- DialogSettings is one of the OSD playback settings dialogs -->
	<expression name="Dlg_IsOSDSettings">Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)</expression>

	<!-- ============================================================ variables -->
	<!-- Track panel kicker: "SUBTITLES · 16 TRACKS" -->
	<variable name="Dlg_SelectKicker">
		<value condition="Window.IsVisible(osdsubtitlesettings)">Subtitles$VAR[PL_Container_3_NumItems_Track]</value>
		<value condition="Window.IsVisible(osdaudiosettings)">Audio$VAR[PL_Container_3_NumItems_Track]</value>
		<value condition="Window.IsVisible(osdvideosettings)">Video$VAR[PL_Container_3_NumItems_Option]</value>
		<value condition="Control.IsVisible(6)">Select$VAR[PL_Container_6_NumItems_Item]</value>
		<value>Select$VAR[PL_Container_3_NumItems_Item]</value>
	</variable>
	<!-- Centred select: "03 / 16" in the header -->
	<variable name="Dlg_SelectPosition">
		<value condition="Control.IsVisible(6)">$INFO[Container(6).CurrentItem]$INFO[Container(6).NumItems, / ,]</value>
		<value>$INFO[Container(3).CurrentItem]$INFO[Container(3).NumItems, / ,]</value>
	</variable>
	<!-- What is playing, under the track panel: "PAUSED · 1:02:31 / 2:14:00" -->
	<variable name="Dlg_PlayState">
		<value condition="Player.Paused">Paused  ·  $INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="Dlg_PlayTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value>$INFO[VideoPlayer.Title]</value>
	</variable>

	<variable name="Dlg_AddonNewsLabel">
		<value condition="!String.IsEmpty(Window(Home).Property(daylight.addonnews))">Description</value>
		<value>What's new</value>
	</variable>

	<!-- ============================================================ texture switches -->
	<!-- (button textures can't take $VAR, so corners / outline weight are picked at window load) -->
	<include name="Dlg_Tex_DialogButton">
		<include condition="true">Dlg_Tex_DialogButton_Round</include>
		<include condition="false">Dlg_Tex_DialogButton_Square</include>
	</include>
	<include name="Dlg_Tex_DialogButton_Square">
		<texturefocus border="10" colordiffuse="$VAR[DL_Accent]">common/rect_square.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[DL_Line2]">common/rect_outline_1.png</texturenofocus>
	</include>
	<include name="Dlg_Tex_DialogButton_Round">
		<texturefocus border="24" colordiffuse="$VAR[DL_Accent]">daylight/card20.png</texturefocus>
		<texturenofocus border="24" colordiffuse="$VAR[DL_Raised]">daylight/card20.png</texturenofocus>
	</include>

	<!-- Accent frame drawn AT the control rect (stroke sits 1-3px inside), for Kodi-cloned rows -->
	<include name="Dlg_Tex_RowFocus">
		<include condition="false + !String.IsEqual(Skin.String(daylight.focusoutline),medium)">Dlg_Tex_RowFocus_S2</include>
		<include condition="false + String.IsEqual(Skin.String(daylight.focusoutline),medium)">Dlg_Tex_RowFocus_S3</include>
		<include condition="true + !String.IsEqual(Skin.String(daylight.focusoutline),medium)">Dlg_Tex_RowFocus_R2</include>
		<include condition="true + String.IsEqual(Skin.String(daylight.focusoutline),medium)">Dlg_Tex_RowFocus_R3</include>
	</include>
	<include name="Dlg_Tex_RowFocus_S2"><texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_S3"><texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_R2"><texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_R3"><texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus></include>

	<!-- Hairline under a row (texturenofocus of Kodi-cloned rows). flip = true gives a top rule. -->
	<include name="Dlg_Tex_RowRule">
		<param name="color">$VAR[DL_Line]</param>
		<param name="flip">false</param>
		<definition>
			<texturenofocus border="0,0,0,2" flipy="$PARAM[flip]" colordiffuse="00ffffff">dialogs/row_rule.png</texturenofocus>
		</definition>
	</include>

	<!-- ============================================================ generic dialog -->
	<!-- Centred modal frame. Put inside a group positioned/sized like the dialog.
	     params: width, height, header_id (Kodi heading id, "" if none), header_label,
	             kicker (optional mono caption, right side of the header, accent) -->
	<include name="DL_GenericDialog">
		<param name="header_id"></param>
		<param name="header_label"></param>
		<param name="kicker"></param>
		<definition>
			<control type="image">
				<description>backdrop dim</description>
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="$VAR[DL_DimDialog]">common/white.png</texture>
			</control>
			<control type="group">
				<description>panel: soft card</description>
				<left>0</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
				<include>DL_Card</include>
			</control>
			<control type="label" id="$PARAM[header_id]">
				<description>heading</description>
				<left>dialog_pad</left>
				<top>0</top>
				<right>260</right>
				<height>dialog_header_h</height>
				<font>serif_32</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>$PARAM[header_label]</label>
			</control>
			<control type="label">
				<description>kicker</description>
				<right>dialog_pad</right>
				<top>0</top>
				<width>220</width>
				<height>dialog_header_h</height>
				<align>right</align>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_AccentText]</textcolor>
				<label>$PARAM[kicker]</label>
			</control>
			<control type="image">
				<left>dialog_pad</left>
				<top>dialog_header_h</top>
				<right>dialog_pad</right>
				<height>2</height>
				<texture colordiffuse="$VAR[DL_Line]">common/white.png</texture>
			</control>
		</definition>
	</include>

	<!-- Dialog button: 1px outline at rest, accent fill + ink text on focus (always visible focus).
	     params: id, label, width, height, onclick, onclick2 (second action), visible -->
	<!-- No <enable>: Kodi enables/disables its own dialog buttons (5/7/8, 28-30); a skin <enable> would override it. -->
	<include name="DL_DialogButton">
		<param name="width">300</param>
		<param name="height">dialog_row_h</param>
		<param name="label"></param>
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<label>$PARAM[label]</label>
				<font>ui_22_semibold</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
				<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
				<align>center</align>
				<textoffsetx>16</textoffsetx>
				<include>Dlg_Tex_DialogButton</include>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Definition-list fact (mono field label + value), 40px pitch. params: top, label, value, valuew -->
	<include name="Dlg_FactRow">
		<param name="valuew">620</param>
		<definition>
			<control type="label">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>160</width>
				<height>28</height>
				<font>cap_20</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$PARAM[label]</label>
			</control>
			<control type="label">
				<left>160</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[valuew]</width>
				<height>28</height>
				<font>num_21</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>$PARAM[value]</label>
			</control>
		</definition>
	</include>

	<!-- ============================================================ list rows -->
	<!-- Focused-row treatment inside a <focusedlayout>: raised fill + 2px accent frame (inset).
	     Shown only while the list has focus, so an unfocused list never looks "selected".
	     params: list_id, width, height -->
	<include name="Dlg_RowFocus">
		<definition>
			<control type="image">
				<left>2</left>
				<top>2</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texture>
				<visible>Control.HasFocus($PARAM[list_id])</visible>
			</control>
			<control type="image">
				<left>2</left>
				<top>2</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="20" colordiffuse="$VAR[DL_Raised]">daylight/card16.png</texture>
				<visible>!Control.HasFocus($PARAM[list_id])</visible>
			</control>
		</definition>
	</include>

	<!-- Text list: check column (current / selected item), label, mono label2 on the right,
	     hairline under each row. params: width, height, label, label2, list_id -->
	<include name="DL_ListLayout">
		<param name="width">800</param>
		<param name="height">64</param>
		<param name="label">$INFO[ListItem.Label]</param>
		<param name="label2">$INFO[ListItem.Label2]</param>
		<param name="list_id">50</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<control type="image">
					<left>dlg_row_pad</left>
					<centertop>50%</centertop>
					<width>dlg_check</width>
					<height>dlg_check</height>
					<texture colordiffuse="$VAR[DL_Accent]">markers/check.png</texture>
					<visible>ListItem.IsSelected</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<font>ui_25_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>num_21</font>
					<textcolor>$VAR[DL_Ink3]</textcolor>
					<label>$PARAM[label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<control type="image">
					<left>dlg_row_pad</left>
					<centertop>50%</centertop>
					<width>dlg_check</width>
					<height>dlg_check</height>
					<texture colordiffuse="$VAR[DL_Accent]">markers/check.png</texture>
					<visible>[ListItem.IsSelected] + !Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="image">
					<left>dlg_row_pad</left>
					<centertop>50%</centertop>
					<width>dlg_check</width>
					<height>dlg_check</height>
					<texture colordiffuse="$VAR[DL_OnAccent]">markers/check.png</texture>
					<visible>[ListItem.IsSelected] + Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<font>ui_25_bold</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[label]</label>
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<font>ui_25_bold</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[label]</label>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>num_21</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$PARAM[label2]</label>
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>num_21</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$PARAM[label2]</label>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<include name="Dlg_IndexListLayout">
		<param name="width">860</param>
		<param name="height">72</param>
		<param name="list_id">9000</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<control type="label">
					<left>24</left>
					<top>0</top>
					<right>128</right>
					<height>$PARAM[height]</height>
					<font>ui_25_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>cap_20</font>
					<textcolor>$VAR[DL_Ink3]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<control type="label">
					<left>24</left>
					<top>0</top>
					<right>128</right>
					<height>$PARAM[height]</height>
					<font>ui_25_bold</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<left>24</left>
					<top>0</top>
					<right>128</right>
					<height>$PARAM[height]</height>
					<font>ui_25_bold</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>cap_20</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>cap_20</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<!-- Track rows (mockups/Tracks): 58px, check for the current track, name (bold when current),
	     mono meta (label2) on the right, #1c1c1c-ish divider (bg_ghost). params: list_id -->
	<include name="Dlg_TrackListLayout">
		<param name="list_id">3</param>
		<definition>
			<itemlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<include>Dlg_TrackRowContent</include>
			</itemlayout>
			<focusedlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="00ffffff">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="dlg_panel_in_w"/>
					<param name="height" value="dlg_track_row_h"/>
				</include>
				<include content="Dlg_TrackRowContent">
					<param name="focused" value="true"/>
					<param name="list_id" value="$PARAM[list_id]"/>
				</include>
			</focusedlayout>
		</definition>
	</include>
	<include name="Dlg_TrackRowContent">
		<param name="focused">false</param>
		<param name="list_id">0</param>
		<definition>
			<control type="image">
				<left>dlg_row_pad</left>
				<top>19</top>
				<width>20</width>
				<height>20</height>
				<texture colordiffuse="$VAR[DL_Accent]">markers/check.png</texture>
				<visible>[ListItem.IsSelected] + [!$PARAM[focused] | !Control.HasFocus($PARAM[list_id])]</visible>
			</control>
			<control type="image">
				<left>dlg_row_pad</left>
				<top>19</top>
				<width>20</width>
				<height>20</height>
				<texture colordiffuse="$VAR[DL_OnAccent]">markers/check.png</texture>
				<visible>[ListItem.IsSelected] + $PARAM[focused] + Control.HasFocus($PARAM[list_id])</visible>
			</control>
			<control type="label">
				<left>56</left>
				<top>0</top>
				<right>150</right>
				<height>dlg_track_row_h</height>
				<font>button_22_semibold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>[!ListItem.IsSelected] + [!$PARAM[focused] | !Control.HasFocus($PARAM[list_id])]</visible>
			</control>
			<control type="label">
				<left>56</left>
				<top>0</top>
				<right>150</right>
				<height>dlg_track_row_h</height>
				<font>button_22_semibold</font>
				<textcolor>$VAR[DL_OnAccent]</textcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>[!ListItem.IsSelected] + $PARAM[focused] + Control.HasFocus($PARAM[list_id])</visible>
			</control>
			<control type="label">
				<left>56</left>
				<top>0</top>
				<right>150</right>
				<height>dlg_track_row_h</height>
