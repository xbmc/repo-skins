<?xml version="1.0" encoding="UTF-8"?>
<!--
	Chapters and bookmarks (M3, Builder D, Minimal per SPEC 5). Bottom band over the picture: kicker,
	three action buttons, then a horizontal strip of 16:9 thumbs (chapters + bookmarks; Kodi lists
	both, label = name, label2 = time). Opened from the OSD chapters button (70044).

	Id contract (Estuary Omega VideoOSDBookmarks.xml / GUIDialogVideoBookmarks.cpp): 2 add bookmark
	(default, always), 3 clear bookmarks, 4 add episode bookmark (Kodi enables it for episodes),
	11 thumbs panel (OK jumps to the chapter/bookmark). 9001 = button row.
	Focus map: buttons Left/Right, Down -> thumbs, Up from thumbs -> buttons. Back closes.
-->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<include>DLOSD_Scrims</include>
		<include content="DLOSD_Panel">
			<param name="top" value="508"/>
			<param name="height" value="508"/>
		</include>

		<control type="label">
			<left>168</left>
			<top>540</top>
			<width>1100</width>
			<height>34</height>
			<font>serif_30</font>
			<label>Chapters &amp; bookmarks$INFO[Container(11).NumItems,  ·  ,]</label>
		</control>
		<control type="label">
			<left>1200</left>
			<top>540</top>
			<width>552</width>
			<height>34</height>
			<align>right</align>
			<font>num_22</font>
			<textcolor>$VAR[DL_Ink2]</textcolor>
			<label>$INFO[Player.Time]$INFO[Player.Duration, / ,]</label>
		</control>

		<!-- ====== buttons -->
		<control type="group" id="9001">
			<left>0</left>
			<top>586</top>
			<width>screen_w</width>
			<height>button_h</height>
			<include content="DL_ButtonSecondary">
				<param name="id" value="2"/>
				<param name="left" value="168"/>
				<param name="width" value="300"/>
				<param name="label" value="$LOCALIZE[294]"/>
				<param name="onclick" value="noop"/>
				<param name="onleft" value="4"/>
				<param name="onright" value="3"/>
				<param name="ondown" value="11"/>
			</include>
			<include content="DL_ButtonSecondary">
				<param name="id" value="3"/>
				<param name="left" value="484"/>
				<param name="width" value="300"/>
				<param name="label" value="$LOCALIZE[296]"/>
				<param name="onclick" value="noop"/>
				<param name="onleft" value="2"/>
				<param name="onright" value="4"/>
				<param name="ondown" value="11"/>
			</include>
			<include content="DL_ButtonSecondary">
				<param name="id" value="4"/>
				<param name="left" value="800"/>
				<param name="width" value="380"/>
				<param name="label" value="$LOCALIZE[20406]"/>
				<param name="onclick" value="noop"/>
				<param name="onleft" value="3"/>
				<param name="onright" value="2"/>
				<param name="ondown" value="11"/>
				<param name="visible" value="Control.IsEnabled(4)"/>
			</include>
		</control>

		<!-- ====== thumbs -->
		<control type="label">
			<left>168</left>
			<top>700</top>
			<width>1584</width>
			<height>40</height>
			<font>ui_24</font>
			<textcolor>$VAR[DL_Ink2]</textcolor>
			<label>$LOCALIZE[31276]</label>
			<visible>Integer.IsEqual(Container(11).NumItems,0)</visible>
		</control>
		<control type="panel" id="11">
			<left>136</left>
			<top>672</top>
			<width>1648</width>
			<height>290</height>
			<onup>9001</onup>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<orientation>horizontal</orientation>
			<preloaditems>2</preloaditems>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout width="344" height="290">
				<include content="OSD_BookmarkItem">
					<param name="label_color" value="$VAR[DL_Ink2]"/>
				</include>
			</itemlayout>
			<focusedlayout width="344" height="290">
				<include content="OSD_BookmarkItem">
					<param name="label_color" value="$VAR[DL_Ink]"/>
				</include>
				<control type="group">
					<left>8</left>
					<top>12</top>
					<width>320</width>
					<height>180</height>
					<visible>Control.HasFocus(11)</visible>
					<include>DL_FocusFrameAlways</include>
				</control>
			</focusedlayout>
		</control>

		<control type="label">
			<left>168</left>
			<top>966</top>
			<width>1584</width>
			<height>30</height>
			<font>small_20</font>
			<textcolor>$VAR[DL_Ink2]</textcolor>
			<label>$LOCALIZE[31277]</label>
		</control>
	</controls>
</window>
