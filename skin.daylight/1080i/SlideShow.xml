<?xml version="1.0" encoding="UTF-8"?>
<!--
	Picture slideshow overlay (Daylight). Kodi draws the pictures; the skin adds a soft paused card
	(file name, slide n/count, the clock) and a round play mark when the current slide is a video
	that isn't playing. No Kodi control ids (Estuary Omega SlideShow.xml has none). Info opens
	DialogPictureInfo; Back / Stop exit.
-->
<window>
	<controls>
		<!-- video slide waiting to be played -->
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>136</width>
			<height>136</height>
			<visible>SlideShow.IsVideo</visible>
			<visible>![Player.Playing + Player.HasVideo] | SlideShow.IsPaused</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>136</width>
				<height>136</height>
				<texture colordiffuse="$VAR[DL_Panel]">daylight/circle_64.png</texture>
			</control>
			<control type="image">
				<left>44</left>
				<top>44</top>
				<width>48</width>
				<height>48</height>
				<texture colordiffuse="$VAR[DL_Ink]">daylight/icons/play.png</texture>
			</control>
		</control>
		<!-- paused card -->
		<control type="group">
			<left>page_margin</left>
			<top>888</top>
			<width>1680</width>
			<height>128</height>
			<visible>SlideShow.IsPaused</visible>
			<include>Anim_FadeVisible</include>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>1000</width>
				<height>128</height>
				<include content="DL_Card">
					<param name="color" value="$VAR[DL_Panel]"/>
				</include>
				<control type="image">
					<left>32</left>
					<top>32</top>
					<width>64</width>
					<height>64</height>
					<texture colordiffuse="$VAR[DL_Accent]">daylight/circle_64.png</texture>
				</control>
				<control type="image">
					<left>50</left>
					<top>50</top>
					<width>28</width>
					<height>28</height>
					<texture colordiffuse="$VAR[DL_OnAccent]">daylight/icons/pause.png</texture>
				</control>
				<control type="label">
					<left>124</left>
					<top>24</top>
					<width>840</width>
					<height>44</height>
					<font>serif_30</font>
					<label>Paused$INFO[Slideshow.SlideIndex,  ·  ,]</label>
				</control>
				<control type="label">
					<left>124</left>
					<top>70</top>
					<width>840</width>
					<height>32</height>
					<font>ui_22</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[SlideShow.Filename]$INFO[SlideShow.EXIFTime,  ·  ,]</label>
				</control>
			</control>
			<control type="group">
				<left>1440</left>
				<top>0</top>
				<width>240</width>
				<height>128</height>
				<include content="DL_Card">
					<param name="color" value="$VAR[DL_Panel]"/>
				</include>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>240</width>
					<height>128</height>
					<align>center</align>
					<font>clock_30</font>
					<label>$INFO[System.Time]</label>
				</control>
			</control>
		</control>
	</controls>
</window>
