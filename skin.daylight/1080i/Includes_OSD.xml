	<!-- ============================================================= bookmarks -->
	<!-- One VideoOSDBookmarks thumb (item 344 x 290; thumb 320 x 180 at 8,12 so the focus frame
	     is not clipped by the panel). No art -> raised block with the time. param label_color -->
	<include name="OSD_BookmarkItem">
		<param name="label_color">$VAR[DL_Ink2]</param>
		<definition>
			<control type="image">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>
				<texture border="20" colordiffuse="$VAR[DL_Raised]">daylight/card16.png</texture>
			</control>
			<control type="label">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>
				<align>center</align>
				<font>num_21</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="image">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>
				<aspectratio>scale</aspectratio>
				<fadetime>120</fadetime>
				<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="label">
				<left>8</left>
				<top>206</top>
				<width>320</width>
				<height>30</height>
				<font>ui_22_bold</font>
				<textcolor>$PARAM[label_color]</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<left>8</left>
				<top>238</top>
				<width>320</width>
				<height>26</height>
				<font>num_20</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</definition>
	</include>

