<?xml version="1.0" encoding="UTF-8"?>
<!--
	Add-on information (Daylight; also the update pop-ups, so it must always be closable).
	Hero card: rounded icon, name, summary, a facts line and the screenshots on the right; Kodi's
	button row under it; a Description card (What's new toggle) and a Details card below.
	Id contract (Estuary Omega): button row grouplist 9000 with 12 open, 9 configure,
	13 auto-update (radio), 10 dependencies, 7 enable/disable, 8 install-from-versions, 14 update,
	6 install/uninstall (Kodi labels / enables them); screenshots panel 50 (Kodi fills it).
	Daylight ids: 9202 "What's new" toggle (Window(Home).Property(daylight.addonnews)).
	Focus map: buttons 9000 (default) -Up-> screenshots 50 -Down-> buttons; buttons -Down-> 9202.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload condition="!ListItem.Property(addon.isinstalled) + Window.IsActive(addonbrowser)">SetFocus(6)</onload>
	<onload>ClearProperty(daylight.addonnews,home)</onload>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include>DL_MoodLine</include>
		<include>DL_ClockOnly</include>

		<!-- ====== hero card -->
		<control type="group">
			<left>page_margin</left>
			<top>content_top</top>
			<width>page_width</width>
			<height>412</height>
			<include>DL_Card</include>
			<!-- icon -->
			<control type="image">
				<left>40</left>
				<top>40</top>
				<width>332</width>
				<height>332</height>
				<texture diffuse="daylight/mask_cover.png" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
			</control>
			<control type="image">
				<left>72</left>
				<top>72</top>
				<width>268</width>
				<height>268</height>
				<aspectratio>keep</aspectratio>
				<fadetime>150</fadetime>
				<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
			</control>
			<!-- text -->
			<control type="group">
				<left>412</left>
				<top>44</top>
				<width>620</width>
				<height>340</height>
				<control type="image">
					<left>0</left>
					<top>9</top>
					<width>10</width>
					<height>10</height>
					<texture colordiffuse="$VAR[DL_Accent]">daylight/circle_12.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>600</width>
					<height>28</height>
					<font>ui_22_semibold</font>
					<textcolor>$VAR[DL_AccentText]</textcolor>
					<label>$INFO[ListItem.AddonType]$INFO[ListItem.AddonVersion,  ·  version ,]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>36</top>
					<width>620</width>
					<height>80</height>
					<font>display_52</font>
					<label>$INFO[ListItem.AddonName]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>124</top>
					<width>620</width>
					<height>76</height>
					<font>ui_26_semibold</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$INFO[ListItem.AddonSummary]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>212</top>
					<width>620</width>
					<height>32</height>
					<font>ui_22</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[ListItem.AddonCreator,by ,]$INFO[ListItem.AddonOrigin,  ·  ,]</label>
				</control>
				<!-- deprecated / broken -->
				<control type="group">
					<top>262</top>
					<visible>String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24170]) | String.IsEqual(ListItem.AddonLifecycleType,$LOCALIZE[24171])</visible>
					<control type="label">
						<left>0</left>
						<top>0</top>
						<width>620</width>
						<height>30</height>
						<font>small_20_bold</font>
						<textcolor>$VAR[DL_AccentText]</textcolor>
						<label>$INFO[ListItem.AddonLifecycleType]</label>
					</control>
					<control type="textbox">
						<left>0</left>
						<top>30</top>
						<width>620</width>
						<height>52</height>
						<font>small_20</font>
						<textcolor>$VAR[DL_Ink2]</textcolor>
						<label>$INFO[ListItem.AddonLifecycleDesc]</label>
					</control>
				</control>
			</control>
			<!-- screenshots (Kodi fills panel 50) -->
			<control type="label">
				<left>1064</left>
				<top>40</top>
				<width>576</width>
				<height>30</height>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>Screenshots$INFO[Container(50).NumItems,  ·  ,]</label>
				<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
			</control>
			<control type="panel" id="50">
				<left>1048</left>
				<top>76</top>
				<width>608</width>
				<height>336</height>
				<orientation>horizontal</orientation>
				<onup>noop</onup>
				<ondown>9000</ondown>
				<onleft>50</onleft>
				<onright>50</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<preloaditems>1</preloaditems>
				<itemlayout width="608" height="336">
					<include>AddonInfo_Shot</include>
				</itemlayout>
				<focusedlayout width="608" height="336">
					<include content="AddonInfo_Shot">
						<param name="focused" value="true"/>
					</include>
				</focusedlayout>
			</control>
			<control type="image">
				<left>1064</left>
				<top>92</top>
				<width>576</width>
				<height>280</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="$VAR[DL_ArtDim]" background="true">$INFO[ListItem.Art(fanart)]</texture>
				<visible>!Integer.IsGreater(Container(50).NumItems,0)</visible>
			</control>
		</control>

		<!-- ====== buttons -->
		<control type="grouplist" id="9000">
			<left>page_margin</left>
			<top>612</top>
			<width>page_width</width>
			<height>dialog_row_h</height>
			<orientation>horizontal</orientation>
			<itemgap>10</itemgap>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup condition="Integer.IsGreater(Container(50).NumItems,0)">50</onup>
			<onup condition="!Integer.IsGreater(Container(50).NumItems,0)">noop</onup>
			<ondown condition="Control.IsVisible(9202)">9202</ondown>
			<ondown condition="!Control.IsVisible(9202)">noop</ondown>
			<include content="DL_DialogButton">
				<param name="id" value="12"/>
				<param name="label" value="$LOCALIZE[518]"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(12)"/>
			</include>
			<include content="DL_DialogButton">
				<param name="id" value="9"/>
				<param name="label" value="$LOCALIZE[24020]"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(9)"/>
			</include>
			<control type="radiobutton" id="13">
				<description>auto-update (Kodi labels it)</description>
				<width>238</width>
				<height>dialog_row_h</height>
				<font>ui_22_semibold</font>
				<textoffsetx>16</textoffsetx>
				<radiowidth>18</radiowidth>
				<radioheight>18</radioheight>
				<include>Dlg_Tex_DialogButton</include>
				<textureradioonnofocus colordiffuse="$VAR[DL_AccentText]">markers/check.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="$VAR[DL_OnAccent]">daylight/nib_ring.png</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="$VAR[DL_Line2]">daylight/nib_ring.png</textureradiooffnofocus>
				<visible>Control.IsEnabled(13)</visible>
			</control>
			<include content="DL_DialogButton">
				<param name="id" value="10"/>
				<param name="label" value="$LOCALIZE[39024]"/>
				<param name="width" value="220"/>
				<param name="visible" value="Control.IsEnabled(10)"/>
			</include>
			<include content="DL_DialogButton">
				<param name="id" value="7"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(7)"/>
			</include>
			<include content="DL_DialogButton">
				<param name="id" value="8"/>
				<param name="label" value="$LOCALIZE[24138]"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(8)"/>
			</include>
			<include content="DL_DialogButton">
				<param name="id" value="14"/>
				<param name="label" value="$LOCALIZE[24069]"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(14)"/>
			</include>
			<include content="DL_DialogButton">
				<param name="id" value="6"/>
				<param name="width" value="200"/>
				<param name="visible" value="Control.IsEnabled(6)"/>
			</include>
		</control>

		<!-- ====== description card -->
		<control type="group">
			<left>page_margin</left>
			<top>724</top>
			<width>1040</width>
			<height>292</height>
			<include>DL_Card</include>
			<control type="label">
				<left>40</left>
				<top>26</top>
				<width>600</width>
				<height>36</height>
				<font>serif_28</font>
				<label>$VAR[AddonInfo_TextTitle]</label>
			</control>
			<control type="button" id="9202">
				<left>760</left>
				<top>22</top>
				<width>240</width>
				<height>44</height>
				<font>ui_22_semibold</font>
				<align>center</align>
				<textoffsetx>0</textoffsetx>
				<texturefocus border="22,0,22,0" colordiffuse="$VAR[DL_Accent]">daylight/pill_44.png</texturefocus>
				<texturenofocus border="22,0,22,0" colordiffuse="$VAR[DL_Raised]">daylight/pill_44.png</texturenofocus>
				<label>$VAR[Dlg_AddonNewsLabel]</label>
				<onclick condition="String.IsEmpty(Window(Home).Property(daylight.addonnews))">SetProperty(daylight.addonnews,1,home)</onclick>
				<onclick condition="!String.IsEmpty(Window(Home).Property(daylight.addonnews))">ClearProperty(daylight.addonnews,home)</onclick>
				<onup>9000</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<visible>!String.IsEmpty(ListItem.AddonNews)</visible>
			</control>
			<control type="textbox">
				<left>40</left>
				<top>80</top>
				<width>960</width>
				<height>180</height>
				<font>body_24</font>
				<label>$VAR[AddonInfo_Text]</label>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>

		<!-- ====== details card -->
		<control type="group">
			<left>1196</left>
			<top>724</top>
			<width>604</width>
			<height>292</height>
			<include>DL_Card</include>
			<control type="label">
				<left>36</left>
				<top>26</top>
				<width>532</width>
				<height>36</height>
				<font>serif_28</font>
				<label>$LOCALIZE[31105]</label>
			</control>
			<control type="group">
				<left>36</left>
				<top>80</top>
				<include content="Dlg_FactRow"><param name="top" value="0"/><param name="label" value="Version"/><param name="value" value="$INFO[ListItem.AddonVersion]"/><param name="valuew" value="360"/></include>
				<include content="Dlg_FactRow"><param name="top" value="40"/><param name="label" value="Type"/><param name="value" value="$INFO[ListItem.AddonType]"/><param name="valuew" value="360"/></include>
				<include content="Dlg_FactRow"><param name="top" value="80"/><param name="label" value="Installed"/><param name="value" value="$INFO[ListItem.AddonInstallDate]"/><param name="valuew" value="360"/></include>
				<include content="Dlg_FactRow"><param name="top" value="120"/><param name="label" value="Status"/><param name="value" value="$INFO[ListItem.Property(Addon.Status)]"/><param name="valuew" value="360"/></include>
				<include content="Dlg_FactRow"><param name="top" value="160"/><param name="label" value="Updated"/><param name="value" value="$INFO[ListItem.AddonLastUpdated]"/><param name="valuew" value="360"/></include>
			</control>
		</control>
	</controls>
</window>
