<?xml version="1.0" encoding="UTF-8"?>
<!--
	Album / artist / song information (Daylight). Same page as the film info: hero card (cover, title,
	meta, pill buttons, artist fanart fading in from the right), a Tracklist / Discography card and an
	About card. Pieces: Includes_MusicInfo.xml (MusInfo_*). Kodi also loads this file for songs.

	Kodi id contract (Estuary Omega DialogMusicInfo.xml, GUIDialogMusicInfo.cpp / GUIDialogSongInfo.cpp):
	  50 list Kodi fills (album -> songs, artist -> discography; OK opens that album's info)
	  6 refresh (hidden by Kodi for songs) | 8 play (hidden for artists) | 12 artist / album info
	  (hidden for artists). 7 user rating and 10 choose art are deliberately not shipped.
	Daylight ids: 9000 button row (default), 9011 shuffle, 9012 play all (artist), 9001 about card
	  (OK = full text), 9200 full text overlay with scrollbar 61.

	Focus map: buttons -Down-> list 50 (the page slides up 440 px) -Right-> about 9001; Up from the
	list's top row or the about card -> buttons. Back closes (Kodi).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include content="Music_BlurSourceOnload">
		<param name="slot" value="daylight.blursrc.prev.musicinfo"/>
	</include>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include>DL_MoodLine</include>
		<include>DL_ClockOnly</include>
		<control type="group">
			<description>page (slides up while the list has focus)</description>
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(daylight.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="240" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(daylight.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="0"/>
			</animation>
			<include>MusInfo_Hero</include>
			<include>MusInfo_ListCard</include>
			<include>MusInfo_AboutCard</include>
		</control>
		<include>MusInfo_FullText</include>
	</controls>
</window>
