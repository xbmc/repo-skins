<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library (mockup DaylightFilms). Layout, ids and focus map: Includes_Views_Video.xml.
	Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav): <views> containers; 3 sort-by,
	4 sort-order (hidden, clicked by the pills); 14 watched toggle (SendClick only); menucontrol 9000;
	defaultcontrol 50 = Kodi focuses the active view.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<views>500,501,502,503,505,506,50,509</views>
	<!-- borrowed colour (TMDb Helper, optional) + minutes left until bedtime for the "fits" checks -->
	<onload condition="$EXP[DL_ArtColourOn] + !Skin.HasSetting(TMDbHelper.EnableColors)">Skin.SetBool(TMDbHelper.EnableColors)</onload>
	<onload condition="$EXP[DL_ArtColourOn]">Skin.SetString(TMDbHelper.Colors.Luminance,$VAR[DL_ColorLum])</onload>
	<onload condition="$EXP[DL_ArtColourOn]">Skin.SetString(TMDbHelper.Colors.Saturation,$VAR[DL_ColorSat])</onload>
	<onload condition="$EXP[DL_ArtColourOn]">SetProperty(TMDbHelper.Colors.SourceImage,Art(poster)||Art(tvshow.poster)||Art(thumb)||Art(fanart),home)</onload>
	<onload>SetProperty(daylight.leftmins,$VAR[DL_LeftMinsQ],home)</onload>
	<!-- empty folder: Kodi can't focus an empty view, so land on the header pills instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
