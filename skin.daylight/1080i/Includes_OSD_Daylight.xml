					<onclick>$PARAM[onclick]</onclick>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft]</onleft>
					<onleft condition="$PARAM[onleft2_if]">$PARAM[onleft2]</onleft>
					<onleft condition="$PARAM[onleft3_if]">$PARAM[onleft3]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright]</onright>
					<onright condition="$PARAM[onright2_if]">$PARAM[onright2]</onright>
					<onright condition="$PARAM[onright3_if]">$PARAM[onright3]</onright>
