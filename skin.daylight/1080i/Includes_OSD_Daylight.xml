		<animation effect="slide" end="13.3,0" time="0" condition="Integer.IsGreater(Player.SeekBar,62)">Conditional</animation>
		<animation effect="slide" end="13.3,0" time="0" condition="Integer.IsGreater(Player.SeekBar,63)">Conditional</animation>
		<animation effect="slide" end="13.3,0" time="0" condition="Integer.IsGreater(Player.SeekBar,64)">Conditional</animation>
