	<!-- circle transport button 64. params: id, icon, onclick, visible, nav (onleft/onright pairs) -->
	<include name="DLOSD_Circle">
		<param name="visible">true</param>
		<param name="onleft2">noop</param>
		<param name="onleft2_if">false</param>
		<param name="onright2">noop</param>
		<param name="onright2_if">false</param>
		<param name="onleft3">noop</param>
		<param name="onleft3_if">false</param>
		<param name="onright3">noop</param>
		<param name="onright3_if">false</param>
		<param name="onleft_if">true</param>
		<param name="onright_if">true</param>
		<param name="icon_size">28</param>
		<definition>
			<control type="group">
				<left>8</left>
				<top>8</top>
				<width>64</width>
				<height>64</height>
				<visible>$PARAM[visible]</visible>
				<animation type="Conditional" condition="Control.HasFocus($PARAM[id]) + !$EXP[ReduceMotion]" reversible="true">
					<effect type="zoom" start="100" end="106" center="auto" time="150" tween="cubic" easing="out"/>
				</animation>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>64</width>
					<height>64</height>
