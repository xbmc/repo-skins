<?xml version="1.0" encoding="UTF-8"?>
<!--
	Picture details / EXIF (Daylight). A soft card on the right with the file name and Kodi's detail
	list; the picture sits in a rounded frame on the left unless the slideshow is behind the dialog
	(then the card floats over the photo on the panel colour).
	Kodi id contract (Estuary Omega DialogPictureInfo.xml): group 9000 holding info list 5 and its
	scrollbar 60. Left / Right on the list close the dialog and step to the previous / next picture
	(Estuary behaviour). Back closes.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<!-- picture (not over the slideshow) -->
		<control type="group">
			<visible>!Window.IsActive(slideshow)</visible>
			<include>DL_Background</include>
			<include>DL_MoodLine</include>
			<include>DL_ClockOnly</include>
			<control type="group">
				<left>page_margin</left>
				<top>168</top>
				<width>1000</width>
				<height>848</height>
				<include>DL_Card</include>
				<control type="image">
					<left>24</left>
					<top>24</top>
					<width>952</width>
					<height>800</height>
					<aspectratio>keep</aspectratio>
					<fadetime>160</fadetime>
					<texture background="true">$INFO[ListItem.FolderPath]</texture>
				</control>
			</control>
		</control>
		<!-- details card -->
		<control type="group">
			<left>1180</left>
			<top>168</top>
			<width>620</width>
			<height>848</height>
			<include content="DL_Card">
				<param name="color" value="$VAR[DL_Panel]"/>
			</include>
			<control type="label">
				<left>36</left>
				<top>30</top>
				<width>548</width>
				<height>28</height>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_AccentText]</textcolor>
				<label>Picture details$INFO[Slideshow.SlideIndex,  ·  ,]</label>
			</control>
			<control type="label">
				<left>36</left>
				<top>62</top>
				<width>548</width>
				<height>48</height>
				<font>serif_32</font>
				<label>$VAR[PicInfo_Name]</label>
			</control>
			<control type="group" id="9000">
				<control type="list" id="5">
					<left>20</left>
					<top>130</top>
					<width>560</width>
					<height>690</height>
					<orientation>vertical</orientation>
					<onleft>Dialog.Close(all,true)</onleft>
					<onleft>Action(left)</onleft>
					<onleft>info</onleft>
					<onright>Dialog.Close(all,true)</onright>
					<onright>Action(right)</onright>
					<onright>info</onright>
					<onup>5</onup>
					<ondown>5</ondown>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<itemlayout width="560" height="60">
						<include content="DL_DetailRow">
							<param name="id" value="5"/>
						</include>
					</itemlayout>
					<focusedlayout width="560" height="60">
						<include content="DL_DetailRow">
							<param name="id" value="5"/>
							<param name="focused" value="true"/>
						</include>
					</focusedlayout>
				</control>
				<include content="DL_Scrollbar">
					<param name="id" value="60"/>
					<param name="left" value="590"/>
					<param name="top" value="130"/>
					<param name="height" value="690"/>
					<param name="onleft" value="5"/>
					<param name="onright" value="5"/>
				</include>
			</control>
		</control>
	</controls>
</window>
