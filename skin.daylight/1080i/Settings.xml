<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings hub (window "settings"): a soft list (label + quiet hint) + a right-hand column with what the focused entry holds and a few system facts.
	No Kodi-owned ids; entries/actions copied from Estuary Omega Settings.xml, Daylight's settings
	first. File manager / System info / Event log / Profiles windows come from Builder F.
-->
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include content="DL_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$LOCALIZE[5]"/>
		</include>

		<control type="group">
			<left>page_margin</left>
			<top>content_top</top>
			<width>900</width>
			<height>848</height>
			<include>DL_Card</include>
		</control>
		<control type="list" id="9000">
			<left>138</left>
			<top>188</top>
			<width>864</width>
			<height>808</height>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="Dlg_IndexListLayout">
				<param name="width" value="860"/>
				<param name="height" value="72"/>
				<param name="list_id" value="9000"/>
			</include>
			<content>
				<item>
					<label>$LOCALIZE[31200]</label>
					<label2>$LOCALIZE[31255]</label2>
					<property name="index">[UPPERCASE]01[/UPPERCASE]</property>
					<property name="help">Daylight's own options: mood, bedtime, weather row, borrowed colour, markers, playback and motion.</property>
					<onclick>ActivateWindow(skinsettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14200]</label>
					<label2>$LOCALIZE[31256]</label2>
					<property name="index">[UPPERCASE]02[/UPPERCASE]</property>
					<property name="help">Video and music playback, refresh-rate matching, subtitle languages and look, discs.</property>
					<onclick>ActivateWindow(PlayerSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14211]</label>
					<label2>$LOCALIZE[31257]</label2>
					<property name="index">[UPPERCASE]03[/UPPERCASE]</property>
					<property name="help">Library behaviour, scrapers, file lists, artwork and what OK does on an item.</property>
					<onclick>ActivateWindow(MediaSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14206]</label>
					<label2>$LOCALIZE[31258]</label2>
					<property name="index">[UPPERCASE]04[/UPPERCASE]</property>
					<property name="help">Skin, colours, fonts, region and language, screensaver. Switch to another skin here: Skin > Skin.</property>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[24001]</label>
					<label2>$LOCALIZE[31259]</label2>
					<property name="index">[UPPERCASE]05[/UPPERCASE]</property>
					<property name="help">Browse, update, configure or install add-ons.</property>
					<onclick>ActivateWindow(addonbrowser)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14036]</label>
					<label2>$LOCALIZE[31260]</label2>
					<property name="index">[UPPERCASE]06[/UPPERCASE]</property>
					<property name="help">Web server and JSON-RPC control, UPnP, AirPlay, Zeroconf, SMB client.</property>
					<onclick>ActivateWindow(ServiceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13000]</label>
					<label2>$LOCALIZE[31261]</label2>
					<property name="index">[UPPERCASE]07[/UPPERCASE]</property>
					<property name="help">Display, audio output and passthrough, input, power saving, logging.</property>
					<onclick>ActivateWindow(SystemSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[10003]</label>
					<label2>$LOCALIZE[31262]</label2>
					<property name="index">[UPPERCASE]08[/UPPERCASE]</property>
					<property name="help">Copy, move and delete files; add network sources.</property>
					<onclick>ActivateWindow(filemanager)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[138]</label>
					<label2>$LOCALIZE[31263]</label2>
					<property name="index">[UPPERCASE]09[/UPPERCASE]</property>
					<property name="help">Kodi version, video renderer, storage, network and hardware details.</property>
					<onclick>ActivateWindow(systeminfo)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[31264]</label>
					<label2>$LOCALIZE[31265]</label2>
					<property name="index">[UPPERCASE]10[/UPPERCASE]</property>
					<property name="help">What Kodi has done recently: scans, add-on updates, errors.</property>
					<onclick>ActivateWindow(eventlog)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13200]</label>
					<label2>$LOCALIZE[31266]</label2>
					<property name="index">[UPPERCASE]11[/UPPERCASE]</property>
					<property name="help">Profiles and the login screen.</property>
					<onclick>ActivateWindow(Profiles)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14204]</label>
					<label2>$LOCALIZE[31267]</label2>
					<property name="index">[UPPERCASE]12[/UPPERCASE]</property>
					<property name="help">Live TV and PVR. Daylight only gives these screens a plain layout.</property>
					<onclick>ActivateWindow(PVRSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[15016]</label>
					<label2>$LOCALIZE[31268]</label2>
					<property name="index">[UPPERCASE]13[/UPPERCASE]</property>
					<property name="help">Games and controllers.</property>
					<onclick>ActivateWindow(GameSettings)</onclick>
					<visible>System.GetBool(gamesgeneral.enable)</visible>
				</item>
			</content>
		</control>

		<!-- ====== right column: what the entry holds + this box -->
		<control type="group">
			<left>1060</left>
			<top>content_top</top>
			<width>740</width>
			<height>380</height>
			<include>DL_Card</include>
			<control type="image">
				<left>40</left>
				<top>40</top>
				<width>28</width>
				<height>28</height>
				<texture colordiffuse="$VAR[DL_AccentText]">daylight/icons/settings.png</texture>
			</control>
			<control type="label">
				<left>82</left>
				<top>38</top>
				<width>620</width>
				<height>32</height>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_AccentText]</textcolor>
				<label>$INFO[Container(9000).ListItem.Label2]</label>
			</control>
			<control type="label">
				<left>40</left>
				<top>86</top>
				<width>660</width>
				<height>64</height>
				<font>display_48</font>
				<label>$INFO[Container(9000).ListItem.Label]</label>
			</control>
			<control type="textbox">
				<left>40</left>
				<top>170</top>
				<width>660</width>
				<height>170</height>
				<font>body_24</font>
				<label>$INFO[Container(9000).ListItem.Property(help)]</label>
			</control>
		</control>
		<control type="group">
			<left>1060</left>
			<top>588</top>
			<width>740</width>
			<height>428</height>
			<include>DL_Card</include>
			<control type="label">
				<left>40</left>
				<top>34</top>
				<width>660</width>
				<height>40</height>
				<font>serif_28</font>
				<label>$LOCALIZE[31269]</label>
			</control>
			<control type="group">
				<left>40</left>
				<top>100</top>
				<include content="Dlg_FactRow"><param name="top" value="0"/><param name="label" value="Kodi"/><param name="value" value="$INFO[System.BuildVersionShort]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="54"/><param name="label" value="Skin"/><param name="value" value="Daylight $INFO[System.AddonVersion(skin.daylight)]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="108"/><param name="label" value="Address"/><param name="value" value="$INFO[Network.IPAddress]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="162"/><param name="label" value="Screen"/><param name="value" value="$INFO[System.ScreenResolution]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="216"/><param name="label" value="Up"/><param name="value" value="$INFO[System.Uptime]"/></include>
			</control>
		</control>
	</controls>
</window>
