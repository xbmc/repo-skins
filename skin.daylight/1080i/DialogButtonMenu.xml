<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi's power / shutdown menu ("shutdownmenu", M4, Builder E). Items and conditions copied from
	Estuary Omega DialogButtonMenu.xml; numbered Index list. The panel hangs from y 260 and is sized to
	the visible items (the power entries depend on the platform). Id contract: list 9000.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<top>260</top>
			<width>640</width>
			<height>656</height>
			<control type="group">
				<top>0</top>
				<height>248</height>
				<visible>!Integer.IsGreater(Container(9000).NumItems,2)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="248"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>316</height>
				<visible>Integer.IsEqual(Container(9000).NumItems,3)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="316"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>384</height>
				<visible>Integer.IsEqual(Container(9000).NumItems,4)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="384"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>452</height>
				<visible>Integer.IsEqual(Container(9000).NumItems,5)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="452"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>520</height>
				<visible>Integer.IsEqual(Container(9000).NumItems,6)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="520"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>588</height>
				<visible>Integer.IsEqual(Container(9000).NumItems,7)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="588"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="group">
				<top>0</top>
				<height>656</height>
				<visible>Integer.IsGreaterOrEqual(Container(9000).NumItems,8)</visible>
				<include content="DL_GenericDialog">
					<param name="width" value="640"/>
					<param name="height" value="656"/>
					<param name="header_label" value="$LOCALIZE[31022]"/>
					<param name="kicker" value="$INFO[System.Time(hh:mm)]"/>
				</include>
			</control>
			<control type="list" id="9000">
				<top>100</top>
				<left>12</left>
				<width>616</width>
				<height>544</height>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="616"/>
					<param name="height" value="68"/>
					<param name="list_id" value="9000"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[13012]</label>
						<label2></label2>
						<property name="index">[UPPERCASE]01[/UPPERCASE]</property>
						<onclick>Quit()</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<item>
						<label>$LOCALIZE[13016]</label>
						<label2></label2>
						<property name="index">[UPPERCASE]02[/UPPERCASE]</property>
						<onclick>Powerdown()</onclick>
						<visible>System.CanPowerDown</visible>
					</item>
					<item>
						<label>$LOCALIZE[13011]</label>
						<label2></label2>
						<property name="index">[UPPERCASE]03[/UPPERCASE]</property>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Suspend()</onclick>
						<visible>System.CanSuspend</visible>
					</item>
					<item>
						<label>$LOCALIZE[13010]</label>
						<label2></label2>
						<property name="index">[UPPERCASE]04[/UPPERCASE]</property>
						<onclick>Dialog.Close(shutdownmenu)</onclick>
						<onclick>Hibernate()</onclick>
						<visible>System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[13013]</label>
						<label2></label2>
						<property name="index">[UPPERCASE]05[/UPPERCASE]</property>
						<onclick>Reset()</onclick>
						<visible>System.CanReboot</visible>
					</item>
					<item>
						<label>$LOCALIZE[20150]</label>
						<label2>$LOCALIZE[31209]</label2>
						<property name="index">[UPPERCASE]06[/UPPERCASE]</property>
						<onclick>AlarmClock(shutdowntimer,Shutdown())</onclick>
						<visible>!System.HasAlarm(shutdowntimer)</visible>
						<visible>System.CanPowerDown | System.CanSuspend | System.CanHibernate</visible>
					</item>
					<item>
						<label>$LOCALIZE[20151]</label>
						<label2>$INFO[System.AlarmPos]</label2>
						<property name="index">[UPPERCASE]07[/UPPERCASE]</property>
						<onclick>CancelAlarm(shutdowntimer)</onclick>
						<visible>System.HasAlarm(shutdowntimer)</visible>
					</item>
					<item>
						<label>$LOCALIZE[20126]</label>
						<label2>$INFO[System.ProfileName]</label2>
						<property name="index">[UPPERCASE]08[/UPPERCASE]</property>
						<onclick>Dialog.Close(all,true)</onclick>
						<onclick>System.LogOff</onclick>
						<visible>System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)</visible>
						<visible>System.Loggedon</visible>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
