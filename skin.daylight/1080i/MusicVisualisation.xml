<?xml version="1.0" encoding="UTF-8"?>
<!--
	Now playing (Daylight): the mood background, a big rounded cover card on the left, the song set
	in Fraunces on the right with a rounded track ("ends 4:12 PM"), and an Up next card along the
	bottom. MusicOSD.xml floats its control panel over the Up next card. Pieces: Includes_NowPlaying.xml.

	Kodi id contract (Estuary Omega MusicVisualisation.xml / GUIWindowVisualisation.cpp):
	  2 = visualisation control. Only drawn when a visualisation add-on is enabled; then the page
	  steps aside to a small title card and comes back on Info / OSD.
	No focusable controls (Kodi routes OK / Menu to MusicOSD, Back to the previous window).
-->
<window>
	<defaultcontrol></defaultcontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<control type="visualisation" id="2">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<visible>Player.HasAudio + Visualisation.Enabled</visible>
		</control>
		<!-- over a visualisation: on Info / OSD the page comes back on its own background -->
		<control type="group">
			<visible>Visualisation.Enabled + [Player.ShowInfo | Window.IsVisible(musicosd)]</visible>
			<include>Anim_FadeVisible</include>
			<include>DL_Background</include>
		</control>
		<control type="group">
			<visible>!Visualisation.Enabled | Player.ShowInfo | Window.IsVisible(musicosd)</visible>
			<include>Anim_FadeVisible</include>
			<include>DL_MoodLine</include>
			<include>DL_ClockOnly</include>
			<include>NP_Cover</include>
			<include>NP_TextColumn</include>
			<include>NP_Progress</include>
			<include>NP_UpNext</include>
		</control>
		<!-- compact card over a running visualisation -->
		<include>NP_VisCard</include>
	</controls>
</window>
