<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library (Daylight): same composition as Films - detail panel on the left (square cover,
	title, artist, meta, description), a soft card on the right with the cover grid or the list.
	Views: 504 Grid (albums, artists, genres with art; 0.9.18 also songs), 508 Wall (albums, artists, genres, full
	page), 507 Spotlight (artists, albums; 0.9.18 also songs: the artist's fanart, the song, its album notes), 50 List
	(songs, everything else).
	Header (inside the card): tabs Albums · Artists · Songs · Genres (grouplist 9001) on the left,
	Sort / order / View pills (9002) on the right, both inside group 9000 (menucontrol).
	Kodi ids (Estuary Omega MyMusicNav.xml): 3 sort by, 4 sort order (hidden, clicked by the pills).
-->
<includes>
	<variable name="MusicView_Title">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value condition="String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Album)">$INFO[ListItem.Album]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="MusicView_Kicker">
		<value condition="ListItem.IsParentFolder">Up one level</value>
		<value condition="String.IsEqual(ListItem.DBType,album) + !String.IsEmpty(ListItem.Property(Album_ReleaseType)) + !String.IsEqual(ListItem.Property(Album_ReleaseType),album)">Album  ·  $INFO[ListItem.Property(Album_ReleaseType)]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">Album</value>
		<value condition="String.IsEqual(ListItem.DBType,artist)">Artist</value>
		<value condition="String.IsEqual(ListItem.DBType,song)">Song$INFO[ListItem.TrackNumber,  ·  track ,]</value>
		<value>$INFO[Container.FolderName]</value>
	</variable>
	<variable name="MusicView_Sub">
		<value condition="String.IsEqual(ListItem.DBType,song)">$INFO[ListItem.Artist]$INFO[ListItem.Album,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Artist]</value>
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Genre]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<variable name="MusicView_Meta">
		<value condition="String.IsEqual(ListItem.DBType,song)">$INFO[ListItem.Duration]$INFO[ListItem.Year,  ·  ,]$INFO[ListItem.Genre,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Year]$INFO[ListItem.Genre,  ·  ,]$INFO[ListItem.Property(Album_Label),  ·  ,]</value>
		<value>$INFO[ListItem.Year]</value>
	</variable>
	<variable name="MusicView_Art">
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(album.thumb))">$INFO[ListItem.Art(album.thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- tile captions: the songs node's Label is Kodi's "01. Artist - Title", so songs print the title -->
	<variable name="MusicView_TileLabel">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<!-- ============================================================ grid item -->
	<include name="MusicView_GridItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>18</left>
				<top>18</top>
				<width>184</width>
				<height>184</height>
				<animation type="Focus" reversible="true" condition="$PARAM[focused] + !$EXP[ReduceMotion]">
					<effect type="zoom" start="100" end="106" center="auto" time="160" tween="cubic" easing="out"/>
				</animation>
				<include content="VidView_ArtFallback">
					<param name="mask" value="masks/square_round8.png"/>
					<param name="label_visible" value="String.IsEmpty(ListItem.Art(thumb))"/>
				</include>
				<include content="VidView_ArtImage">
					<param name="art" value="$VAR[MusicView_Art]"/>
					<param name="mask" value="masks/square_round8.png"/>
					<param name="fade" value="160"/>
				</include>
				<include content="DL_FocusRing" condition="$PARAM[focused]">
					<param name="r" value="16"/>
					<param name="visible" value="Control.HasFocus(504)"/>
				</include>
			</control>
			<control type="label">
				<left>18</left>
				<top>214</top>
				<width>184</width>
				<height>28</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<label>$VAR[MusicView_TileLabel]</label>
			</control>
			<control type="label">
				<left>18</left>
				<top>242</top>
				<width>184</width>
				<height>26</height>
				<font>small_20</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>$INFO[ListItem.Artist]</label>
				<visible>String.IsEqual(ListItem.DBType,album) | String.IsEqual(ListItem.DBType,song)</visible>
			</control>
		</definition>
	</include>

	<include name="Music_View_504">
		<control type="group">
		<visible>Control.IsVisible(504)</visible>
		<include>Anim_FadeVisible</include>
		<control type="panel" id="504">
			<left>vv_grid_x</left>
			<top>vv_grid_y</top>
			<width>vv_grid_w</width>
			<height>vv_grid_h</height>
			<orientation>vertical</orientation>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<onleft>ActivateWindow(1160)</onleft>  <!-- 0.9.8: past the first / last column = Library panel -->
			<onright>ActivateWindow(1160)</onright>
			<preloaditems>2</preloaditems>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<viewtype label="31312">icon</viewtype>
			<visible>Container.Content(albums) | Container.Content(artists) | Container.Content(genres) | Container.Content(years) | Container.Content(songs)</visible>
			<itemlayout width="214" height="282">
				<include>MusicView_GridItem</include>
			</itemlayout>
			<focusedlayout width="214" height="282">
				<include content="MusicView_GridItem"><param name="focused" value="true"/></include>
			</focusedlayout>
		</control>
		</control>
	</include>

	<!-- ============================================================ list rows (songs and the rest) -->
	<include name="MusicView_SongRow">
		<param name="focused">false</param>
		<param name="ink">$VAR[DL_Ink]</param>
		<param name="ink2">$VAR[DL_Ink2]</param>
		<definition>
			<control type="image">
				<left>4</left>
				<top>4</top>
				<width>1068</width>
				<height>68</height>
				<texture border="24" colordiffuse="$VAR[DL_Accent]">daylight/card20.png</texture>
				<visible>$PARAM[focused] + Control.HasFocus(50)</visible>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>56</width>
				<height>76</height>
				<align>right</align>
				<font>num_21</font>
				<textcolor>$PARAM[ink2]</textcolor>
				<label>$INFO[ListItem.TrackNumber]</label>
			</control>
			<control type="label">
				<left>104</left>
				<top>0</top>
				<width>640</width>
				<height>76</height>
				<font>ui_24</font>
				<textcolor>$PARAM[ink]</textcolor>
				<label>$VAR[MusicView_Title]</label>
			</control>
			<control type="label">
				<left>760</left>
				<top>0</top>
				<width>190</width>
				<height>76</height>
				<font>small_20</font>
				<textcolor>$PARAM[ink2]</textcolor>
				<label>$INFO[ListItem.Artist]</label>
			</control>
			<control type="label">
				<left>950</left>
				<top>0</top>
				<width>100</width>
				<height>76</height>
				<align>right</align>
				<font>num_21</font>
				<textcolor>$PARAM[ink2]</textcolor>
				<label>$INFO[ListItem.Duration]</label>
			</control>
		</definition>
	</include>
	<variable name="MusicView_FocusInk">
		<value condition="Control.HasFocus(50)">$VAR[DL_OnAccent]</value>
		<value>$VAR[DL_Ink]</value>
	</variable>
	<variable name="MusicView_FocusInk2">
		<value condition="Control.HasFocus(50)">$VAR[DL_OnAccent]</value>
		<value>$VAR[DL_Ink2]</value>
	</variable>

	<include name="Music_View_50">
		<control type="group">
		<visible>Control.IsVisible(50)</visible>
		<include>Anim_FadeVisible</include>
		<control type="list" id="50">
			<left>702</left>
			<top>vv_grid_y</top>
			<width>1076</width>
			<height>vv_grid_h</height>
			<orientation>vertical</orientation>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<onleft>ActivateWindow(1160)</onleft>  <!-- 0.9.8: past the first / last column = Library panel -->
			<onright>ActivateWindow(1160)</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<viewtype label="535">list</viewtype>
			<itemlayout width="1076" height="76" condition="Container.Content(songs)">
				<include>MusicView_SongRow</include>
			</itemlayout>
			<focusedlayout width="1076" height="76" condition="Container.Content(songs)">
				<include content="MusicView_SongRow"><param name="focused" value="true"/><param name="ink" value="$VAR[MusicView_FocusInk]"/><param name="ink2" value="$VAR[MusicView_FocusInk2]"/></include>
			</focusedlayout>
			<itemlayout width="1076" height="76" condition="!Container.Content(songs)">
				<include>DL_LibListRow</include>
			</itemlayout>
			<focusedlayout width="1076" height="76" condition="!Container.Content(songs)">
				<include content="DL_LibListRow"><param name="focused" value="true"/></include>
			</focusedlayout>
		</control>
		</control>
	</include>

	<!-- ============================================================ 0.9.15 views
	     508 Wall       the whole page of covers, 8 across (artists as round portraits); no detail panel.
	     507 Spotlight  the focused artist or album large (fanart melting into the card, or the portrait /
	                    cover standing on it when there is no fanart; biography / album notes) over a
	                    strip of portraits or covers (list 507).
	     Both span the page in the wide card (MusicView_Wide); tabs slide to the card's left edge. -->
	<expression name="MusicView_Wide">Control.IsVisible(507) | Control.IsVisible(508)</expression>
	<expression name="MusicView_IsArtist">String.IsEqual(ListItem.DBType,artist)</expression>

	<!-- one wall cover (508) -->
	<include name="MusicView_WallItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<left>18</left>
				<top>18</top>
				<width>168</width>
				<height>168</height>
				<animation type="Focus" reversible="true" condition="$PARAM[focused] + !$EXP[ReduceMotion]">
					<effect type="zoom" start="100" end="106" center="auto" time="160" tween="cubic" easing="out"/>
				</animation>
				<!-- square card / round portrait placeholder -->
				<include content="VidView_ParentTile">
					<param name="icon" value="36"/>
					<param name="caption_visible" value="false"/>
				</include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture diffuse="daylight/mask_circle.png" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
					<visible>!ListItem.IsParentFolder + String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture diffuse="masks/square_round8.png" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
					<visible>!ListItem.IsParentFolder + !String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>44</width>
					<height>44</height>
					<texture colordiffuse="$VAR[DL_Ink3]">daylight/icons/music.png</texture>
					<visible>!ListItem.IsParentFolder + String.IsEmpty(ListItem.Art(thumb))</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>160</fadetime>
					<texture background="true" diffuse="daylight/mask_circle.png" colordiffuse="$VAR[DL_ArtDim]">$VAR[MusicView_Art]</texture>
					<visible>!ListItem.IsParentFolder + String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>160</fadetime>
					<texture background="true" diffuse="masks/square_round8.png" colordiffuse="$VAR[DL_ArtDim]">$VAR[MusicView_Art]</texture>
					<visible>!ListItem.IsParentFolder + !String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="group">
					<visible>$PARAM[focused] + Control.HasFocus(508) + !$EXP[MusicView_IsArtist]</visible>
					<include content="DL_FocusRing"><param name="r" value="14"/></include>
				</control>
				<control type="group">
					<visible>$PARAM[focused] + Control.HasFocus(508) + $EXP[MusicView_IsArtist]</visible>
					<control type="image">
						<left>-9</left>
						<top>-9</top>
						<right>-9</right>
						<bottom>-9</bottom>
						<texture colordiffuse="$VAR[DL_Accent]">daylight/ring_circle.png</texture>
					</control>
				</control>
			</control>
			<control type="label">
				<left>18</left>
				<top>198</top>
				<width>168</width>
				<height>28</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<selectedcolor>$VAR[DL_Ink]</selectedcolor>
				<label>$VAR[Music_ItemLabel]</label>
				<visible>!$EXP[MusicView_IsArtist]</visible>
			</control>
			<control type="label">
				<left>10</left>
				<top>198</top>
				<width>184</width>
				<height>28</height>
				<align>center</align>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink]</textcolor>
				<selectedcolor>$VAR[DL_Ink]</selectedcolor>
				<label>$VAR[Music_ItemLabel]</label>
				<visible>$EXP[MusicView_IsArtist]</visible>
			</control>
			<control type="label">
				<left>18</left>
				<top>224</top>
				<width>168</width>
				<height>26</height>
				<font>small_20</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<selectedcolor>$VAR[DL_Ink2]</selectedcolor>
				<label>$INFO[ListItem.Artist]</label>
				<visible>String.IsEqual(ListItem.DBType,album)</visible>
			</control>
		</definition>
	</include>
	<include name="Music_View_508">
		<control type="group">
		<visible>Control.IsVisible(508)</visible>
		<include>Anim_FadeVisible</include>
		<control type="panel" id="508">
			<left>142</left>
			<top>vv_grid_y</top>
			<width>1636</width>
			<height>vv_grid_h</height>
			<orientation>vertical</orientation>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<onleft>ActivateWindow(1160)</onleft>  <!-- past the first / last column = Library panel -->
			<onright>ActivateWindow(1160)</onright>
			<preloaditems>2</preloaditems>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<viewtype label="31313">wrap</viewtype>
			<visible>Container.Content(albums) | Container.Content(artists) | Container.Content(genres) | Container.Content(years)</visible>
			<itemlayout width="204" height="262">
				<include>MusicView_WallItem</include>
			</itemlayout>
			<focusedlayout width="204" height="262">
				<include content="MusicView_WallItem"><param name="focused" value="true"/></include>
			</focusedlayout>
		</control>
		</control>
	</include>

	<!-- ============================================================ Spotlight (507) -->
	<expression name="MusicView_SpotHasFanart">!ListItem.IsParentFolder + [!String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(artist.fanart)) | !String.IsEmpty(ListItem.Art(albumartist.fanart))]</expression>
	<variable name="MusicView_SpotFanart">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(artist.fanart))">$INFO[ListItem.Art(artist.fanart)]</value>
		<value>$INFO[ListItem.Art(albumartist.fanart)]</value>
	</variable>
	<variable name="MusicView_SpotKicker">
		<value condition="ListItem.IsParentFolder">Up one level</value>
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_Type))">$INFO[ListItem.Property(Artist_Type)]</value>
		<value condition="$EXP[MusicView_IsArtist]">Artist</value>
		<value>$VAR[MusicView_Kicker]</value>
	</variable>
	<variable name="MusicView_SpotSub">
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_Formed))">Formed $INFO[ListItem.Property(Artist_Formed)]$INFO[ListItem.Property(Artist_Disbanded),  ·  split ,]</value>
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_Born))">Born $INFO[ListItem.Property(Artist_Born)]$INFO[ListItem.Property(Artist_Died),  ·  died ,]</value>
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_YearsActive))">Active $INFO[ListItem.Property(Artist_YearsActive)]</value>
		<value condition="$EXP[MusicView_IsArtist]"></value>
		<value>$VAR[MusicView_Sub]</value>
	</variable>
	<variable name="MusicView_SpotMeta">
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_Style))">$INFO[ListItem.Property(Artist_Style)]</value>
		<value condition="$EXP[MusicView_IsArtist] + !String.IsEmpty(ListItem.Property(Artist_Genre))">$INFO[ListItem.Property(Artist_Genre)]</value>
		<value condition="$EXP[MusicView_IsArtist]">$INFO[ListItem.Genre]</value>
		<value>$VAR[MusicView_Meta]</value>
	</variable>
	<variable name="MusicView_SpotText">
		<value condition="$EXP[MusicView_IsArtist]">$INFO[ListItem.Property(Artist_Description)]</value>
		<value>$INFO[ListItem.Property(Album_Description)]</value>
	</variable>
	<include name="MusicView_SpotHero">
		<control type="group">
			<left>page_margin</left>
			<top>168</top>
			<width>page_width</width>
			<height>520</height>
			<visible>Control.IsVisible(507) + Integer.IsGreater(Container.NumItems,0)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>540</left>
				<top>0</top>
				<width>1140</width>
				<height>520</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<fadetime>240</fadetime>
				<texture background="true" diffuse="daylight/mask_spot.png" colordiffuse="$VAR[DL_ArtDim]">$VAR[MusicView_SpotFanart]</texture>
				<visible>$EXP[MusicView_SpotHasFanart]</visible>
			</control>
			<!-- no fanart: the portrait (round) or the cover (rounded square) stands on the card -->
			<control type="group">
				<left>1250</left>
				<top>90</top>
				<width>340</width>
				<height>340</height>
				<visible>!$EXP[MusicView_SpotHasFanart] + !ListItem.IsParentFolder + !String.IsEmpty(ListItem.Art(thumb))</visible>
				<control type="image">
					<left>-120</left>
					<top>-90</top>
					<right>-120</right>
					<bottom>-150</bottom>
					<texture border="120" colordiffuse="$VAR[DL_Shadow]">daylight/card_shadow.png</texture>
					<visible>!$EXP[MusicView_IsArtist]</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true" diffuse="daylight/mask_circle.png" colordiffuse="$VAR[DL_ArtDim]">$INFO[ListItem.Art(thumb)]</texture>
					<visible>String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>200</fadetime>
					<texture background="true" diffuse="masks/square_round8_large.png" colordiffuse="$VAR[DL_ArtDim]">$INFO[ListItem.Art(thumb)]</texture>
					<visible>!String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
			</control>
			<!-- no picture at all (many artists): a raised disc / card with the music glyph keeps the place -->
			<control type="group">
				<left>1250</left>
				<top>90</top>
				<width>340</width>
				<height>340</height>
				<visible>!$EXP[MusicView_SpotHasFanart] + !ListItem.IsParentFolder + String.IsEmpty(ListItem.Art(thumb))</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>340</width>
					<height>340</height>
					<texture diffuse="daylight/mask_circle.png" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
					<visible>String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>340</width>
					<height>340</height>
					<texture diffuse="masks/square_round8_large.png" colordiffuse="$VAR[DL_Raised]">common/white.png</texture>
					<visible>!String.IsEqual(ListItem.DBType,artist)</visible>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>96</width>
					<height>96</height>
					<texture colordiffuse="$VAR[DL_Ink3]">daylight/icons/music.png</texture>
				</control>
			</control>
			<control type="image">
				<left>40</left>
				<top>113</top>
				<width>10</width>
				<height>10</height>
				<texture colordiffuse="$VAR[DL_Accent]">daylight/circle_12.png</texture>
			</control>
			<control type="label">
				<left>60</left>
				<top>104</top>
