	<!-- Segmented pills: the current option is filled (accent while the row has focus, soft line
	     colour otherwise); the frame is a 2 px pill outline drawn after the options.
	     Dlg_SegOption params: left, width, label, selected (condition), row (row button id) -->
	<include name="Dlg_SegOption">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>24</top>
				<width>$PARAM[width]</width>
				<height>52</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>52</height>
					<texture border="26,0,26,0" colordiffuse="$VAR[DL_Line2]">daylight/pill_52.png</texture>
					<visible>[$PARAM[selected]] + !Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>52</height>
					<texture border="26,0,26,0" colordiffuse="$VAR[DL_Accent]">daylight/pill_52.png</texture>
					<visible>[$PARAM[selected]] + Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>52</height>
					<align>center</align>
					<font>ui_22_bold</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$PARAM[label]</label>
					<visible>[$PARAM[selected]] + Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>52</height>
					<align>center</align>
					<font>ui_22_bold</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$PARAM[label]</label>
					<visible>[$PARAM[selected]] + !Control.HasFocus($PARAM[row])</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>52</height>
					<align>center</align>
					<font>ui_22</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$PARAM[label]</label>
					<visible>![$PARAM[selected]]</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="Dlg_SegFrame">
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
