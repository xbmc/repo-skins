<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings pieces (owner: Builder E). Used by Settings.xml, SettingsCategory.xml, DialogSettings.xml,
	DialogAddonSettings.xml and SkinSettings.xml.

	Kodi-cloned rows (templates 7-15, category 10): Kodi builds each setting as ONE control, so the
	row look lives in its textures: <texturenofocus> = 1px hairline at the bottom (media/dialogs/
	row_rule.png), <texturefocus> = 2px accent frame drawn inside the row. Kodi gives label and value
	the same font/colour, so the value column can't be mono here (SkinSettings, which Daylight draws
	itself, does use mono/segmented values). Id plans copied from Estuary Omega.
-->
<includes>
	<!-- ============================================================ Kodi-cloned templates -->
	<!-- Look of one setting row. params: width, height, font -->
	<include name="DL_SettingRow">
		<param name="width">1264</param>
		<param name="height">settings_row_h</param>
		<param name="font">ui_25_semibold</param>
		<definition>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<font>$PARAM[font]</font>
			<textcolor>$VAR[DL_Ink]</textcolor>
			<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
			<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
			<invalidcolor>ffe5484d</invalidcolor>
			<selectedcolor>$VAR[DL_Ink]</selectedcolor>
			<textoffsetx>20</textoffsetx>
			<aligny>center</aligny>
			<pulseonselect>false</pulseonselect>
			<include>Dlg_Tex_RowFocus</include>
			<include content="Dlg_Tex_RowRule"/>
		</definition>
	</include>

	<!-- The full template set (ids 7 button, 8 radio, 9 spin, 11 separator, 12 edit, 13 slider,
	     14 group heading, 15 colour). params: width, height, font -->
	<include name="DL_SettingTemplates">
		<param name="width">1264</param>
		<param name="height">settings_row_h</param>
		<param name="font">ui_25_semibold</param>
		<definition>
			<control type="button" id="7">
				<description>Default Button</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="radiobutton" id="8">
				<description>Default RadioButton</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<radiowidth>24</radiowidth>
				<radioheight>24</radioheight>
			</control>
			<control type="spincontrolex" id="9">
				<description>Default SpinControlex</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="image" id="11">
				<description>separator</description>
				<width>$PARAM[width]</width>
				<height>2</height>
				<texture colordiffuse="$VAR[DL_Line]">common/white.png</texture>
			</control>
			<control type="edit" id="12">
				<description>Default Edit</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="sliderex" id="13">
				<description>Default Slider</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<sliderwidth>220</sliderwidth>
				<sliderheight>12</sliderheight>
			</control>
			<control type="label" id="14">
				<description>Default Label (group heading)</description>
				<width>$PARAM[width]</width>
				<height>56</height>
				<textoffsetx>20</textoffsetx>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_AccentText]</textcolor>
				<aligny>center</aligny>
			</control>
			<control type="colorbutton" id="15">
				<description>Default ColorButton</description>
				<include content="DL_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- Category button template (id 10): Settings.dc.html categories - hairline on top, 28px label,
	     tertiary at rest, primary + accent frame on focus. param: width -->
	<include name="DL_SettingCategoryTemplate">
		<param name="width">380</param>
		<definition>
			<control type="button" id="10">
				<description>Default Category Button</description>
				<width>$PARAM[width]</width>
				<height>72</height>
				<font>ui_28</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
				<selectedcolor>$VAR[DL_Ink]</selectedcolor>
				<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
				<textoffsetx>20</textoffsetx>
				<aligny>center</aligny>
				<pulseonselect>false</pulseonselect>
				<include>Dlg_Tex_RowFocus</include>
				<include content="Dlg_Tex_RowRule"><param name="flip" value="true"/></include>
			</control>
		</definition>
	</include>

	<!-- Settings level toggle (id 20: Basic / Standard / Advanced / Expert, Kodi writes the label).
	     params: width, onup, ondown, onleft, onright -->
	<include name="DL_SettingLevelButton">
		<param name="width">380</param>
		<param name="onup">3</param>
		<param name="ondown">3</param>
		<param name="onleft">5</param>
		<param name="onright">5</param>
		<definition>
			<control type="button" id="20">
				<width>$PARAM[width]</width>
				<height>56</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
				<textoffsetx>20</textoffsetx>
				<aligny>center</aligny>
				<pulseonselect>false</pulseonselect>
				<include>Dlg_Tex_RowFocus</include>
				<include content="Dlg_Tex_RowRule"><param name="flip" value="true"/></include>
				<onclick>SettingsLevelChange</onclick>
				<onup>$PARAM[onup]</onup>
				<ondown>$PARAM[ondown]</ondown>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
			</control>
		</definition>
	</include>

	<!-- ============================================================ DialogSettings layouts -->
	<!-- Centred dialog (lock settings, content settings, PVR timers, profiles, sources ...).
	     Ids (Estuary Omega): heading 2, control area 5, templates 7-15, scrollbar 60,
	     buttons 28 / 29 / 30 in grouplist 9000 (Kodi labels/hides them). -->
	<include name="Dlg_SettingsCentred">
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1280</width>
			<height>880</height>
			<visible>!Window.IsVisible(sliderdialog)</visible>
			<include>Anim_FadeVisible</include>
			<include content="DL_GenericDialog">
				<param name="width" value="1280"/>
				<param name="height" value="880"/>
				<param name="header_id" value="2"/>
			</include>
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>920</width>
				<height>744</height>
				<itemgap>0</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<onup>5</onup>
				<ondown>5</ondown>
			</control>
			<include content="DL_SettingTemplates">
				<param name="width" value="920"/>
			</include>
			<include content="DL_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="956"/>
				<param name="top" value="dialog_content_top"/>
				<param name="height" value="744"/>
				<param name="onleft" value="5"/>
				<param name="onright" value="9000"/>
			</include>
			<control type="grouplist" id="9000">
				<left>976</left>
				<top>dialog_content_top</top>
				<width>280</width>
				<height>300</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>5</onleft>
				<onright>5</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<include content="DL_DialogButton"><param name="id" value="28"/><param name="width" value="280"/></include>
				<include content="DL_DialogButton"><param name="id" value="29"/><param name="width" value="280"/></include>
				<include content="DL_DialogButton"><param name="id" value="30"/><param name="width" value="280"/></include>
			</control>
		</control>
	</include>

	<!-- OSD playback settings (osdaudiosettings / osdsubtitlesettings / osdvideosettings / osdcmssettings),
	     mockups/AVSettings: 720px right-hand panel, AUDIO / SUBTITLES / VIDEO tabs (9101-9103) that
	     close this dialog and open the sibling. Hidden while the offset slider is up (Decision 10). -->
	<include name="Dlg_SettingsPanel">
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>screen_w</width>
				<height>screen_h</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="$VAR[DL_DimDialog]">common/white.png</texture>
			</control>
			<control type="group">
				<left>dlg_panel_x</left>
				<!-- slide in on a fresh open, appear instantly when a tab swaps the dialog -->
				<include content="Anim_SidePanel" condition="String.IsEmpty(Window(Home).Property(daylight.osdtab))"><param name="offset" value="80"/></include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>dlg_panel_w</width>
					<height>screen_h</height>
					<texture colordiffuse="$VAR[DL_Ground]">common/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>rule_h</width>
					<height>screen_h</height>
					<texture colordiffuse="$VAR[DL_Line]">common/hairline_v.png</texture>
				</control>
				<!-- tabs -->
				<control type="group">
					<top>dlg_panel_top</top>
					<include content="Dlg_OSDTab">
						<param name="id" value="9101"/>
						<param name="onleft" value="noop"/>
						<param name="onright" value="9102"/>
						<param name="uwidth" value="55"/>
						<param name="target" value="osdaudiosettings"/>
						<param name="left" value="62"/>
						<param name="width" value="75"/>
						<param name="label" value="Audio"/>
						<param name="current" value="Window.IsActive(osdaudiosettings)"/>
					</include>
					<include content="Dlg_OSDTab">
						<param name="id" value="9102"/>
						<param name="onleft" value="9101"/>
						<param name="onright" value="9103"/>
						<param name="uwidth" value="99"/>
						<param name="target" value="osdsubtitlesettings"/>
						<param name="left" value="149"/>
						<param name="width" value="119"/>
						<param name="label" value="Subtitles"/>
						<param name="current" value="Window.IsActive(osdsubtitlesettings)"/>
					</include>
					<include content="Dlg_OSDTab">
						<param name="id" value="9103"/>
						<param name="onleft" value="9102"/>
						<param name="onright" value="noop"/>
						<param name="uwidth" value="55"/>
						<param name="target" value="osdvideosettings"/>
						<param name="left" value="280"/>
						<param name="width" value="75"/>
						<param name="label" value="Video"/>
						<param name="current" value="Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)"/>
					</include>
				</control>
				<control type="label" id="2">
					<description>heading (Kodi: Audio settings / Subtitle settings / Video settings)</description>
					<left>dlg_panel_pad</left>
					<top>128</top>
					<width>dlg_panel_in_w</width>
					<height>56</height>
					<font>font45_title</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
				</control>
				<control type="image">
					<left>dlg_panel_pad</left>
					<top>208</top>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="$VAR[DL_Line]">common/hairline.png</texture>
				</control>
				<control type="grouplist" id="5">
					<description>control area</description>
					<left>dlg_panel_pad</left>
					<top>209</top>
					<width>dlg_panel_in_w</width>
					<height>608</height>
					<itemgap>0</itemgap>
					<pagecontrol>60</pagecontrol>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onup condition="Window.IsActive(osdaudiosettings)">9101</onup>
					<onup condition="Window.IsActive(osdsubtitlesettings)">9102</onup>
					<onup condition="Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)">9103</onup>
					<ondown condition="Control.IsVisible(28) | Control.IsVisible(29) | Control.IsVisible(30)">9000</ondown>
					<ondown condition="!Control.IsVisible(28) + !Control.IsVisible(29) + !Control.IsVisible(30)">5</ondown>
				</control>
				<include content="DL_SettingTemplates">
					<param name="width" value="dlg_panel_in_w"/>
					<param name="height" value="dlg_osd_row_h"/>
					<param name="font" value="button_22_semibold"/>
				</include>
				<control type="scrollbar" id="60">
					<left>646</left>
					<top>209</top>
					<width>2</width>
					<height>608</height>
					<texturesliderbackground colordiffuse="$VAR[DL_Surface]">common/white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="$VAR[DL_Line2]">common/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="$VAR[DL_Line2]">common/white.png</texturesliderbarfocus>
					<orientation>vertical</orientation>
				</control>
				<control type="grouplist" id="9000">
					<left>dlg_panel_pad</left>
					<top>852</top>
					<width>dlg_panel_in_w</width>
					<height>dlg_btn_h</height>
					<orientation>horizontal</orientation>
					<itemgap>14</itemgap>
					<onleft>9000</onleft>
					<onright>9000</onright>
					<onup>5</onup>
					<ondown>5</ondown>
					<include content="DL_DialogButton"><param name="id" value="28"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
					<include content="DL_DialogButton"><param name="id" value="29"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
					<include content="DL_DialogButton"><param name="id" value="30"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
				</control>
				<control type="textbox">
					<left>dlg_panel_pad</left>
					<top>940</top>
					<width>dlg_panel_in_w</width>
					<height>84</height>
					<font>small_20</font>
					<textcolor>$VAR[DL_Ink3]</textcolor>
					<label>$LOCALIZE[31243]</label>
					<visible>Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings)</visible>
				</control>
			</control>
		</control>
	</include>

	<!-- One OSD tab: mono label, 2px accent underline on the current tab, accent fill + ink on focus.
	     Clicking a non-current tab closes whichever OSD settings dialog is open (only the current one
	     is) and opens the target; daylight.osdtab suppresses the slide so the swap reads as a tab change.
	     params: id, left, width, uwidth (underline = text width), label, current (condition), target,
	     onleft, onright -->
	<include name="Dlg_OSDTab">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>40</height>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>40</height>
					<label>$PARAM[label]</label>
					<font>cap_21</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
					<align>center</align>
					<textoffsetx>0</textoffsetx>
					<pulseonselect>false</pulseonselect>
					<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
					<texturenofocus />
					<onleft>$PARAM[onleft]</onleft>
					<onright>$PARAM[onright]</onright>
					<onup>noop</onup>
					<ondown>5</ondown>
					<onclick condition="!Window.IsActive($PARAM[target])">SetProperty(daylight.osdtab,1,home)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdaudiosettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdsubtitlesettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdvideosettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdcmssettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">ActivateWindow($PARAM[target])</onclick>
				</control>
				<!-- current tab: primary text over the secondary one + underline -->
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>40</height>
					<align>center</align>
					<font>cap_21</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$PARAM[label]</label>
					<visible>[$PARAM[current]] + !Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>38</top>
					<width>$PARAM[uwidth]</width>
					<height>2</height>
					<texture colordiffuse="$VAR[DL_Accent]">common/white.png</texture>
					<visible>[$PARAM[current]] + !Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- ============================================================ SkinSettings pieces -->
	<!-- Group entry: soft raised pill when active, accent pill on focus. Focus selects the group
	     (Window(Home).Property(daylight.skincat)). params: id, top, label, key, onright, onup, ondown -->
	<include name="Dlg_SkinCategory">
		<!-- onright_skip / onright_skipto (audit 2026-10-30): where Right goes while the page's first row is disabled
		     (Look starts with Borrowed colour, which needs TMDb Helper; without it Right went nowhere) -->
		<param name="onright_skip">false</param>
		<param name="onright_skipto">noop</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>360</width>
				<height>68</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>360</width>
					<height>68</height>
					<texture border="24" colordiffuse="$VAR[DL_Surface]">daylight/card20.png</texture>
					<visible>String.IsEqual(Window(Home).Property(daylight.skincat),$PARAM[key]) + !Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>360</width>
					<height>68</height>
					<texture border="24" colordiffuse="$VAR[DL_Accent]">daylight/card20.png</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>360</width>
					<height>68</height>
					<label></label>
					<texturefocus />
					<texturenofocus />
					<onfocus>SetProperty(daylight.skincat,$PARAM[key],home)</onfocus>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft>noop</onleft>
					<onright condition="!$PARAM[onright_skip]">$PARAM[onright]</onright>
					<onright condition="$PARAM[onright_skip]">$PARAM[onright_skipto]</onright>
				</control>
				<control type="label">
					<left>28</left>
					<top>0</top>
					<width>320</width>
					<height>68</height>
					<font>ui_26_semibold</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$PARAM[label]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>28</left>
					<top>0</top>
					<width>320</width>
					<height>68</height>
					<font>ui_26_semibold</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$PARAM[label]</label>
					<visible>!Control.HasFocus($PARAM[id]) + String.IsEqual(Window(Home).Property(daylight.skincat),$PARAM[key])</visible>
				</control>
				<control type="label">
					<left>28</left>
					<top>0</top>
					<width>320</width>
					<height>68</height>
					<font>ui_26</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$PARAM[label]</label>
					<visible>!Control.HasFocus($PARAM[id]) + !String.IsEqual(Window(Home).Property(daylight.skincat),$PARAM[key])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Row chrome (860 x 100): focused = raised rounded fill + accent ring, name + quiet hint.
	     Place inside a group whose top is the row's y. params: id, label, hint, enable -->
	<include name="Dlg_SkinRowChrome">
		<param name="enable">true</param>
		<definition>
			<control type="group">
				<visible>Control.HasFocus($PARAM[id])</visible>
				<control type="image">
					<left>-20</left>
					<top>0</top>
					<width>900</width>
					<height>100</height>
					<texture border="24" colordiffuse="$VAR[DL_Raised]">daylight/card20.png</texture>
				</control>
				<control type="image">
					<left>-22</left>
					<top>-2</top>
					<width>904</width>
					<height>104</height>
					<texture border="16" colordiffuse="$VAR[DL_Accent]">focus/outline_3_round.png</texture>
				</control>
			</control>
			<control type="label">
				<left>0</left>
				<top>18</top>
				<width>520</width>
				<height>36</height>
