<?xml version="1.0" encoding="UTF-8"?>
<!--
	System information (SPEC 5: Minimal). Builder F, M4. Section menu on the left; Kodi fills the
	labels for the section whose button has focus.
	Kodi id contract (Estuary Omega SettingsSystemInfo.xml / GUIWindowSystemInfo): section buttons
	95 summary (default), 94 storage, 96 network, 97 video, 98 hardware, 99 PVR, 100 privacy policy,
	101 contribute; info labels 2-13; policy textbox 30 + scrollbar 60; contribute group 102 with
	multiimage 103 (Kodi shows/hides 102); build date label 53.
-->
<window>
	<defaultcontrol always="true">95</defaultcontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include content="DL_TopBar">
			<param name="index" value="13"/>
			<param name="title" value="$LOCALIZE[130]"/>
		</include>
		<!-- ====== cards -->
		<control type="group">
			<left>540</left>
			<top>content_top</top>
			<width>1260</width>
			<height>848</height>
			<include>DL_Card</include>
		</control>
		<control type="group">
			<left>page_margin</left>
			<top>800</top>
			<width>400</width>
			<height>216</height>
			<include>DL_Card</include>
		</control>
		<!-- ====== sections -->
		<control type="grouplist" id="9000">
			<left>page_margin</left>
			<top>content_top</top>
			<width>misc_menu_w</width>
			<height>560</height>
			<orientation>vertical</orientation>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<onleft>noop</onleft>
			<onright>60</onright>
			<control type="button" id="95">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[20037]</label>
			</control>
			<control type="button" id="94">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[13277]</label>
			</control>
			<control type="button" id="96">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[13279]</label>
			</control>
			<control type="button" id="97">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[13280]</label>
			</control>
			<control type="button" id="98">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[13281]</label>
			</control>
			<control type="button" id="99">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[19191]</label>
			</control>
			<control type="button" id="100">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[12389]</label>
			</control>
			<control type="button" id="101">
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[12396]</label>
			</control>
		</control>

		<!-- ====== section content -->
		<control type="grouplist">
			<left>580</left>
			<top>200</top>
			<width>1180</width>
			<height>600</height>
			<orientation>vertical</orientation>
			<control type="label" id="2"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="3"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="4"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="5"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="6"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="7"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="8"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="9"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="10"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="11"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="12"><width>1180</width><height>50</height><font>num_26</font></control>
			<control type="label" id="13"><width>1180</width><height>50</height><font>num_26</font></control>
		</control>
		<control type="textbox" id="30">
			<description>Privacy policy</description>
			<left>580</left>
			<top>200</top>
			<width>1220</width>
			<height>591</height>  <!-- 18 lines exactly: no half-clipped line at the bottom -->
			<font>body_24</font>
			<pagecontrol>60</pagecontrol>
			<autoscroll delay="5000" repeat="7500" time="5000">!Control.HasFocus(60)</autoscroll>
		</control>
		<include content="DL_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1772"/>
			<param name="top" value="200"/>
			<param name="height" value="591"/>
			<param name="onleft" value="9000"/>
			<param name="onright" value="9000"/>
		</include>
		<control type="group" id="102">
			<description>Contribute page (Kodi toggles it)</description>
			<left>580</left>
			<top>200</top>
			<width>1180</width>
			<height>620</height>
			<control type="textbox">
				<left>0</left>
				<top>0</top>
				<width>1180</width>
				<height>100</height>
				<font>body_24</font>
				<label>$LOCALIZE[12397]</label>
			</control>
			<control type="multiimage" id="103">
				<left>0</left>
				<top>110</top>
				<width>440</width>
				<height>440</height>
				<imagepath>special://xbmc/media/qr/kodilove/</imagepath>
				<aspectratio align="left">keep</aspectratio>
				<timeperimage>5000</timeperimage>
				<fadetime>600</fadetime>
				<randomize>false</randomize>
			</control>
			<control type="label">
				<left>0</left>
				<top>570</top>
				<width>1180</width>
				<height>40</height>
				<font>cap_20</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$LOCALIZE[12398]</label>
			</control>
		</control>

		<!-- ====== footer: memory / CPU / build -->
		<include content="DL_Rule">
			<param name="left" value="580"/>
			<param name="top" value="840"/>
			<param name="width" value="1180"/>
			<param name="color" value="$VAR[DL_Line]"/>
		</include>
		<control type="group">
			<left>156</left>
			<top>832</top>
			<width>328</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>328</width>
				<height>30</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>Memory  $INFO[System.Memory(used.percent)]</label>
			</control>
			<control type="progress">
				<left>0</left>
				<top>36</top>
				<width>328</width>
				<height>8</height>
				<texturebg border="4,0,4,0" colordiffuse="$VAR[DL_Line]">daylight/track_8.png</texturebg>
				<midtexture border="4,0,4,0" colordiffuse="$VAR[DL_Accent]">daylight/track_8.png</midtexture>
				<info>System.Memory(used)</info>
			</control>
			<control type="label">
				<left>0</left>
				<top>84</top>
				<width>328</width>
				<height>30</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>CPU  $INFO[System.CPUUsage]</label>
				<visible>System.SupportsCPUUsage</visible>
			</control>
			<control type="progress">
				<left>0</left>
				<top>120</top>
				<width>328</width>
				<height>8</height>
				<texturebg border="4,0,4,0" colordiffuse="$VAR[DL_Line]">daylight/track_8.png</texturebg>
				<midtexture border="4,0,4,0" colordiffuse="$VAR[DL_Accent]">daylight/track_8.png</midtexture>
				<info>System.CPUUsage</info>
				<visible>System.SupportsCPUUsage</visible>
			</control>
		</control>
		<control type="grouplist">
			<left>580</left>
			<top>856</top>
			<width>1180</width>
			<height>140</height>
			<orientation>vertical</orientation>
			<control type="label">
				<width>1180</width>
				<height>40</height>
				<font>num_21</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<label>Kodi $INFO[System.BuildVersionShort]$INFO[System.BuildVersionCode,  (,)]</label>
			</control>
			<control type="label">
				<width>1180</width>
				<height>40</height>
				<font>num_21</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$INFO[System.BuildVersionGit,Git  ,]</label>
			</control>
			<control type="label" id="53">
				<description>Kodi build date (Kodi)</description>
				<width>1180</width>
				<height>40</height>
				<font>num_21</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
			</control>
		</control>
	</controls>
</window>
