		<value condition="$EXP[Home_HasC]">SetFocus(9140)</value>
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value condition="$EXP[Home_HeroOn]">SetFocus(9110)</value>
		<value>SetFocus(9000)</value>
	</variable>
	<variable name="Home_UpFromCustom3">
		<value condition="$EXP[CustomRow2On]">SetFocus(9882)</value>
		<value condition="$EXP[CustomRow1On]">SetFocus(9881)</value>
		<value condition="$EXP[Home_HasC]">SetFocus(9140)</value>
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value condition="$EXP[Home_HeroOn]">SetFocus(9110)</value>
		<value>SetFocus(9000)</value>
	</variable>
	<variable name="Home_DownFromCustom1">
		<value condition="$EXP[CustomRow2On]">SetFocus(9882)</value>
		<value condition="$EXP[CustomRow3On]">SetFocus(9883)</value>
		<value>noop</value>
	</variable>
	<variable name="Home_DownFromCustom2">
		<value condition="$EXP[CustomRow3On]">SetFocus(9883)</value>
		<value>noop</value>
	</variable>
	<variable name="Home_DownFromCustom3">
		<value>noop</value>
	</variable>
	<!-- Down (only) from cards A / B / C: the next card, else the custom rows (Right keeps the old variables) -->
	<variable name="Home_DownFromA">
