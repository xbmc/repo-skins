	<!-- Card-to-card navigation (0.9.2). The cards are one sequence, hero, A, B, C:
	     Down = next card, Up = previous card (the hero from A), from ANY item; Left/Right scroll
	     the strip inside a card and spill into the neighbour at its ends. Empty cards are skipped.
	     Lists keep their own selected item, so SetFocus(card) lands where you left it. -->
	<variable name="Home_RightFromA">
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasC]">SetFocus(9140)</value>
		<value>noop</value>
	</variable>
	<variable name="Home_UpFromB">
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value condition="!$EXP[Home_HeroOn]">SetFocus(9000)</value>
		<value>SetFocus(9110)</value>
	</variable>
	<variable name="Home_LeftFromB">
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value>noop</value>
	</variable>
	<variable name="Home_DownFromB">
		<value condition="$EXP[Home_HasC]">SetFocus(9140)</value>
		<value>noop</value>
	</variable>
	<variable name="Home_UpFromC">
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value condition="!$EXP[Home_HeroOn]">SetFocus(9000)</value>
		<value>SetFocus(9110)</value>
	</variable>
	<variable name="Home_LeftFromC">
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value>noop</value>
	</variable>

