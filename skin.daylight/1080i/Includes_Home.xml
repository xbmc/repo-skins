	<!-- ============================================================ custom rows (0.9.11) -->
	<!-- Opt-in rows from Skin settings > Custom rows (Includes_CustomRows.xml, generated). They continue the
	     card sequence below the first page: Down from the last card (or from the hero / the nav when the cards
	     are hidden) scrolls the page one screen up to them; each is a full-width Daylight card (header with
	     icon + Fraunces title, accent + chevron while focused) holding a strip of card-A posters with their
	     titles. Up = previous row (the last card from row 1), Back = nav. Nothing changes until a row has
	     items: the block sits below the screen and empty rows draw nothing. -->
	<include name="Home_CustomRow">
		<definition>
			<control type="group">
				<left>page_margin</left>
				<top>0</top>
				<width>1680</width>
				<height>home_card_h</height>
				<animation effect="slide" start="0,0" end="0,384" time="0" condition="$PARAM[after1] + $EXP[CustomRow1On]">Conditional</animation>
				<animation effect="slide" start="0,0" end="0,384" time="0" condition="$PARAM[after2] + $EXP[CustomRow2On]">Conditional</animation>
				<control type="group">
					<visible>$EXP[CustomRow$PARAM[n]On]</visible>
					<include>DL_Card</include>
					<include content="Home_CardHeader">
						<param name="icon" value="daylight/icons/home.png"/>
						<param name="title" value="$VAR[CustomRow_Title$PARAM[n]]"/>
						<param name="id" value="$PARAM[id]"/>
						<param name="hasnext" value="$PARAM[hasnext]"/>
					</include>
					<control type="label">
						<left>1100</left>
						<top>30</top>
						<width>552</width>
						<height>28</height>
						<align>right</align>
						<font>small_20</font>
						<textcolor>$VAR[DL_Ink2]</textcolor>
						<label>$VAR[CustomRow_Count$PARAM[n]]</label>
					</control>
				</control>
				<control type="list" id="$PARAM[id]">
					<left>14</left>
					<top>64</top>
					<width>1652</width>
					<height>272</height>
					<orientation>horizontal</orientation>
					<onup>$VAR[Home_UpFromCustom$PARAM[n]]</onup>
					<ondown>$VAR[Home_DownFromCustom$PARAM[n]]</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onback>9000</onback>
					<onfocus>SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],home)</onfocus>
					<preloaditems>2</preloaditems>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<itemlayout width="170" height="272">
						<include content="Home_CardPoster">
							<param name="id" value="$PARAM[id]"/>
							<param name="caption" value="$INFO[ListItem.Label]"/>
							<param name="art" value="$VAR[CustomRow_PosterArt]"/>
							<param name="ismore" value="false"/>
						</include>
					</itemlayout>
					<focusedlayout width="170" height="272">
						<include content="Home_CardPoster">
							<param name="id" value="$PARAM[id]"/>
							<param name="caption" value="$INFO[ListItem.Label]"/>
							<param name="art" value="$VAR[CustomRow_PosterArt]"/>
							<param name="ismore" value="false"/>
							<param name="focused" value="true"/>
						</include>
					</focusedlayout>
					<include content="CustomRow_Content"><param name="row" value="$PARAM[n]"/></include>
				</control>
			</control>
		</definition>
	</include>
	<!-- the block: one screen below the first page (top 1080 + 60) inside the Home.xml page wrapper -->
	<include name="Home_CustomRows">
		<control type="group">
			<left>0</left>
			<top>1140</top>
			<include content="Home_CustomRow"><param name="n" value="1"/><param name="id" value="9881"/><param name="after1" value="false"/><param name="after2" value="false"/><param name="hasnext" value="[$EXP[CustomRow2On] | $EXP[CustomRow3On]]"/></include>
			<include content="Home_CustomRow"><param name="n" value="2"/><param name="id" value="9882"/><param name="after1" value="true"/><param name="after2" value="false"/><param name="hasnext" value="$EXP[CustomRow3On]"/></include>
			<include content="Home_CustomRow"><param name="n" value="3"/><param name="id" value="9883"/><param name="after1" value="true"/><param name="after2" value="true"/><param name="hasnext" value="false"/></include>
		</control>
	</include>
	<!-- page wrapper animation: one screen up while a custom row has focus, 144 px more for a third row -->
	<include name="Home_CustomRowsPageAnim">
		<animation effect="slide" start="0,0" end="0,-1080" time="280" tween="cubic" easing="out" condition="$EXP[CustomRowsFocus] + !$EXP[ReduceMotion]">Conditional</animation>
		<animation effect="slide" start="0,0" end="0,-1080" time="0" condition="$EXP[CustomRowsFocus] + $EXP[ReduceMotion]">Conditional</animation>
		<animation effect="slide" start="0,0" end="0,-144" time="240" tween="cubic" easing="out" condition="Control.HasFocus(9883) + $EXP[CustomRow1On] + $EXP[CustomRow2On] + !$EXP[ReduceMotion]">Conditional</animation>
		<animation effect="slide" start="0,0" end="0,-144" time="0" condition="Control.HasFocus(9883) + $EXP[CustomRow1On] + $EXP[CustomRow2On] + $EXP[ReduceMotion]">Conditional</animation>
	</include>
	<!-- Up from a custom row: the row above with items, else the last card shown, else the hero / nav -->
	<variable name="Home_UpFromCustom1">
		<value condition="$EXP[Home_HasC]">SetFocus(9140)</value>
		<value condition="$EXP[Home_HasB]">SetFocus(9130)</value>
		<value condition="$EXP[Home_HasA]">SetFocus(9120)</value>
		<value condition="$EXP[Home_HeroOn]">SetFocus(9110)</value>
		<value>SetFocus(9000)</value>
	</variable>
	<variable name="Home_UpFromCustom2">
