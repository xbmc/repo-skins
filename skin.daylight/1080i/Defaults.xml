<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Daylight focus language: the focused control is a soft accent fill (rounded 16, daylight/card16.png)
	with on-accent text; unfocused controls sit flat on the card. Every colour is a mood token.
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<selectedcolor>$VAR[DL_Ink]</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>$VAR[DL_Body]</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="$VAR[DL_OnAccent]">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[DL_Accent]">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="$VAR[DL_OnAccent]">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="$VAR[DL_Line2]">common/rect_outline_1.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="$VAR[DL_Disabled]">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="10" colordiffuse="$VAR[DL_Disabled]">common/rect_outline_1.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="$VAR[DL_Ink3]">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="$VAR[DL_Ink3]" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[DL_OnAccent]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[DL_OnAccent]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[DL_Disabled]">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[DL_Disabled]" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="$VAR[DL_Ink3]">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="$VAR[DL_Ink3]" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[DL_OnAccent]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[DL_OnAccent]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[DL_Disabled]">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[DL_Disabled]" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>12</sliderheight>
		<texturesliderbar border="6,0,6,0" colordiffuse="$VAR[DL_Line2]">daylight/track_12.png</texturesliderbar>
		<texturesliderbardisabled border="6,0,6,0" colordiffuse="$VAR[DL_Line]">daylight/track_12.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[DL_Ink2]">daylight/circle_24.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[DL_OnAccent]">daylight/circle_24.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[DL_Disabled]">daylight/circle_24.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar border="6,0,6,0" colordiffuse="$VAR[DL_Line2]">daylight/track_12.png</texturesliderbar>
		<texturesliderbardisabled border="6,0,6,0" colordiffuse="$VAR[DL_Line]">daylight/track_12.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[DL_Ink2]">daylight/circle_24.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[DL_OnAccent]">daylight/circle_24.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[DL_Disabled]">daylight/circle_24.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="$VAR[DL_Disabled]">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>$VAR[DL_Ink]</textcolor>
		<focusedcolor>$VAR[DL_OnAccent]</focusedcolor>
		<disabledcolor>$VAR[DL_Disabled]</disabledcolor>
		<invalidcolor>$VAR[DL_Accent]</invalidcolor>
		<texturefocus border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texturefocus>
		<texturenofocus border="20" colordiffuse="$VAR[DL_Raised]">daylight/card16.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg border="6,0,6,0" colordiffuse="$VAR[DL_Line2]">daylight/track_12.png</texturebg>
		<lefttexture />
		<midtexture border="6,0,6,0" colordiffuse="$VAR[DL_Accent]">daylight/track_12.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground border="4" colordiffuse="$VAR[DL_Line]">daylight/track_8.png</texturesliderbackground>
		<texturesliderbar border="4" colordiffuse="$VAR[DL_Ink3]">daylight/track_8.png</texturesliderbar>
		<texturesliderbarfocus border="4" colordiffuse="$VAR[DL_Accent]">daylight/track_8.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
