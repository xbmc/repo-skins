<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music playlist editor (SPEC 5 Minimal, M4; Builder C). Two text lists side by side:
	library browser on the left, the playlist being built on the right.

	Kodi id contract (Estuary Omega MyMusicPlaylistEditor.xml / GUIWindowMusicPlaylistEditor.cpp):
	  menucontrol 9000 with 6 open, 7 save, 8 clear; 50 = browse list (view, <views>50</views>),
	  100 = playlist list, 12 = file count label, 101 = playlist count label (Kodi fills both);
	  60 / 61 scrollbars. OK on list 50 adds the item, OK on 100 offers move / remove (Kodi).
	Navigation: sub-nav Down -> 50; 50 Right -> 100, 100 Left -> 50; Up from either -> sub-nav.
	Back -> previous window (Kodi).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include content="DL_TopBar">
			<param name="index" value="04"/>
			<param name="title" value="Playlist editor"/>
		</include>

		<control type="grouplist" id="9000">
			<left>subnav_left</left>
			<top>below_bar_top</top>
			<width>1300</width>
			<height>subnav_h</height>
			<orientation>horizontal</orientation>
			<itemgap>28</itemgap>
			<onup>noop</onup>
			<ondown>50</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onback>50</onback>
			<include content="DL_SubNavButton">
				<param name="id" value="6"/>
				<param name="label" value="$LOCALIZE[502]"/>
			</include>
			<include content="DL_SubNavButton">
				<param name="id" value="7"/>
				<param name="label" value="$LOCALIZE[190]"/>
			</include>
			<include content="DL_SubNavButton">
				<param name="id" value="8"/>
				<param name="label" value="$LOCALIZE[192]"/>
			</include>
		</control>

		<!-- ============================================================ library (left) -->
		<control type="label">
			<left>page_margin</left>
			<top>200</top>
			<width>400</width>
			<height>24</height>
			<font>cap_20</font>
			<textcolor>$VAR[DL_Ink3]</textcolor>
			<label>$LOCALIZE[31204]</label>
		</control>
		<control type="label" id="12">
			<left>page_margin</left>
			<top>200</top>
			<width>820</width>
			<height>24</height>
			<align>right</align>
			<font>num_20</font>
			<textcolor>$VAR[DL_Ink3]</textcolor>
		</control>
		<include content="DL_Rule">
			<param name="top" value="232"/>
			<param name="width" value="820"/>
		</include>
		<control type="list" id="50">
			<left>page_margin</left>
			<top>240</top>
			<width>820</width>
			<height>726</height>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright condition="Integer.IsGreater(Container(100).NumItems,0)">100</onright>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<viewtype label="535">list</viewtype>
			<include content="Music_RowLayout">
				<param name="width" value="820"/>
				<param name="list_id" value="50"/>
			</include>
		</control>
		<include content="DL_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="928"/>
			<param name="top" value="240"/>
			<param name="height" value="726"/>
			<param name="onleft" value="50"/>
			<param name="onright" value="100"/>
		</include>

		<!-- =========================================================== playlist (right) -->
		<control type="label">
			<left>1004</left>
			<top>200</top>
			<width>400</width>
			<height>24</height>
			<font>cap_20</font>
			<textcolor>$VAR[DL_Accent]</textcolor>
			<label>$LOCALIZE[31249]</label>
		</control>
		<control type="label" id="101">
			<left>1004</left>
			<top>200</top>
			<width>820</width>
			<height>24</height>
			<align>right</align>
			<font>num_20</font>
			<textcolor>$VAR[DL_Ink3]</textcolor>
		</control>
		<include content="DL_Rule">
			<param name="top" value="232"/>
			<param name="left" value="1004"/>
			<param name="width" value="820"/>
		</include>
		<control type="list" id="100">
			<left>1004</left>
			<top>240</top>
			<width>820</width>
			<height>726</height>
			<onup>9000</onup>
			<ondown>noop</ondown>
			<onleft>50</onleft>
			<onright>61</onright>
			<pagecontrol>61</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="Music_RowLayout">
				<param name="width" value="820"/>
				<param name="list_id" value="100"/>
			</include>
		</control>
		<include content="DL_Scrollbar">
			<param name="id" value="61"/>
			<param name="left" value="1836"/>
			<param name="top" value="240"/>
			<param name="height" value="726"/>
			<param name="onleft" value="100"/>
			<param name="onright" value="100"/>
		</include>
		<control type="label">
			<left>1004</left>
			<top>250</top>
			<width>820</width>
			<height>66</height>
			<font>body_24</font>
			<textcolor>$VAR[DL_Ink3]</textcolor>
			<label>$LOCALIZE[31250]</label>
			<visible>Integer.IsEqual(Container(100).NumItems,0)</visible>
		</control>
	</controls>
</window>
