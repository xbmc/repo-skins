<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home "For now" (mockups DaylightEvening / DaylightNight). Includes_Home.xml has the ids and focus map;
	Includes_Daylight.xml decides the greeting, countdown, hero and rows from the clock, bedtime and weather.
	Kodi hard-codes no control ids on Home. Home is KEEP_IN_MEMORY: <include condition> is evaluated
	at skin load only, so everything here switches with <visible> / $VAR instead.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>  <!-- 0.9.2: Home always opens on the main menu (For now), so Back from anywhere ends there -->
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<!-- TMDb Helper borrowed colour (optional): colour service on, normalised per mood -->
	<onload condition="$EXP[DL_ArtColourOn] + !Skin.HasSetting(TMDbHelper.EnableColors)">Skin.SetBool(TMDbHelper.EnableColors)</onload>
	<onload condition="!$EXP[DL_ArtColourOn] + Skin.HasSetting(TMDbHelper.EnableColors)">Skin.Reset(TMDbHelper.EnableColors)</onload>
	<onload condition="$EXP[DL_ArtColourOn]">Skin.SetString(TMDbHelper.Colors.Luminance,$VAR[DL_ColorLum])</onload>
	<onload condition="$EXP[DL_ArtColourOn]">Skin.SetString(TMDbHelper.Colors.Saturation,$VAR[DL_ColorSat])</onload>
	<onload condition="$EXP[DL_ArtColourOn]">SetProperty(TMDbHelper.Colors.SourceImage,Art(poster)||Art(tvshow.poster)||Art(thumb)||Art(fanart),home)</onload>
	<onload condition="$EXP[DL_ArtColourOn]">SetProperty(TMDbHelper.WidgetContainer,9101,home)</onload>
	<!-- other windows must not inherit Home's container id (TMDb Helper reads it globally) -->
	<onunload>ClearProperty(TMDbHelper.WidgetContainer,home)</onunload>
	<!-- 0.9.17: Back from a custom main-menu item comes home on its pill (it set daylight.custommenu on OK);
	     Home otherwise opens on For now (defaultcontrol). Never focus a pill that no longer shows. -->
	<onload condition="String.IsEqual(Window(Home).Property(daylight.custommenu),1) + $EXP[CustomMenu1On]">SetFocus(9011)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(daylight.custommenu),2) + $EXP[CustomMenu2On]">SetFocus(9012)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(daylight.custommenu),3) + $EXP[CustomMenu3On]">SetFocus(9013)</onload>
	<onload>ClearProperty(daylight.custommenu,home)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include>Home_DataLists</include>
		<include>CustomRows_Probes</include>
		<include>DL_CustomMenuProbes</include>
		<!-- 0.9.11: the first page + the custom rows below it; slides one screen up while a custom row has focus -->
		<control type="group">
			<include>Home_CustomRowsPageAnim</include>
			<include>Home_TopLine</include>
			<include>Home_Greeting</include>
			<include>Home_NowPlaying</include>
			<include>Home_Hero</include>
			<include>Home_Cards</include>
			<include>Home_CustomRows</include>
		</control>
	</controls>
</window>
