<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogVideoInfo pieces (Daylight): a big hero card (poster, title, meta, buttons, fanart fading in
	from the right), a Story card and a When-to-watch card underneath, the cast on a second "page".
	Shared labels: Includes_Views_Video.xml (VidView_*). Prefix VidInfo_.
-->
<includes>
	<!-- Collection button (0.9.2 Back audit): inside the library the set opens in place (one Back returns
	     to the grid); from Home it opens the library window with return (one Back returns Home). Opening it
	     with ActivateWindow from the library left Back walking up through videodb nodes. -->
	<variable name="VidInfo_CollectionAction">
		<value condition="Window.IsActive(Videos)">Container.Update(videodb://movies/sets/$INFO[ListItem.SetId]/?setid=$INFO[ListItem.SetId])</value>
		<value>ActivateWindow(Videos,videodb://movies/sets/$INFO[ListItem.SetId]/?setid=$INFO[ListItem.SetId],return)</value>
	</variable>
	<!-- ================================================================== variables -->
	<variable name="VidInfo_Kicker">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[VidView_EpCode]$INFO[ListItem.TVShowTitle,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">TV show$INFO[ListItem.Studio,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Collection$VAR[PL_Total_Film]</value>
		<value condition="!String.IsEmpty(ListItem.Set)">Film  ·  $INFO[ListItem.Set]</value>
		<value>$VAR[VidView_Status]$INFO[ListItem.Studio,  ·  ,]</value>
	</variable>
	<variable name="VidInfo_Title">
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="VidInfo_Poster">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(season.poster))">$INFO[ListItem.Art(season.poster)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_Fanart">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(landscape)]</value>
	</variable>
	<variable name="VidInfo_EndLine">
		<value condition="ListItem.IsResumable">Resume now: done by $INFO[ListItem.EndTimeResume]</value>
		<value condition="!String.IsEmpty(ListItem.Duration)">Start now: ends $INFO[ListItem.EndTime]</value>
	</variable>
	<variable name="VidInfo_CastHeader">
		<value condition="String.IsEqual(ListItem.DBType,set)">Films in this collection</value>
		<value>Cast</value>
	</variable>
	<variable name="VidInfo_CastCount">
		<value condition="String.IsEqual(ListItem.DBType,set)">$VAR[PL_Container_50_NumItems_Film]</value>
		<value>$VAR[PL_Container_50_NumItems_Person]</value>
	</variable>
	<variable name="VidInfo_Hint">
		<value condition="Control.HasFocus(9001)">OK reads the whole story</value>
		<value condition="ControlGroup(9100).HasFocus()">Up or Back returns to the buttons</value>
		<value condition="Integer.IsGreater(Container(50).NumItems,0)">Down for $VAR[VidInfo_CastHeaderLower]</value>
	</variable>
	<variable name="VidInfo_CastHeaderLower">
		<value condition="String.IsEqual(ListItem.DBType,set)">the films</value>
		<value>the cast</value>
	</variable>
	<variable name="VidInfo_CastArt">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_CastLine2">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Year]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<!-- media flags (values checked against reference skins) -->
	<variable name="VidInfo_FlagRes">
		<value condition="String.IsEqual(ListItem.VideoResolution,8K)">8K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,4K) | String.IsEqual(ListItem.VideoResolution,2160)">4K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,1080)">1080p</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,720)">720p</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,576) | String.IsEqual(ListItem.VideoResolution,540) | String.IsEqual(ListItem.VideoResolution,480)">SD</value>
		<value>$INFO[ListItem.VideoResolution]</value>
	</variable>
	<variable name="VidInfo_FlagHDR">
		<value condition="String.IsEqual(ListItem.HdrType,dolbyvision)">Dolby Vision</value>
		<value condition="String.IsEqual(ListItem.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(ListItem.HdrType,hlg)">HLG</value>
		<value>$INFO[ListItem.HdrType]</value>
	</variable>
	<variable name="VidInfo_FlagVideo">
		<value condition="String.IsEqual(ListItem.VideoCodec,hevc) | String.IsEqual(ListItem.VideoCodec,h265) | String.IsEqual(ListItem.VideoCodec,hev1) | String.IsEqual(ListItem.VideoCodec,hvc1)">HEVC</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,h264) | String.IsEqual(ListItem.VideoCodec,avc1) | String.IsEqual(ListItem.VideoCodec,avc)">H.264</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,av1)">AV1</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,mpeg2video) | String.IsEqual(ListItem.VideoCodec,mpeg2)">MPEG-2</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,vc1) | String.IsEqual(ListItem.VideoCodec,wvc1) | String.IsEqual(ListItem.VideoCodec,vc-1)">VC-1</value>
		<value>$INFO[ListItem.VideoCodec]</value>
	</variable>
	<variable name="VidInfo_AudioCodec">
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd_atmos)">TrueHD Atmos</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd)">TrueHD</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3_ddp_atmos)">DD+ Atmos</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3)">DD+</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,ac3) | String.IsEqual(ListItem.AudioCodec,dolbydigital)">Dolby Digital</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma_x) | String.IsEqual(ListItem.AudioCodec,dtshd_ma_x_imax)">DTS:X</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma) | String.IsEqual(ListItem.AudioCodec,dtsma)">DTS-HD MA</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_hra)">DTS-HD HRA</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,dts) | String.IsEqual(ListItem.AudioCodec,dca)">DTS</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,aac) | String.StartsWith(ListItem.AudioCodec,he_aac)">AAC</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,pcm)">PCM</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,mp3)">MP3</value>
		<value>$INFO[ListItem.AudioCodec]</value>
	</variable>
	<variable name="VidInfo_AudioChannels">
		<value condition="Integer.IsEqual(ListItem.AudioChannels,8)"> 7.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,7)"> 6.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,6)"> 5.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,3)"> 2.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,2)"> 2.0</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,1)"> 1.0</value>
	</variable>

	<!-- ==================================================================== buttons -->
	<expression name="VidInfo_ShowResume">Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowPlay">!Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowTrailer">$EXP[ShowTrailerButton] + !String.IsEmpty(ListItem.Trailer)</expression>
	<!-- shared nav for buttons in the row. params: left1..left4 (+ _if), right1..right2 (+ _if) -->
	<include name="VidInfo_ButtonNav">
		<param name="left1">noop</param>
		<param name="left1_if">false</param>
		<param name="left2">noop</param>
		<param name="left2_if">false</param>
		<param name="left3">noop</param>
		<param name="left3_if">false</param>
		<param name="left4">noop</param>
		<param name="left4_if">false</param>
		<param name="right1">noop</param>
		<param name="right1_if">false</param>
		<param name="right2">noop</param>
		<param name="right2_if">false</param>
		<param name="down1">9001</param>
		<param name="down2">50</param>
		<definition>
			<onleft condition="$PARAM[left1_if]">$PARAM[left1]</onleft>
			<onleft condition="$PARAM[left2_if]">$PARAM[left2]</onleft>
			<onleft condition="$PARAM[left3_if]">$PARAM[left3]</onleft>
			<onleft condition="$PARAM[left4_if]">$PARAM[left4]</onleft>
			<onright condition="$PARAM[right1_if]">$PARAM[right1]</onright>
			<onright condition="$PARAM[right2_if]">$PARAM[right2]</onright>
			<onup>noop</onup>
			<ondown condition="Control.IsVisible($PARAM[down1])">$PARAM[down1]</ondown>
			<ondown condition="!Control.IsVisible($PARAM[down1]) + Control.IsVisible($PARAM[down2])">$PARAM[down2]</ondown>
		</definition>
	</include>
	<!-- Pill button in the row (group padded 24 px for the halo). params: id, width, label, icon
	     (empty = centred text), onclick, visible + nav -->
	<include name="VidInfo_Button">
		<param name="icon"></param>
		<param name="text_x">56</param>
		<param name="align">left</param>
		<param name="onclick">noop</param>
		<param name="visible">true</param>
		<param name="left1">noop</param>
		<param name="left1_if">false</param>
		<param name="left2">noop</param>
		<param name="left2_if">false</param>
		<param name="left3">noop</param>
		<param name="left3_if">false</param>
		<param name="left4">noop</param>
		<param name="left4_if">false</param>
		<param name="right1">noop</param>
		<param name="right1_if">false</param>
		<param name="right2">noop</param>
		<param name="right2_if">false</param>
		<param name="down1">9001</param>
		<param name="down2">50</param>
		<param name="onclick2">noop</param>
		<definition>
			<control type="group">
				<left>24</left>
				<top>24</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<animation type="Conditional" condition="Control.HasFocus($PARAM[id]) + !$EXP[ReduceMotion]" reversible="true">
					<effect type="zoom" start="100" end="105" center="auto" time="160" tween="cubic" easing="out"/>
				</animation>
				<control type="group">
					<visible>Control.HasFocus($PARAM[id])</visible>
					<include>DL_PillHalo</include>
				</control>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>button_h</height>
					<label></label>
					<textcolor>00ffffff</textcolor>
					<focusedcolor>00ffffff</focusedcolor>
					<disabledcolor>00ffffff</disabledcolor>
					<include>DL_Tex_ButtonPrimary</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<include content="VidInfo_ButtonNav">
						<param name="left1" value="$PARAM[left1]"/>
						<param name="left1_if" value="$PARAM[left1_if]"/>
						<param name="left2" value="$PARAM[left2]"/>
						<param name="left2_if" value="$PARAM[left2_if]"/>
						<param name="left3" value="$PARAM[left3]"/>
						<param name="left3_if" value="$PARAM[left3_if]"/>
						<param name="left4" value="$PARAM[left4]"/>
						<param name="left4_if" value="$PARAM[left4_if]"/>
						<param name="right1" value="$PARAM[right1]"/>
						<param name="right1_if" value="$PARAM[right1_if]"/>
						<param name="right2" value="$PARAM[right2]"/>
						<param name="right2_if" value="$PARAM[right2_if]"/>
						<param name="down1" value="$PARAM[down1]"/>
						<param name="down2" value="$PARAM[down2]"/>
					</include>
				</control>
				<control type="image">
					<left>24</left>
					<top>17</top>
					<width>22</width>
					<height>22</height>
					<texture colordiffuse="$VAR[DL_OnAccent]">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>24</left>
					<top>17</top>
					<width>22</width>
					<height>22</height>
					<texture colordiffuse="$VAR[DL_Ink]">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>$PARAM[text_x]</left>
					<top>0</top>
					<right>20</right>
					<height>button_h</height>
					<align>$PARAM[align]</align>
					<font>button_22</font>
					<textcolor>$VAR[DL_OnAccent]</textcolor>
					<label>$PARAM[label]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>$PARAM[text_x]</left>
					<top>0</top>
					<right>20</right>
					<height>button_h</height>
					<align>$PARAM[align]</align>
					<font>button_22</font>
					<textcolor>$VAR[DL_Ink]</textcolor>
					<label>$PARAM[label]</label>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- "More" row pill. params: id, label, onclick, onclick2, visible -->
	<include name="VidInfo_MoreButton">
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<include>VidView_PillLook</include>
				<height>44</height>
				<font>ui_22_semibold</font>
				<texturefocus border="22,0,22,0" colordiffuse="$VAR[DL_Accent]">daylight/pill_44.png</texturefocus>
				<texturenofocus border="22,0,22,0" colordiffuse="$VAR[DL_Ground]">daylight/pill_44.png</texturenofocus>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- media flag pill (enabled, never navigated to). params: label, visible -->
	<include name="VidInfo_Flag">
		<param name="visible">true</param>
		<definition>
			<control type="button">
				<width>auto</width>
				<height>40</height>
				<font>small_20_semibold</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<focusedcolor>$VAR[DL_Ink2]</focusedcolor>
				<textoffsetx>16</textoffsetx>
				<texturefocus border="20,0,20,0" colordiffuse="$VAR[DL_Line2]">daylight/pill_40_line.png</texturefocus>
				<texturenofocus border="20,0,20,0" colordiffuse="$VAR[DL_Line2]">daylight/pill_40_line.png</texturenofocus>
				<label>$PARAM[label]</label>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ================================================================ page sections -->
	<!-- Hero card: art, poster, kicker, title, meta, buttons -->
	<include name="VidInfo_Hero">
		<control type="group">
			<left>page_margin</left>
			<top>168</top>
			<width>page_width</width>
			<height>520</height>
			<include>DL_Card</include>
			<control type="image">
				<left>540</left>
				<top>0</top>
				<width>1140</width>
				<height>520</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<include>Anim_BackgroundCrossfade</include>
				<texture background="true" diffuse="daylight/mask_hero_tall.png" colordiffuse="$VAR[DL_ArtDim]">$VAR[VidInfo_Fanart]</texture>
			</control>
			<control type="image">
				<left>540</left>
				<top>0</top>
				<width>1140</width>
				<height>520</height>
				<texture colordiffuse="$VAR[DL_Surface]">daylight/hero_fade.png</texture>
			</control>
			<!-- poster -->
			<control type="group">
				<left>48</left>
				<top>65</top>
				<width>260</width>
				<height>390</height>
				<control type="image">
					<left>-120</left>
					<top>-90</top>
					<right>-120</right>
					<bottom>-150</bottom>
					<texture border="120" colordiffuse="$VAR[DL_Shadow]">daylight/card_shadow.png</texture>
				</control>
				<include content="VidView_ArtFallback">
					<param name="mask" value="daylight/mask_poster_info.png"/>
					<param name="label" value="$VAR[VidInfo_Title]"/>
					<param name="label_visible" value="String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(thumb))"/>
				</include>
				<include content="VidView_ArtImage">
					<param name="art" value="$VAR[VidInfo_Poster]"/>
					<param name="mask" value="daylight/mask_poster_info.png"/>
					<param name="fade" value="160"/>
				</include>
			</control>
			<!-- text column -->
			<control type="group">
				<left>352</left>
				<top>56</top>
				<width>700</width>
				<height>340</height>
				<control type="image">
					<left>0</left>
					<top>9</top>
					<width>10</width>
					<height>10</height>
					<texture colordiffuse="$VAR[DL_Accent]">daylight/circle_12.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>680</width>
					<height>28</height>
					<font>ui_22_semibold</font>
					<textcolor>$VAR[DL_AccentText]</textcolor>
					<label>$VAR[VidInfo_Kicker]</label>
				</control>
				<control type="grouplist">
					<left>0</left>
					<top>40</top>
					<width>700</width>
					<height>300</height>
					<orientation>vertical</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<!-- measuring copy (transparent): the meta follows a 1- or 2-line title -->
					<include content="T_VidInfo_Measure">
						<param name="label" value="$VAR[VidInfo_Title]"/>
					</include>
					<control type="image"><width>10</width><height>16</height><texture></texture></control>
					<control type="grouplist">
						<width>700</width>
						<height>34</height>
						<orientation>horizontal</orientation>
						<itemgap>10</itemgap>
						<usecontrolcoords>true</usecontrolcoords>
						<control type="label">
							<width max="520">auto</width>
							<height>34</height>
							<font>ui_24_semibold</font>
							<textcolor>$VAR[DL_Ink]</textcolor>
							<label>$VAR[VidView_MetaLeft]</label>
						</control>
						<control type="label">
							<width>auto</width>
							<height>34</height>
							<font>ui_24_semibold</font>
							<textcolor>$VAR[DL_Ink2]</textcolor>
							<label>·</label>
							<visible>$EXP[VidView_HasRating]</visible>
						</control>
						<control type="image">
							<top>6</top>
							<width>22</width>
							<height>22</height>
							<texture colordiffuse="$VAR[DL_Accent]">daylight/icons/star.png</texture>
							<visible>$EXP[VidView_HasRating]</visible>
						</control>
						<control type="label">
							<width>auto</width>
							<height>34</height>
							<font>ui_24_semibold</font>
							<textcolor>$VAR[DL_Ink]</textcolor>
							<label>$INFO[ListItem.Rating]</label>
							<visible>$EXP[VidView_HasRating]</visible>
						</control>
					</control>
					<control type="label">
						<width>700</width>
						<height>32</height>
						<font>ui_22</font>
						<textcolor>$VAR[DL_Ink2]</textcolor>
						<label>$INFO[ListItem.Genre]</label>
					</control>
					<control type="image"><width>10</width><height>10</height><texture></texture></control>
					<control type="grouplist">
						<width>700</width>
						<height>32</height>
						<orientation>horizontal</orientation>
						<itemgap>10</itemgap>
						<usecontrolcoords>true</usecontrolcoords>
						<visible>!String.IsEmpty(ListItem.Duration)</visible>
						<control type="label">
							<width max="420">auto</width>
							<height>32</height>
							<font>ui_22</font>
							<textcolor>$VAR[DL_Ink2]</textcolor>
							<label>$VAR[VidInfo_EndLine]</label>
						</control>
						<control type="image">
							<top>5</top>
							<width>22</width>
							<height>22</height>
							<texture colordiffuse="$VAR[DL_AccentText]">daylight/icons/check.png</texture>
							<visible>$EXP[DL_ItemFits]</visible>
						</control>
						<control type="label">
							<width max="300">auto</width>
							<height>32</height>
							<font>ui_22_semibold</font>
							<textcolor>$VAR[DL_AccentText]</textcolor>
							<label>fits before $VAR[DL_BedWord]</label>
							<visible>$EXP[DL_ItemFits]</visible>
						</control>
					</control>
				</control>
				<!-- visible title, unclipped -->
				<control type="group">
					<left>0</left>
					<top>40</top>
					<width>700</width>
					<include content="T_VidInfo_Title">
