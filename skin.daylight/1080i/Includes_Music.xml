				</control>
				<control type="label">
					<left>184</left>
					<top>20</top>
					<width>420</width>
					<height>20</height>
					<font>cap_20</font>
					<textcolor>$VAR[DL_Accent]</textcolor>
					<label>$VAR[Music_NPKicker]</label>
				</control>
				<control type="grouplist">
					<left>184</left>
					<top>42</top>
					<width>420</width>
					<height>32</height>
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
