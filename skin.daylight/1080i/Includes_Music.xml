					<left>list_text_x</left>
					<top>0</top>
					<right>200</right>
					<height>66</height>
					<font>ui_25_semibold</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$VAR[Music_ItemLabel]</label>
				</control>
				<control type="label">
					<right>list_text_x</right>
					<top>0</top>
					<width>180</width>
					<height>66</height>
					<align>right</align>
					<font>num_21</font>
