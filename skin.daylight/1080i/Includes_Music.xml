					<height>22</height>
					<align>center</align>
					<font>cap_20</font>
					<textcolor>$VAR[DL_Ink3]</textcolor>
					<label>$LOCALIZE[31232]</label>
					<visible>$PARAM[caption_visible]</visible>
				</control>
			</control>
		</definition>
	</include>



