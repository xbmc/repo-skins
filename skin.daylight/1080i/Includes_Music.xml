	<!-- Song row: track no (or ▶ when playing) · title · artist · duration.
	     params: width (1080), list_id, number (infolabel for the left column), condition -->
	<include name="Music_SongLayout">
		<param name="width">1080</param>
		<param name="list_id">50</param>
		<param name="number">$INFO[ListItem.TrackNumber]</param>
		<param name="condition">true</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<include content="Music_SongRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="number" value="$PARAM[number]"/>
					<param name="title_font" value="ui_25_semibold"/>
					<param name="title_color" value="$VAR[DL_Ink2]"/>
					<param name="scroll" value="false"/>
				</include>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>66</height>
					<texture border="20" colordiffuse="$VAR[DL_Accent]">daylight/card16.png</texture>
