<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music building blocks (Builder C). Prefix: Music_ (includes, variables, expressions), music_ (constants).
	Used by MyMusicNav, Includes_Views_Music, DialogMusicInfo, MusicVisualisation, MusicOSD,
	MyPlaylist, MyMusicPlaylistEditor. Home may reuse Music_NowPlayingBar (SPEC 4.2 "music playing").
	Sources: mockups Music.dc.html / MusicStage.dc.html / OSD.dc.html, DESIGN 5-7, DATA 4.9-4.11.

	TMDb Helper (optional, guarded by $EXP[ArtBackgroundOn] which includes System.AddonIsEnabled):
	- Library + info dialog: the TMDb Helper image monitor blurs the focused item / info item
	  (MyMusicNav.xml and DialogMusicInfo.xml are both monitored windows) using
	  Window(Home).Property(TMDbHelper.Blur.SourceImage) = Art(thumb), output
	  Window(Home).Property(TMDbHelper.ListItem.BlurImage) (+ .Original = source path).
	  Needs Skin.HasSetting(TMDbHelper.EnableBlur).
	- Now playing: no list item, so the cover is blurred on demand with
	  RunScript(plugin.video.themoviedb.helper,blur_image=<path>,prefix=DaylightPlayer)
	  -> Window(Home).Property(TMDbHelper.DaylightPlayer.BlurImage) (checked in tmdbhelper 6.17.x
	  script/method/image_functions.py + monitor/images.py).
-->
<includes>
	<!-- ============================================================ constants -->
	<!-- Albums grid (view 504): 7 columns, cover 219, column gap 32, row gap 30 (Music.dc.html).
	     The panel is padded 14 px on every side of each cell so the focus frame (+7) and the
	     5 % zoom (+6) are not clipped by the container. -->
	<constant name="music_tile">219</constant>
	<constant name="music_cell_w">251</constant>          <!-- 219 + 32 -->
	<constant name="music_cell_h">310</constant>          <!-- 219 + 12 + 25 + 3 + 21 + 30 -->
	<constant name="music_pad">14</constant>
	<constant name="music_grid_left">82</constant>        <!-- 96 - 14 -->
	<constant name="music_grid_top">146</constant>        <!-- 160 - 14 -->
	<constant name="music_grid_w">1757</constant>         <!-- 7 x 251 -->
	<constant name="music_grid_h">838</constant>          <!-- clip at y 984 (top of the now-playing bar) -->
	<!-- Big Album (view 505): 380 squares, gap 28, focus slot 2 at x 504, top 230 (MusicStage.dc.html).
	     Item content is offset (20, 130) inside the container so the focused item's soft shadow,
	     zoom and frame fit; the container's left edge (76) hides the item before slot 1. -->
	<constant name="music_big">380</constant>
	<constant name="music_big_pitch">408</constant>       <!-- 380 + 28 -->
	<constant name="music_big_left">76</constant>
	<constant name="music_big_top">100</constant>
	<constant name="music_big_w">1844</constant>
	<constant name="music_big_h">668</constant>
	<constant name="music_big_pad_x">20</constant>
	<constant name="music_big_pad_y">130</constant>
	<constant name="music_details_x">504</constant>
	<constant name="music_details_y">662</constant>
	<!-- Lists / panels -->
	<constant name="music_list_top">160</constant>
	<constant name="music_list_h">792</constant>          <!-- 12 rows of 66, ends at 952 -->
	<constant name="music_panel_x">1264</constant>
	<constant name="music_panel_art">560</constant>
	<!-- Header tabs (inside the 120 px top bar, Music.dc.html) -->
	<constant name="music_tab_top">47</constant>  <!-- centre 65 = the header date's centre (DL_Clock) -->
	<constant name="music_tab_h">36</constant>
	<!-- Now-playing bar (DESIGN 7.9) -->
	<constant name="music_np_top">984</constant>
	<constant name="music_np_h">96</constant>
	<!-- Now playing window / OSD (OSD.dc.html geometry) -->
	<constant name="music_np_cover">560</constant>
	<constant name="music_np_text_x">720</constant>
	<constant name="music_np_text_w">1104</constant>
	<constant name="music_progress_y">806</constant>
	<constant name="music_osd_y">900</constant>
	<constant name="music_osd_btn">72</constant>
	<constant name="music_osd_btn_f">88</constant>
	<constant name="music_osd_y_f">892</constant>

	<!-- ========================================================== expressions -->
	<expression name="Music_IsPlaying">Player.HasAudio</expression>
	<!-- Header tab that matches the current library node (path based, so drilling into an artist keeps ARTISTS lit) -->
	<expression name="Music_TabArtists">String.StartsWith(Container.FolderPath,musicdb://artists/)</expression>
	<expression name="Music_TabGenres">String.StartsWith(Container.FolderPath,musicdb://genres/)</expression>
	<expression name="Music_TabSongs">String.StartsWith(Container.FolderPath,musicdb://songs/)</expression>
	<expression name="Music_TabAlbums">String.StartsWith(Container.FolderPath,musicdb://albums/) | String.StartsWith(Container.FolderPath,musicdb://recentlyaddedalbums/) | String.StartsWith(Container.FolderPath,musicdb://compilations/) | [Container.Content(albums) + !String.StartsWith(Container.FolderPath,musicdb://artists/) + !String.StartsWith(Container.FolderPath,musicdb://genres/)]</expression>
	<!-- At a tab root (used to hide the folder caption in the page header) -->
	<expression name="Music_AtTabRoot">String.IsEqual(Container.FolderPath,musicdb://albums/) | String.IsEqual(Container.FolderPath,musicdb://artists/) | String.IsEqual(Container.FolderPath,musicdb://songs/) | String.IsEqual(Container.FolderPath,musicdb://genres/)</expression>
	<!-- Soft / Visible artwork background: add the focus halo behind the frame (DESIGN 7.2) -->
	<expression name="Music_ArtStrong">$EXP[ArtBackgroundOn] + [String.IsEqual(Skin.String(daylight.artbackground),soft) | String.IsEqual(Skin.String(daylight.artbackground),visible)]</expression>
	<expression name="Music_InfoIsAlbum">String.IsEqual(ListItem.DBType,album)</expression>
	<expression name="Music_InfoIsArtist">String.IsEqual(ListItem.DBType,artist)</expression>
	<expression name="Music_InfoIsSong">String.IsEqual(ListItem.DBType,song)</expression>
	<!-- Now playing: the cover blur exists and belongs to the track that is playing now -->
	<expression name="Music_PlayerBlurReady">!String.IsEmpty(Window(Home).Property(TMDbHelper.DaylightPlayer.BlurImage)) + String.IsEqual(Window(Home).Property(daylight.np.blursrc),Player.Art(thumb))</expression>

	<!-- ============================================================ variables -->




	<!-- Title for any item; the ".." parent item (filelists.showparentdiritems = on) reads "Back" -->
	<variable name="Music_ItemLabel">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<variable name="Music_SortArrow">
		<value condition="Container.SortDirection(descending)">↓</value>
		<value>↑</value>
	</variable>
	<!-- Now playing kicker -->
	<variable name="Music_NPKicker">
		<value condition="Player.Paused">Paused$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
		<value>Now playing$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
	</variable>
	<!-- Shuffle / repeat state caption (Now playing) -->
	<variable name="Music_PlayModes">
		<value condition="Playlist.IsRandom + Playlist.IsRepeatOne">Shuffle  ·  Repeat one</value>
		<value condition="Playlist.IsRandom + Playlist.IsRepeat">Shuffle  ·  Repeat all</value>
		<value condition="Playlist.IsRandom">Shuffle</value>
		<value condition="Playlist.IsRepeatOne">Repeat one</value>
		<value condition="Playlist.IsRepeat">Repeat all</value>
	</variable>
	<!-- Info dialog -->
	<variable name="Music_InfoKicker">
		<value condition="$EXP[Music_InfoIsArtist]">Artist</value>
		<value condition="$EXP[Music_InfoIsSong]">Song$INFO[ListItem.TrackNumber,  ·  Track ,]</value>
		<value condition="!String.IsEmpty(ListItem.Property(Album_ReleaseType)) + !String.IsEqual(ListItem.Property(Album_ReleaseType),album)">Album$INFO[ListItem.Property(Album_ReleaseType),  ·  ,]</value>
		<value>Album</value>
	</variable>
	<variable name="Music_InfoTitle">
		<value condition="$EXP[Music_InfoIsArtist] + !String.IsEmpty(ListItem.Artist)">$INFO[ListItem.Artist]</value>
		<value condition="$EXP[Music_InfoIsSong] + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value condition="$EXP[Music_InfoIsAlbum] + !String.IsEmpty(ListItem.Album)">$INFO[ListItem.Album]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="Music_InfoSubline">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Type)]$INFO[ListItem.Property(Artist_Style),  ·  ,]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Artist]$INFO[ListItem.Album,  ·  ,]</value>
		<value>$INFO[ListItem.Artist]</value>
	</variable>
	<variable name="Music_InfoDescription">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Description)]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Comment]</value>
		<value>$INFO[ListItem.Property(Album_Description)]</value>
	</variable>
	<variable name="Music_InfoListCaption">
		<value condition="$EXP[Music_InfoIsArtist]">Discography$INFO[Container(50).NumItems,  ·  ,]</value>
		<value>Tracklist$INFO[Container(50).NumItems,  ·  ,]</value>
	</variable>
	<!-- Shuffle (skin action; Kodi has no shuffle button in this dialog). PlayMedia clears the music
	     playlist (which resets shuffle), then the button's second action turns RandomOn. -->
	<variable name="Music_InfoShuffleAction">
		<value condition="$EXP[Music_InfoIsArtist]">PlayMedia(musicdb://artists/$INFO[ListItem.DBID]/,isdir)</value>
		<value>PlayMedia(musicdb://albums/$INFO[ListItem.DBID]/,isdir)</value>
	</variable>
	<!-- Queue window (MyPlaylist) -->
	<variable name="Music_QueueTitle">
		<value condition="Window.IsActive(videoplaylist)">Video queue</value>
		<value>Queue</value>
	</variable>
	<variable name="Music_QueueIndex">
		<value condition="Window.IsActive(videoplaylist)">02</value>
		<value>04</value>
	</variable>
	<variable name="Music_QueueShuffleLabel">
		<value condition="Playlist.IsRandom">Shuffle: on</value>
		<value>Shuffle: off</value>
	</variable>

	<!-- ================================================================ cover -->
	<!-- Square cover with corner mask (picked at window load, DESIGN 7.1) and an optional opaque
	     dim (colordiffuse). Fallback = raised tile with the name, covered by the art when it loads.
	     Sits inside a group of the cover size.
	     params: art, title, mask_round (default 219 grid mask), diffuse (default white = undimmed),
	             fadetime (embedded MP3 art loads slowly: default 160) -->
	<include name="Music_Cover">
		<param name="art">$INFO[ListItem.Art(thumb)]</param>
		<param name="title">$INFO[ListItem.Label]</param>
		<param name="mask_round">masks/square_round8.png</param>
		<param name="diffuse">white</param>
		<param name="fadetime">160</param>
		<param name="parent_icon">40</param>
		<param name="parent_caption">false</param>
		<definition>
			<include content="Music_ParentTile">
				<param name="icon" value="$PARAM[parent_icon]"/>
				<param name="caption_visible" value="$PARAM[parent_caption]"/>
			</include>
			<control type="group">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<visible>!ListItem.IsParentFolder</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture border="20" colordiffuse="$VAR[DL_Raised]">daylight/card16.png</texture>
			</control>
			<control type="textbox">
				<left>16</left>
				<top>14</top>
				<right>16</right>
				<height>52</height>
				<font>small_20_bold</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$PARAM[title]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" diffuse="$PARAM[mask_round]" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>true</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>false</visible>
			</control>
			</control>
		</definition>
	</include>

	<!-- ".." parent item tile (same look as Builder B's VidView_ParentTile): hairline box + back
	     chevron + optional "UP ONE LEVEL" caption. Inside the cover group. params: icon, caption_visible -->
	<include name="Music_ParentTile">
		<param name="icon">40</param>
		<param name="caption_visible">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="10" colordiffuse="$VAR[DL_Line2]">$VAR[ButtonOutline]</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>$PARAM[icon]</width>
					<height>$PARAM[icon]</height>
