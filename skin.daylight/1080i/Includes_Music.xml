					<control type="label">
						<width max="400">auto</width>
						<height>32</height>
						<font>ui_22</font>
						<textcolor>$VAR[DL_Ink2]</textcolor>
						<label>$INFO[MusicPlayer.Artist,  ·  ,]</label>
					</control>
				</control>
				<control type="progress">
					<left>632</left>
					<top>47</top>
					<width>1014</width>
					<height>2</height>
					<texturebg colordiffuse="$VAR[DL_Line2]">common/white.png</texturebg>
					<midtexture colordiffuse="$VAR[DL_Ink]">common/white.png</midtexture>
					<info>Player.Progress</info>
				</control>
				<control type="label">
					<left>1674</left>
					<top>33</top>
					<width>150</width>
					<height>30</height>
					<align>right</align>
					<font>num_21</font>
					<textcolor>$VAR[DL_Ink2]</textcolor>
