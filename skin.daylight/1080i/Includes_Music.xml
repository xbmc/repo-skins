					<textcolor>$VAR[DL_Ink2]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<right>list_text_x</right>
					<top>0</top>
					<width>180</width>
					<height>66</height>
					<align>right</align>
					<font>num_21</font>
