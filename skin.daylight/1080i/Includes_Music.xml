			</control>
		</definition>
	</include>

	<!-- ========================================================= header tabs -->


	<!-- ================================================== stage background -->

	<!-- ========================================================== music OSD -->



	<!-- ===================================================== Now playing blur -->

	<!-- Library / info: blur source for the TMDb Helper image monitor. Saves the previous value
	     (Home or video windows may use another source) and puts it back on unload.
	     param slot: Home property that holds the saved value; must differ per window because the
	     info dialog opens on top of the library (default daylight.blursrc.prev.music). -->
	<include name="Music_BlurSourceOnload">
		<param name="slot">daylight.blursrc.prev.music</param>
		<definition>
			<onload>SetProperty($PARAM[slot],$ESCINFO[Window(Home).Property(TMDbHelper.Blur.SourceImage)],Home)</onload>
			<onload>SetProperty(TMDbHelper.Blur.SourceImage,Art(thumb),Home)</onload>
			<onload condition="$EXP[ArtBackgroundOn] + !Skin.HasSetting(TMDbHelper.EnableBlur)">Skin.SetBool(TMDbHelper.EnableBlur)</onload>
			<onunload>SetProperty(TMDbHelper.Blur.SourceImage,$ESCINFO[Window(Home).Property($PARAM[slot])],Home)</onunload>
		</definition>
	</include>

	<!-- Info dialog: a description exists for this item type -->
	<expression name="Music_InfoHasDescription">[$EXP[Music_InfoIsAlbum] + !String.IsEmpty(ListItem.Property(Album_Description))] | [$EXP[Music_InfoIsArtist] + !String.IsEmpty(ListItem.Property(Artist_Description))] | [$EXP[Music_InfoIsSong] + !String.IsEmpty(ListItem.Comment)]</expression>



	<!-- ============================================== text rows (lists 50/100) -->
