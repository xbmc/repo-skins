				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>screen_w</width>
					<height>rule_h</height>
					<texture colordiffuse="$VAR[DL_Line2]">common/hairline.png</texture>
				</control>
				<control type="group">
					<left>page_margin</left>
