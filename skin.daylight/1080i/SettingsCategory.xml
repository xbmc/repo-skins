<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...) - M4, Builder E.
	Layout from mockups/Settings.dc.html: categories x96 w380, list x560 w860 (hairline rows,
	2px accent frame on focus), description in the right-hand aside x1500 w324.
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2 (Kodi writes it; shown as the page title),
	categories grouplist 3 + template 10, control area 5, description textbox 6, templates 7-15,
	level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>ff000000</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include content="DL_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$INFO[Control.GetLabel(2)]"/>
			<param name="sub" value="$LOCALIZE[5]"/>
		</include>

		<!-- ====== categories -->
		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>page_margin</left>
			<top>content_top</top>
			<width>settings_cat_w</width>
			<height>648</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="DL_SettingCategoryTemplate">
			<param name="width" value="settings_cat_w"/>
		</include>
		<control type="group">
			<left>page_margin</left>
			<top>880</top>
			<include content="DL_SettingLevelButton">
				<param name="width" value="settings_cat_w"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list (in a card, like Daylight's own settings) -->
		<control type="group">
			<left>540</left>
			<top>content_top</top>
			<width>980</width>
			<height>848</height>
			<include>DL_Card</include>
		</control>
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>560</left>
			<top>192</top>
			<width>920</width>
			<height>800</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="DL_SettingTemplates">
			<param name="width" value="920"/>
		</include>
		<include content="DL_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1494"/>
			<param name="top" value="192"/>
			<param name="height" value="800"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>

		<!-- ====== aside: what the focused setting does (same column as Daylight's settings) -->
		<control type="group">
			<left>1556</left>
			<top>content_top</top>
			<width>244</width>
			<control type="image">
				<left>0</left>
				<top>4</top>
				<width>32</width>
				<height>32</height>
				<texture colordiffuse="$VAR[DL_AccentText]">$VAR[DL_MoodIcon]</texture>
			</control>
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>0</left>
				<top>56</top>
				<width>244</width>
				<height>780</height>
				<font>ui_22_reg</font>
				<textcolor>$VAR[DL_Ink2]</textcolor>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>

		<control type="label" id="2">
			<description>section label (Kodi writes it; shown in the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
