<?xml version="1.0" encoding="UTF-8"?>
<!--
	Text viewer (changelogs, logs, long plots) - M4, Builder E. Reading panel: 1320px measure,
	body_23 (log files switch to the mono font), page position bottom-right.
	Id contract (Estuary Omega): heading 1, textbox 5, scrollbar 3000, focus button 1000.
	Focus sits on invisible button 1000: Up / Down page the text, OK and Back close.
-->
<window>
	<defaultcontrol always="true">1000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1440</width>
			<height>900</height>
			<include content="DL_GenericDialog">
				<param name="width" value="1440"/>
				<param name="height" value="900"/>
				<param name="header_id" value="1"/>
				<param name="kicker" value="$INFO[Container(5).CurrentPage]$INFO[Container(5).NumPages, / ,]"/>
			</include>
			<control type="textbox" id="5">
				<left>dialog_pad</left>
				<top>dialog_content_top</top>
				<width>1320</width>
				<height>689</height>  <!-- 21 lines exactly: no half-clipped line at the bottom -->
				<font>body_24</font>
				<monofont>Mono26</monofont>
				<pagecontrol>3000</pagecontrol>
			</control>
			<control type="scrollbar" id="3000">
				<left>1398</left>
				<top>dialog_content_top</top>
				<width>2</width>
				<height>704</height>
				<texturesliderbackground colordiffuse="$VAR[DL_Surface]">common/white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="$VAR[DL_Line2]">common/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="$VAR[DL_Accent]">common/white.png</texturesliderbarfocus>
				<onup>3000</onup>
				<ondown>3000</ondown>
				<onleft>1000</onleft>
				<onright>1000</onright>
			</control>
			<include content="DL_Rule">
				<param name="top" value="836"/>
				<param name="left" value="0"/>
				<param name="width" value="1440"/>
				<param name="color" value="$VAR[DL_Line2]"/>
			</include>
			<control type="label">
				<left>dialog_pad</left>
				<top>836</top>
				<width>1360</width>
				<height>64</height>
				<font>cap_20</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$LOCALIZE[31014]</label>
			</control>
		</control>
		<control type="button" id="1000">
			<description>focus holder: up/down page, OK closes</description>
			<include>DL_Hidden</include>
			<onclick>Action(Close)</onclick>
			<onup>PageUp(3000)</onup>
			<ondown>PageDown(3000)</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
		</control>
	</controls>
</window>
