<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information (Daylight). Movie, episode, TV show, season and collection share one page;
	texts switch on ListItem.DBType (Includes_VideoInfo.xml, VidView_* in Includes_Views_Video.xml).

	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo, Omega source):
	  8 play (plays from the beginning when 9 exists; browses for tvshow/season/set)
	  9 resume (enabled by Kodi only with a resume point) | 11 play trailer | 50 cast list
	  (collections: the films of the set) | 6 refresh | 7 user rating | 10 choose art | 12 choose
	  fanart | 13 director search | 14 manage versions | 15 manage extras | 443 go to collection.
	Daylight ids: 9000 button row (default focus), 9001 story card (OK = full story), 9010 More,
	  9012 Browse / 9013 From start (both re-send 8), 9100 More row, 9200 full story overlay, 61 its scrollbar.

	Focus map: buttons 9000 -Down-> story 9001 -Down-> cast 50 (the page slides up 440 px while 50 has
	focus). More -> 9100 row (replaces the lower cards; Up / Back return to More).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(daylight.leftmins,$VAR[DL_LeftMinsQ],home)</onload>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>DL_Background</include>
		<include>DL_MoodLine</include>
		<include>DL_ClockOnly</include>
		<control type="group">
			<description>page (slides up while the cast row has focus)</description>
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(daylight.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="240" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(daylight.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="0"/>
			</animation>
			<include>VidInfo_Hero</include>
			<include>VidInfo_LowerCards</include>
			<include>VidInfo_MoreRow</include>
			<include>VidInfo_CastRow</include>
		</control>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
