<?xml version="1.0" encoding="UTF-8"?>
<!--
	EPG grid jump controls, opened from the guide (SPEC 5: Minimal). Builder F, M4. A mono text bar
	at the bottom instead of Estuary's icon buttons; actions are Kodi's PVR.EpgGridControl builtin.
	Id plan (Estuary Omega DialogPVRGuideControls.xml): group 200; grouplists 201 (programmes:
	600-605), 202 (channels: 70040-70042), 203 (groups: 70043-70045). Back closes.
-->
<window>
	<defaultcontrol always="true">602</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group" id="200">
			<left>0</left>
			<top>880</top>
			<width>screen_w</width>
			<height>200</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>screen_w</width>
				<height>200</height>
				<texture colordiffuse="$VAR[DL_Ground]">common/white.png</texture>
			</control>
			<include content="DL_Rule">
				<param name="left" value="0"/>
				<param name="top" value="0"/>
				<param name="width" value="screen_w"/>
				<param name="color" value="$VAR[DL_Line2]"/>
			</include>
			<!-- programmes -->
			<include content="Misc_Caption">
				<param name="left" value="page_margin"/>
				<param name="top" value="36"/>
				<param name="width" value="800"/>
				<param name="label" value="Programme"/>
			</include>
			<control type="grouplist" id="201">
				<left>subnav_left</left>
				<top>84</top>
				<width>860</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<onleft>70045</onleft>
				<onright>70040</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<include content="DL_SubNavButton">
					<param name="id" value="600"/>
					<param name="label" value="First"/>
					<param name="onclick" value="PVR.EpgGridControl(FirstProgramme)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="601"/>
					<param name="label" value="-12 h"/>
					<param name="onclick" value="PVR.EpgGridControl(-12)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="602"/>
					<param name="label" value="Now"/>
					<param name="onclick" value="PVR.EpgGridControl(CurrentProgramme)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="603"/>
					<param name="label" value="+12 h"/>
					<param name="onclick" value="PVR.EpgGridControl(+12)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="604"/>
					<param name="label" value="Last"/>
					<param name="onclick" value="PVR.EpgGridControl(LastProgramme)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="605"/>
					<param name="label" value="Pick date"/>
					<param name="onclick" value="PVR.EpgGridControl(SelectDate)"/>
				</include>
			</control>
			<!-- channels -->
			<include content="Misc_Caption">
				<param name="left" value="1000"/>
				<param name="top" value="36"/>
				<param name="width" value="400"/>
				<param name="label" value="Channel"/>
			</include>
			<control type="grouplist" id="202">
				<left>990</left>
				<top>84</top>
				<width>420</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<onleft>605</onleft>
				<onright>70043</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<include content="DL_SubNavButton">
					<param name="id" value="70040"/>
					<param name="label" value="First"/>
					<param name="onclick" value="PVR.EpgGridControl(FirstChannel)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="70041"/>
					<param name="label" value="Playing"/>
					<param name="onclick" value="PVR.EpgGridControl(PlayingChannel)"/>
					<param name="visible" value="PVR.IsPlayingTV | PVR.IsPlayingRadio | PVR.IsPlayingEpgTag"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="70042"/>
					<param name="label" value="Last"/>
					<param name="onclick" value="PVR.EpgGridControl(LastChannel)"/>
				</include>
			</control>
			<!-- groups -->
			<include content="Misc_Caption">
				<param name="left" value="1440"/>
				<param name="top" value="36"/>
				<param name="width" value="384"/>
				<param name="label" value="Group"/>
			</include>
			<control type="grouplist" id="203">
				<left>1430</left>
				<top>84</top>
				<width>400</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>20</itemgap>
				<onleft>70042</onleft>
				<onright>600</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<include content="DL_SubNavButton">
					<param name="id" value="70043"/>
					<param name="label" value="Prev"/>
					<param name="onclick" value="PVR.EpgGridControl(PreviousGroup)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="70044"/>
					<param name="label" value="Next"/>
					<param name="onclick" value="PVR.EpgGridControl(NextGroup)"/>
				</include>
				<include content="DL_SubNavButton">
					<param name="id" value="70045"/>
					<param name="label" value="Choose"/>
					<param name="onclick" value="PVR.EpgGridControl(SelectGroup)"/>
				</include>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>146</top>
				<width>page_width</width>
				<height>30</height>
				<font>cap_20</font>
				<textcolor>$VAR[DL_Ink3]</textcolor>
				<label>$LOCALIZE[31214]</label>
			</control>
		</control>
	</controls>
</window>
