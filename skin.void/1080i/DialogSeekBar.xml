<?xml version="1.0" encoding="UTF-8"?>
<!--
	Seek bar = Void's minimal OSD (VoidOSD mockup): bottom scrim, title in serif 64, 1px timeline with
	a 2px playhead, "1:12:40" left and "−57:20 · ends 22:44" right. Shows while seeking, skipping,
	paused, fast-forwarding or showing time; nothing else ever covers the picture.
	Id contract (Estuary Omega DialogSeekBar.xml / GUIDialogSeekBar.cpp): 401 = slider Kodi moves to
	the seek target; drawn as the playhead while a seek is pending. 402/403 PVR only (not used).
	Window visibility copied from Estuary Omega (written out: no $EXP at window level). The content
	steps aside while the OSD / fullscreen info / a playback dialog draws its own (OSD_SeekBarHidden).
-->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>![Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(pvrguideinfo)]</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<zorder>0</zorder>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_SeekBarHidden] + !Player.HasGame</visible>
			<include>Anim_FadeVisible</include>
			<include>OSD_Scrim</include>
			<include>OSD_TitleBlock</include>
			<include content="OSD_Timeline">
				<param name="head_visible" value="!$EXP[OSD_SeekActive]"/>
			</include>
			<control type="slider" id="401">
				<left>158</left>
				<top>917</top>
				<width>1604</width>
				<height>28</height>
				<texturesliderbar colordiffuse="00ffffff">osd/head.png</texturesliderbar>
				<textureslidernib colordiffuse="white">osd/head.png</textureslidernib>
				<textureslidernibfocus colordiffuse="white">osd/head.png</textureslidernibfocus>
				<visible>$EXP[OSD_SeekActive]</visible>
			</control>
			<include>OSD_Numbers</include>
		</control>
	</controls>
</window>
