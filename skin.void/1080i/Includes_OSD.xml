<?xml version="1.0" encoding="UTF-8"?>
<!--
	Playback, Void (VoidOSD mockup): nothing over the picture but a bottom scrim, the title in serif,
	a 1px timeline with a 2px playhead and two numbers. The minimal version is the seek bar (seeking,
	paused, skipping); the Video OSD adds one row of text buttons under it at the same positions, so
	opening the OSD never moves anything.
	Users: VideoOSD, DialogSeekBar, DialogFullScreenInfo, DialogPlayerProcessInfo, DialogSlider,
	DialogSubtitles, VideoOSDBookmarks, PlayerControls, MusicOSD, MusicVisualisation.
	Kodi 21 Omega infolabels only (PlayerGUIInfo.cpp / GUIInfoManager.cpp, reference skins).
-->
<includes>
	<!-- =========================================================== expressions -->
	<!-- A playback dialog covers the OSD: hide the OSD chrome underneath (Tracks/AVSettings/
	     SubDownload/Offset mockups all show a clean frame + their own panel). -->
	<expression name="OSD_PanelOpen">$EXP[OSDPanelOpen] | Window.IsVisible(selectdialog) | Window.IsVisible(subtitlesearch) | Window.IsVisible(fullscreeninfo) | Window.IsVisible(movieinformation) | Window.IsVisible(contextmenu)</expression>
	<!-- The seek bar steps aside for the OSD / info (they draw their own progress) and for dialogs.
	     Process info keeps the bar (it sits top-left, the bar bottom). -->
	<expression name="OSD_SeekBarHidden">Window.IsVisible(videoosd) | Window.IsVisible(fullscreeninfo) | Window.IsVisible(sliderdialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(osdcmssettings) | Window.IsVisible(videobookmarks) | Window.IsVisible(selectdialog) | Window.IsVisible(subtitlesearch) | Window.IsVisible(movieinformation)</expression>
	<expression name="OSD_HasChapters">Integer.IsGreater(Player.ChapterCount,1)</expression>
	<expression name="OSD_HasPrevNext">Integer.IsGreater(Player.ChapterCount,1) | Integer.IsGreater(Playlist.Length(video),1) | Player.HasSceneMarkers</expression>
	<expression name="OSD_SeekActive">Player.Seeking | Player.HasPerformedSeek(3) | !String.IsEmpty(Player.SeekNumeric)</expression>
	<expression name="OSD_HasNext">!String.IsEmpty(VideoPlayer.offset(1).Title) + Window.IsActive(fullscreenvideo)</expression>
	<expression name="OSD_OffsetBarBottom">String.IsEqual(Skin.String(void.offsetbar),bottom)</expression>

	<!-- ============================================================= variables -->
	<variable name="OSD_Speed">
		<value condition="Player.Forwarding2x | Player.Rewinding2x">2x</value>
		<value condition="Player.Forwarding4x | Player.Rewinding4x">4x</value>
		<value condition="Player.Forwarding8x | Player.Rewinding8x">8x</value>
		<value condition="Player.Forwarding16x | Player.Rewinding16x">16x</value>
		<value condition="Player.Forwarding32x | Player.Rewinding32x">32x</value>
	</variable>
	<!-- Live state, first word of the kicker -->
	<variable name="OSD_State">
		<value condition="Player.Caching">Buffering$INFO[Player.CacheLevel, ,%]</value>
		<value condition="!String.IsEmpty(Player.SeekNumeric)">Go to $INFO[Player.SeekNumeric]</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">Skip $VAR[OSD_SkipValue]</value>
		<value condition="Player.Forwarding">Forward $VAR[OSD_Speed]</value>
		<value condition="Player.Rewinding">Rewind $VAR[OSD_Speed]</value>
		<value condition="Player.Paused">Paused</value>
		<value>Playing</value>
	</variable>
	<variable name="OSD_Title">
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value condition="!String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<!-- S02E04 with zero padding (VideoPlayer.Season/Episode are bare numbers) -->
	<variable name="OSD_EpisodeCode">
		<value condition="String.IsEmpty(VideoPlayer.Episode)"></value>
		<value condition="Integer.IsLess(VideoPlayer.Season,10) + Integer.IsLess(VideoPlayer.Episode,10)">S0$INFO[VideoPlayer.Season]E0$INFO[VideoPlayer.Episode]</value>
		<value condition="Integer.IsLess(VideoPlayer.Season,10)">S0$INFO[VideoPlayer.Season]E$INFO[VideoPlayer.Episode]</value>
		<value condition="Integer.IsLess(VideoPlayer.Episode,10)">S$INFO[VideoPlayer.Season]E0$INFO[VideoPlayer.Episode]</value>
		<value>S$INFO[VideoPlayer.Season]E$INFO[VideoPlayer.Episode]</value>
	</variable>
	<!-- One-line title for the minimal seek bar -->
	<variable name="OSD_ShortTitle">
		<value condition="VideoPlayer.Content(episodes)">$VAR[OSD_Title]$VAR[OSD_EpisodeCode,  ·  ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]$INFO[MusicPlayer.Artist,  ·  ,]</value>
		<value>$VAR[OSD_Title]</value>
	</variable>
	<!-- Next item (TV next episode / playlist), DialogFullScreenInfo -->
	<variable name="OSD_NextLabel">
		<value condition="VideoPlayer.Content(episodes) + Integer.IsLess(VideoPlayer.offset(1).Season,10) + Integer.IsLess(VideoPlayer.offset(1).Episode,10)">$INFO[VideoPlayer.offset(1).Season,S0,]$INFO[VideoPlayer.offset(1).Episode,E0,]$INFO[VideoPlayer.offset(1).Title,  ·  ,]</value>
		<value condition="VideoPlayer.Content(episodes) + Integer.IsLess(VideoPlayer.offset(1).Season,10)">$INFO[VideoPlayer.offset(1).Season,S0,]$INFO[VideoPlayer.offset(1).Episode,E,]$INFO[VideoPlayer.offset(1).Title,  ·  ,]</value>
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.offset(1).Season,S,]$INFO[VideoPlayer.offset(1).Episode,E,]$INFO[VideoPlayer.offset(1).Title,  ·  ,]</value>
		<value>$INFO[VideoPlayer.offset(1).Title]$INFO[VideoPlayer.offset(1).Year,  ·  ,]</value>
	</variable>

	<!-- Time shown at the playhead / as elapsed: the seek target while seeking -->
	<variable name="OSD_SeekTimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric]</value>
		<value condition="Player.Seeking + Integer.IsGreater(Player.Duration(h),0)">$INFO[Player.SeekTime(h:mm:ss)]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime]</value>
		<value condition="Integer.IsGreater(Player.Duration(h),0)">$INFO[Player.Time(h:mm:ss)]</value>
		<value>$INFO[Player.Time]</value>
	</variable>
	<!-- "+30s" skip feedback (step size while stepping, offset after the seek). Under a minute the
	     (mm) part is +00/-00, so (ss) is the whole value. -->
	<variable name="OSD_SkipValue">
		<value condition="!String.IsEmpty(Player.SeekStepSize) + Integer.IsEqual(Player.SeekStepSize(mm),0)">$INFO[Player.SeekStepSize(ss)]s</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$INFO[Player.SeekStepSize]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Integer.IsEqual(Player.SeekOffset(mm),0)">$INFO[Player.SeekOffset(ss)]s</value>
		<value condition="!String.IsEmpty(Player.SeekOffset)">$INFO[Player.SeekOffset]</value>
	</variable>

	<variable name="OSD_FlagVideoCodec">
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,h264) | String.IsEqual(VideoPlayer.VideoCodec,avc1)">H.264</value>
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,hevc) | String.IsEqual(VideoPlayer.VideoCodec,h265) | String.IsEqual(VideoPlayer.VideoCodec,hvc1)">HEVC</value>
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,mpeg2video)">MPEG-2</value>
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,vc1) | String.IsEqual(VideoPlayer.VideoCodec,wvc1)">VC-1</value>
		<value condition="String.IsEqual(VideoPlayer.VideoCodec,mpeg4) | String.IsEqual(VideoPlayer.VideoCodec,xvid) | String.IsEqual(VideoPlayer.VideoCodec,divx)">MPEG-4</value>
		<value>$INFO[VideoPlayer.VideoCodec]</value>
	</variable>
	<variable name="OSD_FlagHDR">
		<value condition="String.IsEqual(VideoPlayer.HdrType,dolbyvision)">DOLBY VISION</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10plus)">HDR10+</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(VideoPlayer.HdrType,hlg)">HLG</value>
		<value>$INFO[VideoPlayer.HdrType]</value>
	</variable>
	<variable name="OSD_AudioCodec">
		<value condition="String.Contains(VideoPlayer.AudioCodec,truehd) + String.Contains(VideoPlayer.AudioCodec,atmos)">TRUEHD ATMOS</value>
		<value condition="String.Contains(VideoPlayer.AudioCodec,eac3) + String.Contains(VideoPlayer.AudioCodec,atmos)">DD+ ATMOS</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,dtshd_ma_x)">DTS:X</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,truehd)">TRUEHD</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,eac3)">DD+</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,ac3)">DD</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_ma)">DTS-HD MA</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,dtshd_hra)">DTS-HD HRA</value>
		<value condition="String.IsEqual(VideoPlayer.AudioCodec,dca) | String.IsEqual(VideoPlayer.AudioCodec,dts)">DTS</value>
		<value condition="String.StartsWith(VideoPlayer.AudioCodec,pcm) | String.IsEqual(VideoPlayer.AudioCodec,lpcm)">PCM</value>
		<value>$INFO[VideoPlayer.AudioCodec]</value>
	</variable>
	<variable name="OSD_AudioChannels">
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,8)">7.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,7)">6.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,6)">5.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,5)">4.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,4)">4.0</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,3)">2.1</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,2)">2.0</value>
		<value condition="String.IsEqual(VideoPlayer.AudioChannels,1)">1.0</value>
	</variable>
	<variable name="OSD_FlagAudio">
		<value>$VAR[OSD_AudioCodec]$VAR[OSD_AudioChannels, ,]</value>
	</variable>

	<!-- OSD right-hand button values -->
	<variable name="OSD_SubtitleValue">
		<value condition="VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">$INFO[VideoPlayer.SubtitlesLanguage]</value>
		<value condition="VideoPlayer.SubtitlesEnabled">On</value>
		<value condition="VideoPlayer.HasSubtitles">Off</value>
		<value>None</value>
	</variable>
	<variable name="OSD_AudioValue">
		<value condition="!String.IsEmpty(VideoPlayer.AudioCodec)">[UPPERCASE]$VAR[OSD_FlagAudio][/UPPERCASE]</value>
		<value condition="!String.IsEmpty(VideoPlayer.AudioLanguage)">$INFO[VideoPlayer.AudioLanguage]</value>
		<value>Streams</value>
	</variable>
	<!-- PlayerControls -->
	<variable name="OSD_PlayerArt">
		<value condition="!String.IsEmpty(Player.Art(poster))">$INFO[Player.Art(poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(tvshow.poster))">$INFO[Player.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(thumb))">$INFO[Player.Art(thumb)]</value>
		<value>$INFO[Player.Icon]</value>
	</variable>
	<!-- Process info: decoder HW/SW, HDR or SDR -->
	<variable name="OSD_DecoderType">
		<value condition="Player.Process(videohwdecoder)">HW</value>
		<value>SW</value>
	</variable>
	<variable name="OSD_DynamicRange">
		<value condition="!String.IsEmpty(VideoPlayer.HdrType)">$VAR[OSD_FlagHDR]</value>
		<value>SDR</value>
	</variable>

	<variable name="OSD_Kicker">
		<value condition="VideoPlayer.Content(episodes)">$VAR[OSD_EpisodeCode]$INFO[VideoPlayer.Title,[COLOR sep_light]  ·  [/COLOR],]</value>
		<value condition="VideoPlayer.Content(musicvideos)">$INFO[VideoPlayer.Artist]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,[COLOR sep_light]  ·  [/COLOR],]</value>
	</variable>
	<!-- second number: remaining and end time, "−57:20 · ends 22:44" -->
	<variable name="OSD_Right">
		<value condition="Integer.IsGreater(Player.TimeRemaining(h),0) + Player.HasVideo">−$INFO[Player.TimeRemaining(h:mm:ss)][COLOR sep_light]  ·  [/COLOR]ends $INFO[Player.FinishTime]</value>
		<value condition="!String.IsEmpty(Player.TimeRemaining) + Player.HasVideo">−$INFO[Player.TimeRemaining][COLOR sep_light]  ·  [/COLOR]ends $INFO[Player.FinishTime]</value>
		<value condition="!String.IsEmpty(Player.TimeRemaining)">−$INFO[Player.TimeRemaining]</value>
		<value>$INFO[Player.Duration]</value>
	</variable>
	<!-- grey note after the elapsed number: skip size, speed, buffering -->
	<variable name="OSD_Note">
		<value condition="Player.Caching">buffering$INFO[Player.CacheLevel, ,%]</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">$VAR[OSD_SkipValue]</value>
		<value condition="!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)">$VAR[OSD_SkipValue]</value>
		<value condition="Player.Forwarding">$VAR[OSD_Speed] forward</value>
		<value condition="Player.Rewinding">$VAR[OSD_Speed] back</value>
	</variable>
	<variable name="OSD_FSMeta">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.Premiered,aired ,]$INFO[VideoPlayer.Rating,[COLOR sep_light]  ·  [/COLOR][COLOR value],[/COLOR]]$INFO[VideoPlayer.Genre,[COLOR sep_light]  ·  [/COLOR],]</value>
		<value>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Rating,[COLOR sep_light]  ·  [/COLOR][COLOR value],[/COLOR]]$INFO[VideoPlayer.Director,[COLOR sep_light]  ·  [/COLOR],]$INFO[VideoPlayer.Genre,[COLOR sep_light]  ·  [/COLOR],]</value>
	</variable>
	<variable name="OSD_RepeatState">
		<value condition="Playlist.IsRepeatOne">one</value>
		<value condition="Playlist.IsRepeat">all</value>
		<value>off</value>
	</variable>
	<variable name="OSD_ShuffleState">
		<value condition="Playlist.IsRandom">on</value>
		<value>off</value>
	</variable>
	<variable name="OSD_PauseLabel">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">Play</value>
		<value>Pause</value>
	</variable>
	<variable name="OSD_SubFlags">
		<value condition="ListItem.Property(hearing_imp) + ListItem.Property(sync)">[COLOR sep]  ·  [/COLOR][COLOR text]in sync[/COLOR][COLOR sep]  ·  [/COLOR]hearing impaired</value>
		<value condition="ListItem.Property(sync)">[COLOR sep]  ·  [/COLOR][COLOR text]in sync[/COLOR]</value>
		<value condition="ListItem.Property(hearing_imp)">[COLOR sep]  ·  [/COLOR]hearing impaired</value>
	</variable>

	<!-- ============================================================= pieces -->
	<!-- Bottom-only scrim (VoidOSD stops), own fades (LESSONS 4). param height -->
	<include name="OSD_Scrim">
		<param name="height">520</param>
		<definition>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>$PARAM[height]</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="scrim">common/scrim_bottom.png</texture>
			</control>
		</definition>
	</include>
	<!-- engine name: the same single bottom scrim -->
	<include name="OSD_Scrims">
		<param name="bottom_h">520</param>
		<param name="top_h">0</param>
		<definition>
			<include content="OSD_Scrim"><param name="height" value="$PARAM[bottom_h]"/></include>
		</definition>
	</include>

	<!-- Kicker (caps) + title (serif 64) at the mockup positions (title CSS box 826 -> Kodi top 836) -->
	<include name="OSD_TitleBlock">
		<control type="label">
			<left>164</left>
			<top>796</top>
			<width>1500</width>
			<height>24</height>
			<aligny>top</aligny>
			<font>capsw_20</font>
			<textcolor>grey</textcolor>
			<label>$VAR[OSD_Kicker]</label>
		</control>
		<include content="Title_OSD">
			<param name="label" value="$VAR[OSD_Title]"/>
			<param name="p0" value="7841"/>
			<param name="p1" value="7842"/>
		</include>
	</include>

	<!-- 1px timeline (26% track, white elapsed) + 2px playhead (slider nib: osd/head.png is both the
	     bar and the nib texture, 28 px tall, so Kodi draws the nib 1:1, centred on the line). -->
	<include name="OSD_Timeline">
		<param name="head_visible">true</param>
		<definition>
		<control type="progress">
			<left>160</left>
			<top>930</top>
			<width>1600</width>
			<height>1</height>
			<texturebg colordiffuse="42f2f2f0">common/white.png</texturebg>
			<midtexture colordiffuse="text">common/white.png</midtexture>
			<info>Player.Progress</info>
		</control>
		<control type="slider">
			<left>158</left>
			<top>917</top>
			<width>1604</width>
			<height>28</height>
			<texturesliderbar colordiffuse="00ffffff">osd/head.png</texturesliderbar>
			<textureslidernib colordiffuse="white">osd/head.png</textureslidernib>
			<textureslidernibfocus colordiffuse="white">osd/head.png</textureslidernibfocus>
			<info>Player.Progress</info>
			<visible>$PARAM[head_visible]</visible>
		</control>
		</definition>
	</include>
	<!-- the two numbers (+ a grey note after the elapsed one) -->
	<include name="OSD_Numbers">
		<control type="grouplist">
			<left>160</left>
			<top>954</top>
			<width>1000</width>
			<height>30</height>
			<orientation>horizontal</orientation>
			<itemgap>20</itemgap>
			<control type="label">
				<width>auto</width>
				<height>30</height>
				<aligny>top</aligny>
				<font>num_24</font>
				<textcolor>text</textcolor>
				<label>$VAR[OSD_SeekTimeLabel]</label>
			</control>
			<control type="label">
				<width>auto</width>
				<height>30</height>
				<aligny>top</aligny>
				<font>num_24</font>
				<textcolor>grey</textcolor>
				<label>$VAR[OSD_Note]</label>
			</control>
		</control>
		<control type="label">
			<right>160</right>
			<top>954</top>
			<width>900</width>
			<height>30</height>
			<align>right</align>
			<aligny>top</aligny>
			<font>num_24</font>
			<textcolor>grey</textcolor>
			<label>$VAR[OSD_Right]</label>
		</control>
	</include>

	<!-- Text button for the OSD row. params: id, label, onclick, visible, width.
	     width: FIXED = widest label + 2 x 14 + (characters + 4) (sans_24_med measured with PIL; Kodi needs ~1 px per glyph more), so the left-aligned row never
	     reflows when a label changes (Pause/Play, Shuffle on/off, Repeat one/all/off). Only the last
	     buttons of a row, whose values change rarely (audio / subtitle stream), stay auto. -->
	<include name="OSD_RowButton">
		<param name="visible">true</param>
		<param name="width">auto</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<top>4</top>
				<width>$PARAM[width]</width>
				<height>48</height>
				<font>sans_24_med</font>
				<textcolor>grey_dim</textcolor>
				<focusedcolor>text</focusedcolor>
				<textoffsetx>14</textoffsetx>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
				<include content="Void_Anim_FocusText"><param name="zoom" value="112"/></include>
			</control>
		</definition>
	</include>

	<!-- ============================================================= rows -->
	<!-- Key / value row (process info). params: key, value, visible -->
	<include name="OSD_InfoRow">
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<width>900</width>
				<height>42</height>
				<visible>$PARAM[visible]</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>260</width>
					<height>42</height>
					<font>caps_20</font>
					<textcolor>grey_soft</textcolor>
					<label>$PARAM[key]</label>
				</control>
				<control type="label">
					<left>260</left>
					<top>0</top>
					<width>640</width>
					<height>42</height>
					<font>num_24</font>
					<textcolor>text</textcolor>
					<label>$PARAM[value]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- One DialogSubtitles result row (696 x 84): language, file name, meta; HI / sync as words.
	     params: focused, color -->
	<include name="OSD_SubtitleRow">
		<param name="focused">false</param>
		<param name="color">grey</param>
		<definition>
			<control type="label">
				<left>16</left>
				<top>12</top>
				<width>72</width>
				<height>32</height>
				<aligny>top</aligny>
				<font>caps_20</font>
				<textcolor>grey</textcolor>
				<label>$INFO[ListItem.Thumb]</label>
			</control>
			<control type="label">
				<left>96</left>
				<top>8</top>
				<width>590</width>
				<height>36</height>
				<aligny>top</aligny>
				<font>sans_26_med</font>
				<textcolor>$PARAM[color]</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<scroll>$PARAM[focused]</scroll>
			</control>
			<control type="label">
				<left>96</left>
				<top>46</top>
				<width>590</width>
				<height>26</height>
				<aligny>top</aligny>
				<font>sans_22</font>
				<textcolor>grey_soft</textcolor>
				<label>$INFO[ListItem.Label]$INFO[ListItem.ActualIcon,[COLOR sep]  ·  [/COLOR]rating , / 5]$VAR[OSD_SubFlags]</label>
			</control>
		</definition>
	</include>

	<!-- One VideoOSDBookmarks thumb (item 344 x 290; thumb 320 x 180 at 8,12). params: label_color, art_color -->
	<include name="OSD_BookmarkItem">
		<param name="label_color">grey</param>
		<param name="art_color">art_35</param>
		<definition>
			<control type="label">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>
				<align>center</align>
				<font>num_24</font>
				<textcolor>grey_soft</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="image">
				<left>8</left>
				<top>12</top>
				<width>320</width>
				<height>180</height>
				<aspectratio>scale</aspectratio>
				<fadetime>120</fadetime>
				<texture background="true" colordiffuse="$PARAM[art_color]">$INFO[ListItem.Art(thumb)]</texture>
				<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="label">
