<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video OSD, Void: exactly the seek bar's composition (title, 1px timeline, two numbers) plus one row
	of text buttons at y=1004 that appears when the OSD is opened. Nothing moves when it opens.
	Id contract (Estuary Omega VideoOSD.xml): 602 play/pause (default), 603 stop (focus when pause is
	not possible), 600 previous / 607 next (chapter or playlist item), 601 rewind / 606 forward
	(not shown: Left/Right on the timeline seek instead), 87 seek stepper, 200 = button row,
	70043 info, 70044 chapters/bookmarks, 70046 subtitles, 70048 video settings, 70049 audio,
	70051 player process info (Void).
	Row order: Play/Pause, Stop, Previous, Next, Chapters, Info, Stats, Picture, Audio, Subtitles.
	Focus map: open -> 602. Left/Right walk the row. Up -> 87 (timeline brightens; Left/Right skip,
	frame step when paused); Down from 87 -> the row. Back closes the OSD (Kodi default).
	Auto-hide: Custom_1152_OSDAutoHide.xml (skin setting). Chrome hides while a playback dialog is up.
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_PanelOpen]</visible>
			<include>Anim_FadeVisible</include>
			<include>OSD_Scrim</include>
			<include>OSD_TitleBlock</include>
			<include>OSD_Timeline</include>
			<!-- seek mode: the track brightens while the stepper has focus -->
			<control type="image">
				<left>160</left>
				<top>930</top>
				<width>1600</width>
				<height>1</height>
				<texture colordiffuse="99f2f2f0">common/white.png</texture>
				<visible>Control.HasFocus(87)</visible>
				<include>Anim_FadeVisible</include>
			</control>
			<include>OSD_Numbers</include>
			<control type="button" id="87">
				<description>seek stepper</description>
				<include>Void_Hidden</include>
				<onup>noop</onup>
				<ondown>200</ondown>
				<onleft>StepBack</onleft>
				<onright condition="!Player.Paused">StepForward</onright>
				<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				<visible>Player.SeekEnabled</visible>
			</control>
			<control type="grouplist" id="200">
				<left>146</left>
				<top>1000</top>
				<width>1640</width>
				<height>56</height>
				<orientation>horizontal</orientation>
				<itemgap>30</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<onup condition="Player.SeekEnabled">87</onup>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<ondown>noop</ondown>
				<!-- Order (Omar): Play/Pause, Stop next to it, then chapter / item skips, Chapters, Info, Stats, and
				     the three settings panels last. Fixed widths (OSD_RowButton); Audio and Subtitles carry live
				     values, so they end the row where a width change moves nothing else. -->
				<include content="OSD_RowButton">
					<param name="id" value="602"/>
					<param name="label" value="$VAR[OSD_PauseLabel]"/>
					<param name="onclick" value="PlayerControl(Play)"/>
					<param name="width" value="107"/>
					<param name="visible" value="Player.PauseEnabled"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="603"/>
					<param name="label" value="Stop"/>
					<param name="onclick" value="PlayerControl(Stop)"/>
					<param name="width" value="91"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="600"/>
					<param name="label" value="Previous"/>
					<param name="onclick" value="PlayerControl(Previous)"/>
					<param name="width" value="140"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="607"/>
					<param name="label" value="Next"/>
					<param name="onclick" value="PlayerControl(Next)"/>
					<param name="width" value="92"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70044"/>
					<param name="label" value="Chapters"/>
					<param name="onclick" value="ActivateWindow(videobookmarks)"/>
					<param name="width" value="147"/>
					<param name="visible" value="Player.SeekEnabled + !VideoPlayer.Content(livetv)"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70043"/>
					<param name="label" value="Info"/>
					<param name="onclick" value="Action(Info,fullscreenvideo)"/>
					<param name="width" value="80"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70051"/>
					<param name="label" value="Stats"/>
					<param name="onclick" value="Action(PlayerProcessInfo)"/>
					<param name="width" value="98"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70048"/>
					<param name="label" value="Picture"/>
					<param name="onclick" value="ActivateWindow(osdvideosettings)"/>
					<param name="width" value="123"/>
					<param name="visible" value="Player.HasVideo"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70049"/>
					<param name="label" value="Audio  [COLOR grey_soft]$VAR[OSD_AudioValue][/COLOR]"/>
					<param name="onclick" value="ActivateWindow(osdaudiosettings)"/>
				</include>
				<include content="OSD_RowButton">
					<param name="id" value="70046"/>
					<param name="label" value="Subtitles  [COLOR grey_soft]$VAR[OSD_SubtitleValue][/COLOR]"/>
					<param name="onclick" value="ActivateWindow(osdsubtitlesettings)"/>
					<param name="visible" value="Player.HasVideo"/>
				</include>
			</control>
		</control>
	</controls>
</window>
