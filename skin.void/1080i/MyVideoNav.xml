<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library: rotary text index (50), sparse poster wall (51) (Includes_Views.xml); One (53), Frames (54),
	Notes (55), Stills (56, episodes) (Includes_ViewsMore.xml, generated by _src/make_views.py).
	Kodi id contract (Estuary Omega MyVideoNav.xml / CGUIWindowVideoNav): views listed in <views>
	(first valid one opens a new node: the index), menucontrol 9000, 3 = sort by, 4 = sort order,
	14 = watched filter toggle (SendClick only). Void ids: 9321-9328 options buttons (9326 View = view picker 1161, 9328 Options = Library panel 1160).
	Focus map: view -Up at the top / Left on item 1-> options 9000 -Down/Back-> view. Library panel 1160:
	Right on the last index item, Left/Right past the wall edges, Left/Right past the ends of 9000, Options.
	Back on the view = Kodi parent folder. Empty folder: focus lands on the options row.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>50,51,53,54,55,56</views>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include>Void_View53_Ambient</include>
		<control type="group">
			<visible>!ControlGroup(9000).HasFocus()</visible>
			<include>Void_Anim_Dwell</include>
			<include content="Void_TopBar">
				<param name="title" value="$VAR[Lib_Title]"/>
				<param name="sub" value="$VAR[Lib_Sub]"/>
			</include>
			<include>LibPanel_HeaderWord</include>
		</control>
		<include content="Void_View50"><param name="viewlabel" value="31217"/><param name="libpanel" value="true"/></include>
		<include>Void_View51</include>
		<include>Void_View53</include>
		<include>Void_View54</include>
		<include>Void_View55</include>
		<include>Void_View56</include>
		<include content="Void_LibraryEmpty">
			<param name="hint" value="Up for sort, filter and view. With Unwatched on, everything may be filtered away."/>
		</include>
		<control type="grouplist" id="9000">
			<include>Void_OptionsBegin</include>
			<!-- 0.9.7: Left past the first word / Right past the last = the Library panel -->
			<onleft>ActivateWindow(1160)</onleft>
			<onright>ActivateWindow(1160)</onright>
			<ondown>SetFocus(50)</ondown>
			<onback>SetFocus(50)</onback>
			<!-- watched filter -->
			<include content="Void_SubNavButton">
				<param name="id" value="9321"/>
				<param name="label" value="$VAR[VidLib_FilterLabel]"/>
				<param name="width" value="301"/>
				<param name="onclick" value="SendClick(14)"/>
				<param name="visible" value="$EXP[Lib_IsVideoLibrary] + !$EXP[Lib_IsInProgressTV]"/>
			</include>
			<!-- TV: in progress / all shows -->
			<include content="Void_SubNavButton">
				<param name="id" value="9323"/>
				<param name="label" value="In progress"/>
				<param name="width" value="218"/>
				<param name="onclick" value="Container.Update(videodb://inprogresstvshows/)"/>
				<param name="visible" value="$EXP[Lib_IsTVRoot]"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9322"/>
				<param name="label" value="All shows"/>
				<param name="width" value="218"/>
				<param name="onclick" value="Container.Update(videodb://tvshows/titles/)"/>
				<param name="visible" value="$EXP[Lib_IsInProgressTV]"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9324"/>
				<param name="label" value="Sort  $INFO[Container.SortMethod]"/>
				<param name="onclick" value="SendClick(3)"/>
				<param name="visible" value="Control.IsEnabled(3)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9325"/>
				<param name="label" value="$VAR[VidLib_Direction]"/>
				<param name="width" value="213"/>
				<param name="onclick" value="SendClick(4)"/>
				<param name="visible" value="Control.IsEnabled(4)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9326"/>
				<param name="label" value="View  $INFO[Container.Viewmode]"/>
				<param name="width" value="211"/>
				<param name="onclick" value="ActivateWindow(1161)"/>
				<param name="visible" value="Integer.IsGreater(Container.ViewCount,1)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9327"/>
				<param name="label" value="Search"/>
				<param name="onclick" value="ActivateWindow(1150)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="9328"/>
				<param name="label" value="More"/>
				<param name="onclick" value="ActivateWindow(1160)"/>
			</include>
		</control>
		<include>Void_OptionsCaption</include>
		<include>Void_SortControls</include>
	</controls>
</window>
