<?xml version="1.0" encoding="UTF-8"?>
<!--
	Event log (SPEC 5: Minimal). Builder F, M4. Options on the left, events on the right.
	Kodi id contract (Estuary Omega EventLog.xml / GUIWindowEventLog): view container 50 +
	scrollbar 60, menucontrol 9000 holding togglebutton 4 (sort order), button 21 (level filter,
	Kodi sets the label), radiobutton 22 (include higher levels, Kodi sets the label), button 20
	(clear); 501 opens the logging settings. Item property Event.Description.
	The list and the options share focus group 9100, so an empty log still lands focus on the options.
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include content="Void_TopBar">
			<param name="index" value="14"/>
			<param name="title" value="Event log"/>
			<param name="sub" value="$INFO[Container.NumItems]"/>
		</include>
		<control type="group" id="9100">
			<defaultcontrol always="true">50</defaultcontrol>
			<!-- ====== events -->
			<control type="list" id="50">
				<left>misc_col_x</left>
				<top>content_top</top>
				<width>1230</width>
				<height>840</height>
				<onleft>9000</onleft>
				<onright>60</onright>
				<onup>50</onup>
				<ondown>50</ondown>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<itemlayout width="1230" height="120">
					<control type="image">
						<left>16</left>
						<top>20</top>
						<width>64</width>
						<height>64</height>
						<aspectratio>keep</aspectratio>
						<texture background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>104</left>
						<top>12</top>
						<width>820</width>
						<height>36</height>
						<font>serif_32</font>
						<textcolor>grey</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<right>list_text_x</right>
						<top>12</top>
						<width>300</width>
						<height>36</height>
						<align>right</align>
						<font>num_14</font>
						<textcolor>grey_soft</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
					<control type="textbox">
						<left>104</left>
						<top>52</top>
						<width>1100</width>
						<height>56</height>
						<font>small_19</font>
						<textcolor>grey_soft</textcolor>
						<label>$INFO[ListItem.Property(Event.Description)]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>1230</width>
						<height>rule_h</height>
						<texture colordiffuse="00ffffff">common/white.png</texture>
					</control>
				</itemlayout>
				<focusedlayout width="1230" height="120">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>1230</width>
						<height>120</height>
						<texture colordiffuse="00ffffff">common/white.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>list_bar_w</width>
						<height>120</height>
						<texture colordiffuse="00ffffff">common/white.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="image">
						<left>16</left>
						<top>20</top>
						<width>64</width>
						<height>64</height>
						<aspectratio>keep</aspectratio>
						<texture background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>104</left>
						<top>12</top>
						<width>820</width>
						<height>36</height>
						<font>serif_32</font>
						<textcolor>text_primary</textcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<right>list_text_x</right>
						<top>12</top>
						<width>300</width>
						<height>36</height>
						<align>right</align>
						<font>num_14</font>
						<textcolor>grey</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
					<control type="textbox">
						<left>104</left>
						<top>52</top>
						<width>1100</width>
						<height>56</height>
						<font>small_19</font>
						<label>$INFO[ListItem.Property(Event.Description)]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>1230</width>
						<height>rule_h</height>
						<texture colordiffuse="00ffffff">common/white.png</texture>
					</control>
				</focusedlayout>
			</control>
			<!-- ====== options -->
			<control type="grouplist" id="9000">
				<left>page_margin</left>
				<top>content_top</top>
				<width>misc_menu_w</width>
				<height>400</height>
				<orientation>vertical</orientation>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>noop</onleft>
				<onright>50</onright>
				<onback>50</onback>
				<control type="togglebutton" id="4">
					<description>Sort order</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
					<label>$LOCALIZE[31243] $LOCALIZE[584]</label>
					<altlabel>$LOCALIZE[31243] $LOCALIZE[585]</altlabel>
				</control>
				<control type="button" id="21">
					<description>Level filter (Kodi sets the label)</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				</control>
				<control type="radiobutton" id="22">
					<description>Include higher levels (Kodi sets the label)</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				</control>
				<control type="button" id="20">
					<description>Clear</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
					<label>$LOCALIZE[192]</label>
				</control>
				<control type="button" id="501">
					<description>Logging settings</description>
					<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
					<label>$LOCALIZE[5]</label>
					<onclick>ActivateWindow(systemsettings,logging)</onclick>
				</control>
			</control>
		</control>
		<include content="Void_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1810"/>
			<param name="top" value="content_top"/>
			<param name="height" value="840"/>
			<param name="onleft" value="50"/>
			<param name="onright" value="9000"/>
		</include>
		<control type="label">
			<left>misc_col_x</left>
			<top>content_top</top>
			<width>1230</width>
			<height>list_row_h</height>
			<font>mono_15</font>
			<textcolor>grey_soft</textcolor>
			<label>$LOCALIZE[31244]</label>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
		</control>
	</controls>
</window>
