<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults. Void's focus language everywhere: NO outlines, NO fills. Unfocused text is grey,
	focused text is the warm white (brightness); lists and button rows add scale (a zoom animation or
	a larger serif focused layout, see Includes_Common.xml). State indicators (radio dot, slider nib,
	edit underline) also brighten on focus.
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>sans_26</font>
		<textcolor>text</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<selectedcolor>text</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>sans_26</font>
		<textcolor>text</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>sans_28</font>
		<textcolor>text_body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<textoffsetx>0</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<alttexturefocus />
		<alttexturenofocus />
		<textoffsetx>0</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<radiowidth>12</radiowidth>
		<radioheight>12</radioheight>
		<textureradioonfocus colordiffuse="text">common/dot.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="grey">common/dot.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="grey">common/dash.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="sep">common/dash.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="disabled">common/dot.png</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="disabled">common/dash.png</textureradiooffdisabled>
		<textoffsetx>0</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="sep">common/chevron.png</textureup>
		<texturedown colordiffuse="sep" flipx="true">common/chevron.png</texturedown>
		<textureupfocus colordiffuse="text">common/chevron.png</textureupfocus>
		<texturedownfocus colordiffuse="text" flipx="true">common/chevron.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">common/chevron.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">common/chevron.png</texturedowndisabled>
		<textoffsetx>0</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>sans_26</font>
		<textcolor>grey</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="sep">common/chevron.png</textureup>
		<texturedown colordiffuse="sep" flipx="true">common/chevron.png</texturedown>
		<textureupfocus colordiffuse="text">common/chevron.png</textureupfocus>
		<texturedownfocus colordiffuse="text" flipx="true">common/chevron.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">common/chevron.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">common/chevron.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<sliderwidth>320</sliderwidth>
		<sliderheight>24</sliderheight>
		<texturesliderbar colordiffuse="hairline_strong">common/sliderbar.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hairline">common/sliderbar.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="grey">common/slidernib.png</textureslidernib>
		<textureslidernibfocus colordiffuse="text">common/slidernib.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/slidernib.png</textureslidernibdisabled>
		<textoffsetx>0</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="hairline_strong">common/sliderbar.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hairline">common/sliderbar.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="grey">common/slidernib.png</textureslidernib>
		<textureslidernibfocus colordiffuse="text">common/slidernib.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/slidernib.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>sans_28_med</font>
		<textcolor>grey_dim</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus />
		<texturenofocus />
		<colorwidth>48</colorwidth>
		<colorheight>24</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="disabled">common/white.png</texturecolordisabledmask>
		<textoffsetx>0</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>sans_28</font>
		<textcolor>grey</textcolor>
		<focusedcolor>text</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<invalidcolor>grey_dim</invalidcolor>
		<texturefocus border="0,0,0,3" colordiffuse="text">common/underline.png</texturefocus>
		<texturenofocus border="0,0,0,3" colordiffuse="sep">common/underline.png</texturenofocus>
		<textoffsetx>0</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="hairline_strong">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="text">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="hairline">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="sep">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="text">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
