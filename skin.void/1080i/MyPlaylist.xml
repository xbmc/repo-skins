<?xml version="1.0" encoding="UTF-8"?>
<!--
	Play queue (musicplaylist and videoplaylist both load this file), Void: the queue as the rotary
	text index, options row above it.
	Kodi id contract (Estuary Omega MyPlaylist.xml / GUIWindowMusicPlaylist.cpp): menucontrol 9000,
	20 shuffle (Kodi toggles on click), 26 repeat (Kodi writes "Repeat: Off/One/All"), 21 save,
	22 clear. Views: 50 (any id listed in <views> works).
	Navigation: Up at the top / Left on item 1 -> options; Down / Back -> list; Back -> previous window.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>50</views>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<control type="group">
			<visible>!ControlGroup(9000).HasFocus()</visible>
			<include>Void_Anim_Dwell</include>
			<include content="Void_TopBar">
				<param name="title" value="$VAR[Music_QueueTitle]"/>
				<param name="sub" value="$VAR[PL_Container_NumItems_Item]$INFO[Container.TotalTime,  ·  ,]"/>
			</include>
		</control>
		<include content="Void_View50"><param name="viewlabel" value="31217"/></include>
		<include content="Void_LibraryEmpty">
			<param name="hint" value="The queue is empty."/>
		</include>
		<control type="grouplist" id="9000">
			<include>Void_OptionsBegin</include>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<ondown>SetFocus(50)</ondown>
			<onback>SetFocus(50)</onback>
			<include content="Void_SubNavButton">
				<param name="id" value="20"/>
				<param name="label" value="$VAR[Music_QueueShuffleLabel]"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="26"/>
				<param name="label" value="$LOCALIZE[595]"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="21"/>
				<param name="label" value="$LOCALIZE[190]"/>
				<param name="visible" value="Integer.IsGreater(Container.NumItems,0)"/>
			</include>
			<include content="Void_SubNavButton">
				<param name="id" value="22"/>
				<param name="label" value="$LOCALIZE[192]"/>
				<param name="visible" value="Integer.IsGreater(Container.NumItems,0)"/>
			</include>
		</control>
		<include>Void_OptionsCaption</include>
	</controls>
</window>
