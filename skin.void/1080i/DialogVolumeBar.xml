<?xml version="1.0" encoding="UTF-8"?>
<!--
	Volume, Void: one quiet line under the clock, top right - "Volume  62 %" and a 1px line.
	Volume usually lives on the TV via CEC, so this rarely shows. Hidden progress 29999 holds
	Player.Volume (Estuary contract) so the label can read the percentage.
-->
<window>
	<zorder>4</zorder>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(startup) + !Window.IsActive(GameVolume)</visible>
			<include>Anim_Toast</include>
			<control type="progress" id="29999">
				<description>volume (Kodi)</description>
				<left>-3000</left>
				<top>-3000</top>
				<width>1</width>
				<height>1</height>
				<info>Player.Volume</info>
			</control>
			<control type="image">
				<left>1180</left>
				<top>60</top>
				<width>740</width>
				<height>160</height>
				<texture colordiffuse="d9000000">common/scrim_right.png</texture>
			</control>
			<control type="label">
				<right>160</right>
				<top>124</top>
				<width>600</width>
				<height>30</height>
				<align>right</align>
				<aligny>top</aligny>
				<font>num_24</font>
				<label>[COLOR grey]Volume  [/COLOR]$INFO[Control.GetLabel(29999),, %]</label>
				<visible>!Player.Muted</visible>
			</control>
			<control type="label">
				<right>160</right>
				<top>124</top>
				<width>600</width>
				<height>30</height>
				<align>right</align>
				<aligny>top</aligny>
				<font>sans_24</font>
				<textcolor>grey</textcolor>
				<label>$LOCALIZE[31015]</label>
				<visible>Player.Muted</visible>
			</control>
			<control type="progress">
				<right>160</right>
				<top>168</top>
				<width>320</width>
				<height>1</height>
				<info>Player.Volume</info>
				<visible>!Player.Muted</visible>
			</control>
		</control>
	</controls>
</window>
