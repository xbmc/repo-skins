	</variable>
	<variable name="PL_Container_NumItems_Item"><!--Container.NumItems|| items-->
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 item</value>
		<value>$INFO[Container.NumItems,, items]</value>
	</variable>
	<variable name="PL_PlayCount_Time"><!--ListItem.PlayCount|[COLOR sep]  ·  [/COLOR]played | times-->
