<?xml version="1.0" encoding="UTF-8"?>
<!-- Count captions that read right at 1 ("1 season", not "1 seasons").
     Each PL_ variable: singular value at exactly 1, else the original $INFO[count,prefix, plural]. -->
<includes>
	<variable name="PL_Container_120_NumItems_Result"><!--Container(120).NumItems|| RESULTS-->
		<value condition="Integer.IsEqual(Container(120).NumItems,1)">1 RESULT</value>
		<value>$INFO[Container(120).NumItems,, RESULTS]</value>
	</variable>
	<variable name="PL_Container_9105_TotalSeasons_Season"><!--Container(9105).ListItem.Property(TotalSeasons)|| seasons-->
		<value condition="Integer.IsEqual(Container(9105).ListItem.Property(TotalSeasons),1)">1 season</value>
		<value>$INFO[Container(9105).ListItem.Property(TotalSeasons),, seasons]</value>
	</variable>
	<variable name="PL_Movies_Count_Film"><!--Window(Home).Property(Movies.Count)|| films-->
		<value condition="Integer.IsEqual(Window(Home).Property(Movies.Count),1)">1 film</value>
		<value>$INFO[Window(Home).Property(Movies.Count),, films]</value>
	</variable>
	<variable name="PL_TVShows_Count_Show"><!--Window(Home).Property(TVShows.Count)|| shows-->
		<value condition="Integer.IsEqual(Window(Home).Property(TVShows.Count),1)">1 show</value>
