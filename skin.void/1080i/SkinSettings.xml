<?xml version="1.0" encoding="UTF-8"?>
<!--
	Void skin settings (docs/skin.void/SETTINGS.md). One column of rows on the x=160 axis: name on the
	left, value on the right; OK / Right = next value, Left = previous. The focused row is white and
	grows a little; what it does is explained on the right. Reset asks for a second OK.
	Ids: 9600 rows grouplist, 9601-9610 rows, 9630 Main menu heading, 9611-9621 main menu rows,
	9631 Custom rows heading, 9622-9624 custom rows, 9632 Custom menu items heading, 9625-9627 menu items, 9889 favourites data list. No Kodi-owned ids (custom content of skinsettings).
-->
<window>
	<defaultcontrol always="true">9601</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<onload>ClearProperty(void.resetarmed,home)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include content="Void_TopBar">
			<param name="title" value="Settings"/>
			<param name="sub" value="Void"/>
		</include>
		<control type="label">
			<left>152</left>
			<top>150</top>
			<width>1100</width>
			<height>80</height>
			<aligny>top</aligny>
			<font>serif_72</font>
			<label>$LOCALIZE[31336]</label>
		</control>
		<control type="grouplist" id="9600">
			<left>146</left>
			<top>260</top>
			<width>1120</width>
			<height>740</height>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<!-- 1 dwell pace -->
			<control type="button" id="9601">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31277]</label>
				<label2>$VAR[SkinSet_DwellLabel]</label2>
				<onclick>Skin.SetString(void.dwell,$VAR[SkinSet_DwellNext])</onclick>
				<onright>Skin.SetString(void.dwell,$VAR[SkinSet_DwellNext])</onright>
				<onleft>Skin.SetString(void.dwell,$VAR[SkinSet_DwellPrev])</onleft>
			</control>
			<!-- 2 ambient -->
			<control type="button" id="9602">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31278]</label>
				<label2>$VAR[SkinSet_AmbientLabel]</label2>
				<onclick>Skin.ToggleSetting(void.noambient)</onclick>
				<onright>Skin.ToggleSetting(void.noambient)</onright>
				<onleft>Skin.ToggleSetting(void.noambient)</onleft>
			</control>
			<!-- 3 ambient level -->
			<control type="button" id="9603">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31279]</label>
				<label2>$VAR[SkinSet_LevelLabel]</label2>
				<onclick>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelNext])</onclick>
				<onright>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelNext])</onright>
				<onleft>Skin.SetString(void.ambientlevel,$VAR[SkinSet_LevelPrev])</onleft>
				<enable>!Skin.HasSetting(void.noambient)</enable>
			</control>
			<!-- 4 Ken Burns -->
			<control type="button" id="9604">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31280]</label>
				<label2>$VAR[SkinSet_KenBurnsLabel]</label2>
				<onclick>Skin.ToggleSetting(void.nokenburns)</onclick>
				<onright>Skin.ToggleSetting(void.nokenburns)</onright>
				<onleft>Skin.ToggleSetting(void.nokenburns)</onleft>
				<enable>!Skin.HasSetting(void.noambient) + !Skin.HasSetting(void.reducemotion)</enable>
			</control>
			<!-- 5 hints -->
			<control type="button" id="9605">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31281]</label>
				<label2>$VAR[SkinSet_HintsLabel]</label2>
				<onclick>Skin.ToggleSetting(void.nohints)</onclick>
				<onright>Skin.ToggleSetting(void.nohints)</onright>
				<onleft>Skin.ToggleSetting(void.nohints)</onleft>
			</control>
			<!-- 6 clock -->
			<control type="button" id="9606">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31282]</label>
				<label2>$VAR[SkinSet_ClockLabel]</label2>
				<onclick>Skin.ToggleSetting(void.noclock)</onclick>
				<onright>Skin.ToggleSetting(void.noclock)</onright>
				<onleft>Skin.ToggleSetting(void.noclock)</onleft>
			</control>
			<!-- 7 OSD auto-hide -->
			<control type="button" id="9607">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31283]</label>
				<label2>$VAR[SkinSet_OSDLabel]</label2>
				<onclick>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDNext])</onclick>
				<onright>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDNext])</onright>
				<onleft>Skin.SetString(void.osdhide,$VAR[SkinSet_OSDPrev])</onleft>
			</control>
			<!-- 8 offset strip position -->
			<control type="button" id="9608">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31284]</label>
				<label2>$VAR[SkinSet_OffsetLabel]</label2>
				<onclick condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onclick>
				<onclick condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onclick>
				<onright condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onright>
				<onright condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onright>
				<onleft condition="String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,top)</onleft>
				<onleft condition="!String.IsEqual(Skin.String(void.offsetbar),bottom)">Skin.SetString(void.offsetbar,bottom)</onleft>
			</control>
			<!-- 9 reduce motion -->
			<control type="button" id="9609">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31285]</label>
				<label2>$VAR[SkinSet_MotionLabel]</label2>
				<onclick>Skin.ToggleSetting(void.reducemotion)</onclick>
				<onright>Skin.ToggleSetting(void.reducemotion)</onright>
				<onleft>Skin.ToggleSetting(void.reducemotion)</onleft>
			</control>
			<!-- 10 reset (second OK confirms; conditions are read once per key press) -->
			<control type="button" id="9610">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31286]</label>
				<label2>$VAR[SkinSet_ResetLabel]</label2>
				<onclick condition="String.IsEmpty(Window(Home).Property(void.resetarmed))">SetProperty(void.resetarmed,1,home)</onclick>
				<onclick condition="!String.IsEmpty(Window(Home).Property(void.resetarmed))">Skin.ResetSettings</onclick>
				<onclick condition="!String.IsEmpty(Window(Home).Property(void.resetarmed))">ClearProperty(void.resetarmed,home)</onclick>
				<onunfocus>ClearProperty(void.resetarmed,home)</onunfocus>
			</control>
			<!-- main menu (0.9.10): HideMenu.* bools; Settings / System never hide -->
			<control type="group" id="9630">
				<width>1100</width>
				<height>96</height>
				<control type="label">
					<left>14</left>
					<top>44</top>
					<width>1000</width>
					<height>24</height>
					<aligny>top</aligny>
					<font>caps_20</font>
					<textcolor>grey_soft</textcolor>
					<label>$LOCALIZE[31340]</label>
				</control>
			</control>
			<control type="button" id="9611">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31301]</label>
				<label2>$VAR[SkinSet_MenuLabel_Movies]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Movies)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Movies)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Movies)</onleft>
			</control>
			<control type="button" id="9612">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31302]</label>
				<label2>$VAR[SkinSet_MenuLabel_TVShows]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.TVShows)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.TVShows)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.TVShows)</onleft>
			</control>
			<control type="button" id="9613">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31211]</label>
				<label2>$VAR[SkinSet_MenuLabel_Music]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Music)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Music)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Music)</onleft>
			</control>
			<control type="button" id="9614">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31303]</label>
				<label2>$VAR[SkinSet_MenuLabel_MusicVideos]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.MusicVideos)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.MusicVideos)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.MusicVideos)</onleft>
			</control>
			<control type="button" id="9615">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31304]</label>
				<label2>$VAR[SkinSet_MenuLabel_LiveTV]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.LiveTV)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.LiveTV)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.LiveTV)</onleft>
			</control>
			<control type="button" id="9616">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31305]</label>
				<label2>$VAR[SkinSet_MenuLabel_Weather]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Weather)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Weather)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Weather)</onleft>
			</control>
			<control type="button" id="9617">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31306]</label>
				<label2>$VAR[SkinSet_MenuLabel_Addons]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Addons)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Addons)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Addons)</onleft>
			</control>
			<control type="button" id="9618">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31307]</label>
				<label2>$VAR[SkinSet_MenuLabel_Favourites]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Favourites)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Favourites)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Favourites)</onleft>
			</control>
			<control type="button" id="9619">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31308]</label>
				<label2>$VAR[SkinSet_MenuLabel_Pictures]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Pictures)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Pictures)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Pictures)</onleft>
			</control>
			<control type="button" id="9620">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31309]</label>
				<label2>$VAR[SkinSet_MenuLabel_Files]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Files)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Files)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Files)</onleft>
			</control>
			<control type="button" id="9621">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31208]</label>
				<label2>$VAR[SkinSet_MenuLabel_Search]</label2>
				<onclick>Skin.ToggleSetting(HideMenu.Search)</onclick>
				<onright>Skin.ToggleSetting(HideMenu.Search)</onright>
				<onleft>Skin.ToggleSetting(HideMenu.Search)</onleft>
			</control>
			<!-- custom rows (0.9.10): three opt-in Home shelves after Search; OK opens the row's options (Includes_CustomRows.xml) -->
			<control type="group" id="9631">
				<width>1100</width>
				<height>96</height>
				<control type="label">
					<left>14</left>
					<top>44</top>
					<width>1000</width>
					<height>24</height>
					<aligny>top</aligny>
					<font>caps_20</font>
					<textcolor>grey_soft</textcolor>
					<label>$LOCALIZE[31940]</label>
				</control>
			</control>
			<control type="button" id="9622">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31941]</label>
				<label2>$VAR[CustomRow_Value1]</label2>
				<include content="CustomRows_SettingsClick"><param name="row" value="1"/><param name="heading" value="$LOCALIZE[31941]"/></include>
			</control>
			<control type="button" id="9623">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31942]</label>
				<label2>$VAR[CustomRow_Value2]</label2>
				<include content="CustomRows_SettingsClick"><param name="row" value="2"/><param name="heading" value="$LOCALIZE[31942]"/></include>
			</control>
			<control type="button" id="9624">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31943]</label>
				<label2>$VAR[CustomRow_Value3]</label2>
				<include content="CustomRows_SettingsClick"><param name="row" value="3"/><param name="heading" value="$LOCALIZE[31943]"/></include>
			</control>
			<!-- custom menu items (0.9.16): up to three add-ons / favourites / library folders in the Library shelf, before
			     Settings / System; OK opens the item's options (Includes_CustomMenu.xml) -->
			<control type="group" id="9632">
				<width>1100</width>
				<height>96</height>
				<control type="label">
					<left>14</left>
					<top>44</top>
					<width>1000</width>
					<height>24</height>
					<aligny>top</aligny>
					<font>caps_20</font>
					<textcolor>grey_soft</textcolor>
					<label>$LOCALIZE[31980]</label>
				</control>
			</control>
			<control type="button" id="9625">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31981]</label>
				<label2>$VAR[CustomMenu_Value1]</label2>
				<include content="CustomMenu_SettingsClick"><param name="item" value="1"/><param name="heading" value="$LOCALIZE[31981]"/></include>
			</control>
			<control type="button" id="9626">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31982]</label>
				<label2>$VAR[CustomMenu_Value2]</label2>
				<include content="CustomMenu_SettingsClick"><param name="item" value="2"/><param name="heading" value="$LOCALIZE[31982]"/></include>
			</control>
			<control type="button" id="9627">
				<include>SkinSet_Row</include>
				<label>$LOCALIZE[31983]</label>
				<label2>$VAR[CustomMenu_Value3]</label2>
				<include content="CustomMenu_SettingsClick"><param name="item" value="3"/><param name="heading" value="$LOCALIZE[31983]"/></include>
			</control>
		</control>
		<include>CustomRows_FavData</include>
		<!-- what the focused row does -->
		<control type="textbox">
			<left>1360</left>
			<top>276</top>
			<width>400</width>
			<height>502</height>
			<font>sans_24</font>
			<textcolor>grey</textcolor>
			<label>$VAR[SkinSet_Help]</label>
		</control>
		<control type="label">
			<left>160</left>
			<top>1000</top>
			<width>1600</width>
			<height>24</height>
			<aligny>top</aligny>
			<font>caps_20</font>
			<textcolor>grey_soft</textcolor>
			<label>$LOCALIZE[31287][COLOR sep]  ·  [/COLOR]$LOCALIZE[31288][COLOR sep]  ·  [/COLOR]$LOCALIZE[31289]</label>
		</control>
	</controls>
</window>
