<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings pieces, Void: Kodi's setting templates (SettingsCategory, DialogSettings, DialogAddonSettings,
	OSD playback settings), the OSD settings side area with Audio / Subtitles / Picture tabs, and the
	skin settings rows. Rows are text only: grey at rest, white and 3% larger with focus.
-->
<includes>
	<!-- ============================================================ Kodi setting rows -->
	<include name="Void_SettingRow">
		<param name="width">1000</param>
		<param name="height">settings_row_h</param>
		<param name="font">sans_28_med</param>
		<definition>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<font>$PARAM[font]</font>
			<textcolor>grey_dim</textcolor>
			<focusedcolor>text</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<invalidcolor>grey_soft</invalidcolor>
			<selectedcolor>text</selectedcolor>
			<textoffsetx>14</textoffsetx>
			<aligny>center</aligny>
			<pulseonselect>false</pulseonselect>
			<texturefocus />
			<texturenofocus />
			<include content="Void_Anim_FocusText"><param name="zoom" value="103"/></include>
		</definition>
	</include>

	<!-- Templates Kodi clones (ids from Estuary Omega: 7 button, 8 radio, 9 spin, 11 separator,
	     12 edit, 13 slider, 14 group label, 15 colour). params: width, height, font -->
	<include name="Void_SettingTemplates">
		<param name="width">1000</param>
		<param name="height">settings_row_h</param>
		<param name="font">sans_28_med</param>
		<param name="sliderw">240</param>
		<definition>
			<control type="button" id="7">
				<description>Default Button</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="radiobutton" id="8">
				<description>Default RadioButton</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<radiowidth>12</radiowidth>
				<radioheight>12</radioheight>
			</control>
			<control type="spincontrolex" id="9">
				<description>Default SpinControlex</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="image" id="11">
				<description>separator</description>
				<width>$PARAM[width]</width>
				<height>1</height>
				<texture colordiffuse="hairline">common/white.png</texture>
			</control>
			<control type="edit" id="12">
				<description>Default Edit</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="sliderex" id="13">
				<description>Default Slider</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<sliderwidth>$PARAM[sliderw]</sliderwidth>
				<sliderheight>24</sliderheight>
			</control>
			<control type="label" id="14">
				<description>Default Label (group heading)</description>
				<width>$PARAM[width]</width>
				<height>64</height>
				<textoffsetx>14</textoffsetx>
				<font>caps_20</font>
				<textcolor>grey_soft</textcolor>
				<aligny>bottom</aligny>
			</control>
			<control type="colorbutton" id="15">
				<description>Default ColorButton</description>
				<include content="Void_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- Category template (id 10): the current category reads grey (selected), others dim;
