				<include content="Void_DialogButton"><param name="id" value="29"/><param name="width" value="360"/><param name="align" value="left"/></include>
				<include content="Void_DialogButton"><param name="id" value="30"/><param name="width" value="360"/><param name="align" value="left"/></include>
