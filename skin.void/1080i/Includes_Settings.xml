					<include content="Void_DialogButton"><param name="id" value="29"/><param name="width" value="auto"/><param name="height" value="dlg_btn_h"/></include>
					<include content="Void_DialogButton"><param name="id" value="30"/><param name="width" value="auto"/><param name="height" value="dlg_btn_h"/></include>
