				<top>150</top>
				<width>1500</width>
				<height>80</height>
				<aligny>top</aligny>
				<font>serif_64</font>
				<textcolor>text</textcolor>
			</control>
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>146</left>
				<top>270</top>
				<width>1100</width>
				<height>740</height>
				<itemgap>0</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>9000</onleft>
				<onright>9000</onright>
