		</definition>
	</include>

	<!-- Settings level toggle (id 20, Kodi writes Basic / Standard / Advanced / Expert).
	     params: width, onup, ondown, onleft, onright -->
	<include name="Void_SettingLevelButton">
		<param name="width">420</param>
		<param name="onup">3</param>
		<param name="ondown">3</param>
		<param name="onleft">5</param>
		<param name="onright">5</param>
		<definition>
			<control type="button" id="20">
				<width>$PARAM[width]</width>
				<height>48</height>
				<font>caps_20</font>
				<textcolor>grey_soft</textcolor>
				<focusedcolor>text</focusedcolor>
				<textoffsetx>14</textoffsetx>
				<aligny>center</aligny>
				<pulseonselect>false</pulseonselect>
				<texturefocus />
				<texturenofocus />
				<include>Void_Anim_FocusText</include>
				<onclick>SettingsLevelChange</onclick>
				<onup>$PARAM[onup]</onup>
				<ondown>$PARAM[ondown]</ondown>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
			</control>
		</definition>
	</include>

