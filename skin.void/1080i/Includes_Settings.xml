	<!-- One OSD tab: caps word; the current tab is white, others dim; focus = white + 10%.
	     Clicking a non-current tab closes whichever OSD settings dialog is open and opens the target;
	     void.osdtab suppresses the slide so the swap reads as a tab change.
	     params: id, label, current (condition), target, onleft, onright -->
	<include name="Dlg_OSDTab">
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>44</height>
				<label>$PARAM[label]</label>
				<font>caps_20</font>
				<textcolor>$VAR[Dlg_TabColor_$PARAM[id]]</textcolor>
				<focusedcolor>text</focusedcolor>
				<textoffsetx>8</textoffsetx>
				<pulseonselect>false</pulseonselect>
				<texturefocus />
				<texturenofocus />
				<include content="Void_Anim_FocusText"><param name="zoom" value="110"/></include>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
				<onup>noop</onup>
				<ondown>5</ondown>
				<onclick condition="!Window.IsActive($PARAM[target])">SetProperty(void.osdtab,1,home)</onclick>
				<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdaudiosettings,true)</onclick>
				<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdsubtitlesettings,true)</onclick>
				<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdvideosettings,true)</onclick>
				<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdcmssettings,true)</onclick>
				<onclick condition="!Window.IsActive($PARAM[target])">ActivateWindow($PARAM[target])</onclick>
			</control>
		</definition>
	</include>
	<variable name="Dlg_TabColor_9101">
		<value condition="Window.IsActive(osdaudiosettings)">grey</value>
		<value>sep_light</value>
	</variable>
	<variable name="Dlg_TabColor_9102">
		<value condition="Window.IsActive(osdsubtitlesettings)">grey</value>
		<value>sep_light</value>
	</variable>
	<variable name="Dlg_TabColor_9103">
		<value condition="Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)">grey</value>
		<value>sep_light</value>
	</variable>

