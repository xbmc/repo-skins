<?xml version="1.0" encoding="UTF-8"?>
<!--
	Yes/No, OK and progress dialogs (Kodi 21 routes all three through DialogConfirm). Void: on the
	x=160 axis over a 92% black backdrop - serif heading, body text, 1px progress, text buttons.
	Used by "Keep this skin?" - must always work. No <defaultcontrol>: Kodi focuses its own default
	button (yes or no, per caller).
	Id contract (Estuary Omega): heading 1, text 9, progress 20, buttons 11 (yes) / 10 (no) /
	12 (custom) in grouplist 9000, Estuary order 11, 10, 12. Kodi hides the unused ones.
-->
<window>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>Dlg_Backdrop</include>
		<control type="label" id="1">
			<left>152</left>
			<top>330</top>
			<width>1500</width>
			<height>80</height>
			<aligny>top</aligny>
			<font>serif_64</font>
		</control>
		<control type="textbox" id="9">
			<left>160</left>
			<top>440</top>
			<width>1100</width>
			<height>202</height>
			<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
		</control>
		<control type="progress" id="20">
			<left>160</left>
			<top>680</top>
			<width>1100</width>
			<height>1</height>
			<info>System.Progressbar</info>
		</control>
		<control type="grouplist" id="9000">
			<left>146</left>
			<top>720</top>
			<width>1400</width>
			<height>70</height>
			<orientation>horizontal</orientation>
			<itemgap>40</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>9000</onleft>
			<onright>9000</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
			<include content="Void_DialogButton">
				<param name="id" value="11"/>
				<param name="width" value="auto"/>
				<param name="align" value="left"/>
			</include>
			<include content="Void_DialogButton">
				<param name="id" value="10"/>
				<param name="width" value="auto"/>
				<param name="align" value="left"/>
			</include>
			<include content="Void_DialogButton">
				<param name="id" value="12"/>
				<param name="width" value="auto"/>
				<param name="align" value="left"/>
			</include>
		</control>
	</controls>
</window>
