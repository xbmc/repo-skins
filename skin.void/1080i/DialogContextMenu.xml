<?xml version="1.0" encoding="UTF-8"?>
<!--
	Context menu (long-press OK / Menu key), Void: the choices as a column of text on the x=160 axis,
	vertically centred on the screen over a black ramp from the left. Focused choice = white + 10%.
	Id contract (Estuary Omega): Kodi clones button template 1000 into grouplist 996 and resizes
	image 999 (kept, transparent). <origin> stops Kodi centring the window on the focused control;
	the grouplist is full height with <align>center</align>, so it centres itself vertically
	(a vertical grouplist's align works along its orientation: GUIControlGroupList::GetAlignOffset).
-->
<window>
	<defaultcontrol>996</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<!-- Options reach v2 (docs/OPTIONS_REACH_V2_BRIEF.md): Kodi's item menu is left alone. Button 990 is the first
	     child of grouplist 996, so Kodi appends its own buttons after it and keeps focus on its first one (Resume /
	     Play): OK still plays, and Up reaches "View, sort, filter...". It shows only in an item menu of the
	     video / music windows (one of Kodi's buttons reads Add to / Remove from favourites, 14076 / 14077), never
	     in the resume prompt, the select-action chooser or Play using.... Its click closes the menu and opens the
	     Library panel 1160 on a 0 s alarm, after the menu's modal loop has returned (opened from inside the
	     menu it would nest, and a Kodi action picked later would run twice). -->
	<coordinates>
		<origin x="0" y="0"/>
	</coordinates>
	<controls>
		<control type="group">
			<include content="Dlg_Backdrop"><param name="color" value="b3000000"/></include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1300</width>
				<height>1080</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="scrim">common/scrim_left.png</texture>
			</control>
			<!-- second pass of the same ramp (audit 2026-10-30): with one pass the focused item's big serif title behind the
			     menu stayed readable (about 10-20 % grey) right beside the choices; two passes keep the poster on the right
			     untouched (the ramp ends at 1300) -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1300</width>
				<height>1080</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="scrim">common/scrim_left.png</texture>
			</control>
			<control type="image" id="999">
				<description>background (Kodi sizes it; transparent in Void)</description>
				<left>146</left>
				<top>0</top>
				<width>900</width>
				<height>1080</height>
				<texture colordiffuse="00ffffff">common/white.png</texture>
			</control>
			<control type="grouplist" id="996">
				<description>grouplist for context buttons</description>
				<left>146</left>
				<top>40</top>
				<width>1000</width>
				<height>1000</height>
				<orientation>vertical</orientation>
				<align>center</align>
				<itemgap>4</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<!-- Options reach v2: the skin's own row, first; Kodi's buttons (1001...) follow -->
				<control type="button" id="990">
					<width>auto</width>
					<height>60</height>
					<textcolor>grey</textcolor>
					<textoffsetx>14</textoffsetx>
					<include content="Void_Anim_FocusText"><param name="zoom" value="112"/></include>
					<label>$LOCALIZE[31355]</label>
					<onclick>Dialog.Close(contextmenu)</onclick>
					<onclick>AlarmClock(voidopen,ActivateWindow(1160),00:00,silent)</onclick>
					<visible>[Window.IsActive(videos) | Window.IsActive(music)] + [String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14077])]</visible>
				</control>
			</control>
		</control>
		<control type="button" id="1000">
			<description>button template</description>
			<left>0</left>
			<top>0</top>
			<width>auto</width>
			<height>60</height>
			<textcolor>grey</textcolor>
			<textoffsetx>14</textoffsetx>
			<include content="Void_Anim_FocusText"><param name="zoom" value="112"/></include>
		</control>
	</controls>
</window>
