<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...), Void: categories as a text
	column on the axis (x 160), the settings as text rows (x 640), the description on the right.
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2 (Kodi writes it; shown as the page title),
	categories grouplist 3 + template 10, control area 5, description textbox 6, templates 7-15,
	level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include content="Void_TopBar">
			<param name="title" value="$INFO[Control.GetLabel(2)]"/>
			<param name="sub" value="$LOCALIZE[5]"/>
		</include>

		<!-- ====== categories -->
		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>146</left>
			<top>170</top>
			<width>440</width>
			<height>704</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="Void_SettingCategoryTemplate">
			<param name="width" value="420"/>
		</include>
		<control type="group">
			<left>146</left>
			<top>990</top>
			<include content="Void_SettingLevelButton">
				<param name="width" value="420"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list -->
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>626</left>
			<top>170</top>
			<width>820</width>
			<height>864</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="Void_SettingTemplates">
			<param name="width" value="820"/>
			<param name="height" value="66"/>
		</include>
		<include content="Void_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1470"/>
			<param name="top" value="170"/>
			<param name="height" value="864"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>

		<!-- ====== aside: what the focused setting does -->
		<control type="textbox" id="6">
			<description>description (Kodi)</description>
			<left>1520</left>
			<top>186</top>
			<width>260</width>
			<height>780</height>
			<font>sans_22</font>
			<textcolor>grey</textcolor>
			<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
		</control>
		<control type="label" id="2">
			<description>section label (Kodi writes it; shown in the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
