<!--
	Video information, Void: Includes_VideoInfo.xml.
	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo):
	  8 play (from the beginning when 9 exists; browses for tvshow/season/set) | 9 resume (enabled
	  by Kodi only with a resume point) | 11 trailer | 50 cast list (collections: the films; OK on a
	  film re-opens the dialog with it) | 6 refresh | 7 user rating | 10 choose art | 12 choose fanart
	  | 13 director search | 14 versions | 15 extras | 443 go to collection.
	Void ids: 9000 actions (default focus), 9001 plot (OK = full plot), 9010 More, 9100 + 9101 More rows (film; library: collection, art, refresh),
	  9200 full-plot overlay with scrollbar 61.
	Focus map: 9001 plot / 9000 actions / 9100 / 9101 More rows stacked on the left; Right from any of them
	  -> cast 50 on the right; Left / Back from the cast -> actions. Back closes the dialog.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>Void_Background</include>
		<include>VidInfo_Backdrop</include>
		<include>VidInfo_Column</include>
