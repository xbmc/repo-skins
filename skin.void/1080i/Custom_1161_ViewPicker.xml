<?xml version="1.0" encoding="UTF-8"?>
<!--
	Void view picker (custom dialog 1161; docs/requests/library-panel/BRIEF.md). Opened by "View" in
	the options row and the Library panel. One schematic preview per view that is valid for the
	content underneath (same conditions as the views in Includes_Views.xml), its name, and a dot +
	"Current" under the view the library shows now. OK = Container.SetViewMode(id), closes, focus
	back on the view; Back closes with no change. Previews: media/views/ (_src/make_view_previews.py).
	Opens on the current view: SetFocus(100,k,absolute), k = its place among the visible items.
-->
<window type="dialog" id="1161">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<!-- Kodi restores the list's last selection when the dialog reopens (and Control.Move wraps), so
	     select absolutely (0-based): item 0, then the current view's place (Pick_Onload, Includes_ViewsMore.xml) -->
	<onload>SetFocus(100,0,absolute)</onload>
	<include>Pick_Onload</include>
	<controls>
		<control type="image">
			<description>backdrop dim</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="dim_dialog">common/white.png</texture>
		</control>
		<control type="label">
			<left>axis</left>
			<top>360</top>
			<width>1200</width>
			<height>24</height>
			<aligny>top</aligny>
			<font>caps_20</font>
			<textcolor>grey</textcolor>
			<label>View[COLOR sep_light]  ·  [/COLOR]$VAR[LibPanel_Where]</label>
		</control>
		<control type="list" id="100">
			<left>152</left>
			<top>404</top>
			<width>1620</width>
			<height>320</height>
			<orientation>horizontal</orientation>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
			<scrolltime tween="cubic" easing="out">160</scrolltime>
			<itemlayout width="400" height="320">
				<include>Pick_Item</include>
			</itemlayout>
			<focusedlayout width="400" height="320">
				<include content="Pick_Item"><param name="focused" value="true"/></include>
			</focusedlayout>
			<content>
				<include>Pick_Items</include>
			</content>
		</control>
		<control type="label">
			<left>axis</left>
			<top>760</top>
			<width>1600</width>
			<height>24</height>
			<aligny>top</aligny>
			<font>caps_20</font>
			<textcolor>grey_soft</textcolor>
			<label>$LOCALIZE[31220][COLOR sep_light]  ·  [/COLOR]$LOCALIZE[31221]</label>
		</control>
	</controls>
</window>
