				<height>70</height>
				<aligny>top</aligny>
				<font>serif_56</font>
				<textcolor>text</textcolor>
				<label>$VAR[Dlg_PlayTitle]</label>
			</control>
		</control>
		<control type="group">
			<left>dlg_panel_x</left>
			<include content="Anim_SidePanel"><param name="offset" value="60"/></include>
			<control type="label">
				<description>kicker</description>
				<left>dlg_panel_pad</left>
				<top>dlg_panel_top</top>
				<width>dlg_panel_in_w</width>
				<height>24</height>
				<aligny>top</aligny>
				<font>caps_20</font>
				<textcolor>grey</textcolor>
				<label>$VAR[Dlg_SelectKicker]</label>
			</control>
			<control type="label" id="1">
				<description>heading (Kodi)</description>
				<left>66</left>
				<top>98</top>
				<width>dlg_panel_in_w</width>
				<height>64</height>
				<aligny>top</aligny>
				<font>serif_52</font>
				<textcolor>text</textcolor>
			</control>
			<control type="list" id="3">
				<left>56</left>
				<top>190</top>
				<width>dlg_panel_in_w</width>
				<height>720</height>
				<onup>9100</onup>
				<ondown>9100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<pagecontrol>61</pagecontrol>
				<scrolltime tween="cubic" easing="out">180</scrolltime>
				<include content="Dlg_TrackListLayout"><param name="list_id" value="3"/></include>
			</control>
			<control type="list" id="6">
				<left>56</left>
				<top>190</top>
				<width>dlg_panel_in_w</width>
				<height>720</height>
				<onup>9100</onup>
				<ondown>9100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<pagecontrol>61</pagecontrol>
				<scrolltime tween="cubic" easing="out">180</scrolltime>
				<include content="Dlg_TrackListLayout"><param name="list_id" value="6"/></include>
			</control>
			<control type="label">
				<left>dlg_panel_pad</left>
				<top>190</top>
				<width>dlg_panel_in_w</width>
				<height>dlg_track_row_h</height>
				<font>sans_26</font>
				<textcolor>grey</textcolor>
				<label>$LOCALIZE[31246]</label>
				<visible>[Control.IsVisible(3) + Integer.IsEqual(Container(3).NumItems,0)] | [Control.IsVisible(6) + Integer.IsEqual(Container(6).NumItems,0)]</visible>
			</control>
			<control type="scrollbar" id="61">
				<left>650</left>
				<top>190</top>
				<width>1</width>
				<height>720</height>
