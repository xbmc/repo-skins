<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music pieces, Void (prefix Music_). Libraries use the shared views (Includes_Views.xml); Now playing
	and the music OSD live in their window files. This holds the info-page and queue labels.
-->
<includes>
	<expression name="Music_InfoIsAlbum">String.IsEqual(ListItem.DBType,album)</expression>
	<expression name="Music_InfoIsArtist">String.IsEqual(ListItem.DBType,artist)</expression>
	<expression name="Music_InfoIsSong">String.IsEqual(ListItem.DBType,song)</expression>
	<expression name="Music_InfoHasArt">!String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(artist.fanart))</expression>

	<variable name="Music_InfoKicker">
		<value condition="$EXP[Music_InfoIsArtist]">Artist$INFO[ListItem.Genre,[COLOR sep]  ·  [/COLOR],]</value>
		<value condition="$EXP[Music_InfoIsSong]">Song$INFO[ListItem.TrackNumber,[COLOR sep]  ·  [/COLOR]track ,]$INFO[ListItem.Year,[COLOR sep]  ·  [/COLOR],]</value>
		<value>Album$INFO[ListItem.Year,[COLOR sep]  ·  [/COLOR],]$INFO[ListItem.Property(Album_Label),[COLOR sep]  ·  [/COLOR],]</value>
	</variable>
	<variable name="Music_InfoTitle">
		<value condition="$EXP[Music_InfoIsArtist] + !String.IsEmpty(ListItem.Artist)">$INFO[ListItem.Artist]</value>
		<value condition="$EXP[Music_InfoIsSong] + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value condition="$EXP[Music_InfoIsAlbum] + !String.IsEmpty(ListItem.Album)">$INFO[ListItem.Album]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="Music_InfoSubline">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Type)]$INFO[ListItem.Property(Artist_Style),[COLOR sep_light]  ·  [/COLOR],]</value>
		<value condition="$EXP[Music_InfoIsSong]">[COLOR value]$INFO[ListItem.Artist][/COLOR]$INFO[ListItem.Album,[COLOR sep_light]  ·  [/COLOR],]$INFO[ListItem.Duration,[COLOR sep_light]  ·  [/COLOR],]</value>
		<value>[COLOR value]$INFO[ListItem.Artist][/COLOR]$INFO[ListItem.Genre,[COLOR sep_light]  ·  [/COLOR],]$INFO[ListItem.Property(Album_Label),[COLOR sep_light]  ·  [/COLOR],]</value>
	</variable>
	<variable name="Music_InfoDescription">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Description)]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Comment]</value>
		<value>$INFO[ListItem.Property(Album_Description)]</value>
	</variable>
	<variable name="Music_InfoShuffleAction">
		<value condition="$EXP[Music_InfoIsArtist]">PlayMedia(musicdb://artists/$INFO[ListItem.DBID]/,isdir)</value>
		<value>PlayMedia(musicdb://albums/$INFO[ListItem.DBID]/,isdir)</value>
	</variable>
	<variable name="Music_InfoListCaption">
		<value condition="$EXP[Music_InfoIsArtist]">Discography$INFO[Container(50).NumItems,[COLOR sep_light]  ·  [/COLOR],]</value>
		<value>Tracks$INFO[Container(50).NumItems,[COLOR sep_light]  ·  [/COLOR],]</value>
	</variable>
	<variable name="Music_InfoArt">
		<value condition="!String.IsEmpty(ListItem.Art(artist.fanart))">$INFO[ListItem.Art(artist.fanart)]</value>
		<value>$INFO[ListItem.Art(fanart)]</value>
	</variable>
	<variable name="Music_QueueTitle">
		<value condition="Window.IsActive(videoplaylist)">Video queue</value>
		<value>Queue</value>
	</variable>
	<variable name="Music_QueueShuffleLabel">
		<value condition="Playlist.IsRandom">Shuffle  on</value>
		<value>Shuffle  off</value>
	</variable>
</includes>
