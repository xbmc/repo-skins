<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info (Info during playback), Void: the OSD composition grown upwards - meta line and a
	3-line plot above the title, the "next" item as a quiet caps line, the same timeline and numbers.
	Opened by Kodi's Info action in fullscreen video and the OSD "Info" button; Info again or Back
	closes it (GUIDialogFullScreenInfo.cpp).
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button
	(default): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_Toast</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include content="OSD_Scrim"><param name="height" value="760"/></include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1200</width>
				<height>1080</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="b3000000">common/scrim_left.png</texture>
			</control>
			<!-- plot + meta grow upwards from the title -->
			<control type="grouplist">
				<left>0</left>
				<top>380</top>
				<width>1200</width>
				<height>404</height>
				<orientation>vertical</orientation>
				<align>right</align>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="textbox">
					<left>160</left>
					<width>880</width>
					<height max="160">auto</height>
					<textcolor>text_72</textcolor>
					<label>$INFO[VideoPlayer.Plot]</label>
				</control>
				<control type="group">
					<width>1200</width>
					<height>52</height>
					<control type="label">
						<left>160</left>
						<top>18</top>
						<width>1000</width>
						<height>32</height>
						<aligny>top</aligny>
						<textcolor>grey</textcolor>
						<label>$VAR[OSD_FSMeta]</label>
					</control>
				</control>
			</control>
			<include>OSD_TitleBlock</include>
			<include>OSD_Timeline</include>
			<include>OSD_Numbers</include>
			<control type="label">
				<left>160</left>
				<top>1004</top>
				<width>1600</width>
				<height>26</height>
				<aligny>top</aligny>
				<font>caps_20</font>
				<textcolor>grey_soft</textcolor>
				<label>Next[COLOR sep]  ·  [/COLOR]$VAR[OSD_NextLabel]</label>
				<visible>$EXP[OSD_HasNext]</visible>
			</control>
		</control>
	</controls>
</window>
