{
    "infolabels": {
        "path": "Skin.String(CustomRow.{row}.Path)"
    },
    "operations": [
        {
            "regex": {
                "addon": {
                    "regex": "(?s)^plugin://([^/?]+).*$",
                    "value": "\\1",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "isplugin": {
                    "regex": "(?s)^plugin://[^/?]+.*$",
                    "value": "yes",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "isplugin": {
                    "regex": "(?s)^(?!yes$).*$",
                    "value": "no",
                    "input": "{isplugin}"
                }
            }
        },
        {
            "regex": {
                "addon": {
                    "regex": "(?s)^.*://.*$",
                    "value": "",
                    "input": "{addon}"
                }
            }
        }
    ],
    "actions": [
        {
            "rules": [
                "{isplugin}==yes"
            ],
            "value": [
                "Skin.SetString(CustomRow.{row}.Addon,{addon})"
            ]
        },
        {
            "rules": [
                "{isplugin}==no"
            ],
            "value": [
                "Skin.Reset(CustomRow.{row}.Addon)"
            ]
        }
    ]
}
