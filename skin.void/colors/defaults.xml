<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.void palette (docs/skin.void/DESIGN.md section 2). AARRGGBB, lowercase names.
    True black ground, one warm white, greys. No accent colour: focus is brightness and scale.
    The second block keeps the engine's semantic names (inherited window logic) pointing at Void values.
-->
<colors>
    <!-- Ground and text -->
    <color name="bg">ff000000</color>                <!-- OLED off -->
    <color name="ink">ff000000</color>
    <color name="text">fff2f2f0</color>              <!-- titles, focused text -->
    <color name="text_84">d6f2f2f0</color>           <!-- title in ambient mode -->
    <color name="text_72">b8f2f2f0</color>           <!-- plot over fanart -->
    <color name="value">ffc9c9c6</color>             <!-- rating, highlighted numbers -->
    <color name="grey">ff8a8a88</color>              <!-- secondary: meta, labels (5.9:1 on black) -->
    <color name="grey_dim">ff6e6e6c</color>          <!-- unfocused option text (4.1:1, 26px+) -->
    <color name="grey_soft">ff5e5e5c</color>         <!-- "of 1,360" -->
    <color name="letter_off">ff4e4e4c</color>        <!-- scrubber letters -->
    <color name="sep">ff3a3a38</color>               <!-- middots, inactive dots -->
    <color name="sep_light">ff4a4a48</color>
    <color name="hairline">ff262626</color>          <!-- the one hairline -->
    <color name="clock">66f2f2f0</color>             <!-- 40% -->

    <!-- Rotary / rolodex distance alphas (VoidIndex mockup) -->
    <color name="d1">75f2f2f0</color>                <!-- 46% -->
    <color name="d2">5cf2f2f0</color>                <!-- 36% -->
    <color name="d3">4af2f2f0</color>                <!-- 29% -->
    <color name="d4">3df2f2f0</color>                <!-- 24% -->
    <color name="d5">33f2f2f0</color>                <!-- 20% -->
    <color name="d6">2bf2f2f0</color>                <!-- 17% -->
    <color name="d7">26f2f2f0</color>                <!-- 15% -->
    <color name="neighbour">47f2f2f0</color>         <!-- 28%: Home neighbours, unfocused rolodex -->

    <!-- Artwork -->
    <color name="art_70">b3ffffff</color>            <!-- ambient fanart default -->
    <color name="art_50">80ffffff</color>
    <color name="art_90">e6ffffff</color>
    <color name="art_35">ff595959</color>            <!-- unfocused wall posters: opaque multiply (never alpha: text under art would show) -->
    <color name="art_dim">ff595959</color>
    <color name="art_full">ffffffff</color>

    <!-- Scrims (tint black gradient textures) -->
    <color name="scrim">ff000000</color>
    <color name="dim_dialog">f2000000</color>        <!-- 95% behind full-screen dialogs -->
    <color name="dim_video">b3000000</color>         <!-- 70% behind OSD side panels -->

    <!-- ============ engine semantic names (inherited logic) mapped to Void values ============ -->
    <color name="bg_raised">ff0e0e0e</color>
    <color name="bg_ghost">ff141414</color>
    <color name="text_primary">fff2f2f0</color>
    <color name="text_body">ffc9c9c6</color>
    <color name="text_secondary">ff8a8a88</color>
    <color name="text_tertiary">ff6e6e6c</color>
    <color name="hairline_strong">ff333333</color>
    <color name="hairline_soft">ff1a1a1a</color>
    <color name="border_control">ff333333</color>
    <color name="border_button">ff333333</color>
    <color name="hairline_art">26ffffff</color>
    <color name="hairline_art_strong">40ffffff</color>
    <color name="accent">fff2f2f0</color>            <!-- there is no accent: "accent" is the white -->
    <color name="accent_signal">fff2f2f0</color>
    <color name="scrim_tab">d9000000</color>
    <color name="scrim_track">cc000000</color>
    <color name="shadow">73000000</color>
    <color name="focus_halo">00000000</color>
    <color name="dim_passed">ff595959</color>
    <color name="dim_ahead">ff595959</color>
    <color name="dim_row">ff595959</color>
    <color name="art_faint">4dffffff</color>
    <color name="art_soft">73ffffff</color>
    <color name="art_visible">a6ffffff</color>

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
    <color name="disabled">ff3a3a38</color>
</colors>
