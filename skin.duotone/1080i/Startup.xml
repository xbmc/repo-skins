<?xml version="1.0" encoding="UTF-8"?>
<!--
	Startup: a vermilion field + the wordmark for the instant before Home. No splash timer.
	Goes to Kodi's configured startup window (default Home), like Estuary, so Omar's
	"Settings > Interface > Startup window" keeps working.
-->
<window>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<texture colordiffuse="$VAR[sec_films]">common/white.png</texture>
		</control>
		<include>DT_FieldDots</include>
		<control type="label">
			<left>58</left>
			<top>434</top>
			<width>1800</width>
			<height>212</height>
			<font>an_236</font>
			<textcolor>$VAR[ink]</textcolor>
			<label>$LOCALIZE[31024]</label>
		</control>
	</controls>
</window>
