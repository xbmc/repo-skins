<?xml version="1.0" encoding="UTF-8"?>
<!--
	Smart playlist rule (SPEC 5: Minimal, DT_GenericDialog). Builder F, M4.
	Kodi id contract (Estuary Omega SmartPlaylistRule.xml / GUIDialogSmartPlaylistRule): heading 2,
	15 field, 16 operator (Kodi writes their labels), value edit 17 + browse 20 in grouplist 9002
	(inside grouplist 9001), buttons 18 OK / 19 cancel in grouplist 9000.
-->
<window>
	<defaultcontrol always="true">9001</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1040</width>
			<height>480</height>
			<include content="DT_GenericDialog">
				<param name="width" value="1040"/>
				<param name="height" value="480"/>
				<param name="header_id" value="2"/>
				<param name="header_label" value="$LOCALIZE[21421]"/>
			</include>
			<control type="grouplist" id="9001">
				<left>dialog_pad</left>
				<top>dialog_content_top</top>
				<width>960</width>
				<height>200</height>
				<orientation>vertical</orientation>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<control type="button" id="15">
					<description>Rule field</description>
					<include content="Misc_RowLook"><param name="width" value="960"/></include>
				</control>
				<control type="button" id="16">
					<description>Rule operator</description>
					<include content="Misc_RowLook"><param name="width" value="960"/></include>
				</control>
				<control type="grouplist" id="9002">
					<width>960</width>
					<height>dialog_row_h</height>
					<orientation>horizontal</orientation>
					<itemgap>16</itemgap>
					<control type="edit" id="17">
						<description>Value</description>
						<width>680</width>
						<height>dialog_row_h</height>
						<font>bold_26</font>
						<hinttext>$LOCALIZE[31374]</hinttext>
					</control>
					<include content="DT_DialogButton">
						<param name="id" value="20"/>
						<param name="width" value="264"/>
						<param name="label" value="$LOCALIZE[1024]"/>
					</include>
				</control>
			</control>
			<control type="grouplist" id="9000">
				<left>dialog_pad</left>
				<top>384</top>
				<width>960</width>
				<height>dialog_row_h</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>16</itemgap>
				<onup>9002</onup>
				<ondown>15</ondown>
				<include content="DT_DialogButton">
					<param name="id" value="18"/>
					<param name="width" value="260"/>
					<param name="label" value="$LOCALIZE[186]"/>
				</include>
				<include content="DT_DialogButton">
					<param name="id" value="19"/>
					<param name="width" value="260"/>
					<param name="label" value="$LOCALIZE[222]"/>
				</include>
			</control>
		</control>
	</controls>
</window>
