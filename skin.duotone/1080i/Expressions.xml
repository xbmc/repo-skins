<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin setting names: docs/skin.duotone/SETTINGS.md. An empty string / unset bool always means the default.
	Reminder (LESSONS 2): $EXP is not expanded in <autoscroll> or window-level <visible>.
-->
<includes>
	<!-- ===================================================== section system (Variables.xml) -->
	<!-- Home: the position of list 300 (1 films, 2 series, 3 music, 4 search). Container(300).ListItem.* would
	     resolve to the drawn item inside other lists' layouts (seen on device), CurrentItem does not. Dialogs over
	     Home can't see list 300, so they read the copy Home keeps in Window(Home).Property(duotone.section). -->
	<expression name="DT_HomeSeries">Window.IsActive(home) + [!Skin.HasSetting(HideMenu.TVShows) + [[!Skin.HasSetting(HideMenu.Movies) + Integer.IsEqual(Container(300).CurrentItem,2)] | [Skin.HasSetting(HideMenu.Movies) + Integer.IsEqual(Container(300).CurrentItem,1)]] | [String.IsEmpty(Container(300).CurrentItem) + String.IsEqual(Window(Home).Property(duotone.section),series)]]</expression>
	<expression name="DT_HomeMusic">Window.IsActive(home) + [!Skin.HasSetting(HideMenu.Music) + [[!Skin.HasSetting(HideMenu.Movies) + !Skin.HasSetting(HideMenu.TVShows) + Integer.IsEqual(Container(300).CurrentItem,3)] | [!Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Integer.IsEqual(Container(300).CurrentItem,2)] | [Skin.HasSetting(HideMenu.Movies) + !Skin.HasSetting(HideMenu.TVShows) + Integer.IsEqual(Container(300).CurrentItem,2)] | [Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Integer.IsEqual(Container(300).CurrentItem,1)]] | [String.IsEmpty(Container(300).CurrentItem) + String.IsEqual(Window(Home).Property(duotone.section),music)]]</expression>
	<!-- BEGIN menu positions: GENERATED by _src/make_menu_stack.py (edit the generator) -->
	<expression name="DT_HomeSearch">Window.IsActive(home) + [[$EXP[DT_MenuShown0] + $EXP[CustomMenuCount0] + Integer.IsEqual(Container(300).CurrentItem,1)] | [$EXP[DT_MenuShown0] + $EXP[CustomMenuCount1] + Integer.IsEqual(Container(300).CurrentItem,2)] | [$EXP[DT_MenuShown0] + $EXP[CustomMenuCount2] + Integer.IsEqual(Container(300).CurrentItem,3)] | [$EXP[DT_MenuShown0] + $EXP[CustomMenuCount3] + Integer.IsEqual(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount0] + Integer.IsEqual(Container(300).CurrentItem,2)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount1] + Integer.IsEqual(Container(300).CurrentItem,3)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount2] + Integer.IsEqual(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount3] + Integer.IsEqual(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount0] + Integer.IsEqual(Container(300).CurrentItem,3)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount1] + Integer.IsEqual(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount2] + Integer.IsEqual(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount3] + Integer.IsEqual(Container(300).CurrentItem,6)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount0] + Integer.IsEqual(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount1] + Integer.IsEqual(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount2] + Integer.IsEqual(Container(300).CurrentItem,6)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount3] + Integer.IsEqual(Container(300).CurrentItem,7)] | [String.IsEmpty(Container(300).CurrentItem) + String.IsEqual(Window(Home).Property(duotone.section),search)]]</expression>
	<expression name="DT_HomeCustom">Window.IsActive(home) + [[$EXP[DT_MenuShown0] + $EXP[CustomMenuCount1] + Integer.IsGreater(Container(300).CurrentItem,0) + Integer.IsLess(Container(300).CurrentItem,2)] | [$EXP[DT_MenuShown0] + $EXP[CustomMenuCount2] + Integer.IsGreater(Container(300).CurrentItem,0) + Integer.IsLess(Container(300).CurrentItem,3)] | [$EXP[DT_MenuShown0] + $EXP[CustomMenuCount3] + Integer.IsGreater(Container(300).CurrentItem,0) + Integer.IsLess(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount1] + Integer.IsGreater(Container(300).CurrentItem,1) + Integer.IsLess(Container(300).CurrentItem,3)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount2] + Integer.IsGreater(Container(300).CurrentItem,1) + Integer.IsLess(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown1] + $EXP[CustomMenuCount3] + Integer.IsGreater(Container(300).CurrentItem,1) + Integer.IsLess(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount1] + Integer.IsGreater(Container(300).CurrentItem,2) + Integer.IsLess(Container(300).CurrentItem,4)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount2] + Integer.IsGreater(Container(300).CurrentItem,2) + Integer.IsLess(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown2] + $EXP[CustomMenuCount3] + Integer.IsGreater(Container(300).CurrentItem,2) + Integer.IsLess(Container(300).CurrentItem,6)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount1] + Integer.IsGreater(Container(300).CurrentItem,3) + Integer.IsLess(Container(300).CurrentItem,5)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount2] + Integer.IsGreater(Container(300).CurrentItem,3) + Integer.IsLess(Container(300).CurrentItem,6)] | [$EXP[DT_MenuShown3] + $EXP[CustomMenuCount3] + Integer.IsGreater(Container(300).CurrentItem,3) + Integer.IsLess(Container(300).CurrentItem,7)] | [String.IsEmpty(Container(300).CurrentItem) + String.StartsWith(Window(Home).Property(duotone.section),custom)]]</expression>
	<!-- END menu positions -->
	<expression name="DT_TVContent">Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)</expression>
	<expression name="DT_TVItem">String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)</expression>

	<expression name="DT_SecSeries">[Window.IsActive(movieinformation) + $EXP[DT_TVItem]] | [!Window.IsActive(movieinformation) + !Window.IsActive(musicinformation) + [[Window.IsActive(fullscreenvideo) + VideoPlayer.Content(episodes)] | $EXP[DT_HomeSeries] | [Window.IsActive(videos) + !Window.IsActive(fullscreenvideo) + $EXP[DT_TVContent]]]]</expression>
	<expression name="DT_SecMusic">Window.IsActive(musicinformation) | [!Window.IsActive(movieinformation) + !Window.IsActive(fullscreenvideo) + [Window.IsActive(music) | Window.IsActive(visualisation) | Window.IsActive(musicplaylist) | Window.IsActive(musicplaylisteditor) | $EXP[DT_HomeMusic]]]</expression>
	<expression name="DT_SecPaper">!Window.IsActive(movieinformation) + !Window.IsActive(musicinformation) + !Window.IsActive(fullscreenvideo) + !Window.IsActive(visualisation) + [$EXP[DT_HomeSearch] | $EXP[DT_HomeCustom] | [!Window.IsActive(home) + !Window.IsActive(videos) + !Window.IsActive(music) + !Window.IsActive(musicplaylist) + !Window.IsActive(musicplaylisteditor) + !Window.IsActive(videoplaylist)]]</expression>

	<!-- ============================================================ settings -->
	<expression name="ReduceMotion">Skin.HasSetting(duotone.reducemotion)</expression>
	<expression name="DT_MonoOn">!String.IsEqual(Skin.String(duotone.mono),off)</expression>
	<expression name="DT_Halftone">!Skin.HasSetting(duotone.nohalftone)</expression>
	<!-- True black-and-white source for the big focused art (TMDb Helper desaturate service) -->
	<expression name="DT_DesatOn">!Skin.HasSetting(duotone.nodesaturate) + !String.IsEqual(Skin.String(duotone.mono),off) + System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>
	<expression name="ShowTrailerButton">!Skin.HasSetting(duotone.hidetrailer)</expression>
	<expression name="ShowUnwatchedMarkers">String.IsEqual(Skin.String(duotone.watchedmarkers),both) | String.IsEqual(Skin.String(duotone.watchedmarkers),unwatched)</expression>
	<expression name="ShowWatchedMarkers">String.IsEmpty(Skin.String(duotone.watchedmarkers)) | String.IsEqual(Skin.String(duotone.watchedmarkers),both) | String.IsEqual(Skin.String(duotone.watchedmarkers),watched)</expression>
	<expression name="SpotlightRotateOff">String.IsEqual(Skin.String(duotone.spotlightrotate),off)</expression>

	<!-- Majan settings that Duotone does not have (one look): constant so forked code keeps resolving -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>
	<expression name="IsRounded">false</expression>
	<expression name="FocusOutlineOff">false</expression>
	<expression name="FocusOutlineMedium">false</expression>
	<expression name="ArtBackgroundOn">false</expression>
	<expression name="HomeNewestDateAdded">true</expression>
	<expression name="HomeNewestRelease">false</expression>
	<expression name="HomeNewestBoth">false</expression>

	<!-- ============================================================ items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>

	<!-- ============================================================ windows -->
	<expression name="InfoDialogActive">Window.IsVisible(movieinformation) | Window.IsVisible(musicinformation) | Window.IsVisible(addoninformation)</expression>
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>
</includes>
