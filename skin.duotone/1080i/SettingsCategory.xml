<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...) - M4, Builder E.
	Duotone, paper field: categories x64 w380 (Anton 40), 8px rules, list x500 w920 (2px row rules,
	solid ink focus bar, paper text), description aside x1488 w368.
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2 (Kodi writes it; shown as the page title),
	categories grouplist 3 + template 10, control area 5, description textbox 6, templates 7-15,
	level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DT_Background</include>
		<include content="DT_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$INFO[Control.GetLabel(2)]"/>
			<param name="sub" value="$LOCALIZE[5]"/>
		</include>

		<!-- ====== categories -->
		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>page_margin</left>
			<top>176</top>
			<width>settings_cat_w</width>
			<height>648</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="DT_SettingCategoryTemplate">
			<param name="width" value="settings_cat_w"/>
		</include>
		<control type="group">
			<left>page_margin</left>
			<top>880</top>
			<include content="DT_SettingLevelButton">
				<param name="width" value="settings_cat_w"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list -->
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>500</left>
			<top>176</top>
			<width>920</width>
			<height>792</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="DT_SettingTemplates">
			<param name="width" value="920"/>
		</include>
		<include content="DT_RuleV"><param name="left" value="468"/><param name="top" value="176"/><param name="height" value="840"/></include>
		<include content="DT_RuleV"><param name="left" value="1456"/><param name="top" value="176"/><param name="height" value="840"/></include>
		<include content="DT_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1432"/>
			<param name="top" value="176"/>
			<param name="height" value="792"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>

		<!-- ====== aside: what the focused setting does -->
		<control type="group">
			<left>1488</left>
			<top>176</top>
			<width>368</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>368</width>
				<height>24</height>
				<font>cap_20</font>
				<label>$LOCALIZE[31306]</label>
			</control>
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>0</left>
				<top>44</top>
				<width>368</width>
				<height>748</height>  <!-- 22 lines of 34 -->
				<font>body_24</font>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>

		<control type="label" id="2">
			<description>section label (Kodi writes it; shown in the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
