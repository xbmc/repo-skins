<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	$VAR works in colordiffuse="" and <textcolor>/<focusedcolor> (verified: Majan on device, Arctic Fuse),
	NOT in diffuse="" or border="".

	THE SECTION SYSTEM (the heart of Duotone, DESIGN.md section 2)
	One section is "current" at any moment: films / series / music / paper. It is decided by the
	$EXP[DT_SecSeries] / $EXP[DT_SecMusic] / $EXP[DT_SecPaper] expressions (Expressions.xml; films is
	whatever is left). Every field, tint, rule and text colour reads one of the section variables, so a
	section change recolours the whole screen in the same frame:
	  SectionColor   the field (Colour look: vermilion / cobalt / acid / paper)
	  SectionText    text and icons ON the field (ink; paper on cobalt, the one dark field)
	  SectionText2   secondary text on the field (80%)
	  SectionText3   captions / disabled (55%)
	  SectionFaint   ghosted display type (the unfocused section names, 26-30%)
	  SectionTint    colordiffuse that turns artwork into the section's one-colour print
	  SectionPrint   tint for TMDb Helper's black-and-white source
	They are generated with the Look setting (Colour / Light / Dark) into Includes_Theme.xml by
	_src/make_theme.py; every other colour is a look token $VAR[ink], $VAR[paper_70] ... (colors/defaults.xml).
	Ink blocks carry paper text and section-colour captions ($VAR[SectionColor] reads well on ink).
-->
<includes>
	<!-- The section colour variables (SectionColor, SectionText/2/3, SectionFaint, SectionTint, SectionPrint)
	     live in Includes_Theme.xml, generated by _src/make_theme.py: they follow the Look setting too. -->

	<!-- ==================================================================== textures -->
	<!-- 8px ink frame, 48x48, border 16 (8 ring + 8 transparent buffer). Placed at item rect -8px. -->
	<variable name="FocusFrameAlways">
		<value>focus/frame_8.png</value>
	</variable>
	<!-- Block fill / 8px bordered block (48x48, border 16) -->
	<variable name="ButtonOutline">
		<value>common/rect_outline_8.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

</includes>
