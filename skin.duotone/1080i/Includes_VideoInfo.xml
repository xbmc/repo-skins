<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogVideoInfo pieces (DuotoneInfo.dc.html): fanart print left, poster-design right column with
	giant numerals and thick action blocks, cast as a second page below.
	Shared facts / labels come from Includes_Views_Video.xml (VidView_Fact*, VidView_Status,
	VidView_MPAA, VidView_Runtime, VidView_EpCode, VidView_ArtImage...).
	Prefix: VidInfo_.
-->
<includes>
	<!-- ================================================================== variables -->
	<!-- mono accent line above the title -->
	<variable name="VidInfo_Title">
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<!-- poster column art: episodes use the season / show poster -->
	<variable name="VidInfo_Poster">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(season.poster))">$INFO[ListItem.Art(season.poster)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_CaptionRight">
		<value condition="$EXP[VidView_IsTVType] + Integer.IsGreater(ListItem.Property(TotalEpisodes),0)">$INFO[ListItem.Property(WatchedEpisodes)] OF $INFO[ListItem.Property(TotalEpisodes)] SEEN</value>  <!-- 0.9.3: "SEEN" (was WATCHED) so "RATING / 10 · 152 OF 152 SEEN" fits the 408 column -->
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Property(Watched)] OF $INFO[ListItem.Property(Total)] SEEN</value>
		<value condition="ListItem.IsResumable">RESUME AT $INFO[ListItem.PercentPlayed]%</value>
		<value condition="Integer.IsEqual(ListItem.PlayCount,1)">WATCHED ONCE</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,1)">WATCHED $INFO[ListItem.PlayCount] TIMES</value>
		<value condition="!$EXP[VidView_IsFolderType]">UNWATCHED</value>
	</variable>
	<variable name="VidInfo_CastHeader">
		<value condition="String.IsEqual(ListItem.DBType,set)">Films in this collection</value>
		<value>Cast</value>
	</variable>
	<variable name="VidInfo_CastCount">
		<value condition="String.IsEqual(ListItem.DBType,set)">$VAR[PL_Container_50_NumItems_Film]</value>
		<value>$VAR[PL_Container_50_NumItems_Person]</value>
	</variable>
	<!-- cast row items (inside list 50): actors, or the films of a collection -->
	<variable name="VidInfo_CastArt">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_CastLine2">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Year]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>

	<!-- Media flags (DESIGN 7.8): typographic boxes. Values checked against reference skins:
	     VideoResolution 480/540/576/720/1080/4K/8K, HdrType hdr10/dolbyvision/hlg, codec ids. -->
	<variable name="VidInfo_FlagRes">
		<value condition="String.IsEqual(ListItem.VideoResolution,8K)">8K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,4K) | String.IsEqual(ListItem.VideoResolution,2160)">4K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,1080)">1080P</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,720)">720P</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,576) | String.IsEqual(ListItem.VideoResolution,540) | String.IsEqual(ListItem.VideoResolution,480)">SD</value>
		<value>$INFO[ListItem.VideoResolution]</value>
	</variable>
	<variable name="VidInfo_FlagHDR">
		<value condition="String.IsEqual(ListItem.HdrType,dolbyvision)">DOLBY VISION</value>
		<value condition="String.IsEqual(ListItem.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(ListItem.HdrType,hlg)">HLG</value>
		<value>$INFO[ListItem.HdrType]</value>
	</variable>
	<variable name="VidInfo_AudioCodec">
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd_atmos)">TRUEHD ATMOS</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd)">TRUEHD</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3_ddp_atmos)">DD+ ATMOS</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3)">DD+</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,ac3) | String.IsEqual(ListItem.AudioCodec,dolbydigital)">DD</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma_x) | String.IsEqual(ListItem.AudioCodec,dtshd_ma_x_imax)">DTS:X</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma) | String.IsEqual(ListItem.AudioCodec,dtsma)">DTS-HD MA</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_hra)">DTS-HD HRA</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,dts) | String.IsEqual(ListItem.AudioCodec,dca)">DTS</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,aac) | String.StartsWith(ListItem.AudioCodec,he_aac)">AAC</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,pcm)">PCM</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,mp3)">MP3</value>
		<value>$INFO[ListItem.AudioCodec]</value>
	</variable>
	<variable name="VidInfo_AudioChannels">
		<value condition="Integer.IsEqual(ListItem.AudioChannels,8)"> 7.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,7)"> 6.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,6)"> 5.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,3)"> 2.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,2)"> 2.0</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,1)"> 1.0</value>
		<value condition="!String.IsEmpty(ListItem.AudioChannels)"> $INFO[ListItem.AudioChannels]CH</value>
	</variable>

	<!-- ============================================================ Duotone info page -->
	<!-- DuotoneInfo.dc.html. Left: the fanart as a 760x1080 one-colour print (TMDb Helper's B/W print
	     tinted when ready, else the colour fanart tinted) + halftone, ink section tag top-left, ink
	     tagline block bottom-left. 8px rule x 760. Right column x 824-1856: genres caption, clock, rule,
	     Anton title (2 lines), rule, giant rating numeral, 2x3 stat grid, rule, plot (3 lines) + credits,
	     action blocks at y 944. -->
	<variable name="VidInfo_Fanart">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value>$VAR[VidInfo_Poster]</value>
	</variable>
	<expression name="VidInfo_DesatReady">$EXP[DT_DesatOn] + !String.IsEmpty(ListItem.Art(fanart)) + [String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.DesaturateImage.Original),ListItem.Art(fanart)) | String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.Current.DesaturateImage.Original),ListItem.Art(fanart))]</expression>
	<variable name="VidInfo_SectionTag">
		<value condition="String.IsEqual(ListItem.DBType,episode)">Series  ·  episode</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">Series  ·  season</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Series  ·  info</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Films  ·  collection</value>
		<value>Films  ·  info</value>
	</variable>
	<variable name="VidInfo_TopCaption">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.TVShowTitle]$INFO[ListItem.Season,  ·  Season ,]$INFO[ListItem.Episode,  ·  Episode ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Genre]</value>
	</variable>
	<!-- giant numeral block -->
	<variable name="VidInfo_BigLabel">
		<value condition="String.IsEqual(ListItem.DBType,season)">Season</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Films</value>
		<value condition="$EXP[VidView_HasRating]">Rating</value>
		<value>Year</value>
	</variable>
	<variable name="VidInfo_BigSub">
		<value condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)">  ·  $VAR[VidInfo_CaptionRight]</value>
		<value condition="$EXP[VidView_HasRating]"> / 10  ·  $VAR[VidInfo_CaptionRight]</value>
		<value>  ·  $VAR[VidInfo_CaptionRight]</value>
	</variable>
	<variable name="VidInfo_BigValue">
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Season]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Property(Total)]</value>
		<value condition="$EXP[VidView_HasRating]">$INFO[ListItem.Rating]</value>
		<value condition="!String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value>—</value>
	</variable>
	<!-- 2x3 stat grid: label / value per DBType; "—" when unknown -->
	<variable name="VidInfo_S1L">
		<value condition="String.IsEqual(ListItem.DBType,episode)">Aired</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">Episodes</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Watched</value>
		<value>Year</value>
	</variable>
	<variable name="VidInfo_S1V">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(TotalEpisodes))">$INFO[ListItem.Property(TotalEpisodes)]</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Watched))">$INFO[ListItem.Property(Watched)]</value>
		<value condition="!String.IsEqual(ListItem.DBType,episode) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value>—</value>
	</variable>
	<variable name="VidInfo_S2L">
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Seasons</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">Watched</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">To watch</value>
		<value>Minutes</value>
	</variable>
	<variable name="VidInfo_S2V">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Property(TotalSeasons))">$INFO[ListItem.Property(TotalSeasons)]</value>
		<value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(WatchedEpisodes))">$INFO[ListItem.Property(WatchedEpisodes)]</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(UnWatched))">$INFO[ListItem.Property(UnWatched)]</value>
		<value condition="!String.IsEqual(ListItem.DBType,tvshow) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Duration)">$INFO[ListItem.Duration(mins)]</value>
		<value>—</value>
	</variable>
	<variable name="VidInfo_S3L">
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Episodes</value>
		<value condition="String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)">Year</value>
		<value>Ends</value>
	</variable>
	<variable name="VidInfo_S3V">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Property(TotalEpisodes))">$INFO[ListItem.Property(TotalEpisodes)]</value>
		<value condition="[String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)] + !String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value condition="ListItem.IsResumable + !String.IsEmpty(ListItem.EndTimeResume)">$INFO[ListItem.EndTimeResume]</value>
		<value condition="!$EXP[VidView_IsFolderType] + !String.IsEmpty(ListItem.EndTime)">$INFO[ListItem.EndTime]</value>
		<value>—</value>
	</variable>
	<variable name="VidInfo_S4V">
		<value condition="!String.IsEmpty(ListItem.MPAA)">$VAR[VidView_MPAA]</value>
		<value>—</value>
	</variable>
	<variable name="VidInfo_S5L">
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Status</value>
		<value>Video</value>
	</variable>
	<variable name="VidInfo_S5V">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Status)">$INFO[ListItem.Status]</value>
		<value condition="!String.IsEmpty(ListItem.HdrType)">$VAR[VidInfo_FlagRes] $VAR[VidInfo_FlagHDR]</value>
		<value condition="!String.IsEmpty(ListItem.VideoResolution)">$VAR[VidInfo_FlagRes]</value>
		<value>—</value>
	</variable>
	<!-- 0.9.4 (Omar): series show the next episode's air date instead of Studio (it repeated Network).
	     Source: TMDb Helper (optional) tvshow details, read through the hidden list 7160 below; property
	     names from its source (itemmeta basemedia.get_infoproperties_next_ep + mappings.get_custom_date:
	     next_aired.short = "%d %b"). Nothing scheduled -> "Last ep" + last_aired.short (0.9.5);
	     neither / no TMDb Helper -> "Premiered" + the premiere year. -->
	<expression name="VidInfo_HasTMDb">System.HasAddon(plugin.video.themoviedb.helper) + System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>
	<!-- list 7160 keeps the previous show's item when the path goes empty: only trust it for this show (0.9.5) -->
	<expression name="VidInfo_TMDbItemOk">!String.IsEmpty(ListItem.UniqueID(tmdb)) + String.IsEqual(Container(7160).ListItem(0).Property(tmdb_id),ListItem.UniqueID(tmdb))</expression>
	<expression name="VidInfo_HasNextAired">String.IsEqual(ListItem.DBType,tvshow) + $EXP[VidInfo_HasTMDb] + $EXP[VidInfo_TMDbItemOk] + !String.IsEmpty(Container(7160).ListItem(0).Property(next_aired.short))</expression>
	<expression name="VidInfo_HasLastAired">String.IsEqual(ListItem.DBType,tvshow) + $EXP[VidInfo_HasTMDb] + $EXP[VidInfo_TMDbItemOk] + !String.IsEmpty(Container(7160).ListItem(0).Property(last_aired.short))</expression>
	<variable name="VidInfo_TMDbPath">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + $EXP[VidInfo_HasTMDb] + !String.IsEmpty(ListItem.UniqueID(tmdb))">plugin://plugin.video.themoviedb.helper/?info=details&amp;tmdb_type=tv&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]</value>
	</variable>
	<variable name="VidInfo_S6L">
		<value condition="$EXP[VidInfo_HasNextAired]">Next ep</value>
		<value condition="$EXP[VidInfo_HasLastAired]">Last ep</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Premiered</value>
		<value>Audio</value>
	</variable>
	<variable name="VidInfo_S6V">
		<value condition="$EXP[VidInfo_HasNextAired]">$INFO[Container(7160).ListItem(0).Property(next_aired.short)]</value>
		<value condition="$EXP[VidInfo_HasLastAired]">$INFO[Container(7160).ListItem(0).Property(last_aired.short)]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">—</value>
		<value condition="!String.IsEmpty(ListItem.AudioCodec)">$VAR[VidInfo_AudioCodec]$VAR[VidInfo_AudioChannels]</value>
		<value>—</value>
	</variable>
	<variable name="VidInfo_CreditLabel1">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Studio)">Network</value>
		<value>Director</value>
	</variable>
	<variable name="VidInfo_CreditValue1">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Studio)">$INFO[ListItem.Studio]</value>
		<value condition="!String.IsEmpty(ListItem.Director)">$INFO[ListItem.Director]</value>
		<value>—</value>
	</variable>

	<!-- ==================================================================== buttons -->
	<expression name="VidInfo_ShowResume">Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowPlay">!Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowTrailer">$EXP[ShowTrailerButton] + !String.IsEmpty(ListItem.Trailer)</expression>
	<!-- Action block (mockup .btn): 8px ink border, Anton 40; focus = ink fill, paper text, 6% zoom.
	     Direct children of grouplist 9000 (left 8 = room for the zoom inside the clipping rect).
	     params: id, width, label, onclick, onclick2, visible -->
	<include name="VidInfo_Block">
		<param name="width">272</param>
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<left>8</left>
				<top>8</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<label>$PARAM[label]</label>
				<font>an_40</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<focusedcolor>$VAR[paper]</focusedcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<include>DT_Tex_Block</include>
				<include>Anim_FocusZoom</include>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<onup condition="Control.IsVisible(9001)">9001</onup>
				<ondown condition="Integer.IsGreater(Container(50).NumItems,0)">50</ondown>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- "More" row item: caps button, 4px ink box; ink fill + paper on focus. params: id, label, onclick, visible -->
	<include name="VidInfo_MoreButton">
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>48</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<focusedcolor>$VAR[paper]</focusedcolor>
				<textoffsetx>16</textoffsetx>
				<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
				<texturenofocus border="10" colordiffuse="$VAR[SectionText]">common/rect_outline_1.png</texturenofocus>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ================================================================ page sections -->
	<!-- Left print (fixed: does not slide with the page) -->
	<include name="VidInfo_Print">
		<control type="group">
			<left>0</left>
			<top>0</top>
			<width>760</width>
			<height>screen_h</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>screen_h</height>
				<texture colordiffuse="$VAR[ink]">common/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>screen_h</height>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" colordiffuse="$VAR[SectionTint]">$VAR[VidInfo_Fanart]</texture>
			</control>
			<include>DT_PrintGhost</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>screen_h</height>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" colordiffuse="$VAR[SectionPrint]">$INFO[Window(Home).Property(TMDbHelper.ListItem.DesaturateImage)]</texture>
				<visible>$EXP[DT_DesatOn] + !String.IsEmpty(ListItem.Art(fanart)) + String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.DesaturateImage.Original),ListItem.Art(fanart))</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>760</width>
				<height>screen_h</height>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" colordiffuse="$VAR[SectionPrint]">$INFO[Window(Home).Property(TMDbHelper.ListItem.Current.DesaturateImage)]</texture>
				<visible>$EXP[DT_DesatOn] + !String.IsEmpty(ListItem.Art(fanart)) + !String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.DesaturateImage.Original),ListItem.Art(fanart)) + String.IsEqual(Window(Home).Property(TMDbHelper.ListItem.Current.DesaturateImage.Original),ListItem.Art(fanart))</visible>
			</control>
			<include>DT_PrintVeil</include>
			<include>DT_ArtDots</include>
			<!-- section tag -->
			<control type="button">
				<left>page_margin</left>
				<top>64</top>
				<width min="120" max="632">auto</width>
				<height>48</height>
				<font>cap_20</font>
				<textoffsetx>18</textoffsetx>
				<textcolor>$VAR[paper]</textcolor>
				<focusedcolor>$VAR[paper]</focusedcolor>
				<texturenofocus colordiffuse="$VAR[ink]">common/white.png</texturenofocus>
				<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
				<label>$VAR[VidInfo_SectionTag]</label>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>9000</onleft>
				<onright>9000</onright>
			</control>
			<!-- tagline block: ink, 520 wide, bottom 64 -->
			<control type="group">
				<left>page_margin</left>
				<top>764</top>
				<width>520</width>
				<height>252</height>
				<visible>!String.IsEmpty(ListItem.Tagline)</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>520</width>
					<height>252</height>
					<texture colordiffuse="$VAR[ink]">common/white.png</texture>
				</control>
				<control type="label">
					<left>32</left>
					<top>22</top>
					<width>456</width>
					<height>24</height>
					<font>cap_20</font>
					<textcolor>$VAR[SectionColor]</textcolor>
					<label>$LOCALIZE[31340]</label>
				</control>
