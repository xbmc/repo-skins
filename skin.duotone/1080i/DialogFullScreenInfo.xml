<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info - info on demand during playback (Duotone). A slab of the section colour from
	y 480: kicker + ends + clock, the poster in full colour, Anton title, caption meta, plot (4 lines),
	flags + NEXT, times and the 16px bar. Opened by Kodi's Info action in fullscreen video and by the
	OSD "Info" button; Info again or Back closes it (GUIDialogFullScreenInfo.cpp).

	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button
	(default, always): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>

		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include content="OSD_Slab">
				<param name="top" value="480"/>
			</include>
			<include content="OSD_TopLine">
				<param name="top" value="508"/>
			</include>
			<!-- what's playing: the poster in full colour, left -->
			<control type="group">
				<left>page_margin</left>
				<top>592</top>
				<width>232</width>
				<height>348</height>
				<include content="DT_Artwork">
					<param name="art" value="$VAR[OSDInfo_Poster]"/>
					<param name="title" value="$INFO[VideoPlayer.Title]"/>
				</include>
			</control>
			<!-- text column -->
			<control type="group">
				<left>328</left>
				<top>592</top>
				<width>1528</width>
				<height>348</height>
				<include content="Title_FSInfo"><param name="left" value="0"/><param name="top" value="9"/></include>
				<control type="label">
					<left>0</left>
					<top>92</top>
					<width>1528</width>
					<height>24</height>
					<font>cap_20</font>
					<label>$VAR[OSD_Meta]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>136</top>
					<width>1180</width>
					<height>136</height>
					<font>body_24</font>
					<label>$INFO[VideoPlayer.Plot]</label>
					<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>
				</control>
				<include content="OSD_Flags">
					<param name="top" value="312"/>
					<param name="left" value="0"/>
					<param name="width" value="900"/>
					<param name="align" value="left"/>
				</include>
				<!-- next episode / next playlist item: right end of the flags row -->
				<control type="grouplist">
					<left>0</left>
					<top>312</top>
					<width>1528</width>
					<height>36</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<itemgap>16</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<visible>$EXP[OSD_HasNext]</visible>
					<control type="label">
						<top>6</top>
						<width>auto</width>
						<height>24</height>
						<font>cap_20</font>
						<label>$LOCALIZE[31126]</label>
					</control>
					<control type="label">
						<width max="700">auto</width>
						<height>36</height>
						<font>bold_24</font>
						<label>$VAR[OSD_NextLabel]</label>
					</control>
				</control>
			</control>
			<!-- times + thick bar -->
			<control type="label">
				<left>page_margin</left>
				<top>956</top>
				<width>800</width>
				<height>34</height>
				<font>bold_28</font>
				<label>$VAR[OSD_SeekTimeLabel]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>962</top>
				<width>page_width</width>
				<height>24</height>
				<align>right</align>
				<font>cap_20</font>
				<label>$INFO[Player.TimeRemaining,−,]$INFO[Player.Duration,  /  ,]</label>
			</control>
			<include content="OSD_Track">
				<param name="top" value="1000"/>
			</include>
			<control type="label">
				<left>page_margin</left>
				<top>1036</top>
				<width>page_width</width>
				<height>24</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText2]</textcolor>
				<label>◀ ▶ skip  ·  OK controls  ·  Back hides</label>
			</control>
		</control>
	</controls>
</window>
