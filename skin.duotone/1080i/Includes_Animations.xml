<?xml version="1.0" encoding="UTF-8"?>
<!--
	Duotone motion system (DESIGN.md section 6). Graphic, quick and flat: fades/slides/zoom only,
	focus = 6% zoom + 8px frame, section change = 200 ms colour-field wipe (Home).

	Budget (SPEC 9): focus <= 160 ms cubic out, window/dialog open <= 200 ms, close faster than open,
	list scrolltime ~200 ms. Entering = cubic out, leaving = cubic in. No loop animations, no
	Conditional animations inside item layouts, cheap effects only (fade / slide / small zoom).

	Reduce motion: Skin.HasSetting(duotone.reducemotion). Every include carries a pair of animations per
	trigger with mutually exclusive animation-level conditions (effect-level conditions are NOT used:
	Kodi does not honour them). Reduce motion = short fades only, no zoom/slide; focus = instant.

	Timing tokens (ms):  micro 120-160 | small 180-200 | window 200 open / 140 close | bg 350
	Reduced:             fade in 80 | fade out 60 | focus 0 (no animation)
-->
<includes>

	<!-- ===================================================================================== -->
	<!-- WINDOWS                                                                               -->
	<!-- ===================================================================================== -->

	<!-- Full-screen windows (Home, library, settings). Place as a direct child of <window>. -->
	<include name="Anim_WindowOpenClose">
		<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="200" tween="cubic" easing="out"/>
			<effect type="zoom" start="98" end="100" center="auto" time="200" tween="cubic" easing="out"/>
		</animation>
		<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="140" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="60"/>
		</animation>
	</include>

	<!-- Centred modal dialogs: fade + 2% zoom in, fade out. Direct child of <window>. -->
	<include name="Anim_DialogOpenClose">
		<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="180" tween="cubic" easing="out"/>
			<effect type="zoom" start="98" end="100" center="auto" time="180" tween="cubic" easing="out"/>
		</animation>
		<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="60"/>
		</animation>
	</include>

	<!-- Right-hand panels as a WINDOW (context/side menus, info side sheets).
	     Direct child of <window> or on the panel group. Param offset = px travelled (default 80). -->
	<include name="Anim_SidePanel">
		<param name="offset" default="80"/>
		<definition>
			<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
				<effect type="fade" start="0" end="100" time="200" tween="cubic" easing="out"/>
				<effect type="slide" start="$PARAM[offset],0" end="0,0" time="200" tween="cubic" easing="out"/>
			</animation>
			<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
				<effect type="fade" start="0" end="100" time="80"/>
			</animation>
			<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
				<effect type="fade" start="100" end="0" time="140" tween="cubic" easing="in"/>
				<effect type="slide" start="0,0" end="$PARAM[offset],0" time="140" tween="cubic" easing="in"/>
			</animation>
			<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
				<effect type="fade" start="100" end="0" time="60"/>
			</animation>
		</definition>
	</include>

	<!-- Toasts (notification, busy, progress, volume, seek bar): fade only - shown over playback. -->
	<include name="Anim_Toast">
		<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="160" tween="cubic" easing="out"/>
		</animation>
		<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="60"/>
		</animation>
	</include>

	<!-- ===================================================================================== -->
	<!-- OSD / STRIPS                                                                          -->
	<!-- ===================================================================================== -->

	<!-- Video/music OSD as a WINDOW: fade + 40 px rise from the bottom. Direct child of <window>
	     or on the bottom OSD group. -->
	<include name="Anim_OSDSlideUp">
		<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="180" tween="cubic" easing="out"/>
			<effect type="slide" start="0,40" end="0,0" time="180" tween="cubic" easing="out"/>
		</animation>
		<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="140" tween="cubic" easing="in"/>
			<effect type="slide" start="0,0" end="0,40" time="140" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="60"/>
		</animation>
	</include>

	<!-- Top strip (offset/info strip, OSD top bar): drops 24 px from the top + fade.
	     Put on the strip GROUP (not window level). Fires on window open AND when its <visible> flips. -->
	<include name="Anim_TopStrip">
		<animation type="WindowOpen" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="180" tween="cubic" easing="out"/>
			<effect type="slide" start="0,-24" end="0,0" time="180" tween="cubic" easing="out"/>
		</animation>
		<animation type="WindowOpen" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="Visible" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="180" tween="cubic" easing="out"/>
			<effect type="slide" start="0,-24" end="0,0" time="180" tween="cubic" easing="out"/>
		</animation>
		<animation type="Visible" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="Hidden" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in"/>
			<effect type="slide" start="0,0" end="0,-24" time="120" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in"/>
		</animation>
		<animation type="WindowClose" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="100" end="0" time="60"/>
		</animation>
	</include>

	<!-- ===================================================================================== -->
	<!-- CONTENT REGIONS                                                                       -->
	<!-- ===================================================================================== -->

	<!-- Generic Visible/Hidden fade for any group (hubs, spotlight, info panels, labels). -->
	<include name="Anim_FadeVisible">
		<animation type="Visible" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="180" tween="cubic" easing="out"/>
		</animation>
		<animation type="Visible" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="120" tween="cubic" easing="in"/>
		</animation>
	</include>

	<!-- Legacy alias (M1 Home spotlight / views). -->
	<include name="Anim_VisibleFade">
		<include>Anim_FadeVisible</include>
	</include>

	<!-- ===================================================================================== -->
	<!-- FOCUS                                                                                 -->
	<!-- ===================================================================================== -->

	<!-- Focused item zoom 100 -> 105 around its own centre, 150 ms cubic out.
	     Use on the art GROUP inside a list <focusedlayout>, or directly on a button/control.
	     Focus-only + reversible: losing focus reverses from the current value, so fast d-pad
	     scrolling never stacks or snaps. Reduce motion: no zoom (focus frame still shows). -->
	<include name="Anim_FocusZoom">
		<animation type="Focus" reversible="true" condition="!Skin.HasSetting(duotone.reducemotion)">
			<effect type="zoom" start="100" end="106" center="auto" time="140" tween="cubic" easing="out"/>
		</animation>
	</include>

	<!-- Action block / tile zoom 100 -> 106 while control `id` has focus (on the block's GROUP). -->
	<include name="Anim_BlockZoom">
		<param name="id"/>
		<definition>
			<animation type="Conditional" reversible="true" condition="Control.HasFocus($PARAM[id]) + !Skin.HasSetting(duotone.reducemotion)">
				<effect type="zoom" start="100" end="106" center="auto" time="140" tween="cubic" easing="out"/>
			</animation>
		</definition>
	</include>

	<!-- Field wipe (Home section change). On a full-screen field image coloured with the NEW section
	     colour: it slides in over the old colour (held underneath by DT_FieldHold) in 200 ms.
	     Visible animation = fires when this section's field becomes the current one. Direction follows
	     the section list: down the list (next) wipes up from the bottom, up the list wipes down. -->
	<include name="Anim_FieldWipeIn">
		<animation type="Visible" condition="Container(300).OnPrevious + !Skin.HasSetting(duotone.reducemotion)">
			<effect type="slide" start="0,-1080" end="0,0" time="200" tween="cubic" easing="out"/>
		</animation>
		<animation type="Visible" condition="!Container(300).OnPrevious + !Skin.HasSetting(duotone.reducemotion)">
			<effect type="slide" start="0,1080" end="0,0" time="200" tween="cubic" easing="out"/>
		</animation>
		<animation type="Visible" condition="Skin.HasSetting(duotone.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
	</include>
	<!-- The outgoing colour stays put underneath for the length of the wipe, then goes. -->
	<include name="Anim_FieldHold">
		<animation type="Visible">
			<effect type="fade" start="0" end="100" time="0" delay="200"/>
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="100" time="200"/>
		</animation>
	</include>

</includes>
