<?xml version="1.0" encoding="UTF-8"?>
<!--
	Busy indicator (M4, Builder E; SPEC 5: tiny, non-blocking look). Bottom-right mono caption over
	a 2px track with a sliding accent segment - no full-screen dim, so the page stays readable.
	The slide only runs while this dialog is up; with Reduce motion the segment stays still.
	Kodi writes a percentage into label 10 when it knows one (Estuary contract).
	Hidden at startup and while the player caches (the OSD shows buffering itself).
-->
<window>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(startup) + !Player.Caching</visible>
			<right>page_margin</right>
			<bottom>64</bottom>
			<width>240</width>
			<height>48</height>
			<control type="image">
				<left>-16</left>
				<top>-12</top>
				<width>272</width>
				<height>72</height>
				<texture colordiffuse="$VAR[ink]">common/white.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>240</width>
				<height>24</height>
				<align>right</align>
				<font>cap_20</font>
				<textcolor>$VAR[paper]</textcolor>
				<label>$LOCALIZE[31013]$INFO[Control.GetLabel(10),  ·  ,%]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>34</top>
				<width>240</width>
				<height>8</height>
				<texture colordiffuse="$VAR[paper_22]">common/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>34</top>
				<width>60</width>
				<height>8</height>
				<texture colordiffuse="$VAR[SectionColor]">common/white.png</texture>
				<animation effect="slide" start="0,0" end="180,0" time="700" tween="sine" easing="inout" loop="true" reversible="false" condition="!Skin.HasSetting(duotone.reducemotion)">Conditional</animation>
			</control>
			<control type="label" id="10">
				<description>progress % (Kodi)</description>
				<visible>false</visible>
			</control>
		</control>
	</controls>
</window>
