<?xml version="1.0" encoding="UTF-8"?>
<!--
	Common building blocks: the colour field, rules, header furniture, focus frames, monotone artwork,
	watched markers, action blocks. Prefix: DT_. Parameterised includes document their params.
	Grid: 64px margins, 1792 wide, 12 columns of 128 + 32 gutters (DESIGN.md section 4).
-->
<includes>
	<!-- ============================================================ field -->

	<!-- The section colour field + halftone. First control of every full-screen window. -->
	<include name="DT_Background">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<texture colordiffuse="$VAR[SectionColor]">common/white.png</texture>
		</control>
		<include>DT_FieldDots</include>
	</include>
	<!-- Halftone over a field (mockup .dots at 75%). Full screen, unscaled (aspectratio center). -->
	<include name="DT_FieldDots">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<aspectratio>center</aspectratio>
			<texture colordiffuse="$VAR[dots]">overlays/dots.png</texture>
			<visible>$EXP[DT_Halftone] + $EXP[DT_ScreenDots]</visible>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<aspectratio>center</aspectratio>
			<texture colordiffuse="$VAR[dots]">overlays/screen_lines.png</texture>
			<visible>$EXP[DT_Halftone] + $EXP[DT_ScreenLines]</visible>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<aspectratio>center</aspectratio>
			<texture colordiffuse="$VAR[dots]">overlays/screen_coarse.png</texture>
			<visible>$EXP[DT_Halftone] + $EXP[DT_ScreenCoarse]</visible>
		</control>
	</include>
	<!-- Halftone over a print (art). Fill the parent group. params: visible -->
	<include name="DT_ArtDots">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="$VAR[dots_art]">overlays/dots_art.png</texture>
				<visible>$EXP[DT_Halftone] + $EXP[DT_MonoOn] + [$PARAM[visible]] + $EXP[DT_ScreenDots]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="$VAR[dots_art]">overlays/screen_lines_art.png</texture>
				<visible>$EXP[DT_Halftone] + $EXP[DT_MonoOn] + [$PARAM[visible]] + $EXP[DT_ScreenLines]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="$VAR[dots_art]">overlays/screen_coarse_art.png</texture>
				<visible>$EXP[DT_Halftone] + $EXP[DT_MonoOn] + [$PARAM[visible]] + $EXP[DT_ScreenCoarse]</visible>
			</control>
		</definition>
	</include>

	<!-- Print veils (DESIGN 9.4): field colour at an alpha over a print, Light / Dark only (clear in Colour, and
	     with Monotone off). Ghost (layer 3) sits over the colour art, Veil (layer 5) over the black-and-white
	     source. Fill the parent group. params: visible -->
	<include name="DT_PrintGhost">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="$VAR[SectionVeilGhost]">common/white.png</texture>
				<visible>$EXP[DT_PrintVeils] + [$PARAM[visible]]</visible>
			</control>
		</definition>
	</include>
	<include name="DT_PrintVeil">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="$VAR[SectionVeil]">common/white.png</texture>
				<visible>$EXP[DT_PrintVeils] + [$PARAM[visible]]</visible>
			</control>
		</definition>
	</include>

	<!-- ============================================================ rules -->

	<!-- Thin (2px) rule. params: top, left (default page margin), width (default page width), color -->
	<include name="DT_Rule">
		<param name="top">0</param>
		<param name="left">page_margin</param>
		<param name="width">page_width</param>
		<param name="color">$VAR[ink]</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="$PARAM[color]">common/white.png</texture>
			</control>
		</definition>
	</include>
	<!-- Thick 8px structural rule. params: top, left, width, color -->
	<include name="DT_RuleThick">
		<param name="top">0</param>
		<param name="left">page_margin</param>
		<param name="width">page_width</param>
		<param name="color">$VAR[ink]</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>rule_thick</height>
				<texture colordiffuse="$PARAM[color]">common/white.png</texture>
			</control>
		</definition>
	</include>
	<!-- Vertical 8px rule. params: left, top, height, color -->
	<include name="DT_RuleV">
		<param name="color">$VAR[ink]</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>rule_thick</width>
				<height>$PARAM[height]</height>
				<texture colordiffuse="$PARAM[color]">common/white.png</texture>
			</control>
		</definition>
	</include>

	<!-- 8px header rule at y 136 (every page except Home) -->
	<include name="DT_TopRule">
		<include content="DT_RuleThick">
			<param name="top" value="topbar_rule_y"/>
		</include>
	</include>

	<!-- Clock: Anton 60, right edge of the grid, caps centred on y 91 (mockup: top 64) -->
	<include name="DT_Clock">
		<control type="label">
			<right>page_margin</right>
			<top>61</top>
			<width>400</width>
			<height>60</height>
			<align>right</align>
			<aligny>center</aligny>
			<font>an_60</font>
			<textcolor>$VAR[SectionText]</textcolor>
			<label>$VAR[ClockLabel]</label>
		</control>
	</include>

	<!-- Page header caption at y 76: "TITLE · sub" (cap_20, sub at 45%).
	     params: title (label), sub (optional), index (unused, kept for forked callers) -->
	<include name="DT_PageHeader">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<control type="grouplist">
				<left>page_margin</left>
				<top>76</top>
				<width>1300</width>
				<height>24</height>
				<orientation>horizontal</orientation>
				<itemgap>28</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width max="900">auto</width>
					<height>24</height>
					<font>cap_20</font>
					<textcolor>$VAR[SectionText]</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<width max="560">auto</width>
					<height>24</height>
					<font>cap_20</font>
					<textcolor>$VAR[SectionText3]</textcolor>
					<label>$PARAM[sub]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- Full top bar for non-Home windows: caption + clock + 8px rule -->
	<include name="DT_TopBar">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<include content="DT_PageHeader">
				<param name="title" value="$PARAM[title]"/>
				<param name="sub" value="$PARAM[sub]"/>
			</include>
			<include>DT_Clock</include>
			<include>DT_TopRule</include>
		</definition>
	</include>

	<!-- ===================================================== focus frames -->
	<!-- 8px ink frame just outside the item (frame = item rect grown 8px each side).
	     Put inside a group sized to the item. param visible: condition; omit inside focusedlayouts. -->
	<include name="DT_FocusFrame">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="16" colordiffuse="$VAR[ink]">focus/frame_8.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="DT_FocusFrameAlways">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="16" colordiffuse="$VAR[ink]">focus/frame_8.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ========================================================== artwork -->
	<!-- Artwork inside a group of the art size, with an ink "no art" block + title behind it.
	     params: art (infolabel), title (fallback label), tint (colordiffuse: $VAR[SectionTint] for the
	     one-colour print, white for full colour), dots (condition: halftone over the print),
	     mask_round / mask_square (unused: Duotone is square; kept for forked callers), titlefont (the no-art title;
     an_32 in the small tiles of the Sheet / Stage views) -->
	<include name="DT_Artwork">
		<param name="art">$INFO[ListItem.Art(poster)]</param>
		<param name="mask_round"></param>
		<param name="mask_square"></param>
		<param name="title">$INFO[ListItem.Label]</param>
		<param name="tint">white</param>
		<param name="dots">false</param>
		<param name="aspect">scale</param>
		<param name="titlefont">an_40</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="$VAR[ink]">common/white.png</texture>
			</control>
			<control type="textbox">
				<left>16</left>
				<right>16</right>
				<top>16</top>
				<height>120</height>
				<font>$PARAM[titlefont]</font>
				<textcolor>$VAR[SectionColor]</textcolor>
				<label>$PARAM[title]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<fadetime>120</fadetime>
				<texture background="true" colordiffuse="$PARAM[tint]">$PARAM[art]</texture>
			</control>
			<include content="DT_PrintGhost">
				<param name="visible" value="$PARAM[dots]"/>
			</include>
			<include content="DT_PrintVeil">
				<param name="visible" value="$PARAM[dots]"/>
			</include>
			<include content="DT_ArtDots">
				<param name="visible" value="$PARAM[dots]"/>
			</include>
		</definition>
	</include>

	<!-- Watched markers for a movie/episode poster (mockup .wt). Inside the poster group.
	     watched: 44px ink block with a paper check, top right. unwatched: 16px ink square.
	     in progress: 14px ink bar on the bottom edge with a paper fill. -->
	<include name="DT_WatchedMarkers">
		<control type="image">
			<right>0</right>
			<top>0</top>
			<width>marker_s</width>
			<height>marker_s</height>
			<texture colordiffuse="$VAR[ink]">markers/unwatched.png</texture>
			<visible>$EXP[ShowUnwatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemUnwatched]</visible>
		</control>
		<control type="image">
			<right>0</right>
			<top>0</top>
			<width>marker_tab</width>
			<height>marker_tab</height>
			<texture>$VAR[DT_TexWatched]</texture>
			<visible>$EXP[ShowWatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemWatched]</visible>
		</control>
		<control type="progress">
			<left>0</left>
			<right>0</right>
			<bottom>0</bottom>
			<height>progress_h</height>
			<texturebg colordiffuse="$VAR[bar]">common/white.png</texturebg>
			<midtexture colordiffuse="$VAR[bar_fill]">common/white.png</midtexture>
			<info>ListItem.PercentPlayed</info>
			<visible>ListItem.IsResumable</visible>
		</control>
	</include>

	<!-- ========================================================== action blocks -->
	<!-- Thick bordered blocks (mockup .btn): 8px ink border, Anton 40 label; focus = filled ink, paper
	     text, 6% zoom. Primary carries an icon left of the label.
	     params: id, left, top, width, label, onclick, visible, onleft, onright, onup, ondown, onback, icon -->
	<include name="DT_Tex_Block">
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus border="16" colordiffuse="$VAR[ink]">common/rect_outline_8.png</texturenofocus>
	</include>
	<include name="DT_ButtonPrimary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="icon">icons/play.png</param>
		<param name="onup">noop</param>
		<param name="ondown">noop</param>
		<param name="onleft">noop</param>
		<param name="onright">noop</param>
		<param name="onback">noop</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<include content="Anim_BlockZoom">
					<param name="id" value="$PARAM[id]"/>
				</include>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>an_40</font>
					<textcolor>$VAR[SectionText]</textcolor>
					<focusedcolor>$VAR[paper]</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>24</textoffsetx>
					<include>DT_Tex_Block</include>
					<onclick>$PARAM[onclick]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft>$PARAM[onleft]</onleft>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
				<control type="image">
					<left>24</left>
					<top>21</top>
					<width>30</width>
					<height>30</height>
					<texture colordiffuse="$VAR[paper]">$PARAM[icon]</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>24</left>
					<top>21</top>
					<width>30</width>
					<height>30</height>
					<texture colordiffuse="$VAR[SectionText]">$PARAM[icon]</texture>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="DT_ButtonSecondary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="focus_also">false</param>
		<param name="onclick2">noop</param>
		<param name="onup">noop</param>
		<param name="ondown">noop</param>
		<param name="onleft">noop</param>
		<param name="onright">noop</param>
		<param name="onback">noop</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<include content="Anim_BlockZoom">
					<param name="id" value="$PARAM[id]"/>
				</include>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>an_40</font>
					<textcolor>$VAR[SectionText]</textcolor>
					<focusedcolor>$VAR[paper]</focusedcolor>
					<align>center</align>
					<aligny>center</aligny>
					<textoffsetx>0</textoffsetx>
					<include>DT_Tex_Block</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft>$PARAM[onleft]</onleft>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
			</control>
		</definition>
	</include>

	<!-- Engine aliases (forked callers). Primary = solid ink block (paper text, focus by zoom/frame);
	     secondary = 8px bordered block that fills ink on focus (callers use focusedcolor paper). -->
	<include name="DT_Tex_ButtonPrimary">
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus colordiffuse="$VAR[ink]">common/white.png</texturenofocus>
	</include>
	<include name="DT_Tex_ButtonPrimary_Round">
		<include>DT_Tex_ButtonPrimary</include>
	</include>

	<!-- Caps sub-nav button (library header bar, OSD text buttons): ink fill + paper text on focus.
	     params: id, label, onclick, visible -->
	<include name="DT_SubNavButton">
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<param name="width">auto</param>  <!-- pass a fixed width for labels that toggle (no judder in right-aligned bars) -->
		<param name="align">left</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<align>$PARAM[align]</align>
				<height>subnav_h</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText]</textcolor>
				<focusedcolor>$VAR[paper]</focusedcolor>
				<textoffsetx>14</textoffsetx>
				<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
				<texturenofocus />
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Off-screen object (template/hidden controls Kodi needs but the user never sees) -->
	<include name="DT_Hidden">
		<left>offscreen</left>
		<top>offscreen</top>
		<width>1</width>
		<height>1</height>
		<texturefocus />
		<texturenofocus />
	</include>
</includes>
