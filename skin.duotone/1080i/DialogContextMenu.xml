				<control type="image"><left>0</left><top>0</top><width>560</width><height>604</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1009) + !Control.IsVisible(1010) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>668</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1010) + !Control.IsVisible(1011) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>732</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1011) + !Control.IsVisible(1012) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>796</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1012) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>156</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1001) + !Control.IsVisible(1002) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>220</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1002) + !Control.IsVisible(1003) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>284</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1003) + !Control.IsVisible(1004) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>348</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1004) + !Control.IsVisible(1005) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>412</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1005) + !Control.IsVisible(1006) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>476</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1006) + !Control.IsVisible(1007) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>540</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1007) + !Control.IsVisible(1008) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>604</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1008) + !Control.IsVisible(1009) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>668</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1009) + !Control.IsVisible(1010) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>732</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1010) + !Control.IsVisible(1011) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>796</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1011) + !Control.IsVisible(1012) + Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>796</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1012) + Control.IsVisible(990)</visible></control>
				<control type="grouplist" id="996">
					<description>grouplist for context buttons</description>
					<left>16</left>
					<top>16</top>
					<width>528</width>
					<height max="768">auto</height>
					<usecontrolcoords>true</usecontrolcoords>
					<!-- Options reach v2: the skin's own row, first; Kodi's buttons (1001...) follow -->
					<control type="button" id="990">
						<width>528</width>
						<height>dialog_row_h</height>
						<font>bold_26</font>
						<textcolor>$VAR[SectionText]</textcolor>
						<label>$LOCALIZE[31422]</label>
						<onclick>Dialog.Close(contextmenu)</onclick>
						<onclick>AlarmClock(duotoneopen,ActivateWindow(1155),00:00,silent)</onclick>
						<visible>[Window.IsActive(videos) | Window.IsActive(music)] + [String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14077])]</visible>
					</control>
				</control>
			</control>
		</control>
		<control type="button" id="1000">
			<description>button template</description>
			<left>0</left>
			<top>0</top>
			<width>528</width>
			<height>dialog_row_h</height>
			<font>bold_26</font>
			<textcolor>$VAR[SectionText]</textcolor>
		</control>
	</controls>
</window>
