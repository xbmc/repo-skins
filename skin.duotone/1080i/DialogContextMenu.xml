				<control type="image"><left>0</left><top>0</top><width>560</width><height>412</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1006) + !Control.IsVisible(1007) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>476</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1007) + !Control.IsVisible(1008) + !Control.IsVisible(990)</visible></control>
