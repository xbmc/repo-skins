<?xml version="1.0" encoding="UTF-8"?>
<!--
	Context menu (long-press OK / Menu key) - M4, Builder E.
	Id contract (Estuary Omega): Kodi clones button template 1000 into grouplist 996, resizes the
	background image 999 to fit (keeping the gap between the grouplist's bottom and 999's bottom)
	and centres the window. 999's texture carries both the fill and the 8px ink frame
	(media/dialogs/panel_framed.png: white fill x $VAR[SectionColor], ink frame) because Kodi only
	resizes that one image. Rows: 64px, solid ink bar + paper text on focus.
-->
<window>
	<defaultcontrol>996</defaultcontrol>
	<!-- Options reach v2 (docs/OPTIONS_REACH_V2_BRIEF.md): Kodi's item menu is left alone. Button 990 is the first
	     child of grouplist 996, so Kodi appends its own buttons after it and keeps focus on its first one (Resume /
	     Play): OK still plays, and Up reaches "View, sort, filter...". It shows only in an item menu of the
	     video / music windows (one of Kodi's buttons reads Add to / Remove from favourites, 14076 / 14077), never
	     in the resume prompt, the select-action chooser or Play using.... Its click closes the menu and opens the
	     Library panel 1155 on a 0 s alarm, after the menu's modal loop has returned (opened from inside the
	     menu it would nest, and a Kodi action picked later would run twice). -->
	<include>Anim_DialogOpenClose</include>
	<!-- <origin> stops Kodi centring the menu on the focused control (in Duotone's half-width lists that put
	     it off to one side); the panel group below centres itself instead. -->
	<coordinates>
		<origin x="0" y="0"/>
	</coordinates>
	<controls>
		<control type="group">
			<description>the menu</description>
			<control type="image">
				<left>-1920</left>
				<top>-1080</top>
				<width>5760</width>
				<height>3240</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="$VAR[scrim]">common/white.png</texture>
			</control>
			<!-- centred: 560 wide; one row (64 + 16 padding) sits on the screen centre and every extra button
			     Kodi clones (ids 1002...) lifts the panel half a row, up to the 12-row grouplist cap -->
			<control type="group">
				<left>680</left>
				<top>500</top>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(990) + !Control.IsVisible(1012)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1002)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1003)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1004)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1005)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1006)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1007)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1008)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1009)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1010)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1011)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1012)">Conditional</animation>
				<control type="image" id="999">
					<description>background (Kodi sizes it)</description>
					<left>0</left>
					<top>0</top>
					<width>560</width>
					<height>796</height>
					<texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture>
					<visible>false</visible>
				</control>
				<!-- Options reach v2: Kodi sizes 999 for its own buttons only, not for row 990, so 999 stays hidden (Kodi's
				     contract) and the panel is drawn here: 28 + 64 per row, for each count of Kodi rows (1001...) with and
				     without 990, up to the 12-row grouplist cap. Without 990 it is the size Kodi gave 999. -->
				<control type="image"><left>0</left><top>0</top><width>560</width><height>92</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1001) + !Control.IsVisible(1002) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>156</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1002) + !Control.IsVisible(1003) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>220</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1003) + !Control.IsVisible(1004) + !Control.IsVisible(990)</visible></control>
				<control type="image"><left>0</left><top>0</top><width>560</width><height>284</height><texture border="16" colordiffuse="$VAR[DT_PanelTint]">$VAR[DT_PanelTex]</texture><visible>Control.IsVisible(1004) + !Control.IsVisible(1005) + !Control.IsVisible(990)</visible></control>
