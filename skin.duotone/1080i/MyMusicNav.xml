<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library (DuotoneMusic.dc.html), acid field. Views: 504 Albums wall (albums, artists), 508 Stage (albums, songs since 0.9.18,
	artists), 509 Tracks (songs), 50 List; 508 / 509 in Includes_Views_More.xml (_src/make_views_more.py).
	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp): views in <views>,
	menucontrol 9000, 3 sort by, 4 sort order (hidden, clicked by the header tabs).
	Reserved by Kodi in this window and not reused: 2, 5, 8, 12, 15, 16, 17, 19, 20.
	Duotone ids: 9320-9326 header tabs (inside grouplist 9000), 60 list scrollbar, 5041 tracklist.

	Focus map: view <-> Up/Down <-> header tabs (Left/Right inside). Back on a view is Kodi's.
	Back on the tabs returns to the view. Empty folder: caption + hint, Up reaches the tabs.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<!-- an empty folder has nothing focusable in the view: put focus on the header tabs -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>ground_static</backgroundcolor>
	<views>504,508,509,50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DT_Background</include>
		<include>Music_HeaderBar</include>
		<!-- header furniture: the wall has its own clock block and a half-width rule -->
		<control type="group">
			<visible>!Control.IsVisible(504)</visible>
			<include>DT_Clock</include>
			<include>DT_TopRule</include>
		</control>
		<include content="DT_RuleThick">
			<param name="top" value="136"/>
			<param name="width" value="1032"/>
		</include>

		<!-- views -->
		<include>Music_View_504</include>
		<include>Music_View_508</include>
		<include>Music_View_509</include>
		<include>Music_View_50</include>

		<!-- empty folder (the empty view keeps focus; Up reaches the tabs) -->
		<control type="group">
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			<control type="label">
				<left>page_margin</left>
				<top>200</top>
				<width>page_width</width>
				<height>30</height>
				<font>an_48</font>
				<label>$LOCALIZE[31012]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>240</top>
				<width>page_width</width>
				<height>36</height>
				<font>body_24</font>
				<textcolor>$VAR[SectionText2]</textcolor>
				<label>$LOCALIZE[31352]</label>
			</control>
		</control>

		<include>Music_NowPlayingBar</include>
	</controls>
</window>
