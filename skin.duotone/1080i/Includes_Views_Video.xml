<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library views (Builder B, SPEC 6, mockups Movies.dc / MoviesPoster.dc / TV.dc).
	Used by MyVideoNav.xml; the shared label/fact variables are also used by DialogVideoInfo.xml.

	View ids (CONVENTIONS 4): 500 Poster Showcase (movies, sets) | 501 Big Poster (movies, sets) |
	502 Wall (tvshows, seasons) + Next up strip 9310 at the TV root | 503 Episodes list (episodes,
	seasons) | 50 List (Includes_Views.xml, every content type). Each view container carries its own
	Container.Content() <visible> so VIEW only cycles views valid for the folder.

	Header (replaces Estuary's side blade, Kodi CGUIWindowVideoNav ids, Omega source):
	  3 sort-by (click = Kodi sort dialog), 4 sort order, 14 watched toggle All <-> Unwatched
	  (sent with SendClick(14); state read with System.Setting(hidewatched)).
	  Duotone buttons: 9000 grouplist (menucontrol) with 9321 ALL, 9322 UNWATCHED, 9323 IN PROGRESS,
	  9324 SORT, 9325 sort direction, 9326 VIEW.

	Settings read (SETTINGS.md): duotone.watchedmarkers ($EXP[ShowUnwatchedMarkers]/[ShowWatchedMarkers]),
	duotone.roundedcorners (include conditions; toggling runs ReloadSkin), duotone.artbackground
	($EXP[ArtBackgroundOn]), duotone.focusoutline ($VAR[FocusFrame]).
	Prefix: VidView_ (variables, expressions, includes), vidview_ (constants).
-->
<includes>
	<!-- ================================================================== constants -->
	<constant name="vidview_nav_left">600</constant>          <!-- header filter bar: right-aligned box 600..1540 -->
	<constant name="vidview_nav_w">940</constant>
	<constant name="vidview_nav_top">45</constant>  <!-- centre 65 = the header date's centre (DT_Clock) -->
	<constant name="vidview_col_x">680</constant>             <!-- Showcase / info text column -->
	<constant name="vidview_col_w">1144</constant>
	<constant name="vidview_fact_w">228</constant>            <!-- 1144 / 5 -->
	<constant name="vidview_fact_h">96</constant>
	<constant name="vidview_hero_w">520</constant>
	<constant name="vidview_hero_h">780</constant>
	<constant name="vidview_strip_w">100</constant>           <!-- Showcase browse strip -->
	<constant name="vidview_strip_h">150</constant>
	<constant name="vidview_strip_pitch">116</constant>
	<constant name="vidview_big_w">330</constant>             <!-- Big Poster -->
	<constant name="vidview_big_h">495</constant>
	<constant name="vidview_big_pitch">354</constant>
	<constant name="vidview_big_marker">14</constant>
	<constant name="vidview_big_tab">24</constant>
	<constant name="vidview_wall_w">158</constant>            <!-- TV wall, 10 columns -->
	<constant name="vidview_wall_h">237</constant>
	<constant name="vidview_wall_pitch_x">174</constant>
	<constant name="vidview_wall_pitch_y">253</constant>
	<constant name="vidview_wall_top">540</constant>
	<constant name="vidview_next_w">320</constant>            <!-- Next up cards -->
	<constant name="vidview_next_h">180</constant>
	<constant name="vidview_next_pitch">344</constant>
	<constant name="vidview_ep_row_h">174</constant>          <!-- Episodes list -->
	<constant name="vidview_ep_thumb_w">256</constant>
	<constant name="vidview_ep_thumb_h">144</constant>
	<constant name="vidview_ep_text_x">312</constant>

	<!-- ================================================================ expressions -->
	<expression name="VidView_HideWatched">System.Setting(hidewatched)</expression>
	<expression name="VidView_IsInProgressTV">String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</expression>
	<expression name="VidView_IsMoviesRoot">Container.Content(movies) + String.StartsWith(Container.FolderPath,videodb://movies/titles)</expression>
	<expression name="VidView_IsTVRoot">Container.Content(tvshows) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles)</expression>
	<expression name="VidView_IsLibraryVideo">Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)</expression>
	<!-- Next up strip: TV root while the Wall is the active view -->
	<expression name="VidView_ShowNextUp">Container.Content(tvshows) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles) + Control.IsVisible(502)</expression>
	<expression name="VidView_HasNextUp">Container.Content(tvshows) + String.StartsWith(Container.FolderPath,videodb://tvshows/titles) + Control.IsVisible(502) + Integer.IsGreater(Container(9310).NumItems,0)</expression>
	<expression name="VidView_NavActiveAll">!System.Setting(hidewatched) + !String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</expression>
	<expression name="VidView_IsFolderType">String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,set)</expression>
	<expression name="VidView_IsTVType">String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)</expression>
	<expression name="VidView_HasRating">!String.IsEmpty(ListItem.Rating) + !String.IsEqual(ListItem.Rating,0.0) + !String.IsEqual(ListItem.Rating,0)</expression>
	<!-- Facts strip cells (DialogVideoInfo + Showcase): hide a cell when its value is empty -->
	<expression name="VidView_Fact1Visible">[String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Premiered)] | [String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Season)] | [String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Total))] | [!String.IsEqual(ListItem.DBType,episode) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Year)]</expression>
	<expression name="VidView_Fact2Visible">[String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Property(TotalSeasons))] | [String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(TotalEpisodes))] | [String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Watched))] | [!String.IsEqual(ListItem.DBType,tvshow) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Duration)]</expression>
	<expression name="VidView_Fact3Visible">[String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(WatchedEpisodes))] | [!String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + $EXP[VidView_HasRating]]</expression>
	<expression name="VidView_Fact4Visible">[String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Property(TotalEpisodes))] | [!String.IsEqual(ListItem.DBType,tvshow) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.MPAA)]</expression>
	<!-- TV show / season watched state (DATA 4.7) -->
	<expression name="VidView_TVStarted">Integer.IsGreater(ListItem.Property(WatchedEpisodes),0) + Integer.IsGreater(ListItem.Property(UnWatchedEpisodes),0)</expression>
	<expression name="VidView_TVDone">Integer.IsEqual(ListItem.Property(UnWatchedEpisodes),0) + Integer.IsGreater(ListItem.Property(TotalEpisodes),0)</expression>
	<expression name="VidView_SetDone">String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Total)) + String.IsEqual(ListItem.Property(Watched),ListItem.Property(Total))</expression>

	<!-- ================================================================== variables -->

	<!-- Page header -->
	<variable name="VidView_Title">
		<value condition="$EXP[VidView_IsMoviesRoot]">Films</value>
		<value condition="$EXP[VidView_IsTVRoot] | $EXP[VidView_IsInProgressTV]">Series</value>
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- Filter bar counts (DATA 4.4): Container.* follow the current filter; library totals come
	     from the Home window properties Kodi core sets (Movies.Count, TVShows.Count). -->
	<variable name="VidView_CountAll">
		<value condition="$EXP[VidView_IsInProgressTV]">$INFO[Window(Home).Property(TVShows.Count)]</value>
		<value condition="System.Setting(hidewatched) + $EXP[VidView_IsMoviesRoot]">$INFO[Window(Home).Property(Movies.Count)]</value>
		<value condition="System.Setting(hidewatched) + $EXP[VidView_IsTVRoot]">$INFO[Window(Home).Property(TVShows.Count)]</value>
		<value condition="!System.Setting(hidewatched)">$INFO[Container.NumItems]</value>
	</variable>
	<variable name="VidView_CountUnwatched">
		<value condition="System.Setting(hidewatched)">$INFO[Container.NumItems]</value>
		<value>$INFO[Container.TotalUnWatched]</value>
	</variable>
	<variable name="VidView_CountInProgress">
		<value condition="$EXP[VidView_IsInProgressTV]">$INFO[Container.NumItems]</value>
	</variable>
	<variable name="VidView_SortArrow">
		<value condition="Container.SortDirection(descending)">↓</value>
		<value>↑</value>
	</variable>
	<!-- Active filter: primary text (button textures do not expand $VAR, so the word has no underline) -->
	<variable name="VidView_ColNavAll">
		<value condition="$EXP[VidView_NavActiveAll]">$VAR[SectionText]</value>
		<value>$VAR[SectionText2]</value>
	</variable>
	<variable name="VidView_ColNavUnwatched">
		<value condition="System.Setting(hidewatched)">$VAR[SectionText]</value>
		<value>$VAR[SectionText2]</value>
	</variable>
	<variable name="VidView_ColNavInProgress">
		<value condition="$EXP[VidView_IsInProgressTV]">$VAR[SectionText]</value>
		<value>$VAR[SectionText2]</value>
	</variable>

	<!-- "0002" style position (mockups: 0002 / 1360) -->
	<variable name="VidView_PosPad">
		<value condition="Integer.IsLess(Container.CurrentItem,10)">00</value>
		<value condition="Integer.IsLess(Container.CurrentItem,100)">0</value>
	</variable>

	<!-- Kodi stores US certifications as "Rated PG-13" (DATA 4.1): show the bare code -->
	<variable name="VidView_MPAA">
		<value condition="String.IsEqual(ListItem.MPAA,Rated R)">R</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated PG-13)">PG-13</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated PG)">PG</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated G)">G</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated NR)">NR</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated NC-17)">NC-17</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-MA)">TV-MA</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-14)">TV-14</value>
		<value condition="String.IsEqual(ListItem.MPAA,Rated TV-PG)">TV-PG</value>
		<value>$INFO[ListItem.MPAA]</value>
	</variable>

	<!-- Title for any item; the ".." parent item (filelists.showparentdiritems = on) reads "Back" -->
	<variable name="VidView_ItemTitle">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<!-- ================================================================== art pieces -->

	<!-- ".." parent item tile: hairline box + back chevron (+ optional mono caption).
	     Inside the art group. params: icon (px), caption_visible -->
	<include name="VidView_ParentTile">
		<param name="icon">40</param>
		<param name="caption_visible">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="10" colordiffuse="$VAR[ink]">$VAR[ButtonOutline]</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>$PARAM[icon]</width>
					<height>$PARAM[icon]</height>
					<texture colordiffuse="$VAR[SectionText2]">icons/back.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<right>0</right>
					<bottom>24</bottom>
					<height>22</height>
					<align>center</align>
					<font>cap_20</font>
					<textcolor>$VAR[SectionText3]</textcolor>
					<label>$LOCALIZE[31345]</label>
					<visible>$PARAM[caption_visible]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Raised fallback block + title for missing art (DESIGN 6). Sits under the artwork.
	     params: mask (rounded-mode mask), label, label_visible -->
	<include name="VidView_ArtFallback">
		<param name="mask">masks/poster_round8.png</param>
		<param name="label">$INFO[ListItem.Label]</param>
		<param name="label_visible">String.IsEmpty(ListItem.Art(poster))</param>
		<param name="parent_icon">40</param>
		<param name="parent_caption">false</param>
		<definition>
			<include content="VidView_ParentTile">
				<param name="icon" value="$PARAM[parent_icon]"/>
				<param name="caption_visible" value="$PARAM[parent_caption]"/>
			</include>
			<control type="group">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<visible>!ListItem.IsParentFolder</visible>
			<include content="VidView_ArtFallbackRound" condition="false">
				<param name="mask" value="$PARAM[mask]"/>
			</include>
			<include condition="true">VidView_ArtFallbackSquare</include>
			<control type="label">
				<left>12</left>
				<right>12</right>
				<top>10</top>
				<height>60</height>
				<font>bold_22</font>
				<textcolor>$VAR[SectionText2]</textcolor>
				<wrapmultiline>true</wrapmultiline>
				<aligny>top</aligny>
				<label>$PARAM[label]</label>
				<visible>$PARAM[label_visible]</visible>
			</control>
			</control>
		</definition>
	</include>
	<include name="VidView_ArtFallbackRound">
		<param name="mask">masks/poster_round8.png</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture diffuse="$PARAM[mask]" colordiffuse="$VAR[ink_12]">common/white.png</texture>
			</control>
		</definition>
	</include>
	<include name="VidView_ArtFallbackSquare">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<texture colordiffuse="$VAR[ink_12]">common/white.png</texture>
		</control>
	</include>

	<!-- One artwork image, mask chosen at window load (corners setting runs ReloadSkin).
	     params: art, mask (rounded mode), color (dim diffuse, default white), visible, aspect, fade -->
	<include name="VidView_ArtImage">
		<param name="art">$INFO[ListItem.Art(poster)]</param>
		<param name="mask">masks/poster_round8.png</param>
		<param name="color">white</param>
		<param name="visible">true</param>
		<param name="aspect">scale</param>
		<param name="fade">0</param>
		<definition>
			<include content="VidView_ArtImageRound" condition="false">
				<param name="art" value="$PARAM[art]"/>
				<param name="mask" value="$PARAM[mask]"/>
				<param name="color" value="$PARAM[color]"/>
				<param name="visible" value="$PARAM[visible]"/>
				<param name="aspect" value="$PARAM[aspect]"/>
				<param name="fade" value="$PARAM[fade]"/>
			</include>
			<include content="VidView_ArtImageSquare" condition="true">
				<param name="art" value="$PARAM[art]"/>
				<param name="color" value="$PARAM[color]"/>
				<param name="visible" value="$PARAM[visible]"/>
				<param name="aspect" value="$PARAM[aspect]"/>
				<param name="fade" value="$PARAM[fade]"/>
			</include>
		</definition>
	</include>
	<include name="VidView_ArtImageRound">
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<fadetime>$PARAM[fade]</fadetime>
				<texture background="true" diffuse="$PARAM[mask]" colordiffuse="$PARAM[color]">$PARAM[art]</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="VidView_ArtImageSquare">
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>$PARAM[aspect]</aspectratio>
				<fadetime>$PARAM[fade]</fadetime>
				<texture background="true" colordiffuse="$PARAM[color]">$PARAM[art]</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ================================================================== page chrome -->

	<!-- Artwork background + text scrim (setting 4). Off = control not rendered, no blur request
	     (the window only sets Blur.SourceImage when the setting is on).
	     params: scrim (texture), scrim_left/top/width/height, scrim_flip -->
	<!-- (VidView_ArtBackground removed: Duotone draws no scrims or gradients) -->

	<!-- Empty folder (or everything filtered away) -->
	<include name="VidView_Empty">
		<control type="group">
			<left>page_margin</left>
			<top>content_top</top>
			<width>page_width</width>
			<height>120</height>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>page_width</width>
				<height>30</height>
				<font>cap_20</font>
				<textcolor>$VAR[SectionText3]</textcolor>
				<label>$LOCALIZE[31346]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>40</top>
				<width>page_width</width>
				<height>40</height>
				<font>body_24</font>
				<textcolor>$VAR[SectionText2]</textcolor>
				<label>$LOCALIZE[31347]</label>
				<visible>System.Setting(hidewatched)</visible>
			</control>
		</control>
	</include>

	<!-- ================================================================== DUOTONE VIEWS -->
	<!-- Wall numerals (DuotoneWall.dc.html): three big Anton numbers per DBType. "—" when unknown. -->
	<variable name="VidView_N1L">
		<value condition="String.IsEqual(ListItem.DBType,season)">Season</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Films</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">Season</value>
		<value>Year</value>
	</variable>
	<variable name="VidView_N1V">
		<value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.Season]</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Total))">$INFO[ListItem.Property(Total)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Season)">$INFO[ListItem.Season]</value>
		<value condition="!String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]</value>
		<value>—</value>
	</variable>
	<variable name="VidView_N2L">
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Seasons</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">Episodes</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Watched</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">Episode</value>
		<value>Minutes</value>
	</variable>
	<variable name="VidView_N2V">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + !String.IsEmpty(ListItem.Property(TotalSeasons))">$INFO[ListItem.Property(TotalSeasons)]</value>
		<value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(TotalEpisodes))">$INFO[ListItem.Property(TotalEpisodes)]</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(Watched))">$INFO[ListItem.Property(Watched)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Episode)">$INFO[ListItem.Episode]</value>
		<value condition="!String.IsEqual(ListItem.DBType,tvshow) + !String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + !String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Duration)">$INFO[ListItem.Duration(mins)]</value>
		<value>—</value>
	</variable>
	<variable name="VidView_N3L">
		<value condition="String.IsEqual(ListItem.DBType,season)">Watched</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">To watch</value>
		<value>Rating</value>
	</variable>
	<variable name="VidView_N3V">
		<value condition="String.IsEqual(ListItem.DBType,season) + !String.IsEmpty(ListItem.Property(WatchedEpisodes))">$INFO[ListItem.Property(WatchedEpisodes)]</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + !String.IsEmpty(ListItem.Property(UnWatched))">$INFO[ListItem.Property(UnWatched)]</value>
		<value condition="!String.IsEqual(ListItem.DBType,season) + !String.IsEqual(ListItem.DBType,set) + $EXP[VidView_HasRating]">$INFO[ListItem.Rating]</value>
		<value>—</value>
	</variable>
	<!-- "R · SCI-FI · THRILLER" kicker in front of the one-line plot -->
	<variable name="VidView_Kicker">
		<value condition="!String.IsEmpty(ListItem.MPAA)">$VAR[VidView_MPAA]$INFO[ListItem.Genre,  ·  ,]</value>
		<value>$INFO[ListItem.Genre]</value>
	</variable>
	<variable name="VidView_WallBigTitle">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="VidView_WallPlot">
		<value condition="ListItem.IsParentFolder">Parent folder  ·  OK goes up one level</value>
		<value condition="!String.IsEmpty(ListItem.Plot)">$INFO[ListItem.Plot]</value>
		<value>$INFO[ListItem.Tagline]</value>
	</variable>
	<variable name="VidView_PosterArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- Episodes view: "05" giant numeral, "S02 · E05" kicker -->
	<variable name="VidView_EpNum">
		<value condition="String.IsEmpty(ListItem.Episode)"></value>
		<value condition="Integer.IsLess(ListItem.Episode,10)">0$INFO[ListItem.Episode]</value>
		<value>$INFO[ListItem.Episode]</value>
	</variable>
	<variable name="VidView_EpKicker">
		<value condition="ListItem.IsParentFolder">Parent folder</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.TVShowTitle]$INFO[ListItem.Season,  ·  Season ,]$INFO[ListItem.Episode,  ·  Episode ,]</value>
	</variable>
	<variable name="VidView_EpMeta">
		<value condition="String.IsEqual(ListItem.DBType,season)">$VAR[PL_TotalEpisodes_Episode]$INFO[ListItem.Property(WatchedEpisodes),  ·  , watched]</value>
