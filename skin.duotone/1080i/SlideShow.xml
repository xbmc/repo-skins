<?xml version="1.0" encoding="UTF-8"?>
<!--
	Picture slideshow overlay (SPEC 5: Minimal). Builder F, M4. Kodi renders the pictures itself;
	the skin only adds a play mark when the current slide is a video that isn't playing, and a
	mono PAUSED tag. No Kodi control ids (Estuary Omega SlideShow.xml has none). Back / Stop exit.
-->
<window>
	<controls>
		<control type="group">
			<visible>SlideShow.IsVideo</visible>
			<visible>![Player.Playing + Player.HasVideo] | SlideShow.IsPaused</visible>
			<control type="image">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>160</width>
				<height>160</height>
				<texture colordiffuse="$VAR[ink]">common/white.png</texture>
			</control>
			<control type="image">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>64</width>
				<height>64</height>
				<texture colordiffuse="$VAR[paper]">icons/play.png</texture>
			</control>
		</control>
		<control type="group">
			<right>page_margin</right>
			<top>48</top>
			<width>160</width>
			<height>40</height>
			<visible>SlideShow.IsPaused</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>160</width>
				<height>40</height>
				<texture colordiffuse="$VAR[ink]">common/white.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>160</width>
				<height>40</height>
				<align>center</align>
				<font>cap_20</font>
				<textcolor>$VAR[paper]</textcolor>
				<label>$LOCALIZE[112]</label>
			</control>
		</control>
	</controls>
</window>
