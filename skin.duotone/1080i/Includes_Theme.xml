<!-- GENERATED by _src/make_theme.py from colors/defaults.xml - edit there / in the generator, then re-run.
     The Look setting (Colour / Light / Dark): docs/skin.duotone/CONVENTIONS.md. Windows use $VAR[<token>]
     or a section variable for every colour; never co_ / lt_ / dk_ names, never hex. -->
<includes>
	<expression name="DT_LookLight">String.IsEqual(Skin.String(duotone.look),light)</expression>
	<expression name="DT_LookDark">String.IsEqual(Skin.String(duotone.look),dark)</expression>
	<expression name="DT_LookMono">String.IsEqual(Skin.String(duotone.look),light) | String.IsEqual(Skin.String(duotone.look),dark)</expression>
	<!-- print veils (DESIGN 9.4 layers 3 / 5) are drawn only in Light / Dark with Monotone on -->
	<expression name="DT_PrintVeils">$EXP[DT_LookMono] + $EXP[DT_MonoOn]</expression>
	<!-- section screens (DESIGN 9.5): Colour = dots everywhere; Light / Dark = films dots, series 45-degree
	     lines, music coarse dots, Search / Settings / system no screen. Same precedence as SectionColor. -->
	<expression name="DT_ScreenDots">!$EXP[DT_LookMono] | [!$EXP[DT_SecSeries] + !$EXP[DT_SecMusic] + !$EXP[DT_SecPaper]]</expression>
	<expression name="DT_ScreenLines">$EXP[DT_LookMono] + $EXP[DT_SecSeries]</expression>
	<expression name="DT_ScreenCoarse">$EXP[DT_LookMono] + !$EXP[DT_SecSeries] + $EXP[DT_SecMusic]</expression>

	<!-- ============================================================ section variables (DESIGN.md 2) -->
	<!-- the field -->
	<variable name="SectionColor">
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecSeries]">lt_sec_series</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecMusic]">lt_sec_music</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecPaper]">lt_sec_paper</value>
		<value condition="$EXP[DT_LookLight]">lt_sec_films</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecSeries]">dk_sec_series</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecMusic]">dk_sec_music</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecPaper]">dk_sec_paper</value>
		<value condition="$EXP[DT_LookDark]">dk_sec_films</value>
		<value condition="$EXP[DT_SecSeries]">co_sec_series</value>
		<value condition="$EXP[DT_SecMusic]">co_sec_music</value>
		<value condition="$EXP[DT_SecPaper]">co_sec_paper</value>
		<value>co_sec_films</value>
	</variable>
	<!-- text and icons on the field -->
	<variable name="SectionText">
		<value condition="$EXP[DT_LookLight]">lt_ink</value>
		<value condition="$EXP[DT_LookDark]">dk_ink</value>
		<value condition="$EXP[DT_SecSeries]">co_paper</value>
		<value>co_ink</value>
	</variable>
	<!-- secondary text on the field (80%) -->
	<variable name="SectionText2">
		<value condition="$EXP[DT_LookLight]">lt_ink_80</value>
		<value condition="$EXP[DT_LookDark]">dk_ink_80</value>
		<value condition="$EXP[DT_SecSeries]">co_paper_80</value>
		<value>co_ink_80</value>
	</variable>
	<!-- captions / disabled (55%) -->
	<variable name="SectionText3">
		<value condition="$EXP[DT_LookLight]">lt_ink_55</value>
		<value condition="$EXP[DT_LookDark]">dk_ink_55</value>
		<value condition="$EXP[DT_SecSeries]">co_paper_55</value>
		<value>co_ink_55</value>
	</variable>
	<!-- ghosted display type: unfocused Home section names -->
	<variable name="SectionFaint">
		<value condition="$EXP[DT_LookLight]">lt_ink_26</value>
		<value condition="$EXP[DT_LookDark]">dk_ink_26</value>
		<value condition="$EXP[DT_SecSeries]">co_paper_30</value>
		<value>co_ink_26</value>
	</variable>
	<!-- monotone print tint (setting duotone.mono: empty = full print, light = soft wash, off = colour) -->
	<variable name="SectionTint">
		<value condition="String.IsEqual(Skin.String(duotone.mono),off)">white</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookLight]">lt_tintl_films</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookDark]">dk_tintl_films</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecSeries]">co_tintl_series</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecMusic]">co_tintl_music</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_SecPaper]">co_tintl_paper</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light)">co_tintl_films</value>
		<value condition="$EXP[DT_LookLight]">lt_tint_films</value>
		<value condition="$EXP[DT_LookDark]">dk_tint_films</value>
		<value condition="$EXP[DT_SecSeries]">co_tint_series</value>
		<value condition="$EXP[DT_SecMusic]">co_tint_music</value>
		<value condition="$EXP[DT_SecPaper]">co_tint_paper</value>
		<value>co_tint_films</value>
	</variable>
	<!-- tint for a desaturated (TMDb Helper) source -->
	<variable name="SectionPrint">
		<value condition="$EXP[DT_LookLight]">lt_print_films</value>
		<value condition="$EXP[DT_LookDark]">dk_print_films</value>
		<value condition="$EXP[DT_SecSeries]">co_print_series</value>
		<value condition="$EXP[DT_SecMusic]">co_print_music</value>
		<value condition="$EXP[DT_SecPaper]">co_print_paper</value>
		<value>co_print_films</value>
	</variable>
	<!-- layer 3 (DESIGN 9.4): field colour over the colour art, ghosts it; clear in Colour and with Monotone off -->
	<variable name="SectionVeilGhost">
		<value condition="String.IsEqual(Skin.String(duotone.mono),off)">clear</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecSeries]">lt_veil_ghost_series</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecMusic]">lt_veil_ghost_music</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecPaper]">lt_veil_ghost_paper</value>
		<value condition="$EXP[DT_LookLight]">lt_veil_ghost_films</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecSeries]">dk_veil_ghost_series</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecMusic]">dk_veil_ghost_music</value>
		<value condition="$EXP[DT_LookDark] + $EXP[DT_SecPaper]">dk_veil_ghost_paper</value>
		<value condition="$EXP[DT_LookDark]">dk_veil_ghost_films</value>
		<value>co_veil_ghost_films</value>
	</variable>
	<!-- layer 5: field colour over the black-and-white source (veill with Monotone Light) -->
	<variable name="SectionVeil">
		<value condition="String.IsEqual(Skin.String(duotone.mono),off)">clear</value>
