		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookDark] + $EXP[DT_SecSeries]">dk_veill_series</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookDark] + $EXP[DT_SecMusic]">dk_veill_music</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookDark] + $EXP[DT_SecPaper]">dk_veill_paper</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light) + $EXP[DT_LookDark]">dk_veill_films</value>
		<value condition="String.IsEqual(Skin.String(duotone.mono),light)">co_veill_films</value>
		<value condition="$EXP[DT_LookLight] + $EXP[DT_SecSeries]">lt_veil_series</value>
