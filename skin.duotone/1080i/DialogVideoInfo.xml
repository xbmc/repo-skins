<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information (DuotoneInfo.dc.html). Movie, episode, TV show, season and collection share one
	page; texts and numerals switch on ListItem.DBType (Includes_VideoInfo.xml). Films vermilion,
	series cobalt (DT_SecSeries reads the item's DBType in this window).

	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo):
	  8 play (plays from the beginning when 9 exists; browses for tvshow/season/set)
	  9 resume (enabled by Kodi only with a resume point) | 11 play trailer | 50 cast list
	  (collections: the films of the set) | 6 refresh | 7 user rating | 10 choose art | 12 choose fanart
	  13 director search | 14 manage versions | 15 manage extras | 443 go to collection (Estuary convention).
	Duotone ids: 9000 action blocks (default focus), 9001 plot (OK = full plot), 9010 More (+),
	  9012 Browse / 9013 From start (re-send 8), 9014 Cast (focus 50), 9100 More row, 9200 full plot, 61 its scrollbar.

	Focus map: 9001 plot ↕ 9000 blocks ↓ 50 cast (the right column slides up 480 px while 50 has focus).
	  + → 9100 row (over the plot while focused; ↑ / ↓ / Back return to +). Back closes the dialog.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<!-- true one-colour print of the fanart (TMDb Helper desaturate, optional): source = this item's fanart -->
	<onload condition="$EXP[DT_DesatOn]">SetProperty(TMDbHelper.Desaturate.SourceImage,Art(fanart)|Art(tvshow.fanart),home)</onload>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>DT_Background</include>
		<include>VidInfo_Print</include>
		<control type="group">
			<description>right column (slides up while the cast row has focus)</description>
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(duotone.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-480" time="200" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(duotone.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-480" time="0"/>
			</animation>
			<include>VidInfo_Header</include>
			<include>VidInfo_Body</include>
			<include>VidInfo_MoreRow</include>
			<include>VidInfo_Buttons</include>
			<include>VidInfo_CastRow</include>
		</control>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
