		<textureradioonnofocus colordiffuse="$VAR[ink]">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="$VAR[paper]">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1.png</textureradiooffnofocus>
	</include>

	<!-- ============================================================ toasts -->
	<!-- Toast panel (notification / background progress): bg + hairline frame, no accent bar.
	     params: height -->
	<include name="DT_ToastFrame">
		<param name="height">104</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>toast_w</width>
				<height>$PARAM[height]</height>
				<texture colordiffuse="$VAR[SectionColor]">common/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>toast_w</width>
				<height>$PARAM[height]</height>
				<texture border="16" colordiffuse="$VAR[ink]">common/rect_outline_8.png</texture>
			</control>
		</definition>
	</include>

	<!-- ============================================================ keyboard keys -->
	<!-- On-screen keyboard / numeric keys. Kodi writes the key labels. 1px outline at rest,
	     accent fill + ink on focus; corners follow the setting (picked at window load). -->
	<include name="DT_KeyboardKey">
		<font>an_40</font>
		<textcolor>$VAR[SectionText]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
		<pulseonselect>false</pulseonselect>
		<include condition="false">Dlg_Tex_Key_Round</include>
		<include condition="true">Dlg_Tex_Key_Square</include>
	</include>
	<include name="DT_KeyboardFunc">
		<font>capt_20</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
		<pulseonselect>false</pulseonselect>
		<include condition="false">Dlg_Tex_Key_Round</include>
		<include condition="true">Dlg_Tex_Key_Square</include>
	</include>
	<include name="Dlg_Tex_Key_Square">
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1.png</texturenofocus>
	</include>
	<include name="Dlg_Tex_Key_Round">
		<texturefocus border="10" colordiffuse="$VAR[ink]">common/rect_round8.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1_round8.png</texturenofocus>
	</include>
</includes>
