<?xml version="1.0" encoding="UTF-8"?>
<!--
	Seek bar (Duotone): a low slab of the section colour from y 832 (8px ink rule on top): title and
	"ENDS 1:52 AM · 11:38" captions, the time as an Anton 104 numeral (the seek target while seeking),
	state / remaining caption, a 16px bar with a playhead block and a time tab above it; top right an
	ink "+30s SKIP" tab while skipping.

	Id contract (Estuary Omega DialogSeekBar.xml / GUIDialogSeekBar.cpp): 401 = progress slider Kodi
	selects to the seek target (POPUP_SEEK_PROGRESS); 402/403 are PVR only (omitted).
	Window visibility conditions copied from Estuary Omega. The content steps aside while the OSD,
	the fullscreen info or a playback dialog is up (they draw their own progress): OSD_SeekBarHidden.
-->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>  <!-- Now playing (visualisation) draws its own progress; no seek bar on top of it -->
	<visible>![Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(pvrguideinfo)]</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<zorder>0</zorder>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_SeekBarHidden]</visible>
			<visible>!Player.HasGame</visible>
			<include>Anim_FadeVisible</include>

			<!-- slab (none when the music OSD, which has its own, is open) -->
			<control type="group">
				<visible>!Window.IsVisible(musicosd)</visible>
				<include content="OSD_Slab">
					<param name="top" value="832"/>
				</include>
			</control>

			<!-- ====== skip feedback, top right -->
			<control type="grouplist">
				<right>page_margin</right>
				<top>64</top>
				<width>600</width>
				<height>54</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<usecontrolcoords>true</usecontrolcoords>
				<visible>[!String.IsEmpty(Player.SeekStepSize) | [!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)]] + Window.IsActive(fullscreenvideo)</visible>
				<include>Anim_FadeVisible</include>
				<control type="button">
					<description>tab: "+30s" (accent) + "SKIP"; one auto-width disabled button so the tab hugs the text</description>
					<width>auto</width>
					<height>54</height>
					<font>an_40</font>
					<textcolor>$VAR[SectionColor]</textcolor>
					<disabledcolor>$VAR[SectionColor]</disabledcolor>
					<textoffsetx>18</textoffsetx>
					<texturenofocus colordiffuse="$VAR[ink]">common/white.png</texturenofocus>
					<label>$VAR[OSD_SkipValue]</label>
					<enable>false</enable>
				</control>
				<control type="button">
					<width>auto</width>
					<height>54</height>
					<font>cap_20</font>
					<textcolor>$VAR[paper]</textcolor>
					<disabledcolor>$VAR[paper]</disabledcolor>
					<textoffsetx>14</textoffsetx>
					<texturenofocus colordiffuse="$VAR[ink]">common/white.png</texturenofocus>
					<label>$LOCALIZE[31316]</label>
					<enable>false</enable>
				</control>
			</control>

			<!-- ====== caption row: title (left), ends + clock (right) -->
			<control type="label">
				<left>page_margin</left>
				<top>862</top>
				<width>1200</width>
				<height>24</height>
				<font>cap_20</font>
				<label>$VAR[OSD_ShortTitle]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>862</top>
				<width>page_width</width>
				<height>24</height>
				<align>right</align>
				<font>cap_20</font>
				<label>$VAR[OSD_EndsClock]</label>
			</control>
			<!-- ====== giant time (seek target while seeking) + state / remaining -->
			<control type="label">
				<left>60</left>
				<top>885</top>
				<width>900</width>
				<height>104</height>
				<font>an_104</font>
				<label>$VAR[OSD_SeekTimeLabel]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>970</top>
				<width>page_width</width>
				<height>24</height>
				<align>right</align>
				<font>cap_20</font>
				<label>$VAR[OSD_State]$INFO[Player.TimeRemaining,  ·  −,]$INFO[Player.Duration,  /  ,]</label>
			</control>
			<!-- ====== thick bar -->
			<include content="OSD_Track">
				<param name="top" value="1016"/>
			</include>
			<!-- Kodi selects 401 to the seek target; drawn invisible (OSD_Track shows the same value) -->
			<control type="slider" id="401">
				<left>page_margin</left>
				<top>1008</top>
				<width>page_width</width>
				<height>32</height>
				<texturesliderbar>osd/slider_bg.png</texturesliderbar>
				<textureslidernib colordiffuse="clear">osd/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="clear">osd/slider_nib.png</textureslidernibfocus>
			</control>
			<include content="OSD_SeekBubble">
				<param name="top" value="974"/>
				<param name="visible" value="Player.SeekEnabled + [$EXP[OSD_SeekActive] | Player.Forwarding | Player.Rewinding]"/>
			</include>
		</control>
	</controls>
</window>
