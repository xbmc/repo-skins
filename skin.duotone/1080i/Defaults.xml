<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Duotone focus language for controls: a solid ink block with paper text (focusedcolor paper).
	Text on the field: $VAR[SectionText] (ink, paper on cobalt). Art focus (8px frame) lives in the views.
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText]</textcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<selectedcolor>$VAR[SectionText]</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText]</textcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText]</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<alttexturefocus colordiffuse="$VAR[ink]">common/white.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="$VAR[paper]">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[ink]">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="$VAR[paper]">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="$VAR[SectionText3]">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="10" colordiffuse="$VAR[SectionText3]">common/rect_outline_1.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="$VAR[SectionText3]">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="$VAR[SectionText3]" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[paper]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[paper]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[SectionText3]">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[SectionText3]" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="$VAR[SectionText3]">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="$VAR[SectionText3]" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[paper]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[paper]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[SectionText3]">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[SectionText3]" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>8</sliderheight>
		<texturesliderbar colordiffuse="$VAR[ink_26]">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[ink]">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[SectionText2]">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[paper]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[SectionText3]">common/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="$VAR[ink_26]">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[ink]">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[SectionText2]">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[paper]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[SectionText3]">common/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText2]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="$VAR[SectionText3]">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>ui_26</font>
		<textcolor>$VAR[SectionText]</textcolor>
		<focusedcolor>$VAR[paper]</focusedcolor>
		<disabledcolor>$VAR[SectionText3]</disabledcolor>
		<invalidcolor>$VAR[chip_films]</invalidcolor>
		<texturefocus colordiffuse="$VAR[ink]">common/white.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="$VAR[ink_26]">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="$VAR[ink]">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="$VAR[ink_20]">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="$VAR[SectionText3]">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="$VAR[ink]">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
