<?xml version="1.0" encoding="UTF-8"?>
<!--
	Profile login screen (only shown when profiles + login screen are enabled; SPEC 5: Minimal).
	Builder F, M4. Up / Down moves between the profiles and the Power button.
	Kodi id contract (Estuary Omega LoginScreen.xml / GUIWindowLoginScreen): profile container 52,
	power button 20 (opens the shutdown menu).
-->
<window>
	<defaultcontrol always="true">52</defaultcontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>DT_Background</include>
		<include content="DT_TopBar">
			<param name="index" value="00"/>
			<param name="title" value="Who is watching?"/>
		</include>
		<control type="list" id="52">
			<left>page_margin</left>
			<top>260</top>
			<width>page_width</width>
			<height>360</height>
			<orientation>horizontal</orientation>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup>20</onup>
			<ondown>20</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout width="300" height="360">
				<control type="group">
					<left>14</left>
					<top>14</top>
					<width>240</width>
					<height>240</height>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>240</width>
						<height>240</height>
						<texture colordiffuse="$VAR[ink_12]">common/white.png</texture>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>240</width>
						<height>240</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" colordiffuse="$VAR[SectionTint]">$INFO[ListItem.Icon]</texture>
					</control>
				</control>
				<control type="label">
					<left>14</left>
					<top>276</top>
					<width>240</width>
					<height>40</height>
					<font>ui_22</font>
					<textcolor>$VAR[SectionText2]</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout width="300" height="360">
				<control type="group">
					<left>14</left>
					<top>14</top>
					<width>240</width>
					<height>240</height>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>240</width>
						<height>240</height>
						<texture colordiffuse="$VAR[ink_12]">common/white.png</texture>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>240</width>
						<height>240</height>
						<aspectratio>scale</aspectratio>
						<texture background="true">$INFO[ListItem.Icon]</texture>
					</control>
					<include content="DT_FocusFrameAlways">
						<param name="visible" value="Control.HasFocus(52)"/>
					</include>
				</control>
				<control type="label">
					<left>14</left>
					<top>276</top>
					<width>240</width>
					<height>40</height>
					<font>bold_22</font>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
		<control type="label">
			<left>page_margin</left>
			<top>660</top>
			<width>page_width</width>
			<height>30</height>
			<font>cap_20</font>
			<textcolor>$VAR[SectionText3]</textcolor>
			<label>$INFO[Container(52).ListItem.Label2,Last login  ,]</label>
		</control>
		<control type="button" id="20">
			<description>Power menu</description>
			<left>page_margin</left>
			<top>900</top>
			<width>260</width>
			<height>dialog_row_h</height>
			<label>$LOCALIZE[31022]</label>
			<font>btn_24</font>
			<textcolor>$VAR[SectionText]</textcolor>
			<align>center</align>
			<textoffsetx>16</textoffsetx>
			<texturefocus border="10" colordiffuse="$VAR[ink]">common/rect_square.png</texturefocus>
			<texturenofocus border="10" colordiffuse="$VAR[ink]">common/rect_outline_1.png</texturenofocus>
			<onclick>ActivateWindow(ShutdownMenu)</onclick>
			<onup>52</onup>
			<ondown>52</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
		</control>
	</controls>
</window>
