<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Duotone / Home Series spotlight: random shows rated 7.5+ (any watch state). -->
<smartplaylist type="tvshows">
    <name>Duotone series spotlight</name>
    <match>all</match>
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
    <limit>5</limit>
    <order direction="ascending">random</order>
</smartplaylist>
