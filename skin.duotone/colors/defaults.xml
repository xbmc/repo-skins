    <color name="dk_sec_music">ff323232</color>
    <color name="co_sec_paper">fff1ede4</color>      <!-- paper: Search / Settings / everything else -->
    <color name="lt_sec_paper">fff7f7f7</color>
    <color name="dk_sec_paper">ff1c1c1c</color>

