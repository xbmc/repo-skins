<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Orbit / Home Movies arc default band: unwatched films that show as 7.5+ in the UI, shuffled
     on every load (rating > 7.449 so a stored 7.45 displayed as "7.5" is included; votes > 50
     drops 1-vote outliers). -->
<smartplaylist type="movies">
    <name>Unwatched, rated 7.5+</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
    <rule field="votes" operator="greaterthan">
        <value>50</value>
    </rule>
    <order direction="ascending">random</order>
</smartplaylist>
