<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.orbit palette (docs/skin.orbit/DESIGN.md section 2). Format AARRGGBB, refer by name.
    One accent only: signal amber, for the live value on every ring (sweep, progress, focused tick).
    Everything else is monochrome deep blue (0.9.2: lifted from the mockups' near-black so it reads blue on a TV). Legacy token names from the Majan engine are kept
    (bg, text_primary, hairline ...) and remapped, so every window speaks the Orbit palette.
-->
<colors>
    <!-- Ground and surfaces -->
    <color name="bg">ff0a1226</color>                <!-- ground fill #0A1226 (full screens use media/ground/*.png) -->
    <color name="lift">ff1c2d52</color>              <!-- radial lift behind the lens -->
    <color name="panel">ff0d1529</color>             <!-- round button fill, chips, panels -->
    <color name="bg_raised">ff1a2744</color>         <!-- focused row fill -->
    <color name="bg_ghost">ff18233d</color>
    <color name="plate">ff15203a</color>             <!-- poster plate (missing art) -->
    <color name="ink">ff07090d</color>               <!-- text/icons on light fills -->

    <!-- Text -->
    <color name="text_primary">ffe9edf3</color>      <!-- titles, values, focused -->
    <color name="text_body">ffc9d0db</color>         <!-- plot (info page) -->
    <color name="text_plot">ffb9c1ce</color>         <!-- plot (arc browser) -->
    <color name="text_meta">ffaeb7c6</color>         <!-- meta lines under titles -->
    <color name="text_secondary">ff8b95a7</color>    <!-- labels, unfocused items -->
    <color name="text_tertiary">ff8b95a7</color>     <!-- legacy: captions -->
    <color name="text_dim">ff566075</color>          <!-- engraved numerals, "/ 1360" -->

    <!-- Lines and ticks -->
    <color name="line">ff2b3240</color>              <!-- fine lines 1.5px, minor ticks -->
    <color name="line_soft">ff1d2740</color>
    <color name="line_faint">ff18223a</color>
    <color name="tick">ff566075</color>              <!-- major ticks -->
    <color name="tick_bright">ff7a8496</color>
    <color name="border_button">ff3a4252</color>     <!-- round button / chip outline -->
    <color name="hairline">ff2b3240</color>
    <color name="hairline_soft">ff1d2740</color>
    <color name="hairline_strong">ff3a4252</color>
    <color name="border_control">ff3a4252</color>
    <color name="hairline_art">33e9edf3</color>
    <color name="hairline_art_strong">4de9edf3</color>

    <!-- Accent -->
    <color name="accent">ffffb547</color>            <!-- signal amber #FFB547 -->
    <color name="accent_signal">ffffb547</color>
    <color name="accent_fill">21ffb547</color>       <!-- 13% sector fill -->
    <color name="accent_dim">80ffb547</color>

    <!-- Scrims and dims (tint white gradient/scrim textures) -->
    <color name="scrim">ff060b1c</color>
    <color name="scrim_tab">d1060b1c</color>         <!-- .82 badge / chip backing -->
    <color name="scrim_track">cc060b1c</color>
    <color name="shadow">b3000000</color>
    <color name="focus_halo">b3060b1c</color>
    <color name="dim_dialog">d9060b1c</color>        <!-- 85% behind modal dialogs -->
    <color name="dim_video">80060b1c</color>         <!-- 50% video dim under the OSD -->
    <color name="dim_passed">ff737373</color>
    <color name="dim_ahead">ffcccccc</color>
    <color name="dim_row">ff6e6e6e</color>

    <!-- Artwork background opacity (TMDb Helper blur, setting "artwork backdrop") -->
    <color name="art_faint">40ffffff</color>
    <color name="art_soft">66ffffff</color>
    <color name="art_visible">99ffffff</color>

    <!-- Arc brightness by distance from the lens (fadediffuse values: 1, .62, .44, .32, .22, .15) -->
    <color name="arc_b0">ffffffff</color>
    <color name="arc_b1">ff9e9e9e</color>
    <color name="arc_b2">ff707070</color>
    <color name="arc_b3">ff525252</color>
    <color name="arc_b4">ff383838</color>
    <color name="arc_b5">ff262626</color>

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
    <color name="disabled">ff4a5263</color>
</colors>
