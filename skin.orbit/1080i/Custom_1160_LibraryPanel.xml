<?xml version="1.0" encoding="UTF-8"?>
<!--
	Orbit Library panel (custom dialog 1160; docs/requests/library-panel/BRIEF.md). The library's
	general-purpose menu: View, Sort, Order, Unwatched only, Sets (films), Search, Update library,
	Clean library, Library settings. Opened by the Menu key's "View, sort, filter" row in the library windows (0.9.21, DialogContextMenu.xml), by Right from any library view (arc, grid, episodes, dial list), Left past
	the first pill of the option bar, the OPTIONS pill, and the System menu (Update / Clean library,
	orbit.libmode = update / clean: choose Movies and TV shows or Music).
	Same language as the System menu: navy framed panel, amber mono kicker, numbered rows.
	Kodi's CleanLibrary() has no confirmation of its own, so the panel asks first (list 200, "No"
	focused). Back closes the panel (Kodi's Back); the library keeps the item you came from.
	GENERATED by _src/make_library_panel.py (variables in Includes_LibraryPanel.xml). No Kodi-owned ids.
-->
<window type="dialog" id="1160">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<!-- Kodi restores a dialog list's last selection on reopen: always start on the first row, and
	     the Clean confirmation always on "No" (SetFocus(200,0,absolute) in the Clean rows) -->
	<onload>SetFocus(100,0,absolute)</onload>
	<onunload>ClearProperty(orbit.libclean,home)</onunload>
	<onunload>ClearProperty(orbit.libmode,home)</onunload>
	<controls>
		<control type="image">
			<description>backdrop dim</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="dim_dialog">common/white.png</texture>
		</control>
		<control type="group">
			<left>660</left>
			<top>below_bar_top</top>
			<width>600</width>
			<height>748</height>
			<!-- frame sized to the visible rows -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>136</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,1)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>204</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,2)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>272</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,3)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>340</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,4)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>408</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,5)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>476</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,6)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>544</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,7)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>612</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,8)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>680</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsEqual(Container(100).NumItems,9)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>748</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libclean)) + Integer.IsGreaterOrEqual(Container(100).NumItems,10)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>358</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>!String.IsEmpty(Window(Home).Property(orbit.libclean))</visible>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>552</width>
				<height>56</height>
				<font>mono_13</font>
				<textcolor>accent</textcolor>
				<label>$VAR[LibPanel_Kicker]</label>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>552</width>
				<height>56</height>
				<align>right</align>
				<font>num_14</font>
				<textcolor>text_tertiary</textcolor>
				<label>$VAR[LibPanel_Where]</label>
				<visible>String.IsEmpty(Window(Home).Property(orbit.libmode))</visible>
			</control>
			<control type="list" id="100">
				<left>12</left>
				<top>56</top>
				<width>576</width>
				<height>680</height>
				<onup>100</onup>
				<ondown>100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<visible allowhiddenfocus="true">String.IsEmpty(Window(Home).Property(orbit.libclean))</visible>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="576"/>
					<param name="height" value="68"/>
					<param name="list_id" value="100"/>
				</include>
				<content>
					<!-- ===== the library underneath (orbit.libmode empty) ===== -->
					<item>
						<label>$LOCALIZE[31011]</label>
						<label2>$INFO[Container.Viewmode]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>ActivateWindow(1161)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Integer.IsGreater(Container.ViewCount,1)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31010]</label>
						<label2>$INFO[Container.SortMethod]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>SendClick(3)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + !String.IsEmpty(Container.SortMethod)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31300]</label>
						<label2>$VAR[LibPanel_Direction]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick condition="Window.IsActive(videos)">SendClick(4)</onclick>
						<onclick condition="!Window.IsActive(videos)">Container.SetSortDirection</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + !String.IsEmpty(Container.SortMethod)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31081]</label>
						<label2>$VAR[LibPanel_Unwatched]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>SendClick(14)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(videos) + !String.StartsWith(Container.FolderPath,videodb://inprogresstvshows) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)]</visible>
					</item>
					<item>
						<label>$LOCALIZE[20434]</label>
						<label2>$LOCALIZE[31308]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>SetFocus(50)</onclick>
						<onclick>Container.Update(videodb://movies/sets/)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + $EXP[LibPanel_ShowSets]</visible>
					</item>
					<item>
						<label>$LOCALIZE[31302]</label>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>ActivateWindow(1150)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode))</visible>
					</item>
					<item>
						<label>$LOCALIZE[31202]</label>
						<label2>$LOCALIZE[31309]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(video)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(videos) + !Library.IsScanningVideo + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31303]</label>
						<label2>$LOCALIZE[31309]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(video)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(videos) + Library.IsScanningVideo + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31202]</label>
						<label2>$LOCALIZE[31305]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(music)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(music) + !Library.IsScanningMusic + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31303]</label>
						<label2>$LOCALIZE[31305]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(music)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(music) + Library.IsScanningMusic + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31204]</label>
						<label2>$LOCALIZE[31309]</label2>
						<onclick>SetProperty(orbit.libclean,video,home)</onclick>
						<onclick>SetFocus(200,0,absolute)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(videos) + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31204]</label>
						<label2>$LOCALIZE[31305]</label2>
						<onclick>SetProperty(orbit.libclean,music,home)</onclick>
						<onclick>SetFocus(200,0,absolute)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode)) + Window.IsActive(music) + String.IsEmpty(Container.PluginName) + !Container.Content(addons)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31304]</label>
						<label2>Kodi</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>ActivateWindow(MediaSettings)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(orbit.libmode))</visible>
					</item>
					<!-- ===== from the System menu: Update library ===== -->
					<item>
						<label>$LOCALIZE[31309]</label>
						<label2>$LOCALIZE[31306]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(video)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),update) + !Library.IsScanningVideo</visible>
					</item>
					<item>
						<label>$LOCALIZE[31309]</label>
						<label2>$LOCALIZE[31303]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(video)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),update) + Library.IsScanningVideo</visible>
					</item>
					<item>
						<label>$LOCALIZE[31305]</label>
						<label2>$LOCALIZE[31306]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(music)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),update) + !Library.IsScanningMusic</visible>
					</item>
					<item>
						<label>$LOCALIZE[31305]</label>
						<label2>$LOCALIZE[31303]</label2>
						<onclick>Dialog.Close(1160,true)</onclick>
						<onclick>UpdateLibrary(music)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),update) + Library.IsScanningMusic</visible>
					</item>
					<!-- ===== from the System menu: Clean library ===== -->
					<item>
						<label>$LOCALIZE[31309]</label>
						<label2>$LOCALIZE[31307]</label2>
						<onclick>SetProperty(orbit.libclean,video,home)</onclick>
						<onclick>SetFocus(200,0,absolute)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),clean)</visible>
					</item>
					<item>
						<label>$LOCALIZE[31305]</label>
						<label2>$LOCALIZE[31307]</label2>
						<onclick>SetProperty(orbit.libclean,music,home)</onclick>
						<onclick>SetFocus(200,0,absolute)</onclick>
						<visible>String.IsEqual(Window(Home).Property(orbit.libmode),clean)</visible>
					</item>
				</content>
			</control>
			<!-- Clean library: ask first ("No" is focused) -->
			<control type="textbox">
				<left>24</left>
				<top>64</top>
				<width>552</width>
				<height>136</height>
				<font>text_24</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[LibPanel_CleanText]</label>
				<visible>!String.IsEmpty(Window(Home).Property(orbit.libclean))</visible>
			</control>
			<control type="list" id="200">
				<left>12</left>
				<top>206</top>
				<width>576</width>
				<height>136</height>
				<onup>200</onup>
				<ondown>200</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<visible allowhiddenfocus="true">!String.IsEmpty(Window(Home).Property(orbit.libclean))</visible>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="576"/>
					<param name="height" value="68"/>
					<param name="list_id" value="200"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[31310]</label>
						<onclick>ClearProperty(orbit.libclean,home)</onclick>
						<onclick>SetFocus(100)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31311]</label>
						<onclick condition="String.IsEqual(Window(Home).Property(orbit.libclean),video)">CleanLibrary(video)</onclick>
						<onclick condition="String.IsEqual(Window(Home).Property(orbit.libclean),music)">CleanLibrary(music)</onclick>
						<onclick>Dialog.Close(1160,true)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
