<?xml version="1.0" encoding="UTF-8"?>
<!--
	Orbit Search - custom window 1150 (opened from the Home dial: Search). The page is a dial like Home:
	stations Search / Films / Shows / Albums / Artists on the ring (counts beside them), the selected
	station's results sweep out on an arc. Pieces: Includes_Search.xml.

	Flow: the window opens on hidden button 9099, which focuses the edit field 9001 and opens the
	keyboard when there is no query yet. Done -> results load (library only). Left / Back from the
	field -> the dial (9000). Up/Down turns the dial; Right enters the station's arc (Search station:
	the field); OK on the Search station types again. Back from an arc -> the dial; Back on the dial
	-> Home.
	Ids: 9099 opener, 9001 edit, 9000 dial, 9101 films, 9102 shows, 9103 albums, 9104 artists.
-->
<window type="window" id="1150">
	<defaultcontrol always="true">9099</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<!-- the encoded query (Includes_Search.xml) must not outlive the window: a stale one would show old rows -->
	<onunload>ClearProperty(Orbit.Search.Encoded,home)</onunload>
	<controls>
		<!-- query encoder (script.skinvariables): its items are never shown; it exists to set Orbit.Search.Encoded -->
		<control type="list" id="9710">
			<left>-20</left>
			<top>-20</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content target="programs">$VAR[Search_EncoderPath]</content>
		</control>
		<!-- fit-to-width probes for the wide titles (Includes_Titles.xml) -->
		<include content="Fit_SearchVideo_Probes">
			<param name="label" value="$VAR[Search_VideoTitle]"/>
		</include>
		<include content="Fit_SearchMusic_Probes">
			<param name="label" value="$VAR[Search_MusicTitle]"/>
		</include>
		<!-- Opens the keyboard on arrival (onload/AlarmClock clicks were lost on the Shield, Majan) -->
		<control type="button" id="9099">
			<left>-100</left>
			<top>-100</top>
			<width>1</width>
			<height>1</height>
			<texturefocus/>
			<onfocus>SetFocus(9001)</onfocus>
			<onfocus condition="!$EXP[Search_HasQuery]">Action(Select)</onfocus>
			<visible allowhiddenfocus="true">false</visible>
		</control>
		<include content="Orbit_Background">
			<param name="ground" value="home"/>
		</include>
		<include>Search_Furniture</include>
		<include>Search_Lists</include>
		<include>Search_DialReadout</include>
		<include>Search_Arcs</include>
		<include>Search_Panels</include>
		<include>Arc_HomeDial</include>
	</controls>
</window>
