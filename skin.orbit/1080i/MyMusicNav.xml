<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library. Views: 504 arc (album covers / artist discs + record dial), 505 grid (+ songs 0.9.19), 507 horizon (+ songs 0.9.19), 50 dial list.
	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp): views in <views>,
	menucontrol 9000, 3 sort by, 4 sort order (hidden, clicked by the option bar).
	Reserved by Kodi in this window and not reused: 2, 5, 8, 12, 15, 16, 17, 19, 20.
	Focus map: view -Left-> option bar (Albums / Artists / Songs / Genres / Sort / View) -Up/Right/Back->
	view. Back on a view is Kodi's (up a folder, back through the tab history, out at the start node).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>bg</backgroundcolor>
	<views>504,505,507,50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<!-- fit-to-width probes for the wide titles (Includes_Titles.xml) -->
		<include content="Fit_MusicArc_Probes">
			<param name="label" value="$VAR[MusicView_FitLabel]"/>
		</include>
		<include content="Orbit_Background">
			<param name="ground" value="page"/>
		</include>
		<include content="Orbit_Ground">
			<param name="ground" value="arc"/>
			<param name="visible" value="Control.IsVisible(504)"/>
		</include>
		<include content="Orbit_Ground">
			<param name="ground" value="list"/>
			<param name="visible" value="Control.IsVisible(50)"/>
		</include>
		<include>Music_View_504</include>
		<include>Music_View_505</include>
		<include>Music_View_507</include>
		<include>Music_View_50</include>
		<include content="Orbit_Header">
			<param name="title" value="$VAR[MusicView_Title]"/>
			<param name="sub" value="$VAR[Orbit_Position]"/>
		</include>
		<include>Orbit_MenuHint</include>
		<include>Music_HeaderBar</include>
		<control type="group">
			<animation effect="slide" start="0,0" end="0,-300" time="0" condition="Control.IsVisible(507)">Conditional</animation>
			<!-- a ".." item sits at the lens in every view but Horizon: the ring and caption go below it -->
			<animation effect="slide" start="0,0" end="0,280" time="0" condition="Container.HasParent + !Control.IsVisible(507)">Conditional</animation>
			<include>Orbit_EmptyFolder</include>
		</control>
		<include>Music_NowPlayingBar</include>
	</controls>
</window>
