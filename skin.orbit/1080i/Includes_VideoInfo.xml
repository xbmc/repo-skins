<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogVideoInfo = the instrument panel (OrbitInfo.dc.html): darkened fanart, wide title, three
	gauges (rating ring, runtime clock sector with "ends at", your progress), story + codec chips,
	round action buttons, cast on a shallow arc. Prefix VidInfo_.
	Shared labels: Includes_Views_Video.xml (VidView_*).
-->
<includes>
	<!-- ================================================================== variables -->
	<variable name="VidInfo_TypeTitle">
		<value condition="String.IsEqual(ListItem.DBType,movie)">Film info</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">Episode info</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">Show info</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">Season info</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Collection</value>
		<value condition="String.IsEqual(ListItem.DBType,musicvideo)">Music video</value>
		<value>Video info</value>
	</variable>
	<variable name="VidInfo_Section">
		<value condition="String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,set)">$LOCALIZE[342]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">TV</value>
		<value>$LOCALIZE[3]</value>
	</variable>
	<!-- label above the title: tagline, episode code + show, set name -->
	<variable name="VidInfo_Kicker">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[VidView_EpCode]$INFO[ListItem.TVShowTitle,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">Collection$VAR[PL_Total_Film]</value>
		<value condition="!String.IsEmpty(ListItem.Tagline)">$INFO[ListItem.Tagline]</value>
		<value condition="!String.IsEmpty(ListItem.Set)">$INFO[ListItem.Set]</value>
		<value>$INFO[ListItem.Studio]</value>
	</variable>
	<variable name="VidInfo_Title">
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="VidInfo_Fanart">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_MetaPeople">
		<value condition="!String.IsEmpty(ListItem.Director)">$INFO[ListItem.Director]$INFO[ListItem.Genre,  ·  ,]</value>
		<value>$INFO[ListItem.Studio]$INFO[ListItem.Genre,  ·  ,]</value>
	</variable>
	<variable name="VidInfo_CastHeader">
		<value condition="String.IsEqual(ListItem.DBType,set)">Films</value>
		<value>$LOCALIZE[206]</value>
	</variable>
	<!-- chips -->
	<variable name="VidInfo_FlagRes">
		<value condition="String.IsEqual(ListItem.VideoResolution,8K)">8K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,4K) | String.IsEqual(ListItem.VideoResolution,2160)">4K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,1080)">1080p</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,720)">720p</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,576) | String.IsEqual(ListItem.VideoResolution,540) | String.IsEqual(ListItem.VideoResolution,480)">SD</value>
		<value>$INFO[ListItem.VideoResolution]</value>
	</variable>
	<variable name="VidInfo_FlagHDR">
		<value condition="String.IsEqual(ListItem.HdrType,dolbyvision)">DV</value>
		<value condition="String.IsEqual(ListItem.HdrType,hdr10)">HDR10</value>
		<value condition="String.IsEqual(ListItem.HdrType,hlg)">HLG</value>
		<value>$INFO[ListItem.HdrType]</value>
	</variable>
	<variable name="VidInfo_FlagVideo">
		<value condition="String.IsEqual(ListItem.VideoCodec,hevc) | String.IsEqual(ListItem.VideoCodec,h265) | String.IsEqual(ListItem.VideoCodec,hev1) | String.IsEqual(ListItem.VideoCodec,hvc1)">HEVC</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,h264) | String.IsEqual(ListItem.VideoCodec,avc1) | String.IsEqual(ListItem.VideoCodec,avc)">H264</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,mpeg2video) | String.IsEqual(ListItem.VideoCodec,mpeg2)">MPEG2</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,av1)">AV1</value>
		<value condition="String.IsEqual(ListItem.VideoCodec,vc1) | String.IsEqual(ListItem.VideoCodec,wvc1)">VC1</value>
		<value>[UPPERCASE]$INFO[ListItem.VideoCodec][/UPPERCASE]</value>
	</variable>
	<variable name="VidInfo_AudioCodec">
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd_atmos)">ATMOS</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd)">TRUEHD</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3_ddp_atmos)">DD+ ATMOS</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3)">DD+</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,ac3) | String.IsEqual(ListItem.AudioCodec,dolbydigital)">AC3</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma_x) | String.IsEqual(ListItem.AudioCodec,dtshd_ma_x_imax)">DTS:X</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma) | String.IsEqual(ListItem.AudioCodec,dtsma)">DTS-HD MA</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,dts) | String.IsEqual(ListItem.AudioCodec,dca)">DTS</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,aac)">AAC</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,pcm)">PCM</value>
		<value condition="String.StartsWith(ListItem.AudioCodec,flac)">FLAC</value>
		<value>[UPPERCASE]$INFO[ListItem.AudioCodec][/UPPERCASE]</value>
	</variable>
	<variable name="VidInfo_AudioChannels">
		<value condition="Integer.IsEqual(ListItem.AudioChannels,8)">7.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,7)">6.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,6)">5.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,3)">2.1</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,2)">2.0</value>
		<value condition="Integer.IsEqual(ListItem.AudioChannels,1)">1.0</value>
		<value condition="!String.IsEmpty(ListItem.AudioChannels)">$INFO[ListItem.AudioChannels,,ch]</value>
	</variable>
	<variable name="VidInfo_ProgressCaption">
		<value condition="$EXP[VidView_IsTVType] + Integer.IsGreater(ListItem.Property(TotalEpisodes),0)">[COLOR text_secondary]$INFO[ListItem.Property(WatchedEpisodes)] of [/COLOR]$VAR[PL_TotalEpisodes_Episode]</value>
		<value condition="ListItem.IsResumable">[COLOR text_secondary]resume at [/COLOR]$INFO[ListItem.PercentPlayed]%</value>
		<value condition="Integer.IsEqual(ListItem.PlayCount,1)">[COLOR text_secondary]watched once[/COLOR]</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,1)">[COLOR text_secondary]watched [/COLOR]$INFO[ListItem.PlayCount,, times]</value>
		<value>[COLOR text_secondary]unwatched[/COLOR]</value>
	</variable>
	<!-- by TMDb id (the title as a query would need URL encoding; Kodi 21 has none) -->
	<variable name="VidInfo_SimilarPath">
		<value condition="$EXP[VidView_IsTVType] | String.IsEqual(ListItem.DBType,episode)">plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=tv&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]</value>
		<value>plugin://plugin.video.themoviedb.helper/?info=recommendations&amp;tmdb_type=movie&amp;tmdb_id=$INFO[ListItem.UniqueID(tmdb)]</value>
	</variable>

	<expression name="VidInfo_ShowResume">Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowPlay">!Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowTrailer">$EXP[ShowTrailerButton] + !String.IsEmpty(ListItem.Trailer)</expression>
	<expression name="VidInfo_ShowSimilar">System.AddonIsEnabled(plugin.video.themoviedb.helper) + !String.IsEmpty(ListItem.UniqueID(tmdb)) + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow)]</expression>

	<!-- ================================================================ backdrop -->
	<include name="VidInfo_Backdrop">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<aspectratio>scale</aspectratio>
			<fadetime>300</fadetime>
			<texture background="true">$VAR[VidInfo_Fanart]</texture>
		</control>
		<!-- each scrim with its own fades (LESSONS 4) -->
		<include content="Orbit_GroundScrim">
			<param name="mask" value="common/scrim_info_h.png"/>
			<param name="ground" value="page"/>
		</include>
		<include content="Orbit_GroundScrim">
			<param name="mask" value="common/scrim_info_v.png"/>
			<param name="ground" value="page"/>
		</include>
	</include>

	<!-- ================================================================ head -->
	<include name="VidInfo_Head">
		<control type="grouplist">
			<left>64</left>
			<top>64</top>
			<width>1200</width>
			<height>26</height>
			<orientation>horizontal</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label">
				<width>auto</width>
				<height>26</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[VidInfo_Section]</label>
			</control>
			<control type="label">
				<width>auto</width>
				<height>26</height>
				<font>label_20</font>
				<textcolor>text_dim</textcolor>
				<label> / </label>
			</control>
			<control type="label">
				<width>auto</width>
				<height>26</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[VidInfo_TypeTitle]</label>
			</control>
		</control>
		<include>Orbit_Clock</include>
		<control type="grouplist">
			<left>64</left>
			<top>124</top>
			<width>1500</width>
			<height>270</height>
			<orientation>vertical</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label">
				<width>1300</width>
				<height>24</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$VAR[VidInfo_Kicker]</label>
			</control>
			<include content="Fit_Info">
				<param name="top" value="10"/>
				<param name="label" value="$VAR[VidInfo_Title]"/>
			</include>
			<control type="grouplist">
				<top>8</top>
				<width>1500</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<font>mono_20</font>
					<textcolor>text_meta</textcolor>
					<label>$INFO[ListItem.Year,,  ·  ]</label>
				</control>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<font>label_20</font>
					<textcolor>text_meta</textcolor>
					<label>$VAR[VidView_MPAA]  ·  </label>
					<visible>!String.IsEmpty(ListItem.MPAA)</visible>
				</control>
				<control type="label">
					<width max="1300">auto</width>
					<height>26</height>
					<font>label_20</font>
					<textcolor>text_meta</textcolor>
					<label>$VAR[VidInfo_MetaPeople]</label>
				</control>
			</control>
		</control>
	</include>

	<!-- ================================================================ instruments -->
	<include name="VidInfo_GaugeLabel">
		<control type="label">
			<left>-30</left>
			<top>0</top>
			<width>320</width>
			<height>24</height>
			<align>center</align>
			<font>label_20</font>
			<textcolor>text_secondary</textcolor>
			<label>$PARAM[label]</label>
		</control>
	</include>
	<include name="VidInfo_Instruments">
		<control type="group">
			<left>64</left>
			<top>410</top>
			<width>920</width>
			<height>360</height>
			<!-- rating -->
			<control type="group">
				<left>0</left>
				<top>0</top>
				<width>260</width>
				<height>360</height>
				<include content="VidInfo_GaugeLabel">
					<param name="label" value="$LOCALIZE[563]"/>
				</include>
				<control type="group">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<include content="Orbit_GaugeRating">
						<param name="S" value="260"/>
						<param name="value_font" value="mono_50"/>
					</include>
				</control>
				<control type="label">
					<left>-30</left>
					<top>314</top>
					<width>320</width>
					<height>28</height>
					<align>center</align>
					<font>mono_22</font>
					<textcolor>text_primary</textcolor>
					<label>[COLOR text_secondary]out of [/COLOR]10$INFO[ListItem.Votes,  ·  , votes]</label>
					<visible>!String.IsEmpty(ListItem.Rating)</visible>
				</control>
			</control>
			<!-- runtime clock sector -->
			<control type="group">
				<left>330</left>
				<top>0</top>
				<width>260</width>
				<height>360</height>
				<visible>Integer.IsGreater(ListItem.Duration(mins),0)</visible>
				<include content="VidInfo_GaugeLabel">
					<param name="label" value="$LOCALIZE[180]"/>
				</include>
				<control type="group">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<include content="Orbit_GaugeRuntime">
						<param name="S" value="260"/>
						<param name="c" value="130"/>
					</include>
				</control>
				<control type="label">
					<!-- 460 wide (centre 130): fits "3h 59m  ·  ends 10:14 PM" on a 12 h region -->
					<left>-100</left>
					<top>314</top>
					<width>460</width>
					<height>28</height>
					<align>center</align>
					<font>mono_22</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[VidView_Runtime]  ·  ends [COLOR accent]$VAR[VidView_Ends][/COLOR]</label>
				</control>
			</control>
			<!-- seasons (shows / seasons have no runtime): engraved count -->
			<control type="group">
				<left>330</left>
				<top>0</top>
				<width>260</width>
				<height>360</height>
				<visible>$EXP[VidView_IsTVType] | String.IsEqual(ListItem.DBType,set)</visible>
				<include content="VidInfo_GaugeLabel">
					<param name="label" value="$VAR[VidInfo_CountLabel]"/>
				</include>
				<control type="image">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<texture>$VAR[RingFaceClock260]</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>mono_50</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[VidInfo_CountValue]</label>
				</control>
				<control type="label">
					<left>-50</left>
					<top>314</top>
					<width>360</width>
					<height>28</height>
					<align>center</align>
					<font>mono_22</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[ListItem.Premiered]</label>
					<visible>$EXP[VidView_IsTVType]</visible>
				</control>
			</control>
			<!-- your progress -->
			<control type="group">
				<left>660</left>
				<top>0</top>
				<width>260</width>
				<height>360</height>
				<visible>$EXP[VidView_IsPlayable] | $EXP[VidView_IsTVType]</visible>
				<include content="VidInfo_GaugeLabel">
					<param name="label" value="Your progress"/>
				</include>
				<control type="image">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<texture>$VAR[RingFaceProgress260]</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<texture fallback="rings/progress_260/0.png">rings/progress_260/$VAR[VidView_ProgressFrame].png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>40</top>
					<width>260</width>
					<height>260</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>mono_50</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[VidView_ProgressValue]</label>
				</control>
				<control type="label">
					<left>-50</left>
					<top>314</top>
					<width>360</width>
					<height>28</height>
					<align>center</align>
					<font>mono_22</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[VidInfo_ProgressCaption]</label>
				</control>
			</control>
		</control>
	</include>
	<variable name="VidInfo_CountLabel">
		<value condition="String.IsEqual(ListItem.DBType,set)">Films</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$LOCALIZE[20360]</value>
		<value>Seasons</value>
	</variable>
	<variable name="VidInfo_CountValue">
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Property(Total)]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Property(TotalEpisodes)]</value>
		<value>$INFO[ListItem.Property(TotalSeasons)]</value>
	</variable>

	<!-- ================================================================ story -->
	<include name="VidInfo_Story">
		<control type="group">
			<left>1120</left>
			<top>410</top>
			<width>736</width>
			<height>320</height>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>736</width>
				<height>24</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[31248]</label>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>40</top>
				<width>736</width>
				<height>168</height>
				<font>text_28</font>
				<textcolor>text_body</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="3000" repeat="10000">true</autoscroll>
			</control>
			<control type="grouplist">
				<left>0</left>
				<top>236</top>
				<width>736</width>
				<height>36</height>
				<orientation>horizontal</orientation>
				<itemgap>10</itemgap>
				<include content="Orbit_Chip">
					<param name="label" value="$VAR[VidInfo_FlagRes]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoResolution)"/>
				</include>
				<include content="Orbit_Chip">
					<param name="label" value="$VAR[VidInfo_FlagHDR]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.HdrType)"/>
				</include>
				<include content="Orbit_Chip">
					<param name="label" value="$VAR[VidInfo_FlagVideo]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.VideoCodec)"/>
				</include>
				<include content="Orbit_Chip">
					<param name="label" value="$VAR[VidInfo_AudioCodec]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioCodec)"/>
				</include>
				<include content="Orbit_Chip">
					<param name="label" value="$VAR[VidInfo_AudioChannels]"/>
					<param name="visible" value="!String.IsEmpty(ListItem.AudioChannels)"/>
				</include>
			</control>
		</control>
	</include>

	<!-- ================================================================ buttons -->
	<!-- Round instrument buttons (pre-rendered btn/r96/<icon>_<n|f|p>.png: disc + icon + focus halo,
	     150x164 with the label under the disc). Plain buttons directly in grouplist 9000, so Kodi's
	     grouplist navigation and hidden-button skipping just work.
	     Kodi ids: 8 play (from the beginning when 9 exists; browses for tvshow/season/set), 9 resume
	     (enabled only with a resume point), 11 trailer. Orbit: 9013 restart (=8), 9012 browse (=8),
	     9014 similar (TMDb Helper), 9010 more (opens row 9100). -->
	<include name="VidInfo_Button">
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="state">n</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>150</width>
				<height>164</height>
				<texturefocus>btn/r96/$PARAM[icon]_f.png</texturefocus>
				<texturenofocus>btn/r96/$PARAM[icon]_$PARAM[state].png</texturenofocus>
				<label>$PARAM[label]</label>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<align>center</align>
				<aligny>top</aligny>
				<textoffsetx>0</textoffsetx>
				<textoffsety>126</textoffsety>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="VidInfo_Buttons">
		<control type="grouplist" id="9000">
			<left>37</left>
			<top>824</top>
			<width>1060</width>
			<height>164</height>
			<orientation>horizontal</orientation>
			<itemgap>0</itemgap>
			<onup>noop</onup>
			<!-- Down reaches the cast arc beside the row from any button (no walking to More) -->
			<ondown condition="Integer.IsGreater(Container(50).NumItems,0)">50</ondown>
			<ondown>noop</ondown>
			<onleft>noop</onleft>
			<onright>50</onright>
			<include content="VidInfo_Button">
				<param name="id" value="9"/>
				<param name="icon" value="play"/>
				<param name="state" value="p"/>
				<param name="label" value="Resume"/>
				<param name="visible" value="$EXP[VidInfo_ShowResume]"/>
