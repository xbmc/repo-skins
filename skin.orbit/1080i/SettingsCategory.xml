<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...) - M4, Builder E.
	Layout from mockups/Settings.dc.html: categories x96 w380, list x560 w860 (hairline rows,
	2px accent frame on focus), description in the right-hand aside x1500 w324.
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2 (Kodi writes it; shown as the page title),
	categories grouplist 3 + template 10, control area 5, description textbox 6, templates 7-15,
	level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>bg</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Orbit_PageSoft</include>
		<include content="Orbit_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$INFO[Control.GetLabel(2)]"/>
			<param name="sub" value="$LOCALIZE[5]"/>
		</include>

		<!-- ====== categories -->
		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>page_margin</left>
			<top>content_top</top>
			<width>settings_cat_w</width>
			<height>648</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="Orbit_SettingCategoryTemplate">
			<param name="width" value="settings_cat_w"/>
		</include>
		<control type="group">
			<left>page_margin</left>
			<top>880</top>
			<include content="Orbit_SettingLevelButton">
				<param name="width" value="settings_cat_w"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list -->
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>settings_list_x</left>
			<top>content_top</top>
			<width>860</width>
			<height>792</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="Orbit_SettingTemplates">
			<param name="width" value="860"/>
		</include>
		<include content="Orbit_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1440"/>
			<param name="top" value="content_top"/>
			<param name="height" value="792"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>

		<!-- ====== aside: what the focused setting does -->
		<control type="group">
			<left>1500</left>
			<top>content_top</top>
			<width>324</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>324</width>
				<height>24</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[31207]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>34</top>
				<width>324</width>
				<height>14</height>
				<aspectratio align="left" aligny="top">center</aspectratio>
				<texture>rings/ruler.png</texture>
			</control>
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>0</left>
				<top>52</top>
				<width>324</width>
				<height>612</height>  <!-- 18 lines of text_24 (34px pitch) exactly -->
				<font>text_24</font>
				<textcolor>text_secondary</textcolor>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>

		<control type="label" id="2">
			<description>section label (Kodi writes it; shown in the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
