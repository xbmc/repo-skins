<?xml version="1.0" encoding="UTF-8"?>
<!--
	Dialog building blocks (owner: Builder E · Settings + core dialogs, M4 styling pass).
	Index vocabulary: flat bg panel, 1px hairline frame, header title + rule, hairline list rows,
	focused row = bg_raised fill + 2px accent frame (inset), buttons = 1px outline at rest, accent
	fill + ink text on focus. Right-hand 720px playback panel per mockups/Tracks + AVSettings.

	Shared names other builders may use (params unchanged from M1, look restyled):
	  Orbit_GenericDialog, Orbit_DialogButton, Orbit_ListLayout, Orbit_Scrollbar,
	  Orbit_ToastFrame, Orbit_KeyboardKey, Orbit_KeyboardFunc
	Builder E's own: Dlg_* (constants dlg_*).
-->
<includes>
	<!-- ============================================================ constants -->
	<constant name="dlg_panel_x">1200</constant>          <!-- right-hand playback panel (mockups/Tracks, AVSettings) -->
	<constant name="dlg_panel_w">720</constant>
	<constant name="dlg_panel_pad">72</constant>          <!-- inner left/right padding -->
	<constant name="dlg_panel_in_w">576</constant>        <!-- 720 - 2 x 72 -->
	<constant name="dlg_panel_top">64</constant>
	<constant name="dlg_track_row_h">58</constant>
	<constant name="dlg_osd_row_h">76</constant>
	<constant name="dlg_row_pad">16</constant>            <!-- text inset inside a list row -->
	<constant name="dlg_check">22</constant>              <!-- current-item check -->
	<constant name="dlg_check_gutter">56</constant>       <!-- label x when a check column precedes it -->
	<constant name="dlg_btn_h">60</constant>

	<!-- ============================================================ expressions -->
	<!-- DialogSelect shows the right-hand track panel only over fullscreen video -->
	<expression name="Dlg_IsTrackPanel">Player.HasVideo + Window.IsActive(fullscreenvideo)</expression>
	<!-- the select list was opened from the OSD subtitle settings (subtitle stream list) -->
	<expression name="Dlg_FromSubtitleSettings">Window.IsVisible(osdsubtitlesettings)</expression>
	<!-- DialogSettings is one of the OSD playback settings dialogs -->
	<expression name="Dlg_IsOSDSettings">Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)</expression>

	<!-- ============================================================ variables -->
	<!-- Track panel kicker: "SUBTITLES · 16 TRACKS" -->
	<variable name="Dlg_SelectKicker">
		<value condition="Window.IsVisible(osdsubtitlesettings)">Subtitles$VAR[PL_Container_3_NumItems_Track]</value>
		<value condition="Window.IsVisible(osdaudiosettings)">Audio$VAR[PL_Container_3_NumItems_Track]</value>
		<value condition="Window.IsVisible(osdvideosettings)">Video$VAR[PL_Container_3_NumItems_Option]</value>
		<value condition="Control.IsVisible(6)">Select$VAR[PL_Container_6_NumItems_Item]</value>
		<value>Select$VAR[PL_Container_3_NumItems_Item]</value>
	</variable>
	<!-- Centred select: "03 / 16" in the header -->
	<variable name="Dlg_SelectPosition">
		<value condition="Control.IsVisible(6)">$INFO[Container(6).CurrentItem]$INFO[Container(6).NumItems, / ,]</value>
		<value>$INFO[Container(3).CurrentItem]$INFO[Container(3).NumItems, / ,]</value>
	</variable>
	<!-- What is playing, under the track panel: "PAUSED · 1:02:31 / 2:14:00" -->
	<variable name="Dlg_PlayState">
		<value condition="Player.Paused">Paused  ·  $INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="Dlg_PlayTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value>$INFO[VideoPlayer.Title]</value>
	</variable>

	<variable name="Dlg_AddonNewsLabel">
		<value condition="!String.IsEmpty(Window(Home).Property(orbit.addonnews))">Description</value>
		<value>What's new</value>
	</variable>

	<!-- ============================================================ texture switches -->
	<!-- (button textures can't take $VAR, so corners / outline weight are picked at window load) -->
	<include name="Dlg_Tex_DialogButton">
		<texturefocus border="22" colordiffuse="text_primary">common/pill_fill.png</texturefocus>
		<texturenofocus border="22" colordiffuse="border_button">common/pill_line.png</texturenofocus>
	</include>

	<!-- Accent frame drawn AT the control rect (stroke sits 1-3px inside), for Kodi-cloned rows -->
	<!-- Row focus for Kodi-cloned rows: raised fill + amber edge (own colours, focus/row.png) -->
	<include name="Dlg_Tex_RowFocus">
		<texturefocus border="8">focus/row.png</texturefocus>
	</include>

	<!-- Hairline under a row (texturenofocus of Kodi-cloned rows). flip = true gives a top rule. -->
	<include name="Dlg_Tex_RowRule">
		<param name="color">hairline</param>
		<param name="flip">false</param>
		<definition>
			<texturenofocus border="0,0,0,2" flipy="$PARAM[flip]" colordiffuse="$PARAM[color]">dialogs/row_rule.png</texturenofocus>
		</definition>
	</include>

	<!-- ============================================================ generic dialog -->
	<!-- Centred modal frame. Put inside a group positioned/sized like the dialog.
	     params: width, height, header_id (Kodi heading id, "" if none), header_label,
	             kicker (optional mono caption, right side of the header, accent) -->
	<!-- Centred modal frame in the instrument language: panel + fine frame, wide heading,
	     mono kicker (dim, right), engraved tick ruler under the header.
	     params: width, height, header_id (Kodi heading id, "" if none), header_label, kicker -->
	<include name="Orbit_GenericDialog">
		<param name="header_id"></param>
		<param name="header_label"></param>
		<param name="kicker"></param>
		<definition>
			<control type="image">
				<description>backdrop dim (own fades, LESSONS 4)</description>
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="dim_dialog">common/white.png</texture>
			</control>
			<control type="image">
				<description>panel</description>
				<left>0</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="10" colordiffuse="panel">common/rect_round8.png</texture>
			</control>
			<control type="image">
				<description>fine frame</description>
				<left>0</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="10" colordiffuse="line">common/rect_outline_1_round8.png</texture>
			</control>
			<control type="label" id="$PARAM[header_id]">
				<description>heading</description>
				<left>dialog_pad</left>
				<top>6</top>
				<right>260</right>
				<height>dialog_header_h</height>
				<font>wide_26</font>
				<textcolor>text_primary</textcolor>
				<label>$PARAM[header_label]</label>
			</control>
			<control type="label">
				<description>kicker</description>
				<right>dialog_pad</right>
				<top>6</top>
				<width>220</width>
				<height>dialog_header_h</height>
				<align>right</align>
				<font>mono_20</font>
				<textcolor>text_dim</textcolor>
				<label>$PARAM[kicker]</label>
			</control>
			<control type="image">
				<description>engraved ruler under the header</description>
				<left>dialog_pad</left>
				<top>dialog_header_h</top>
				<right>dialog_pad</right>
				<height>14</height>
				<aspectratio align="left" aligny="top">center</aspectratio>
				<texture>rings/ruler.png</texture>
			</control>
		</definition>
	</include>

	<!-- Dialog button: 1px outline at rest, accent fill + ink text on focus (always visible focus).
	     params: id, label, width, height, onclick, onclick2 (second action), visible -->
	<!-- No <enable>: Kodi enables/disables its own dialog buttons (5/7/8, 28-30); a skin <enable> would override it. -->
	<include name="Orbit_DialogButton">
		<param name="width">300</param>
		<param name="height">dialog_row_h</param>
		<param name="label"></param>
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<label>$PARAM[label]</label>
				<font>label_22</font>
				<textcolor>text_primary</textcolor>
				<focusedcolor>ink</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<align>center</align>
				<textoffsetx>16</textoffsetx>
				<include>Dlg_Tex_DialogButton</include>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Definition-list fact (mono field label + value), 40px pitch. params: top, label, value, valuew -->
	<include name="Dlg_FactRow">
		<param name="valuew">620</param>
		<definition>
			<control type="label">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>160</width>
				<height>28</height>
				<font>label_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$PARAM[label]</label>
			</control>
			<control type="label">
				<left>160</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[valuew]</width>
				<height>28</height>
				<font>mono_22</font>
				<textcolor>text_primary</textcolor>
				<label>$PARAM[value]</label>
			</control>
		</definition>
	</include>

	<!-- ============================================================ list rows -->
	<!-- Focused-row treatment inside a <focusedlayout>: raised fill + 2px accent frame (inset).
	     Shown only while the list has focus, so an unfocused list never looks "selected".
	     params: list_id, width, height -->
	<include name="Dlg_RowFocus">
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<texture border="8">focus/row.png</texture>
				<visible>Control.HasFocus($PARAM[list_id])</visible>
			</control>
		</definition>
	</include>

	<!-- Text list: check column (current / selected item), label, mono label2 on the right,
	     hairline under each row. params: width, height, label, label2, list_id -->
	<include name="Orbit_ListLayout">
		<param name="width">800</param>
		<param name="height">64</param>
		<param name="label">$INFO[ListItem.Label]</param>
		<param name="label2">$INFO[ListItem.Label2]</param>
		<param name="list_id">50</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="line_soft">common/hairline.png</texture>
				</control>
				<control type="image">
					<left>dlg_row_pad</left>
					<centertop>50%</centertop>
					<width>dlg_check</width>
					<height>dlg_check</height>
					<texture colordiffuse="accent">markers/check.png</texture>
					<visible>ListItem.IsSelected</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<font>label_25_semibold</font>
					<textcolor>text_secondary</textcolor>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>num_16</font>
					<textcolor>text_tertiary</textcolor>
					<label>$PARAM[label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="line_soft">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<control type="image">
					<left>dlg_row_pad</left>
					<centertop>50%</centertop>
					<width>dlg_check</width>
					<height>dlg_check</height>
					<texture colordiffuse="accent">markers/check.png</texture>
					<visible>ListItem.IsSelected</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<font>label_25_bold</font>
					<textcolor>text_primary</textcolor>
					<scroll>true</scroll>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>num_16</font>
					<textcolor>text_secondary</textcolor>
					<label>$PARAM[label2]</label>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<!-- Numbered menu list (Settings hub, System menu, power menu): mono index from
	     ListItem.Property(index) (accent on the focused row), label, mono hint (label2).
	     params: width, height, list_id -->
	<!-- Row number from the item's position among VISIBLE items (no gaps when Kodi hides items such
	     as Reboot/Power off on Android); two digits. -->
	<variable name="Dlg_RowIndex">
		<value condition="Integer.IsLess(ListItem.CurrentItem,10)">$INFO[ListItem.CurrentItem,0]</value>
		<value>$INFO[ListItem.CurrentItem]</value>
	</variable>
	<include name="Dlg_IndexListLayout">
		<param name="width">860</param>
		<param name="height">72</param>
		<param name="list_id">9000</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="line_soft">common/hairline.png</texture>
				</control>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>40</width>
					<height>$PARAM[height]</height>
					<font>mono_20</font>
					<textcolor>text_dim</textcolor>
					<label>$VAR[Dlg_RowIndex]</label>
				</control>
				<control type="label">
					<left>72</left>
					<top>0</top>
					<right>128</right>
					<height>$PARAM[height]</height>
					<font>text_26_med</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>mono_20</font>
					<textcolor>text_tertiary</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="line_soft">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<control type="label">
					<left>20</left>
					<top>0</top>
					<width>40</width>
					<height>$PARAM[height]</height>
					<font>mono_20</font>
					<textcolor>accent</textcolor>
					<label>$VAR[Dlg_RowIndex]</label>
				</control>
				<control type="label">
					<left>72</left>
					<top>0</top>
					<right>128</right>
					<height>$PARAM[height]</height>
					<font>text_26_semi</font>
					<textcolor>text_primary</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<font>mono_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<!-- Track rows (mockups/Tracks): 58px, check for the current track, name (bold when current),
	     mono meta (label2) on the right, #1c1c1c-ish divider (bg_ghost). params: list_id -->
	<include name="Dlg_TrackListLayout">
		<param name="list_id">3</param>
		<definition>
			<itemlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="bg_ghost">common/hairline.png</texture>
				</control>
				<include>Dlg_TrackRowContent</include>
			</itemlayout>
			<focusedlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="bg_ghost">common/hairline.png</texture>
				</control>
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="dlg_panel_in_w"/>
					<param name="height" value="dlg_track_row_h"/>
				</include>
				<include>Dlg_TrackRowContent</include>
			</focusedlayout>
		</definition>
	</include>
	<include name="Dlg_TrackRowContent">
		<control type="image">
			<left>dlg_row_pad</left>
			<top>19</top>
			<width>20</width>
			<height>20</height>
			<texture colordiffuse="accent">markers/check.png</texture>
			<visible>ListItem.IsSelected</visible>
		</control>
		<control type="label">
			<left>56</left>
			<top>0</top>
			<right>150</right>
			<height>dlg_track_row_h</height>
			<font>button_23_semibold</font>
			<textcolor>text_secondary</textcolor>
			<label>$INFO[ListItem.Label]</label>
			<visible>!ListItem.IsSelected</visible>
		</control>
		<control type="label">
			<left>56</left>
			<top>0</top>
			<right>150</right>
			<height>dlg_track_row_h</height>
			<font>button_23_bold</font>
			<textcolor>text_primary</textcolor>
			<label>$INFO[ListItem.Label]</label>
			<visible>ListItem.IsSelected</visible>
		</control>
		<control type="label">
			<right>dlg_row_pad</right>
			<top>0</top>
			<width>130</width>
			<height>dlg_track_row_h</height>
			<align>right</align>
			<font>mono_14</font>
			<textcolor>text_tertiary</textcolor>
			<label>$INFO[ListItem.Label2]</label>
		</control>
	</include>

	<!-- Thin scroll-position line paired with a list (2px; thumb brightens to accent when focused).
	     params: id, left, top, height, onleft, onright -->
	<include name="Orbit_Scrollbar">
		<param name="onleft">noop</param>
		<param name="onright">noop</param>
		<definition>
			<control type="scrollbar" id="$PARAM[id]">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>2</width>
				<height>$PARAM[height]</height>
				<texturesliderbackground colordiffuse="bg_ghost">common/white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="border_button">common/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="accent">common/white.png</texturesliderbarfocus>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
				<orientation>vertical</orientation>
			</control>
		</definition>
	</include>

	<!-- ============================================================ right-hand playback panel -->
	<!-- Full-screen dim over the paused frame + the 720px panel with its left hairline.
	     Place at window level (absolute coords). -->
	<include name="Dlg_SidePanelFrame">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="dim_dialog">common/white.png</texture>
		</control>
		<control type="group">
			<left>dlg_panel_x</left>
			<include content="Anim_SidePanel"><param name="offset" value="80"/></include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>dlg_panel_w</width>
				<height>screen_h</height>
				<texture colordiffuse="bg">common/white.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>rule_h</width>
				<height>screen_h</height>
				<texture colordiffuse="hairline">common/hairline_v.png</texture>
			</control>
		</control>
	</include>

	<!-- ============================================================ DialogSelect -->
	<!-- Centred select (id contract from Estuary Omega Includes_DialogSelect.xml: heading 1,
	     list 3 simple / 6 detailed, scrollbar 61, buttons 5 / 8 / 7 (cancel) in grouplist 9001). -->
	<include name="Dlg_SelectCentred">
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1120</width>
			<height>800</height>
			<include content="Orbit_GenericDialog">
				<param name="width" value="1120"/>
				<param name="height" value="800"/>
				<param name="header_id" value="1"/>
				<param name="kicker" value="$VAR[Dlg_SelectPosition]"/>
			</include>
			<control type="list" id="3">
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>768</width>
				<height>640</height>
				<onup>3</onup>
				<ondown>3</ondown>
				<onleft>9001</onleft>
				<onright>9001</onright>
				<pagecontrol>61</pagecontrol>
