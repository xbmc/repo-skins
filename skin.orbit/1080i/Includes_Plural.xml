<?xml version="1.0" encoding="UTF-8"?>
<!-- Count captions that read right at 1 ("1 season", not "1 seasons").
     Each PL_ variable: singular value at exactly 1, else the original $INFO[count,prefix, plural]. -->
<includes>
	<variable name="PL_Container_120_NumItems_Result"><!--Container(120).NumItems|| RESULTS-->
		<value condition="Integer.IsEqual(Container(120).NumItems,1)">1 RESULT</value>
		<value>$INFO[Container(120).NumItems,, RESULTS]</value>
	</variable>
	<variable name="PL_Container_3_NumItems_Track"><!--Container(3).NumItems|  ·  | tracks-->
		<value condition="Integer.IsEqual(Container(3).NumItems,1)">  ·  1 track</value>
		<value>$INFO[Container(3).NumItems,  ·  , tracks]</value>
	</variable>
	<variable name="PL_Container_3_NumItems_Option"><!--Container(3).NumItems|  ·  | options-->
		<value condition="Integer.IsEqual(Container(3).NumItems,1)">  ·  1 option</value>
		<value>$INFO[Container(3).NumItems,  ·  , options]</value>
	</variable>
	<variable name="PL_Container_6_NumItems_Item"><!--Container(6).NumItems|  ·  | items-->
		<value condition="Integer.IsEqual(Container(6).NumItems,1)">  ·  1 item</value>
		<value>$INFO[Container(6).NumItems,  ·  , items]</value>
	</variable>
	<variable name="PL_Container_3_NumItems_Item"><!--Container(3).NumItems|  ·  | items-->
		<value condition="Integer.IsEqual(Container(3).NumItems,1)">  ·  1 item</value>
		<value>$INFO[Container(3).NumItems,  ·  , items]</value>
	</variable>
	<variable name="PL_Music_ArtistsCount_Artist"><!--Window(Home).Property(Music.ArtistsCount)|| artists-->
		<value condition="Integer.IsEqual(Window(Home).Property(Music.ArtistsCount),1)">1 artist</value>
		<value>$INFO[Window(Home).Property(Music.ArtistsCount),, artists]</value>
	</variable>
	<variable name="PL_Container_9300_TotalEpisodes_Episode"><!--Container(9300).ListItem.Property(TotalEpisodes)|| episodes-->
		<value condition="Integer.IsEqual(Container(9300).ListItem.Property(TotalEpisodes),1)">1 episode</value>
		<value>$INFO[Container(9300).ListItem.Property(TotalEpisodes),, episodes]</value>
	</variable>
	<variable name="PL_Total_Film"><!--ListItem.Property(Total)|  ·  | films-->
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">  ·  1 film</value>
		<value>$INFO[ListItem.Property(Total),  ·  , films]</value>
	</variable>
	<variable name="PL_TotalEpisodes_Episode"><!--ListItem.Property(TotalEpisodes)|| episodes-->
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">1 episode</value>
		<value>$INFO[ListItem.Property(TotalEpisodes),, episodes]</value>
	</variable>
	<variable name="PL_Total_Film2"><!--ListItem.Property(Total)|| films-->
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">1 film</value>
		<value>$INFO[ListItem.Property(Total),, films]</value>
	</variable>
	<variable name="PL_TotalEpisodes_Episode2"><!--ListItem.Property(TotalEpisodes)||  episodes-->
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">1  episode</value>
		<value>$INFO[ListItem.Property(TotalEpisodes),,  episodes]</value>
	</variable>
	<variable name="PL_Container_NumItems_Item"><!--Container.NumItems|| items-->
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 item</value>
		<value>$INFO[Container.NumItems,, items]</value>
	</variable>
	<variable name="PL_Episodes_UnWatched_Episode"><!--Window(Home).Property(Episodes.UnWatched)|| episodes to go-->
		<value condition="Integer.IsEqual(Window(Home).Property(Episodes.UnWatched),1)">1 episode to go</value>
		<value>$INFO[Window(Home).Property(Episodes.UnWatched),, episodes to go]</value>
	</variable>
</includes>
