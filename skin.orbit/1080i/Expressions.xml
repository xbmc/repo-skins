<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: booleans used in more than one place. Use as $EXP[Name].
	Skin settings: docs/skin.orbit/SETTINGS.md. Rule: an empty string / unset bool = the default.
	Reminder (LESSONS 2): $EXP is NOT expanded inside <autoscroll> or window-level <visible>.
-->
<includes>
	<!-- Helpers -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting: library opens in (empty/arc = Arc, grid = Grid) -->
	<expression name="LibDefaultGrid">String.IsEqual(Skin.String(orbit.libview),grid)</expression>

	<!-- Setting: ring style (empty/full = engraved ticks + numerals, minimal = track only) -->
	<expression name="RingMinimal">String.IsEqual(Skin.String(orbit.ringstyle),minimal)</expression>

	<!-- Setting: artwork backdrop (empty/off, faint, soft). Needs TMDb Helper's blur service. -->
	<expression name="ArtBackgroundOn">[String.IsEqual(Skin.String(orbit.artbackground),faint) | String.IsEqual(Skin.String(orbit.artbackground),soft)] + System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting: trailer button on info pages -->
	<expression name="ShowTrailerButton">!Skin.HasSetting(orbit.hidetrailer)</expression>

	<!-- Setting: watched badges on posters (on unless switched off) -->
	<expression name="ShowWatchedMarkers">!Skin.HasSetting(orbit.nowatchedbadges)</expression>
	<expression name="ShowUnwatchedMarkers">!Skin.HasSetting(orbit.nowatchedbadges)</expression>

	<!-- Setting: reduce motion -->
	<expression name="ReduceMotion">Skin.HasSetting(orbit.reducemotion)</expression>

	<!-- Retired Majan settings, kept as constants so inherited conditions stay valid -->
	<expression name="IsRounded">true</expression>
	<expression name="FocusOutlineOff">false</expression>
	<expression name="FocusOutlineMedium">false</expression>
	<expression name="SpotlightRotateOff">true</expression>
	<expression name="HomeNewestDateAdded">true</expression>
	<expression name="HomeNewestRelease">false</expression>
	<expression name="HomeNewestBoth">false</expression>

	<!-- Items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>
	<expression name="ListItemHasRating">!String.IsEmpty(ListItem.Rating) + !String.IsEqual(ListItem.Rating,0.0)</expression>
	<expression name="ListItemHasRuntime">Integer.IsGreater(ListItem.Duration(mins),0)</expression>

	<!-- Windows -->
	<expression name="InfoDialogActive">Window.IsVisible(movieinformation) | Window.IsVisible(musicinformation) | Window.IsVisible(addoninformation)</expression>
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>
</includes>
