<?xml version="1.0" encoding="UTF-8"?>
<!--
	First-run view reset (0.9.1). Kodi stores the chosen view per folder; folders visited under Majan
	kept Majan view ids that mean other views in Orbit. Each timer fires once per content type, the
	first time Orbit shows that content (persistent Skin.HasSetting(orbit.vreset.<type>)), and sets the
	intended default: films / shows / sets / seasons / music videos / albums / artists open on the arc
	(or the grid with Skin settings > Library opens in = Grid; changing that setting re-arms these),
	episodes on the episodes dial list, songs / genres / files on the dial list. After that, whatever
	view you pick sticks (Kodi remembers it per folder).
-->
<timers>
	<timer>
		<name>orbit_view_movies</name>
		<start>Window.IsActive(videos) + Container.Content(movies) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.movies)</start>
		<stop>Skin.HasSetting(orbit.vreset.movies) | !Window.IsActive(videos)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(501)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(500)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.movies)</onstart>
	</timer>
	<timer>
		<name>orbit_view_tvshows</name>
		<start>Window.IsActive(videos) + Container.Content(tvshows) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.tvshows)</start>
		<stop>Skin.HasSetting(orbit.vreset.tvshows) | !Window.IsActive(videos)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(501)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(500)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.tvshows)</onstart>
	</timer>
	<timer>
		<name>orbit_view_sets</name>
		<start>Window.IsActive(videos) + Container.Content(sets) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.sets)</start>
		<stop>Skin.HasSetting(orbit.vreset.sets) | !Window.IsActive(videos)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(501)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(500)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.sets)</onstart>
	</timer>
	<timer>
		<name>orbit_view_musicvideos</name>
		<start>Window.IsActive(videos) + Container.Content(musicvideos) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.musicvideos)</start>
		<stop>Skin.HasSetting(orbit.vreset.musicvideos) | !Window.IsActive(videos)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(501)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(500)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.musicvideos)</onstart>
	</timer>
	<timer>
		<name>orbit_view_seasons</name>
		<start>Window.IsActive(videos) + Container.Content(seasons) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.seasons)</start>
		<stop>Skin.HasSetting(orbit.vreset.seasons) | !Window.IsActive(videos)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(501)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(500)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.seasons)</onstart>
	</timer>
	<timer>
		<name>orbit_view_episodes</name>
		<start>Window.IsActive(videos) + Container.Content(episodes) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.episodes)</start>
		<stop>Skin.HasSetting(orbit.vreset.episodes) | !Window.IsActive(videos)</stop>
		<onstart>Container.SetViewMode(502)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.episodes)</onstart>
	</timer>
	<timer>
		<name>orbit_view_files</name>
		<start>Window.IsActive(videos) + Container.Content(files) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.files)</start>
		<stop>Skin.HasSetting(orbit.vreset.files) | !Window.IsActive(videos)</stop>
		<onstart>Container.SetViewMode(50)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.files)</onstart>
	</timer>
	<timer>
		<name>orbit_view_albums</name>
		<start>Window.IsActive(music) + Container.Content(albums) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.albums)</start>
		<stop>Skin.HasSetting(orbit.vreset.albums) | !Window.IsActive(music)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(505)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(504)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.albums)</onstart>
	</timer>
	<timer>
		<name>orbit_view_artists</name>
		<start>Window.IsActive(music) + Container.Content(artists) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.artists)</start>
		<stop>Skin.HasSetting(orbit.vreset.artists) | !Window.IsActive(music)</stop>
		<onstart condition="String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(505)</onstart>
		<onstart condition="!String.IsEqual(Skin.String(orbit.libview),grid)">Container.SetViewMode(504)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.artists)</onstart>
	</timer>
	<timer>
		<name>orbit_view_songs</name>
		<start>Window.IsActive(music) + Container.Content(songs) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.songs)</start>
		<stop>Skin.HasSetting(orbit.vreset.songs) | !Window.IsActive(music)</stop>
		<onstart>Container.SetViewMode(50)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.songs)</onstart>
	</timer>
	<timer>
		<name>orbit_view_genres</name>
		<start>Window.IsActive(music) + Container.Content(genres) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.genres)</start>
		<stop>Skin.HasSetting(orbit.vreset.genres) | !Window.IsActive(music)</stop>
		<onstart>Container.SetViewMode(50)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.genres)</onstart>
	</timer>
	<!-- 0.9.19: video genres / years / tags. Grid 501 (type icon) is offered there now, so a path Orbit never saved a
	     view for can open in Grid through another skin's icon-typed row (Kodi borrows any skin's row, then matches by
	     type; bench 2026-10-28). Once, on the first visit, put such a folder back on its old default, the list. -->
	<timer>
		<name>orbit_view_videogenres</name>
		<start>Window.IsActive(videos) + Container.Content(genres) + !Container.IsUpdating + Integer.IsGreater(Container.NumItems,0) + !Skin.HasSetting(orbit.vreset.videogenres)</start>
		<stop>Skin.HasSetting(orbit.vreset.videogenres) | !Window.IsActive(videos)</stop>
		<onstart condition="Control.IsVisible(501)">Container.SetViewMode(50)</onstart>
		<onstart>Skin.SetBool(orbit.vreset.videogenres)</onstart>
	</timer>
</timers>
