<?xml version="1.0" encoding="UTF-8"?>
<!--
	Orbit System menu (custom dialog 1151, M4, Builder E) - Home's gear (SPEC 4 / Decision 2), the
	escape hatch. Drops down under the top-bar rule next to the gear (menu_x_gear 865): Skin settings,
	Settings, File manager, System info, Add-ons, then Power: Exit / Reboot / Power off / Power menu.
	0.9.9: Update library / Clean library (Library panel 1160 with orbit.libmode = update / clean:
	choose Movies and TV shows or Music; Clean asks first).
	Numbered Index list (Dlg_IndexListLayout). Back closes. No Kodi-owned ids.
-->
<window type="dialog" id="1151">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="image">
			<description>backdrop dim (lighter than a modal: the page stays readable)</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="dim_dialog">common/white.png</texture>
		</control>
		<control type="group">
			<left>840</left>
			<top>below_bar_top</top>
			<width>600</width>
			<height>892</height>
			<!-- panel sized to the visible items (power entries depend on the platform) -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>476</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>!Integer.IsGreater(Container(100).NumItems,6)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>544</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,7)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>612</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,8)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>680</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,9)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>748</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,10)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>816</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsEqual(Container(100).NumItems,11)</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>600</width>
				<height>884</height>
				<texture border="2">dialogs/panel_framed.png</texture>
				<visible>Integer.IsGreaterOrEqual(Container(100).NumItems,12)</visible>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>552</width>
				<height>56</height>
				<font>mono_13</font>
				<textcolor>accent</textcolor>
				<label>$LOCALIZE[31020]</label>
			</control>
			<control type="label">
				<left>24</left>
				<top>0</top>
				<width>552</width>
				<height>56</height>
				<align>right</align>
				<font>num_14</font>
				<textcolor>text_tertiary</textcolor>
				<label>$INFO[System.Time(hh:mm)]$INFO[System.Date(DDD d MMM),  ·  ,]</label>
			</control>
			<control type="list" id="100">
				<left>12</left>
				<top>56</top>
				<width>576</width>
				<height>824</height>
				<onup>100</onup>
				<ondown>100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="576"/>
					<param name="height" value="68"/>
					<param name="list_id" value="100"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[31021]</label>
						<label2>$LOCALIZE[31024]</label2>
						<property name="index">[UPPERCASE]01[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(skinsettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[5]</label>
						<label2>Kodi</label2>
						<property name="index">[UPPERCASE]02[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(settings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[10003]</label>
						<property name="index">[UPPERCASE]03[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(filemanager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[138]</label>
						<property name="index">[UPPERCASE]04[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(systeminfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<property name="index">[UPPERCASE]05[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(addonbrowser)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31200]</label>
						<label2>$LOCALIZE[31201]</label2>
						<property name="index">[UPPERCASE]06[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(TVChannels)</onclick>
						<visible>System.HasPVRAddon</visible>
					</item>
					<item>
						<label>$LOCALIZE[1]</label>
						<label2>$LOCALIZE[31201]</label2>
						<property name="index">[UPPERCASE]07[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(Pictures)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[744]</label>
						<label2>$LOCALIZE[31201]</label2>
						<property name="index">[UPPERCASE]08[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(Videos,sources://video/,return)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31202]</label>
						<label2>$LOCALIZE[31203]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>SetProperty(orbit.libmode,update,home)</onclick>
						<onclick>ActivateWindow(1160)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31204]</label>
						<label2>$LOCALIZE[31203]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>SetProperty(orbit.libmode,clean,home)</onclick>
						<onclick>ActivateWindow(1160)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13012]</label>
						<label2>$LOCALIZE[31022]</label2>
						<property name="index">[UPPERCASE]09[/UPPERCASE]</property>
						<onclick>Quit()</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<item>
						<label>$LOCALIZE[13013]</label>
						<label2>$LOCALIZE[31022]</label2>
						<property name="index">[UPPERCASE]10[/UPPERCASE]</property>
						<onclick>Reset()</onclick>
						<visible>System.CanReboot</visible>
					</item>
					<item>
						<label>$LOCALIZE[13016]</label>
						<label2>$LOCALIZE[31022]</label2>
						<property name="index">[UPPERCASE]11[/UPPERCASE]</property>
						<onclick>Powerdown()</onclick>
						<visible>System.CanPowerDown</visible>
					</item>
					<item>
						<label>$LOCALIZE[31022]</label>
						<label2>$LOCALIZE[31205]</label2>
						<property name="index">[UPPERCASE]12[/UPPERCASE]</property>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(shutdownmenu)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
