<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings pieces (owner: Builder E). Used by Settings.xml, SettingsCategory.xml, DialogSettings.xml,
	DialogAddonSettings.xml and SkinSettings.xml.

	Kodi-cloned rows (templates 7-15, category 10): Kodi builds each setting as ONE control, so the
	row look lives in its textures: <texturenofocus> = 1px hairline at the bottom (media/dialogs/
	row_rule.png), <texturefocus> = 2px accent frame drawn inside the row. Kodi gives label and value
	the same font/colour, so the value column can't be mono here (SkinSettings, which Orbit draws
	itself, does use mono/segmented values). Id plans copied from Estuary Omega.
-->
<includes>
	<!-- ============================================================ Kodi-cloned templates -->
	<!-- Look of one setting row. params: width, height, font -->
	<include name="Orbit_SettingRow">
		<param name="width">1264</param>
		<param name="height">settings_row_h</param>
		<param name="font">text_26_med</param>
		<definition>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<font>$PARAM[font]</font>
			<textcolor>text_secondary</textcolor>
			<focusedcolor>text_primary</focusedcolor>
			<disabledcolor>disabled</disabledcolor>
			<invalidcolor>accent_signal</invalidcolor>
			<selectedcolor>text_primary</selectedcolor>
			<textoffsetx>20</textoffsetx>
			<aligny>center</aligny>
			<pulseonselect>false</pulseonselect>
			<include>Dlg_Tex_RowFocus</include>
			<include content="Dlg_Tex_RowRule"/>
		</definition>
	</include>

	<!-- The full template set (ids 7 button, 8 radio, 9 spin, 11 separator, 12 edit, 13 slider,
	     14 group heading, 15 colour). params: width, height, font -->
	<include name="Orbit_SettingTemplates">
		<param name="width">1264</param>
		<param name="height">settings_row_h</param>
		<param name="font">text_26_med</param>
		<definition>
			<control type="button" id="7">
				<description>Default Button</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="radiobutton" id="8">
				<description>Default RadioButton</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<radiowidth>24</radiowidth>
				<radioheight>24</radioheight>
			</control>
			<control type="spincontrolex" id="9">
				<description>Default SpinControlex</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="image" id="11">
				<description>separator</description>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="line">common/hairline.png</texture>
			</control>
			<control type="edit" id="12">
				<description>Default Edit</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
			<control type="sliderex" id="13">
				<description>Default Slider</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<sliderwidth>200</sliderwidth>
				<sliderheight>4</sliderheight>
			</control>
			<control type="label" id="14">
				<description>Default Label (group heading)</description>
				<width>$PARAM[width]</width>
				<height>56</height>
				<textoffsetx>20</textoffsetx>
				<font>mono_14</font>
				<textcolor>accent</textcolor>
				<aligny>center</aligny>
			</control>
			<control type="colorbutton" id="15">
				<description>Default ColorButton</description>
				<include content="Orbit_SettingRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- Category button template (id 10): Settings.dc.html categories - hairline on top, 28px label,
	     tertiary at rest, primary + accent frame on focus. param: width -->
	<include name="Orbit_SettingCategoryTemplate">
		<param name="width">380</param>
		<definition>
			<control type="button" id="10">
				<description>Default Category Button</description>
				<width>$PARAM[width]</width>
				<height>72</height>
				<font>text_30_med</font>
				<textcolor>text_secondary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<selectedcolor>text_primary</selectedcolor>
				<disabledcolor>disabled</disabledcolor>
				<textoffsetx>20</textoffsetx>
				<aligny>center</aligny>
				<pulseonselect>false</pulseonselect>
				<include>Dlg_Tex_RowFocus</include>
				<texturenofocus />
			</control>
		</definition>
	</include>

	<!-- Settings level toggle (id 20: Basic / Standard / Advanced / Expert, Kodi writes the label).
	     params: width, onup, ondown, onleft, onright -->
	<include name="Orbit_SettingLevelButton">
		<param name="width">380</param>
		<param name="onup">3</param>
		<param name="ondown">3</param>
		<param name="onleft">5</param>
		<param name="onright">5</param>
		<definition>
			<control type="button" id="20">
				<width>$PARAM[width]</width>
				<height>56</height>
				<font>mono_14</font>
				<textcolor>text_tertiary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<textoffsetx>20</textoffsetx>
				<aligny>center</aligny>
				<pulseonselect>false</pulseonselect>
				<include>Dlg_Tex_RowFocus</include>
				<include content="Dlg_Tex_RowRule"><param name="flip" value="true"/></include>
				<onclick>SettingsLevelChange</onclick>
				<onup>$PARAM[onup]</onup>
				<ondown>$PARAM[ondown]</ondown>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
			</control>
		</definition>
	</include>

	<!-- ============================================================ DialogSettings layouts -->
	<!-- Centred dialog (lock settings, content settings, PVR timers, profiles, sources ...).
	     Ids (Estuary Omega): heading 2, control area 5, templates 7-15, scrollbar 60,
	     buttons 28 / 29 / 30 in grouplist 9000 (Kodi labels/hides them). -->
	<include name="Dlg_SettingsCentred">
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1280</width>
			<height>880</height>
			<visible>!Window.IsVisible(sliderdialog)</visible>
			<include>Anim_FadeVisible</include>
			<include content="Orbit_GenericDialog">
				<param name="width" value="1280"/>
				<param name="height" value="880"/>
				<param name="header_id" value="2"/>
			</include>
			<control type="grouplist" id="5">
				<description>control area</description>
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>920</width>
				<height>744</height>
				<itemgap>0</itemgap>
				<pagecontrol>60</pagecontrol>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<onup>5</onup>
				<ondown>5</ondown>
			</control>
			<include content="Orbit_SettingTemplates">
				<param name="width" value="920"/>
			</include>
			<include content="Orbit_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="956"/>
				<param name="top" value="dialog_content_top"/>
				<param name="height" value="744"/>
				<param name="onleft" value="5"/>
				<param name="onright" value="9000"/>
			</include>
			<control type="grouplist" id="9000">
				<left>976</left>
				<top>dialog_content_top</top>
				<width>280</width>
				<height>300</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>5</onleft>
				<onright>5</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<include content="Orbit_DialogButton"><param name="id" value="28"/><param name="width" value="280"/></include>
				<include content="Orbit_DialogButton"><param name="id" value="29"/><param name="width" value="280"/></include>
				<include content="Orbit_DialogButton"><param name="id" value="30"/><param name="width" value="280"/></include>
			</control>
		</control>
	</include>

	<!-- OSD playback settings (osdaudiosettings / osdsubtitlesettings / osdvideosettings / osdcmssettings),
	     mockups/AVSettings: 720px right-hand panel, AUDIO / SUBTITLES / VIDEO tabs (9101-9103) that
	     close this dialog and open the sibling. Hidden while the offset slider is up (Decision 10). -->
	<include name="Dlg_SettingsPanel">
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>screen_w</width>
				<height>screen_h</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="dim_dialog">common/white.png</texture>
			</control>
			<control type="group">
				<left>dlg_panel_x</left>
				<!-- slide in on a fresh open, appear instantly when a tab swaps the dialog -->
				<include content="Anim_SidePanel" condition="String.IsEmpty(Window(Home).Property(orbit.osdtab))"><param name="offset" value="80"/></include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>dlg_panel_w</width>
					<height>screen_h</height>
					<texture colordiffuse="bg">common/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>rule_h</width>
					<height>screen_h</height>
					<texture colordiffuse="hairline">common/hairline_v.png</texture>
				</control>
				<!-- tabs -->
				<control type="group">
					<top>dlg_panel_top</top>
					<include content="Dlg_OSDTab">
						<param name="id" value="9101"/>
						<param name="onleft" value="noop"/>
						<param name="onright" value="9102"/>
						<param name="uwidth" value="55"/>
						<param name="target" value="osdaudiosettings"/>
						<param name="left" value="62"/>
						<param name="width" value="75"/>
						<param name="label" value="Audio"/>
						<param name="current" value="Window.IsActive(osdaudiosettings)"/>
					</include>
					<include content="Dlg_OSDTab">
						<param name="id" value="9102"/>
						<param name="onleft" value="9101"/>
						<param name="onright" value="9103"/>
						<param name="uwidth" value="99"/>
						<param name="target" value="osdsubtitlesettings"/>
						<param name="left" value="149"/>
						<param name="width" value="119"/>
						<param name="label" value="Subtitles"/>
						<param name="current" value="Window.IsActive(osdsubtitlesettings)"/>
					</include>
					<include content="Dlg_OSDTab">
						<param name="id" value="9103"/>
						<param name="onleft" value="9102"/>
						<param name="onright" value="noop"/>
						<param name="uwidth" value="55"/>
						<param name="target" value="osdvideosettings"/>
						<param name="left" value="280"/>
						<param name="width" value="75"/>
						<param name="label" value="Video"/>
						<param name="current" value="Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)"/>
					</include>
				</control>
				<control type="label" id="2">
					<description>heading (Kodi: Audio settings / Subtitle settings / Video settings)</description>
					<left>dlg_panel_pad</left>
					<top>128</top>
					<width>dlg_panel_in_w</width>
					<height>56</height>
					<font>font45_title</font>
					<textcolor>text_primary</textcolor>
				</control>
				<control type="image">
					<left>dlg_panel_pad</left>
					<top>208</top>
					<width>dlg_panel_in_w</width>
					<height>rule_h</height>
					<texture colordiffuse="hairline">common/hairline.png</texture>
				</control>
				<control type="grouplist" id="5">
					<description>control area</description>
					<left>dlg_panel_pad</left>
					<top>209</top>
					<width>dlg_panel_in_w</width>
					<height>608</height>
					<itemgap>0</itemgap>
					<pagecontrol>60</pagecontrol>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onup condition="Window.IsActive(osdaudiosettings)">9101</onup>
					<onup condition="Window.IsActive(osdsubtitlesettings)">9102</onup>
					<onup condition="Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)">9103</onup>
					<ondown condition="Control.IsVisible(28) | Control.IsVisible(29) | Control.IsVisible(30)">9000</ondown>
					<ondown condition="!Control.IsVisible(28) + !Control.IsVisible(29) + !Control.IsVisible(30)">5</ondown>
				</control>
				<include content="Orbit_SettingTemplates">
					<param name="width" value="dlg_panel_in_w"/>
					<param name="height" value="dlg_osd_row_h"/>
					<param name="font" value="button_23_semibold"/>
				</include>
				<control type="scrollbar" id="60">
					<left>646</left>
					<top>209</top>
					<width>2</width>
					<height>608</height>
					<texturesliderbackground colordiffuse="bg_ghost">common/white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="border_button">common/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="border_button">common/white.png</texturesliderbarfocus>
					<orientation>vertical</orientation>
				</control>
				<control type="grouplist" id="9000">
					<left>dlg_panel_pad</left>
					<top>852</top>
					<width>dlg_panel_in_w</width>
					<height>dlg_btn_h</height>
					<orientation>horizontal</orientation>
					<itemgap>14</itemgap>
					<onleft>9000</onleft>
					<onright>9000</onright>
					<onup>5</onup>
					<ondown>5</ondown>
					<include content="Orbit_DialogButton"><param name="id" value="28"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
					<include content="Orbit_DialogButton"><param name="id" value="29"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
					<include content="Orbit_DialogButton"><param name="id" value="30"/><param name="width" value="181"/><param name="height" value="dlg_btn_h"/></include>
				</control>
				<control type="textbox">
					<left>dlg_panel_pad</left>
					<top>940</top>
					<width>dlg_panel_in_w</width>
					<height>84</height>
					<font>small_19</font>
					<textcolor>text_tertiary</textcolor>
					<label>$LOCALIZE[31247]</label>
					<visible>Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings)</visible>
				</control>
			</control>
		</control>
	</include>

	<!-- One OSD tab: mono label, 2px accent underline on the current tab, accent fill + ink on focus.
	     Clicking a non-current tab closes whichever OSD settings dialog is open (only the current one
	     is) and opens the target; orbit.osdtab suppresses the slide so the swap reads as a tab change.
	     params: id, left, width, uwidth (underline = text width), label, current (condition), target,
	     onleft, onright -->
	<include name="Dlg_OSDTab">
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>0</top>
				<width>$PARAM[width]</width>
				<height>40</height>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>40</height>
					<label>$PARAM[label]</label>
					<font>mono_15</font>
					<textcolor>text_secondary</textcolor>
					<focusedcolor>ink</focusedcolor>
					<align>center</align>
					<textoffsetx>0</textoffsetx>
					<pulseonselect>false</pulseonselect>
					<texturefocus border="20" colordiffuse="text_primary">common/pill_fill.png</texturefocus>
					<texturenofocus />
					<onleft>$PARAM[onleft]</onleft>
					<onright>$PARAM[onright]</onright>
					<onup>noop</onup>
					<ondown>5</ondown>
					<onclick condition="!Window.IsActive($PARAM[target])">SetProperty(orbit.osdtab,1,home)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdaudiosettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdsubtitlesettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdvideosettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">Dialog.Close(osdcmssettings,true)</onclick>
					<onclick condition="!Window.IsActive($PARAM[target])">ActivateWindow($PARAM[target])</onclick>
				</control>
				<!-- current tab: primary text over the secondary one + underline -->
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>40</height>
					<align>center</align>
					<font>mono_15</font>
					<textcolor>text_primary</textcolor>
					<label>$PARAM[label]</label>
					<visible>[$PARAM[current]] + !Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="image">
					<left>10</left>
					<top>38</top>
					<width>$PARAM[uwidth]</width>
					<height>2</height>
					<texture colordiffuse="accent">common/white.png</texture>
					<visible>[$PARAM[current]] + !Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- ============================================================ SkinSettings pieces -->





	<!-- ============================================================ SkinSettings expressions -->
	<expression name="Dlg_AccentSignal">String.IsEmpty(Skin.String(orbit.accent)) | String.IsEqual(Skin.String(orbit.accent),signal) | [!String.IsEqual(Skin.String(orbit.accent),cobalt) + !String.IsEqual(Skin.String(orbit.accent),mint) + !String.IsEqual(Skin.String(orbit.accent),amber) + !String.IsEqual(Skin.String(orbit.accent),rose) + !String.IsEqual(Skin.String(orbit.accent),ice) + !String.IsEqual(Skin.String(orbit.accent),bone)]</expression>
	<expression name="Dlg_OutlineThin">!String.IsEqual(Skin.String(orbit.focusoutline),medium) + !String.IsEqual(Skin.String(orbit.focusoutline),off)</expression>
	<expression name="Dlg_ArtOff">!System.AddonIsEnabled(plugin.video.themoviedb.helper) | String.IsEqual(Skin.String(orbit.artbackground),off)</expression>
	<expression name="Dlg_ArtFaint">System.AddonIsEnabled(plugin.video.themoviedb.helper) + [String.IsEmpty(Skin.String(orbit.artbackground)) | String.IsEqual(Skin.String(orbit.artbackground),faint)]</expression>
	<expression name="Dlg_ArtSoft">System.AddonIsEnabled(plugin.video.themoviedb.helper) + String.IsEqual(Skin.String(orbit.artbackground),soft)</expression>
	<expression name="Dlg_ArtVisible">System.AddonIsEnabled(plugin.video.themoviedb.helper) + String.IsEqual(Skin.String(orbit.artbackground),visible)</expression>
	<expression name="Dlg_WatchedBoth">String.IsEmpty(Skin.String(orbit.watchedmarkers)) | String.IsEqual(Skin.String(orbit.watchedmarkers),both)</expression>
	<expression name="Dlg_OffsetBottom">String.IsEqual(Skin.String(orbit.offsetbar),bottom)</expression>
	<expression name="Dlg_NewestAdded">!String.IsEqual(Skin.String(orbit.home.newest),release) + !String.IsEqual(Skin.String(orbit.home.newest),both)</expression>
	<expression name="Dlg_OSDHide5">!String.IsEqual(Skin.String(orbit.osdhide),off) + !String.IsEqual(Skin.String(orbit.osdhide),3) + !String.IsEqual(Skin.String(orbit.osdhide),10)</expression>
	<expression name="Dlg_Rotate15">!String.IsEqual(Skin.String(orbit.spotlightrotate),off) + !String.IsEqual(Skin.String(orbit.spotlightrotate),8) + !String.IsEqual(Skin.String(orbit.spotlightrotate),30)</expression>

	<!-- ============================================================ SkinSettings labels -->
	<!-- ============================================================ Orbit skin settings row -->
	<!-- One setting: label left, value (amber) right via label2; Left = previous, Right / OK = next.
	     params: id, label, value, next, prev, also/also2/also3 (extra actions), enable -->
	<!-- 0.9.12 custom rows: the Set_Row look; OK opens the row's options. params: id, row (1-3), label -->
	<include name="Set_CustomRow">
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>1000</width>
				<height>80</height>
				<font>text_26_med</font>
				<textcolor>text_secondary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<textoffsetx>28</textoffsetx>
				<texturefocus border="8">focus/row.png</texturefocus>
				<texturenofocus border="0,0,0,2" colordiffuse="line_soft">dialogs/row_rule.png</texturenofocus>
				<label>$PARAM[label]</label>
				<label2>[COLOR accent]$VAR[CustomRow_Value$PARAM[row]][/COLOR]</label2>
				<include content="CustomRows_SettingsClick"><param name="row" value="$PARAM[row]"/><param name="heading" value="$PARAM[label]"/></include>
			</control>
		</definition>
	</include>
	<!-- 0.9.18 custom menu item n (Includes_CustomMenu.xml): the same row as a custom row -->
	<include name="Set_CustomMenu">
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>1000</width>
				<height>80</height>
				<font>text_26_med</font>
				<textcolor>text_secondary</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<disabledcolor>disabled</disabledcolor>
				<textoffsetx>28</textoffsetx>
				<texturefocus border="8">focus/row.png</texturefocus>
				<texturenofocus border="0,0,0,2" colordiffuse="line_soft">dialogs/row_rule.png</texturenofocus>
				<label>$PARAM[label]</label>
				<label2>[COLOR accent]$VAR[CustomMenu_Value$PARAM[item]][/COLOR]</label2>
				<include content="CustomMenu_SettingsClick"><param name="item" value="$PARAM[item]"/><param name="heading" value="$PARAM[label]"/></include>
			</control>
		</definition>
	</include>
	<include name="Set_Row">
		<param name="also">noop</param>
		<param name="also2">noop</param>
		<param name="also3">noop</param>
		<param name="also4">noop</param>
		<param name="also5">noop</param>
		<param name="enable">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>1000</width>
