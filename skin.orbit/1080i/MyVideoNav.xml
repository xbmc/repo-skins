<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library (OrbitArc.dc.html). Includes: Includes_Views_Video.xml (VidView_*), View_50_List
	(Includes_Views.xml), the arc mechanics (Includes_Arc.xml).

	Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav): <views> containers
	500 (arc), 501 (grid), 502 (episodes), 503 (horizon), 506 (tiles), 50 (dial list); menucontrol 9000 (option bar, bottom left);
	3 sort-by / 4 sort-order hidden buttons; 14 watched toggle (SendClick only); defaultcontrol 50 =
	Kodi focuses the active view (any view id is redirected to the current view).

	Focus map: view (Up/Down turns the arc / dial list, grid moves freely) -Left-> option bar
	-Up/Right/Back-> view. Back on a view = Kodi parent folder.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>500,501,502,503,506,50</views>
	<onload condition="$EXP[ArtBackgroundOn]">SetProperty(TMDbHelper.Blur.SourceImage,Art(fanart)|Art(tvshow.fanart)|Art(poster)|Art(tvshow.poster)|Art(thumb),Home)</onload>
	<!-- empty folder: Kodi can't focus an empty view, so land on the option bar instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<!-- fit-to-width probes for the wide titles (Includes_Titles.xml) -->
		<include content="Fit_LibArc_Probes">
			<param name="label" value="$VAR[VidView_ItemTitle]"/>
		</include>
		<include>VidView_Window</include>
	</controls>
</window>
