<?xml version="1.0" encoding="UTF-8"?>
<!--
	Smart playlist editor (SPEC 5: Minimal, Orbit_GenericDialog). Builder F, M4.
	Kodi id contract (Estuary Omega SmartPlaylistEditor.xml / GUIDialogSmartPlaylistEditor):
	heading 2; options in grouplist 500: 22 type, 12 name, 16 match, 17 limit, 18 order by,
	19 order direction, 23 group by, 24 mixed (radio) - Kodi writes the values as label2;
	rules list 10 (Kodi adds the "new rule" item); buttons 20 OK / 21 cancel in grouplist 9001.
-->
<window>
	<defaultcontrol always="true">22</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1740</width>
			<height>820</height>
			<include content="Orbit_GenericDialog">
				<param name="width" value="1740"/>
				<param name="height" value="820"/>
				<param name="header_id" value="2"/>
				<param name="header_label" value="Smart playlist"/>
			</include>
			<control type="grouplist" id="500">
				<left>dialog_pad</left>
				<top>dialog_content_top</top>
				<width>700</width>
				<height>680</height>
				<orientation>vertical</orientation>
				<onleft>9001</onleft>
				<onright>10</onright>
				<onup>500</onup>
				<ondown>500</ondown>
				<control type="button" id="22">
					<description>Playlist type</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[467]</label>
				</control>
				<control type="button" id="12">
					<description>Name</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[21433]</label>
				</control>
				<control type="label" id="1101">
					<description>Rules caption</description>
					<width>700</width>
					<height>52</height>
					<textoffsetx>24</textoffsetx>
					<font>mono_14</font>
					<textcolor>accent</textcolor>
					<label>$LOCALIZE[31277]</label>
				</control>
				<control type="button" id="16">
					<description>Match</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[21424]</label>
				</control>
				<control type="button" id="17">
					<description>Limit</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[21427]</label>
				</control>
				<control type="button" id="18">
					<description>Order by</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[21429]</label>
				</control>
				<control type="button" id="19">
					<description>Order direction</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[31278]</label>
				</control>
				<control type="button" id="23">
					<description>Group by</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[21458]</label>
				</control>
				<control type="radiobutton" id="24">
					<description>Mixed</description>
					<include content="Misc_RowLook"><param name="width" value="700"/></include>
					<label>$LOCALIZE[467]: $LOCALIZE[21459]</label>
				</control>
			</control>
			<include content="Misc_Caption">
				<param name="left" value="780"/>
				<param name="top" value="dialog_content_top"/>
				<param name="width" value="600"/>
				<param name="label" value="Rules"/>
			</include>
			<control type="list" id="10">
				<description>Rules</description>
				<left>780</left>
				<top>156</top>
				<width>600</width>
				<height>512</height>
				<onup>10</onup>
				<ondown>10</ondown>
				<onleft>500</onleft>
				<onright>9001</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<orientation>vertical</orientation>
				<include content="Misc_SimpleListLayouts">
					<param name="width" value="600"/>
					<param name="list_id" value="10"/>
				</include>
			</control>
			<control type="textbox">
				<left>780</left>
				<top>684</top>
				<width>600</width>
				<height>89</height>  <!-- 3 lines exactly: no half-clipped line at the bottom -->
				<font>small_19</font>
				<textcolor>text_tertiary</textcolor>
				<label>$LOCALIZE[31279]</label>
			</control>
			<control type="grouplist" id="9001">
				<left>1420</left>
				<top>dialog_content_top</top>
				<width>280</width>
				<height>300</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>10</onleft>
				<onright>500</onright>
				<onup>9001</onup>
				<ondown>9001</ondown>
				<include content="Orbit_DialogButton">
					<param name="id" value="20"/>
					<param name="width" value="280"/>
					<param name="label" value="$LOCALIZE[186]"/>
				</include>
				<include content="Orbit_DialogButton">
					<param name="id" value="21"/>
					<param name="width" value="280"/>
					<param name="label" value="$LOCALIZE[222]"/>
				</include>
			</control>
		</control>
	</controls>
</window>
