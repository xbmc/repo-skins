<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information = the instrument panel (OrbitInfo.dc.html). Movie, episode, show, season,
	collection and music video share the page; texts and gauges switch on ListItem.DBType
	(Includes_VideoInfo.xml).

	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo):
	  8 play (plays from the beginning when 9 exists; browses for tvshow/season/set)
	  9 resume (enabled by Kodi only with a resume point) | 11 play trailer | 50 cast list
	  (collections: the films of the set; OK on a film re-opens the dialog with it)
	  6 refresh | 7 user rating | 10 choose art | 12 choose fanart | 13 director search
	  14 manage versions | 15 manage extras | 443 go to collection (Estuary convention).
	Orbit ids: 9000 round-button row (default focus), 9010 More, 9012 Browse / 9013 From start
	  (both re-send 8), 9014 Similar (TMDb Helper), 9100 More row, 9200 full-story overlay, 61 its
	  scrollbar.

	Focus map: buttons (Left/Right) -Right from More or Down from any button-> cast arc 50 (Left/Right turns it, Up/Back
	  return). More -> row 9100 (Down / Back return to More). Back closes the dialog.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<!-- fit-to-width probes for the wide titles (Includes_Titles.xml) -->
		<include content="Fit_Info_Probes">
			<param name="label" value="$VAR[VidInfo_Title]"/>
		</include>
		<include>Orbit_Background</include>
		<include>VidInfo_Backdrop</include>
		<include>VidInfo_Head</include>
		<include>VidInfo_Instruments</include>
		<include>VidInfo_Story</include>
		<include>VidInfo_Buttons</include>
		<include>VidInfo_Cast</include>
		<include>VidInfo_MoreRow</include>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
