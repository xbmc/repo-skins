		<value condition="!$EXP[Search_HasEncoded]">$LOCALIZE[31013]</value>
		<value condition="$EXP[Search_KFilms] + Container(9101).IsUpdating">$LOCALIZE[31013]</value>
		<value condition="$EXP[Search_KShows] + Container(9102).IsUpdating">$LOCALIZE[31013]</value>
		<value condition="$EXP[Search_KAlbums] + Container(9103).IsUpdating">$LOCALIZE[31013]</value>
		<value condition="$EXP[Search_KArtists] + Container(9104).IsUpdating">$LOCALIZE[31013]</value>
