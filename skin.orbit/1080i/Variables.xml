		<value condition="Control.HasFocus(9619)">$LOCALIZE[31982]</value>
		<value condition="Control.HasFocus(9620)">$LOCALIZE[31983]</value>
	</variable>
	<variable name="Set_FocusValue">
		<value condition="Control.HasFocus(9601)">$VAR[LabelLibView]</value>
		<value condition="Control.HasFocus(9602)">$VAR[LabelRingStyle]</value>
		<value condition="Control.HasFocus(9603)">$VAR[LabelHomeMovies]</value>
		<value condition="Control.HasFocus(9604)">$VAR[LabelArtBackground]</value>
		<value condition="Control.HasFocus(9605)">$VAR[LabelWatchedMarkers]</value>
		<value condition="Control.HasFocus(9606)">$VAR[LabelTrailer]</value>
