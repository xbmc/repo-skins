<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml.
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->
	<!-- Orbit has one accent (signal amber). Kept as a variable so inherited windows stay valid. -->
	<variable name="ColorAccent">
		<value>accent</value>
	</variable>
	<variable name="ColorRule">
		<value>line</value>
	</variable>
	<variable name="ColorCaption">
		<value>text_secondary</value>
	</variable>

	<!-- ==================================================================== textures -->
	<variable name="FocusFrameAlways">
		<value>focus/outline_2.png</value>
	</variable>
	<variable name="ButtonOutline">
		<value>common/rect_outline_1_round8.png</value>
	</variable>

	<!-- Ring faces (setting "ring style"): engraved ticks + numerals, or the bare track -->
	<variable name="RingFaceRating180"><value condition="$EXP[RingMinimal]">rings/dial_min_180.png</value><value>rings/dial_rating_180.png</value></variable>
	<variable name="RingFaceRating200"><value condition="$EXP[RingMinimal]">rings/dial_min_200.png</value><value>rings/dial_rating_200.png</value></variable>
	<variable name="RingFaceRating260"><value condition="$EXP[RingMinimal]">rings/dial_min_260.png</value><value>rings/dial_rating_260.png</value></variable>
	<variable name="RingFaceClock180"><value condition="$EXP[RingMinimal]">rings/dial_minclock_180.png</value><value>rings/dial_clock_180.png</value></variable>
	<variable name="RingFaceClock200"><value condition="$EXP[RingMinimal]">rings/dial_minclock_200.png</value><value>rings/dial_clock_200.png</value></variable>
	<variable name="RingFaceClock260"><value condition="$EXP[RingMinimal]">rings/dial_minclock_260.png</value><value>rings/dial_clock_260.png</value></variable>
	<variable name="RingFaceProgress180"><value condition="$EXP[RingMinimal]">rings/dial_min_180.png</value><value>rings/dial_progress_180.png</value></variable>
	<variable name="RingFaceProgress200"><value condition="$EXP[RingMinimal]">rings/dial_min_200.png</value><value>rings/dial_progress_200.png</value></variable>
	<variable name="RingFaceProgress260"><value condition="$EXP[RingMinimal]">rings/dial_min_260.png</value><value>rings/dial_progress_260.png</value></variable>

	<!-- ====================================================================== labels -->
	<variable name="DateLabel">
		<value>$INFO[System.Date(ddd d mmm)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>
	<!-- "Sun 18 Oct · 14° light rain" (weather bits only when a weather add-on reports) -->
	<variable name="DateWeatherLabel">
		<value condition="!String.IsEmpty(Weather.Conditions)">$INFO[System.Date(ddd d mmm)]$INFO[Weather.Temperature,  ·  ,]$INFO[Weather.Conditions, ,]</value>
		<value>$INFO[System.Date(ddd d mmm)]</value>
	</variable>

	<!-- Poster/thumb for any list item -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>


	<!-- OSD -->
	<variable name="OSDTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>

	<!-- ============================================================ skin settings -->
	<!-- Cycle helpers: SkinSettings rows run Skin.SetString(name,$VAR[Next...]) -->
	<variable name="NextLibView"><value condition="String.IsEqual(Skin.String(orbit.libview),grid)">arc</value><value>grid</value></variable>
	<variable name="LabelLibView"><value condition="String.IsEqual(Skin.String(orbit.libview),grid)">Grid</value><value>Arc</value></variable>
	<variable name="NextRingStyle"><value condition="String.IsEqual(Skin.String(orbit.ringstyle),minimal)">full</value><value>minimal</value></variable>
	<variable name="LabelRingStyle"><value condition="String.IsEqual(Skin.String(orbit.ringstyle),minimal)">Minimal</value><value>Engraved</value></variable>
	<variable name="NextArtBackground">
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">soft</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">off</value>
		<value>faint</value>
	</variable>
	<variable name="LabelArtBackground">
		<value condition="!System.AddonIsEnabled(plugin.video.themoviedb.helper)">Off (needs TMDb Helper)</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">Faint</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">Soft</value>
		<value>Off</value>
	</variable>
	<variable name="NextHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">inprogress</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">toprated</value>
		<value>recent</value>
	</variable>
	<variable name="LabelHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">Recently added</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">In progress</value>
		<value>Unwatched, rated 7.5+</value>
	</variable>
	<variable name="NextOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">5</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">3</value>
		<value>10</value>
	</variable>
	<variable name="PrevOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">5</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">10</value>
		<value>3</value>
	</variable>
	<variable name="LabelOSDAutoHide">
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),3)">3 seconds</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),10)">10 seconds</value>
		<value condition="String.IsEqual(Skin.String(orbit.osdhide),off)">Never</value>
		<value>5 seconds</value>
	</variable>
	<variable name="PrevHomeMovies">
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),recent)">toprated</value>
		<value condition="String.IsEqual(Skin.String(orbit.homemovies),inprogress)">recent</value>
		<value>inprogress</value>
	</variable>
	<variable name="PrevArtBackground">
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),faint)">off</value>
		<value condition="String.IsEqual(Skin.String(orbit.artbackground),soft)">faint</value>
		<value>soft</value>
	</variable>
	<variable name="LabelTrailer"><value condition="Skin.HasSetting(orbit.hidetrailer)">Hidden</value><value>Shown</value></variable>
	<variable name="LabelReduceMotion"><value condition="Skin.HasSetting(orbit.reducemotion)">On</value><value>Off</value></variable>
	<variable name="LabelReset">
		<value condition="!String.IsEmpty(Window(Home).Property(orbit.resetarmed))">[COLOR accent]Press OK again to reset every Orbit setting[/COLOR]</value>
		<value>Reset all skin settings</value>
	</variable>
	<!-- settings instrument (focused row) -->
	<variable name="LabelHideMenu_Movies"><value condition="Skin.HasSetting(HideMenu.Movies)">$LOCALIZE[31332]</value><value>$LOCALIZE[31331]</value></variable>
	<variable name="LabelHideMenu_TVShows"><value condition="Skin.HasSetting(HideMenu.TVShows)">$LOCALIZE[31332]</value><value>$LOCALIZE[31331]</value></variable>
	<variable name="LabelHideMenu_Music"><value condition="Skin.HasSetting(HideMenu.Music)">$LOCALIZE[31332]</value><value>$LOCALIZE[31331]</value></variable>
	<variable name="LabelHideMenu_Search"><value condition="Skin.HasSetting(HideMenu.Search)">$LOCALIZE[31332]</value><value>$LOCALIZE[31331]</value></variable>
	<variable name="Set_FocusTitle">
		<value condition="Control.HasFocus(9601)">Library opens in</value>
		<value condition="Control.HasFocus(9602)">Ring style</value>
		<value condition="Control.HasFocus(9603)">Films on the Home dial</value>
		<value condition="Control.HasFocus(9604)">Artwork backdrop</value>
		<value condition="Control.HasFocus(9605)">Watched badges</value>
		<value condition="Control.HasFocus(9606)">Trailer button</value>
		<value condition="Control.HasFocus(9607)">Player controls</value>
		<value condition="Control.HasFocus(9608)">Reduce motion</value>
		<value condition="Control.HasFocus(9611)">$LOCALIZE[342]</value>
		<value condition="Control.HasFocus(9612)">$LOCALIZE[20343]</value>
		<value condition="Control.HasFocus(9613)">$LOCALIZE[2]</value>
		<value condition="Control.HasFocus(9614)">$LOCALIZE[137]</value>
