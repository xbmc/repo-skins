		<value condition="Control.HasFocus(9613) + Skin.HasSetting(HideMenu.Music)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9613)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9614) + Skin.HasSetting(HideMenu.Search)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9614)">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9615) + !String.IsEmpty(Skin.String(CustomRow.1.Path))">rings/knob/2_1.png</value>
		<value condition="Control.HasFocus(9615)">rings/knob/2_0.png</value>
		<value condition="Control.HasFocus(9616) + !String.IsEmpty(Skin.String(CustomRow.2.Path))">rings/knob/2_1.png</value>
