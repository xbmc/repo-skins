				</control>
			</control>
			<control type="group">
				<left>640</left>
				<top>27</top>
				<width>40</width>
				<height>30</height>
				<visible>ListItem.Property(hearing_imp) + !ListItem.Property(sync)</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>40</width>
					<height>30</height>
					<texture border="10" colordiffuse="border_button">common/rect_outline_1_round8.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>40</width>
					<height>30</height>
					<align>center</align>
					<font>mono_13</font>
					<textcolor>text_secondary</textcolor>
					<label>HI</label>
				</control>
