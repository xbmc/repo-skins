				<top>206</top>
				<width>320</width>
				<height>30</height>
				<font>card_21_bold</font>
				<textcolor>$PARAM[label_color]</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<left>8</left>
				<top>238</top>
				<width>320</width>
				<height>26</height>
				<font>num_14</font>
