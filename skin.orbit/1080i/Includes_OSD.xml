	<!-- ============================================================= legacy (M1) -->

	<!-- ================================================================ Orbit OSD (circular scrubber) -->
	<!-- Name of the focused OSD control, shown under the transport arc -->
	<variable name="OSDO_FocusLabel">
		<value condition="Control.HasFocus(87)">Seek  ·  Left / Right</value>
		<value condition="Control.HasFocus(600)">Previous</value>
		<value condition="Control.HasFocus(602) + [Player.Paused | Player.Forwarding | Player.Rewinding]">Play</value>
		<value condition="Control.HasFocus(602)">Pause</value>
		<value condition="Control.HasFocus(603)">Stop</value>
		<value condition="Control.HasFocus(607)">Next</value>
		<value condition="Control.HasFocus(70046)">Subtitles  ·  $VAR[OSD_SubtitleValue]</value>
		<value condition="Control.HasFocus(70049)">Audio  ·  $VAR[OSD_AudioValue]</value>
		<value condition="Control.HasFocus(70048)">Video settings</value>
		<value condition="Control.HasFocus(70044)">Chapters and bookmarks</value>
		<value condition="Control.HasFocus(70043)">Information</value>
		<value condition="Control.HasFocus(70051)">Player stats</value>
	</variable>
	<variable name="OSDO_TimeLabel">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(h:mm:ss)]</value>
		<value condition="Player.Seeking">$INFO[Player.SeekTime(h:mm:ss)]</value>
		<value>$INFO[Player.Time(h:mm:ss)]</value>
	</variable>
	<variable name="OSDO_StateIcon">
		<value condition="Player.Paused">icons/pause.png</value>
		<value condition="Player.Forwarding">icons/forward.png</value>
		<value condition="Player.Rewinding">icons/rewind.png</value>
		<value condition="Player.Caching">icons/clock.png</value>
		<value>icons/play.png</value>
	</variable>
	<variable name="OSDO_State">
		<value condition="Player.Caching">Buffering$INFO[Player.CacheLevel, ,%]</value>
		<value condition="!String.IsEmpty(Player.SeekNumeric)">Go to</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">Skip $VAR[OSD_SkipValue]</value>
		<value condition="Player.Forwarding">Forward $VAR[OSD_Speed]</value>
		<value condition="Player.Rewinding">Rewind $VAR[OSD_Speed]</value>
		<value condition="Player.Paused">$LOCALIZE[112]</value>
		<value>Playing</value>
	</variable>
	<variable name="OSDO_Kicker">
		<value condition="VideoPlayer.Content(episodes)">Now playing  ·  Episode</value>
		<value condition="VideoPlayer.Content(movies)">Now playing  ·  Film</value>
		<value condition="VideoPlayer.Content(musicvideos)">Now playing  ·  Music video</value>
		<value condition="VideoPlayer.Content(livetv)">Now playing  ·  Live TV</value>
		<value>Now playing</value>
	</variable>
	<variable name="OSDO_Meta">
		<value condition="VideoPlayer.Content(episodes)">$VAR[OSD_EpisodeCode]$INFO[VideoPlayer.Title,  ·  ,]</value>
		<value condition="VideoPlayer.Content(musicvideos)">$INFO[VideoPlayer.Artist]$INFO[VideoPlayer.Album,  ·  ,]</value>
		<!-- 0.9.4: no "2024  ·    ·  DIRECTOR" when a film has no certificate -->
		<value condition="String.IsEmpty(VideoPlayer.mpaa)">$INFO[VideoPlayer.Director]</value>
		<value condition="String.IsEmpty(VideoPlayer.Director)">$VAR[OSD_MPAA]</value>
		<value>$VAR[OSD_MPAA]  ·  $INFO[VideoPlayer.Director]</value>
	</variable>
	<!-- PlayerControls.xml: meta line and focused-control name -->
	<variable name="PC_Meta">
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ,]</value>
		<value condition="VideoPlayer.Content(episodes) | VideoPlayer.Content(musicvideos)">$VAR[OSDO_Meta]</value>
		<value>$VAR[OSDO_Year]$VAR[OSDO_Meta]</value>
	</variable>
	<variable name="PC_FocusLabel">
		<value condition="Control.HasFocus(87)">Seek</value>
		<value condition="Control.HasFocus(600)">Previous</value>
		<value condition="Control.HasFocus(602) + [Player.Paused | Player.Forwarding | Player.Rewinding]">Play</value>
		<value condition="Control.HasFocus(602)">Pause</value>
		<value condition="Control.HasFocus(603)">Stop</value>
		<value condition="Control.HasFocus(605)">Next</value>
		<value condition="Control.HasFocus(607)">Shuffle</value>
		<value condition="Control.HasFocus(704)">Repeat</value>
	</variable>
	<!-- year before OSDO_Meta (films): no trailing dot when nothing follows it -->
	<variable name="OSDO_Year">
		<value condition="String.IsEmpty(VideoPlayer.mpaa) + String.IsEmpty(VideoPlayer.Director)">$INFO[VideoPlayer.Year]</value>
		<value>$INFO[VideoPlayer.Year,,  ·  ]</value>
	</variable>
	<!-- One OSD tool / transport button: pre-rendered round textures (btn/rS/<icon>_<n|f|s>.png).
	     params: id, icon, onclick, visible, nofocus (n | s = amber icon), S (56|64), W (canvas = S + 24) -->
	<include name="OSDO_Tool">
		<param name="onclick">noop</param>
		<param name="visible">true</param>
		<param name="nofocus">n</param>
		<param name="S">56</param>
		<param name="W">80</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[W]</width>
				<height>$PARAM[W]</height>
				<label></label>
				<texturefocus>btn/r$PARAM[S]/$PARAM[icon]_f.png</texturefocus>
				<texturenofocus>btn/r$PARAM[S]/$PARAM[icon]_$PARAM[nofocus].png</texturenofocus>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- OSD readout cell: engraved label + mono value. params: w, label, value, visible -->
	<include name="OSDO_Readout">
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<width>$PARAM[w]</width>
				<height>80</height>
				<visible>$PARAM[visible]</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[w]</width>
					<height>24</height>
					<font>label_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>32</top>
					<width>$PARAM[w]</width>
					<height>48</height>
					<font>mono_40</font>
					<textcolor>text_primary</textcolor>
					<label>$PARAM[value]</label>
				</control>
			</control>
		</definition>
	</include>
	<!-- The scrubber ring (OrbitOSD: 640 face, amber sweep + nib at Player.Progress, integer 0-100) -->
	<include name="OSDO_Ring">
		<param name="left">120</param>
		<param name="top">200</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>640</width>
				<height>640</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>640</width>
					<height>640</height>
					<texture>rings/osd_face.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>640</width>
					<height>640</height>
					<texture fallback="rings/osd/0.png">rings/osd/$INFO[Player.Progress].png</texture>
				</control>
				<control type="grouplist">
					<left>140</left>
					<top>208</top>
					<width>360</width>
					<height>26</height>
					<orientation>horizontal</orientation>
					<align>center</align>
					<itemgap>10</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="image">
						<top>3</top>
						<width>20</width>
						<height>20</height>
						<texture colordiffuse="text_primary">$VAR[OSDO_StateIcon]</texture>
					</control>
					<control type="label">
						<width>auto</width>
						<height>26</height>
						<font>label_20</font>
						<textcolor>text_primary</textcolor>
						<label>$VAR[OSDO_State]</label>
					</control>
				</control>
				<control type="label">
					<left>40</left>
					<top>244</top>
					<width>560</width>
					<height>92</height>
					<align>center</align>
					<font>mono_80</font>
					<textcolor>text_primary</textcolor>
					<label>$VAR[OSDO_TimeLabel]</label>
				</control>
				<control type="label">
					<left>40</left>
					<top>340</top>
					<width>560</width>
					<height>34</height>
					<align>center</align>
					<font>mono_26</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[Player.Duration(h:mm:ss),of ,]</label>
				</control>
				<control type="label">
					<left>40</left>
					<top>378</top>
					<width>560</width>
					<height>34</height>
					<align>center</align>
					<font>mono_26</font>
					<textcolor>text_primary</textcolor>
					<label>ends [COLOR accent]$INFO[Player.FinishTime][/COLOR]</label>
					<visible>!String.IsEmpty(Player.FinishTime) + Player.HasVideo</visible>
				</control>
			</control>
		</definition>
	</include>
	<!-- Straight chapter track under the ring: exact chapter positions via a ranges control
	     (Player.Chapters), cache, seek target. params: left, top, width -->
	<include name="OSDO_ChapterTrack">
		<param name="left">160</param>
		<param name="top">986</param>
		<param name="width">560</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>12</height>
				<visible>Player.SeekEnabled</visible>
				<control type="image">
					<left>0</left>
					<top>5</top>
					<width>$PARAM[width]</width>
					<height>2</height>
					<texture colordiffuse="border_button">common/white.png</texture>
				</control>
				<control type="progress">
					<left>0</left>
					<top>5</top>
					<width>$PARAM[width]</width>
					<height>2</height>
					<info>Player.ProgressCache</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="tick_bright">common/white.png</midtexture>
				</control>
				<control type="progress">
					<left>0</left>
					<top>4</top>
					<width>$PARAM[width]</width>
					<height>4</height>
					<info>Player.SeekBar</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="accent">common/white.png</midtexture>
				</control>
				<control type="ranges">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>12</height>
					<texturebg>osd/slider_bg.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="text_primary">osd/tick.png</righttexture>
					<info>Player.Chapters</info>
					<visible>$EXP[OSD_HasChapters]</visible>
				</control>
			</control>
		</definition>
	</include>

</includes>
