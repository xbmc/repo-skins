<?xml version="1.0" encoding="UTF-8"?>
<!--
	Play-start curtain. Omar's Kodi switches the TV's refresh rate when a video starts
	(videoplayer.adjustrefreshrate = on start/stop), and during the HDMI resync Kodi keeps drawing
	the page underneath until the first frame, so the page "flashes". This black dialog covers the
	screen from the moment a video player exists until fullscreen video has been shown once, then
	fades out over the picture.
	- Window(Home).Property(orbit.fsseen) is set by VideoFullScreen.xml onload and cleared by
	  Custom_1154_PlayCurtainReset.xml when nothing is playing, so leaving fullscreen to browse
	  while a video plays never brings the curtain back.
	- Safety: never more than 8 s after the last key press (System.IdleTime), so a player that
	  never goes fullscreen can't leave a black screen.
	Conditions are written out in full (window-level <visible>).
-->
<window type="dialog" id="1153">
	<visible>[Player.HasVideo | [Player.HasMedia + !Player.HasAudio]] + !Window.IsActive(fullscreenvideo) + String.IsEmpty(Window(Home).Property(orbit.fsseen)) + !System.IdleTime(8)</visible>
	<zorder>2</zorder>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="120">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="300">WindowClose</animation>
			<texture colordiffuse="FF000000">common/white.png</texture>
		</control>
	</controls>
</window>
