<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.nocturne palette (docs/skin.nocturne/DESIGN.md). AARRGGBB.
    No accent colour: the torch is the highlight. Text is "lit" (full) or "unlit" (faded).
    Engine names kept from the Majan fork (text_*, hairline*, bg*, dim_*) so every window speaks Nocturne.
-->
<colors>
    <!-- Wall and velvet -->
    <color name="bg">ff0c0d10</color>                <!-- the wall in darkness -->
    <color name="velvet">ff0a0c12</color>            <!-- shroud colour -->
    <color name="bg_raised">ff17161a</color>         <!-- card fill, fallback art block -->
    <color name="bg_ghost">ff1d1b1e</color>
    <color name="ink">ff2b1d0c</color>               <!-- engraved text on brass / on the light -->

    <!-- Lit text (warm white), body, captions, unlit -->
    <color name="text_primary">fff3e2c6</color>
    <color name="text_lit">fff4e6cf</color>
    <color name="text_body">dbeadcc6</color>         <!-- plot, 86 % -->
    <color name="text_secondary">b8e2d0b4</color>    <!-- meta lines, 72 % -->
    <color name="text_tertiary">8cc8b8a0</color>     <!-- captions, counts, 55 % -->
    <color name="text_unlit">5ca49680</color>        <!-- words outside the light, 36 % -->
    <color name="serif_soft">ffe3cfae</color>        <!-- "Wes Anderson, 2014", "With ..." -->
    <color name="caption_lit">c7e2d0b4</color>       <!-- lit group label, 78 % -->

    <!-- Light and brass -->
    <color name="light">ffffe7c2</color>             <!-- 2700 K -->
    <color name="warm_art">ffffeed8</color>          <!-- colordiffuse on a lit picture -->
    <color name="brass">ffb8924f</color>
    <color name="brass_light">ffd9b377</color>
    <color name="brass_dim">59c8a05c</color>         <!-- progress track 35 % -->
    <color name="brass_word">9eeccea0</color>        <!-- unlit engraved word on the dark rail, 62 % -->

    <!-- Lines -->
    <color name="hairline">29dcbe8c</color>
    <color name="hairline_soft">1adcbe8c</color>
    <color name="hairline_strong">40dcbe8c</color>
    <color name="border_control">59dcbe8c</color>
    <color name="border_button">59dcbe8c</color>
    <color name="hairline_art">29dcbe8c</color>
    <color name="hairline_art_strong">40dcbe8c</color>

    <!-- Accent aliases (Majan engine names): all resolve to the light -->
    <color name="accent">ffffe7c2</color>
    <color name="accent_signal">ffffe7c2</color>

    <!-- Scrims and shadows -->
    <color name="scrim">ff0a0c12</color>
    <color name="scrim_tab">d90a0c12</color>
    <color name="scrim_track">590a0c12</color>
    <color name="shadow">8c000000</color>
    <color name="focus_halo">00000000</color>
    <color name="dim_passed">ff8a8a8a</color>
    <color name="dim_ahead">ffb0b0b0</color>
    <color name="dim_row">ff8a8a8a</color>
    <color name="unlit_art">ff5a5a5a</color>         <!-- grid art outside the pool (salon, lists) -->
    <color name="art_faint">4dffffff</color>
    <color name="art_soft">73ffffff</color>
    <color name="art_visible">a6ffffff</color>

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
    <color name="disabled">4da49680</color>
    <color name="dim_dialog">d90a0c12</color>
    <color name="dim_video">a60a0c12</color>
</colors>
