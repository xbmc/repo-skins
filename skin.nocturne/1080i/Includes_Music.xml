<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music building blocks (Builder C). Prefix: Music_ (includes, variables, expressions), music_ (constants).
	Used by MyMusicNav, Includes_Views_Music, DialogMusicInfo, MusicVisualisation, MusicOSD,
	MyPlaylist, MyMusicPlaylistEditor. Home may reuse Music_NowPlayingBar (SPEC 4.2 "music playing").
	Sources: mockups Music.dc.html / MusicStage.dc.html / OSD.dc.html, DESIGN 5-7, DATA 4.9-4.11.

	TMDb Helper (optional, guarded by $EXP[ArtBackgroundOn] which includes System.AddonIsEnabled):
	- Library + info dialog: the TMDb Helper image monitor blurs the focused item / info item
	  (MyMusicNav.xml and DialogMusicInfo.xml are both monitored windows) using
	  Window(Home).Property(TMDbHelper.Blur.SourceImage) = Art(thumb), output
	  Window(Home).Property(TMDbHelper.ListItem.BlurImage) (+ .Original = source path).
	  Needs Skin.HasSetting(TMDbHelper.EnableBlur).
	- Now playing: no list item, so the cover is blurred on demand with
	  RunScript(plugin.video.themoviedb.helper,blur_image=<path>,prefix=NocturnePlayer)
	  -> Window(Home).Property(TMDbHelper.NocturnePlayer.BlurImage) (checked in tmdbhelper 6.17.x
	  script/method/image_functions.py + monitor/images.py).
-->
<includes>
	<!-- ============================================================ constants -->
	<!-- Albums grid (view 504): 7 columns, cover 219, column gap 32, row gap 30 (Music.dc.html).
	     The panel is padded 14 px on every side of each cell so the focus frame (+7) and the
	     5 % zoom (+6) are not clipped by the container. -->
	<constant name="music_tile">219</constant>
	<constant name="music_cell_w">251</constant>          <!-- 219 + 32 -->
	<constant name="music_cell_h">310</constant>          <!-- 219 + 12 + 25 + 3 + 21 + 30 -->
	<constant name="music_pad">14</constant>
	<constant name="music_grid_left">82</constant>        <!-- 96 - 14 -->
	<constant name="music_grid_top">146</constant>        <!-- 160 - 14 -->
	<constant name="music_grid_w">1757</constant>         <!-- 7 x 251 -->
	<constant name="music_grid_h">838</constant>          <!-- clip at y 984 (top of the now-playing bar) -->
	<!-- Big Album (view 505): 380 squares, gap 28, focus slot 2 at x 504, top 230 (MusicStage.dc.html).
	     Item content is offset (20, 130) inside the container so the focused item's soft shadow,
	     zoom and frame fit; the container's left edge (76) hides the item before slot 1. -->
	<constant name="music_big">380</constant>
	<constant name="music_big_pitch">408</constant>       <!-- 380 + 28 -->
	<constant name="music_big_left">76</constant>
	<constant name="music_big_top">100</constant>
	<constant name="music_big_w">1844</constant>
	<constant name="music_big_h">668</constant>
	<constant name="music_big_pad_x">20</constant>
	<constant name="music_big_pad_y">130</constant>
	<constant name="music_details_x">504</constant>
	<constant name="music_details_y">662</constant>
	<!-- Lists / panels -->
	<constant name="music_list_top">250</constant>
	<constant name="music_list_h">594</constant>          <!-- 12 rows of 66, ends at 952 -->
	<constant name="music_panel_x">1264</constant>
	<constant name="music_panel_art">560</constant>
	<!-- Header tabs (inside the 120 px top bar, Music.dc.html) -->
	<constant name="music_tab_top">47</constant>  <!-- centre 65 = the header date's centre (Noc_Clock) -->
	<constant name="music_tab_h">36</constant>
	<!-- Now-playing bar (DESIGN 7.9) -->
	<constant name="music_np_top">984</constant>
	<constant name="music_np_h">96</constant>
	<!-- Now playing window / OSD (OSD.dc.html geometry) -->
	<constant name="music_np_cover">560</constant>
	<constant name="music_np_text_x">720</constant>
	<constant name="music_np_text_w">1104</constant>
	<constant name="music_progress_y">806</constant>
	<constant name="music_osd_y">900</constant>
	<constant name="music_osd_btn">72</constant>
	<constant name="music_osd_btn_f">88</constant>
	<constant name="music_osd_y_f">892</constant>

	<!-- ========================================================== expressions -->
	<expression name="Music_IsPlaying">Player.HasAudio</expression>
	<!-- Visualiser (VIS_PRESETS_BRIEF, 0.9.8): Now playing is the listening room; the music OSD's top rail word
	     "Visualiser" swaps it for Kodi's visualisation (skin bool nocturne.np.viz, off by default) and back ("The record").
	     Kodi only creates the visualisation add-on while control 2 is visible, so HasPresets is true only in this mode. -->
	<expression name="Music_VizMode">Skin.HasSetting(nocturne.np.viz) + Visualisation.Enabled</expression>
	<expression name="Music_VizPresets">Skin.HasSetting(nocturne.np.viz) + Visualisation.Enabled + Visualisation.HasPresets</expression>
	<variable name="Music_VizWord">
		<value condition="Skin.HasSetting(nocturne.np.viz)">$LOCALIZE[31378]</value>
		<value>$LOCALIZE[31377]</value>
	</variable>
	<!-- Header tab that matches the current library node (path based, so drilling into an artist keeps ARTISTS lit) -->
	<expression name="Music_TabArtists">String.StartsWith(Container.FolderPath,musicdb://artists/)</expression>
	<expression name="Music_TabGenres">String.StartsWith(Container.FolderPath,musicdb://genres/)</expression>
	<expression name="Music_TabSongs">String.StartsWith(Container.FolderPath,musicdb://songs/)</expression>
	<expression name="Music_TabAlbums">String.StartsWith(Container.FolderPath,musicdb://albums/) | String.StartsWith(Container.FolderPath,musicdb://recentlyaddedalbums/) | String.StartsWith(Container.FolderPath,musicdb://compilations/) | [Container.Content(albums) + !String.StartsWith(Container.FolderPath,musicdb://artists/) + !String.StartsWith(Container.FolderPath,musicdb://genres/)]</expression>
	<!-- At a tab root (used to hide the folder caption in the page header) -->
	<expression name="Music_AtTabRoot">String.IsEqual(Container.FolderPath,musicdb://albums/) | String.IsEqual(Container.FolderPath,musicdb://artists/) | String.IsEqual(Container.FolderPath,musicdb://songs/) | String.IsEqual(Container.FolderPath,musicdb://genres/)</expression>
	<!-- Soft / Visible artwork background: add the focus halo behind the frame (DESIGN 7.2) -->
	<expression name="Music_ArtStrong">$EXP[ArtBackgroundOn] + [String.IsEqual(Skin.String(nocturne.artbackground),soft) | String.IsEqual(Skin.String(nocturne.artbackground),visible)]</expression>
	<expression name="Music_InfoIsAlbum">String.IsEqual(ListItem.DBType,album)</expression>
	<expression name="Music_InfoIsArtist">String.IsEqual(ListItem.DBType,artist)</expression>
	<expression name="Music_InfoIsSong">String.IsEqual(ListItem.DBType,song)</expression>
	<!-- Now playing: the cover blur exists and belongs to the track that is playing now -->
	<expression name="Music_PlayerBlurReady">!String.IsEmpty(Window(Home).Property(TMDbHelper.NocturnePlayer.BlurImage)) + String.IsEqual(Window(Home).Property(nocturne.np.blursrc),Player.Art(thumb))</expression>

	<!-- ============================================================ variables -->

	<!-- Title for any item; the ".." parent item (filelists.showparentdiritems = on) reads "Back" -->
	<variable name="Music_ItemLabel">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<variable name="Music_ViewTitle">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<!-- Header tabs -->
	<variable name="Music_TabText_Albums">
		<value condition="$EXP[Music_TabAlbums]">d9e2d0b4</value>
		<value>66c8b8a0</value>
	</variable>
	<variable name="Music_TabText_Artists">
		<value condition="$EXP[Music_TabArtists]">d9e2d0b4</value>
		<value>66c8b8a0</value>
	</variable>
	<variable name="Music_TabText_Songs">
		<value condition="$EXP[Music_TabSongs]">d9e2d0b4</value>
		<value>66c8b8a0</value>
	</variable>
	<variable name="Music_TabText_Genres">
		<value condition="$EXP[Music_TabGenres]">d9e2d0b4</value>
		<value>66c8b8a0</value>
	</variable>
	<!-- Library totals come from Kodi core (Window(Home) properties set by CRecentlyAddedJob, DATA 4.2) -->
	<variable name="Music_TabLabel_Albums">
		<value condition="$EXP[Music_TabAlbums]">$LOCALIZE[31229]$INFO[Container.NumItems,  ,]</value>
		<value>$LOCALIZE[31229]</value>
	</variable>
	<variable name="Music_TabLabel_Artists">
		<value condition="$EXP[Music_TabArtists]">$LOCALIZE[133]$INFO[Container.NumItems,  ,]</value>
		<value>$LOCALIZE[133]</value>
	</variable>
	<variable name="Music_TabLabel_Songs">
		<value condition="$EXP[Music_TabSongs]">$LOCALIZE[134]$INFO[Container.NumItems,  ,]</value>
		<value>$LOCALIZE[134]</value>
	</variable>
	<variable name="Music_SortArrow">
		<value condition="Container.SortDirection(descending)">↓</value>
		<value>↑</value>
	</variable>
	<!-- Now playing kicker -->
	<variable name="Music_NPKicker">
		<value condition="Player.Paused">Paused$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
		<value>Now playing$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
	</variable>
	<!-- Info dialog -->
	<variable name="Music_InfoKicker">
		<value condition="$EXP[Music_InfoIsArtist]">Artist</value>
		<value condition="$EXP[Music_InfoIsSong]">Song$INFO[ListItem.TrackNumber,  ·  Track ,]</value>
		<value condition="String.IsEqual(ListItem.Property(Album_ReleaseType),album) | String.IsEmpty(ListItem.Property(Album_ReleaseType))">Album$INFO[ListItem.DateAdded,  ·  $LOCALIZE[31252] ,]</value>
		<value>Album$INFO[ListItem.Property(Album_ReleaseType),  ·  ,]</value>
	</variable>
	<variable name="Music_InfoTitle">
		<value condition="$EXP[Music_InfoIsArtist] + !String.IsEmpty(ListItem.Artist)">$INFO[ListItem.Artist]</value>
		<value condition="$EXP[Music_InfoIsSong] + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value condition="$EXP[Music_InfoIsAlbum] + !String.IsEmpty(ListItem.Album)">$INFO[ListItem.Album]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="Music_InfoSubline">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Type)]$INFO[ListItem.Property(Artist_Style),  ·  ,]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Artist]$INFO[ListItem.Album,  ·  ,]</value>
		<value>$INFO[ListItem.Artist]</value>
	</variable>
	<variable name="Music_InfoDescription">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Description)]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Comment]</value>
		<value>$INFO[ListItem.Property(Album_Description)]</value>
	</variable>
	<variable name="Music_InfoListCaption">
		<value condition="$EXP[Music_InfoIsArtist]">Discography$INFO[Container(50).NumItems,  ·  ,]</value>
		<value>Tracklist$INFO[Container(50).NumItems,  ·  ,]</value>
	</variable>
	<!-- Shuffle (skin action; Kodi has no shuffle button in this dialog). PlayMedia clears the music
	     playlist (which resets shuffle), then the button's second action turns RandomOn. -->
	<variable name="Music_InfoShuffleAction">
		<value condition="$EXP[Music_InfoIsArtist]">PlayMedia(musicdb://artists/$INFO[ListItem.DBID]/,isdir)</value>
		<value>PlayMedia(musicdb://albums/$INFO[ListItem.DBID]/,isdir)</value>
	</variable>
	<!-- Queue window (MyPlaylist) -->
	<variable name="Music_QueueTitle">
		<value condition="Window.IsActive(videoplaylist)">Video queue</value>
		<value>Queue</value>
	</variable>
	<variable name="Music_QueueIndex">
		<value condition="Window.IsActive(videoplaylist)">02</value>
		<value>04</value>
	</variable>
	<variable name="Music_QueueShuffleLabel">
		<value condition="Playlist.IsRandom">Shuffle: on</value>
		<value>Shuffle: off</value>
	</variable>

	<!-- ================================================================ cover -->
	<!-- Square cover with corner mask (picked at window load, DESIGN 7.1) and an optional opaque
	     dim (colordiffuse). Fallback = raised tile with the name, covered by the art when it loads.
	     Sits inside a group of the cover size.
	     params: art, title, mask_round (default 219 grid mask), diffuse (default white = undimmed),
	             fadetime (embedded MP3 art loads slowly: default 160) -->
	<include name="Music_Cover">
		<param name="art">$INFO[ListItem.Art(thumb)]</param>
		<param name="title">$INFO[ListItem.Label]</param>
		<param name="mask_round">masks/square_round8.png</param>
		<param name="diffuse">white</param>
		<param name="fadetime">160</param>
		<param name="parent_icon">40</param>
		<param name="parent_caption">false</param>
		<definition>
			<include content="Music_ParentTile">
				<param name="icon" value="$PARAM[parent_icon]"/>
				<param name="caption_visible" value="$PARAM[parent_caption]"/>
			</include>
			<control type="group">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<visible>!ListItem.IsParentFolder</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="bg_raised">common/white.png</texture>
			</control>
			<control type="textbox">
				<left>16</left>
				<top>14</top>
				<right>16</right>
				<height>52</height>
				<font>sans_20</font>
				<textcolor>text_tertiary</textcolor>
				<label>$PARAM[title]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" diffuse="$PARAM[mask_round]" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>false</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>true</visible>
			</control>
			</control>
		</definition>
	</include>

	<!-- ".." parent item tile (same look as Builder B's VidView_ParentTile): hairline box + back
	     chevron + optional "UP ONE LEVEL" caption. Inside the cover group. params: icon, caption_visible -->
	<include name="Music_ParentTile">
		<param name="icon">40</param>
		<param name="caption_visible">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="10" colordiffuse="hairline_strong">$VAR[ButtonOutline]</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>$PARAM[icon]</width>
					<height>$PARAM[icon]</height>
					<texture colordiffuse="text_secondary">icons/back.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<right>0</right>
					<bottom>24</bottom>
					<height>22</height>
					<align>center</align>
					<font>caps_20</font>
					<textcolor>text_tertiary</textcolor>
					<label>$LOCALIZE[31340]</label>
					<visible>$PARAM[caption_visible]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ===================================================== now-playing bar -->
	<!-- Bottom bar when audio plays (Music.dc.html / DESIGN 7.9). Not focusable.
	     params: visible (default: audio is playing) -->
	<include name="Music_NowPlayingBar">
		<param name="visible">$EXP[Music_IsPlaying]</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>music_np_top</top>
				<width>screen_w</width>
				<height>music_np_h</height>
				<visible>$PARAM[visible]</visible>
				<include>Anim_FadeVisible</include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>screen_w</width>
					<height>music_np_h</height>
					<texture colordiffuse="bg">common/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>screen_w</width>
					<height>rule_h</height>
					<texture colordiffuse="hairline_strong">common/hairline.png</texture>
				</control>
				<control type="group">
					<left>page_margin</left>
					<top>18</top>
					<width>60</width>
					<height>60</height>
					<include content="Music_Cover">
						<param name="art" value="$INFO[Player.Art(thumb)]"/>
						<param name="title" value=""/>
						<param name="mask_round" value="masks/square_round8.png"/>
					</include>
				</control>
				<control type="label">
					<left>184</left>
					<top>20</top>
					<width>420</width>
					<height>20</height>
					<font>caps_20</font>
					<textcolor>light</textcolor>
					<label>$VAR[Music_NPKicker]</label>
				</control>
				<control type="grouplist">
					<left>184</left>
					<top>42</top>
					<width>420</width>
					<height>32</height>
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width max="300">auto</width>
						<height>32</height>
						<font>sans_22</font>
						<textcolor>text_primary</textcolor>
						<label>$INFO[MusicPlayer.Title]</label>
					</control>
					<control type="label">
						<width max="400">auto</width>
						<height>32</height>
						<font>sans_22</font>
						<textcolor>text_secondary</textcolor>
						<label>$INFO[MusicPlayer.Artist,  ·  ,]</label>
					</control>
				</control>
				<control type="progress">
					<left>632</left>
					<top>47</top>
					<width>1014</width>
					<height>2</height>
					<texturebg colordiffuse="hairline_strong">common/white.png</texturebg>
					<midtexture colordiffuse="text_primary">common/white.png</midtexture>
					<info>Player.Progress</info>
				</control>
				<control type="label">
					<left>1674</left>
					<top>33</top>
					<width>150</width>
					<height>30</height>
					<align>right</align>
					<font>num_20</font>
					<textcolor>text_secondary</textcolor>
					<label>$INFO[Player.Time]$INFO[Player.Duration, / ,]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- ========================================================= header tabs -->
	<!-- One mono tab: active = text_primary + 3 px accent underline (togglebutton alt texture),
	     focused = accent fill + ink text (same language as Noc_SubNavButton).
	     params: id, label, onclick, active (condition), textcolor, visible -->
	<include name="Music_Tab">
		<param name="active">false</param>
		<param name="textcolor">73c8b8a0</param>
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>48</height>
				<font>caps_20</font>
				<textcolor>$PARAM[textcolor]</textcolor>
				<focusedcolor>text_primary</focusedcolor>
				<textoffsetx>14</textoffsetx>
				<aligny>center</aligny>
				<label>$PARAM[label]</label>
				<texturefocus colordiffuse="light">noc/glow_word.png</texturefocus>
				<texturenofocus />
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Header bar of the music library: ALBUMS · ARTISTS · SONGS · GENRES · SORT ↓ · VIEW.
	     Lives inside the 120 px top bar between the page title and the clock (Music.dc.html), right-aligned
	     inside 600..1530 so it ends before the date + clock block (the date starts at ~1555 on device;
	     same box as MyVideoNav's filter bar) and never reaches the page title + folder caption.
	     Tabs swap the node in place with Container.Update(path) - no replace, so Back walks the tab
	     history and leaves the window at the start node (Kodi's own OnBack; a skin onback action
	     would run AND still let Kodi handle Back). Kodi ids: 3 sort by (SendClick opens Kodi's sort chooser), 4 sort order. -->
	<include name="Music_HeaderBar">
		<control type="grouplist" id="9000">
			<left>82</left>
			<top>184</top>
			<width>1130</width>
			<height>48</height>
			<orientation>horizontal</orientation>
			<itemgap>18</itemgap>
			<ondown>50</ondown>
			<onup>50</onup>
			<onright>9830</onright>
			<onback>50</onback>
			<include content="Music_Tab">
				<param name="id" value="9320"/>
				<param name="label" value="$VAR[Music_TabLabel_Albums]"/>
				<param name="onclick" value="ReplaceWindow(Music,musicdb://albums/,return)"/>
				<param name="textcolor" value="$VAR[Music_TabText_Albums]"/>
			</include>
			<include content="Music_Tab">
				<param name="id" value="9321"/>
				<param name="label" value="$VAR[Music_TabLabel_Artists]"/>
				<param name="onclick" value="ReplaceWindow(Music,musicdb://artists/,return)"/>
				<param name="textcolor" value="$VAR[Music_TabText_Artists]"/>
			</include>
			<include content="Music_Tab">
				<param name="id" value="9322"/>
				<param name="label" value="$VAR[Music_TabLabel_Songs]"/>
				<param name="onclick" value="ReplaceWindow(Music,musicdb://songs/,return)"/>
				<param name="textcolor" value="$VAR[Music_TabText_Songs]"/>
			</include>
			<include content="Music_Tab">
				<param name="id" value="9323"/>
				<param name="label" value="$LOCALIZE[135]"/>
				<param name="onclick" value="ReplaceWindow(Music,musicdb://genres/,return)"/>
				<param name="textcolor" value="$VAR[Music_TabText_Genres]"/>
			</include>
			<control type="image" id="9327">
				<width>30</width>
				<height>48</height>
				<texture />
			</control>
			<include content="Music_Tab">
				<param name="id" value="9324"/>
				<param name="label" value="$LOCALIZE[31010]  $INFO[Container.SortMethod]"/>
				<param name="onclick" value="SendClick(3)"/>
				<param name="visible" value="Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)"/>
			</include>
			<include content="Music_Tab">
				<param name="id" value="9325"/>
				<param name="label" value="$VAR[Music_SortArrow]"/>
				<param name="onclick" value="Container.SetSortDirection"/>
				<param name="visible" value="Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)"/>
			</include>
		</control>
		<include content="Lib_BrassWords">
			<param name="top" value="176"/>
			<param name="pick_focus" value="Lib_PickFocusMusic"/>
			<param name="view_w" value="386"/>
			<param name="view_label" value="$VAR[Music_ViewName]"/>
