<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info: the room goes dark and a small wall label is lit beside the poster (the spotlight, small).
	Opened by Info in fullscreen video and by the OSD "Info" word; Info again or Back closes it.
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button
	(default): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include content="Rail_Dark">
				<param name="floor" value="760"/>
			</include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="velvet">osd/scrim_corner_bl.png</texture>
			</control>
			<include>Noc_Clock</include>
			<!-- the poster, lit -->
			<control type="image">
				<left>-100</left>
				<top>380</top>
				<width>640</width>
				<height>620</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="light">noc/glow_warm.png</texture>
			</control>
			<control type="group">
				<left>112</left>
				<top>500</top>
				<width>236</width>
				<height>354</height>
				<visible>!String.IsEmpty(Player.Art(poster)) | !String.IsEmpty(Player.Art(tvshow.poster))</visible>
				<include content="Noc_FrameParts">
					<param name="art" value="$VAR[OSDInfo_Poster]"/>
					<param name="lit" value="true"/>
				</include>
			</control>
			<control type="label">
				<left>404</left>
				<top>494</top>
				<width>1300</width>
				<height>30</height>
				<font>caps_20</font>
				<textcolor>d9e2d0b4</textcolor>
				<label>$VAR[OSD_State]  ·  $VAR[OSD_Type]</label>
			</control>
			<control type="label">
				<left>400</left>
				<top>526</top>
				<width>1420</width>
				<height>84</height>
				<font>title_64</font>
				<textcolor>fff4e6cf</textcolor>
				<shadowcolor>cc000000</shadowcolor>
				<label>$VAR[OSD_Title]</label>
			</control>
			<control type="label">
				<left>404</left>
				<top>612</top>
				<width>1420</width>
				<height>30</height>
				<font>caps_20</font>
				<textcolor>b8e2d0b4</textcolor>
				<label>$VAR[OSD_Meta]</label>
			</control>
			<control type="image">
				<left>404</left>
				<top>656</top>
				<width>56</width>
				<height>2</height>
				<texture colordiffuse="ccb8924f">common/white.png</texture>
			</control>
			<control type="textbox">
				<left>404</left>
				<top>676</top>
				<width>1200</width>
				<height>112</height>
				<font>body_24</font>
				<textcolor>dbeadcc6</textcolor>
				<label>$INFO[VideoPlayer.Plot]</label>
				<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>
			</control>
			<control type="grouplist">
				<left>404</left>
				<top>812</top>
				<width>1420</width>
				<height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>16</itemgap>
				<visible>$EXP[OSD_HasNext]</visible>
				<control type="label">
					<width>auto</width>
					<height>40</height>
					<font>caps_20</font>
					<textcolor>d9e2d0b4</textcolor>
					<label>$LOCALIZE[31290]</label>
				</control>
				<control type="label">
					<width max="1200">auto</width>
					<height>40</height>
					<font>serif_28</font>
					<textcolor>serif_soft</textcolor>
					<label>$VAR[OSD_NextLabel]</label>
				</control>
			</control>
			<!-- time + filament -->
			<control type="label">
				<left>96</left>
				<top>900</top>
				<width>900</width>
				<height>40</height>
				<font>clock_30</font>
				<textcolor>e6f3e2c6</textcolor>
				<label>$VAR[OSD_SeekTimeLabel]$INFO[Player.Duration,  [COLOR 99e2ceae]/  ,[/COLOR]]</label>
			</control>
			<control type="label">
				<right>96</right>
				<top>900</top>
				<width>900</width>
				<height>40</height>
				<align>right</align>
				<font>caps_20</font>
				<textcolor>99c8b8a0</textcolor>
				<label>$VAR[Rail_Facts]</label>
			</control>
			<control type="image">
				<left>96</left>
				<top>962</top>
				<width>1728</width>
				<height>1</height>
				<texture colordiffuse="38dcbe8c">common/white.png</texture>
			</control>
			<control type="progress">
				<left>84</left>
				<top>950</top>
				<width>1752</width>
				<height>24</height>
				<texturebg />
				<midtexture border="12,0,12,0">noc/filament.png</midtexture>
				<info>Player.Progress</info>
			</control>
			<control type="label">
				<left>96</left>
				<top>1000</top>
				<width>1728</width>
				<height>30</height>
				<font>caps_20</font>
				<textcolor>73c8b8a0</textcolor>
				<label>◀ ▶  $LOCALIZE[31289]   ·   OK  $LOCALIZE[31292]   ·   $LOCALIZE[31241]  $LOCALIZE[31293]</label>
			</control>
		</control>
	</controls>
</window>
