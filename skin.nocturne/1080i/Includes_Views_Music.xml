<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library = the listening room (mockup NocturneMusic.html). MyMusicNav <views>504,505,50</views>:
	  504 Listening room  albums / artists on a shelf under the pendant lamp (Includes_Gallery.xml)
	  505 Record bins     a grid of covers (albums, artists, songs); a small torch follows Column(n)/Row(n)
	  50  List            songs, genres, years, roots, playlists, files
	Tabs and options (9000) sit under the cornice (y 184); views Up -> 9000, 9000 Down/Back -> the view.
-->
<includes>
	<include name="Music_View_504">
		<control type="group">
			<visible>Control.IsVisible(504)</visible>
			<include>Anim_VisibleFade</include>
			<include content="Noc_ListeningRoomShelf">
				<param name="id" value="504"/>
				<param name="onup" value="9000"/>
				<param name="ondown" value="9000"/>
			</include>
			<include content="Noc_ListeningRoomLight">
				<param name="list" value="504"/>
				<!-- lifted 64 px: the shade sat on the header's Sort words (y 200) -->
				<param name="lamp_top" value="-104"/>
			</include>
		</control>
	</include>

	<include name="Music_View_505">
		<control type="group">
			<visible>Control.IsVisible(505)</visible>
			<include>Anim_VisibleFade</include>
			<control type="panel" id="505">
				<left>96</left>
				<top>250</top>
				<width>1728</width>
				<height>780</height>
				<orientation>vertical</orientation>
				<preloaditems>2</preloaditems>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<include>Lib_OpenLeft</include>
				<include>Lib_OpenRight</include>
				<viewtype label="31274">icon</viewtype>
				<visible>Container.Content(albums) | Container.Content(artists) | Container.Content(songs)</visible>
				<itemlayout width="216" height="300">
					<control type="group">
						<left>18</left>
						<top>14</top>
						<width>180</width>
						<height>180</height>
						<include content="Noc_CoverParts">
							<param name="art" value="$INFO[ListItem.Art(thumb)]"/>
							<param name="label" value="$VAR[Music_ViewTitle]"/>
						</include>
					</control>
					<control type="label">
						<left>8</left>
						<top>208</top>
						<width>200</width>
						<height>36</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>title_30</font>
						<textcolor>66e3cfae</textcolor>
						<label>$VAR[Music_ViewTitle]</label>
					</control>
				</itemlayout>
				<focusedlayout width="216" height="300">
					<control type="group">
						<left>18</left>
						<top>14</top>
						<width>180</width>
						<height>180</height>
						<include content="Noc_CoverParts">
							<param name="art" value="$INFO[ListItem.Art(thumb)]"/>
							<param name="label" value="$VAR[Music_ViewTitle]"/>
							<param name="lit" value="Control.HasFocus(505)"/>
						</include>
					</control>
					<control type="label">
						<left>8</left>
						<top>208</top>
						<width>200</width>
						<height>36</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>title_30</font>
						<textcolor>66e3cfae</textcolor>
						<label>$VAR[Music_ViewTitle]</label>
						<visible>!Control.HasFocus(505)</visible>
					</control>
					<control type="label">
						<left>8</left>
						<top>208</top>
						<width>200</width>
						<height>36</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>title_30</font>
						<textcolor>text_lit</textcolor>
						<scroll>true</scroll>
						<scrollsuffix>     ·     </scrollsuffix>
						<label>$VAR[Music_ViewTitle]</label>
						<visible>Control.HasFocus(505)</visible>
					</control>
					<control type="label">
						<left>8</left>
						<top>244</top>
						<width>200</width>
						<height>30</height>
						<align>center</align>
						<aligny>center</aligny>
						<font>caps_20</font>
						<textcolor>b8e2d0b4</textcolor>
						<scroll>true</scroll>
						<scrollsuffix>     ·     </scrollsuffix>
						<label>$INFO[ListItem.Artist]</label>
						<visible>Control.HasFocus(505) + !String.IsEqual(ListItem.DBType,artist)</visible>
					</control>
				</focusedlayout>
			</control>
			<control type="group">
				<left>96</left>
				<top>250</top>
				<animation effect="slide" start="0,0" end="216,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(1)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="216,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(1)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="432,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(2)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="432,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(2)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="648,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(3)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="648,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(3)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="864,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(4)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="864,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(4)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1080,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(5)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1080,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(5)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1296,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(6)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1296,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(6)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1512,0" time="180" tween="sine" easing="inout" condition="[Container(505).Column(7)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="1512,0" time="0" tween="sine" easing="inout" condition="[Container(505).Column(7)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="0,300" time="180" tween="sine" easing="inout" condition="[Container(505).Row(1)] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<animation effect="slide" start="0,0" end="0,300" time="0" tween="sine" easing="inout" condition="[Container(505).Row(1)] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
				<include content="Noc_Dust">
					<param name="left" value="-292"/>
					<param name="top" value="-260"/>
					<param name="size" value="800"/>
				</include>
				<control type="image">
					<left>-1812</left>
					<top>-1780</top>
					<width>3840</width>
					<height>3840</height>
					<texture colordiffuse="$VAR[Noc_ShroudAlpha]">noc/shroud_small.png</texture>
				</control>
			</control>
		</control>
	</include>

	<include name="Music_View_50">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>96</left>
				<top>music_list_top</top>
				<width>1000</width>
				<height>music_list_h</height>
				<onup>9000</onup>
				<onleft>9000</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<include content="Music_SongLayout">
					<param name="condition" value="Container.Content(songs)"/>
				</include>
				<include content="Music_RowLayout">
					<param name="condition" value="!Container.Content(songs)"/>
				</include>
			</control>
			<include content="Noc_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1120"/>
				<param name="top" value="music_list_top"/>
				<param name="height" value="music_list_h"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="SetProperty(noc.lib.from,view,home)"/>
				<param name="onright2" value="SetFocus(9801,0,absolute)"/>
			</include>
			<include>Music_ListPanel</include>
		</control>
	</include>
</includes>
