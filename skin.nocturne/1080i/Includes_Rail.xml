<?xml version="1.0" encoding="UTF-8"?>
<!--
	Nocturne playback chrome: "the room is dark; a low brass rail at the bottom catches a strip of light carrying
	the title, the time and a hairline progress line that glows like a filament" (docs/concepts/round4/nocturne.md).
	Used by VideoOSD, DialogSeekBar, DialogFullScreenInfo, MusicOSD.
-->
<includes>
	<!-- One engraved word on a playback rail. Fixed width (no judder). params: id, label, width, onclick, onleft, onright, onup, ondown, visible -->
	<include name="Rail_Word">
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<param name="onup">87</param>
		<param name="ondown">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>64</height>
				<font>btn_22</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<textcolor>brass_word</textcolor>
				<focusedcolor>ink</focusedcolor>
				<texturenofocus>noc/rail_mid.png</texturenofocus>
				<texturefocus border="30,0,30,0">noc/rail_on.png</texturefocus>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
				<onup>$PARAM[onup]</onup>
				<ondown>$PARAM[ondown]</ondown>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="Rail_Sep">
		<param name="visible">true</param>
		<definition>
			<control type="image" id="$PARAM[id]">
				<width>3</width>
				<height>64</height>
				<texture>noc/rail_sep_tall.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="Rail_CapL">
		<definition>
			<control type="image" id="$PARAM[id]">
				<width>26</width>
				<height>64</height>
				<texture>noc/rail_capl.png</texture>
			</control>
		</definition>
	</include>
	<include name="Rail_CapR">
		<definition>
			<control type="image" id="$PARAM[id]">
				<width>20</width>
				<height>64</height>
				<texture>noc/rail_capr.png</texture>
			</control>
		</definition>
	</include>

	<!-- The dark room over the picture: velvet floor ramp + a thin ceiling ramp for the clock. param floor (height) -->
	<include name="Rail_Dark">
		<param name="floor">560</param>
		<definition>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>$PARAM[floor]</height>
				<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
				<texture>noc/floor_ramp.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>220</height>
				<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="160">WindowClose</animation>
				<texture>noc/ceiling_ramp.png</texture>
			</control>
		</definition>
	</include>

	<!-- Title block + filament. params: top (title top; the filament sits 128 below), show_time -->
	<include name="Rail_TitleAndFilament">
		<param name="top">752</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>$PARAM[top]</top>
				<control type="image">
					<left>0</left>
					<top>40</top>
					<width>1920</width>
					<height>220</height>
					<texture>noc/strip.png</texture>
				</control>
				<control type="label">
					<left>96</left>
					<top>-30</top>
					<width>900</width>
					<height>30</height>
					<aligny>center</aligny>
					<font>caps_20</font>
					<textcolor>d9e2d0b4</textcolor>
					<label>$VAR[OSD_State]  ·  $VAR[OSD_Type]</label>
				</control>
				<control type="label">
					<left>92</left>
					<top>0</top>
					<width>1240</width>
					<height>84</height>
					<aligny>center</aligny>
					<font>title_64</font>
					<textcolor>fff4e6cf</textcolor>
					<shadowcolor>cc000000</shadowcolor>
					<label>$VAR[OSD_Title]</label>
				</control>
				<control type="label">
					<left>96</left>
					<top>86</top>
					<width>1000</width>
					<height>30</height>
					<aligny>center</aligny>
					<font>caps_20</font>
					<textcolor>b8e2d0b4</textcolor>
					<label>$VAR[OSD_Meta]</label>
				</control>
				<!-- time, right -->
				<control type="label">
					<right>96</right>
					<top>20</top>
					<width>560</width>
					<height>40</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>clock_30</font>
					<textcolor>e6f3e2c6</textcolor>
					<shadowcolor>cc000000</shadowcolor>
					<label>$VAR[OSD_SeekTimeLabel]$INFO[Player.Duration,  [COLOR 99e2ceae]/  ,[/COLOR]]</label>
				</control>
				<control type="label">
					<right>96</right>
					<top>86</top>
					<width>760</width>
					<height>30</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>caps_20</font>
					<textcolor>99c8b8a0</textcolor>
					<label>$VAR[Rail_Facts]</label>
				</control>
				<!-- the filament -->
				<control type="image">
					<left>96</left>
					<top>128</top>
					<width>1728</width>
					<height>1</height>
					<texture colordiffuse="38dcbe8c">common/white.png</texture>
				</control>
				<control type="progress">
					<left>96</left>
					<top>127</top>
					<width>1728</width>
					<height>3</height>
					<texturebg />
					<midtexture colordiffuse="33dcbe8c">common/white.png</midtexture>
					<info>Player.ProgressCache</info>
				</control>
				<control type="progress">
					<left>84</left>
					<top>116</top>
					<width>1752</width>
					<height>24</height>
					<texturebg />
					<midtexture border="12,0,12,0">noc/filament.png</midtexture>
					<info>Player.Progress</info>
				</control>
			</control>
		</definition>
	</include>
	<variable name="Rail_Facts">
		<value condition="Player.HasVideo">$VAR[OSD_FlagResolution]$INFO[VideoPlayer.HdrType,  ·  ,]$VAR[Rail_AudioFact]$VAR[Rail_SubFact]$VAR[Rail_Ends]</value>
		<value>$VAR[Rail_Ends]</value>
	</variable>
	<variable name="Rail_AudioFact">
		<value condition="!String.IsEmpty(VideoPlayer.AudioCodec)">  ·  $VAR[OSD_FlagAudio]</value>
	</variable>
	<variable name="Rail_SubFact">
		<value condition="VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">  ·  $LOCALIZE[31275] $INFO[VideoPlayer.SubtitlesLanguage]</value>
	</variable>
	<!-- "ends 12:48 PM" with no-break spaces so it never splits -->
	<variable name="Rail_Ends">
		<value condition="!String.IsEmpty(Player.FinishTime) + Player.HasVideo">  ·  $LOCALIZE[31255] $INFO[Player.FinishTime]</value>
	</variable>
	<variable name="Rail_ShuffleLabel">
		<value condition="Playlist.IsRandom">$LOCALIZE[31286]  $LOCALIZE[31295]</value>
		<value>$LOCALIZE[31286]  $LOCALIZE[31296]</value>
	</variable>
	<variable name="Rail_RepeatLabel">
		<value condition="Playlist.IsRepeatOne">$LOCALIZE[31287]  $LOCALIZE[31297]</value>
		<value condition="Playlist.IsRepeat">$LOCALIZE[31287]  $LOCALIZE[31298]</value>
		<value>$LOCALIZE[31287]  $LOCALIZE[31296]</value>
	</variable>
	<variable name="Rail_QueueLabel">
		<value>$LOCALIZE[31288]$INFO[Playlist.Length(music),  ,]</value>
	</variable>
	<variable name="Noc_PlayerHaloColor">
		<value condition="!String.IsEmpty(Window(Home).Property(TMDbHelper.NocturnePlayer.Colors.Main))">$INFO[Window(Home).Property(TMDbHelper.NocturnePlayer.Colors.Main)]</value>
		<value>ffffe2b8</value>
	</variable>
	<variable name="Rail_PlayLabel">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">$LOCALIZE[31261]</value>
		<value>$LOCALIZE[31276]</value>
	</variable>
</includes>
