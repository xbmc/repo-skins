<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video / screen calibration (SPEC 5: Minimal, "must keep Kodi's required control ids").
	Builder F, M4. Kodi positions the movers itself (overscan corners, subtitle line, pixel ratio)
	and writes the help labels; Select steps through the controls, Back saves and exits.
	Kodi id contract (Estuary Omega SettingsScreenCalibration.xml / GUIWindowSettingsScreenCalibration):
	movers 8 (top-left), 9 (bottom-right), 10 (subtitle position), 12 (reset), resize 11 (pixel
	ratio); labels 2 (resolution), 3 (control help), 4 (value). Textures: media/misc/cal_*.png
	(generated by _src/make_misc_textures.py). The 40px transparent margin above / below the
	subtitle bar is part of the texture, as Kodi expects.
-->
<window>
	<defaultcontrol>8</defaultcontrol>
	<controls>
		<include>Noc_Background</include>
		<control type="mover" id="8">
			<description>top left mover</description>
			<left>0</left>
			<top>0</top>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="light">misc/cal_tl.png</texturefocus>
			<texturenofocus colordiffuse="text_tertiary">misc/cal_tl.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="mover" id="9">
			<description>bottom right mover</description>
			<left>700</left>
			<top>500</top>
			<width>128</width>
			<height>128</height>
			<texturefocus colordiffuse="light">misc/cal_br.png</texturefocus>
			<texturenofocus colordiffuse="text_tertiary">misc/cal_br.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="resize" id="11">
			<description>pixel aspect ratio</description>
			<left>0</left>
			<top>390</top>
			<width>500</width>
			<height>500</height>
			<texturefocus colordiffuse="light">misc/cal_ratio.png</texturefocus>
			<texturenofocus colordiffuse="text_tertiary">misc/cal_ratio.png</texturenofocus>
			<movingspeed acceleration="140" maxvelocity="300" resettimeout="180" delta="1">
				<eventconfig type="left"/>
				<eventconfig type="right"/>
			</movingspeed>
		</control>
		<control type="mover" id="10">
			<description>subtitle position mover</description>
			<left>200</left>
			<top>500</top>
			<width>380</width>
			<height>90</height>
			<texturefocus colordiffuse="light">misc/cal_sub.png</texturefocus>
			<texturenofocus colordiffuse="text_tertiary">misc/cal_sub.png</texturenofocus>
			<movingspeed acceleration="180" maxvelocity="300" resettimeout="200" delta="1">
				<eventconfig type="up"/>
				<eventconfig type="down"/>
			</movingspeed>
		</control>
		<control type="mover" id="12">
			<description>reset calibration</description>
			<left>0</left>
			<top>900</top>
			<width>100</width>
			<height>100</height>
			<texturefocus colordiffuse="light">misc/cal_reset.png</texturefocus>
			<texturenofocus colordiffuse="text_tertiary">misc/cal_reset.png</texturenofocus>
		</control>
		<control type="label">
			<description>window title</description>
			<left>0</left>
			<top>150</top>
			<width>screen_w</width>
			<height>50</height>
			<align>center</align>
			<font>title_40</font>
			<label>$LOCALIZE[214]</label>
		</control>
		<control type="label" id="2">
			<description>resolution info</description>
			<left>0</left>
			<top>210</top>
			<width>screen_w</width>
			<height>36</height>
			<align>center</align>
			<font>caps_20</font>
			<textcolor>light</textcolor>
		</control>
		<control type="label" id="3">
			<description>control description and help</description>
			<left>200</left>
			<top>260</top>
			<width>1520</width>
			<height>50</height>
			<align>center</align>
			<font>body_26</font>
			<textcolor>text_body</textcolor>
		</control>
		<control type="label" id="4">
			<description>calibration value</description>
			<left>0</left>
			<top>320</top>
			<width>screen_w</width>
			<height>44</height>
			<align>center</align>
			<font>serif_32</font>
		</control>
	</controls>
</window>
