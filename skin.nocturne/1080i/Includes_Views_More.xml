				<param name="label" value="$VAR[VidView_ItemTitle]"/>
				<param name="lit" value="$PARAM[lit]"/>
				<param name="font" value="$PARAM[font]"/>
				<param name="shadow" value="$PARAM[shadow]"/>
				<param name="inset" value="10"/>
			</include>
		</definition>
	</include>

