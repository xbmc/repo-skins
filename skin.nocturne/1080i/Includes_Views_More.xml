<?xml version="1.0" encoding="UTF-8"?>
<!--
	More views (docs/VIEWS_BRIEF_2026-10-27.md), in the museum's own language. Lights: _src/make_textures.py view_shrouds().

	Video (MyVideoNav):
	  502 Vitrine    one picture under the spot with its wall label and the curator's text; the rest of the room
	                 waits in a drawer of small frames below (horizontal list).
	  506 Panorama   a hang of 16:9 pictures (fanart / landscape / episode stills; icons and posters sit in a mat,
	                 never cropped); a wide torch follows Column(n)/Row(n) like the salon.
	  507 Catalogue  the register: six entries a page, each with its picture, meta and the first line of the text;
	                 the lit picture and the whole text on the wall to the right. Episodes list with their stills.
	Music (MyMusicNav):
	  508 Portraits  an index of names on the left; the artist's fanart hung as a big canvas (the portrait in a mat
	                 when there is no fanart), a brass plaque and the description under it.
	viewtypes bigwrap / bigwide / biglist / wide are never a node's default type (Kodi defaults are list, icon, big
	icon, info, big info, or auto = info / list by metadata, AutoSwitch.cpp), so the view a node opens in by default
	is unchanged (CGUIViewControl::SetCurrentView: the saved id, else the first visible view of the default type,
	else the first list view).
-->
<includes>
	<!-- ================================================================ art (with honest fallbacks) -->
	<expression name="VidView_HasPoster">!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster))</expression>
	<expression name="VidView_HasLand">[String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))] | !String.IsEmpty(ListItem.Art(landscape)) | !String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(tvshow.fanart))</expression>
	<expression name="VidView_HasThumb">!String.IsEmpty(ListItem.Art(thumb))</expression>
	<expression name="VidView_IsEpisode">String.IsEqual(ListItem.DBType,episode)</expression>
	<!-- the more views: offered where they have something to show -->
	<expression name="VidView_ShowVitrine">$EXP[VidView_IsLibraryVideo] | !String.IsEmpty(Container.PluginName)</expression>
	<variable name="VidView_PosterOnly">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(tvshow.poster)]</value>
	</variable>
	<variable name="VidView_LandOnly">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Art(tvshow.fanart)]</value>
	</variable>
	<!-- what a wide frame shows in a mat when there is no wide art: the poster, else the thumb / icon art -->
	<variable name="VidView_MatArt">
		<value condition="$EXP[VidView_HasPoster]">$VAR[VidView_PosterOnly]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidView_CatMeta">
		<value condition="ListItem.IsParentFolder"></value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[VidView_PlaqueMeta]$INFO[ListItem.Premiered,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,musicvideo)">$VAR[VidView_PlaqueMeta]$INFO[ListItem.Genre,  ·  ,]</value>
		<value>$VAR[VidView_PlaqueMeta]</value>
	</variable>
	<variable name="VidView_CatLine">
		<value condition="ListItem.IsParentFolder">$LOCALIZE[31242]</value>
		<value condition="!String.IsEmpty(ListItem.Plot)">$INFO[ListItem.Plot]</value>
		<value>$VAR[VidView_Credits]</value>
	</variable>

	<!-- A framed picture with fallbacks: the art (scale) when it exists, else the mat art drawn whole (keep) on
	     the dark mount, else the title engraved on the mount. Never an empty frame, never a cropped logo.
	     Use inside a group at the art rect. params: art, has_art, mat, has_mat, label, lit, font -->
	<include name="VidView_SmartFrame">
		<param name="lit">false</param>
		<param name="font">title_30</param>
		<param name="inset">10</param>
		<param name="shadow">true</param>
		<definition>
			<control type="image">
				<left>-64</left>
				<top>-64</top>
				<right>-64</right>
				<bottom>-64</bottom>
				<texture border="64">noc/shadow.png</texture>
				<visible>$PARAM[shadow]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="bg_raised">common/white.png</texture>
			</control>
			<control type="label">
				<left>10</left>
				<right>10</right>
				<top>10</top>
				<bottom>10</bottom>
				<align>center</align>
				<aligny>center</aligny>
				<wrapmultiline>true</wrapmultiline>
				<font>$PARAM[font]</font>
				<textcolor>text_secondary</textcolor>
				<label>$PARAM[label]</label>
				<visible>![$PARAM[has_art]] + ![$PARAM[has_mat]]</visible>
			</control>
			<control type="image">
				<left>$PARAM[inset]</left>
				<top>$PARAM[inset]</top>
				<right>$PARAM[inset]</right>
				<bottom>$PARAM[inset]</bottom>
				<aspectratio>keep</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true">$PARAM[mat]</texture>
				<visible>![$PARAM[has_art]] + [$PARAM[has_mat]] + ![$PARAM[lit]]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true">$PARAM[art]</texture>
				<visible>[$PARAM[has_art]] + ![$PARAM[lit]]</visible>
			</control>
			<control type="image">
				<left>$PARAM[inset]</left>
				<top>$PARAM[inset]</top>
				<right>$PARAM[inset]</right>
				<bottom>$PARAM[inset]</bottom>
				<aspectratio>keep</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" colordiffuse="warm_art">$PARAM[mat]</texture>
				<visible>![$PARAM[has_art]] + [$PARAM[has_mat]] + [$PARAM[lit]]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true" colordiffuse="warm_art">$PARAM[art]</texture>
				<visible>[$PARAM[has_art]] + [$PARAM[lit]]</visible>
			</control>
			<control type="image">
				<left>-16</left>
				<top>-16</top>
				<right>-16</right>
				<bottom>-16</bottom>
				<texture border="16">noc/frame.png</texture>
			</control>
		</definition>
	</include>
	<include name="VidView_PosterFrame">
		<param name="lit">false</param>
		<param name="font">title_30</param>
		<param name="shadow">true</param>
		<definition>
			<include content="VidView_SmartFrame">
