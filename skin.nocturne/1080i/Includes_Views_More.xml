				<param name="mat" value="$INFO[ListItem.Art(thumb)]"/>
				<param name="has_mat" value="$EXP[VidView_HasThumb]"/>
				<param name="label" value="$VAR[VidView_ItemTitle]"/>
				<param name="lit" value="$PARAM[lit]"/>
				<param name="font" value="$PARAM[font]"/>
				<param name="shadow" value="$PARAM[shadow]"/>
				<param name="inset" value="8"/>
			</include>
		</definition>
	</include>
	<include name="VidView_LandFrame">
		<param name="lit">false</param>
		<param name="font">title_30</param>
		<param name="shadow">true</param>
		<definition>
			<include content="VidView_SmartFrame">
				<param name="art" value="$VAR[VidView_LandOnly]"/>
