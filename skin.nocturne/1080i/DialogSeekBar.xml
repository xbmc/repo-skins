<?xml version="1.0" encoding="UTF-8"?>
<!--
	Seek bar: the strip of light and the filament alone (no rail), plus a brass skip plaque top right.
	Id contract (Estuary Omega DialogSeekBar.xml / GUIDialogSeekBar.cpp): 401 = progress slider Kodi selects to the
	seek target (drawn invisible; the filament shows it). Window visibility copied from Estuary Omega.
-->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>![Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(pvrguideinfo)]</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<zorder>0</zorder>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_SeekBarHidden]</visible>
			<visible>!Player.HasGame</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>360</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture>noc/floor_ramp.png</texture>
			</control>
			<include content="Noc_Plaque">
				<param name="left" value="1224"/>
				<param name="top" value="64"/>
				<param name="width" value="600"/>
				<param name="title" value="$VAR[OSD_SkipValue]"/>
				<param name="meta" value="$LOCALIZE[31289]"/>
				<param name="visible" value="[!String.IsEmpty(Player.SeekStepSize) | [!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)]] + Window.IsActive(fullscreenvideo)"/>
			</include>
			<include content="Rail_TitleAndFilament">
				<param name="top" value="892"/>
			</include>
			<control type="slider" id="401">
				<left>96</left>
				<top>1018</top>
				<width>1728</width>
				<height>8</height>
				<texturesliderbar colordiffuse="clear">common/white.png</texturesliderbar>
				<textureslidernib colordiffuse="clear">osd/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="clear">osd/slider_nib.png</textureslidernibfocus>
			</control>
		</control>
	</controls>
</window>
