<?xml version="1.0" encoding="UTF-8"?>
<!--
	Game controller / port / player dialogs (SPEC 5: Minimal). Builder F, M4. Kodi uses this one
	file for the gamecontrollers, gameports and gameagents windows; like Estuary Omega, the variant
	is picked at load with Window.IsDialogTopMost(). Layouts and id contracts: Includes_Misc.xml
	(Misc_GameControllers / Misc_GamePorts / Misc_GameAgents). Back closes.
-->
<window>
	<defaultcontrol always="true">3</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include condition="Window.IsDialogTopMost(gamecontrollers)">Misc_GameControllers</include>
		<include condition="Window.IsDialogTopMost(gameports)">Misc_GamePorts</include>
		<include condition="Window.IsDialogTopMost(gameagents)">Misc_GameAgents</include>
	</controls>
</window>
