<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogVideoInfo = the spotlight (mockup NocturneInfo.html): a tight spot on the poster, a softer second
	light on the wall label (curator's text), actions engraved on a brass rail.
	Kodi ids (Estuary Omega / CGUIDialogVideoInfo): 8 play (from start when 9 exists; browses folders),
	9 resume, 11 trailer, 50 cast (or a collection's films), 6 refresh, 7 user rating, 10 art, 12 fanart,
	13 director, 14 versions, 15 extras, 443 collection.
	Nocturne ids: 9000 rail, 9001 plot (OK = full plot 9200), 9010 More, 9012 Browse, 9013 From start,
	9100 More row (below the rail while focused), 61 full-plot scrollbar.
	Focus: 9001 plot ↑ rail 9000 ↓ cast 50 (the page slides up 440 while the cast has focus).
-->
<includes>
	<expression name="VidInfo_ShowResume">Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowPlay">!Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_ShowTrailer">$EXP[ShowTrailerButton] + !String.IsEmpty(ListItem.Trailer)</expression>
	<expression name="VidInfo_IsStill">String.IsEqual(ListItem.DBType,episode)</expression>

	<variable name="VidInfo_Title">
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="VidInfo_Poster">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- museum line over the title: "ACC. NO. 925 · ACQUIRED 14/02/2021" -->
	<variable name="VidInfo_Kicker">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.TVShowTitle]  ·  $VAR[VidView_EpCode]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$LOCALIZE[31250]$VAR[VidInfo_SetFilms]</value>
		<value>$INFO[ListItem.DBID,$LOCALIZE[31251] ,]$INFO[ListItem.DateAdded,  ·  $LOCALIZE[31252] ,]</value>
	</variable>
	<!-- "Wes Anderson, 2014" -->
	<variable name="VidInfo_Byline">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$LOCALIZE[31272] $INFO[ListItem.Season]$INFO[ListItem.Episode,  ·  $LOCALIZE[31273] ,]$INFO[ListItem.Premiered,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.Studio,,$COMMA ]$INFO[ListItem.Year]</value>
		<value condition="!String.IsEmpty(ListItem.Director)">$INFO[ListItem.Director]$INFO[ListItem.Year,$COMMA ,]</value>
		<value>$INFO[ListItem.Year]</value>
	</variable>
	<variable name="VidInfo_Meta">
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$VAR[VidInfo_Seasons]$VAR[VidInfo_Episodes]$INFO[ListItem.Genre,  ·  ,]$INFO[ListItem.Rating,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$VAR[VidInfo_Episodes4]$INFO[ListItem.Property(WatchedEpisodes),  ·  , $LOCALIZE[31253]]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Genre]</value>
		<value>$INFO[ListItem.Duration(mins),, $LOCALIZE[31221]]$INFO[ListItem.Genre,  ·  ,]$INFO[ListItem.MPAA,  ·  ,]$INFO[ListItem.Rating,  ·  ,]</value>
	</variable>
	<variable name="VidInfo_With">
		<value condition="String.IsEqual(ListItem.DBType,set)"></value>
		<value condition="!String.IsEmpty(ListItem.Cast)">$LOCALIZE[31254] $INFO[Container(50).ListItemAbsolute(0).Label]$INFO[Container(50).ListItemAbsolute(1).Label,$COMMA ,]$INFO[Container(50).ListItemAbsolute(2).Label,$COMMA ,]$INFO[Container(50).ListItemAbsolute(3).Label,$COMMA ,…]</value>
	</variable>
	<variable name="VidInfo_Status">
		<value condition="$EXP[VidView_IsFolderType]">$VAR[VidView_Status]</value>
		<value condition="!String.IsEmpty(ListItem.EndTime) + ListItem.IsResumable">$VAR[VidView_Status]  ·  $LOCALIZE[31255] $INFO[ListItem.EndTimeResume]</value>
		<value condition="!String.IsEmpty(ListItem.EndTime)">$VAR[VidView_Status]  ·  $LOCALIZE[31255] $INFO[ListItem.EndTime]</value>
		<value>$VAR[VidView_Status]</value>
	</variable>
	<variable name="VidInfo_Flags">
		<value>$VAR[VidInfo_FlagRes]$INFO[ListItem.HdrType,  ·  ,]$VAR[VidInfo_FlagAudio]</value>
	</variable>
	<variable name="VidInfo_FlagRes">
		<value condition="String.IsEqual(ListItem.VideoResolution,4K) | String.IsEqual(ListItem.VideoResolution,2160)">4K</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,1080)">1080P</value>
		<value condition="String.IsEqual(ListItem.VideoResolution,720)">720P</value>
		<value condition="!String.IsEmpty(ListItem.VideoResolution)">SD</value>
	</variable>
	<variable name="VidInfo_FlagAudio">
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd_atmos) | String.IsEqual(ListItem.AudioCodec,eac3_ddp_atmos)">  ·  ATMOS</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma_x) | String.IsEqual(ListItem.AudioCodec,dtshd_ma_x_imax)">  ·  DTS:X</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,dtshd_ma) | String.IsEqual(ListItem.AudioCodec,dtsma)">  ·  DTS-HD MA</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,truehd)">  ·  TRUEHD</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,eac3)">  ·  DD+</value>
		<value condition="String.IsEqual(ListItem.AudioCodec,ac3)">  ·  DD</value>
	</variable>
	<variable name="VidInfo_CastHeader">
		<value condition="String.IsEqual(ListItem.DBType,set)">$LOCALIZE[31256]</value>
		<value>$LOCALIZE[31271]</value>
	</variable>
	<variable name="VidInfo_CastArt">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="VidInfo_CastLine2">
		<value condition="String.IsEqual(ListItem.DBType,movie)">$INFO[ListItem.Year]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<variable name="VidInfo_Crumb">
		<value condition="String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,set)">$LOCALIZE[31200]</value>
		<value condition="String.IsEqual(ListItem.DBType,musicvideo)">$LOCALIZE[20389]</value>
		<value condition="!String.IsEmpty(ListItem.DBType)">$LOCALIZE[31201]</value>
		<value>$LOCALIZE[3]</value>
	</variable>
	<variable name="VidInfo_Crumb2">
		<value condition="Window.IsVisible(home) + String.StartsWith(Window(Home).Property(nocturne.slot),a)">·   $LOCALIZE[31210]</value>
		<value condition="Window.IsVisible(home) + String.StartsWith(Window(Home).Property(nocturne.slot),b) + String.IsEqual(Window(Home).Property(nocturne.section),series)">·   $LOCALIZE[31213]</value>
		<value condition="Window.IsVisible(home) + String.StartsWith(Window(Home).Property(nocturne.slot),b)">·   $LOCALIZE[31211]</value>
		<value condition="Window.IsVisible(home) + String.StartsWith(Window(Home).Property(nocturne.slot),c) + String.IsEqual(Window(Home).Property(nocturne.section),series)">·   $LOCALIZE[31214]</value>
		<value condition="Window.IsVisible(home) + String.StartsWith(Window(Home).Property(nocturne.slot),c)">·   $LOCALIZE[31212]</value>
		<value condition="!Window.IsVisible(home) + !String.IsEmpty(Container.FolderName)">·   $INFO[Container.FolderName]</value>
	</variable>

	<!-- ============================================================ the rail -->
	<!-- One engraved word on the brass rail. params: id, label, onclick, visible, sep (separator before it) -->
	<include name="VidInfo_RailWord">
		<param name="onclick">noop</param>
		<param name="visible">true</param>
		<param name="width">232</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>64</height>
				<font>btn_22</font>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>0</textoffsetx>
				<textcolor>brass_word</textcolor>
				<focusedcolor>ink</focusedcolor>
				<texturenofocus>noc/rail_mid.png</texturenofocus>
				<texturefocus border="30,0,30,0">noc/rail_on.png</texturefocus>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<onup condition="Control.IsVisible(9001)">9001</onup>
				<ondown condition="Integer.IsGreater(Container(50).NumItems,0)">50</ondown>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<include name="VidInfo_RailSep">
		<control type="image" id="$PARAM[id]">
			<width>3</width>
			<height>64</height>
			<texture>noc/rail_sep_tall.png</texture>
			<visible>$PARAM[visible]</visible>
		</control>
	</include>

