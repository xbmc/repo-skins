<?xml version="1.0" encoding="UTF-8"?>
<!--
	Manage video versions / extras (Kodi 21, opened from DialogVideoInfo buttons 14 / 15).
	SPEC 5: Minimal treatment (Noc_GenericDialog). Builder B.
	Kodi id contract (Estuary Omega DialogVideoManager.xml): heading 2, list 50 (+ scrollbar 60)
	inside group 100, button grouplist 101 with 21 play, 22 add version, 23 add extra, 27 choose art,
	24 set default, 28 rename, 26 remove, 25 choose version type (22/24/25 versions only, 23/28 extras only).
-->
<window>
	<defaultcontrol always="true">101</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1500</width>
			<height>780</height>
			<include content="Noc_GenericDialog">
				<param name="width" value="1500"/>
				<param name="height" value="780"/>
				<param name="header_id" value="2"/>
			</include>
			<!-- poster of the movie -->
			<control type="group">
				<left>dialog_pad</left>
				<top>dialog_content_top</top>
				<width>280</width>
				<height>420</height>
				<include content="VidView_ArtFallback">
					<param name="label_visible" value="false"/>
				</include>
				<include content="VidView_ArtImage">
					<param name="art" value="$VAR[ListItemArt]"/>
				</include>
			</control>
			<control type="group" id="100">
				<left>360</left>
				<top>dialog_content_top</top>
				<control type="list" id="50">
					<left>0</left>
					<top>0</top>
					<width>760</width>
					<height>576</height>
					<onup>50</onup>
					<ondown>50</ondown>
					<onleft>101</onleft>
					<onright>60</onright>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<include content="Noc_ListLayout">
						<param name="width" value="760"/>
						<param name="height" value="64"/>
						<param name="list_id" value="50"/>
					</include>
				</control>
				<include content="Noc_Scrollbar">
					<param name="id" value="60"/>
					<param name="left" value="772"/>
					<param name="top" value="0"/>
					<param name="height" value="576"/>
					<param name="onleft" value="50"/>
					<param name="onright" value="101"/>
				</include>
			</control>
			<control type="label">
				<left>360</left>
				<top>712</top>
				<width>1100</width>
				<height>30</height>
				<font>caps_20</font>
				<textcolor>text_tertiary</textcolor>
				<label>$INFO[Container(50).ListItem.FileNameAndPath]</label>
			</control>
			<control type="grouplist" id="101">
				<left>1160</left>
				<top>dialog_content_top</top>
				<width>300</width>
				<height>600</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft condition="Integer.IsGreater(Container(50).NumItems,0)">50</onleft>
				<onleft condition="!Integer.IsGreater(Container(50).NumItems,0)">noop</onleft>
				<onright>noop</onright>
				<include content="Noc_DialogButton">
					<param name="id" value="21"/>
					<param name="label" value="$LOCALIZE[208]"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="22"/>
					<param name="label" value="$LOCALIZE[40014]"/>
					<param name="visible" value="Window.IsVisible(managevideoversions)"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="23"/>
					<param name="label" value="$LOCALIZE[40015]"/>
					<param name="visible" value="Window.IsVisible(managevideoextras)"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="27"/>
					<param name="label" value="$LOCALIZE[13511]"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="24"/>
					<param name="label" value="$LOCALIZE[40004]"/>
					<param name="visible" value="Window.IsVisible(managevideoversions)"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="28"/>
					<param name="label" value="$LOCALIZE[118]"/>
					<param name="visible" value="Window.IsVisible(managevideoextras)"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="26"/>
					<param name="label" value="$LOCALIZE[15015]"/>
				</include>
				<include content="Noc_DialogButton">
					<param name="id" value="25"/>
					<param name="label" value="$LOCALIZE[40023]"/>
					<param name="visible" value="Window.IsVisible(managevideoversions)"/>
				</include>
			</control>
		</control>
	</controls>
</window>
