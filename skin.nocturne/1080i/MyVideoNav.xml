<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library (SPEC 5/6, Builder B). Mockups: Movies.dc (500), MoviesPoster.dc (501), TV.dc (502).
	Includes: Includes_Views_Video.xml (VidView_*), View_50_List from Includes_Views.xml.

	Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav, Omega source):
	  <views> containers 500/501/502/503/50 (first visible one is the default for a new node, so
	  movies/sets open in 500, tvshows/seasons in 502, episodes in 503, everything else in 50);
	  menucontrol 9000 (header filter bar); 3 sort-by / 4 sort-order (hidden buttons the bar clicks);
	  14 watched toggle (SendClick only, no control needed); defaultcontrol 50 = Kodi focuses the
	  active view. Nocturne ids: 9310 Next up strip, 9321-9326 header buttons, 63 scrollbar of 503.

	Focus map: header 9000 ↓ Next up 9310 (TV root, when it has items) ↓ view. View ↑ (top row)
	→ Next up or header. Back = Kodi parent folder; Back on the header returns to the view.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>bg</backgroundcolor>
	<views>500,501,503,50,502,506,507</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the header bar instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
