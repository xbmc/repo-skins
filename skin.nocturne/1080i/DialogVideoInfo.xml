<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information = the spotlight (Includes_VideoInfo.xml; mockup NocturneInfo.html).
	Movie, episode, TV show, season and collection share one page; texts switch on ListItem.DBType.
	Focus: rail 9000 (default) ↑ plot 9001 (OK = full text 9200) ↓ cast 50 (page slides up 440).
	More (9010) -> row 9100 under the rail; Up / Back return to More. Back closes the dialog.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>Noc_Wall</include>
		<control type="group">
			<description>page (slides up while the cast row has focus)</description>
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(nocturne.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="200" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(nocturne.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-440" time="0"/>
			</animation>
			<include>Noc_CorniceImage</include>
			<include>VidInfo_Picture</include>
			<include>VidInfo_Label</include>
			<include>VidInfo_Rail</include>
			<include>VidInfo_MoreRow</include>
			<include>VidInfo_Cast</include>
			<include content="Noc_Crumbs">
				<param name="first" value="$VAR[VidInfo_Crumb]"/>
				<param name="second" value="$VAR[VidInfo_Crumb2]"/>
				<param name="glow" value="35"/>
			</include>
			<include>Noc_Clock</include>
		</control>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
