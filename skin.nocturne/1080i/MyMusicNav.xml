<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library = the listening room (Includes_Views_Music.xml, Includes_Gallery.xml).
	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp): views in <views>, menucontrol 9000,
	3 sort by, 4 sort order (hidden, clicked by the option words). Reserved by Kodi: 2, 5, 8, 12, 15, 16, 17, 19, 20.
	Nocturne ids: 9320-9326 tab / option words (grouplist 9000), 60 list scrollbar.
	Tabs use ReplaceWindow(Music,<node>,return): the new node becomes the start folder, so Back leaves in one press.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>bg</backgroundcolor>
	<views>504,505,50,508</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Noc_Wall</include>
		<control type="group">
			<visible>Control.IsVisible(50) | Integer.IsEqual(Container.NumItems,0)</visible>
			<include content="Noc_ShroudStatic">
				<param name="texture" value="noc/shroud_page.png"/>
			</include>
		</control>
		<include>Music_View_504</include>
		<include>Music_View_505</include>
		<include>Music_View_50</include>
		<include>Music_View_508</include>
		<control type="group">
			<!-- not over the listening room's ".." record (504) -->
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating + [!Container.HasParent | !Control.IsVisible(504)]</visible>
			<control type="label">
				<left>0</left>
				<top>460</top>
				<width>1920</width>
				<height>60</height>
				<align>center</align>
				<font>title_48</font>
				<textcolor>text_secondary</textcolor>
				<label>$LOCALIZE[31248]</label>
			</control>
		</control>
		<include content="Noc_NowPlayingRail">
			<param name="visible" value="Player.HasMedia"/>
		</include>
		<include>Noc_CorniceImage</include>
		<include content="Noc_Crumbs">
			<param name="first" value="$LOCALIZE[31202]"/>
			<param name="second" value="$VAR[Music_Crumb2]"/>
		</include>
		<include>Noc_Clock</include>
		<include>Music_HeaderBar</include>
		<include content="Lib_Panel">
			<param name="is_video" value="false"/>
			<param name="kind" value="music"/>
			<param name="section" value="$LOCALIZE[31202]"/>
			<param name="view_name" value="$VAR[Music_ViewName]"/>
			<param name="order_click" value="Container.SetSortDirection"/>
			<param name="pick_focus" value="Lib_PickFocusMusic"/>
		</include>
		<include content="Lib_Picker">
			<param name="items" value="Lib_PickerMusic"/>
			<param name="section" value="$LOCALIZE[31202]"/>
		</include>
	</controls>
</window>
