		<animation effect="fade" start="100" end="0" time="140" tween="cubic" easing="out" condition="![$PARAM[show]] + !Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
		<animation effect="fade" start="100" end="0" time="60" condition="![$PARAM[show]] + Skin.HasSetting(nocturne.reducemotion)">Conditional</animation>
	</include>
