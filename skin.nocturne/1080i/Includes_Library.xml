	<!-- video: Corridor 500, Salon 501 (films, sets, series, seasons, music videos, genres / years / people), Stills 503 (episodes), Vitrine 502 +
	     Catalogue 507 (library and add-on listings), Panorama 506 and List 50 (everything) -->
	<!-- picker focus on the view that is hanging (absolute positions of the visible items: Corridor, Salon, Stills,
	     Vitrine, Panorama, Catalogue, List; music Listening room, Record bins, Portraits, List) -->
	<include name="Lib_PickFocusVideo">
		<onclick condition="Control.IsVisible(500) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(501) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,1,absolute)</onclick>
		<onclick condition="Control.IsVisible(502) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(506) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,3,absolute)</onclick>
		<onclick condition="Control.IsVisible(507) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,4,absolute)</onclick>
		<onclick condition="Control.IsVisible(50) + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)]">SetFocus(9851,5,absolute)</onclick>
		<onclick condition="Control.IsVisible(503) + Container.Content(episodes)">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(502) + Container.Content(episodes)">SetFocus(9851,1,absolute)</onclick>
		<onclick condition="Control.IsVisible(506) + Container.Content(episodes)">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(507) + Container.Content(episodes)">SetFocus(9851,3,absolute)</onclick>
		<onclick condition="Control.IsVisible(50) + Container.Content(episodes)">SetFocus(9851,4,absolute)</onclick>
		<onclick condition="Control.IsVisible(502) + $EXP[VidView_ShowVitrine] + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + !Container.Content(episodes)">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(506) + $EXP[VidView_ShowVitrine] + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + !Container.Content(episodes)">SetFocus(9851,1,absolute)</onclick>
		<onclick condition="Control.IsVisible(507) + $EXP[VidView_ShowVitrine] + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + !Container.Content(episodes)">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(50) + $EXP[VidView_ShowVitrine] + ![Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos)] + !Container.Content(episodes)">SetFocus(9851,3,absolute)</onclick>
		<onclick condition="Control.IsVisible(501) + $EXP[VidView_IsNode]">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(506) + $EXP[VidView_IsNode]">SetFocus(9851,1,absolute)</onclick>
		<onclick condition="Control.IsVisible(50) + $EXP[VidView_IsNode]">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(506) + !$EXP[VidView_ShowVitrine] + !$EXP[VidView_IsNode]">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(50) + !$EXP[VidView_ShowVitrine] + !$EXP[VidView_IsNode]">SetFocus(9851,1,absolute)</onclick>
