		<onleft>SetProperty(noc.lib.from,view,home)</onleft>
		<onleft>SetFocus(9801,0,absolute)</onleft>
	</include>
	<include name="Lib_OpenRight">
		<onright>SetProperty(noc.lib.from,view,home)</onright>
		<onright>SetFocus(9801,0,absolute)</onright>
	</include>

