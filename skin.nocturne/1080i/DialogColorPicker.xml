<?xml version="1.0" encoding="UTF-8"?>
<!--
	Colour picker (Kodi / add-on colour settings; Nocturne's accent uses its own swatches).
	SPEC 5: Minimal, Noc_GenericDialog. Builder F, M4.
	Kodi id contract (Estuary Omega DialogColorPicker.xml / GUIDialogColorPicker): heading 1,
	colour panel 6 (ListItem.Label = name, Label2 = AARRGGBB), scrollbar 61, cancel button 7 in
	grouplist 9001.
-->
<window>
	<defaultcontrol always="true">6</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1260</width>
			<height>820</height>
			<include content="Noc_GenericDialog">
				<param name="width" value="1260"/>
				<param name="height" value="820"/>
				<param name="header_id" value="1"/>
			</include>
			<control type="panel" id="6">
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>880</width>
				<height>640</height>
				<onup>6</onup>
				<ondown>6</ondown>
				<onleft>9001</onleft>
				<onright>9001</onright>
				<orientation>vertical</orientation>
				<pagecontrol>61</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="100">icon</viewtype>
				<itemlayout width="146" height="80">
					<control type="image">
						<left>10</left>
						<top>8</top>
						<width>126</width>
						<height>64</height>
						<texture colordiffuse="bg_raised">common/white.png</texture>
					</control>
					<control type="image">
						<left>10</left>
						<top>8</top>
						<width>126</width>
						<height>64</height>
						<texture>common/white.png</texture>
						<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
					</control>
				</itemlayout>
				<focusedlayout width="146" height="80">
					<control type="group">
						<left>10</left>
						<top>8</top>
						<width>126</width>
						<height>64</height>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>126</width>
							<height>64</height>
							<texture colordiffuse="bg_raised">common/white.png</texture>
						</control>
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>126</width>
							<height>64</height>
							<texture>common/white.png</texture>
							<colordiffuse>$INFO[ListItem.Label2]</colordiffuse>
						</control>
						<include content="Noc_FocusFrameAlways">
							<param name="visible" value="Control.HasFocus(6)"/>
						</include>
					</control>
				</focusedlayout>
			</control>
			<include content="Noc_Scrollbar">
				<param name="id" value="61"/>
				<param name="left" value="916"/>
				<param name="top" value="dialog_content_top"/>
				<param name="height" value="640"/>
				<param name="onleft" value="6"/>
				<param name="onright" value="9001"/>
			</include>
			<control type="label">
				<left>dialog_pad</left>
				<top>764</top>
				<width>880</width>
				<height>36</height>
				<font>num_20</font>
				<textcolor>text_secondary</textcolor>
				<label>$INFO[Container(6).ListItem.Label]$INFO[Container(6).ListItem.Label2,  ·  #,]</label>
			</control>
			<control type="grouplist" id="9001">
				<left>944</left>
				<top>dialog_content_top</top>
				<width>280</width>
				<height>200</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>6</onleft>
				<onright>6</onright>
				<include content="Noc_DialogButton">
					<param name="id" value="7"/>
					<param name="width" value="280"/>
					<param name="label" value="$LOCALIZE[222]"/>
				</include>
			</control>
		</control>
	</controls>
</window>
