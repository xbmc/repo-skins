<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Nocturne / Home "New acquisitions" count: films added in the last 30 days. -->
<smartplaylist type="movies">
    <name>New acquisitions</name>
    <match>all</match>
    <rule field="dateadded" operator="inthelast">
        <value>30 days</value>
    </rule>
</smartplaylist>
