<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Nocturne / Home Series "New episodes" count: unwatched episodes added in the last 30 days. -->
<smartplaylist type="episodes">
    <name>New episodes</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="dateadded" operator="inthelast">
        <value>30 days</value>
    </rule>
</smartplaylist>
