<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Nocturne / Home spotlight. Random unwatched films that show as 7.5+ in the UI.
     rating > 7.449 so a stored 7.45-7.499 (displayed "7.5") is included; votes > 50 drops
     1-vote outliers. No art rules exist in xsp: the skin handles missing fanart/clearlogo. -->
<smartplaylist type="movies">
    <name>Nocturne spotlight</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
    <rule field="votes" operator="greaterthan">
        <value>50</value>
    </rule>
    <limit>5</limit>
    <order direction="ascending">random</order>
</smartplaylist>
