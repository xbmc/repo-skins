<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Nocturne / Home Series "Unseen, 7.5+": shows with no watched episode, rated 7.5 or more (the skin sorts random). -->
<smartplaylist type="tvshows">
    <name>Unseen, 7.5+</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="inprogress" operator="false" />
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
</smartplaylist>
