<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Nocturne / native Next-up fallback: shows started but not finished, most recently watched first.
     Used when script.embuary.helper is missing. Items are SHOWS, not episodes. -->
<smartplaylist type="tvshows">
    <name>Shows in progress</name>
    <match>all</match>
    <rule field="inprogress" operator="true" />
    <order direction="descending">lastplayed</order>
</smartplaylist>
