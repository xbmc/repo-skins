<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Passe-partout / Home room (Series): shows with episodes added lately. -->
<smartplaylist type="tvshows">
    <name>Recently acquired</name>
    <match>all</match>
    <limit>15</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
