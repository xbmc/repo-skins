<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Passe-partout / Home exhibition (Films): twelve unwatched films rated 6.5+, drawn at random. -->
<smartplaylist type="movies">
    <name>Unwatched, drawn at random</name>
    <match>all</match>
    <rule field="playcount" operator="is"><value>0</value></rule>
    <rule field="rating" operator="greaterthan"><value>6.5</value></rule>
    <limit>12</limit>
    <order direction="ascending">random</order>
</smartplaylist>
