<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Passe-partout / Home exhibition (Films): unwatched, best rated first. rating > 7.449 so a stored
     7.45 (shown "7.5") counts; votes > 50 drops 1-vote outliers. -->
<smartplaylist type="movies">
    <name>Unwatched, best rated</name>
    <match>all</match>
    <rule field="playcount" operator="is"><value>0</value></rule>
    <rule field="rating" operator="greaterthan"><value>7.449</value></rule>
    <rule field="votes" operator="greaterthan"><value>50</value></rule>
    <limit>12</limit>
    <order direction="descending">rating</order>
</smartplaylist>
