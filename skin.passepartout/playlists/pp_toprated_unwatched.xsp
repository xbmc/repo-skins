<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Passe-partout / Movies widget 03 "Top rated, unwatched". Same pool as the spotlight, best first. -->
<smartplaylist type="movies">
    <name>Top rated, unwatched</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
    <rule field="votes" operator="greaterthan">
        <value>50</value>
    </rule>
    <limit>25</limit>
    <order direction="descending">rating</order>
</smartplaylist>
