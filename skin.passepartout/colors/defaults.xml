<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.passepartout · paper and ink. Source of truth: docs/skin.passepartout/DESIGN.md
    (values from the approved mockups docs/concepts/mockups/Passepartout*.dc.html).
    Format AARRGGBB. Names are lowercase.

    The LIVE paper is not a colour here: it is TMDb Helper's
    Window(Home).Property(TMDbHelper.ListItem.Colors.Main) used as colordiffuse on a white
    texture (PP_Background). `paper` below is the fallback (neutral) paper.
    Secondary text is alpha ink where it sits on art-coloured paper so it takes the paper's hue;
    the solid values are the mockup tokens on the fallback paper.
-->
<colors>
    <!-- Paper -->
    <color name="paper">ffeeeae3</color>          <!-- fallback / "neutral paper" -->
    <color name="card">fff7f4ef</color>           <!-- dialog card paper (lighter than the page) -->
    <color name="card_edge">ffffffff</color>
    <color name="card_lift">66ffffff</color>      <!-- white 40% over the paper = the dialog card -->
    <color name="rule_card">1a1c1b19</color>      <!-- card edge 10% ink -->
    <color name="rule_mat">121c1b19</color>       <!-- the wall's mat edge 7% ink -->
    <color name="rule_row">1f1c1b19</color>       <!-- row rules 12% -->
    <color name="rule_div">241c1b19</color>       <!-- settings divider 14% -->
    <color name="rule_track">381c1b19</color>     <!-- progress track 22% -->
    <color name="rule_hair">401c1b19</color>      <!-- 25% -->
    <color name="wash">0f1c1b19</color>           <!-- 6% ink: quiet fills (unfocused fields, tracks) -->
    <color name="wash_strong">1f1c1b19</color>    <!-- 12% ink -->

    <!-- Ink -->
    <color name="ink">ff1c1b19</color>            <!-- titles, focused words, placard fill -->
    <color name="body">ff3a3834</color>           <!-- curator text (plot) -->
    <color name="ink2">ff5f5b55</color>           <!-- secondary (token 6E6A63 darkened: >= 4.5:1 on every art paper at L .86 / S .22) -->
    <color name="ink3">6b1c1b19</color>           <!-- 42% ink: faint counter, hints -->
    <color name="on_ink">fff2eee8</color>         <!-- text on the ink placard -->
    <color name="disabled">591c1b19</color>       <!-- 35% ink -->

    <!-- Lines -->
    <color name="rule">2e1c1b19</color>           <!-- 18% ink: hairline track (now-playing line) -->
    <color name="rule_strong">4d1c1b19</color>    <!-- 30% ink -->

    <!-- Veils and shadows -->
    <color name="veil">9e1c1b19</color>           <!-- dim behind dialog cards: ink 62% (tokens) -->
    <color name="veil_video">8c14130f</color>     <!-- over moving video behind OSD cards (55% dark) -->
    <color name="video_dim">8c14130f</color>
    <color name="shade">ff1c1b19</color>
    <color name="shadow">ff4a443c</color>         <!-- tint for baked shadows when the paper colour is unknown -->

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
</colors>
