<?xml version="1.0" encoding="UTF-8"?>
<!--
	In-game OSD (SPEC 5: Minimal, "must close on Back"). Builder F, M4.
	Kodi id contract (Estuary Omega GameOSD.xml / DialogGameOSDHelp): group 1 (hidden while a game
	sub-dialog is open), help group 10 with help textbox 1101 (Kodi writes the text and treats the
	help as shown while 1101 is visible), menu group 20 with list 1103 + scrollbar 2200, headings 2 / 3.
	Passe-partout differences: the menu list stays focusable underneath the help (it is only faded out), so
	when the first Back hides the help (Kodi consumes that press) focus is already on the menu; the
	next Back closes the OSD. Estuary's Settings item opened its own Custom_1101 list, which Passe-partout
	omits, so the game settings windows are listed directly.
-->
<window>
	<defaultcontrol always="true">1103</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group" id="1">
			<visible>!Window.IsActive(GameVideoFilter) + !Window.IsActive(GameStretchMode) + !Window.IsActive(GameControllers) + !Window.IsActive(GameVideoRotation) + !Window.IsActive(InGameSaves) + !Window.IsActive(GameAgents) + !Window.IsActive(GameVolume) + !Window.IsActive(GamePorts) + !Window.IsActive(GameAdvancedSettings)</visible>
			<include>Anim_FadeVisible</include>
			<!-- ====== menu -->
			<control type="group" id="20">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>760</width>
				<height>960</height>
				<animation effect="fade" start="100" end="0" time="0" condition="System.GetBool(gamesgeneral.showosdhelp)">Conditional</animation>
				<include content="PP_GenericDialog">
					<param name="width" value="760"/>
					<param name="height" value="960"/>
					<param name="header_id" value="3"/>
					<param name="header_label" value="$LOCALIZE[35221]"/>
				</include>
				<control type="group" id="2000">
					<control type="list" id="1103">
						<left>dialog_inset</left>
						<top>dialog_content_top</top>
						<width>700</width>
						<height>832</height>
						<onup>1103</onup>
						<ondown>1103</ondown>
						<onleft>noop</onleft>
						<onright>noop</onright>
						<pagecontrol>2200</pagecontrol>
						<scrolltime tween="cubic" easing="out">200</scrolltime>
						<orientation>vertical</orientation>
						<include content="PP_ListLayout">
							<param name="width" value="700"/>
							<param name="height" value="dialog_row_h"/>
							<param name="list_id" value="1103"/>
						</include>
						<content>
							<item>
								<label>$LOCALIZE[35224]</label>
								<label2>$FEATURE[select,game.controller.snes] + $FEATURE[x,game.controller.default]</label2>
								<onclick>Play</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35249]</label>
								<onclick>ActivateWindow(InGameSaves)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35172]</label>
								<onclick>ActivateWindow(GameAgents)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[13007]</label>
								<onclick>PlayerControl(Reset)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35222]</label>
								<label2>$FEATURE[select,game.controller.snes] + $FEATURE[start,game.controller.default]</label2>
								<onclick>Stop</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35225]</label>
								<onclick>ActivateWindow(GameVideoFilter)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35233]</label>
								<onclick>ActivateWindow(GameStretchMode)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35227]</label>
								<onclick>ActivateWindow(GameVideoRotation)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[13376]</label>
								<onclick>ActivateWindow(GameVolume)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35234]</label>
								<onclick>ActivateWindow(GameControllers)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35110]</label>
								<onclick>ActivateWindow(GamePorts)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[35226]</label>
								<onclick>ActivateWindow(GameAdvancedSettings)</onclick>
							</item>
						</content>
					</control>
					<include content="PP_Scrollbar">
						<param name="id" value="2200"/>
						<param name="left" value="736"/>
						<param name="top" value="dialog_content_top"/>
						<param name="height" value="832"/>
					</include>
				</control>
			</control>
			<!-- ====== help overlay (first Back hides it) -->
			<control type="group" id="10">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>760</width>
				<height>960</height>
				<visible>System.GetBool(gamesgeneral.showosdhelp)</visible>
				<include>Anim_FadeVisible</include>
				<include content="PP_GenericDialog">
					<param name="width" value="760"/>
					<param name="height" value="960"/>
					<param name="header_id" value="2"/>
					<param name="header_label" value="$LOCALIZE[35221]"/>
				</include>
				<control type="group" id="1000">
					<control type="group" id="1100">
						<control type="textbox" id="1101">
							<description>Help text (Kodi)</description>
							<left>dialog_pad</left>
							<top>dialog_content_top</top>
							<width>680</width>
							<height>130</height>
							<font>body_24</font>
						</control>
						<control type="gamecontroller">
							<left>dialog_pad</left>
							<top>250</top>
							<width>680</width>
							<height>520</height>
							<controllerid>game.controller.snes</controllerid>
						</control>
						<control type="textbox">
							<left>dialog_pad</left>
							<top>790</top>
							<width>680</width>
							<height>89</height>  <!-- 3 lines exactly: no half-clipped line at the bottom -->
							<font>body_20</font>
							<textcolor>ink2</textcolor>
							<label>$LOCALIZE[35236]</label>
						</control>
						<control type="label">
							<left>dialog_pad</left>
							<top>900</top>
							<width>680</width>
							<height>36</height>
							<font>cap_20</font>
							<textcolor>ink3</textcolor>
							<label>$LOCALIZE[31175]</label>
						</control>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
