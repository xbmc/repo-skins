<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults. Focus language: the ink placard (solid ink block, text in the paper colour).
	No outlines anywhere. Colours are names from colors/defaults.xml or $VAR[PaperColor].
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<selectedcolor>ink</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<alttexturefocus colordiffuse="ink">common/white.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<radiowidth>40</radiowidth>
		<radioheight>22</radioheight>
		<textureradioonfocus colordiffuse="$VAR[PaperColor]">pp/switch_on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="ink">pp/switch_on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="$VAR[PaperColor]">pp/switch_off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="ink2">pp/switch_off.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="disabled">pp/switch_on.png</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="disabled">pp/switch_off.png</textureradiooffdisabled>
		<textoffsetx>28</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="ink2">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="ink2" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[PaperColor]">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[PaperColor]" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>28</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>ink</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="ink2">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="ink2" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="ink">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="ink" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>12</sliderheight>
		<texturesliderbar colordiffuse="rule_track">pp/slider_track.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="disabled">pp/slider_track.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink">pp/slider_nib.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[PaperColor]">pp/slider_nib.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">pp/slider_nib.png</textureslidernibdisabled>
		<textoffsetx>28</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="rule_track">pp/slider_track.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="disabled">pp/slider_track.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink2">pp/slider_nib.png</textureslidernib>
		<textureslidernibfocus colordiffuse="ink">pp/slider_nib.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">pp/slider_nib.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="disabled">common/white.png</texturecolordisabledmask>
		<textoffsetx>28</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[PaperColor]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<invalidcolor>ink2</invalidcolor>
		<texturefocus colordiffuse="ink">common/white.png</texturefocus>
		<texturenofocus border="1" colordiffuse="rule">pp/frame_1.png</texturenofocus>
		<textoffsetx>28</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="rule_track">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="ink">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="rule">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="ink2">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="ink">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
