<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: booleans used in more than one place. Use as $EXP[Name].
	Skin settings: docs/skin.passepartout/SETTINGS.md (an empty string / unset bool = the default).
-->
<includes>
	<!-- Helpers -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>
	<!-- the art-coloured paper is live: add-on present, not set to neutral, a colour has arrived -->
	<expression name="PP_HasArtPaper">System.AddonIsEnabled(plugin.video.themoviedb.helper) + !Skin.HasSetting(passepartout.neutralpaper) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Colors.Main))</expression>
	<expression name="PP_ArtPaperOn">System.AddonIsEnabled(plugin.video.themoviedb.helper) + !Skin.HasSetting(passepartout.neutralpaper)</expression>

	<!-- Forked Majan switches that Passe-partout fixes to one value -->
	<expression name="IsRounded">false</expression>
	<expression name="FocusOutlineOff">true</expression>
	<expression name="FocusOutlineMedium">false</expression>
	<expression name="ArtBackgroundOn">false</expression>

	<!-- Settings -->
	<expression name="ShowTrailerButton">!Skin.HasSetting(passepartout.hidetrailer)</expression>
	<expression name="ShowUnwatchedMarkers">!Skin.HasSetting(passepartout.nowatched)</expression>
	<expression name="ShowWatchedMarkers">!Skin.HasSetting(passepartout.nowatched)</expression>
	<expression name="ReduceMotion">Skin.HasSetting(passepartout.reducemotion)</expression>

	<!-- Items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>

	<!-- Windows -->
	<expression name="InfoDialogActive">Window.IsVisible(movieinformation) | Window.IsVisible(musicinformation) | Window.IsVisible(addoninformation)</expression>
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>
</includes>
