<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings hub (window "settings"), mockup PassepartoutSettings: the index of the room on the left
	(list 9000, Geist 30 / 40, the ink placard on focus), the page on the right (title in Geist Light 96,
	what the entry holds, a few facts about the system). No Kodi-owned ids; entries from Estuary Omega.
-->
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>paper</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>PP_Background</include>
		<include content="PP_Crumbs">
			<param name="a" value="Settings"/>
		</include>
		<control type="list" id="9000">
			<left>100</left>
			<top>162</top>
			<width>460</width>
			<height>832</height>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="PP_IndexLayout"><param name="list_id" value="9000"/></include>
			<content>
				<item>
					<label>$LOCALIZE[31021]</label>
					<label2>$LOCALIZE[31135]</label2>
					<property name="help">Passe-partout's own options: the paper (art colour, luminance, saturation, shadow), the exhibition, watched dots, the OSD and motion.</property>
					<onclick>ActivateWindow(skinsettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14200]</label>
					<label2>$LOCALIZE[31208]</label2>
					<property name="help">Video and music playback, refresh-rate matching, subtitle languages and look, discs.</property>
					<onclick>ActivateWindow(PlayerSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14211]</label>
					<label2>$LOCALIZE[31209]</label2>
					<property name="help">Library behaviour, scrapers, file lists, artwork and what OK does on an item.</property>
					<onclick>ActivateWindow(MediaSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14206]</label>
					<label2>$LOCALIZE[31210]</label2>
					<property name="help">Skin, colours, fonts, region and language, screensaver. Switch to another skin here: Skin > Skin.</property>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[24001]</label>
					<label2>$LOCALIZE[31211]</label2>
					<property name="help">Browse, update, configure or install add-ons.</property>
					<onclick>ActivateWindow(addonbrowser)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14036]</label>
					<label2>$LOCALIZE[31212]</label2>
					<property name="help">Web server and JSON-RPC control, UPnP, AirPlay, Zeroconf, SMB client.</property>
					<onclick>ActivateWindow(ServiceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13000]</label>
					<label2>$LOCALIZE[31213]</label2>
					<property name="help">Display, audio output and passthrough, input, power saving, logging.</property>
					<onclick>ActivateWindow(SystemSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[10003]</label>
					<label2>$LOCALIZE[31214]</label2>
					<property name="help">Copy, move and delete files; add network sources.</property>
					<onclick>ActivateWindow(filemanager)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[138]</label>
					<label2>$LOCALIZE[31215]</label2>
					<property name="help">Kodi version, video renderer, storage, network and hardware details.</property>
					<onclick>ActivateWindow(systeminfo)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[31216]</label>
					<label2>$LOCALIZE[31217]</label2>
					<property name="help">What Kodi has done recently: scans, add-on updates, errors.</property>
					<onclick>ActivateWindow(eventlog)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13200]</label>
					<label2>$LOCALIZE[31218]</label2>
					<property name="help">Profiles and the login screen.</property>
					<onclick>ActivateWindow(Profiles)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14204]</label>
					<label2>$LOCALIZE[31219]</label2>
					<property name="help">Live TV and PVR. Passe-partout only gives these screens a plain layout.</property>
					<onclick>ActivateWindow(PVRSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[15016]</label>
					<label2>$LOCALIZE[31220]</label2>
					<property name="help">Games and controllers.</property>
					<onclick>ActivateWindow(GameSettings)</onclick>
					<visible>System.GetBool(gamesgeneral.enable)</visible>
				</item>
			</content>
		</control>
		<include>PP_SettingsDivider</include>
		<!-- the page -->
		<control type="label">
			<left>680</left>
			<top>134</top>
			<width>1120</width>
			<height>112</height>
			<font>disp_96</font>
			<label>$INFO[Container(9000).ListItem.Label]</label>
		</control>
		<control type="textbox">
			<left>680</left>
			<top>256</top>
			<width>1040</width>
			<height>68</height>
			<font>body_24</font>
			<textcolor>ink2</textcolor>
			<label>$INFO[Container(9000).ListItem.Property(help)]</label>
		</control>
		<control type="group">
			<left>680</left>
			<top>760</top>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1120</width>
				<height>1</height>
				<texture colordiffuse="rule">common/white.png</texture>
			</control>
			<include content="Dlg_FactRow"><param name="top" value="24"/><param name="label" value="Kodi"/><param name="value" value="$INFO[System.BuildVersion]"/></include>
			<include content="Dlg_FactRow"><param name="top" value="64"/><param name="label" value="Skin"/><param name="value" value="Passe-partout $INFO[System.AddonVersion(skin.passepartout)]"/></include>
			<include content="Dlg_FactRow"><param name="top" value="104"/><param name="label" value="Address"/><param name="value" value="$INFO[Network.IPAddress]"/></include>
			<include content="Dlg_FactRow"><param name="top" value="144"/><param name="label" value="Screen"/><param name="value" value="$INFO[System.ScreenResolution]"/></include>
			<include content="Dlg_FactRow"><param name="top" value="184"/><param name="label" value="Up"/><param name="value" value="$INFO[System.Uptime]"/></include>
		</control>
	</controls>
</window>
