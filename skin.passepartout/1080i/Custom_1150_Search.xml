<?xml version="1.0" encoding="UTF-8"?>
<!--
	Search, custom window 1150 (mockup PassepartoutSearch). Opened from Home's "Search" word.
	The page types on its own keyboard; results follow the typing (Includes_Search.xml, generated by
	_src/make_search.py). No Kodi-owned ids.
	Focus map: keys 9300 ↓ Space/Delete 9310; Right from the keys or the buttons -> the first result group;
	results Left/Right across groups and Down/Up from any print to the next/previous group (the group in focus slides
	to the column start), Up from the first group / Back -> keys. Back on the keys closes the window.
	Paper: neutral while typing; a result in focus colours the page (TMDb Helper WidgetContainer).
-->
<window type="window" id="1150">
	<defaultcontrol always="true">9300</defaultcontrol>
	<backgroundcolor>paper</backgroundcolor>
	<onload>ClearProperty(TMDbHelper.WidgetContainer,home)</onload>
	<onunload>ClearProperty(TMDbHelper.WidgetContainer,home)</onunload>
	<onunload>ClearProperty(Passepartout.Search.Encoded,home)</onunload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>PP_Background</include>
		<control type="group">
			<control type="grouplist">
				<left>120</left>
				<top>64</top>
				<width>1200</width>
				<height>38</height>
				<orientation>horizontal</orientation>
				<itemgap>52</itemgap>
				<control type="label"><width>auto</width><height>28</height><font>cap_20</font><textcolor>ink2</textcolor><label>$LOCALIZE[31130]</label></control>
				<control type="label"><width>auto</width><height>28</height><font>cap_20</font><textcolor>ink2</textcolor><label>$LOCALIZE[31131]</label></control>
				<control type="label"><width>auto</width><height>28</height><font>cap_20</font><textcolor>ink2</textcolor><label>$LOCALIZE[31132]</label></control>
				<control type="button">
					<width>auto</width>
					<height>37</height>
					<font>cap_20</font>
					<disabledcolor>ink</disabledcolor>
					<textoffsetx>0</textoffsetx>
					<aligny>top</aligny>
					<texturenofocus border="0,0,0,2" colordiffuse="ink">pp/underline.png</texturenofocus>
					<texturefocus border="0,0,0,2" colordiffuse="ink">pp/underline.png</texturefocus>
					<label>$LOCALIZE[31133]</label>
				</control>
				<control type="label"><width>auto</width><height>28</height><font>cap_20</font><textcolor>ink2</textcolor><label>$LOCALIZE[31134]</label></control>
			</control>
			<include>PP_Clock</include>
		</control>
		<include>Search_Encoder</include>
		<include>Search_Query</include>
		<include>Search_Results</include>
	</controls>
</window>
