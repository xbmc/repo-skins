<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video OSD (mockup PassepartoutOSD): no mat, a flat paper caption bar (OSD_PPBar), the paper tag
	top right (OSD_PPTag), transport words on the right with the ink placard on focus.

	Ids (Estuary Omega VideoOSD.xml convention): 602 play/pause (default), 603 stop (focus when pause
	is not possible), 600 previous / 607 next (chapters, playlist or scene markers only); no seek words (Omar: seek works without the OSD), 87 hidden seek stepper (Left/Right = StepBack /
	StepForward, frame advance when paused), 200 = transport row, 70044 chapters/bookmarks,
	70049 audio settings, 70046 subtitle settings (the OSD settings dialogs have tabs to Video).

	Focus map: open -> 602. Left/Right walk the row. Up -> 87 (seek), Down from 87 -> the row.
	Back closes the OSD (Kodi). The OSD steps aside while a playback dialog is up ($EXP[OSD_PanelOpen]).
	Auto-hide: Custom_1152_OSDAutoHide.xml.
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_PanelOpen]</visible>
			<include>Anim_FadeVisible</include>
			<include>OSD_PPTag</include>
			<include content="OSD_PPBar">
				<param name="top" value="824"/>
				<!-- 640: the transport row starts at x 786 at its widest (all seven words) -->
				<param name="titlew" value="640"/>
			</include>

			<!-- seek stepper (invisible): the elapsed time and a heavier line show it -->
			<control type="button" id="87">
				<description>seek stepper</description>
				<include>PP_Hidden</include>
				<onup>noop</onup>
				<ondown>200</ondown>
				<onleft>StepBack</onleft>
				<onright condition="!Player.Paused">StepForward</onright>
				<onright condition="Player.Paused">PlayerControl(FrameAdvance(1))</onright>
				<visible>Player.SeekEnabled</visible>
			</control>
			<control type="group">
				<visible>Control.HasFocus(87)</visible>
				<include>Anim_FadeVisible</include>
				<control type="progress">
					<left>300</left>
					<top>870</top>
					<width>1320</width>
					<height>3</height>
					<info>Player.SeekBar</info>
				</control>
				<control type="label">
					<left>300</left>
					<top>826</top>
					<width>1320</width>
					<height>28</height>
					<align>center</align>
					<font>cap_20</font>
					<textcolor>ink2</textcolor>
					<label>$LOCALIZE[31256]</label>
				</control>
			</control>

			<!-- transport words, right-aligned to 1816 (+24 for the placard margin). Order (Omar): Pause, Stop next to it, Previous / Next (when there is something to skip to), then the panels. Fixed widths: see OSD_PPWord -->
			<control type="grouplist" id="200">
				<left>0</left>
				<top>908</top>
				<width>1840</width>
				<height>124</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>-44</itemgap>
				<onup>87</onup>
				<ondown>noop</ondown>
				<include content="OSD_PPWord">
					<param name="id" value="602"/>
					<param name="label" value="$VAR[OSD_PPPlayLabel]"/>
					<param name="width" value="170"/>
					<param name="onclick" value="PlayerControl(Play)"/>
					<param name="visible" value="Player.PauseEnabled"/>
				</include>
				<include content="OSD_PPWord">
					<param name="id" value="603"/>
					<param name="label" value="Stop"/>
					<param name="width" value="151"/>
					<param name="onclick" value="PlayerControl(Stop)"/>
				</include>
				<!-- Previous / Next (Omar, 0.9.5): only with chapters, a video playlist or scene markers (Majan's gate) -->
				<include content="OSD_PPWord">
					<param name="id" value="600"/>
					<param name="label" value="Previous"/>
					<param name="width" value="221"/>
					<param name="onclick" value="PlayerControl(Previous)"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="OSD_PPWord">
					<param name="id" value="607"/>
					<param name="label" value="Next"/>
					<param name="width" value="149"/>
					<param name="onclick" value="PlayerControl(Next)"/>
					<param name="visible" value="$EXP[OSD_HasPrevNext]"/>
				</include>
				<include content="OSD_PPWord">
					<param name="id" value="70044"/>
					<param name="label" value="Chapters"/>
					<param name="width" value="227"/>
					<param name="onclick" value="ActivateWindow(videobookmarks)"/>
					<param name="visible" value="Player.SeekEnabled + !VideoPlayer.Content(livetv)"/>
				</include>
				<include content="OSD_PPWord">
					<param name="id" value="70049"/>
					<param name="label" value="Audio"/>
					<param name="width" value="166"/>
					<param name="onclick" value="ActivateWindow(osdaudiosettings)"/>
				</include>
				<include content="OSD_PPWord">
					<param name="id" value="70046"/>
					<param name="label" value="Subtitles"/>
					<param name="width" value="234"/>
					<param name="onclick" value="ActivateWindow(osdsubtitlesettings)"/>
					<param name="visible" value="Player.HasVideo"/>
				</include>
			</control>
		</control>
	</controls>
</window>
