<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library = the hang (Includes_Views_Video.xml). Kodi id contract (Estuary Omega MyVideoNav.xml):
	<views> containers (first VISIBLE one is the default for a new node), menucontrol 9000,
	3 sort-by / 4 sort-order buttons, 14 watched toggle (SendClick only), defaultcontrol 50 = the view.
	0.9.18: 503 moved after 500 (it also hangs films / sets / series now, and films must still open in 500;
	saved views match by id + type, so the order changes none). 507 the print room is new and last.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>paper</backgroundcolor>
	<views>502,500,503,501,50,506,507</views>
	<include>PP_PaperInit</include>
	<onload>SetProperty(TMDbHelper.Colors.SourceImage,Art(poster)|Art(tvshow.poster)|Art(thumb)|Art(fanart),home)</onload>
	<!-- empty folder: Kodi can't focus an empty view, so land on the header words instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
