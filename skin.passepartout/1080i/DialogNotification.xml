<?xml version="1.0" encoding="UTF-8"?>
<!--
	Notification toast (M4, Builder E): top-right under the top-bar rule, minimal - bg panel with a
	1px hairline frame, mono accent heading, one-line message, small icon on the right (Kodi's
	stock DefaultIcon*.png names don't exist in Passe-partout, so those simply render nothing and the text
	is unaffected).
	Id contract (Estuary Omega): 400 icon, 401 line 1 (heading), 402 line 2 (message).
-->
<window>
	<zorder>3</zorder>
	<include content="Anim_SidePanel"><param name="offset" value="40"/></include>
	<controls>
		<control type="group">
			<right>page_margin</right>
			<top>below_bar_top</top>
			<width>toast_w</width>
			<height>104</height>
			<include content="PP_ToastFrame">
				<param name="height" value="104"/>
			</include>
			<control type="fadelabel" id="401">
				<description>heading</description>
				<left>28</left>
				<top>20</top>
				<width>420</width>
				<height>28</height>
				<font>cap_20</font>
				<textcolor>ink2</textcolor>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="fadelabel" id="402">
				<description>message</description>
				<left>28</left>
				<top>50</top>
				<width>420</width>
				<height>34</height>
				<font>body_24</font>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="image" id="400">
				<description>icon</description>
				<right>20</right>
				<top>20</top>
				<width>64</width>
				<height>64</height>
				<aspectratio>keep</aspectratio>
			</control>
		</control>
	</controls>
</window>
