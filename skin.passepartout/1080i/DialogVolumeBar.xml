<?xml version="1.0" encoding="UTF-8"?>
<!--
	Volume (M4, Builder E): minimal top strip in the offset-strip vocabulary (mockups/Offset):
	720px, top-centre, mono caption + mono value (accent) + 2px track. Volume is usually on the TV
	via CEC, so this rarely shows. Hidden progress 29999 holds Player.Volume (Estuary contract) so
	the label can read the percentage.
-->
<window>
	<zorder>4</zorder>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(startup) + !Window.IsActive(GameVolume)</visible>
			<left>600</left>
			<top>56</top>
			<width>720</width>
			<height>86</height>
			<include>Anim_TopStrip</include>
			<control type="progress" id="29999">
				<description>volume (Kodi)</description>
				<left>offscreen</left>
				<top>offscreen</top>
				<width>1</width>
				<height>1</height>
				<info>Player.Volume</info>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>720</width>
				<height>86</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="veil">common/white.png</texture>
			</control>
			<control type="label">
				<left>24</left>
				<top>16</top>
				<width>400</width>
				<height>36</height>
				<font>cap_20</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[13376]</label>
			</control>
			<control type="label">
				<right>24</right>
				<top>16</top>
				<width>260</width>
				<height>36</height>
				<align>right</align>
				<font>mono_26</font>
				<label>$INFO[Control.GetLabel(29999),, %]</label>
				<visible>!Player.Muted</visible>
			</control>
			<control type="label">
				<right>24</right>
				<top>16</top>
				<width>260</width>
				<height>36</height>
				<align>right</align>
				<font>cap_20</font>
				<label>$LOCALIZE[31015]</label>
				<visible>Player.Muted</visible>
			</control>
			<control type="progress">
				<left>24</left>
				<top>66</top>
				<width>672</width>
				<height>2</height>
				<info>Player.Volume</info>
				<visible>!Player.Muted</visible>
			</control>
			<control type="image">
				<left>24</left>
				<top>66</top>
				<width>672</width>
				<height>2</height>
				<texture colordiffuse="rule_strong">common/white.png</texture>
				<visible>Player.Muted</visible>
			</control>
		</control>
	</controls>
</window>
