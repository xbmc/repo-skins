<?xml version="1.0" encoding="UTF-8"?>
<!--
	Startup: the neutral paper + the wordmark for the instant before Home. Starts the TMDb Helper
	colour service (PP_PaperInit) and goes to Kodi's configured startup window, like Estuary.
-->
<window>
	<include>PP_PaperInit</include>
	<onload>SetProperty(passepartout.monthday,$INFO[System.Date(MMMM D)],home)</onload>
	<onload>SetProperty(passepartout.monthyear,$INFO[System.Date(MMMM YYYY)],home)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="paper">common/white.png</texture>
		</control>
		<control type="label">
			<left>120</left>
			<top>498</top>
			<width>1680</width>
			<height>84</height>
			<font>ttl_72</font>
			<align>center</align>
			<label>$LOCALIZE[31135]</label>
		</control>
	</controls>
</window>
