<?xml version="1.0" encoding="UTF-8"?>
<!--
	File browser (paths for settings / sources) - M4, Builder E: centred Index dialog, hairline
	list with the check column, buttons on the right, mono path line at the bottom.
	Id contract (Estuary Omega): heading 411, list 450 (451 = thumbs variant, not used), path
	label 412, buttons 413 OK / 414 cancel / 415 new folder / 416 mirror image in grouplist 9000,
	scrollbar 60.
-->
<window>
	<defaultcontrol always="true">450</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1400</width>
			<height>860</height>
			<include content="PP_GenericDialog">
				<param name="width" value="1400"/>
				<param name="height" value="860"/>
				<param name="header_id" value="411"/>
				<param name="kicker" value="$INFO[Container(450).CurrentItem]$INFO[Container(450).NumItems, / ,]"/>
			</include>
			<control type="list" id="450">
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>1000</width>
				<height>640</height>
				<onup>450</onup>
				<ondown>450</ondown>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="PP_ListLayout">
					<param name="width" value="1000"/>
					<param name="height" value="dialog_row_h"/>
					<param name="list_id" value="450"/>
				</include>
			</control>
			<include content="PP_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1032"/>
				<param name="top" value="dialog_content_top"/>
				<param name="height" value="640"/>
				<param name="onleft" value="450"/>
				<param name="onright" value="9000"/>
			</include>
			<control type="grouplist" id="9000">
				<left>1060</left>
				<top>dialog_content_top</top>
				<width>300</width>
				<height>400</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onleft>450</onleft>
				<onright>450</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<include content="PP_DialogButton">
					<param name="id" value="413"/>
					<param name="label" value="$LOCALIZE[186]"/>
				</include>
				<include content="PP_DialogButton">
					<param name="id" value="414"/>
					<param name="label" value="$LOCALIZE[222]"/>
				</include>
				<include content="PP_DialogButton">
					<param name="id" value="415"/>
					<param name="label" value="$LOCALIZE[119]"/>
					<param name="visible" value="Control.IsEnabled(415)"/>
				</include>
				<include content="PP_DialogButton">
					<param name="id" value="416"/>
					<param name="label" value="$LOCALIZE[749]"/>
					<param name="visible" value="Control.IsEnabled(416)"/>
				</include>
			</control>
			<include content="PP_Rule">
				<param name="top" value="784"/>
				<param name="left" value="0"/>
				<param name="width" value="1400"/>
				<param name="color" value="rule_strong"/>
			</include>
			<control type="label" id="412">
				<description>path</description>
				<left>dialog_pad</left>
				<top>796</top>
				<width>1320</width>
				<height>40</height>
				<haspath>true</haspath>
				<font>num_20</font>
				<textcolor>ink3</textcolor>
			</control>
		</control>
	</controls>
</window>
