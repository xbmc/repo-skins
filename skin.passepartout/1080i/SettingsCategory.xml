<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...), mockup PassepartoutSettings:
	categories on the left (Geist 30 / 40, the ink placard on focus), a 14% divider at x 600, the page
	at x 680: the section's name in Geist Light 96, what the focused setting does, then the rows
	(Geist 28 on 76px, 12% hairlines, the ink placard on focus).
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2, categories grouplist 3 + template 10, control area 5,
	description textbox 6, templates 7-15, level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>paper</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>PP_Background</include>
		<include content="PP_Crumbs2">
			<param name="a" value="$LOCALIZE[5]"/>
			<param name="b" value="$INFO[Control.GetLabel(2)]"/>
		</include>

		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>100</left>
			<top>162</top>
			<width>460</width>
			<height>704</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="PP_SettingCategoryTemplate">
			<param name="width" value="460"/>
		</include>
		<control type="group">
			<left>100</left>
			<top>920</top>
			<include content="PP_SettingLevelButton">
				<param name="width" value="460"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>
		<include>PP_SettingsDivider</include>

		<!-- the page -->
		<control type="label">
			<left>680</left>
			<top>134</top>
			<width>1120</width>
			<height>112</height>
			<font>disp_96</font>
			<label>$INFO[Control.GetLabel(2)]</label>
		</control>
		<control type="textbox" id="6">
			<description>what the focused setting does (Kodi)</description>
			<left>680</left>
			<top>256</top>
			<width>1040</width>
			<height>68</height>
			<font>body_24</font>
			<textcolor>ink2</textcolor>
			<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
		</control>
		<control type="image">
			<left>680</left>
			<top>339</top>
			<width>1120</width>
			<height>1</height>
			<texture colordiffuse="rule">common/white.png</texture>
		</control>
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>680</left>
			<top>340</top>
			<width>1120</width>
			<height>684</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="PP_SettingTemplates">
			<param name="width" value="1120"/>
		</include>
		<include content="PP_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1812"/>
			<param name="top" value="340"/>
			<param name="height" value="684"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>
		<control type="label" id="2">
			<description>section label (Kodi writes it; shown as the page title)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
