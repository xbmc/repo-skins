<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables shared by every window. Use as $VAR[Name]. Area variables live in their Includes_* file.
	Colours are returned as names from colors/defaults.xml, or as the live paper colour (an AARRGGBB
	infolabel from TMDb Helper).
-->
<includes>
	<!-- ===================================================================== paper -->
	<!-- The art-coloured paper: TMDb Helper's Colors.Main of the item in focus (normalised to
	     luminance/saturation from the Paper settings), else the neutral paper. -->
	<variable name="PaperColor">
		<value condition="$EXP[PP_HasArtPaper]">$INFO[Window(Home).Property(TMDbHelper.ListItem.Colors.Main)]</value>
		<value>paper</value>
	</variable>
	<!-- Baked shadows are neutral grey (G 62); multiplied by the paper they become a deep version of
	     the paper's own hue (the mockups' shadow colours). -->
	<variable name="ShadowColor">
		<value condition="$EXP[PP_HasArtPaper]">$INFO[Window(Home).Property(TMDbHelper.ListItem.Colors.Main)]</value>
		<value>paper</value>
	</variable>

	<!-- paper for the playing item (now playing, OSD): its own colour once computed, else the page paper -->
	<variable name="PlayerPaper">
		<value condition="$EXP[PP_ArtPaperOn] + !String.IsEmpty(Window(Home).Property(TMDbHelper.PPPlayer.Colors.Main))">$INFO[Window(Home).Property(TMDbHelper.PPPlayer.Colors.Main)]</value>
		<value>$VAR[PaperColor]</value>
	</variable>

	<!-- ==================================================================== labels -->
	<variable name="ClockLabel">
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>
	<variable name="PP_WeatherLabel">
		<value condition="!String.IsEmpty(Weather.Temperature)">$INFO[Weather.Temperature]$INFO[Weather.Conditions, · ,]</value>
		<value>$INFO[Weather.Conditions]</value>
	</variable>

	<!-- Poster/thumb for any list item -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<!-- Landscape art for any list item -->
	<variable name="ListItemLandscape">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.landscape))">$INFO[ListItem.Art(tvshow.landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>

	<!-- Library page title (generic windows) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- ==================================================================== textures -->
	<variable name="FocusFrameAlways"><value>pp/focus_bar.png</value></variable>
	<variable name="ButtonOutline"><value>pp/frame_1.png</value></variable>

	<!-- ==================================================================== OSD -->
</includes>
