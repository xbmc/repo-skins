<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home: one large matted print on art-coloured paper (PassepartoutHome), Down reveals the rest of the
	room (PassepartoutHomeRoom). Ids, focus map and paper wiring: Includes_Home.xml header.
	Home is KEEP_IN_MEMORY: onload runs every time Home is shown.
-->
<window>
	<!-- Hiding menu items can no longer leave Home without focus: Kodi falls back to the default control whenever
	     nothing has focus, so it is Settings (9005), which never hides (it was 9001, hidden with the films item).
	     The first onload focuses 9001 while it is shown, exactly as the old default did; the onloads below override it. -->
	<defaultcontrol always="true">9005</defaultcontrol>
	<onload>SetProperty(passepartout.monthday,$INFO[System.Date(MMMM D)],home)</onload>
	<onload>SetProperty(passepartout.monthyear,$INFO[System.Date(MMMM YYYY)],home)</onload>
	<onload condition="!Skin.HasSetting(HideMenu.Movies)">SetFocus(9001)</onload>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>paper</backgroundcolor>
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),series) + !Skin.HasSetting(HideMenu.TVShows)">SetFocus(9002)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),music) + !Skin.HasSetting(HideMenu.Music)">SetFocus(9003)</onload>
	<!-- 0.9.14: the remembered section (or Films, the default) is hidden in Skin settings (HideMenu.*): focus the first
	     word shown; its onfocus sets the section. Settings (9005) never hides. -->
	<onload condition="[[[String.IsEmpty(Window(Home).Property(passepartout.section)) | String.IsEqual(Window(Home).Property(passepartout.section),films)] + Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(passepartout.section),series) + Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(passepartout.section),music) + Skin.HasSetting(HideMenu.Music)]] + !Skin.HasSetting(HideMenu.Movies)">SetFocus(9001)</onload>
	<onload condition="[[[String.IsEmpty(Window(Home).Property(passepartout.section)) | String.IsEqual(Window(Home).Property(passepartout.section),films)] + Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(passepartout.section),series) + Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(passepartout.section),music) + Skin.HasSetting(HideMenu.Music)]] + Skin.HasSetting(HideMenu.Movies) + !Skin.HasSetting(HideMenu.TVShows)">SetFocus(9002)</onload>
	<onload condition="[[[String.IsEmpty(Window(Home).Property(passepartout.section)) | String.IsEqual(Window(Home).Property(passepartout.section),films)] + Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(passepartout.section),series) + Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(passepartout.section),music) + Skin.HasSetting(HideMenu.Music)]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + !Skin.HasSetting(HideMenu.Music)">SetFocus(9003)</onload>
	<onload condition="[[[String.IsEmpty(Window(Home).Property(passepartout.section)) | String.IsEqual(Window(Home).Property(passepartout.section),films)] + Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(passepartout.section),series) + Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(passepartout.section),music) + Skin.HasSetting(HideMenu.Music)]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !Skin.HasSetting(HideMenu.Search)">SetFocus(9004)</onload>
	<onload condition="[[[String.IsEmpty(Window(Home).Property(passepartout.section)) | String.IsEqual(Window(Home).Property(passepartout.section),films)] + Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(passepartout.section),series) + Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(passepartout.section),music) + Skin.HasSetting(HideMenu.Music)]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + Skin.HasSetting(HideMenu.Search)">SetFocus(9005)</onload>
	<!-- 0.9.17: back on the custom main-menu item you left (its onfocus keeps the section); a remembered item that is
	     gone now (cleared, add-on removed) -> the first word shown, whose onfocus sets its section -->
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),custom1) + $EXP[CustomMenu1On]">SetFocus(9006)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),custom2) + $EXP[CustomMenu2On]">SetFocus(9007)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),custom3) + $EXP[CustomMenu3On]">SetFocus(9008)</onload>
	<onload condition="[[String.IsEqual(Window(Home).Property(passepartout.section),custom1) + !$EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom2) + !$EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom3) + !$EXP[CustomMenu3On]]] + !Skin.HasSetting(HideMenu.Movies)">SetFocus(9001)</onload>
	<onload condition="[[String.IsEqual(Window(Home).Property(passepartout.section),custom1) + !$EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom2) + !$EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom3) + !$EXP[CustomMenu3On]]] + Skin.HasSetting(HideMenu.Movies) + !Skin.HasSetting(HideMenu.TVShows)">SetFocus(9002)</onload>
	<onload condition="[[String.IsEqual(Window(Home).Property(passepartout.section),custom1) + !$EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom2) + !$EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom3) + !$EXP[CustomMenu3On]]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + !Skin.HasSetting(HideMenu.Music)">SetFocus(9003)</onload>
	<onload condition="[[String.IsEqual(Window(Home).Property(passepartout.section),custom1) + !$EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom2) + !$EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom3) + !$EXP[CustomMenu3On]]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !Skin.HasSetting(HideMenu.Search)">SetFocus(9004)</onload>
	<onload condition="[[String.IsEqual(Window(Home).Property(passepartout.section),custom1) + !$EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom2) + !$EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(passepartout.section),custom3) + !$EXP[CustomMenu3On]]] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + Skin.HasSetting(HideMenu.Search)">SetFocus(9005)</onload>
	<onload condition="String.IsEmpty(Window(Home).Property(passepartout.section)) + !Skin.HasSetting(HideMenu.Movies)">SetProperty(passepartout.section,films,home)</onload>
	<!-- new stamp each time Home opens: the Next up plugin path changes, so it refreshes after playback -->
	<onload>SetProperty(passepartout.reload,$INFO[System.Time(hh:mm:ss)],home)</onload>
	<include>PP_PaperInit</include>
	<onload condition="String.IsEqual(Window(Home).Property(passepartout.section),music)">SetProperty(TMDbHelper.Colors.SourceImage,Art(thumb)|Art(fanart),home)</onload>
	<onload condition="!String.IsEqual(Window(Home).Property(passepartout.section),music)">SetProperty(TMDbHelper.Colors.SourceImage,Art(fanart)|Art(landscape)|Art(poster)|Art(thumb),home)</onload>
	<onload>SetProperty(TMDbHelper.WidgetContainer,9101,home)</onload>
	<!-- other windows must not inherit Home's container id (TMDb Helper reads it globally) -->
	<onunload>ClearProperty(TMDbHelper.WidgetContainer,home)</onunload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>PP_Background</include>
		<include>Home_Data</include>
		<include>Home_Exhibition</include>
		<include>Home_CustomMenuPanel</include>
		<include>Home_ExhibitionSmall</include>
		<include>Home_RoomRows</include>
		<include>Home_CustomRows</include>
		<include>CustomRows_Probes</include>
		<include>PP_NowPlayingLine</include>
		<include>Home_Nav</include>
		<!-- section switching: the nav word in focus decides the exhibition and the paper source -->
		<control type="group">
			<visible>false</visible>
		</control>
	</controls>
</window>
