<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info (Info during playback): a small wall label on a paper sheet that rises from the
	bottom of the picture - the matted poster, the title in Geist Light 64, the artist and medium lines,
	the curator text (three lines), the hairline progress with the times. The paper tag top right.
	Info again or Back closes it (GUIDialogFullScreenInfo.cpp).
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button
	(default, always): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include>OSD_PPTag</include>
			<include content="OSD_Scrims">
				<param name="bottom_h" value="600"/>
			</include>
			<!-- the print -->
			<control type="group">
				<visible>!String.IsEmpty(Player.Art(poster)) | !String.IsEmpty(Player.Art(tvshow.poster))</visible>
				<include content="PP_Print">
					<param name="left" value="120"/>
					<param name="top" value="572"/>
					<param name="width" value="200"/>
					<param name="height" value="300"/>
					<param name="art" value="$VAR[OSDInfo_Poster]"/>
					<param name="title" value="$INFO[VideoPlayer.Title]"/>
				</include>
			</control>
			<!-- the label -->
			<control type="group">
				<left>380</left>
				<animation effect="slide" start="0,0" end="-260,0" time="0" condition="String.IsEmpty(Player.Art(poster)) + String.IsEmpty(Player.Art(tvshow.poster))">Conditional</animation>
				<control type="label">
					<left>0</left>
					<top>566</top>
					<width>1420</width>
					<height>28</height>
					<font>cap_20</font>
					<label>$VAR[OSD_PPArtist]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>598</top>
					<width>1420</width>
					<height>76</height>
					<font>ttl_64</font>
					<label>$VAR[OSD_PPTitle]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>680</top>
					<width>1420</width>
					<height>28</height>
					<font>cap_20</font>
					<textcolor>ink2</textcolor>
					<label>$INFO[VideoPlayer.Genre]$INFO[Player.Duration, · ,]$INFO[Player.FinishTime, · ends ,]</label>
				</control>
				<control type="image">
					<left>0</left>
					<top>730</top>
					<width>64</width>
					<height>1</height>
					<texture colordiffuse="ink">common/white.png</texture>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>752</top>
					<width>1300</width>
					<height>120</height>
					<font>body_26</font>
					<label>$INFO[VideoPlayer.Plot]</label>
					<autoscroll delay="8000" time="3000" repeat="10000">true</autoscroll>
				</control>
			</control>
			<!-- hairline progress with the times -->
			<control type="label">
				<left>120</left>
				<top>930</top>
				<width>170</width>
				<height>28</height>
				<font>mono_22</font>
				<label>$VAR[OSD_PPElapsed]</label>
			</control>
			<control type="label">
				<left>1630</left>
				<top>930</top>
				<width>170</width>
				<height>28</height>
				<align>right</align>
				<font>mono_22</font>
				<textcolor>ink2</textcolor>
				<label>$INFO[Player.Duration]</label>
			</control>
			<control type="progress">
				<left>300</left>
				<top>944</top>
				<width>1320</width>
				<height>1</height>
				<info>Player.Progress</info>
			</control>
			<control type="label">
				<left>120</left>
				<top>984</top>
				<width>1680</width>
				<height>28</height>
				<font>cap_20</font>
				<textcolor>ink2</textcolor>
				<label>$VAR[OSD_NextLabel]</label>
			</control>
		</control>
	</controls>
</window>
