	<!-- ============================================================= legacy (M1) -->
	<!-- =====================================================================================
	     Passe-partout OSD (mockup PassepartoutOSD): no mat. A flat paper caption bar (256px) at the
	     bottom in the film's paper colour, a hairline progress line between the times, the title in
	     Geist Light 64, "Director, Year · ends 23:57", transport words on the right (ink placard on
	     focus). A small paper tag top right: PAUSED | 21:47.
	     ===================================================================================== -->
	<variable name="OSD_PPTitle">
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(VideoPlayer.Title)">$INFO[VideoPlayer.Title]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Title]</value>
		<value>$INFO[Player.Title]</value>
	</variable>
	<variable name="OSD_PPArtist">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Season, · Season ,]$INFO[VideoPlayer.Episode, · Episode ,]</value>
		<value condition="Player.HasAudio + !Player.HasVideo">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album, · ,]</value>
		<value condition="!String.IsEmpty(VideoPlayer.Director)">$INFO[VideoPlayer.Director]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<variable name="OSD_PPEnds">
		<!-- non-breaking spaces (U+00A0, in both fonts): "· " stays on the first line and "ends 12:37 AM" never splits;
		     the time is built from (hh:mm) + (xx) so its own space is non-breaking too (0.9.6) -->
		<value condition="Player.HasVideo + !String.IsEmpty(Player.FinishTime)">[COLOR ink2]&#160;· ends&#160;[/COLOR]$INFO[Player.FinishTime(hh:mm)]$INFO[Player.FinishTime(xx),&#160;,]</value>
	</variable>
	<variable name="OSD_PPElapsed">
		<value condition="!String.IsEmpty(Player.SeekNumeric)">$INFO[Player.SeekNumeric(hh:mm:ss)]</value>
		<value condition="Player.Seeking | Player.HasPerformedSeek(3)">$INFO[Player.SeekTime]</value>
		<value>$INFO[Player.Time]</value>
	</variable>
	<variable name="OSD_PPState">
		<value condition="Player.Forwarding">Forward $INFO[Player.PlaySpeed]x</value>
		<value condition="Player.Rewinding">Rewind $INFO[Player.PlaySpeed]x</value>
		<value condition="!String.IsEmpty(Player.SeekStepSize)">Skip $VAR[OSD_SkipValue]</value>
		<value condition="Player.Caching">Buffering</value>
		<value condition="Player.Paused">Paused</value>
	</variable>
	<variable name="OSD_PPPlayLabel">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">Play</value>
		<value>Pause</value>
	</variable>

	<!-- the bar: params top (824 for the OSD, 920 for the seek bar), transport (true/false) -->
	<include name="OSD_PPBar">
		<param name="top">824</param>
		<param name="title">true</param>
		<param name="wide">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>1920</width>
				<height>256</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1920</width>
					<height>256</height>
					<texture colordiffuse="$VAR[PlayerPaper]">common/white.png</texture>
				</control>
				<!-- times + hairline progress (L 300 .. R 1620, y 48) -->
				<control type="label">
					<left>120</left>
					<top>34</top>
					<width>170</width>
					<height>28</height>
					<font>mono_22</font>
					<textcolor>ink</textcolor>
					<label>$VAR[OSD_PPElapsed]</label>
				</control>
				<control type="label">
					<left>1630</left>
					<top>34</top>
					<width>170</width>
					<height>28</height>
					<align>right</align>
					<font>mono_22</font>
					<textcolor>ink2</textcolor>
					<label>$INFO[Player.Duration]</label>
				</control>
				<control type="image">
					<left>300</left>
					<top>48</top>
					<width>1320</width>
					<height>1</height>
					<texture colordiffuse="rule_track">common/white.png</texture>
				</control>
				<control type="progress">
					<left>300</left>
					<top>48</top>
					<width>1320</width>
					<height>1</height>
					<info>Player.ProgressCache</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="rule_strong">common/white.png</midtexture>
					<visible>Player.SeekEnabled</visible>
				</control>
				<control type="progress">
					<left>300</left>
					<top>48</top>
					<width>1320</width>
					<height>1</height>
					<info>Player.SeekBar</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="ink">common/white.png</midtexture>
				</control>
				<control type="ranges">
					<left>300</left>
					<top>44</top>
					<width>1320</width>
					<height>9</height>
					<texturebg>pp/playhead_bar.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="ink2">osd/tick.png</righttexture>
					<info>Player.Chapters</info>
					<visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
				</control>
				<!-- playhead: 1 x 21 at the position (slider nib scaled from 2 x 42) -->
				<control type="slider">
					<left>300</left>
					<top>38</top>
					<width>1320</width>
					<height>21</height>
					<info>Player.SeekBar</info>
					<texturesliderbar>pp/playhead_bar.png</texturesliderbar>
					<textureslidernib colordiffuse="ink">pp/playhead.png</textureslidernib>
					<textureslidernibfocus colordiffuse="ink">pp/playhead.png</textureslidernibfocus>
					<visible>Player.SeekEnabled</visible>
				</control>
				<!-- title + museum line -->
				<control type="group">
					<visible>$PARAM[title]</visible>
					<control type="group">
						<visible>!$PARAM[wide]</visible>
						<include content="Title_OSD"><param name="left" value="120"/><param name="top" value="72"/></include>
					</control>
					<control type="group">
						<visible>$PARAM[wide]</visible>
						<include content="Title_OSDWide"><param name="left" value="120"/><param name="top" value="72"/></include>
					</control>
					<!-- two lines when needed ("Ash vs Evil Dead · Season 2 · Episode 4 · ends 12:25 AM" was cut to
					     "Episod..."; 0.9.5). cap_20 pitch 28: two lines = 56, the bar has room down to 1080 -->
					<control type="textbox">
						<left>120</left>
						<top>154</top>
						<width>$PARAM[titlew]</width>
						<height>58</height>
						<font>cap_20</font>
						<textcolor>ink</textcolor>
						<align>left</align>
						<label>$VAR[OSD_PPArtist]$VAR[OSD_PPEnds]</label>
					</control>
				</control>
			</control>
		</definition>
	</include>

