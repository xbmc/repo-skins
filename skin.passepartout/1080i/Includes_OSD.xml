	<!-- one transport word. Control = block + 24 / 4 / 24 / 56 (placard with its shadow). params: id, label, pad, color, width.
	     Rows give every word a FIXED width (widest label + 2 x 36 + 2, measured from PPCapsWide 22): auto widths made the
	     right-aligned row shift whenever a label changed (Pause/Play, Shuffle on/off, seek flicker). -->
	<include name="OSD_PPWord">
		<param name="width">auto</param>
		<param name="color">ink</param>
		<param name="pad">36</param>
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<include content="PP_PlacardLook"><param name="pad" value="$PARAM[pad]"/><param name="color" value="$PARAM[color]"/></include>
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<onup>87</onup>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
