<?xml version="1.0" encoding="UTF-8"?>
<!--
	The wall label (PassepartoutLabel). Movie, episode, TV show, season and collection share one page;
	texts switch on ListItem.DBType (Includes_VideoInfo.xml).

	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo, Omega):
	  8 play (from the beginning when 9 exists; browses for tvshow/season/set) · 9 resume ·
	  11 trailer · 50 cast (collections: the films of the set) · 6 refresh · 7 user rating ·
	  10 choose art · 12 choose fanart · 13 director search · 14 versions · 15 extras · 443 collection.
	Passe-partout ids: 9000 actions (default focus), 9001 curator-text handle (OK = full text 9200),
	  9010 More, 9012 Browse / 9013 From the start (re-send 8), 9100 More row, 61 full-text scrollbar.
	Focus map: 9001 ↕ 9000 ↓ 50 (the page slides up while the cast has focus). Back closes.
	Paper: TMDb Helper reads ListItem in info dialogs, so the page takes this film's colour.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(TMDbHelper.Colors.SourceImage,Art(poster)|Art(tvshow.poster)|Art(thumb)|Art(fanart),home)</onload>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>PP_Background</include>
		<control type="group">
			<description>page (slides up while the cast has focus)</description>
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(passepartout.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-540" time="260" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(passepartout.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-540" time="0"/>
			</animation>
			<include>VidInfo_Header</include>
			<include>VidInfo_Print</include>
			<include>VidInfo_Label</include>
			<include>VidInfo_Buttons</include>
			<include>VidInfo_MoreRow</include>
			<include>VidInfo_CastRow</include>
		</control>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
