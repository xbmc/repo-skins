<?xml version="1.0" encoding="UTF-8"?>
<!--
	Passe-partout System menu (custom dialog 1151): what Home's Settings word opens. A paper card (PP_Card:
	the page's paper + 40% white, 1px edge, soft lift) hanging under the Settings word (x 658, y 136),
	"System" + the time as its caption, rows in Geist 28 on 68px with 12% hairlines, the ink placard with
	paper-coloured text on focus (same rows as the context card / select dialog).
	Entries: Skin settings, Settings, File manager, System info, Add-ons, Update library, Clean library
	(0.9.11: the task card 1157 asks which library; Clean asks first), Live TV, Pictures, Favourites, Files,
	then Power: Exit / Reboot /
	Power off / Power menu (platform-dependent). Back closes. No Kodi-owned ids.
	0.9.2: was still Majan's dark framed panel (dialogs/panel_framed.png) with ink text on it.
-->
<window type="dialog" id="1151">
	<defaultcontrol always="true">100</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="image">
			<description>dim (flat ink 62%, own fades: LESSONS 4)</description>
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="veil">common/white.png</texture>
		</control>
		<control type="group">
			<left>658</left>
			<top>below_bar_top</top>
			<width>640</width>
			<height>924</height>
			<animation effect="slide" start="0,0" end="0,-8" time="0" condition="Integer.IsGreaterOrEqual(Container(100).NumItems,12)">Conditional</animation>
			<!-- card sized to the visible rows: 80 header + 68 per row + 16 (power entries depend on the platform) -->
			<control type="group">
				<width>640</width>
				<height>504</height>
				<visible>!Integer.IsGreater(Container(100).NumItems,6)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>572</height>
				<visible>Integer.IsEqual(Container(100).NumItems,7)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>640</height>
				<visible>Integer.IsEqual(Container(100).NumItems,8)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>708</height>
				<visible>Integer.IsEqual(Container(100).NumItems,9)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>776</height>
				<visible>Integer.IsEqual(Container(100).NumItems,10)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>844</height>
				<visible>Integer.IsEqual(Container(100).NumItems,11)</visible>
				<include>PP_Card</include>
			</control>
			<control type="group">
				<width>640</width>
				<height>912</height>
				<visible>Integer.IsGreaterOrEqual(Container(100).NumItems,12)</visible>
				<include>PP_Card</include>
			</control>
			<control type="label">
				<left>40</left>
				<top>24</top>
				<width>300</width>
				<height>28</height>
				<font>cap_20</font>
				<label>$LOCALIZE[31020]</label>
			</control>
			<control type="label">
				<left>300</left>
				<top>24</top>
				<width>300</width>
				<height>28</height>
				<align>right</align>
				<font>mono_22</font>
				<textcolor>ink2</textcolor>
				<label>$INFO[System.Time(hh:mm)]</label>
			</control>
			<control type="image">
				<left>16</left>
				<top>72</top>
				<width>608</width>
				<height>1</height>
				<texture colordiffuse="rule">common/white.png</texture>
			</control>
			<control type="list" id="100">
				<left>16</left>
				<top>80</top>
				<width>608</width>
				<height>816</height>
				<onup>100</onup>
				<ondown>100</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="608"/>
					<param name="height" value="68"/>
					<param name="list_id" value="100"/>
					<param name="hint_w" value="240"/>
					<param name="label_r" value="272"/>
					<param name="hint_l" value="344"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[31021]</label>
						<label2>$LOCALIZE[31135]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(skinsettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[5]</label>
						<label2>Kodi</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(settings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[10003]</label>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(filemanager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[138]</label>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(systeminfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(addonbrowser)</onclick>
					</item>
					<!-- 0.9.11: the library jobs, with the choice of library on the task card (1157; Clean asks first) -->
					<item>
						<label>$LOCALIZE[31136]</label>
						<label2>$LOCALIZE[31137]</label2>
						<onclick>SetProperty(pp.libtask,update,home)</onclick>
						<onclick>SetProperty(pp.libtarget,choose,home)</onclick>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(1157)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31138]</label>
						<label2>$LOCALIZE[31137]</label2>
						<onclick>SetProperty(pp.libtask,clean,home)</onclick>
						<onclick>SetProperty(pp.libtarget,choose,home)</onclick>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(1157)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31139]</label>
						<label2>$LOCALIZE[31140]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(TVChannels)</onclick>
						<visible>System.HasPVRAddon</visible>
					</item>
					<item>
						<label>$LOCALIZE[1]</label>
						<label2>$LOCALIZE[31140]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(Pictures)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[10134]</label>
						<label2>$LOCALIZE[31140]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(FavouritesBrowser)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[744]</label>
						<label2>$LOCALIZE[31140]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(Videos,sources://video/,return)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13012]</label>
						<label2>$LOCALIZE[31022]</label2>
						<onclick>Quit()</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<item>
						<label>$LOCALIZE[13013]</label>
						<label2>$LOCALIZE[31022]</label2>
						<onclick>Reset()</onclick>
						<visible>System.CanReboot</visible>
					</item>
					<item>
						<label>$LOCALIZE[13016]</label>
						<label2>$LOCALIZE[31022]</label2>
						<onclick>Powerdown()</onclick>
						<visible>System.CanPowerDown</visible>
					</item>
					<item>
						<label>$LOCALIZE[31022]</label>
						<label2>$LOCALIZE[31141]</label2>
						<onclick>Dialog.Close(1151,true)</onclick>
						<onclick>ActivateWindow(shutdownmenu)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
