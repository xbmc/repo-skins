<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by tools/customrows/make_customrows.py: the path of a custom row that is not set up. Always empty
     (no film has this file name); a real path, because Kodi's list provider keeps the old items when a path turns
     empty. -->
<smartplaylist type="movies">
    <name>Custom row: not set</name>
    <match>all</match>
    <rule field="filename" operator="is">
        <value>customrows-not-set.none</value>
    </rule>
    <limit>1</limit>
</smartplaylist>
