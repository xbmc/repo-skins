				<width>26</width>
				<height>27</height>
				<visible>true</visible>
				<control type="image" id="1">
					<width>26</width>
					<height>27</height>
					<texture>flags/base 2.png</texture>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
				<control type="image" id="1">
					<left>5</left>
					<top>3</top>
					<width>21</width>
					<height>21</height>
					<texture>flags/icon_aspect.png</texture>
					<aspectratio>keep</aspectratio>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
			</control>
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$PARAM[aspect]</label>
				<font>flag.text</font>
				<textcolor>$INFO[Skin.String(color.500)]</textcolor>
				<disabledcolor>$INFO[Skin.String(color.500)]</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturenofocus>
				<enable>false</enable>
				<visible>true</visible>
			</control>
			<!-- audio codec (filled) -->
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$VAR[FlagLibAudioCodec]</label>
				<font>flag.text.caps</font>
				<textcolor>white</textcolor>
				<disabledcolor>white</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturenofocus>
				<enable>false</enable>
				<visible>!String.IsEqual(ListItem.AudioCodec,eac3_ddp_atmos) + !String.IsEqual(ListItem.AudioCodec,truehd_atmos)</visible>
			</control>
			<control type="group" id="1">
