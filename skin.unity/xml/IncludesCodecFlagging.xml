				</control>
				<control type="label" id="1">
					<left>7</left>
					<top>2</top>
					<width>46</width>
					<height>13</height>
					<font>flag.stack.top</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>white</textcolor>
					<label>DOLBY +</label>
				</control>
				<control type="label" id="1">
					<left>7</left>
					<top>14</top>
					<width>46</width>
					<height>11</height>
					<font>flag.stack.bottom</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>white</textcolor>
					<label>ATMOS</label>
				</control>
			</control>
			<control type="group" id="1">
				<width>69</width>
				<height>27</height>
				<visible>String.IsEqual(ListItem.AudioCodec,truehd_atmos)</visible>
				<control type="image" id="1">
					<width>69</width>
					<height>27</height>
					<texture colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texture>
				</control>
				<control type="label" id="1">
					<left>7</left>
					<top>2</top>
					<width>55</width>
					<height>13</height>
					<font>flag.stack.top</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>white</textcolor>
					<label>DOLBY HD</label>
				</control>
				<control type="label" id="1">
					<left>7</left>
					<top>14</top>
					<width>55</width>
					<height>11</height>
					<font>flag.stack.bottom</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>white</textcolor>
					<label>ATMOS</label>
				</control>
			</control>
			<!-- audio channels (outlined) -->
			<control type="group" id="1">
				<width>26</width>
				<height>27</height>
				<visible>true</visible>
				<control type="image" id="1">
					<width>26</width>
					<height>27</height>
					<texture>flags/base 2.png</texture>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
				<control type="image" id="1">
					<left>5</left>
					<top>3</top>
					<width>21</width>
					<height>21</height>
					<texture>flags/icon_channels.png</texture>
					<aspectratio>keep</aspectratio>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
			</control>
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$VAR[FlagLibAudioChannels]</label>
				<font>flag.text.caps</font>
				<textcolor>$INFO[Skin.String(color.500)]</textcolor>
				<disabledcolor>$INFO[Skin.String(color.500)]</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturefocus>
