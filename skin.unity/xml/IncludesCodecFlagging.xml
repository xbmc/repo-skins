<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="media.flags.small">
		<!-- media badges for the focused library item: same row as playback (video.flags.info), from the
		     library's stream details. Each view passes its width so a right-aligned row ends at the panel's
		     inner right edge (same padding as on the left). The info screen: left-aligned, aspect ratio as "16:9 (1.78)". -->
		<param name="width" default="510" />
		<param name="align" default="right" />
		<param name="aspect" default="$VAR[FlagLibAspect]" />
		<definition>
		<control type="grouplist" id="1">
			<top>6</top>
			<width>$PARAM[width]</width>
			<height>27</height>
			<itemgap>0</itemgap>
			<align>$PARAM[align]</align>
			<orientation>horizontal</orientation>
			<visible>!String.IsEmpty(ListItem.VideoResolution) | !String.IsEmpty(ListItem.VideoCodec) | !String.IsEmpty(ListItem.AudioCodec)</visible>
			<!-- BEGIN generated: flag-row-library (tools/gen_flag_labels.py) -->
			<!-- Generated by tools/gen_flag_labels.py - edit the script, not this block.
			     Badges: [icon][7][text][7]; filled and outlined badges alternate. -->
			<!-- left cap: the row starts with an outlined badge -->
			<control type="image" id="1">
				<width>1.4</width>
				<height>27</height>
				<texture>backgrounds/white.png</texture>
				<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				<visible>true</visible>
			</control>
			<!-- resolution (outlined), with the HDR type when there is one: "4K HDR10" -->
			<control type="group" id="1">
				<width>26</width>
				<height>27</height>
				<visible>true</visible>
				<control type="image" id="1">
					<width>26</width>
					<height>27</height>
					<texture>flags/base 2.png</texture>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
				<control type="image" id="1">
					<left>5</left>
					<top>3</top>
					<width>21</width>
					<height>21</height>
					<texture>flags/icon_resolution.png</texture>
					<aspectratio>keep</aspectratio>
					<colordiffuse>$INFO[Skin.String(color.500)]</colordiffuse>
				</control>
			</control>
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$VAR[FlagLibResolution]</label>
				<font>flag.text.caps</font>
				<textcolor>$INFO[Skin.String(color.500)]</textcolor>
				<disabledcolor>$INFO[Skin.String(color.500)]</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texturenofocus>
				<enable>false</enable>
				<visible>true</visible>
			</control>
			<control type="group" id="1">
				<width>44</width>
				<height>27</height>
				<visible>String.IsEqual(ListItem.HdrType,dolbyvision)</visible>
				<control type="image" id="1">
					<width>44</width>
					<height>27</height>
					<texture colordiffuse="$INFO[Skin.String(color.500)]">flags/base 2.png</texture>
				</control>
				<control type="label" id="1">
					<left>0</left>
					<top>2</top>
					<width>37</width>
					<height>13</height>
					<font>flag.stack.top</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>$INFO[Skin.String(color.500)]</textcolor>
					<label>DOLBY</label>
				</control>
				<control type="label" id="1">
					<left>0</left>
					<top>14</top>
					<width>37</width>
					<height>11</height>
					<font>flag.stack.bottom</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>$INFO[Skin.String(color.500)]</textcolor>
					<label>VISION</label>
				</control>
			</control>
			<!-- video codec (filled) -->
			<control type="button" id="1">
				<width min="10">auto</width>
				<height>27</height>
				<label>$VAR[FlagLibVideoCodec]</label>
				<font>flag.text.caps</font>
				<textcolor>white</textcolor>
				<disabledcolor>white</disabledcolor>
				<textoffsetx>7</textoffsetx>
				<aligny>center</aligny>
				<texturefocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturefocus>
				<texturenofocus colordiffuse="$INFO[Skin.String(color.500)]">backgrounds/white.png</texturenofocus>
				<enable>false</enable>
				<visible>true</visible>
			</control>
			<!-- aspect ratio (outlined): "2.40" ($PARAM[aspect] in the library: the info screen shows "12:5 (2.40)") -->
