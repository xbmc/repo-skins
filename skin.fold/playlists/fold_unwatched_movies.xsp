<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Fold / Home Films row A "Unwatched": films never played, newest added first (the skin also sorts the
     container by dateadded, because widget paths don't always honour <order>). Also the pool counter. -->
<smartplaylist type="movies">
    <name>Unwatched</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <order direction="descending">dateadded</order>
</smartplaylist>
