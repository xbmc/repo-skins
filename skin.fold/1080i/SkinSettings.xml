<?xml version="1.0" encoding="UTF-8"?>
<!--
	Skin settings (docs/skin.fold/SETTINGS.md): one folded note, sixteen rows (the list scrolls). Each row is one button: OK or Right
	steps to the next value, Left to the previous one, applied at once. Values are stored as explicit keywords
	(an empty Skin.SetString value can open the keyboard: LESSONS round 3, Void).
	  9601 fold.reducemotion   bool    folds become quick fades
	  9602 fold.osdhide        string  3 | 5 (default, also empty) | 10 | off
	  9603 fold.hideclock      bool    the clock on the table
	  9604 fold.hidetrailer    bool    the Trailer word in the spread
	  9605 fold.watchedmarkers string  both (default) | unwatched (= no punched holes)
	  9606 reset: the library opens on the Fold views again (clears fold.vreset.*)
	  9607-9610 HideMenu.Movies / TVShows / Music / Search  bool  the Home tabs (main menu)
	  9611-9613 custom rows 1-3 on Home: CustomRow.<n>.Path / .Label / .Target / .Addon strings, OK opens the row's
	            options (Includes_CustomRows.xml); favourites data list 9889
	  9614-9616 custom menu items 1-3 (tabs on Home): CustomMenu.<n>.Path / .Label / .Target / .Icon / .Addon strings,
	            OK opens the item's options (Includes_CustomMenu.xml)
	Back closes the window (Kodi).
-->
<window>
	<defaultcontrol always="true">9600</defaultcontrol>
	<backgroundcolor>table</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Fold_Background</include>
		<include>CustomRows_FavData</include>
		<include>Fold_Tabs</include>
		<include>Fold_Clock</include>
		<include content="Fold_RowHead">
			<param name="top" value="118"/>
			<param name="label" value="Skin"/>
			<param name="sub" value="   Fold's own options"/>
		</include>
		<control type="group">
			<left>420</left>
			<top>196</top>
			<width>1080</width>
			<height>760</height>
			<include content="Anim_StandUp"><param name="bottom" value="956"/></include>
			<control type="image">
				<left>-96</left>
				<top>-96</top>
				<right>-96</right>
				<bottom>-96</bottom>
				<texture border="104">fold/shadow_spread.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture border="6" colordiffuse="cream">fold/rr4.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture diffuse="fold/rr4.png">fold/tooth_cream.png</texture>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture border="4" colordiffuse="graph">fold/edge_all.png</texture>
			</control>
			<control type="label">
				<left>64</left>
				<top>44</top>
				<width>900</width>
				<height>80</height>
				<font>disp_72</font>
				<label>$LOCALIZE[31024]</label>
			</control>
			<control type="label">
				<left>66</left>
				<top>126</top>
				<width>900</width>
				<height>40</height>
				<font>light_30</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[31352]</label>
			</control>
			<control type="grouplist" id="9600">
				<left>48</left>
				<top>196</top>
				<width>984</width>
				<height>456</height>
				<orientation>vertical</orientation>
				<itemgap>4</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<include content="SkinSet_Row">
					<param name="id" value="9601"/>
					<param name="label" value="Reduce motion"/>
					<param name="value" value="$VAR[SkinSet_Motion]"/>
					<param name="next" value="Skin.ToggleSetting(fold.reducemotion)"/>
					<param name="prev" value="Skin.ToggleSetting(fold.reducemotion)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9602"/>
					<param name="label" value="Fold the player controls away after"/>
					<param name="value" value="$VAR[SkinSet_OSDHide]"/>
					<param name="next" value="$VAR[SkinSet_OSDHideNext]"/>
					<param name="prev" value="$VAR[SkinSet_OSDHidePrev]"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9603"/>
					<param name="label" value="Clock on the table"/>
					<param name="value" value="$VAR[SkinSet_Clock]"/>
					<param name="next" value="Skin.ToggleSetting(fold.hideclock)"/>
					<param name="prev" value="Skin.ToggleSetting(fold.hideclock)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9604"/>
					<param name="label" value="Trailer word in the open card"/>
					<param name="value" value="$VAR[SkinSet_Trailer]"/>
					<param name="next" value="Skin.ToggleSetting(fold.hidetrailer)"/>
					<param name="prev" value="Skin.ToggleSetting(fold.hidetrailer)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9605"/>
					<param name="label" value="Punch a hole in watched cards"/>
					<param name="value" value="$VAR[SkinSet_Punch]"/>
					<param name="next" value="$VAR[SkinSet_PunchToggle]"/>
					<param name="prev" value="$VAR[SkinSet_PunchToggle]"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9606"/>
					<param name="label" value="Open the library on Fold's views again"/>
					<param name="value" value="$VAR[SkinSet_ResetValue]"/>
					<param name="next" value="SetProperty(fold.viewsreset,1,home)"/>
					<param name="prev" value="noop"/>
					<param name="next2" value="Skin.Reset(fold.vreset.movies)"/>
					<param name="next3" value="Skin.Reset(fold.vreset.sets)"/>
					<param name="next4" value="Skin.Reset(fold.vreset.tvshows)"/>
					<param name="next5" value="Skin.Reset(fold.vreset.seasons)"/>
					<param name="next6" value="Skin.Reset(fold.vreset.episodes)"/>
					<param name="next7" value="Skin.Reset(fold.vreset.albums)"/>
					<param name="next8" value="Skin.Reset(fold.vreset.artists)"/>
				</include>
				<!-- 0.9.10 main menu (HideMenu.*): tabs on Home; Settings always stays -->
				<include content="SkinSet_Row">
					<param name="id" value="9607"/>
					<param name="label" value="$LOCALIZE[31700]"/>
					<param name="value" value="$VAR[SkinSet_HideMenu_Movies]"/>
					<param name="next" value="Skin.ToggleSetting(HideMenu.Movies)"/>
					<param name="prev" value="Skin.ToggleSetting(HideMenu.Movies)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9608"/>
					<param name="label" value="$LOCALIZE[31701]"/>
					<param name="value" value="$VAR[SkinSet_HideMenu_TVShows]"/>
					<param name="next" value="Skin.ToggleSetting(HideMenu.TVShows)"/>
					<param name="prev" value="Skin.ToggleSetting(HideMenu.TVShows)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9609"/>
					<param name="label" value="$LOCALIZE[31702]"/>
					<param name="value" value="$VAR[SkinSet_HideMenu_Music]"/>
					<param name="next" value="Skin.ToggleSetting(HideMenu.Music)"/>
					<param name="prev" value="Skin.ToggleSetting(HideMenu.Music)"/>
				</include>
				<include content="SkinSet_Row">
					<param name="id" value="9610"/>
					<param name="label" value="$LOCALIZE[31703]"/>
					<param name="value" value="$VAR[SkinSet_HideMenu_Search]"/>
					<param name="next" value="Skin.ToggleSetting(HideMenu.Search)"/>
					<param name="prev" value="Skin.ToggleSetting(HideMenu.Search)"/>
				</include>
				<!-- 0.9.10 custom rows on Home (Includes_CustomRows.xml): OK opens the row's options -->
				<include content="SkinSet_CustomRow"><param name="id" value="9611"/><param name="row" value="1"/><param name="label" value="$LOCALIZE[31941]"/></include>
				<include content="SkinSet_CustomRow"><param name="id" value="9612"/><param name="row" value="2"/><param name="label" value="$LOCALIZE[31942]"/></include>
				<include content="SkinSet_CustomRow"><param name="id" value="9613"/><param name="row" value="3"/><param name="label" value="$LOCALIZE[31943]"/></include>
				<!-- 0.9.15 custom menu items (Includes_CustomMenu.xml): tabs on Home after Music; OK opens the item's options -->
				<include content="SkinSet_CustomMenu"><param name="id" value="9614"/><param name="item" value="1"/><param name="label" value="$LOCALIZE[31981]"/></include>
				<include content="SkinSet_CustomMenu"><param name="id" value="9615"/><param name="item" value="2"/><param name="label" value="$LOCALIZE[31982]"/></include>
				<include content="SkinSet_CustomMenu"><param name="id" value="9616"/><param name="item" value="3"/><param name="label" value="$LOCALIZE[31983]"/></include>
			</control>
			<control type="textbox">
				<left>64</left>
				<top>664</top>
				<width>952</width>
				<height>68</height>
				<font>body_22</font>
				<textcolor>cap</textcolor>
				<label>$VAR[SkinSet_Help]</label>
			</control>
		</control>
		<control type="grouplist">
			<left>420</left>
			<top>1000</top>
			<width>1080</width>
			<height>32</height>
			<orientation>horizontal</orientation>
			<include content="Fold_KeyHint"><param name="key" value="OK"/><param name="label" value="Next value"/></include>
			<include content="Fold_KeyHint"><param name="key" value="← →"/><param name="label" value="Step through"/></include>
			<include content="Fold_KeyHint"><param name="key" value="BACK"/><param name="label" value="Done"/></include>
		</control>
	</controls>
</window>
