<?xml version="1.0" encoding="UTF-8"?>
<!--
	Context menu (long-press OK / Menu key) - M4, Builder E.
	Id contract (Estuary Omega): Kodi clones button template 1000 into grouplist 996, resizes the
	background image 999 to fit (keeping the gap between the grouplist's bottom and 999's bottom)
	and centres the window. 999's texture carries both the bg fill and the 1px hairline frame
	(media/dialogs/panel_framed.png) because Kodi only resizes that one image.
	Rows: 64px, accent fill + ink text on focus (always visible, independent of the outline setting).
-->
<window>
	<defaultcontrol>996</defaultcontrol>
	<!-- Options reach v2 (2026-10-29): in Videos / Music an item menu (one of Kodi's buttons 1001-1020 reads Add to /
	     Remove from favourites, 14076 / 14077; the resume prompt and the play-action chooser use this window too and never
	     carry it) gets one extra first row, 990, that opens the Library panel (1155) on View. Deferred with AlarmClock so
	     the panel is never nested inside this menu. Kodi's own buttons follow it and keep the initial focus. -->
	<include>Anim_DialogOpenClose</include>
	<!-- <origin> stops Kodi centring the menu on the focused control (in Fold's half-width lists that put
	     it off to one side); the panel group below centres itself instead. -->
	<coordinates>
		<origin x="0" y="0"/>
	</coordinates>
	<controls>
		<control type="group">
			<description>the menu</description>
			<control type="image">
				<left>-1920</left>
				<top>-1080</top>
				<width>5760</width>
				<height>3240</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="veil">common/white.png</texture>
			</control>
			<!-- centred: 560 wide; one row (64 + 16 padding) sits on the screen centre and every extra button
			     Kodi clones (ids 1002...) lifts the panel half a row, up to the 12-row grouplist cap -->
			<control type="group">
				<left>680</left>
				<top>500</top>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1002)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1003)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1004)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1005)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1006)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1007)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1008)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1009)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1010)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1011)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(1012)">Conditional</animation>
				<animation effect="slide" end="0,-32" time="0" condition="Control.IsVisible(990) + !Control.IsVisible(1012)">Conditional</animation>
				<control type="image" id="999">
					<description>background (Kodi sizes it)</description>
					<visible>!Control.IsVisible(990)</visible>
					<left>0</left>
					<top>0</top>
					<width>560</width>
					<height>796</height>
					<texture border="2">dialogs/panel_framed.png</texture>
				</control>
				<control type="group">
					<description>v2: the frame while row 990 shows (Kodi sizes 999 for its own buttons only, one row short): N Kodi buttons + 1 row</description>
					<visible>Control.IsVisible(990)</visible>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>144</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1001) + !Control.IsVisible(1002)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>208</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1002) + !Control.IsVisible(1003)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>272</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1003) + !Control.IsVisible(1004)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>336</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1004) + !Control.IsVisible(1005)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>400</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1005) + !Control.IsVisible(1006)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>464</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1006) + !Control.IsVisible(1007)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>528</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1007) + !Control.IsVisible(1008)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>592</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1008) + !Control.IsVisible(1009)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>656</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1009) + !Control.IsVisible(1010)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>720</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1010) + !Control.IsVisible(1011)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>784</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1011) + !Control.IsVisible(1012)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>560</width>
						<height>796</height>
						<texture border="2">dialogs/panel_framed.png</texture>
						<visible>Control.IsVisible(1012)</visible>
					</control>
				</control>
				<control type="grouplist" id="996">
					<description>grouplist for context buttons</description>
					<left>8</left>
					<top>8</top>
					<width>544</width>
					<height max="780">auto</height>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="button" id="990">
						<description>v2: the skin's options, first row of Kodi's own item menu (Kodi appends its buttons after it and keeps focus on its own first one)</description>
						<width>544</width>
						<height>dialog_row_h</height>
						<font>sans_26_semi</font>
						<label>$LOCALIZE[31430]</label>
						<onclick>Dialog.Close(contextmenu)</onclick>
						<onclick>AlarmClock(foldopen,ActivateWindow(1155),00:00,silent)</onclick>
						<visible>[Window.IsActive(videos) | Window.IsActive(music)] + [String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14077])]</visible>
					</control>
				</control>
			</control>
		</control>
		<control type="button" id="1000">
			<description>button template</description>
			<left>0</left>
			<top>0</top>
			<width>544</width>
			<height>dialog_row_h</height>
			<font>sans_26_semi</font>
		</control>
	</controls>
</window>
