<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library. Views (Includes_Views_Video.xml, generated by _src/make_views.py): 500 Shelf (films, sets,
	series), 501 Seasons, 502 Concertina (episodes), 50 List (everything); 0.9.13 Table 503, Leaflet 505, Prints 506; 0.9.16 Accordion 509. Timers.xml corrects a view that is
	hidden for the current content and opens each content type on its Fold view the first time.

	Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav): <views> containers; menucontrol 9000
	(header words); 3 sort-by / 4 sort-order (hidden buttons the words click); 14 watched toggle (SendClick).
	Focus map: header 9000 <-> view (Up from the top row / Down from the words). Back = Kodi's parent folder;
	at the start folder Back goes Home (9398).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>table</backgroundcolor>
	<views>500,501,502,503,505,506,50,509</views>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
