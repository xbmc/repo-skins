<?xml version="1.0" encoding="UTF-8"?>
<!--
	PVR channel-group manager (SPEC 5: Minimal, Fold_GenericDialog). Builder F, M4.
	Kodi id contract (Estuary Omega DialogPVRGroupManager.xml): heading 1, groups list 13 +
	scrollbar 73, ungrouped channels list 11 + scrollbar 71 + header label 21, grouped channels
	list 12 + scrollbar 72 + header label 22, buttons in grouplist 9000: 29 OK, 26 add, 27 rename,
	25 hide (radio), 28 delete, 35 regenerate thumbnail, 34 TV/radio toggle; hidden label 20
	(Kodi passes the group name through it).
-->
<window>
	<defaultcontrol always="true">29</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1760</width>
			<height>960</height>
			<include content="Fold_GenericDialog">
				<param name="width" value="1760"/>
				<param name="height" value="960"/>
				<param name="header_id" value="1"/>
				<param name="header_label" value="$LOCALIZE[19048]"/>
			</include>
			<!-- ====== groups -->
			<include content="Misc_Caption">
				<param name="left" value="dialog_inset"/>
				<param name="top" value="dialog_content_top"/>
				<param name="width" value="400"/>
				<param name="label" value="Groups$INFO[Container(13).NumItems,  ·  ,]"/>
			</include>
			<control type="list" id="13">
				<left>dialog_inset</left>
				<top>156</top>
				<width>400</width>
				<height>704</height>
				<onup>13</onup>
				<ondown>13</ondown>
				<onleft>9000</onleft>
				<onright>11</onright>
				<pagecontrol>73</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Misc_SimpleListLayouts">
					<param name="width" value="400"/>
					<param name="list_id" value="13"/>
				</include>
			</control>
			<include content="Fold_Scrollbar">
				<param name="id" value="73"/>
				<param name="left" value="432"/>
				<param name="top" value="156"/>
				<param name="height" value="704"/>
				<param name="onleft" value="13"/>
				<param name="onright" value="11"/>
			</include>
			<control type="label">
				<left>dialog_inset</left>
				<top>876</top>
				<width>400</width>
				<height>40</height>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$INFO[Container(13).ListItem.Property(ClientName)]</label>
			</control>
			<!-- ====== channels not in the group -->
			<control type="label" id="21">
				<left>460</left>
				<top>dialog_content_top</top>
				<width>320</width>
				<height>36</height>
				<font>caps_20</font>
				<textcolor>$VAR[FoldAccent]</textcolor>
			</control>
			<control type="label">
				<left>460</left>
				<top>dialog_content_top</top>
				<width>420</width>
				<height>36</height>
				<align>right</align>
				<font>num_20</font>
				<textcolor>cap</textcolor>
				<label>$INFO[Container(11).NumItems]</label>
			</control>
			<control type="list" id="11">
				<left>460</left>
				<top>156</top>
				<width>420</width>
				<height>704</height>
				<onup>11</onup>
				<ondown>11</ondown>
				<onleft>13</onleft>
				<onright>12</onright>
				<pagecontrol>71</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Misc_SimpleListLayouts">
					<param name="width" value="420"/>
					<param name="list_id" value="11"/>
					<param name="label" value="$INFO[ListItem.ChannelNumberLabel,,  ]$INFO[ListItem.ChannelName]"/>
				</include>
			</control>
			<include content="Fold_Scrollbar">
				<param name="id" value="71"/>
				<param name="left" value="888"/>
				<param name="top" value="156"/>
				<param name="height" value="704"/>
				<param name="onleft" value="11"/>
				<param name="onright" value="12"/>
			</include>
			<!-- ====== channels in the group -->
			<control type="label" id="22">
				<left>916</left>
				<top>dialog_content_top</top>
				<width>320</width>
				<height>36</height>
				<font>caps_20</font>
				<textcolor>$VAR[FoldAccent]</textcolor>
			</control>
			<control type="label">
				<left>916</left>
				<top>dialog_content_top</top>
				<width>420</width>
				<height>36</height>
				<align>right</align>
				<font>num_20</font>
				<textcolor>cap</textcolor>
				<label>$INFO[Container(12).NumItems]</label>
			</control>
			<control type="list" id="12">
				<left>916</left>
				<top>156</top>
				<width>420</width>
				<height>704</height>
				<onup>12</onup>
				<ondown>12</ondown>
				<onleft>11</onleft>
				<onright>9000</onright>
				<pagecontrol>72</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Misc_SimpleListLayouts">
					<param name="width" value="420"/>
					<param name="list_id" value="12"/>
					<param name="label" value="$INFO[ListItem.ChannelNumberLabel,,  ]$INFO[ListItem.ChannelName]"/>
				</include>
			</control>
			<include content="Fold_Scrollbar">
				<param name="id" value="72"/>
				<param name="left" value="1344"/>
				<param name="top" value="156"/>
				<param name="height" value="704"/>
				<param name="onleft" value="12"/>
				<param name="onright" value="9000"/>
			</include>
			<!-- ====== actions -->
			<control type="grouplist" id="9000">
				<left>1376</left>
				<top>dialog_content_top</top>
				<width>360</width>
				<height>460</height>
				<orientation>vertical</orientation>
				<onleft>12</onleft>
				<onright>13</onright>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<control type="button" id="29">
					<description>OK</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[186]</label>
				</control>
				<control type="button" id="26">
					<description>Add group</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[31308]</label>
				</control>
				<control type="button" id="27">
					<description>Rename group</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[31309]</label>
				</control>
				<control type="radiobutton" id="25">
					<description>Hide group</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[19289]</label>
				</control>
				<control type="button" id="28">
					<description>Delete group</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[31310]</label>
				</control>
				<control type="button" id="35">
					<description>Regenerate group thumbnail</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<label>$LOCALIZE[13315]</label>
				</control>
				<control type="togglebutton" id="34">
					<description>TV / radio toggle</description>
					<include content="Misc_RowLook"><param name="width" value="360"/></include>
					<alttexturefocus border="16" colordiffuse="$VAR[FoldAccent]">focus/outline_2.png</alttexturefocus>
					<label>$LOCALIZE[19174]</label>
					<altlabel>$LOCALIZE[19173]</altlabel>
					<usealttexture>!String.IsEmpty(Window.Property(IsRadio))</usealttexture>
				</control>
			</control>
			<control type="image">
				<left>1376</left>
				<top>620</top>
				<width>360</width>
				<height>240</height>
				<aspectratio align="left" aligny="top">keep</aspectratio>
				<texture background="true">$INFO[Container(13).ListItem.Icon]</texture>
			</control>
		</control>
		<control type="label" id="20">
			<description>Hidden label Kodi uses to pass the group name</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
