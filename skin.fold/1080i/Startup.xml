<?xml version="1.0" encoding="UTF-8"?>
<!--
	Startup: black page + wordmark for the instant before Home. No splash timer.
	Goes to Kodi's configured startup window (default Home), like Estuary, so Omar's
	"Settings > Interface > Startup window" keeps working.
-->
<window>
	<!-- region date order for the board dates (Includes_Dates.xml, Date_RegionMonthFirst) -->
	<onload>SetProperty(fold.monthday,$INFO[System.Date(MMMM D)],home)</onload>
	<onload>SetProperty(fold.monthyear,$INFO[System.Date(MMMM YYYY)],home)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls>
		<include>Fold_Background</include>
		<control type="label">
			<left>page_margin</left>
			<top>460</top>
			<width>page_width</width>
			<height>140</height>
			<font>disp_96</font>
			<label>$LOCALIZE[31024]</label>
		</control>
	</controls>
</window>
