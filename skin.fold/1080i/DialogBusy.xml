<?xml version="1.0" encoding="UTF-8"?>
<!--
	Busy indicator (M4, Builder E; SPEC 5: tiny, non-blocking look). Bottom-right mono caption over
	a 2px track with a sliding accent segment - no full-screen dim, so the page stays readable.
	The slide only runs while this dialog is up; with Reduce motion the segment stays still.
	Kodi writes a percentage into label 10 when it knows one (Estuary contract).
	Hidden at startup and while the player caches (the OSD shows buffering itself).
-->
<window>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(startup) + !Player.Caching</visible>
			<right>page_margin</right>
			<bottom>64</bottom>
			<width>240</width>
			<height>48</height>
			<control type="image">
				<left>-48</left>
				<top>-44</top>
				<width>336</width>
				<height>136</height>
				<texture border="40">fold/slip_shadow.png</texture>
			</control>
			<control type="image">
				<left>-16</left>
				<top>-12</top>
				<width>272</width>
				<height>72</height>
				<texture border="6" colordiffuse="cream">fold/rr3.png</texture>
			</control>
			<control type="image">
				<left>-16</left>
				<top>-12</top>
				<width>6</width>
				<height>72</height>
				<texture colordiffuse="$VAR[FoldAccent]">common/white.png</texture>
			</control>
			<!-- a small card turning on its hinge while Kodi works -->
			<control type="image">
				<left>10</left>
				<top>4</top>
				<width>28</width>
				<height>40</height>
				<texture colordiffuse="cream_edge">common/white.png</texture>
			</control>
			<control type="image">
				<left>10</left>
				<top>4</top>
				<width>28</width>
				<height>40</height>
				<camera x="10" y="24"/>
				<texture border="6" colordiffuse="$VAR[FoldAccent]">fold/rr3.png</texture>
				<animation type="Conditional" condition="!Skin.HasSetting(fold.reducemotion)" loop="true" reversible="false">
					<effect type="rotatey" start="0" end="80" center="10" time="450" tween="sine" easing="inout"/>
					<effect type="rotatey" start="0" end="-80" center="10" delay="450" time="450" tween="sine" easing="inout"/>
				</animation>
			</control>
			<control type="label">
				<left>48</left>
				<top>0</top>
				<width>192</width>
				<height>48</height>
				<align>right</align>
				<font>caps_20_b</font>
				<label>$LOCALIZE[31013]$INFO[Control.GetLabel(10),  ·  ,%]</label>
			</control>
			<control type="label" id="10">
				<description>progress % (Kodi)</description>
				<visible>false</visible>
			</control>
		</control>
	</controls>
</window>
