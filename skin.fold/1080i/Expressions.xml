<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin setting names are documented in docs/skin.fold/SETTINGS.md.
	Rule (SPEC section 7): an empty string / unset bool always means the default.
-->
<includes>
	<!-- Helpers -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting 2: corners -->
	<expression name="IsRounded">false</expression>

	<!-- Setting 3: focus outline (empty or thin = thin) -->
	<expression name="FocusOutlineOff">String.IsEqual(Skin.String(fold.focusoutline),off)</expression>
	<expression name="FocusOutlineMedium">String.IsEqual(Skin.String(fold.focusoutline),medium)</expression>

	<!-- Setting 4: artwork background (empty = faint). Forced off without TMDb Helper. Wired in M2 (T15). -->
	<expression name="ArtBackgroundOn">!String.IsEqual(Skin.String(fold.artbackground),off) + System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>

	<!-- Setting 5: trailer button -->
	<expression name="ShowTrailerButton">!Skin.HasSetting(fold.hidetrailer)</expression>

	<!-- Setting 6: watched indicators (empty or both = both) -->
	<expression name="ShowUnwatchedMarkers">String.IsEmpty(Skin.String(fold.watchedmarkers)) | String.IsEqual(Skin.String(fold.watchedmarkers),both) | String.IsEqual(Skin.String(fold.watchedmarkers),unwatched)</expression>
	<expression name="ShowWatchedMarkers">String.IsEmpty(Skin.String(fold.watchedmarkers)) | String.IsEqual(Skin.String(fold.watchedmarkers),both) | String.IsEqual(Skin.String(fold.watchedmarkers),watched)</expression>

	<!-- Setting 7: spotlight rotation (empty = 15 s). Wired in M2 (T12). -->
	<expression name="SpotlightRotateOff">String.IsEqual(Skin.String(fold.spotlightrotate),off)</expression>

	<!-- Setting 8: reduce motion -->
	<expression name="ReduceMotion">Skin.HasSetting(fold.reducemotion)</expression>

	<!-- Setting 9 (Omar, 2026-10-18): Home newest row. empty or added = date added, release, both -->
	<expression name="HomeNewestDateAdded">!String.IsEqual(Skin.String(fold.home.newest),release)</expression>
	<expression name="HomeNewestRelease">String.IsEqual(Skin.String(fold.home.newest),release) | String.IsEqual(Skin.String(fold.home.newest),both)</expression>
	<expression name="HomeNewestBoth">String.IsEqual(Skin.String(fold.home.newest),both)</expression>

	<!-- Items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>

	<!-- Windows -->
	<expression name="InfoDialogActive">Window.IsVisible(movieinformation) | Window.IsVisible(musicinformation) | Window.IsVisible(addoninformation)</expression>
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>

	<!-- Fold: which section's card stock is live (FoldAccent). Info dialogs first, then libraries, then Home's tab. -->
	<expression name="InfoIsSeries">Window.IsVisible(movieinformation) + [String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)]</expression>
	<expression name="SectionSeries">$EXP[InfoIsSeries] | [Player.HasVideo + VideoPlayer.Content(episodes) + [Window.IsVisible(fullscreenvideo) | Window.IsVisible(videoosd)] + !Window.IsVisible(movieinformation)] | [!Window.IsVisible(movieinformation) + Window.IsVisible(videos) + [Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)]] | [Window.IsVisible(home) + !Window.IsVisible(movieinformation) + String.IsEqual(Window(Home).Property(fold.section),series)]</expression>
	<expression name="SectionMusic">Window.IsVisible(musicinformation) | Window.IsVisible(music) | Window.IsVisible(musicplaylist) | Window.IsVisible(musicplaylisteditor) | Window.IsVisible(visualisation) | Window.IsVisible(musicosd) | [Window.IsVisible(home) + !Window.IsVisible(movieinformation) + String.IsEqual(Window(Home).Property(fold.section),music)]</expression>
	<expression name="SectionSearch">Window.IsVisible(1150) | [Window.IsVisible(home) + !Window.IsVisible(movieinformation) + String.IsEqual(Window(Home).Property(fold.section),search)]</expression>
	<expression name="SectionSettings">Window.IsVisible(settings) | Window.IsVisible(playersettings) | Window.IsVisible(mediasettings) | Window.IsVisible(interfacesettings) | Window.IsVisible(systemsettings) | Window.IsVisible(servicesettings) | Window.IsVisible(pvrsettings) | Window.IsVisible(gamesettings) | Window.IsVisible(appearancesettings) | Window.IsVisible(addonsettings) | Window.IsVisible(skinsettings) | Window.IsVisible(1151) | Window.IsVisible(addonbrowser) | Window.IsVisible(systeminfo) | Window.IsVisible(programs) | Window.IsVisible(filemanager) | Window.IsVisible(profiles) | Window.IsVisible(eventlog) | [Window.IsVisible(home) + !Window.IsVisible(movieinformation) + String.IsEqual(Window(Home).Property(fold.section),settings)]</expression>
	<!-- 0.9.15: Home can refocus the remembered tab (a hidden tab or a cleared custom item can't) -->
	<expression name="Home_RefocusValid">[[String.IsEmpty(Window(Home).Property(fold.section)) | String.IsEqual(Window(Home).Property(fold.section),films)] + !Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(fold.section),series) + !Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(fold.section),music) + !Skin.HasSetting(HideMenu.Music)] | [String.IsEqual(Window(Home).Property(fold.section),search) + !Skin.HasSetting(HideMenu.Search)] | String.IsEqual(Window(Home).Property(fold.section),settings) | [String.IsEqual(Window(Home).Property(fold.section),custom1) + $EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(fold.section),custom2) + $EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(fold.section),custom3) + $EXP[CustomMenu3On]]</expression>
	<!-- 0.9.15: Home on a custom menu item's tab (graphite accent: no section colour of its own) -->
	<expression name="SectionCustom">Window.IsVisible(home) + !Window.IsVisible(movieinformation) + String.StartsWith(Window(Home).Property(fold.section),custom)</expression>
</includes>
