<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Focus language everywhere: accent 2px frame (focus/outline_2.png, border 16) or accent fill.
	Colours are names from colors/defaults.xml; $VAR[FoldAccent] = live accent (setting 1).
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<selectedcolor>ink</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="on_card">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[FoldAccent]">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="on_card">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="rule_strong">common/rect_outline_1.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="disabled">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="10" colordiffuse="disabled">common/rect_outline_1.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="cap">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="cap" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="on_card">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="on_card" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="cap">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="cap" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="on_card">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="on_card" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="rule">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="rule_soft">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink2">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[FoldAccent]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="rule">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="rule_soft">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink2">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[FoldAccent]">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="disabled">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>$VAR[FoldOnAccent]</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<invalidcolor>verm</invalidcolor>
		<texturefocus border="6" colordiffuse="$VAR[FoldAccent]">fold/chip.png</texturefocus>
		<texturenofocus border="10" colordiffuse="rule_strong">common/rect_outline_1.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="rule">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="$VAR[FoldAccent]">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="rule_soft">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="cap">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="$VAR[FoldAccent]">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
