<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information = the card opened into its spread (FoldOpen / FoldHalfOpen). Movie, episode, TV show,
	season and collection share one spread; texts switch on ListItem.DBType. All of it: Includes_VideoInfo.xml,
	generated by _src/make_spread.py (ids, timings and the two-phase hinge are documented there).

	Focus map: action words 9000 (Resume · Start | Play | Open · Trailer · More) -Right-> cast 50 -Left-> words.
	  More -> the More note 9100 (Back / Left / Right return to More); Read the full plot -> note 9200 (scrollbar 61).
	  Back closes the dialog: the card folds shut and returns to the slot it came from.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onunload>ClearProperty(fold.from,home)</onunload>
	<controls>
		<include>Spread_Window</include>
	</controls>
</window>
