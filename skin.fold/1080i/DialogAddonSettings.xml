<?xml version="1.0" encoding="UTF-8"?>
<!--
	Add-on settings (TMDb Helper, YouTube, subtitle services ...) - M4, Builder E.
	Full-screen Index page in the Settings.dc.html grid so it reads like Kodi's own settings:
	categories x96 w380, list x560 w860, aside x1500 w324 with OK / Cancel / Defaults and the
	description of the focused setting.
	Id contract (Estuary Omega): heading 2, categories grouplist 3 + template 10, control area 5,
	description 6, templates 7-15, buttons 28 / 29 / 30 in grouplist 9000, level button 20,
	scrollbar 60.
-->
<window>
	<defaultcontrol>5</defaultcontrol>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Fold_Background</include>
		<!-- ====== header: mono index + add-on name (Kodi writes label 2) -->
		<control type="grouplist">
			<left>page_margin</left>
			<top>topbar_item_top</top>
			<width>1300</width>
			<height>topbar_item_h</height>
			<orientation>horizontal</orientation>
			<itemgap>20</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label">
				<top>14</top>
				<width>auto</width>
				<height>30</height>
				<font>caps_20</font>
				<textcolor>$VAR[FoldAccent]</textcolor>
				<label>$LOCALIZE[31304]</label>
			</control>
			<control type="label" id="2">
				<description>heading (Kodi)</description>
				<width max="1100">auto</width>
				<height>topbar_item_h</height>
				<font>head_34</font>
			</control>
		</control>
		<include>Fold_Clock</include>
		<include>Fold_TopRule</include>

		<!-- ====== categories + level -->
		<control type="grouplist" id="3">
			<description>categories</description>
			<left>page_margin</left>
			<top>content_top</top>
			<width>settings_cat_w</width>
			<height>576</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="Fold_SettingCategoryTemplate">
			<param name="width" value="settings_cat_w"/>
		</include>
		<control type="group">
			<left>page_margin</left>
			<top>760</top>
			<include content="Fold_SettingLevelButton">
				<param name="width" value="settings_cat_w"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list -->
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>settings_list_x</left>
			<top>content_top</top>
			<width>860</width>
			<height>864</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>9000</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="Fold_SettingTemplates">
			<param name="width" value="860"/>
		</include>
		<include content="Fold_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1440"/>
			<param name="top" value="content_top"/>
			<param name="height" value="864"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="9000"/>
		</include>

		<!-- ====== aside: buttons + description -->
		<control type="grouplist" id="9000">
			<left>1500</left>
			<top>content_top</top>
			<width>324</width>
			<height>216</height>
			<orientation>vertical</orientation>
			<itemgap>12</itemgap>
			<onleft>5</onleft>
			<onright>noop</onright>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<include content="Fold_DialogButton"><param name="id" value="28"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
			<include content="Fold_DialogButton"><param name="id" value="29"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
			<include content="Fold_DialogButton"><param name="id" value="30"/><param name="width" value="324"/><param name="height" value="dlg_btn_h"/></include>
		</control>
		<control type="group">
			<left>1500</left>
			<top>420</top>
			<width>324</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>324</width>
				<height>20</height>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$LOCALIZE[31305]</label>
			</control>
			<include content="Fold_Rule">
				<param name="top" value="32"/>
				<param name="left" value="0"/>
				<param name="width" value="324"/>
			</include>
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>0</left>
				<top>52</top>
				<width>324</width>
				<height>549</height>  <!-- 19 lines exactly: no half-clipped line at the bottom -->
				<font>body_20</font>
				<textcolor>ink2</textcolor>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>
	</controls>
</window>
