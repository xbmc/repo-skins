<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml (never hex in windows).
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->

	<!-- Section colour (DESIGN: card stock). Home: the focused tab / section property; libraries: the content type. -->
	<variable name="FoldAccent">
		<value condition="$EXP[SectionCustom]">graph</value>
		<value condition="$EXP[SectionSeries]">cobalt</value>
		<value condition="$EXP[SectionMusic]">mari</value>
		<value condition="$EXP[SectionSearch]">jade</value>
		<value condition="$EXP[SectionSettings]">graph</value>
		<value>verm</value>
	</variable>
	<!-- The section colour as TEXT on cream / table (marigold prints as ochre) -->
	<variable name="FoldAccentInk">
		<value condition="$EXP[SectionCustom]">graph</value>
		<value condition="$EXP[SectionSeries]">cobalt</value>
		<value condition="$EXP[SectionMusic]">mari_ink</value>
		<value condition="$EXP[SectionSearch]">jade</value>
		<value condition="$EXP[SectionSettings]">graph</value>
		<value>verm</value>
	</variable>
	<!-- Text printed on the section colour: ink on marigold (cream would be 1.9:1), cream elsewhere -->
	<variable name="FoldOnAccent">
		<value condition="$EXP[SectionMusic]">ink</value>
		<value>on_card</value>
	</variable>
	<variable name="FoldRule">
		<value>rule_soft</value>
	</variable>
	<variable name="FoldCaption">
		<value>cap</value>
	</variable>

	<!-- ==================================================================== textures -->

	<!-- Frames for controls that must ALWAYS show focus (buttons, dialogs): never empty -->
	<variable name="FocusFrameAlways">
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>

	<!-- Button fill / outline (32x32, border 10) -->
	<variable name="ButtonOutline">
		<value condition="$EXP[IsRounded]">common/rect_outline_1_round8.png</value>
		<value>common/rect_outline_1.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="DateLabel">
		<value>$INFO[System.Date(ddd)] $INFO[System.Date(d)] $INFO[System.Date(mmm)]</value>
	</variable>
	<variable name="ClockLabel">
		<value>$INFO[System.Time]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>

	<!-- Count words: "1 season", not "1 seasons" (2026-10-30). Used by the _src generators. -->
	<variable name="Fold_N_TotalEpisodes_episodes">
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">  ·  1 episode</value>
		<value>$INFO[ListItem.Property(TotalEpisodes),  ·  , episodes]</value>
	</variable>
	<variable name="Fold_N_TotalEpisodes_episodes2">
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">1 episode</value>
		<value>$INFO[ListItem.Property(TotalEpisodes),, episodes]</value>
	</variable>
	<variable name="Fold_N_TotalSeasons_seasons">
		<value condition="Integer.IsEqual(ListItem.Property(TotalSeasons),1)">  ·  1 season</value>
		<value>$INFO[ListItem.Property(TotalSeasons),  ·  , seasons]</value>
	</variable>
	<variable name="Fold_N_Total_films">
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">  ·  1 film</value>
		<value>$INFO[ListItem.Property(Total),  ·  , films]</value>
	</variable>
	<variable name="Fold_N_Total_films2">
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">1 FILM</value>
		<value>$INFO[ListItem.Property(Total),, FILMS]</value>
	</variable>
	<variable name="Fold_N_Total_films3">
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)"> · 1 film</value>
		<value>$INFO[ListItem.Property(Total), · , films]</value>
	</variable>
	<variable name="Fold_N_ContainerNumItems_seasons">
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 season</value>
		<value>$INFO[Container.NumItems,, seasons]</value>
	</variable>
	<variable name="Fold_N_ContainerNumItems_episodes">
		<value condition="Integer.IsEqual(Container.NumItems,1)">  ·  1 episode</value>
		<value>$INFO[Container.NumItems,  ·  , episodes]</value>
	</variable>
	<variable name="Fold_N_ContainerNumItems_episodes2">
		<value condition="Integer.IsEqual(Container.NumItems,1)">   1 episode</value>
		<value>$INFO[Container.NumItems,   , episodes]</value>
	</variable>
	<variable name="Fold_N_ContainerNumItems_episodes3">
		<value condition="Integer.IsEqual(Container.NumItems,1)"> · 1 episode</value>
		<value>$INFO[Container.NumItems, · , episodes]</value>
	</variable>
	<variable name="Fold_N_TotalSeasons_seasonsdot">
		<value condition="Integer.IsEqual(ListItem.Property(TotalSeasons),1)">1 season · </value>
		<value>$INFO[ListItem.Property(TotalSeasons),, seasons · ]</value>
	</variable>
	<variable name="Fold_N_TotalSeasons_seasons2">
		<value condition="Integer.IsEqual(ListItem.Property(TotalSeasons),1)"> · 1 season</value>
		<value>$INFO[ListItem.Property(TotalSeasons), · , seasons]</value>
	</variable>
	<variable name="Fold_N_Total_films4">
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">1 film</value>
		<value>$INFO[ListItem.Property(Total),, films]</value>
	</variable>
	<variable name="Fold_N_TotalEpisodes_episodes3">
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">[COLOR cobalt] · [/COLOR]1 episode</value>
		<value>$INFO[ListItem.Property(TotalEpisodes),[COLOR cobalt] · [/COLOR], episodes]</value>
	</variable>
	<variable name="Fold_N_TotalSeasons_seasons3">
		<value condition="Integer.IsEqual(ListItem.Property(TotalSeasons),1)">[COLOR cobalt] · [/COLOR]1 season</value>
		<value>$INFO[ListItem.Property(TotalSeasons),[COLOR cobalt] · [/COLOR], seasons]</value>
	</variable>
	<variable name="Fold_N_Total_films5">
		<value condition="Integer.IsEqual(ListItem.Property(Total),1)">[COLOR verm] · [/COLOR]1 film</value>
		<value>$INFO[ListItem.Property(Total),[COLOR verm] · [/COLOR], films]</value>
	</variable>
	<variable name="Fold_N_EpWord">
		<value condition="Integer.IsEqual(ListItem.Property(TotalEpisodes),1)"> episode</value>
		<value> episodes</value>
	</variable>
	<variable name="Fold_N_C9130_shows">
		<value condition="Integer.IsEqual(Container(9130).NumItems,1)">1 show</value>
		<value>$INFO[Container(9130).NumItems] shows</value>
	</variable>
	<variable name="Fold_N_C9192_films">
		<value condition="Integer.IsEqual(Container(9192).NumItems,1)">1 film</value>
		<value>$INFO[Container(9192).NumItems] films</value>
	</variable>
	<variable name="Fold_N_EpWord_9130">
		<value condition="Integer.IsEqual(Container(9130).ListItem.Property(TotalEpisodes),1)"> episode</value>
		<value> episodes</value>
	</variable>
	<variable name="Fold_N_EpWord_9131">
		<value condition="Integer.IsEqual(Container(9131).ListItem.Property(TotalEpisodes),1)"> episode</value>
		<value> episodes</value>
	</variable>
</includes>
