<?xml version="1.0" encoding="UTF-8"?>
<!--
	Channel list over live TV (SPEC 5: Minimal). Builder F, M4. Left panel over the picture;
	Left / Right on the list switch channel group (as Estuary).
	Kodi id contract (Estuary Omega DialogPVRChannelsOSD.xml): list 11, scrollbar 60, header label 2.
-->
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<left>0</left>
			<top>0</top>
			<width>1040</width>
			<height>1080</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1040</width>
				<height>1080</height>
				<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="veil">common/white.png</texture>
			</control>
			<control type="label" id="2">
				<description>header label</description>
				<left>page_margin</left>
				<top>topbar_item_top</top>
				<width>880</width>
				<height>topbar_item_h</height>
				<font>head_34</font>
				<label>$LOCALIZE[19019]$INFO[VideoPlayer.ChannelGroup,  ·  ,]</label>
			</control>
			<include content="Fold_Rule">
				<param name="top" value="topbar_rule_y"/>
				<param name="width" value="880"/>
				<param name="color" value="rule_soft"/>
			</include>
			<control type="label">
				<left>page_margin</left>
				<top>below_bar_top</top>
				<width>880</width>
				<height>subnav_h</height>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$LOCALIZE[31307]</label>
			</control>
			<control type="list" id="11">
				<left>page_margin</left>
				<top>200</top>
				<width>880</width>
				<height>792</height>
				<onup>11</onup>
				<ondown>11</ondown>
				<onleft>PreviousChannelGroup</onleft>
				<onright>NextChannelGroup</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Misc_PVRRowLayouts">
					<param name="list_id" value="11"/>
					<param name="width" value="880"/>
					<param name="number" value="$INFO[ListItem.ChannelNumberLabel]"/>
					<param name="text_x" value="120"/>
					<param name="label2" value="$INFO[ListItem.Title]"/>
					<param name="progress" value="ListItem.HasEpg + !ListItem.IsRecording"/>
				</include>
			</control>
			<include content="Fold_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="990"/>
				<param name="top" value="200"/>
				<param name="height" value="792"/>
				<param name="onleft" value="11"/>
				<param name="onright" value="11"/>
			</include>
		</control>
	</controls>
</window>
