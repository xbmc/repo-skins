<?xml version="1.0" encoding="UTF-8"?>
<!--
	Kodi settings pages (Player, Media, Interface, System, Services, ...) - M4, Builder E.
	Layout from mockups/Settings.dc.html: categories x96 w380, list x560 w860 (hairline rows,
	2px accent frame on focus), description in the right-hand aside x1500 w324.
	Escape hatch: Settings > Interface > Skin > Skin (DialogSelect) > Keep? (DialogConfirm).
	Id contract (Estuary Omega): section label 2 (Kodi writes it; shown as the page title),
	categories grouplist 3 + template 10, control area 5, description textbox 6, templates 7-15,
	level button 20, scrollbar 60.
-->
<window>
	<defaultcontrol>3</defaultcontrol>
	<backgroundcolor>table</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Fold_Background</include>
		<include content="Fold_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$INFO[Control.GetLabel(2)]"/>
			<param name="sub" value="$LOCALIZE[5]"/>
		</include>

		<!-- ====== categories -->
		<control type="grouplist" id="3">
			<description>categories (Kodi clones template 10 into it)</description>
			<left>page_margin</left>
			<top>content_top</top>
			<width>settings_cat_w</width>
			<height>648</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>5</onright>
			<onup>20</onup>
			<ondown>20</ondown>
		</control>
		<include content="Fold_SettingCategoryTemplate">
			<param name="width" value="settings_cat_w"/>
		</include>
		<control type="group">
			<left>page_margin</left>
			<top>880</top>
			<include content="Fold_SettingLevelButton">
				<param name="width" value="settings_cat_w"/>
				<param name="onleft" value="noop"/>
			</include>
		</control>

		<!-- ====== settings list, printed on a cream sheet -->
		<control type="image">
			<left>440</left>
			<top>60</top>
			<width>1124</width>
			<height>1032</height>
			<texture border="104">fold/shadow_spread.png</texture>
		</control>
		<control type="image">
			<left>536</left>
			<top>152</top>
			<width>932</width>
			<height>848</height>
			<texture border="6" colordiffuse="cream">fold/rr4.png</texture>
		</control>
		<control type="image">
			<left>536</left>
			<top>152</top>
			<width>932</width>
			<height>848</height>
			<texture diffuse="fold/rr4.png">fold/tooth_cream.png</texture>
		</control>
		<control type="image">
			<left>536</left>
			<top>152</top>
			<width>932</width>
			<height>848</height>
			<texture border="4" colordiffuse="$VAR[FoldAccentEdge]">fold/edge_all.png</texture>
		</control>
		<control type="grouplist" id="5">
			<description>control area</description>
			<left>settings_list_x</left>
			<top>content_top</top>
			<width>860</width>
			<height>792</height>
			<pagecontrol>60</pagecontrol>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>5</onup>
			<ondown>5</ondown>
		</control>
		<include content="Fold_SettingTemplates">
			<param name="width" value="860"/>
		</include>
		<include content="Fold_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="1440"/>
			<param name="top" value="content_top"/>
			<param name="height" value="792"/>
			<param name="onleft" value="5"/>
			<param name="onright" value="5"/>
		</include>

		<!-- ====== aside: what the focused setting does -->
		<control type="group">
			<left>1500</left>
			<top>content_top</top>
			<width>324</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>324</width>
				<height>20</height>
				<font>caps_20</font>
				<textcolor>cap</textcolor>
				<label>$LOCALIZE[31305]</label>
			</control>
			<include content="Fold_Rule">
				<param name="top" value="32"/>
				<param name="left" value="0"/>
				<param name="width" value="324"/>
			</include>
			<control type="textbox" id="6">
				<description>description (Kodi)</description>
				<left>0</left>
				<top>52</top>
				<width>324</width>
				<height>635</height>  <!-- 22 lines exactly: no half-clipped line at the bottom -->
				<font>body_20</font>
				<textcolor>ink2</textcolor>
				<autoscroll time="3000" delay="6000" repeat="6000">true</autoscroll>
			</control>
		</control>

		<control type="label" id="2">
			<description>section label (Kodi writes it; shown in the header)</description>
			<visible>false</visible>
		</control>
	</controls>
</window>
