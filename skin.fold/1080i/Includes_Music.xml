		<value condition="$EXP[Music_InfoIsSong]">Song$INFO[ListItem.Year, · ,]$INFO[ListItem.Duration, · ,]</value>
		<value condition="Integer.IsEqual(Container(50).NumItems,1)">Album$INFO[ListItem.Year, · ,] · 1 track</value>
		<value>Album$INFO[ListItem.Year, · ,]$INFO[Container(50).NumItems, · , tracks]</value>
	</variable>
	<variable name="Gate_Sub">
		<value condition="$EXP[Music_InfoIsArtist]">$INFO[ListItem.Property(Artist_Born)]$INFO[ListItem.Property(Artist_Formed)]</value>
		<value condition="$EXP[Music_InfoIsSong]">$INFO[ListItem.Artist]$INFO[ListItem.Album, · ,]</value>
		<value>$INFO[ListItem.Artist]</value>
	</variable>
	<variable name="Gate_InfoWord">
		<value condition="$EXP[Music_InfoIsSong]">Album</value>
		<value>Artist</value>
	</variable>
	<variable name="Gate_Hint">
