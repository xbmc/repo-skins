	<!-- ============================================================ now playing (make_music_player.py) -->
	<variable name="NP_Kicker">
		<value condition="Player.Paused">Paused$INFO[MusicPlayer.TrackNumber, · track ,]</value>
		<value>Now playing$INFO[MusicPlayer.TrackNumber, · track ,]</value>
	</variable>
	<variable name="NP_Next">
		<value condition="!String.IsEmpty(MusicPlayer.offset(1).Title)">Next  [COLOR ink]$INFO[MusicPlayer.offset(1).Title][/COLOR]$INFO[MusicPlayer.offset(1).Artist, · ,]</value>
		<value>Last track in the queue</value>
	</variable>
	<variable name="NP_Modes">
		<value condition="Integer.IsEqual(Playlist.Length(music),1)">1 track in the queue$VAR[NP_ModeSuffix]</value>
		<value>$INFO[Playlist.Position(music),Track , ]$INFO[Playlist.Length(music),of ,]$VAR[NP_ModeSuffix]</value>
	</variable>
	<variable name="NP_ModeSuffix">
		<value condition="Playlist.IsRandom + Playlist.IsRepeatOne">  ·  shuffle  ·  repeat one</value>
		<value condition="Playlist.IsRandom + Playlist.IsRepeat">  ·  shuffle  ·  repeat all</value>
		<value condition="Playlist.IsRandom">  ·  shuffle</value>
		<value condition="Playlist.IsRepeatOne">  ·  repeat one</value>
		<value condition="Playlist.IsRepeat">  ·  repeat all</value>
	</variable>
	<!-- Visualiser (VIS_PRESETS_BRIEF, 0.9.9): Now playing is the gatefold; the music OSD's "Visualiser" word swaps it for
	     Kodi's visualisation (skin bool fold.np.viz, off by default) and back ("The sleeve"). Kodi only creates the
	     visualisation add-on while control 2 is visible, so Visualisation.HasPresets is true only in this mode. -->
	<expression name="NP_VizMode">Skin.HasSetting(fold.np.viz) + Visualisation.Enabled</expression>
	<expression name="NP_VizPresets">Skin.HasSetting(fold.np.viz) + Visualisation.Enabled + Visualisation.HasPresets</expression>
	<variable name="NP_VizWord">
		<value condition="Skin.HasSetting(fold.np.viz)">$LOCALIZE[31422]</value>
		<value>$LOCALIZE[31421]</value>
	</variable>
	<variable name="NP_ShuffleWord">
		<value condition="Playlist.IsRandom">Shuffle on</value>
		<value>Shuffle off</value>
	</variable>
	<variable name="NP_RepeatWord">
		<value condition="Playlist.IsRepeatOne">Repeat one</value>
		<value condition="Playlist.IsRepeat">Repeat all</value>
		<value>Repeat off</value>
	</variable>
</includes>
