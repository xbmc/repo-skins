<?xml version="1.0" encoding="UTF-8"?>
<!--
	Home (docs/concepts/round4/mockups/FoldHome.html). Ids and properties: Includes_Home.xml (generated by
	_src/make_home.py).

	Focus map
	  tabs 9001-9005 (Left/Right wrap; OK opens the section's library, Search page, or the system cards)
	  0.9.15 custom menu items: tabs 9006-9008 after Music (only while set); Down -> the item's cream card
	    (9171-9173); OK on the tab or the card opens the item; Back returns to the tab.
	    Down -> row A of the section (closed cards lift and tilt on focus) -> Down -> row B (cream cards; the page
	    slides up and row A folds flat). Up retraces. Back from any row -> its tab. Back on a tab: nothing
	    (Kodi switches to the playing video if something plays).
	  OK on a film / episode / album card opens the info spread / gatefold from the card's slot.
	  0.9.10: Down from the last row of any section -> the custom rows (cream rows 9881-9883, opt-in in Skin
	    settings > Custom rows); the page slides on and row A folds flat. Up retraces, Back -> the tabs.
	Default focus on open: the tab of the section that was active when Home was left.
-->
<window>
	<!-- Hiding menu items can no longer leave Home without focus: Kodi falls back to the default control whenever
	     nothing has focus, so it is Settings (9005), which never hides (it was 9001, hidden with the films item).
	     The first onload focuses 9001 while it is shown, exactly as the old default did; the onloads below override it. -->
	<defaultcontrol always="true">9005</defaultcontrol>
	<onload condition="!Skin.HasSetting(HideMenu.Movies)">SetFocus(9001)</onload>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>table</backgroundcolor>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),series) + !Skin.HasSetting(HideMenu.TVShows)">SetFocus(9002)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),music) + !Skin.HasSetting(HideMenu.Music)">SetFocus(9003)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),search) + !Skin.HasSetting(HideMenu.Search)">SetFocus(9004)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),custom1) + $EXP[CustomMenu1On]">SetFocus(9006)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),custom2) + $EXP[CustomMenu2On]">SetFocus(9007)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),custom3) + $EXP[CustomMenu3On]">SetFocus(9008)</onload>
	<!-- 0.9.10 / 0.9.15: the remembered tab (or Films, the default) is hidden in Skin settings (HideMenu.*), or it was a
	     custom menu item that has been cleared: focus the first tab shown (Films, Series, Music, the custom tabs,
	     Search, Settings); its onfocus sets the section. Settings (9005) never hides. -->
	<onload condition="!$EXP[Home_RefocusValid] + !Skin.HasSetting(HideMenu.Movies)">SetFocus(9001)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + !Skin.HasSetting(HideMenu.TVShows)">SetFocus(9002)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + !Skin.HasSetting(HideMenu.Music)">SetFocus(9003)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + $EXP[CustomMenu1On]">SetFocus(9006)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !$EXP[CustomMenu1On] + $EXP[CustomMenu2On]">SetFocus(9007)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !$EXP[CustomMenu1On] + !$EXP[CustomMenu2On] + $EXP[CustomMenu3On]">SetFocus(9008)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !$EXP[CustomMenu1On] + !$EXP[CustomMenu2On] + !$EXP[CustomMenu3On] + !Skin.HasSetting(HideMenu.Search)">SetFocus(9004)</onload>
	<onload condition="!$EXP[Home_RefocusValid] + Skin.HasSetting(HideMenu.Movies) + Skin.HasSetting(HideMenu.TVShows) + Skin.HasSetting(HideMenu.Music) + !$EXP[CustomMenu1On] + !$EXP[CustomMenu2On] + !$EXP[CustomMenu3On] + Skin.HasSetting(HideMenu.Search)">SetFocus(9005)</onload>
	<onload condition="String.IsEqual(Window(Home).Property(fold.section),settings)">SetFocus(9005)</onload>
	<onload>ClearProperty(fold.from,home)</onload>
	<!-- region date order for the board dates (Includes_Dates.xml, Date_RegionMonthFirst) -->
	<onload>SetProperty(fold.monthday,$INFO[System.Date(MMMM D)],home)</onload>
	<onload>SetProperty(fold.monthyear,$INFO[System.Date(MMMM YYYY)],home)</onload>
	<onunload>SetProperty(fold.n.films,$INFO[Container(9191).NumItems],home)</onunload>
	<onunload>SetProperty(fold.n.series,$INFO[Container(9193).NumItems],home)</onunload>
	<onunload>SetProperty(fold.n.music,$INFO[Container(9194).NumItems],home)</onunload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Fold_Background</include>
		<include>Home_Counters</include>
		<include>CustomRows_Probes</include>
		<include>Home_Content</include>
		<include>Home_Tabs</include>
		<!-- 0.9.15: with all eight tabs on show (three custom menu items) the eighth tab reaches the clock -->
		<control type="group">
			<visible>!$EXP[Home_TabsFull]</visible>
			<include>Fold_Clock</include>
		</control>
		<include>Home_NowPlaying</include>
	</controls>
</window>
