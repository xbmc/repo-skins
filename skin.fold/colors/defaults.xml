<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.fold · coloured card on a light table. Source of truth: docs/skin.fold/DESIGN.md
    (values from the approved mockups docs/concepts/round4/mockups/Fold*.html). Format AARRGGBB.
    The live section colour is $VAR[FoldAccent] (Variables.xml): Films vermilion, Series cobalt,
    Music marigold, Search jade, Settings graphite. Text in the section colour uses $VAR[FoldAccentInk]
    (marigold is too light for text on the table, so it prints as ochre).
-->
<colors>
    <!-- Table and paper -->
    <color name="table">ffe9e7e2</color>          <!-- the table (page ground) -->
    <color name="table_lo">ffdedad3</color>       <!-- punched hole / table seen through the card -->
    <color name="cream">fff6f1e7</color>          <!-- inside stock of every card -->
    <color name="cream_deep">ffefe8db</color>     <!-- inside stock turned away from the light -->
    <color name="cream_edge">ffd9d1c1</color>     <!-- fore-edge of a closed card -->
    <!-- Ink -->
    <color name="ink">ff1d1b18</color>            <!-- titles, values -->
    <color name="body">ff2a2722</color>           <!-- plot -->
    <color name="ink2">ff3a362f</color>           <!-- taglines, secondary names -->
    <color name="cap">ff5b5750</color>            <!-- mono captions on the table -->
    <color name="cap2">ff6b665e</color>           <!-- row-head counts, fact labels -->
    <color name="mute">ff8a847a</color>           <!-- separators in the episode line -->
    <color name="disabled">661d1b18</color>
    <!-- Lines -->
    <color name="rule">381d1b18</color>           <!-- 22% ink: dotted leaders, hairlines -->
    <color name="rule_soft">1f1d1b18</color>      <!-- 12% ink: rows -->
    <color name="rule_strong">5c1d1b18</color>    <!-- 36% ink: perforation dots -->
    <color name="track">291d1b18</color>          <!-- 16% ink: empty progress cells -->
    <!-- Section card stock -->
    <color name="verm">ffd9452b</color>
    <color name="verm_edge">ffc63d25</color>
    <color name="cobalt">ff2347a8</color>
    <color name="mari">ffe7a42b</color>
    <color name="mari_ink">ffa86c0c</color>       <!-- marigold as text on cream / table -->
    <color name="jade">ff1e8a6a</color>
    <color name="graph">ff3a3a3c</color>
    <color name="on_card">fff6f1e7</color>        <!-- text printed on coloured card -->
    <color name="on_card2">bff6f1e7</color>       <!-- 75%: counts on unfocused tabs -->
    <!-- Veils and shadows (baked shadow textures carry their own alpha; tint with these) -->
    <color name="veil">5c1d1b18</color>           <!-- table dim behind folded notes (36% ink) -->
    <color name="veil_video">a614130f</color>     <!-- over moving video behind OSD notes -->
    <color name="video_dim">8c14130f</color>
    <color name="shadow">ff46200f</color>         <!-- warm brown for baked shadows on the table -->
    <color name="shadow_cool">ff0a143c</color>    <!-- cobalt cards cast blue-brown -->
    <color name="dim_tab">8cffffff</color>        <!-- tabs while a spread is open (opacity .55) -->
    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
</colors>
