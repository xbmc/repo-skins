<?xml version="1.0" encoding="UTF-8"?>
<!-- Six Degrees / Home "Newest": the film added to the library most recently. -->
<smartplaylist type="movies">
    <name>Newest</name>
    <match>all</match>
    <rule field="title" operator="doesnotcontain"><value>zzzzzzzz</value></rule>
    <limit>1</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
