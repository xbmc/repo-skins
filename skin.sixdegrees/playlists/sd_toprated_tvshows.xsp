<!-- Six Degrees / Home series "Unwatched 7.5+": series rated 7.5+ not watched to the end. -->
<smartplaylist type="tvshows">
    <name>Unwatched 7.5+</name>
    <match>all</match>
    <rule field="playcount" operator="is"><value>0</value></rule>
    <rule field="rating" operator="greaterthan"><value>7.449</value></rule>
    <order direction="ascending">random</order>
</smartplaylist>
