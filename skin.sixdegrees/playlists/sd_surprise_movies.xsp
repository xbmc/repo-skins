<?xml version="1.0" encoding="UTF-8"?>
<!-- Six Degrees / Home "Tonight's surprise": one random unwatched film. -->
<smartplaylist type="movies">
    <name>Tonight's surprise</name>
    <match>all</match>
    <rule field="inprogress" operator="false" />
    <rule field="playcount" operator="is"><value>0</value></rule>
    <limit>1</limit>
    <order direction="ascending">random</order>
</smartplaylist>
