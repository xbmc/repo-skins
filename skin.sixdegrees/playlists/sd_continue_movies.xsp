<?xml version="1.0" encoding="UTF-8"?>
<!-- Six Degrees / Home "Continue": films with a resume point, most recently played first. -->
<smartplaylist type="movies">
    <name>Continue</name>
    <match>all</match>
    <rule field="inprogress" operator="true" />
    <limit>2</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>
