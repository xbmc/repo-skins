<!-- Six Degrees / Home series "Tonight's surprise": one random series. -->
<smartplaylist type="tvshows">
    <name>Tonight's surprise</name>
    <match>all</match>
    <rule field="title" operator="doesnotcontain"><value>zzzzzzzz</value></rule>
    <limit>1</limit>
    <order direction="ascending">random</order>
</smartplaylist>
