<?xml version="1.0" encoding="UTF-8"?>
<!-- Six Degrees / Home music "Tonight's surprise": one random album you have never played. -->
<smartplaylist type="albums">
    <name>Tonight's surprise</name>
    <match>all</match>
    <rule field="playcount" operator="is"><value>0</value></rule>
    <limit>1</limit>
    <order direction="ascending">random</order>
</smartplaylist>
