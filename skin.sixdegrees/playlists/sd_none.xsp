<?xml version="1.0" encoding="UTF-8"?>
<!-- always empty: the Interchange line strip while ".." is focused or the stops scroll -->
<smartplaylist type="movies">
	<name>sd-none</name>
	<match>all</match>
	<rule field="title" operator="is">
		<value>sd-none-never-a-title</value>
	</rule>
</smartplaylist>
