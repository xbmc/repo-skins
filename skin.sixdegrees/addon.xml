<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.sixdegrees" version="0.9.22" name="Six Degrees" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required. script.skinvariables URL-encodes the typed search query (get_encoded_string,
		     unencoded_paths arrived in 2.1.21) and reads a film's billed cast, first director and first genre
		     from Kodi's own library (the map's lines); TMDb Helper stays optional. -->
		<import addon="script.skinvariables" version="2.1.21"/>
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Six Degrees - every direction is a connection.</summary>
		<description lang="en_GB">Browse your library by association, like a transit map. The film in focus is a station; Up rides its director's line, Right its lead actor, Left the second star, Down the films of the same year and genre. OK re-centres, Back retraces the route. Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#sixdegrees</website>
		<news>v0.9.22 - Counts read "1 season", "1 episode", "1 film" instead of the plural. Smaller download: removed images the skin never used.&#10;v0.9.21 - Empty pages no longer print "Nothing here" over the Back item; album titles on two lines keep their descenders.</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
			<screenshot>resources/screenshot-06.jpg</screenshot>
		</assets>
	</extension>
</addon>
