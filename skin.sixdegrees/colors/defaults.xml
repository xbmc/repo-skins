<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.sixdegrees · a transit map on crisp white. Source of truth: docs/skin.sixdegrees/DESIGN.md
    (values from the approved boards docs/concepts/round4/mockups/SixDegrees*.html, gen.py).
    Format AARRGGBB. Line colours are used ONLY for lines, station dots and line labels.
-->
<colors>
    <!-- Ground and surfaces -->
    <color name="ground">fff4f4f1</color>        <!-- the map paper -->
    <color name="card">ffffffff</color>          <!-- dialog cards, station dots, OSD sign -->
    <color name="wash">ffeaeae6</color>          <!-- quiet fills: unfocused fields, poster fallback -->
    <color name="wash_strong">ffe1e1dc</color>

    <!-- Ink -->
    <color name="ink">ff15161a</color>           <!-- titles, focus rings, the interchange ring -->
    <color name="body">ff2b2d33</color>          <!-- plot / long copy -->
    <color name="ink2">ff6b6d74</color>          <!-- secondary: meta, captions, inactive words -->
    <color name="ink3">ff9a9ca2</color>          <!-- hints only, disabled -->
    <color name="on_ink">ffffffff</color>        <!-- text on an ink pill -->

    <!-- Hairlines -->
    <color name="hair">ffd9dad6</color>
    <color name="hair_strong">ffc4c5c0</color>

    <!-- The four lines + the travelled route -->
    <color name="l_dir">ffe8492f</color>         <!-- Up: director (vermilion) -->
    <color name="l_lead">ff2d5bd8</color>        <!-- Right: lead actor (cobalt) -->
    <color name="l_co">ff8a4fd6</color>          <!-- Left: second star (violet) -->
    <color name="l_yg">ff1f9d57</color>          <!-- Down: year + genre (green) -->
    <color name="l_route">ff8c8e94</color>       <!-- route grey, start line on Home -->
    <color name="l_own">ff55606e</color>         <!-- 0.9.18: a custom menu item's own line on Home (slate) -->

    <!-- Veils, video, shadows -->
    <color name="veil">8c15161a</color>          <!-- dim behind dialog cards (ink 55%) -->
    <color name="video_dim">8c0b0b0b</color>     <!-- over moving video behind OSD panels -->
    <color name="track_on_art">8cffffff</color>  <!-- resume track drawn on a poster (white 55%) -->
    <color name="shadow">ff15161a</color>        <!-- tint for baked shadow textures (alpha lives in the PNG) -->

    <!-- Utility -->
    <color name="white">ffffffff</color>
    <color name="black">ff000000</color>
    <color name="clear">00ffffff</color>
</colors>
