<?xml version="1.0" encoding="UTF-8"?>
<!--
	Pictures (SPEC 5: Minimal, Misc_MediaWindow). Builder F, M4. Omar doesn't use pictures.
	Kodi id contract (Estuary Omega MyPics.xml): view container 50, menucontrol 9000, hidden sort
	buttons 3 / 4, buttons 6 (slideshow) / 7 (recursive slideshow), radiobutton 9 (randomise),
	add-on settings 624, get more 621.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground</backgroundcolor>
	<views>50</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the sub-nav instead (as MyVideoNav/MyMusicNav) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include content="Misc_MediaWindow">
			<param name="index" value="07"/>
			<param name="title" value="$LOCALIZE[1]"/>
			<param name="sub" value="$INFO[Container.FolderName]"/>
			<param name="extra" value="Misc_Extra_Pictures"/>
		</include>
	</controls>
</window>
