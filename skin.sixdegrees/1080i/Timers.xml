		<onstart condition="String.IsEmpty(Window(Home).Property(sixdegrees.enterline))">SetFocus(700)</onstart>
	</timer>
	<timer>
		<name>sd_mapfocus</name>
		<start reset="false">Window.IsActive(1160) + String.IsEmpty(System.CurrentControlId) + String.IsEmpty(Window(Home).Property(sixdegrees.enterline))</start>
		<stop>!String.IsEmpty(System.CurrentControlId) | !Window.IsActive(1160)</stop>
		<onstart>SetFocus(700)</onstart>
	</timer>
</timers>
