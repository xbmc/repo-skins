<!--
	The library panel, the view picker and the clean-library confirmation (docs/requests/library-panel/BRIEF.md).
	They live INSIDE the windows that use them (MyVideoNav, MyMusicNav, the map 1160), so Kodi's own ids (3 sort by,
	4 sort order, 14 watched toggle) and Control.IsVisible(<view>) work exactly as they do for the header pills.

	Ids: 9800 panel group, 9801 panel list (a line of stations, Dlg_IndexListLayout), 9850 picker group, 9851 picker
	list, 9890 confirm group (9891 No, 9892 / 9894 Yes), 9832 the "Options" station pill in the header, 9326 the
	header's "View" pill.
	Opening: SetFocus(9801 | 9851 | 9891). The cards are always "visible" (a hidden static list never fills its rows
	and can't take focus) and fade in / out with focus (Conditional fades), so focus never sits on something unseen.
	Where you came from: Window(Home).Property(sixdegrees.lib.from) = view | rail, (sixdegrees.pick.from) = panel | rail.
	Back on a card = a numeric onback to where you came from (a view keeps its item).
	Clean library: Kodi's CleanLibrary() builtin does NOT ask (verified in the Omega source), so the panel asks first,
	with No focused.
-->
<includes>
	<expression name="Lib_LibraryActions">!Container.Content(addons) + String.IsEmpty(Container.PluginName)</expression>
	<!-- Sets row (2026-10-21): only while the Videos window browses films and the library has sets -->
	<expression name="Lib_ShowSets">Window.IsActive(videos) + [Container.Content(movies) | String.IsEqual(Container.FolderPath,videodb://movies/) | String.IsEqual(Container.FolderPath,library://video/movies/)] + Library.HasContent(moviesets)</expression>

	<!-- Options reach v2 (2026-10-29): an ITEM menu in Videos / Music (one of Kodi's buttons 1001-1020 reads Add to /
	     Remove from favourites, 14076 / 14077: not the resume prompt, the select-action chooser or Play using...) gets
	     one extra first row, DialogContextMenu 990, that opens this panel on View. Not over the information dialogs
	     (the panel lives in the media window). -->
	<expression name="Lib_IsItemMenu">String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14077])</expression>
	<expression name="Lib_CtxRow">[Window.IsActive(videos) | Window.IsActive(music)] + !Window.IsVisible(movieinformation) + !Window.IsVisible(musicinformation) + !Window.IsVisible(songinformation) + $EXP[Lib_IsItemMenu]</expression>

	<variable name="Lib_SortOrder">
		<value condition="Container.SortDirection(descending)">$LOCALIZE[585]</value>
		<value>$LOCALIZE[584]</value>
	</variable>
	<variable name="Lib_UpdateVideo">
		<value condition="Library.IsScanningVideo">$LOCALIZE[13353]</value>
		<value>Movies and TV</value>
	</variable>
	<variable name="Lib_UpdateMusic">
		<value condition="Library.IsScanningMusic">$LOCALIZE[13353]</value>
		<value>$LOCALIZE[2]</value>
	</variable>
	<variable name="Lib_Unwatched">
		<value condition="System.Setting(hidewatched)">On</value>
		<value>Off</value>
	</variable>
	<variable name="Lib_MapSection">
		<value condition="String.IsEqual(Window(Home).Property(sixdegrees.kind),tvshows)">TV shows</value>
		<value condition="String.IsEqual(Window(Home).Property(sixdegrees.kind),albums)">Albums</value>
		<value>Movies</value>
	</variable>

	<!-- Open the panel from a view's outer edge (builtins only: they run in order). -->
	<include name="Lib_OpenLeft">
		<onleft>SetProperty(sixdegrees.lib.from,view,home)</onleft>
		<onleft>SetFocus(9801,0,absolute)</onleft>
	</include>
	<!-- the TV root's Next up strip: Back returns to the strip, not the wall -->
	<include name="Lib_OpenNextUp">
		<onleft>SetProperty(sixdegrees.lib.from,nextup,home)</onleft>
		<onleft>SetFocus(9801,0,absolute)</onleft>
		<onright>SetProperty(sixdegrees.lib.from,nextup,home)</onright>
		<onright>SetFocus(9801,0,absolute)</onright>
	</include>
	<include name="Lib_OpenRight">
		<onright>SetProperty(sixdegrees.lib.from,view,home)</onright>
		<onright>SetFocus(9801,0,absolute)</onright>
	</include>

	<!-- Show only while a card has focus: a Conditional fade (normal / reduced twins, fades only). -->
	<include name="Lib_FadeGate">
		<animation effect="fade" start="100" end="0" time="140" tween="cubic" easing="out" condition="![$PARAM[show]] + !Skin.HasSetting(sixdegrees.reducemotion)">Conditional</animation>
		<animation effect="fade" start="100" end="0" time="60" condition="![$PARAM[show]] + Skin.HasSetting(sixdegrees.reducemotion)">Conditional</animation>
	</include>
	<include name="Lib_Dim">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="veil">common/white.png</texture>
		</control>
	</include>
	<!-- A white card with the dialogs' soft shadow. params: left, top, width, height -->
	<include name="Lib_Card">
		<control type="image">
			<left>$PARAM[sl]</left>
			<top>$PARAM[st]</top>
			<width>$PARAM[sw]</width>
			<height>$PARAM[sh]</height>
			<texture border="90" colordiffuse="shadow">sd/shadow_card.png</texture>
			<visible>$PARAM[visible]</visible>
		</control>
		<control type="image">
			<left>$PARAM[left]</left>
			<top>$PARAM[top]</top>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<texture border="20" colordiffuse="card">sd/rr20.png</texture>
			<visible>$PARAM[visible]</visible>
		</control>
	</include>

	<!-- ============================================================ header pills -->
	<!-- The station-style "Options" pill: a roundel at the left of the pill (ink fill + white ring on focus).
	     Lives at the end of the header grouplist 9000. params: height (46 | 36), font -->
	<include name="Lib_OptionsPill">
		<param name="height">46</param>
		<param name="width">156</param>
		<param name="offset">22</param>
		<param name="font">semi_22</param>
		<definition>
			<control type="button" id="9832">
				<include content="Lib_OptionsPillLook">
					<param name="height" value="$PARAM[height]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="offset" value="$PARAM[offset]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
			</control>
		</definition>
	</include>
	<!-- the same pill outside a grouplist (music header: beside the clock), with its own navigation -->
	<include name="Lib_OptionsPillAt">
		<param name="height">36</param>
		<param name="width">162</param>
		<param name="offset">18</param>
		<param name="font">caps_20</param>
		<definition>
			<control type="button" id="9832">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<include content="Lib_OptionsPillLook">
					<param name="height" value="$PARAM[height]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="offset" value="$PARAM[offset]"/>
					<param name="font" value="$PARAM[font]"/>
				</include>
				<onleft>$PARAM[onleft]</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>$PARAM[ondown]</ondown>
				<onback>$PARAM[ondown]</onback>
			</control>
		</definition>
	</include>
	<!-- label right-aligned after the roundel: a button clips its label to width - 2 x textoffsetx, so the width is
	     roundel (= height) + text + Kodi's per-glyph slack + the right pad (offset) -->
	<include name="Lib_OptionsPillLook">
		<width>$PARAM[width]</width>
		<height>$PARAM[height]</height>
		<font>$PARAM[font]</font>
		<textcolor>ink</textcolor>
		<focusedcolor>on_ink</focusedcolor>
		<align>right</align>
		<aligny>center</aligny>
		<textoffsetx>$PARAM[offset]</textoffsetx>
		<texturefocus border="$PARAM[height],0,23,0" colordiffuse="ink">sd/pill_station_$PARAM[height].png</texturefocus>
		<texturenofocus border="$PARAM[height],0,23,0" colordiffuse="ink">sd/pill_station_$PARAM[height]_off.png</texturenofocus>
		<label>$LOCALIZE[31240]</label>
		<onclick>SetProperty(sixdegrees.lib.from,rail,home)</onclick>
		<onclick>SetFocus(9801,0,absolute)</onclick>
	</include>

