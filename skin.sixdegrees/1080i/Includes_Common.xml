<?xml version="1.0" encoding="UTF-8"?>
<!--
	Common building blocks: page background, top-bar furniture, focus frames, posters,
	watched markers, buttons. Prefix: SD_. Parameterised includes document their params.
-->
<includes>
	<!-- ============================================================ page -->

	<!-- Flat page background (bg). Use as the first control of every full-screen window. -->
	<include name="SD_Background">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<texture colordiffuse="ground">common/white.png</texture>
		</control>
	</include>

	<!-- 1px horizontal rule. params: top, left (default page margin), width (default page width), color -->
	<include name="SD_Rule">
		<param name="top">0</param>
		<param name="left">page_margin</param>
		<param name="width">page_width</param>
		<param name="color">hair</param>
		<definition>
			<control type="image">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="$PARAM[color]">common/hairline.png</texture>
			</control>
		</definition>
	</include>

	<!-- Header rule at the bottom of the 120px top bar -->
	<include name="SD_TopRule">
		<description>No rule under the top bar in Six Degrees (boards); kept as an empty hook.</description>
	</include>

	<!-- Date + clock, right side of the top bar (DESIGN 7.4) -->
	<include name="SD_Clock">
		<control type="label">
			<left>1500</left>
			<top>62</top>
			<width>356</width>
			<height>48</height>
			<align>right</align>
			<font>xb_30</font>
			<textcolor>ink</textcolor>
			<label>$INFO[System.Time]</label>
		</control>
	</include>

	<!-- Page header for library / settings windows: mono index (accent) + page name.
	     params: index ("02"), title (label), sub (optional mono caption after the title) -->
	<include name="SD_PageHeader">
		<param name="index"></param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<!-- wordmark + a one-stop route: (o) Home, grey line, (O) Page title, sub -->
			<control type="image">
				<left>64</left>
				<top>66</top>
				<width>44</width>
				<height>44</height>
				<texture>sd/wordmark.png</texture>
			</control>
			<control type="label">
				<left>122</left>
				<top>64</top>
				<width>290</width>
				<height>48</height>
				<font>xb_28</font>
				<textcolor>ink</textcolor>
				<label>$LOCALIZE[31024]</label>
			</control>
			<control type="grouplist">
				<left>420</left>
				<top>70</top>
				<width>1060</width>
				<height>36</height>
				<orientation>horizontal</orientation>
				<itemgap>0</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="group">
					<width>30</width>
					<height>36</height>
					<control type="image"><left>2</left><top>6</top><width>24</width><height>24</height><texture colordiffuse="white">sd/disc_18.png</texture></control>
					<control type="image"><left>2</left><top>6</top><width>24</width><height>24</height><texture colordiffuse="l_route">sd/ring_18_5.png</texture></control>
				</control>
				<control type="label">
					<width>auto</width>
					<height>36</height>
					<font>semi_24</font>
					<textcolor>ink2</textcolor>
					<label>$LOCALIZE[31019]</label>
				</control>
				<control type="label"><width>16</width><height>36</height><label></label></control>
				<control type="image">
					<top>15</top>
					<width>72</width>
					<height>6</height>
					<texture border="3,0,3,0" colordiffuse="l_route">sd/line_h6.png</texture>
				</control>
				<control type="group">
					<width>44</width>
					<height>36</height>
					<control type="image"><left>-1</left><top>-1</top><width>38</width><height>38</height><texture colordiffuse="white">sd/disc_32.png</texture></control>
					<control type="image"><left>-1</left><top>-1</top><width>38</width><height>38</height><texture colordiffuse="ink">sd/ring_32_8.png</texture></control>
				</control>
				<control type="label">
					<width max="640">auto</width>
					<height>36</height>
					<font>xb_24</font>
					<textcolor>ink</textcolor>
					<label>$PARAM[title]</label>
				</control>
				<control type="label">
					<left>16</left>
					<width max="360">auto</width>
					<height>36</height>
					<font>semi_24</font>
					<textcolor>ink2</textcolor>
					<label>$PARAM[sub]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- Full top bar for non-Home windows: header + clock + rule -->
	<include name="SD_TopBar">
		<param name="index">01</param>
		<param name="title"></param>
		<param name="sub"></param>
		<definition>
			<include content="SD_PageHeader">
				<param name="index" value="$PARAM[index]"/>
				<param name="title" value="$PARAM[title]"/>
				<param name="sub" value="$PARAM[sub]"/>
			</include>
			<include>SD_Clock</include>
			<include>SD_TopRule</include>
		</definition>
	</include>

	<!-- ===================================================== focus frames -->
	<!-- Put inside a group sized to the item; the frame grows 7px on each side (DESIGN 7.2).
	     param visible: condition (e.g. Control.HasFocus(9110)); omit inside focusedlayouts. -->
	<include name="SD_FocusFrame">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="20" colordiffuse="ink">sd/ringf_6.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- Same, but never hidden by the "Off" setting (buttons, menus, dialogs) -->
	<include name="SD_FocusFrameAlways">
		<param name="visible">true</param>
		<definition>
			<control type="image">
				<left>focus_out</left>
				<top>focus_out</top>
				<right>focus_out</right>
				<bottom>focus_out</bottom>
				<texture border="20" colordiffuse="ink">sd/ringf_6.png</texture>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ========================================================== posters -->

	<!-- Watched markers for a movie/episode poster (DESIGN 7.3 / SPEC 6). Inside the poster group. -->
	<include name="SD_WatchedMarkers">
		<!-- unwatched: accent square -->
		<control type="image">
			<right>0</right>
			<top>0</top>
			<width>marker_s</width>
			<height>marker_s</height>
			<texture colordiffuse="ink">markers/unwatched.png</texture>
			<visible>$EXP[ShowUnwatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemUnwatched] + false</visible>
		</control>
		<control type="image">
			<right>8</right>
			<top>8</top>
			<width>marker_s</width>
			<height>marker_s</height>
			<texture colordiffuse="ink">markers/unwatched_round.png</texture>
			<visible>$EXP[ShowUnwatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemUnwatched] + true</visible>
		</control>
		<!-- watched: baked tab -->
		<control type="image">
			<right>0</right>
			<top>0</top>
			<width>marker_tab</width>
			<height>marker_tab</height>
			<texture>markers/watched.png</texture>
			<visible>$EXP[ShowWatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemWatched] + false</visible>
		</control>
		<control type="image">
			<right>6</right>
			<top>6</top>
			<width>marker_tab</width>
			<height>marker_tab</height>
			<texture>markers/watched_round.png</texture>
			<visible>$EXP[ShowWatchedMarkers] + $EXP[ListItemIsVideoFile] + $EXP[ListItemWatched] + true</visible>
		</control>
		<!-- in progress: accent bar on the bottom edge -->
		<control type="progress">
			<left>0</left>
			<right>0</right>
			<bottom>0</bottom>
			<height>progress_h</height>
			<texturebg colordiffuse="track_on_art">common/white.png</texturebg>
			<midtexture colordiffuse="ink">common/white.png</midtexture>
			<info>ListItem.PercentPlayed</info>
			<visible>$EXP[ShowUnwatchedMarkers] + ListItem.IsResumable</visible>
		</control>
	</include>

	<!-- ========================================================== buttons -->
	<!-- Button textures (static texture names so rounded/square is picked at window load) -->
	<include name="SD_Tex_ButtonPrimary">
		<texturefocus border="28" colordiffuse="ink">sd/pill_56.png</texturefocus>
		<texturenofocus border="28" colordiffuse="ink">sd/pill_56.png</texturenofocus>
	</include>
	<include name="SD_Tex_ButtonPrimary_Round">
		<texturefocus border="28" colordiffuse="ink">sd/pill_56.png</texturefocus>
		<texturenofocus border="28" colordiffuse="ink">sd/pill_56.png</texturenofocus>
	</include>
	<include name="SD_Tex_ButtonSecondary">
		<texturefocus border="28" colordiffuse="ink">sd/pill_56.png</texturefocus>
		<texturenofocus border="28" colordiffuse="hair">sd/pill_56_o3.png</texturenofocus>
	</include>
	<include name="SD_Tex_ButtonSecondary_Round">
		<texturefocus border="28" colordiffuse="ink">sd/pill_56.png</texturefocus>
		<texturenofocus border="28" colordiffuse="hair">sd/pill_56_o3.png</texturenofocus>
	</include>

	<!-- Primary (accent fill, ink text) / secondary (1px outline) action buttons, 58px.
	     Each lives in its own group so the focus frame can grow around it.
	     params: id, left, top, width, label, onclick, visible, onleft, onright, onup, ondown, icon;
	     onleft_if/onleft_then, onright_if/onright_then = an extra conditional action run before onleft/onright -->
	<include name="SD_ButtonPrimary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="icon">icons/play.png</param>
		<param name="onup">noop</param>
		<param name="ondown">noop</param>
		<param name="onleft">noop</param>
		<param name="onleft_if">false</param>
		<param name="onleft_then">noop</param>
		<param name="onright">noop</param>
		<param name="onright_if">false</param>
		<param name="onright_then">noop</param>
		<param name="onback">noop</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>xb_24</font>
					<textcolor>white</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>right</align>
					<textoffsetx>32</textoffsetx>
					<include condition="true">SD_Tex_ButtonPrimary_Round</include>
					<include condition="false">SD_Tex_ButtonPrimary</include>
					<onclick>$PARAM[onclick]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft_then]</onleft>
					<onleft>$PARAM[onleft]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright_then]</onright>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
				<control type="image">
					<left>32</left>
					<top>20</top>
					<width>18</width>
					<height>18</height>
					<texture colordiffuse="white">$PARAM[icon]</texture>
				</control>
				<control type="image">
					<left>-9</left>
					<top>-9</top>
					<right>-9</right>
					<bottom>-9</bottom>
					<texture border="38" colordiffuse="ink">sd/pill_76_ring.png</texture>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>
	<include name="SD_ButtonSecondary">
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="focus_also">false</param>
		<param name="onclick2">noop</param>
		<param name="onup">noop</param>
		<param name="ondown">noop</param>
		<param name="onleft">noop</param>
		<param name="onleft_if">false</param>
		<param name="onleft_then">noop</param>
		<param name="onright">noop</param>
		<param name="onright_if">false</param>
		<param name="onright_then">noop</param>
		<param name="onback">noop</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>button_h</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<label>$PARAM[label]</label>
					<font>semi_24</font>
					<textcolor>ink</textcolor>
					<focusedcolor>white</focusedcolor>
					<align>center</align>
					<textoffsetx>0</textoffsetx>
					<include condition="true">SD_Tex_ButtonSecondary_Round</include>
					<include condition="false">SD_Tex_ButtonSecondary</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onup>$PARAM[onup]</onup>
					<ondown>$PARAM[ondown]</ondown>
					<onleft condition="$PARAM[onleft_if]">$PARAM[onleft_then]</onleft>
					<onleft>$PARAM[onleft]</onleft>
					<onright condition="$PARAM[onright_if]">$PARAM[onright_then]</onright>
					<onright>$PARAM[onright]</onright>
					<onback>$PARAM[onback]</onback>
				</control>
				<control type="image">
					<left>-9</left>
					<top>-9</top>
					<right>-9</right>
					<bottom>-9</bottom>
					<texture border="38" colordiffuse="ink">sd/pill_76_ring.png</texture>
					<visible>Control.HasFocus($PARAM[id]) | $PARAM[focus_also]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- Mono sub-nav button (library header bar, OSD text buttons): accent fill + ink on focus.
	     params: id, label, onclick, visible -->
	<include name="SD_SubNavButton">
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>subnav_h</height>
				<font>semi_22</font>
				<textcolor>ink2</textcolor>
				<focusedcolor>white</focusedcolor>
				<textoffsetx>16</textoffsetx>
				<texturefocus border="20" colordiffuse="ink">sd/pill_40.png</texturefocus>
				<texturenofocus />
				<label>$PARAM[label]</label>
				<onclick>$PARAM[onclick]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Off-screen object (template/hidden controls Kodi needs but the user never sees) -->
	<include name="SD_Hidden">
		<left>offscreen</left>
		<top>offscreen</top>
		<width>1</width>
		<height>1</height>
		<texturefocus />
		<texturenofocus />
	</include>
</includes>
