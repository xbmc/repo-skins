<?xml version="1.0" encoding="UTF-8"?>
<!--
	File manager (SPEC 5: Minimal, two lists). Builder F, M4. Copy / move / delete come from the
	context menu (Kodi's own items); marked items show the accent check (ListItem.IsSelected).
	Kodi id contract (Estuary Omega FileManager.xml): left list 20 + scrollbar 60, right list 21 +
	scrollbar 61, current-path labels 101 (left) / 102 (right).
-->
<window>
	<defaultcontrol always="true">20</defaultcontrol>
	<backgroundcolor>ground</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>SD_Background</include>
		<include content="SD_TopBar">
			<param name="index" value="12"/>
			<param name="title" value="$LOCALIZE[7]"/>
		</include>
		<!-- ====== left -->
		<control type="label" id="101">
			<description>left path</description>
			<left>page_margin</left>
			<top>below_bar_top</top>
			<width>700</width>
			<height>subnav_h</height>
			<haspath>true</haspath>
			<font>semi_20</font>
			<textcolor>ink2</textcolor>
		</control>
		<control type="label">
			<left>page_margin</left>
			<top>below_bar_top</top>
			<width>840</width>
			<height>subnav_h</height>
			<align>right</align>
			<font>semi_20</font>
			<textcolor>ink2</textcolor>
			<label>$INFO[Container(20).CurrentItem]$INFO[Container(20).NumItems, / ,]</label>
		</control>
		<control type="list" id="20">
			<left>page_margin</left>
			<top>list_top</top>
			<width>840</width>
			<height>858</height>
			<onup>20</onup>
			<ondown>20</ondown>
			<onleft>noop</onleft>
			<onright>21</onright>
			<pagecontrol>60</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="SD_ListLayout">
				<param name="width" value="840"/>
				<param name="height" value="list_row_h"/>
				<param name="list_id" value="20"/>
			</include>
		</control>
		<include content="SD_Scrollbar">
			<param name="id" value="60"/>
			<param name="left" value="944"/>
			<param name="top" value="list_top"/>
			<param name="height" value="858"/>
			<param name="onleft" value="20"/>
			<param name="onright" value="21"/>
		</include>
		<!-- divider -->
		<control type="image">
			<left>959</left>
			<top>list_top</top>
			<width>rule_h</width>
			<height>858</height>
			<texture colordiffuse="hair">common/hairline_v.png</texture>
		</control>
		<!-- ====== right -->
		<control type="label" id="102">
			<description>right path</description>
			<left>984</left>
			<top>below_bar_top</top>
			<width>700</width>
			<height>subnav_h</height>
			<haspath>true</haspath>
			<font>semi_20</font>
			<textcolor>ink2</textcolor>
		</control>
		<control type="label">
			<left>984</left>
			<top>below_bar_top</top>
			<width>840</width>
			<height>subnav_h</height>
			<align>right</align>
			<font>semi_20</font>
			<textcolor>ink2</textcolor>
			<label>$INFO[Container(21).CurrentItem]$INFO[Container(21).NumItems, / ,]</label>
		</control>
		<control type="list" id="21">
			<left>984</left>
			<top>list_top</top>
			<width>840</width>
			<height>858</height>
			<onup>21</onup>
			<ondown>21</ondown>
			<onleft>20</onleft>
			<onright>noop</onright>
			<pagecontrol>61</pagecontrol>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="SD_ListLayout">
				<param name="width" value="840"/>
				<param name="height" value="list_row_h"/>
				<param name="list_id" value="21"/>
			</include>
		</control>
		<include content="SD_Scrollbar">
			<param name="id" value="61"/>
			<param name="left" value="1832"/>
			<param name="top" value="list_top"/>
			<param name="height" value="858"/>
			<param name="onleft" value="21"/>
			<param name="onright" value="21"/>
		</include>
	</controls>
</window>
