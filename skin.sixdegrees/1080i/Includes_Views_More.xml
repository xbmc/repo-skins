<?xml version="1.0" encoding="UTF-8"?>
<!--
	More views (docs/VIEWS_BRIEF_2026-10-27.md), drawn on the transit map.

	Video (MyVideoNav):
	  506 Network      4 x 3 wide stations: 16:9 pictures (episode stills, landscape, fanart) hung on grey lines, a stop
	                   under each one, the name below; posters / icons sit whole on the wash, never cropped. Every
	                   content type (series, episodes, sets, add-ons, genres, files).
	  507 Interchange  the stops of a line run down the left (dot + name, the focused stop an ink pill); the focused
	                   one is the interchange: its picture in the ink ring, title, facts and the plot. Library video and
	                   add-on listings.
	  (502 Wall now also takes films, sets and music videos: the dense poster wall.)
	Music (MyMusicNav):
	  507 Interchange  the same for artists, albums and songs: fanart in the ring (the cover or photo whole when there is
	                   none). Video genres / years / people: the stop's films hang on a line through the ring (list 5075).
	viewtypes bigwide / bigwrap are never a node's default type (Kodi defaults: list, icon, big icon, info, big info,
	auto = info / list), so the view a node opens in by default is unchanged.
-->
<includes>
	<!-- ================================================================ art -->
	<expression name="SDV_HasLand">[String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))] | !String.IsEmpty(ListItem.Art(landscape)) | !String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(tvshow.fanart))</expression>
	<expression name="SDV_HasMat">!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | !String.IsEmpty(ListItem.Art(thumb))</expression>
	<expression name="SDV_IsNode">Container.Content(genres) | Container.Content(years) | Container.Content(actors) | Container.Content(directors) | Container.Content(studios) | Container.Content(countries) | Container.Content(tags)</expression>
	<expression name="SDV_ShowInterchange">$EXP[VidView_IsLibraryVideo] | !String.IsEmpty(Container.PluginName) | $EXP[SDV_IsNode]</expression>
	<!-- a genre / year / person is a line: its films (or series) hang in the ring; the empty playlist while ".." or scrolling -->
	<variable name="SDV_NodeLine">
		<value condition="$EXP[SDV_IsNode] + !Container(507).ListItem.IsParentFolder + !String.IsEmpty(Container(507).ListItem.FolderPath) + !Container(507).Scrolling">$INFO[Container(507).ListItem.FolderPath]</value>
		<value>special://skin/playlists/sd_none.xsp</value>
	</variable>
	<variable name="SDV_LandArt">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Art(tvshow.fanart)]</value>
	</variable>
	<variable name="SDV_MatArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="SDV_Title">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="SDV_StopName">
		<value condition="ListItem.IsParentFolder">Back</value>
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Episode)">$INFO[ListItem.Season,,x]$INFO[ListItem.Episode]  $INFO[ListItem.Title]</value>
		<value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="SDV_Facts">
		<value condition="ListItem.IsParentFolder">PARENT FOLDER · OK GOES UP ONE LEVEL</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.TVShowTitle,, · ]$INFO[ListItem.Premiered]$INFO[ListItem.Duration(mins), · , min]$INFO[ListItem.Rating, · ★ ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$INFO[ListItem.Year]$INFO[ListItem.Studio, · ,]$VAR[SDV_Seasons]$VAR[SDV_Episodes]</value>
		<value condition="String.IsEqual(ListItem.DBType,season)">$INFO[ListItem.TVShowTitle]$VAR[SDV_Episodes]$INFO[ListItem.Property(WatchedEpisodes), · , watched]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$VAR[SDV_SetFilms]$INFO[ListItem.Genre, · ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Artist]$INFO[ListItem.Year, · ,]$INFO[ListItem.Genre, · ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Genre]</value>
		<value condition="String.IsEqual(ListItem.DBType,song)">$INFO[ListItem.Artist]$INFO[ListItem.Album, · ,]$INFO[ListItem.Duration, · ,]</value>
		<value condition="$EXP[SDV_IsNode] + Integer.IsGreater(Container(5075).NumItems,0)">$INFO[Container(5075).NumItems,, on this line]$INFO[Container(5075).ListItem.Title,   ·   ,]$INFO[Container(5075).ListItem.Year, · ,]</value>
		<value condition="!String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]$INFO[ListItem.Duration(mins), · , min]$INFO[ListItem.Rating, · ★ ,]$INFO[ListItem.Genre, · ,]</value>
		<value>$INFO[ListItem.Genre]</value>
	</variable>
	<variable name="SDV_Text">
		<value condition="!String.IsEmpty(ListItem.Plot)">$INFO[ListItem.Plot]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Property(Album_Description)]</value>
		<value condition="String.IsEqual(ListItem.DBType,artist)">$INFO[ListItem.Property(Artist_Description)]</value>
	</variable>

	<!-- A picture with honest fallbacks, inside a group at the art rect: the art (scale, rounded mask) when it exists,
	     else the poster / cover / icon whole on the wash (keep), else the name. params: art, has_art, mat, has_mat, mask,
	     label, font, inset -->
	<include name="SDV_Picture">
		<param name="font">xb_20</param>
		<param name="inset">12</param>
		<definition>
			<include content="VidView_ParentTile">
				<param name="icon" value="48"/>
			</include>
			<control type="group">
				<visible>!ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture diffuse="$PARAM[mask]" colordiffuse="wash">common/white.png</texture>
				</control>
				<control type="label">
					<left>18</left>
					<right>18</right>
					<top>14</top>
					<bottom>14</bottom>
					<align>center</align>
					<aligny>center</aligny>
					<wrapmultiline>true</wrapmultiline>
					<font>$PARAM[font]</font>
					<textcolor>ink2</textcolor>
					<label>$PARAM[label]</label>
					<visible>![$PARAM[has_art]] + ![$PARAM[has_mat]]</visible>
				</control>
				<control type="image">
					<left>$PARAM[inset]</left>
					<top>$PARAM[inset]</top>
					<right>$PARAM[inset]</right>
					<bottom>$PARAM[inset]</bottom>
					<aspectratio>keep</aspectratio>
					<fadetime>120</fadetime>
					<texture background="true">$PARAM[mat]</texture>
					<visible>![$PARAM[has_art]] + [$PARAM[has_mat]]</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>120</fadetime>
					<texture background="true" diffuse="$PARAM[mask]">$PARAM[art]</texture>
					<visible>$PARAM[has_art]</visible>
				</control>
			</control>
		</definition>
	</include>

