<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Six Degrees: focus = ink rounded fill + white text, like the map's ink pills) (Kodi applies these to every control of the type unless overridden).
	Focus language everywhere: accent 2px frame (focus/outline_2.png, border 16) or accent fill.
	Colours are names from colors/defaults.xml; ink = live accent (setting 1).
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>ink3</disabledcolor>
		<selectedcolor>ink</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<disabledcolor>ink3</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="12" colordiffuse="ink">sd/rr12.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="white">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="ink">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="10" colordiffuse="white">common/rect_outline_1.png</textureradioofffocus>
		<textureradiooffnofocus border="10" colordiffuse="hair_strong">common/rect_outline_1.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="ink3">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="10" colordiffuse="ink3">common/rect_outline_1.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="ink2">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="ink2" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="white">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="white" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="ink3">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="ink3" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>ink</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="ink2">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="ink2" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="white">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="white" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="ink3">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="ink3" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="hair_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hair">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink2">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="white">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="ink3">common/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="hair_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="hair">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="ink2">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="white">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="ink3">common/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>ink2</textcolor>
		<focusedcolor>white</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="ink3">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>ink</textcolor>
		<focusedcolor>ink</focusedcolor>
		<disabledcolor>ink3</disabledcolor>
		<invalidcolor>l_dir</invalidcolor>
		<texturefocus border="12" colordiffuse="ink">sd/rr12_o3.png</texturefocus>
		<texturenofocus border="10" colordiffuse="hair_strong">common/rect_outline_1.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="hair_strong">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="ink">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="hair">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="ink2">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="ink">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
