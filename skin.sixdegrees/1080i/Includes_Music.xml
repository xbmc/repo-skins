	<!-- Library / info: blur source for the TMDb Helper image monitor. Saves the previous value
	     (Home or video windows may use another source) and puts it back on unload.
	     param slot: Home property that holds the saved value; must differ per window because the
	     info dialog opens on top of the library (default sixdegrees.blursrc.prev.music). -->
	<include name="Music_BlurSourceOnload">
		<param name="slot">sixdegrees.blursrc.prev.music</param>
