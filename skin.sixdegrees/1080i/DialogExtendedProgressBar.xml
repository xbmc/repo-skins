<?xml version="1.0" encoding="UTF-8"?>
<!--
	Background progress (library scans, add-on updates) - M4, Builder E. Same toast as the
	notification; drops below it while a notification is showing.
	Id contract (Estuary Omega): 30 heading, 31 line, 32 progress.
-->
<window>
	<zorder>3</zorder>
	<include content="Anim_SidePanel"><param name="offset" value="40"/></include>
	<controls>
		<control type="group">
			<right>page_margin</right>
			<top>below_bar_top</top>
			<width>toast_w</width>
			<height>104</height>
			<animation effect="slide" start="0,0" end="0,120" time="160" tween="cubic" easing="out" condition="[Window.IsVisible(notification)] + !Skin.HasSetting(sixdegrees.reducemotion)">Conditional</animation>
			<animation effect="slide" start="0,0" end="0,120" time="0" tween="cubic" easing="out" condition="[Window.IsVisible(notification)] + Skin.HasSetting(sixdegrees.reducemotion)">Conditional</animation>
			<include content="SD_ToastFrame">
				<param name="height" value="104"/>
			</include>
			<control type="label" id="30">
				<description>heading</description>
				<left>24</left>
				<top>18</top>
				<width>420</width>
				<height>22</height>
				<font>caps_20</font>
			</control>
			<control type="label">
				<right>24</right>
				<top>18</top>
				<width>80</width>
				<height>22</height>
				<align>right</align>
				<font>semi_20</font>
				<textcolor>ink2</textcolor>
				<label>$INFO[Control.GetLabel(32),,%]</label>
			</control>
			<control type="label" id="31">
				<description>line</description>
				<left>24</left>
				<top>44</top>
				<width>512</width>
				<height>32</height>
				<font>reg_22</font>
			</control>
			<control type="progress" id="32">
				<left>24</left>
				<top>84</top>
				<width>512</width>
				<height>2</height>
			</control>
		</control>
	</controls>
</window>
