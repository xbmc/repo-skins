<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library (SPEC 5 Bespoke, M2 T14; Builder C). Mockups: Music.dc.html (504 grid +
	now-playing bar), MusicStage.dc.html (505 Big album + artist fanart stage).

	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp):
	  views in <views> (50 list, 504 grid, 505 big album; all from Includes_Views_Music.xml),
	  menucontrol 9000, 3 sort by, 4 sort order (hidden, clicked by the header tabs).
	  Reserved by Kodi in this window and not reused: 2, 5, 8, 12, 15, 16, 17, 19, 20.
	Six Degrees ids: 9320-9326 header tabs (inside grouplist 9000), 60 list scrollbar.

	Focus map: view <-> Up/Down <-> header tabs (Left/Right inside). Back on a view is Kodi's:
	up a folder, back through the tab history, out of the window at the start node.
	Back on the tabs returns to the view. Empty folder: caption + hint, Up still reaches the tabs.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<!-- an empty folder has nothing focusable in the view: put focus on the header tabs -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>ground</backgroundcolor>
	<views>50,504,505,507</views>
	<include>Music_BlurSourceOnload</include>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>SD_Background</include>
		<!-- Big album stage: artist fanart -> TMDb Helper blurred cover -> nothing -->
		<include content="Music_StageBackground">
			<param name="art" value="$VAR[Music_StageArt]"/>
			<param name="visible" value="Control.IsVisible(505)"/>
		</include>

		<include content="SD_TopBar">
			<param name="index" value="04"/>
			<param name="title" value="Music"/>
			<param name="sub" value="$VAR[Music_HeaderSub]"/>
		</include>
		<include>Music_HeaderBar</include>

		<!-- views -->
		<include>Music_View_504</include>
		<include>Music_View_505</include>
		<include>Music_View_50</include>
		<include>Music_View_507</include>

		<!-- empty folder (the empty view keeps focus; Up reaches the tabs) -->
		<control type="group">
			<!-- with a ".." item only the Interchange (507) leaves room for this text -->
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating + [!Container.HasParent | Control.IsVisible(507)]</visible>
			<animation effect="slide" start="0,0" end="688,0" time="0" condition="Control.IsVisible(507)">Conditional</animation>
			<control type="label">
				<left>page_margin</left>
				<top>200</top>
				<width>page_width</width>
				<height>30</height>
				<font>caps_20</font>
				<label>$LOCALIZE[31012]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>240</top>
				<width>page_width</width>
				<height>36</height>
				<font>reg_24</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[31294]</label>
			</control>
		</control>

		<include>Music_NowPlayingBar</include>
		<include content="Lib_Panel">
			<param name="is_video" value="false"/>
			<param name="video_cond" value="false"/>
			<param name="music_cond" value="true"/>
			<param name="section" value="Music"/>
			<param name="view_name" value="$INFO[Container.Viewmode]"/>
			<param name="order_click" value="Container.SetSortDirection"/>
			<param name="pick_focus" value="Lib_PickFocusMusic"/>
		</include>
		<include content="Lib_Picker">
			<param name="items" value="Lib_PickerMusic"/>
			<param name="section" value="Music"/>
		</include>
	</controls>
</window>
