<?xml version="1.0" encoding="UTF-8"?>
<!--
	Library views and the generic list window (SPEC 6).
	View ids: 50 List (M1, generic fallback) | 500 Poster Showcase | 501 Big Poster | 502 Wall |
	503 Episodes | 504 Albums | 505 Big Album (M2). Every view gates itself with Container.Content.
	Header bar (grouplist 9000) replaces Estuary's side blade; uses Kodi's media-window ids
	(3 = sort by, 4 = sort order, 10 = watched filter in video windows).
-->
<includes>
	<!-- ============================================================ View 50 -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<!-- the line runs the full height behind the list -->
			<control type="image">
				<left>140</left>
				<top>168</top>
				<width>8</width>
				<height>870</height>
				<texture colordiffuse="hair_strong">common/white.png</texture>
			</control>
			<control type="list" id="50">
				<left>40</left>
				<top>170</top>
				<width>1144</width>
				<height>858</height>
				<onup>9000</onup>
				<ondown>50</ondown>
				<onleft>9000</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="31200">list</viewtype>
				<itemlayout width="1144" height="66">
					<control type="image"><left>100</left><top>0</top><width>8</width><height>66</height><texture colordiffuse="hair_strong">common/white.png</texture></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="white">sd/disc_24.png</texture><visible>!ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/ring_24_6.png</texture><visible>!ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/disc_24.png</texture><visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/ring_24_6.png</texture><visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="white">sd/disc_24.png</texture><visible>ListItem.IsResumable</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="ink">sd/ring_24_6.png</texture><visible>ListItem.IsResumable</visible></control>
					<control type="label"><left>140</left><top>0</top><width>820</width><height>66</height><font>semi_26</font><textcolor>ink</textcolor><selectedcolor>ink</selectedcolor><label>$INFO[ListItem.Label]</label><visible>true</visible></control>
					<control type="label"><left>860</left><top>0</top><width>250</width><height>66</height><align>right</align><font>semi_22</font><textcolor>ink2</textcolor><selectedcolor>ink2</selectedcolor><label>$INFO[ListItem.Label2]</label><visible>true</visible></control>
				</itemlayout>
				<focusedlayout width="1144" height="66">
					<control type="image"><left>100</left><top>0</top><width>8</width><height>66</height><texture colordiffuse="hair_strong">common/white.png</texture></control>
					<control type="image"><left>24</left><top>5</top><width>1120</width><height>56</height><texture border="28" colordiffuse="ink">sd/pill_56.png</texture><visible>Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="white">sd/disc_24.png</texture><visible>!ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0) + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/ring_24_6.png</texture><visible>!ListItem.IsResumable + !Integer.IsGreater(ListItem.PlayCount,0) + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/disc_24.png</texture><visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="l_route">sd/ring_24_6.png</texture><visible>Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="white">sd/disc_24.png</texture><visible>ListItem.IsResumable + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>89</left><top>18</top><width>30</width><height>30</height><texture colordiffuse="ink">sd/ring_24_6.png</texture><visible>ListItem.IsResumable + !Control.HasFocus(50)</visible></control>
					<control type="image"><left>85</left><top>14</top><width>38</width><height>38</height><texture colordiffuse="ink">sd/disc_32.png</texture><visible>Control.HasFocus(50)</visible></control>
					<control type="image"><left>85</left><top>14</top><width>38</width><height>38</height><texture colordiffuse="white">sd/ring_32_8.png</texture><visible>Control.HasFocus(50)</visible></control>
					<control type="label"><left>140</left><top>0</top><width>820</width><height>66</height><font>semi_26</font><textcolor>ink</textcolor><selectedcolor>ink</selectedcolor><label>$INFO[ListItem.Label]</label><visible>!Control.HasFocus(50)</visible></control>
					<control type="label"><left>860</left><top>0</top><width>250</width><height>66</height><align>right</align><font>semi_22</font><textcolor>ink2</textcolor><selectedcolor>ink2</selectedcolor><label>$INFO[ListItem.Label2]</label><visible>!Control.HasFocus(50)</visible></control>
					<control type="label"><left>140</left><top>0</top><width>820</width><height>66</height><font>xb_26</font><textcolor>white</textcolor><selectedcolor>white</selectedcolor><label>$INFO[ListItem.Label]</label><visible>Control.HasFocus(50)</visible></control>
					<control type="label"><left>860</left><top>0</top><width>250</width><height>66</height><align>right</align><font>semi_22</font><textcolor>white</textcolor><selectedcolor>white</selectedcolor><label>$INFO[ListItem.Label2]</label><visible>Control.HasFocus(50)</visible></control>
				</focusedlayout>
			</control>
			<include content="SD_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1204"/>
				<param name="top" value="170"/>
				<param name="height" value="858"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="SetProperty(sixdegrees.lib.from,view,home)"/>
				<param name="onright2" value="SetFocus(9801,0,absolute)"/>
			</include>
			<!-- focused item: interchange ring (posters) or the plain artwork (covers, thumbs) -->
			<control type="group">
				<left>1264</left>
				<top>170</top>
				<control type="group">
					<visible>!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster))</visible>
					<control type="image"><left>-86</left><top>-64</top><width>472</width><height>622</height><texture border="100" colordiffuse="shadow">sd/shadow_big.png</texture></control>
					<control type="image"><left>-14</left><top>-14</top><width>328</width><height>478</height><texture border="24" colordiffuse="ground">sd/ring_centre_fill.png</texture></control>
					<control type="image"><left>-14</left><top>-14</top><width>328</width><height>478</height><texture border="24" colordiffuse="ink">sd/ring_centre.png</texture></control>
					<control type="image"><left>0</left><top>0</top><width>300</width><height>450</height><texture colordiffuse="wash">common/white.png</texture></control>
					<control type="image">
						<left>0</left><top>0</top><width>300</width><height>450</height>
						<aspectratio>scale</aspectratio><fadetime>120</fadetime>
						<texture background="true" diffuse="sd/mask_300x450.png">$VAR[ListItemArt]</texture>
					</control>
				</control>
				<control type="image">
					<left>0</left><top>0</top><width>592</width><height>450</height>
					<aspectratio align="left" aligny="top">keep</aspectratio><fadetime>120</fadetime>
					<texture background="true">$VAR[ListItemArt]</texture>
					<visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster))</visible>
				</control>
				<control type="label">
					<left>0</left><top>486</top><width>592</width><height>44</height>
					<font>xb_30</font><textcolor>ink</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>0</left><top>532</top><width>592</width><height>32</height>
					<font>semi_22</font><textcolor>ink2</textcolor>
					<label>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins), · , min]$INFO[ListItem.Rating, · ★ ,]$INFO[ListItem.Genre, · ,]</label>
				</control>
				<control type="textbox">
					<left>0</left><top>578</top><width>592</width><height>136</height>
					<font>reg_24</font><textcolor>body</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>
				</control>
			</control>
		</control>
	</include>

	<!-- ===================================================== library header bar -->

	<!-- ========================================== generic list window (Minimal treatment) -->
</includes>
