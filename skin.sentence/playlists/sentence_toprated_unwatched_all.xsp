<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Sentence / unlimited copy of the spotlight pool. Feed it to a hidden list (or the "See all"
     target) only when you need Container(id).NumItems for a "PICK FROM 177" caption. -->
<smartplaylist type="movies">
    <name>Top rated, unwatched (all)</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="rating" operator="greaterthan">
        <value>7.449</value>
    </rule>
    <rule field="votes" operator="greaterthan">
        <value>50</value>
    </rule>
    <order direction="descending">rating</order>
</smartplaylist>
