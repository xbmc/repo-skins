<?xml version="1.0" encoding="UTF-8"?>
<!--
	skin.sentence palette (docs/skin.sentence/DESIGN.md section 2). Values from the approved mockups
	(docs/concepts/mockups/Sentence*.dc.html). AARRGGBB. Refer to colours by NAME in XML.
	One interactive colour: lilac. Lilac text + 3px underline = a phrase you can change;
	a lilac block with ink text = the phrase that has focus.
-->
<colors>
	<!-- Ground -->
	<color name="ground">ff0f1412</color>       <!-- ink green-black page -->
	<color name="raised">ff161d1a</color>       <!-- focused row / card fill -->
	<color name="surface">ff1c2521</color>      <!-- dialog panels -->
	<color name="on_lilac">ff0f1412</color>     <!-- ink text on the lilac block -->

	<!-- Text -->
	<color name="text">ffedeae0</color>         <!-- sentences, titles, values -->
	<color name="body">ffc4c3ba</color>         <!-- plot paragraphs -->
	<color name="muted">ff8c918b</color>        <!-- captions, connective text, inactive -->
	<color name="faint">ff5d645f</color>        <!-- decorative only (separators), never text you must read -->

	<!-- The one highlighter -->
	<color name="lilac">ffb9a6ff</color>
	<color name="lilac_half">80b9a6ff</color>   <!-- spinner neighbours (opacity .5) -->
	<color name="lilac_halo">24b9a6ff</color>   <!-- 6px ring round the focused block (.14) -->

	<!-- Lines -->
	<color name="rule">1fedeae0</color>         <!-- 12% text -->
	<color name="rule_strong">2eedeae0</color>  <!-- 18%: progress tracks, control frames -->

	<!-- Scrims / dims (tint the white alpha ramps in media/ with these) -->
	<color name="scrim">ff0f1412</color>
	<color name="scrim_80">cc0f1412</color>
	<color name="dim_dialog">e00f1412</color>   <!-- behind modal dialogs -->
	<color name="dim_video">990f1412</color>    <!-- video behind OSD panels -->
	<color name="dim_art">ff999999</color>      <!-- unfocused posters: brightness .6 -->
	<color name="dim_art_soft">ffcccccc</color>
	<color name="art_bg">80ffffff</color>       <!-- backdrop art at 50% over ground -->
	<color name="shadow">73000000</color>

	<!-- Utility -->
	<color name="white">ffffffff</color>
	<color name="black">ff000000</color>
	<color name="clear">00ffffff</color>
	<color name="disabled">ff4f5651</color>
	<color name="warn">ffffb59e</color>
</colors>
