	<!-- Track + buffer + played + chapter ticks + playhead. Display only (no id); seeking is
	     done by the hidden stepper 87 in the OSD.
	     params: top (track top), track_h (2-4), track_color, cache_color, playhead_h (16-20) -->
	<include name="OSD_Track">
		<param name="top">0</param>
		<param name="track_h">4</param>
		<param name="track_color">rule_strong</param>
		<param name="cache_color">rule_strong</param>
		<param name="playhead_h">20</param>
		<param name="playhead_top">-8</param>
		<definition>
			<control type="group">
				<left>page_margin</left>
				<top>$PARAM[top]</top>
				<width>page_width</width>
				<height>$PARAM[track_h]</height>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>page_width</width>
					<height>$PARAM[track_h]</height>
					<texture colordiffuse="$PARAM[track_color]">common/white.png</texture>
				</control>
				<control type="progress">
					<left>0</left>
					<top>0</top>
					<width>page_width</width>
					<height>$PARAM[track_h]</height>
					<info>Player.ProgressCache</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="$PARAM[cache_color]">common/white.png</midtexture>
					<visible>Player.SeekEnabled</visible>
				</control>
				<control type="progress">
					<left>0</left>
					<top>0</top>
					<width>page_width</width>
					<height>$PARAM[track_h]</height>
					<info>Player.SeekBar</info>
					<texturebg colordiffuse="clear">common/white.png</texturebg>
					<midtexture colordiffuse="lilac">common/white.png</midtexture>
				</control>
				<control type="ranges">
					<left>0</left>
					<top>-3</top>
					<width>page_width</width>
					<height>10</height>
					<texturebg>osd/slider_bg.png</texturebg>
					<lefttexture />
					<midtexture />
					<righttexture colordiffuse="text">osd/tick.png</righttexture>
					<info>Player.Chapters</info>
					<visible>$EXP[OSD_HasChapters]</visible>
				</control>
				<control type="slider">
					<left>0</left>
					<top>$PARAM[playhead_top]</top>
					<width>page_width</width>
					<height>$PARAM[playhead_h]</height>
					<info>Player.SeekBar</info>
					<texturesliderbar>osd/slider_bg.png</texturesliderbar>
					<textureslidernib colordiffuse="text">sentence/playhead_nib.png</textureslidernib>
					<textureslidernibfocus colordiffuse="text">sentence/playhead_nib.png</textureslidernibfocus>
					<visible>Player.SeekEnabled</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================= OSD buttons -->
	<!-- 72x72 transport box. params: id, icon, onclick, onclick2, onleft, onright, visible,
	     icon_size, icon_pos, icon_color.
	     Up goes to the seek stepper 87, Down stays (noop). -->
	<include name="OSD_BoxButton">
		<param name="visible">true</param>
		<param name="onclick2">noop</param>
		<param name="icon_size">osd_box_icon</param>
		<param name="icon_pos">osd_box_icon_pos</param>
		<param name="icon_color">text</param>
		<definition>
			<control type="group">
				<top>8</top>  <!-- room for the focus frame: the grouplist clips to its own rect -->
				<left>8</left>  <!-- + parent itemgap reduced by 8: left/right room for the frame -->
				<width>osd_box</width>
				<height>osd_box</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<left>0</left>
					<top>0</top>
					<width>osd_box</width>
					<height>osd_box</height>
					<label></label>
					<include condition="false">OSD_Tex_Box_Round</include>
					<include condition="true">OSD_Tex_Box</include>
					<onclick>$PARAM[onclick]</onclick>
					<onclick>$PARAM[onclick2]</onclick>
					<onleft>$PARAM[onleft]</onleft>
					<onright>$PARAM[onright]</onright>
					<onup>87</onup>
					<ondown>noop</ondown>
				</control>
				<control type="image">
					<left>$PARAM[icon_pos]</left>
					<top>$PARAM[icon_pos]</top>
					<width>$PARAM[icon_size]</width>
					<height>$PARAM[icon_size]</height>
					<texture colordiffuse="$PARAM[icon_color]">$PARAM[icon]</texture>
				</control>
				<include content="Sen_FocusFrameAlways">
					<param name="visible" value="Control.HasFocus($PARAM[id])"/>
				</include>
			</control>
		</definition>
	</include>

	<!-- Play / pause: accent fill, ink icon, always the focus target on open. params: onleft, onright -->
	<include name="OSD_PlayButton">
