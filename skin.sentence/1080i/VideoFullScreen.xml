<?xml version="1.0" encoding="UTF-8"?>
<!--
	Full-screen video layer (M3, Builder D). Nothing is drawn over the picture except:
	  * Kodi's debug lines 10/11/12 (only when Kodi fills them), on a small scrim, top-left;
	  * the buffering tab while Player.Caching (centre, mono % + 2px hairline progress, delayed
	    300 ms so short stalls never flash).
	Pause / seek / skip feedback lives in DialogSeekBar, info in DialogFullScreenInfo, controls in
	VideoOSD.

	Id contract (Estuary Omega VideoFullScreen.xml): group 0 holding labels 10/11/12 (Kodi's
	codec/debug info), group 1 = buffering indicator.
-->
<window>
	<defaultcontrol></defaultcontrol>
	<!-- fullscreen video has been shown: lifts the play-start curtain (Custom_1153_PlayCurtain.xml) -->
	<onload>SetProperty(sentence.fsseen,1,home)</onload>
	<controls>
		<control type="group" id="0">
			<control type="image">
				<left>72</left>
				<top>28</top>
				<width>1776</width>
				<height>124</height>
				<texture colordiffuse="scrim_80">common/white.png</texture>
				<visible>!String.IsEmpty(Control.GetLabel(10)) | !String.IsEmpty(Control.GetLabel(11)) | !String.IsEmpty(Control.GetLabel(12))</visible>
			</control>
			<control type="label" id="10">
				<left>page_margin</left>
				<top>40</top>
				<width>page_width</width>
				<height>30</height>
				<font>num_20</font>
			</control>
			<control type="label" id="11">
				<left>page_margin</left>
				<top>72</top>
				<width>page_width</width>
				<height>30</height>
				<font>num_20</font>
			</control>
			<control type="label" id="12">
				<left>page_margin</left>
				<top>104</top>
				<width>page_width</width>
				<height>30</height>
				<font>num_20</font>
			</control>
		</control>

		<control type="group" id="1">
			<!-- shown at 0% too (Estuary hides it at 0, and no other dialog covers caching here) -->
			<visible>Player.Caching</visible>
			<visible>!Window.IsVisible(videoosd) + !Window.IsVisible(fullscreeninfo)</visible>
			<animation effect="fade" delay="300" time="160">Visible</animation>
			<animation effect="fade" time="120">Hidden</animation>
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>320</width>
			<height>72</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>320</width>
				<height>72</height>
				<texture colordiffuse="scrim_80">common/white.png</texture>
			</control>
			<control type="label">
				<left>24</left>
				<top>12</top>
				<width>272</width>
				<height>30</height>
				<font>cap_20</font>
				<textcolor>muted</textcolor>
				<label>$LOCALIZE[31398]</label>
			</control>
			<control type="label">
				<left>24</left>
				<top>12</top>
				<width>272</width>
				<height>30</height>
				<align>right</align>
				<font>num_20</font>
				<textcolor>muted</textcolor>
				<label>$INFO[Player.CacheLevel,,%]</label>
			</control>
			<control type="progress">
				<left>24</left>
				<top>52</top>
				<width>272</width>
				<height>2</height>
				<info>Player.CacheLevel</info>
			</control>
		</control>
	</controls>
</window>
