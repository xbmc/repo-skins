<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info during playback, as a paragraph over the picture: what it is, where you are,
	the plot, then the thin progress line. Opened by Kodi's Info action in fullscreen video and by the
	OSD "about it" phrase; Info again or Back closes it (GUIDialogFullScreenInfo.cpp).
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button
	(default, always): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include content="OSDS_Scrims"><param name="top" value="200"/></include>
			<control type="image">
				<left>0</left>
				<top>200</top>
				<width>1300</width>
				<height>880</height>
				<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
				<texture colordiffuse="b30f1412">sentence/ramp_left.png</texture>
			</control>
			<control type="grouplist">
				<left>page_margin</left>
				<top>380</top>
				<width>1300</width>
				<height>440</height>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="label">
					<width>1300</width>
					<height>28</height>
					<font>cap_20</font>
					<textcolor>muted</textcolor>
					<label>$LOCALIZE[31322]</label>
				</control>
				<control type="textbox">
					<top>14</top>
					<width>1100</width>
					<height max="256">auto</height>
					<font>serif_46</font>
					<textcolor>text</textcolor>
					<label>$VAR[OSDS_InfoP1]</label>
				</control>
				<control type="textbox">
					<top>24</top>
					<width>1000</width>
					<height max="120">auto</height>
					<font>body_26</font>
					<label>$INFO[VideoPlayer.Plot]</label>
				</control>
			</control>
			<include content="OSDS_Progress"><param name="top" value="900"/></include>
			<control type="label">
				<left>page_margin</left>
				<top>990</top>
				<width>page_width</width>
				<height>30</height>
				<font>ui_20</font>
				<textcolor>muted</textcolor>
				<label>$VAR[OSDS_Next]</label>
			</control>
			<control type="label">
				<left>page_margin</left>
				<top>990</top>
				<width>page_width</width>
				<height>30</height>
				<align>right</align>
				<font>ui_20</font>
				<textcolor>muted</textcolor>
				<label>$LOCALIZE[31323]</label>
			</control>
		</control>
	</controls>
</window>
