<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin settings: docs/skin.sentence/SETTINGS.md. Rule: an empty string / unset bool means the default.
	Note: $EXP is NOT expanded inside <autoscroll> or window-level <visible> (docs/LESSONS.md 2).
-->
<includes>
	<!-- Helpers -->
	<expression name="HasTMDbHelper">System.AddonIsEnabled(plugin.video.themoviedb.helper)</expression>
	<expression name="HasNextUpHelper">System.AddonIsEnabled(script.embuary.helper)</expression>

	<!-- Fixed by design in Sentence (kept so forked window logic reads naturally) -->
	<expression name="IsRounded">false</expression>
	<expression name="FocusOutlineOff">false</expression>
	<expression name="FocusOutlineMedium">false</expression>
	<expression name="ArtBackgroundOn">false</expression>
	<expression name="SpotlightRotateOff">true</expression>

	<!-- Settings -->
	<expression name="ShowTrailerButton">!Skin.HasSetting(sentence.hidetrailer)</expression>
	<expression name="ShowUnwatchedMarkers">!Skin.HasSetting(sentence.nomarkers)</expression>
	<expression name="ShowWatchedMarkers">!Skin.HasSetting(sentence.nomarkers)</expression>
	<expression name="ReduceMotion">Skin.HasSetting(sentence.reducemotion)</expression>
	<expression name="CaptionsFinish">!String.IsEqual(Skin.String(sentence.captions),facts)</expression>
	<expression name="ShowWeather">!Skin.HasSetting(sentence.noweather) + !String.IsEmpty(Weather.Conditions)</expression>
	<expression name="TimeGreeting">!Skin.HasSetting(sentence.alwaystonight)</expression>

	<!-- Items -->
	<expression name="ListItemIsVideoFile">!ListItem.IsFolder + [String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,musicvideo)]</expression>
	<expression name="ListItemUnwatched">Integer.IsEqual(ListItem.PlayCount,0) + !ListItem.IsResumable</expression>
	<expression name="ListItemWatched">Integer.IsGreater(ListItem.PlayCount,0)</expression>
	<expression name="ListItemHasRating">!String.IsEmpty(ListItem.Rating) + !String.IsEqual(ListItem.Rating,0.0) + !String.IsEqual(ListItem.Rating,0)</expression>
	<expression name="ListItemLong">Integer.IsGreater(ListItem.Duration(mins),59)</expression>

	<!-- Windows -->
	<expression name="InfoDialogActive">Window.IsVisible(movieinformation) | Window.IsVisible(musicinformation) | Window.IsVisible(addoninformation)</expression>
	<expression name="OSDPanelOpen">Window.IsVisible(SliderDialog) | Window.IsVisible(osdaudiosettings) | Window.IsVisible(osdvideosettings) | Window.IsVisible(osdsubtitlesettings) | Window.IsVisible(VideoBookmarks) | Window.IsVisible(playerprocessinfo) | Window.IsVisible(osdcmssettings)</expression>
</includes>
