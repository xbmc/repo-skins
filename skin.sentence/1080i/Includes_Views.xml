<?xml version="1.0" encoding="UTF-8"?>
<!--
	View 50 (a list, valid for everything) and the generic list window used by the remaining media
	windows (add-ons, programs, pictures, files...). Sentence: the list on the left, the focused item
	explained on the right; the header is a short sentence with phrases ("Sorted by [name], [A to Z], as [a list]").
	Kodi ids: 50 list, 60 its scrollbar, 3 sort-by / 4 sort-order hidden buttons, 9000 header grouplist.
-->
<includes>
	<!-- ============================================================ View 50 -->
	<!-- params: top (list top; the video library starts under its sentence header at 244) -->
	<include name="View_50_List">
		<param name="top">list_top</param>
		<param name="height">858</param>
		<param name="note">false</param>
		<definition>
			<control type="group">
				<visible>Control.IsVisible(50)</visible>
				<include>Anim_VisibleFade</include>
				<control type="list" id="50">
					<include>Lib_BackHomeNav</include>
					<left>page_margin</left>
					<top>$PARAM[top]</top>
					<width>list_w</width>
					<height>$PARAM[height]</height>
					<onup>9000</onup>
					<ondown>50</ondown>
					<onleft condition="Window.IsActive(videos) | Window.IsActive(music)">ActivateWindow(1155)</onleft>  <!-- 0.9.8: the Library panel -->
					<onleft>noop</onleft>
					<onright>60</onright>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<viewtype label="31366">list</viewtype>
					<include content="Sen_ListLayout">
						<param name="width" value="1080"/>
						<param name="height" value="66"/>
						<param name="list_id" value="50"/>
					</include>
				</control>
				<include content="Sen_Scrollbar">
					<param name="id" value="60"/>
					<param name="left" value="1216"/>
					<param name="top" value="$PARAM[top]"/>
					<param name="height" value="$PARAM[height]"/>
					<param name="onleft" value="50"/>
					<param name="onright" value="$VAR[Sen_Lib_ScrollRight]"/>
				</include>
				<!-- video library: the paragraph note; elsewhere: art + a short sentence -->
				<include content="Lib_Note" condition="$PARAM[note]"/>
				<control type="group">
					<left>1308</left>
					<top>$PARAM[top]</top>
					<width>492</width>
					<visible>!$PARAM[note]</visible>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>492</width>
						<height>492</height>
						<aspectratio align="left" aligny="top">keep</aspectratio>
						<fadetime>120</fadetime>
						<texture background="true">$VAR[ListItemArt]</texture>
					</control>
					<control type="textbox">
						<left>0</left>
						<top>516</top>
						<width>492</width>
						<height>154</height>
						<font>serif_36</font>
						<textcolor>text</textcolor>
						<label>[I]$INFO[ListItem.Label][/I]$INFO[ListItem.Label2, · ,]</label>
					</control>
					<control type="textbox">
						<left>0</left>
						<top>684</top>
						<width>492</width>
						<height>114</height>
						<font>body_24</font>
						<textcolor>muted</textcolor>
						<label>$INFO[ListItem.Plot]</label>
					</control>
				</control>
			</control>
		</definition>
	</include>

</includes>
