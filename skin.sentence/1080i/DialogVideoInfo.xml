<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information as a paragraph (Includes_VideoInfo.xml). Movie, episode, show, season, collection.
	Kodi id contract (Estuary Omega DialogVideoInfo + CGUIDialogVideoInfo): 8 play/browse, 9 resume,
	11 trailer, 50 cast, 6/7/10/12/13/14/15 secondary actions, 443 collection (Estuary convention).
	Default focus: the first action phrase. The page slides up while the cast row has focus.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>Sen_Background</include>
		<control type="group">
			<animation type="Conditional" condition="Control.HasFocus(50) + !Skin.HasSetting(sentence.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-470" time="260" tween="cubic" easing="out"/>
			</animation>
			<animation type="Conditional" condition="Control.HasFocus(50) + Skin.HasSetting(sentence.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,-470" time="0"/>
			</animation>
			<include>VidInfo_Backdrop</include>
			<include content="Sen_PageHeader">
				<param name="title" value="$VAR[VidInfo_Crumb]"/>
			</include>
			<include>Sen_Clock</include>
			<include>VidInfo_Article</include>
			<include>VidInfo_TaglineAndHint</include>
			<include>VidInfo_CastRow</include>
		</control>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
