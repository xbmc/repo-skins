<?xml version="1.0" encoding="UTF-8"?>
<!--
	Profiles (Settings > Profiles; SPEC 5: Minimal). Builder F, M4. Estuary splits this into a
	category list (9000) showing either the options or the profiles; Majan shows both at once:
	options on the left, profiles on the right. Kodi appends its own "Add profile..." item.
	Kodi id contract (Estuary Omega SettingsProfile.xml / GUIWindowSettingsProfile): profile
	container 2, login-screen radio 4, auto-login button 5.
-->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<backgroundcolor>ground</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Sen_Background</include>
		<include content="Sen_TopBar">
			<param name="index" value="15"/>
			<param name="title" value="$LOCALIZE[13200]"/>
		</include>
		<!-- ====== options -->
		<include content="Misc_Caption">
			<param name="left" value="page_margin"/>
			<param name="top" value="content_top"/>
			<param name="width" value="misc_menu_w"/>
			<param name="label" value="$LOCALIZE[128]"/>
		</include>
		<control type="grouplist" id="9001">
			<left>page_margin</left>
			<top>212</top>
			<width>misc_menu_w</width>
			<height>200</height>
			<orientation>vertical</orientation>
			<onleft>noop</onleft>
			<onright>2</onright>
			<onup>9001</onup>
			<ondown>9001</ondown>
			<control type="radiobutton" id="4">
				<description>Show login screen on startup</description>
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[31391]</label>
			</control>
			<control type="button" id="5">
				<description>Auto login profile</description>
				<include content="Misc_RowLook"><param name="width" value="misc_menu_w"/></include>
				<label>$LOCALIZE[31392]</label>
				<label2>$INFO[System.ProfileAutoLogin]</label2>
				<enable>!Window.IsVisible(ProfileSettings) + !System.HasLoginScreen</enable>
			</control>
		</control>
		<!-- ====== profiles -->
		<include content="Misc_Caption">
			<param name="left" value="misc_col_x"/>
			<param name="top" value="content_top"/>
			<param name="width" value="misc_col_w"/>
			<param name="label" value="$LOCALIZE[13200]"/>
		</include>
		<control type="list" id="2">
			<left>misc_col_x</left>
			<top>212</top>
			<width>1080</width>
			<height>800</height>
			<onup>2</onup>
			<ondown>2</ondown>
			<onleft>9001</onleft>
			<onright>noop</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout width="1080" height="100">
				<control type="image">
					<left>16</left>
					<top>14</top>
					<width>72</width>
					<height>72</height>
					<aspectratio>scale</aspectratio>
					<texture colordiffuse="raised">common/white.png</texture>
				</control>
				<control type="image">
					<left>16</left>
					<top>14</top>
					<width>72</width>
					<height>72</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>112</left>
					<top>14</top>
					<width>900</width>
					<height>40</height>
					<font>ui_24_bold</font>
					<textcolor>muted</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>112</left>
					<top>54</top>
					<width>900</width>
					<height>30</height>
					<font>cap_20</font>
					<textcolor>muted</textcolor>
					<label>$INFO[ListItem.Label2,Last login  ,]</label>
				</control>
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>1080</width>
					<height>rule_h</height>
					<texture colordiffuse="rule">common/hairline.png</texture>
				</control>
			</itemlayout>
			<focusedlayout width="1080" height="100">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1080</width>
					<height>100</height>
					<texture colordiffuse="raised">common/white.png</texture>
					<visible>Control.HasFocus(2)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>list_bar_w</width>
					<height>100</height>
					<texture colordiffuse="lilac">common/white.png</texture>
					<visible>Control.HasFocus(2)</visible>
				</control>
				<control type="image">
					<left>16</left>
					<top>14</top>
					<width>72</width>
					<height>72</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>112</left>
					<top>14</top>
					<width>900</width>
					<height>40</height>
					<font>ui_24_bold</font>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>112</left>
					<top>54</top>
					<width>900</width>
					<height>30</height>
					<font>cap_20</font>
					<textcolor>muted</textcolor>
					<label>$INFO[ListItem.Label2,Last login  ,]</label>
				</control>
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>1080</width>
					<height>rule_h</height>
					<texture colordiffuse="rule">common/hairline.png</texture>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
