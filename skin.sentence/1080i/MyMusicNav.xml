<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music library. Header sentence + views: Includes_Views_Music.xml; 0.9.16: 507 a tracklist (songs), 508 portraits
	(albums, artists) in Includes_Views_More.xml (_src/make_views_more.py). Now-playing line: Includes_Music.xml.
	Kodi id contract (Estuary Omega MyMusicNav.xml / GUIWindowMusicNav.cpp): <views>, menucontrol 9000,
	3 sort by, 4 sort order (hidden, clicked by the header phrases). Reserved by Kodi and not reused:
	2, 5, 8, 12, 15, 16, 17, 19, 20.
	Focus: view Up -> header sentence (Left/Right inside); Down -> view. Back is Kodi's (up a folder / history).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<backgroundcolor>ground</backgroundcolor>
	<views>504,507,508,50</views>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>Sen_Background</include>
		<include>Music_Header</include>
		<include>Music_View_504</include>
		<include>Music_View_507</include>
		<include>Music_View_508</include>
		<include>Music_View_50</include>
		<control type="group">
			<left>page_margin</left>
			<top>280</top>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>page_width</width>
				<height>72</height>
				<font>serif_44</font>
				<textcolor>muted</textcolor>
				<label>$VAR[Music_EmptySentence]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>84</top>
				<width>page_width</width>
				<height>40</height>
				<font>ui_24</font>
				<textcolor>muted</textcolor>
				<label>$LOCALIZE[31370]</label>
			</control>
		</control>
		<include>Music_NowPlayingBar</include>
		<include>Lib_BackHomeButton</include>
	</controls>
</window>
