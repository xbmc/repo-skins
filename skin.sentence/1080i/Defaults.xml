<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Sentence focus language: the focused control is a lilac block (6px radius) with ink text;
	unfocused text is plain. Colours are names from colors/defaults.xml.
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>text</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<selectedcolor>text</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>text</textcolor>
		<disabledcolor>disabled</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>body</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="8" colordiffuse="lilac">sentence/round6.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="on_lilac">markers/check.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="lilac">markers/check.png</textureradioonnofocus>
		<textureradioofffocus border="8" colordiffuse="on_lilac">sentence/outline6.png</textureradioofffocus>
		<textureradiooffnofocus border="8" colordiffuse="rule_strong">sentence/outline6.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="disabled">markers/check.png</textureradioondisabled>
		<textureradiooffdisabled border="8" colordiffuse="disabled">sentence/outline6.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="muted">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="muted" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="on_lilac">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="on_lilac" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="muted">icons/chevron_right.png</textureup>
		<texturedown colordiffuse="muted" flipx="true">icons/chevron_right.png</texturedown>
		<textureupfocus colordiffuse="lilac">icons/chevron_right.png</textureupfocus>
		<texturedownfocus colordiffuse="lilac" flipx="true">icons/chevron_right.png</texturedownfocus>
		<textureupdisabled colordiffuse="disabled">icons/chevron_right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="disabled" flipx="true">icons/chevron_right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="rule_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="rule">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="muted">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="on_lilac">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="rule_strong">common/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="rule">common/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="muted">common/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="lilac">common/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="disabled">common/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>common/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="disabled">common/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>text</textcolor>
		<focusedcolor>on_lilac</focusedcolor>
		<disabledcolor>disabled</disabledcolor>
		<invalidcolor>warn</invalidcolor>
		<texturefocus border="8" colordiffuse="lilac">sentence/round6.png</texturefocus>
		<texturenofocus border="8" colordiffuse="rule_strong">sentence/outline6.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="rule_strong">common/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="lilac">common/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="rule">common/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="muted">common/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="lilac">common/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
