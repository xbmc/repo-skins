<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Keepsake: the unwatched - films you added and never played, oldest first -->
<smartplaylist type="movies">
    <name>the unwatched</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="inprogress" operator="false">
        <value></value>
    </rule>
    <order direction="ascending">dateadded</order>
</smartplaylist>
