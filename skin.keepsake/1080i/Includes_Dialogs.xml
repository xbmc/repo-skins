<?xml version="1.0" encoding="UTF-8"?>
<!--
	Dialog building blocks (owner: Builder E · Settings + core dialogs, M4 styling pass).
	Index vocabulary: flat bg panel, 1px hairline frame, header title + rule, hairline list rows,
	focused row = bg_raised fill + 2px accent frame (inset), buttons = 1px outline at rest, accent
	fill + ink text on focus. Right-hand 720px playback panel per mockups/Tracks + AVSettings.

	Shared names other builders may use (params unchanged from M1, look restyled):
	  KS_GenericDialog, KS_DialogButton, KS_ListLayout, KS_Scrollbar,
	  KS_ToastFrame, KS_KeyboardKey, KS_KeyboardFunc
	Builder E's own: Dlg_* (constants dlg_*).
-->
<includes>
	<!-- ============================================================ constants -->
	<constant name="dlg_panel_x">1200</constant>          <!-- right-hand playback panel (mockups/Tracks, AVSettings) -->
	<constant name="dlg_panel_w">720</constant>
	<constant name="dlg_panel_pad">72</constant>          <!-- inner left/right padding -->
	<constant name="dlg_panel_in_w">576</constant>        <!-- 720 - 2 x 72 -->
	<constant name="dlg_panel_top">64</constant>
	<constant name="dlg_track_row_h">58</constant>
	<constant name="dlg_osd_row_h">76</constant>
	<constant name="dlg_row_pad">16</constant>            <!-- text inset inside a list row -->
	<constant name="dlg_check">22</constant>              <!-- current-item check -->
	<constant name="dlg_check_gutter">56</constant>       <!-- label x when a check column precedes it -->
	<constant name="dlg_btn_h">60</constant>

	<!-- ============================================================ expressions -->
	<!-- DialogSelect shows the right-hand track panel only over fullscreen video -->
	<expression name="Dlg_IsTrackPanel">Player.HasVideo + Window.IsActive(fullscreenvideo)</expression>
	<!-- the select list was opened from the OSD subtitle settings (subtitle stream list) -->
	<expression name="Dlg_FromSubtitleSettings">Window.IsVisible(osdsubtitlesettings)</expression>
	<!-- DialogSettings is one of the OSD playback settings dialogs -->
	<expression name="Dlg_IsOSDSettings">Window.IsActive(osdaudiosettings) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdvideosettings) | Window.IsActive(osdcmssettings)</expression>

	<!-- ============================================================ variables -->
	<!-- Track panel kicker: "SUBTITLES · 16 TRACKS" -->
	<variable name="Dlg_SelectKicker">
		<!-- 1.0.4: singular for one item ("Audio · 1 tracks" on single-track files) -->
		<value condition="Window.IsVisible(osdsubtitlesettings) + Integer.IsEqual(Container(3).NumItems,1)">Subtitles  ·  1 track</value>
		<value condition="Window.IsVisible(osdaudiosettings) + Integer.IsEqual(Container(3).NumItems,1)">Audio  ·  1 track</value>
		<value condition="Window.IsVisible(osdvideosettings) + Integer.IsEqual(Container(3).NumItems,1)">Video  ·  1 option</value>
		<value condition="Control.IsVisible(6) + Integer.IsEqual(Container(6).NumItems,1)">Select  ·  1 item</value>
		<value condition="!Control.IsVisible(6) + Integer.IsEqual(Container(3).NumItems,1)">Select  ·  1 item</value>
		<value condition="Window.IsVisible(osdsubtitlesettings)">Subtitles$INFO[Container(3).NumItems,  ·  , tracks]</value>
		<value condition="Window.IsVisible(osdaudiosettings)">Audio$INFO[Container(3).NumItems,  ·  , tracks]</value>
		<value condition="Window.IsVisible(osdvideosettings)">Video$INFO[Container(3).NumItems,  ·  , options]</value>
		<value condition="Control.IsVisible(6)">Select$INFO[Container(6).NumItems,  ·  , items]</value>
		<value>Select$INFO[Container(3).NumItems,  ·  , items]</value>
	</variable>
	<!-- Centred select: "03 / 16" in the header -->
	<variable name="Dlg_SelectPosition">
		<value condition="Control.IsVisible(6)">$INFO[Container(6).CurrentItem]$INFO[Container(6).NumItems, / ,]</value>
		<value>$INFO[Container(3).CurrentItem]$INFO[Container(3).NumItems, / ,]</value>
	</variable>
	<!-- What is playing, under the track panel: "PAUSED · 1:02:31 / 2:14:00" -->
	<variable name="Dlg_PlayState">
		<value condition="Player.Paused">Paused  ·  $INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
		<value>$INFO[Player.Time]$INFO[Player.Duration, / ,]</value>
	</variable>
	<variable name="Dlg_PlayTitle">
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value>$INFO[VideoPlayer.Title]</value>
	</variable>

	<variable name="Dlg_CheckOnTape">
		<value condition="Control.HasFocus(3) | Control.HasFocus(6) | Control.HasFocus(50) | Control.HasFocus(9000)">on_tape</value>
		<value>ink</value>
	</variable>
	<variable name="Dlg_AddonNewsLabel">
		<value condition="!String.IsEmpty(Window(Home).Property(keepsake.addonnews))">Description</value>
		<value>What's new</value>
	</variable>

	<!-- ============================================================ texture switches -->
	<!-- (button textures can't take $VAR, so corners / outline weight are picked at window load) -->
	<include name="Dlg_Tex_DialogButton">
		<include condition="false">Dlg_Tex_DialogButton_Round</include>
		<include condition="true">Dlg_Tex_DialogButton_Square</include>
	</include>
	<include name="Dlg_Tex_DialogButton_Square">
		<texturefocus border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texturefocus>
		<texturenofocus />
	</include>
	<include name="Dlg_Tex_DialogButton_Round">
		<include>Dlg_Tex_DialogButton_Square</include>
	</include>

	<!-- Accent frame drawn AT the control rect (stroke sits 1-3px inside), for Kodi-cloned rows -->
	<include name="Dlg_Tex_RowFocus">
		<include condition="true + true">Dlg_Tex_RowFocus_S2</include>
		<include condition="true + false">Dlg_Tex_RowFocus_S3</include>
		<include condition="false + true">Dlg_Tex_RowFocus_R2</include>
		<include condition="false + false">Dlg_Tex_RowFocus_R3</include>
	</include>
	<include name="Dlg_Tex_RowFocus_S2"><texturefocus border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_S3"><texturefocus border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_R2"><texturefocus border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texturefocus></include>
	<include name="Dlg_Tex_RowFocus_R3"><texturefocus border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texturefocus></include>

	<!-- Hairline under a row (texturenofocus of Kodi-cloned rows). flip = true gives a top rule. -->
	<include name="Dlg_Tex_RowRule">
		<param name="color">rule</param>
		<param name="flip">false</param>
		<definition>
			<texturenofocus border="0,0,0,2" flipy="$PARAM[flip]" colordiffuse="$PARAM[color]">dialogs/row_rule.png</texturenofocus>
		</definition>
	</include>

	<!-- ============================================================ generic dialog -->
	<!-- Centred modal frame. Put inside a group positioned/sized like the dialog.
	     params: width, height, header_id (Kodi heading id, "" if none), header_label,
	             kicker (optional mono caption, right side of the header, accent) -->
	<include name="KS_GenericDialog">
		<!-- a loose album leaf over the dimmed page: handwritten heading, DM Mono kicker, dotted rule.
		     params: width, height, header_id (Kodi heading id, "" if none), header_label, kicker -->
		<param name="header_id"></param>
		<param name="header_label"></param>
		<param name="kicker"></param>
		<definition>
			<control type="image">
				<description>backdrop dim (own fades: LESSONS 4)</description>
				<left>-2000</left>
				<top>-2000</top>
				<width>6000</width>
				<height>6000</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="veil">common/white.png</texture>
			</control>
			<control type="image">
				<description>the leaf (paper_card.png carries a 40 px shadow margin)</description>
				<left>-40</left>
				<top>-40</top>
				<right>-40</right>
				<bottom>-40</bottom>
				<texture border="60">ks/paper_card.png</texture>
			</control>
			<control type="label" id="$PARAM[header_id]">
				<description>heading</description>
				<left>dialog_pad</left>
				<top>8</top>
				<right>260</right>
				<height>dialog_header_h</height>
				<font>hand_48</font>
				<textcolor>ink</textcolor>
				<label>$PARAM[header_label]</label>
			</control>
			<control type="label">
				<description>kicker</description>
				<right>dialog_pad</right>
				<top>0</top>
				<width>240</width>
				<height>dialog_header_h</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$PARAM[kicker]</label>
			</control>
			<control type="image">
				<left>dialog_pad</left>
				<top>dialog_header_h</top>
				<right>dialog_pad</right>
				<height>4</height>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="rule_strong">ks/dots_h.png</texture>
			</control>
		</definition>
	</include>

	<!-- Dialog button: 1px outline at rest, accent fill + ink text on focus (always visible focus).
	     params: id, label, width, height, onclick, onclick2 (second action), visible, enable -->
	<!-- No <enable>: Kodi enables/disables its own dialog buttons (5/7/8, 28-30); a skin <enable> would override it. -->
	<include name="KS_DialogButton">
		<!-- dialog button: handwritten word, a strip of tape behind it on focus (dark ink on the tape).
		     No <enable>: Kodi enables/disables its own dialog buttons. params: id, label, width, height,
		     onclick, onclick2, visible -->
		<param name="width">300</param>
		<param name="height">dialog_row_h</param>
		<param name="label"></param>
		<param name="onclick">noop</param>
		<param name="onclick2">noop</param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<label>[LOWERCASE]$PARAM[label][/LOWERCASE]</label>
				<font>hand_40b</font>
				<textcolor>ink</textcolor>
				<focusedcolor>on_tape</focusedcolor>
				<disabledcolor>ink_ghost</disabledcolor>
				<align>center</align>
				<aligny>center</aligny>
				<textoffsetx>18</textoffsetx>
				<include>Dlg_Tex_DialogButton</include>
				<onclick>$PARAM[onclick]</onclick>
				<onclick>$PARAM[onclick2]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- Definition-list fact (mono field label + value), 40px pitch. params: top, label, value, valuew -->
	<include name="Dlg_FactRow">
		<param name="valuew">620</param>
		<definition>
			<control type="label">
				<left>0</left>
				<top>$PARAM[top]</top>
				<width>160</width>
				<height>28</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$PARAM[label]</label>
			</control>
			<control type="label">
				<left>160</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[valuew]</width>
				<height>28</height>
				<font>mono_20</font>
				<textcolor>ink_bold</textcolor>
				<label>$PARAM[value]</label>
			</control>
		</definition>
	</include>

	<!-- ============================================================ list rows -->
	<!-- Focused-row treatment inside a <focusedlayout>: raised fill + 2px accent frame (inset).
	     Shown only while the list has focus, so an unfocused list never looks "selected".
	     params: list_id, width, height -->
	<include name="Dlg_RowFocus">
		<!-- the tape behind the focused row (only while its list has focus). params: list_id, width, height -->
		<definition>
			<control type="image">
				<left>-12</left>
				<top>4</top>
				<right>-12</right>
				<bottom>4</bottom>
				<texture border="24,0,24,0" colordiffuse="tape">ks/tape_row.png</texture>
				<visible>Control.HasFocus($PARAM[list_id])</visible>
			</control>
		</definition>
	</include>

	<!-- Text list: check column (current / selected item), label, mono label2 on the right,
	     hairline under each row. params: width, height, label, label2, list_id -->
	<include name="KS_ListLayout">
		<!-- text list: pen tick for the current / selected item, label, DM Mono label2 on the right, dotted rule
		     under each row; the focused row sits on tape. params: width, height, label, label2, list_id -->
		<param name="width">800</param>
		<param name="height">64</param>
		<param name="label">$INFO[ListItem.Label]</param>
		<param name="label2">$INFO[ListItem.Label2]</param>
		<param name="list_id">50</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>4</height>
					<aspectratio>center</aspectratio>
					<texture colordiffuse="rule">ks/dots_h.png</texture>
				</control>
				<control type="image">
					<left>12</left>
					<centertop>50%</centertop>
					<width>30</width>
					<height>30</height>
					<texture colordiffuse="ink">ks/pen_check.png</texture>
					<visible>ListItem.IsSelected</visible>
				</control>
				<control type="label">
					<left>dlg_check_gutter</left>
					<top>0</top>
					<right>240</right>
					<height>$PARAM[height]</height>
					<aligny>center</aligny>
					<font>ttt_26</font>
					<textcolor>ink2</textcolor>
					<selectedcolor>ink_bold</selectedcolor>
					<label>$PARAM[label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>210</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>lbln_20</font>
					<textcolor>label</textcolor>
					<selectedcolor>label_hi</selectedcolor>
					<label>$PARAM[label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<control type="image">
					<left>12</left>
					<centertop>50%</centertop>
					<width>30</width>
					<height>30</height>
					<texture colordiffuse="$VAR[Dlg_CheckOnTape]">ks/pen_check.png</texture>
					<visible>ListItem.IsSelected</visible>
				</control>
				<include content="KS_RowLabel">
					<param name="list" value="$PARAM[list_id]"/><param name="left" value="dlg_check_gutter"/>
					<param name="right" value="240"/><param name="height" value="$PARAM[height]"/>
					<param name="font" value="ttt_26"/><param name="label" value="$PARAM[label]"/>
				</include>
				<include content="KS_RowLabel">
					<param name="list" value="$PARAM[list_id]"/><param name="left" value="0"/>
					<param name="right" value="24"/><param name="height" value="$PARAM[height]"/>
					<param name="font" value="lbln_20"/><param name="label" value="$PARAM[label2]"/>
					<param name="align" value="right"/><param name="color" value="label_hi"/>
				</include>
			</focusedlayout>
		</definition>
	</include>

	<!-- Numbered menu list (Settings hub, System menu, power menu): mono index from
	     ListItem.Property(index) (accent on the focused row), label, mono hint (label2).
	     params: width, height, list_id -->
	<!-- Row number from the item's position among VISIBLE items (no gaps when Kodi hides items such
	     as Reboot/Power off on Android); two digits. -->
	<include name="Dlg_IndexListLayout">
		<!-- menu list (settings hub, system menu, power menu): label, DM Mono hint (label2); tape on focus.
		     params: width, height, list_id -->
		<param name="width">860</param>
		<param name="height">72</param>
		<param name="list_id">9000</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="$PARAM[height]">
				<control type="label">
					<left>24</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<aligny>center</aligny>
					<font>hand_40</font>
					<textcolor>ink</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<right>24</right>
					<top>0</top>
					<width>320</width>
					<height>$PARAM[height]</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="$PARAM[height]">
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="$PARAM[width]"/>
					<param name="height" value="$PARAM[height]"/>
				</include>
				<include content="KS_RowLabel">
					<param name="list" value="$PARAM[list_id]"/><param name="left" value="24"/>
					<param name="right" value="24"/><param name="height" value="$PARAM[height]"/>
					<param name="font" value="hand_40b"/><param name="label" value="$INFO[ListItem.Label]"/>
				</include>
				<include content="KS_RowLabel">
					<param name="list" value="$PARAM[list_id]"/><param name="left" value="0"/>
					<param name="right" value="24"/><param name="height" value="$PARAM[height]"/>
					<param name="font" value="lbl_20"/><param name="label" value="$INFO[ListItem.Label2]"/>
					<param name="align" value="right"/><param name="color" value="label_hi"/>
				</include>
			</focusedlayout>
		</definition>
	</include>

	<!-- Track rows (mockups/Tracks): 58px, check for the current track, name (bold when current),
	     mono meta (label2) on the right, #1c1c1c-ish divider (bg_ghost). params: list_id -->
	<include name="Dlg_TrackListLayout">
		<param name="list_id">3</param>
		<definition>
			<itemlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>dlg_panel_in_w</width>
					<height>4</height>
					<aspectratio>center</aspectratio>
					<texture colordiffuse="rule">ks/dots_h.png</texture>
				</control>
				<include content="Dlg_TrackRowContent"><param name="on_tape" value="false"/></include>
			</itemlayout>
			<focusedlayout width="dlg_panel_in_w" height="dlg_track_row_h">
				<include content="Dlg_RowFocus">
					<param name="list_id" value="$PARAM[list_id]"/>
					<param name="width" value="dlg_panel_in_w"/>
					<param name="height" value="dlg_track_row_h"/>
				</include>
				<control type="group">
					<visible>Control.HasFocus($PARAM[list_id])</visible>
					<include content="Dlg_TrackRowContent"><param name="on_tape" value="true"/></include>
				</control>
				<control type="group">
					<visible>!Control.HasFocus($PARAM[list_id])</visible>
					<include content="Dlg_TrackRowContent"><param name="on_tape" value="false"/></include>
				</control>
			</focusedlayout>
		</definition>
	</include>
	<include name="Dlg_TrackRowContent">
		<param name="on_tape">false</param>
		<definition>
			<control type="image">
				<left>10</left>
				<top>14</top>
				<width>30</width>
				<height>30</height>
				<texture colordiffuse="ink">ks/pen_check.png</texture>
				<visible>ListItem.IsSelected + !$PARAM[on_tape]</visible>
			</control>
			<control type="image">
				<left>10</left>
				<top>14</top>
				<width>30</width>
				<height>30</height>
				<texture colordiffuse="on_tape">ks/pen_check.png</texture>
				<visible>ListItem.IsSelected + $PARAM[on_tape]</visible>
			</control>
			<control type="label">
				<left>56</left>
				<top>0</top>
				<right>150</right>
				<height>dlg_track_row_h</height>
				<aligny>center</aligny>
				<font>hand_36</font>
				<textcolor>ink2</textcolor>
				<selectedcolor>ink_bold</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>!$PARAM[on_tape]</visible>
			</control>
			<control type="label">
				<left>56</left>
				<top>0</top>
				<right>150</right>
				<height>dlg_track_row_h</height>
				<aligny>center</aligny>
				<font>hand_36b</font>
				<textcolor>on_tape</textcolor>
				<selectedcolor>on_tape</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>$PARAM[on_tape]</visible>
			</control>
			<control type="label">
				<right>dlg_row_pad</right>
				<top>0</top>
				<width>130</width>
				<height>dlg_track_row_h</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<selectedcolor>label</selectedcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>!$PARAM[on_tape]</visible>
			</control>
			<control type="label">
				<right>dlg_row_pad</right>
				<top>0</top>
				<width>130</width>
				<height>dlg_track_row_h</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>lbl_20</font>
				<textcolor>on_tape</textcolor>
				<selectedcolor>on_tape</selectedcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>$PARAM[on_tape]</visible>
			</control>
		</definition>
	</include>

	<!-- Thin scroll-position line paired with a list (2px; thumb brightens to accent when focused).
	     params: id, left, top, height, onleft, onright -->
	<include name="KS_Scrollbar">
		<!-- a thin pen line beside a list. params: id, left, top, height, onleft, onright -->
		<param name="onleft">noop</param>
		<param name="onright">noop</param>
		<param name="onright2">noop</param>
		<definition>
			<control type="scrollbar" id="$PARAM[id]">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>3</width>
				<height>$PARAM[height]</height>
				<texturesliderbackground colordiffuse="rule">common/white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="ink_faint">common/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="ink_bold">common/white.png</texturesliderbarfocus>
				<onleft>$PARAM[onleft]</onleft>
				<onright>$PARAM[onright]</onright>
				<onright>$PARAM[onright2]</onright>
				<orientation>vertical</orientation>
			</control>
		</definition>
	</include>

	<!-- ============================================================ right-hand playback panel -->
	<!-- Full-screen dim over the paused frame + the 720px panel with its left hairline.
