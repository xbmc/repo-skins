<?xml version="1.0" encoding="UTF-8"?>
<!--
	Slider dialog = minimal offset strip (M3, Builder D). Mockup: docs/skin.keepsake/mockups/Offset.dc.html,
	SPEC decisions 10-12: a 720px strip, top-centre by default, holding only the caption (mono),
	the value (accent mono) and a 2px hairline track with a zero tick and the playhead. No helper
	text, no panel, never over the picture centre. Used for audio AND subtitle offset (and any
	other DialogSlider Kodi opens, e.g. video settings sliders: same strip, no zero tick).

	Position: skin setting keepsake.offsetbar = empty/top (default, Omar's subtitles sit at the bottom)
	or "bottom" (for top-aligned subtitles). Read live through a Conditional slide, so the strip
	follows the setting without a skin reload.

	Id contract (Estuary Omega DialogSlider.xml / GUIDialogSlider.cpp): 10 heading, 11 slider
	(default), 12 value label. Mouse-only buttons 13/14 omitted (no pointer on the Shield).
	DialogSettings (Builder E) hides its panel while Window.IsVisible(sliderdialog).
-->
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<controls>
		<control type="group">
			<left>600</left>
			<top>56</top>
			<width>720</width>
			<height>92</height>
			<include>Anim_TopStrip</include>
			<animation effect="slide" end="0,876" time="0" condition="$EXP[OSD_OffsetBarBottom]">Conditional</animation>

			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>720</width>
				<height>92</height>
				<texture colordiffuse="track">common/white.png</texture>
			</control>
			<control type="label" id="10">
				<description>heading (Kodi: "Subtitle offset" / "Audio offset" ...)</description>
				<left>24</left>
				<top>18</top>
				<width>440</width>
				<height>34</height>
				<font>lbl_20</font>
				<textcolor>ink2</textcolor>
			</control>
			<control type="label" id="12">
				<description>value (Kodi formats it, e.g. "0.300 s")</description>
				<left>24</left>
				<top>14</top>
				<width>672</width>
				<height>40</height>
				<align>right</align>
				<font>mono_26</font>
			</control>

			<!-- 2px track + zero tick (offsets are symmetric, so zero is the centre) -->
			<control type="image">
				<left>24</left>
				<top>70</top>
				<width>672</width>
				<height>2</height>
				<texture colordiffuse="rule_strong">common/white.png</texture>
			</control>
			<control type="image">
				<left>360</left>
				<top>64</top>
				<width>1</width>
				<height>14</height>
				<texture colordiffuse="label">common/white.png</texture>
				<visible>String.Contains(Control.GetLabel(10),offset) | String.Contains(Control.GetLabel(10),delay)</visible>
			</control>
			<control type="slider" id="11">
				<description>slider (playhead nib only; Left/Right change the value)</description>
				<left>24</left>
				<top>63</top>
				<width>672</width>
				<height>16</height>
				<texturesliderbar>osd/slider_bg.png</texturesliderbar>
				<textureslidernib colordiffuse="ink_bold">osd/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="ink_bold">osd/slider_nib.png</textureslidernibfocus>
				<onup>11</onup>
				<ondown>11</ondown>
				<onleft>11</onleft>
				<onright>11</onright>
			</control>
		</control>
	</controls>
</window>
