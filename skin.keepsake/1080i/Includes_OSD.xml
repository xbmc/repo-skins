	<include name="OSD_InfoRow">
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<width>860</width>
				<height>44</height>
				<visible>$PARAM[visible]</visible>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>240</width>
					<height>40</height>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$PARAM[key]</label>
				</control>
				<control type="label">
					<left>240</left>
					<top>0</top>
					<width>620</width>
					<height>40</height>
					<font>mono_20</font>
					<textcolor>ink_bold</textcolor>
					<label>$PARAM[value]</label>
				</control>
				<control type="image">
					<left>0</left>
					<top>40</top>
					<width>860</width>
					<height>4</height>
					<aspectratio>center</aspectratio>
					<texture colordiffuse="rule">ks/dots_h.png</texture>
				</control>
			</control>
		</definition>
	</include>

	<!-- one DialogSubtitles result (696 x 84). param focused -->
	<include name="OSD_SubtitleRow">
		<param name="focused">false</param>
		<definition>
			<control type="label">
				<left>16</left>
				<top>24</top>
				<width>60</width>
				<height>36</height>
				<align>center</align>
				<font>mono_22</font>
				<textcolor>stamp</textcolor>
				<label>[UPPERCASE]$INFO[ListItem.Thumb][/UPPERCASE]</label>
			</control>
			<control type="label">
				<left>90</left>
				<top>10</top>
				<width>480</width>
				<height>38</height>
				<font>ttt_24</font>
				<textcolor>ink_bold</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<scroll>$PARAM[focused]</scroll>
			</control>
			<control type="label">
				<left>90</left>
				<top>46</top>
				<width>480</width>
				<height>27</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$INFO[ListItem.Label]$INFO[ListItem.ActualIcon,  ·  rating , / 5]</label>
			</control>
			<control type="label">
				<left>580</left>
				<top>28</top>
				<width>100</width>
				<height>27</height>
				<align>right</align>
				<font>lbl_20</font>
				<textcolor>label_hi</textcolor>
				<label>$VAR[OSD_SubBadges]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>80</top>
				<width>696</width>
				<height>4</height>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="rule">ks/dots_h.png</texture>
			</control>
		</definition>
	</include>
	<variable name="OSD_SubBadges">
		<value condition="ListItem.Property(sync) + ListItem.Property(hearing_imp)">sync · hi</value>
		<value condition="ListItem.Property(sync)">sync</value>
		<value condition="ListItem.Property(hearing_imp)">hi</value>
	</variable>

	<!-- one chapter print (item 344 x 290; photo 300 x 169 + 10 border at 12,12) -->
	<include name="OSD_BookmarkItem">
		<param name="label_color">ink2</param>
		<definition>
			<control type="image">
				<left>9</left>
				<top>9</top>
				<width>326</width>
				<height>195</height>
				<texture border="12" colordiffuse="print">ks/print.png</texture>
			</control>
			<control type="image">
				<left>22</left>
				<top>22</top>
				<width>300</width>
				<height>169</height>
				<texture colordiffuse="paper_raised">common/white.png</texture>
			</control>
			<control type="label">
				<left>22</left>
				<top>22</top>
				<width>300</width>
				<height>169</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>mono_22</font>
				<textcolor>label</textcolor>
				<label>$INFO[ListItem.Label2]</label>
				<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="image">
				<left>22</left>
				<top>22</top>
				<width>300</width>
				<height>169</height>
				<aspectratio>scale</aspectratio>
				<fadetime>120</fadetime>
				<texture background="true">$INFO[ListItem.Art(thumb)]</texture>
				<visible>!String.IsEmpty(ListItem.Art(thumb))</visible>
			</control>
			<control type="label">
				<left>12</left>
				<top>212</top>
				<width>320</width>
				<height>44</height>
				<font>hand_34</font>
				<textcolor>$PARAM[label_color]</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<left>14</left>
				<top>254</top>
				<width>320</width>
				<height>27</height>
				<font>mono_20</font>
				<textcolor>label</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</definition>
	</include>
</includes>
