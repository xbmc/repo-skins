<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogSettings (M4, Builder E). One file, two looks (picked at window load per dialog instance):
	  · osdaudiosettings / osdsubtitlesettings / osdvideosettings / osdcmssettings:
	    720px right-hand panel over the video with AUDIO / SUBTITLES / VIDEO tabs
	    (mockups/AVSettings.dc.html, SPEC Decision 10). Tabs close the current dialog and open the
	    sibling; Window(Home).Property(keepsake.osdtab) marks a tab swap so the panel doesn't re-slide.
	    The panel hides while the offset slider (DialogSlider) is up so the picture stays clear.
	  · everything else (lock, content, PVR timer, profile, source settings ...): centred dialog.
	Id contract (Estuary Omega): heading 2, control area grouplist 5, templates 7-15, scrollbar 60,
	buttons 28 / 29 / 30 in grouplist 9000 (Kodi labels/hides them). Keepsake ids: tabs 9101-9103.
-->
<window>
	<defaultcontrol>5</defaultcontrol>
	<onload>ClearProperty(keepsake.osdtab,home)</onload>
	<include condition="!$EXP[Dlg_IsOSDSettings]">Anim_DialogOpenClose</include>
	<controls>
		<include condition="!$EXP[Dlg_IsOSDSettings]">Dlg_SettingsCentred</include>
		<include condition="$EXP[Dlg_IsOSDSettings]">Dlg_SettingsPanel</include>
	</controls>
</window>
