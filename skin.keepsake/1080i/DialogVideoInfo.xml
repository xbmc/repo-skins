<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video information: an album spread (Includes_VideoInfo.xml, mockups/KeepsakeInfo.html).
	Kodi id contract (Estuary Omega DialogVideoInfo.xml + CGUIDialogVideoInfo): 8 play, 9 resume, 11 trailer,
	50 cast / films of a collection, 6 refresh, 7 user rating, 10 choose art, 12 choose fanart,
	13 director search, 14 versions, 15 extras; 443 collection (Estuary convention).
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<include>KS_Page</include>
		<!-- Skin Variables: when exactly you last watched it -->
		<control type="group">
			<visible>[String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode)]</visible>
			<control type="list" id="9175">
				<left>-40</left>
				<top>-40</top>
				<width>1</width>
				<height>1</height>
				<itemlayout width="1" height="1"/>
				<focusedlayout width="1" height="1"/>
				<content target="videos">$VAR[VidInfo_SVPath]</content>
			</control>
		</control>
		<include>VidInfo_LeftPage</include>
		<include>VidInfo_RightPage</include>
		<include>VidInfo_FullPlot</include>
	</controls>
</window>
