<?xml version="1.0" encoding="UTF-8"?>
<!--
	Now playing (music): the album as a big instant photo on the left page, stamped with today's date; the song in
	Fraunces, the artist in pen, your history with it, the time in LCD digits over a pen line, what's next.
	Kodi id contract (Estuary Omega MusicVisualisation.xml): 2 = visualisation control. Omar has a visualisation
	enabled, and it would draw over the page (LESSONS round 4): it stays hidden, the album is the picture, unless
	Visualiser mode is on ($EXP[Music_VizMode]: the music OSD's "visualiser" word, 0.9.7); then the page steps aside,
	the song is written at the foot and "ok for the presets" when the visualisation has presets.
	9900: a clear full-screen button so OK / Up / Down open the music OSD and Left / Right step (Kodi's
	Visualisation keymap does the same; JSON-RPC Select needs a focusable control). Back = the previous window.
-->
<window>
	<defaultcontrol always="true">9900</defaultcontrol>
	<backgroundcolor>paper</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>KS_Page</include>
		<control type="visualisation" id="2">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<visible>$EXP[Music_VizMode]</visible>
		</control>
		<control type="button" id="9900">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<texturefocus />
			<onclick>ActivateWindow(musicosd)</onclick>
			<onup>ActivateWindow(musicosd)</onup>
			<ondown>ActivateWindow(musicosd)</ondown>
			<onleft>StepBack</onleft>
			<onright>StepForward</onright>
		</control>

		<!-- the album page (hidden in Visualiser mode) -->
		<control type="group">
			<visible>!$EXP[Music_VizMode]</visible>
			<include>Anim_FadeVisible</include>
			<!-- left page: the album -->
			<control type="group">
				<left>196</left>
				<top>176</top>
				<width>504</width>
				<height>586</height>
				<include content="KS_TiltFixed"><param name="angle" value="1.5"/></include>
				<include content="KS_Print_InstantL">
					<param name="art" value="$INFO[Player.Art(thumb)]"/>
					<param name="title" value="$INFO[MusicPlayer.Album]"/>
					<param name="caption" value="$INFO[MusicPlayer.Album]"/>
					<param name="corners" value="false"/>
					<param name="lift" value="true"/>
					<param name="stamp" value="'$INFO[System.Date(yy)]~$INFO[System.Date(mm)]~$INFO[System.Date(dd)]"/>
					<param name="stamped" value="true"/>
				</include>
			</control>
			<control type="image">
				<left>338</left>
				<top>150</top>
				<width>250</width>
				<height>64</height>
				<texture colordiffuse="tape">ks/tape.png</texture>
				<animation effect="rotate" end="-3" center="auto" time="0" condition="true">Conditional</animation>
			</control>

			<!-- right page: the song -->
			<control type="label">
				<left>1068</left>
				<top>191</top>
				<width>700</width>
				<height>27</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$VAR[Music_NPKicker]</label>
			</control>
			<include content="KS_Clock"><param name="label" value="now"/></include>
			<control type="textbox">
				<left>1060</left>
				<top>222</top>
				<width>760</width>
				<height>160</height>
				<font>ttl_72</font>
				<textcolor>cream</textcolor>
				<label>$INFO[MusicPlayer.Title]</label>
			</control>
			<control type="label">
				<left>1064</left>
				<top>388</top>
				<width>760</width>
				<height>70</height>
				<font>hand_52</font>
				<textcolor>ink</textcolor>
				<label>$INFO[MusicPlayer.Artist,by ,]</label>
			</control>
			<control type="label">
				<left>1068</left>
				<top>465</top>
				<width>760</width>
				<height>27</height>
				<font>lbl_20</font>
				<textcolor>label_hi</textcolor>
				<label>$INFO[MusicPlayer.Album]$INFO[MusicPlayer.Year,  ·  ,]$INFO[MusicPlayer.TrackNumber,  ·  track ,]</label>
			</control>
			<control type="label">
				<left>1064</left>
				<top>504</top>
				<width>760</width>
				<height>56</height>
				<font>hand_40</font>
				<textcolor>ink2</textcolor>
				<label>$VAR[Music_NPHistory]</label>
			</control>
			<!-- time: elapsed in LCD over the pen line -->
			<include content="KS_LCD44">
				<param name="label" value="$INFO[Player.Time]"/>
				<param name="left" value="1064"/>
				<param name="top" value="586"/>
				<param name="width" value="500"/>
			</include>
			<include content="KS_PenProgress750">
				<param name="left" value="1064"/>
				<param name="top" value="664"/>
				<param name="info" value="Player.Progress"/>
			</include>
			<control type="label">
				<left>1066</left>
				<top>700</top>
				<width>740</width>
				<height>30</height>
				<align>right</align>
				<font>mono_22</font>
				<textcolor>label_hi</textcolor>
				<label>$INFO[Player.TimeRemaining,−,]$INFO[Player.Duration,  /  ,]</label>
			</control>
			<control type="label">
				<left>1066</left>
				<top>700</top>
				<width>400</width>
				<height>30</height>
				<font>lbl_20</font>
				<textcolor>stamp</textcolor>
				<label>$VAR[Music_PlayModes]</label>
			</control>
			<control type="label">
				<left>1064</left>
				<top>762</top>
				<width>760</width>
				<height>50</height>
				<font>hand_36</font>
				<textcolor>ink_faint</textcolor>
				<label>$INFO[MusicPlayer.offset(1).Title,next  ·  ,]$INFO[MusicPlayer.offset(1).Artist,  ·  ,]</label>
				<visible>MusicPlayer.HasNext</visible>
			</control>
			<control type="label">
				<left>1068</left>
				<top>824</top>
				<width>760</width>
				<height>27</height>
				<font>lbln_20</font>
				<textcolor>label</textcolor>
				<label>$INFO[MusicPlayer.Codec]$INFO[MusicPlayer.BitRate,  ·  , kbps]$INFO[MusicPlayer.SampleRate,  ·  , khz]$INFO[MusicPlayer.Genre,  ·  ,]</label>
			</control>
		</control>
		<control type="label">
			<left>112</left>
			<top>984</top>
			<width>1696</width>
			<height>48</height>
			<align>center</align>
			<font>hand_34</font>
			<textcolor>ink_ghost</textcolor>
			<label>$LOCALIZE[31391]</label>
			<visible>!Window.IsVisible(musicosd) + !$EXP[Music_VizMode]</visible>
		</control>
		<!-- Visualiser mode: the song in pen over a shade at the foot, and the keys (ok for the presets when it has them) -->
		<control type="group">
			<visible>$EXP[Music_VizMode] + !Window.IsVisible(musicosd)</visible>
			<include>Anim_FadeVisible</include>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>260</height>
				<texture colordiffuse="shade">common/gradient_bottom.png</texture>
			</control>
			<control type="label">
				<left>112</left>
				<top>918</top>
				<width>1696</width>
				<height>56</height>
				<font>hand_46</font>
				<textcolor>ink</textcolor>
				<label>$INFO[MusicPlayer.Title]$INFO[MusicPlayer.Artist,  ·  by ,]</label>
			</control>
			<control type="label">
				<left>112</left>
				<top>984</top>
				<width>1696</width>
				<height>48</height>
				<font>hand_34</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[31478]</label>
				<visible>Visualisation.HasPresets</visible>
			</control>
			<control type="label">
				<left>112</left>
				<top>984</top>
				<width>1696</width>
				<height>48</height>
				<font>hand_34</font>
				<textcolor>ink2</textcolor>
				<label>$LOCALIZE[31391]</label>
				<visible>!Visualisation.HasPresets</visible>
			</control>
		</control>
	</controls>
</window>
