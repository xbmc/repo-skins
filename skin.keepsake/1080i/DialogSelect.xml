<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogSelect (M4, Builder E). Generic select: skin chooser (Settings > Interface > Skin),
	add-on choices, video versions/extras, and - on Omega, which has no dedicated audio/subtitle
	select windows - the audio / subtitle STREAM lists opened from the OSD settings.
	  · over fullscreen video: right-hand 720px track picker (mockups/Tracks.dc.html)
	  · otherwise: centred Index dialog
	Include conditions are re-evaluated each time the dialog opens (Kodi reloads the window when
	they change), so one window serves both looks.
	Id contract (Estuary Omega Includes_DialogSelect.xml): heading 1, list 3 (simple) / 6 (detailed),
	scrollbar 61, buttons 5 / 8 (extra, Kodi shows when used) / 7 (cancel) in grouplist 9001.
	Keepsake ids (panel only): grouplist 9100, 9101 download subtitles, 9102 subtitle settings.
	Game save / filter layouts (Estuary game windows) fall back to the centred list.
-->
<window>
	<defaultcontrol always="true">3</defaultcontrol>
	<include condition="!$EXP[Dlg_IsTrackPanel]">Anim_DialogOpenClose</include>
	<controls>
		<include condition="!$EXP[Dlg_IsTrackPanel]">Dlg_SelectCentred</include>
		<include condition="$EXP[Dlg_IsTrackPanel]">Dlg_SelectPanel</include>
	</controls>
</window>
