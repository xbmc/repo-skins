<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings hub (window "settings") - M4, Builder E. Numbered Index list (hairline rows, mono index,
	mono hint) + a right-hand column with what the focused entry holds and a few system facts.
	No Kodi-owned ids; entries/actions copied from Estuary Omega Settings.xml, Keepsake's Skin settings
	first. File manager / System info / Event log / Profiles windows come from Builder F.
-->
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>paper</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>KS_Background</include>
		<include content="KS_TopBar">
			<param name="index" value="SYS"/>
			<param name="title" value="$LOCALIZE[5]"/>
		</include>

		<control type="list" id="9000">
			<left>page_margin</left>
			<top>content_top</top>
			<width>860</width>
			<height>864</height>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="Dlg_IndexListLayout">
				<param name="width" value="860"/>
				<param name="height" value="72"/>
				<param name="list_id" value="9000"/>
			</include>
			<content>
				<item>
					<label>$LOCALIZE[31021]</label>
					<label2>$LOCALIZE[31024]</label2>
					<property name="index">[UPPERCASE]01[/UPPERCASE]</property>
					<property name="help">Keepsake's own six: the date stamp, straight or hand-placed prints, the time of day, the trailer word, motion and when the playback words hide.</property>
					<onclick>ActivateWindow(skinsettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14200]</label>
					<label2>$LOCALIZE[31398]</label2>
					<property name="index">[UPPERCASE]02[/UPPERCASE]</property>
					<property name="help">Video and music playback, refresh-rate matching, subtitle languages and look, discs.</property>
					<onclick>ActivateWindow(PlayerSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14211]</label>
					<label2>$LOCALIZE[31399]</label2>
					<property name="index">[UPPERCASE]03[/UPPERCASE]</property>
					<property name="help">Library behaviour, scrapers, file lists, artwork and what OK does on an item.</property>
					<onclick>ActivateWindow(MediaSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14206]</label>
					<label2>$LOCALIZE[31400]</label2>
					<property name="index">[UPPERCASE]04[/UPPERCASE]</property>
					<property name="help">Skin, colours, fonts, region and language, screensaver. Switch to another skin here: Skin > Skin.</property>
					<onclick>ActivateWindow(InterfaceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[24001]</label>
					<label2>$LOCALIZE[31401]</label2>
					<property name="index">[UPPERCASE]05[/UPPERCASE]</property>
					<property name="help">Browse, update, configure or install add-ons.</property>
					<onclick>ActivateWindow(addonbrowser)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14036]</label>
					<label2>$LOCALIZE[31402]</label2>
					<property name="index">[UPPERCASE]06[/UPPERCASE]</property>
					<property name="help">Web server and JSON-RPC control, UPnP, AirPlay, Zeroconf, SMB client.</property>
					<onclick>ActivateWindow(ServiceSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13000]</label>
					<label2>$LOCALIZE[31403]</label2>
					<property name="index">[UPPERCASE]07[/UPPERCASE]</property>
					<property name="help">Display, audio output and passthrough, input, power saving, logging.</property>
					<onclick>ActivateWindow(SystemSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[10003]</label>
					<label2>$LOCALIZE[31404]</label2>
					<property name="index">[UPPERCASE]08[/UPPERCASE]</property>
					<property name="help">Copy, move and delete files; add network sources.</property>
					<onclick>ActivateWindow(filemanager)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[138]</label>
					<label2>$LOCALIZE[31405]</label2>
					<property name="index">[UPPERCASE]09[/UPPERCASE]</property>
					<property name="help">Kodi version, video renderer, storage, network and hardware details.</property>
					<onclick>ActivateWindow(systeminfo)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[31406]</label>
					<label2>$LOCALIZE[31407]</label2>
					<property name="index">[UPPERCASE]10[/UPPERCASE]</property>
					<property name="help">What Kodi has done recently: scans, add-on updates, errors.</property>
					<onclick>ActivateWindow(eventlog)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[13200]</label>
					<label2>$LOCALIZE[31408]</label2>
					<property name="index">[UPPERCASE]11[/UPPERCASE]</property>
					<property name="help">Profiles and the login screen.</property>
					<onclick>ActivateWindow(Profiles)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[14204]</label>
					<label2>$LOCALIZE[31409]</label2>
					<property name="index">[UPPERCASE]12[/UPPERCASE]</property>
					<property name="help">Live TV and PVR. Keepsake only gives these screens a plain layout.</property>
					<onclick>ActivateWindow(PVRSettings)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[15016]</label>
					<label2>$LOCALIZE[31410]</label2>
					<property name="index">[UPPERCASE]13[/UPPERCASE]</property>
					<property name="help">Games and controllers.</property>
					<onclick>ActivateWindow(GameSettings)</onclick>
					<visible>System.GetBool(gamesgeneral.enable)</visible>
				</item>
			</content>
		</control>

		<!-- ====== right column -->
		<control type="group">
			<left>1040</left>
			<top>content_top</top>
			<width>784</width>
			<control type="label">
				<left>0</left>
				<top>0</top>
				<width>784</width>
				<height>20</height>
				<font>lbl_20</font>
				<label>$INFO[Container(9000).ListItem.Property(index),,  ·  ]$INFO[Container(9000).ListItem.Label]</label>
			</control>
			<include content="KS_Rule">
				<param name="top" value="32"/>
				<param name="left" value="0"/>
				<param name="width" value="784"/>
			</include>
			<control type="textbox">
				<left>0</left>
				<top>52</top>
				<width>620</width>
				<height>117</height>  <!-- 4 lines exactly: no half-clipped line at the bottom -->
				<font>body_24</font>
				<textcolor>ink2</textcolor>
				<label>$INFO[Container(9000).ListItem.Property(help)]</label>
			</control>
			<!-- system facts: definition list, mono labels -->
			<control type="group">
				<top>560</top>
				<include content="KS_Rule">
					<param name="top" value="0"/>
					<param name="left" value="0"/>
					<param name="width" value="784"/>
				</include>
				<include content="Dlg_FactRow"><param name="top" value="16"/><param name="label" value="Kodi"/><param name="value" value="$INFO[System.BuildVersion]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="56"/><param name="label" value="Skin"/><param name="value" value="Keepsake $INFO[System.AddonVersion(skin.keepsake)]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="96"/><param name="label" value="Address"/><param name="value" value="$INFO[Network.IPAddress]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="136"/><param name="label" value="Screen"/><param name="value" value="$INFO[System.ScreenResolution]"/></include>
				<include content="Dlg_FactRow"><param name="top" value="176"/><param name="label" value="Up"/><param name="value" value="$INFO[System.Uptime]"/></include>
			</control>
		</control>
	</controls>
</window>
