<?xml version="1.0" encoding="UTF-8"?>
<!--
	Fullscreen info (Info during playback): the playing film as a print on the strip, its title, a handwritten
	line about your history with it, the plot, what comes next and the pen progress line.
	Id contract (Estuary Omega DialogFullScreenInfo.xml): 999 = full-screen invisible focus button (default,
	always): Left/Right step seek, Up/Down chapter or big step, OK opens the OSD. Info again or Back closes it.
-->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<label></label>
			<texturefocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>

		<control type="group">
			<visible>!Window.IsVisible(sliderdialog) + !Window.IsVisible(selectdialog) + !Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(osdvideosettings)</visible>
			<include content="OSD_Scrims">
				<param name="bottom_h" value="780"/>
				<param name="top_h" value="260"/>
			</include>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>1920</width>
				<height>640</height>
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="shade">common/scrim_bottom.png</texture>
			</control>
			<include content="OSD_TopLine"/>

			<!-- the print (poster, 240 x 360) -->
			<control type="group">
				<left>116</left>
				<top>488</top>
				<width>264</width>
				<height>384</height>
				<visible>!String.IsEmpty(Player.Art(poster)) | !String.IsEmpty(Player.Art(tvshow.poster))</visible>
				<include content="KS_TiltFixed"><param name="angle" value="1.6"/></include>
				<include content="KS_Print_FSPoster">
					<param name="art" value="$VAR[OSDInfo_Poster]"/>
					<param name="lift" value="true"/>
					<param name="title" value="$VAR[OSD_Title]"/>
					<param name="stamp" value="$VAR[KS_VP_Stamp]"/>
					<param name="stamped" value="Integer.IsGreater(VideoPlayer.PlayCount,0) + !String.IsEmpty(VideoPlayer.LastPlayed)"/>
				</include>
			</control>
			<control type="group">
				<animation effect="slide" end="320,0" time="0" condition="!String.IsEmpty(Player.Art(poster)) | !String.IsEmpty(Player.Art(tvshow.poster))">Conditional</animation>
				<control type="label">
					<left>114</left>
					<top>497</top>
					<width>1300</width>
					<height>27</height>
					<font>lbl_20</font>
					<textcolor>label_hi</textcolor>
					<label>$VAR[OSD_Meta]</label>
				</control>
				<control type="label">
					<left>108</left>
					<top>522</top>
					<width>1240</width>
					<height>84</height>
					<font>ttl_64</font>
					<textcolor>cream</textcolor>
					<label>$VAR[OSD_Title]</label>
				</control>
				<control type="label">
					<left>112</left>
					<top>604</top>
					<width>1240</width>
					<height>60</height>
					<font>hand_44</font>
					<textcolor>ink</textcolor>
					<label>$VAR[FSInfo_History]</label>
				</control>
				<control type="textbox">
					<left>114</left>
					<top>676</top>
					<width>1150</width>
					<height>122</height>
					<font>body_26</font>
					<label>$INFO[VideoPlayer.Plot]</label>
					<autoscroll delay="7000" time="3000" repeat="10000">true</autoscroll>
				</control>
				<control type="label">
					<left>114</left>
					<top>818</top>
					<width>1150</width>
					<height>27</height>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>next  ·  [COLOR ink_bold]$VAR[OSD_NextLabel][/COLOR]</label>
					<visible>$EXP[OSD_HasNext]</visible>
				</control>
			</control>
			<include content="OSD_ProgressBlock"><param name="top" value="896"/></include>
			<control type="label">
				<left>112</left>
				<top>984</top>
				<width>1696</width>
				<height>48</height>
				<font>hand_34</font>
				<textcolor>ink_faint</textcolor>
				<label>$LOCALIZE[31315]</label>
			</control>
		</control>
	</controls>
</window>
