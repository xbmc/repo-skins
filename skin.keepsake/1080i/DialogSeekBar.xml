<?xml version="1.0" encoding="UTF-8"?>
<!--
	Seek bar (M3, Builder D). Mockup: docs/skin.keepsake/mockups/Seek.dc.html.
	Minimal bar over the playing picture: title + "ENDS 22:58 · 21:47", 3px track with buffer,
	played part, chapter ticks, playhead, a time bubble at the playhead, start/total times, and a
	top-right "+30s SKIP" tab while skipping.

	Id contract (Estuary Omega DialogSeekBar.xml / GUIDialogSeekBar.cpp): 401 = progress slider Kodi
	selects to the seek target (POPUP_SEEK_PROGRESS); 402/403 are PVR only (PVR unused, omitted).
	Window visibility conditions copied from Estuary Omega. The content steps aside while the OSD,
	the fullscreen info or a playback dialog is up (they draw their own progress): OSD_SeekBarHidden.
-->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>  <!-- Now playing (visualisation) draws its own progress; no seek bar on top of it -->
	<visible>![Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(pvrguideinfo)]</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric)</visible>
	<zorder>0</zorder>
	<include>Anim_Toast</include>
	<controls>
		<control type="group">
			<visible>!$EXP[OSD_SeekBarHidden]</visible>
			<visible>!Player.HasGame</visible>
			<include>Anim_FadeVisible</include>

			<!-- one bottom scrim (none when the music OSD, which has its own, is open) -->
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>screen_w</width>
				<height>300</height>
				<!-- own fades: a translucent image without them is drawn over the window content on Shield (QA 2026-10-18) -->
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
				<texture colordiffuse="shade">common/gradient_bottom.png</texture>
				<visible>!Window.IsVisible(musicosd)</visible>
			</control>

			<!-- ====== skip feedback, top right -->
			<control type="grouplist">
				<right>page_margin</right>
				<top>64</top>
				<width>600</width>
				<height>54</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<usecontrolcoords>true</usecontrolcoords>
				<visible>[!String.IsEmpty(Player.SeekStepSize) | [!String.IsEmpty(Player.SeekOffset) + Player.HasPerformedSeek(3)]] + Window.IsActive(fullscreenvideo)</visible>
				<include>Anim_FadeVisible</include>
				<control type="button">
					<description>tab: "+30s" (accent) + "SKIP"; one auto-width disabled button so the tab hugs the text</description>
					<width>auto</width>
					<height>54</height>
					<font>mono_26</font>
					<textcolor>ink_bold</textcolor>
					<disabledcolor>ink_bold</disabledcolor>
					<textoffsetx>18</textoffsetx>
					<texturefocus border="12" colordiffuse="shade_tab">ks/print.png</texturefocus>
					<texturenofocus border="12" colordiffuse="shade_tab">ks/print.png</texturenofocus>
					<label>$VAR[OSD_SkipValue]</label>
					<enable>false</enable>
				</control>
				<control type="button">
					<width>auto</width>
					<height>54</height>
					<font>lbl_20</font>
					<disabledcolor>ink2</disabledcolor>
					<textoffsetx>14</textoffsetx>
					<texturefocus border="12" colordiffuse="shade_tab">ks/print.png</texturefocus>
					<texturenofocus border="12" colordiffuse="shade_tab">ks/print.png</texturenofocus>
					<label>$LOCALIZE[31327]</label>
					<enable>false</enable>
				</control>
			</control>

			<!-- ====== title row: Fraunces title left, "ends" in LCD digits right -->
			<control type="label">
				<left>110</left>
				<top>900</top>
				<width>1200</width>
				<height>48</height>
				<font>ttt_34</font>
				<textcolor>cream</textcolor>
				<label>$VAR[OSD_ShortTitle]</label>
			</control>
			<control type="group">
				<visible>Player.HasVideo + !String.IsEmpty(Player.FinishTime)</visible>
				<control type="label">
					<left>1208</left>
					<top>915</top>
					<width>420</width>
					<height>27</height>
					<align>right</align>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$LOCALIZE[31328]</label>
				</control>
				<control type="label">
					<left>1768</left>
					<top>915</top>
					<width>60</width>
					<height>27</height>
					<font>lbl_20</font>
					<textcolor>stamp</textcolor>
					<label>$VAR[OSD_EndsAMPM]</label>
				</control>
				<include content="KS_LCD30">
					<param name="label" value="$INFO[Player.FinishTime]"/>
					<param name="left" value="1560"/>
					<param name="top" value="904"/>
					<param name="width" value="200"/>
					<param name="align" value="right"/>
				</include>
			</control>

			<!-- ====== the pen line -->
			<include content="OSD_Track"><param name="top" value="960"/></include>
			<!-- Kodi selects 401 to the seek target; drawn invisible (OSD_Track shows the same value) -->
			<control type="slider" id="401">
				<left>112</left>
				<top>966</top>
				<width>1696</width>
				<height>16</height>
				<texturesliderbar>osd/slider_bg.png</texturesliderbar>
				<textureslidernib colordiffuse="clear">osd/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="clear">osd/slider_nib.png</textureslidernibfocus>
			</control>
			<include content="OSD_SeekBubble">
				<param name="top" value="908"/>
				<param name="visible" value="Player.SeekEnabled + [$EXP[OSD_SeekActive] | Player.Forwarding | Player.Rewinding]"/>
			</include>
			<control type="label">
				<left>114</left>
				<top>996</top>
				<width>500</width>
				<height>30</height>
				<font>mono_22</font>
				<label>$INFO[Player.Time]</label>
			</control>
			<control type="label">
				<left>1208</left>
				<top>996</top>
				<width>600</width>
				<height>30</height>
				<align>right</align>
				<font>mono_22</font>
				<textcolor>label_hi</textcolor>
				<label>$INFO[Player.TimeRemaining,−,]$INFO[Player.Duration,  /  ,]</label>
			</control>
			<control type="label">
				<left>460</left>
				<top>992</top>
				<width>1000</width>
				<height>48</height>
				<align>center</align>
				<font>hand_36</font>
				<textcolor>ink</textcolor>
				<label>[LOWERCASE]$VAR[OSD_State][/LOWERCASE]</label>
				<visible>!$EXP[OSD_SeekActive] + [Player.Paused | Player.Forwarding | Player.Rewinding | Player.Caching]</visible>
			</control>
		</control>
	</controls>
</window>
