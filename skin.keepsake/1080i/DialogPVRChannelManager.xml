<?xml version="1.0" encoding="UTF-8"?>
<!--
	PVR channel manager (SPEC 5: Minimal, KS_GenericDialog). Builder F, M4.
	Kodi id contract (Estuary Omega DialogPVRChannelManager.xml): heading 2, channel list 20 +
	scrollbar 60; channel options in grouplist 9002: 7 active (radio), 8 name (edit), 9 logo,
	12 EPG active (radio), 13 EPG source (spin), 14 parental lock (radio); misc in grouplist 9003:
	35 refresh logos, 31 new channel, 30 group manager, 34 TV/radio toggle; buttons 4 OK, 5 apply,
	6 cancel in grouplist 9000. Item properties: Number, Name, icon, ActiveChannel, Changed,
	ParentalLocked, ClientName.
-->
<window>
	<defaultcontrol always="true">4</defaultcontrol>
	<include>Anim_DialogOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>1760</width>
			<height>960</height>
			<include content="KS_GenericDialog">
				<param name="width" value="1760"/>
				<param name="height" value="960"/>
				<param name="header_id" value="2"/>
				<param name="header_label" value="$LOCALIZE[19199]$INFO[Container(20).NumItems,  ·  ,]"/>
			</include>
			<!-- ====== channels -->
			<control type="list" id="20">
				<left>dialog_inset</left>
				<top>dialog_content_top</top>
				<width>640</width>
				<height>768</height>
				<onup>20</onup>
				<ondown>20</ondown>
				<onleft>9000</onleft>
				<onright>9002</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<itemlayout width="640" height="dialog_row_h">
					<control type="label">
						<left>list_text_x</left>
						<top>0</top>
						<width>480</width>
						<height>dialog_row_h</height>
						<font>ttt_26</font>
						<textcolor>ink2</textcolor>
						<label>$INFO[ListItem.Property(Number),,  ]$INFO[ListItem.Property(Name)]</label>
						<visible>ListItem.Property(ActiveChannel)</visible>
					</control>
					<control type="label">
						<left>list_text_x</left>
						<top>0</top>
						<width>480</width>
						<height>dialog_row_h</height>
						<font>ttt_26</font>
						<textcolor>disabled</textcolor>
						<label>$INFO[ListItem.Property(Number),,  ]$INFO[ListItem.Property(Name)]</label>
						<visible>!ListItem.Property(ActiveChannel)</visible>
					</control>
					<control type="label">
						<right>list_text_x</right>
						<top>0</top>
						<width>120</width>
						<height>dialog_row_h</height>
						<align>right</align>
						<font>lbl_20</font>
						<label>$VAR[Misc_ChannelMgrFlags]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>640</width>
						<height>rule_h</height>
						<texture colordiffuse="rule">common/hairline.png</texture>
					</control>
				</itemlayout>
				<focusedlayout width="640" height="dialog_row_h">
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>640</width>
						<height>dialog_row_h</height>
						<texture colordiffuse="paper_raised">common/white.png</texture>
						<visible>Control.HasFocus(20)</visible>
					</control>
					<control type="image">
						<left>0</left>
						<top>0</top>
						<width>list_bar_w</width>
						<height>dialog_row_h</height>
						<texture colordiffuse="ink_bold">common/white.png</texture>
					</control>
					<control type="label">
						<left>list_text_x</left>
						<top>0</top>
						<width>480</width>
						<height>dialog_row_h</height>
						<font>ttt_26</font>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Property(Number),,  ]$INFO[ListItem.Property(Name)]</label>
					</control>
					<control type="label">
						<right>list_text_x</right>
						<top>0</top>
						<width>120</width>
						<height>dialog_row_h</height>
						<align>right</align>
						<font>lbl_20</font>
						<label>$VAR[Misc_ChannelMgrFlags]</label>
					</control>
					<control type="image">
						<left>0</left>
						<bottom>0</bottom>
						<width>640</width>
						<height>rule_h</height>
						<texture colordiffuse="rule">common/hairline.png</texture>
					</control>
				</focusedlayout>
			</control>
			<include content="KS_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="676"/>
				<param name="top" value="dialog_content_top"/>
				<param name="height" value="768"/>
				<param name="onleft" value="20"/>
				<param name="onright" value="9002"/>
			</include>
			<control type="label">
				<left>dialog_inset</left>
				<top>892</top>
				<width>640</width>
				<height>40</height>
				<font>lbl_20</font>
				<textcolor>label</textcolor>
				<label>$INFO[Container(20).ListItem.Property(ClientName),$LOCALIZE[19210]  ,]</label>
			</control>
			<!-- ====== channel options -->
			<include content="Misc_Caption">
				<param name="left" value="720"/>
				<param name="top" value="dialog_content_top"/>
				<param name="width" value="620"/>
				<param name="label" value="Channel"/>
			</include>
			<control type="grouplist" id="9002">
				<left>720</left>
				<top>152</top>
				<width>620</width>
				<height>384</height>
				<orientation>vertical</orientation>
				<onleft>20</onleft>
				<onright>9000</onright>
				<onup>34</onup>
				<ondown>35</ondown>
				<control type="radiobutton" id="7">
					<description>Channel activated</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19074]</label>
				</control>
				<control type="edit" id="8">
					<description>Channel name</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19201]</label>
				</control>
				<control type="button" id="9">
					<description>Channel logo</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19202]</label>
				</control>
				<control type="radiobutton" id="12">
					<description>EPG activated</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19206]</label>
				</control>
				<control type="spincontrolex" id="13">
					<description>EPG source</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19200]</label>
				</control>
				<control type="radiobutton" id="14">
					<description>Parental locked</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19267]</label>
				</control>
			</control>
			<control type="image">
				<left>720</left>
				<top>548</top>
				<width>160</width>
				<height>64</height>
				<aspectratio align="left">keep</aspectratio>
				<texture background="true">$INFO[Container(20).ListItem.Property(icon)]</texture>
			</control>
			<!-- ====== misc -->
			<include content="Misc_Caption">
				<param name="left" value="720"/>
				<param name="top" value="628"/>
				<param name="width" value="620"/>
				<param name="label" value="Other"/>
			</include>
			<control type="grouplist" id="9003">
				<left>720</left>
				<top>668</top>
				<width>620</width>
				<height>256</height>
				<orientation>vertical</orientation>
				<onleft>20</onleft>
				<onright>9000</onright>
				<onup>14</onup>
				<ondown>7</ondown>
				<control type="button" id="35">
					<description>Refresh channel logos</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19041]</label>
				</control>
				<control type="button" id="31">
					<description>New channel</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19204]</label>
				</control>
				<control type="button" id="30">
					<description>Group manager</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19205]</label>
				</control>
				<control type="togglebutton" id="34">
					<description>TV / radio toggle</description>
					<include content="Misc_RowLook"><param name="width" value="620"/></include>
					<label>$LOCALIZE[19024]</label>
					<altlabel>$LOCALIZE[19023]</altlabel>
					<usealttexture>!String.IsEmpty(Window.Property(IsRadio))</usealttexture>
				</control>
			</control>
			<!-- ====== buttons -->
			<control type="grouplist" id="9000">
				<left>1400</left>
				<top>dialog_content_top</top>
				<width>320</width>
				<height>400</height>
				<orientation>vertical</orientation>
				<itemgap>12</itemgap>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft condition="Integer.IsGreater(Container(20).NumItems,0)">9002</onleft>
				<onleft condition="Integer.IsEqual(Container(20).NumItems,0)">9003</onleft>
				<onright>20</onright>
				<include content="KS_DialogButton">
					<param name="id" value="4"/>
					<param name="width" value="320"/>
					<param name="label" value="$LOCALIZE[186]"/>
				</include>
				<include content="KS_DialogButton">
					<param name="id" value="5"/>
					<param name="width" value="320"/>
					<param name="label" value="$LOCALIZE[14070]"/>
				</include>
				<include content="KS_DialogButton">
					<param name="id" value="6"/>
					<param name="width" value="320"/>
					<param name="label" value="$LOCALIZE[222]"/>
				</include>
			</control>
		</control>
	</controls>
</window>
