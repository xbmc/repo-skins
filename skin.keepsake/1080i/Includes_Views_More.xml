<?xml version="1.0" encoding="UTF-8"?>
<!--
	More views (docs/VIEWS_BRIEF_2026-10-27.md), pasted into the album.

	Video (MyVideoNav):
	  525 a page      one spread per item: the big print (fanart, or the still for episodes) taped on the left page with
	                  the poster tucked under it, the title, meta, the plot and a handwritten line on the right page; the
	                  rest of the shelf waits in a strip of small prints along the bottom (horizontal list 525).
	                  Library video and add-on listings.
	  526 postcards   wide prints (fanart / landscape / episode stills) four across the spread, the name written under each;
	                  posters and icons are printed whole on the card, never cropped. Every content type.
	Music (MyMusicNav):
	  532 album pages the album's cover as a big print, its title, artist and year and the tracks written out on the right
	                  page (hidden list 5321 over musicdb://albums/<id>/); artists get their fanart (or photo) and their
	                  story. A strip of instant prints along the bottom (horizontal list 532).
	0.9.15 (docs/VIEWS_PER_SECTION_2026-10-28.md): 527 a contact sheet (films, sets, series, seasons, music videos,
	genres / years / people), 533 a mixtape (songs), 532 also for songs, 524 (Includes_Views_Video.xml) also for films / series.
	viewtypes bigwrap / bigwide / biglist / wide are never a node's default type (Kodi defaults: list, icon, big icon, info, big
	info, auto = info / list), so the view a node opens in by default is unchanged.
-->
<includes>
	<!-- ================================================================ shared -->
	<expression name="KSV_HasWide">[String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))] | !String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(tvshow.fanart)) | !String.IsEmpty(ListItem.Art(landscape))</expression>
	<expression name="KSV_HasPoster">!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | [String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(season.poster))]</expression>
	<expression name="KSV_HasMat">!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | !String.IsEmpty(ListItem.Art(thumb))</expression>
	<expression name="KSV_IsNode">Container.Content(genres) | Container.Content(years) | Container.Content(actors) | Container.Content(directors) | Container.Content(studios) | Container.Content(countries) | Container.Content(tags)</expression>
	<expression name="KSV_IsFilmsTV">Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(musicvideos)</expression>
	<expression name="KSV_ShowSheet">Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(musicvideos) | Container.Content(seasons) | Container.Content(genres) | Container.Content(years) | Container.Content(actors) | Container.Content(directors) | Container.Content(studios) | Container.Content(countries) | Container.Content(tags)</expression>
	<expression name="KSV_ShowPage">$EXP[VidView_IsLibraryVideo] | !String.IsEmpty(Container.PluginName)</expression>
	<variable name="KSV_WideArt">
		<value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Art(tvshow.fanart)]</value>
	</variable>
	<!-- printed whole on the card when there is no wide picture -->
	<variable name="KSV_MatArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- the title written on an empty print: only when nothing else is printed there -->
	<variable name="KSV_MatTitle">
		<value condition="$EXP[KSV_HasMat]"></value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="KSV_Dim">
		<value condition="Control.HasFocus(525) | Control.HasFocus(526) | Control.HasFocus(527) | Control.HasFocus(532)">dim_print</value>
		<value>white</value>
	</variable>
	<!-- a wide print: the picture (scale) or the poster / icon whole (keep). params: kind, lift, dim -->
	<include name="KSV_WidePrint">
		<param name="lift">false</param>
		<param name="dim">white</param>
		<definition>
			<control type="group">
				<visible>$EXP[KSV_HasWide]</visible>
				<include content="KS_Print_$PARAM[kind]">
					<param name="art" value="$VAR[KSV_WideArt]"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
					<param name="stamped" value="!String.IsEmpty(ListItem.LastPlayed) + Integer.IsGreater(ListItem.PlayCount,0)"/>
					<param name="title" value="$INFO[ListItem.Label]"/>
				</include>
			</control>
			<control type="group">
				<visible>!$EXP[KSV_HasWide]</visible>
				<include content="KS_Print_$PARAM[kind]">
					<param name="art" value="$VAR[KSV_MatArt]"/>
					<param name="aspect" value="keep"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="title" value="$VAR[KSV_MatTitle]"/>
				</include>
			</control>
		</definition>
	</include>
	<!-- the ".." print: the word "back" in pen -->
	<include name="KSV_BackWord">
		<control type="label">
			<left>$PARAM[left]</left>
			<top>$PARAM[top]</top>
			<width>$PARAM[width]</width>
			<height>$PARAM[height]</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>hand_46</font>
			<textcolor>ink_faint</textcolor>
			<selectedcolor>ink_faint</selectedcolor>
			<label>$LOCALIZE[31384]</label>
			<visible>ListItem.IsParentFolder</visible>
		</control>
	</include>

	<!-- ================================================================ 525 a page -->
	<!-- strip items: Search prints (150 x 225 -> 170 x 245) at pitch 200, Stop prints for episodes (300 x 169 -> 328 x 197)
	     at pitch 360. params: focused, lift, dim -->
	<include name="KSV_StripPoster">
		<include content="KSV_BackWord">
			<param name="left" value="15"/><param name="top" value="22"/><param name="width" value="170"/><param name="height" value="245"/>
		</include>
		<control type="group">
			<left>15</left>
			<top>22</top>
			<width>170</width>
			<height>245</height>
			<visible>!ListItem.IsParentFolder</visible>
			<include>KS_TiltItem</include>
			<control type="group">
				<width>170</width>
				<height>245</height>
				<include content="KS_TiltFocus" condition="$PARAM[focused]"><param name="focus" value="$PARAM[lift]"/></include>
				<include content="KS_Print_Search">
					<param name="art" value="$VAR[KS_PosterArt]"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="title" value="$INFO[ListItem.Label]"/>
				</include>
			</control>
		</control>
	</include>
	<include name="KSV_StripStill">
		<include content="KSV_BackWord">
			<param name="left" value="16"/><param name="top" value="46"/><param name="width" value="328"/><param name="height" value="197"/>
		</include>
		<control type="group">
			<left>16</left>
			<top>46</top>
			<width>328</width>
			<height>197</height>
			<visible>!ListItem.IsParentFolder</visible>
			<include>KS_TiltItem</include>
			<control type="group">
				<width>328</width>
				<height>197</height>
				<include content="KS_TiltFocus" condition="$PARAM[focused]"><param name="focus" value="$PARAM[lift]"/></include>
				<include content="KSV_WidePrint">
					<param name="kind" value="Stop"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
				</include>
			</control>
		</control>
	</include>
	<include name="VidView_525_Page">
		<control type="group">
			<visible>Control.IsVisible(525)</visible>
			<include>Anim_VisibleFade</include>
			<!-- left page: the big print and the poster tucked under it -->
			<control type="group">
				<visible>!ListItem.IsParentFolder + Integer.IsGreater(Container.NumItems,0)</visible>
				<control type="group">
					<left>124</left>
					<top>226</top>
					<width>728</width>
					<height>422</height>
					<include content="KS_TiltFixed"><param name="angle" value="1.4"/></include>
					<include content="KSV_WidePrint">
						<param name="kind" value="InfoBig"/>
						<param name="lift" value="true"/>
					</include>
				</control>
				<control type="group">
					<left>650</left>
					<top>470</top>
					<width>224</width>
					<height>309</height>
					<visible>$EXP[KSV_HasPoster] + $EXP[KSV_HasWide]</visible>
					<include content="KS_TiltFixed"><param name="angle" value="-3.4"/></include>
					<include content="KS_Print_InfoPoster">
						<param name="art" value="$VAR[VidInfo_Poster]"/>
						<param name="title" value="$INFO[ListItem.Label]"/>
					</include>
				</control>
			</control>
			<!-- right page: title (Fraunces 104 one line, else 72 on two), meta, plot, the handwritten line -->
			<control type="group">
				<visible>!ListItem.IsParentFolder + Integer.IsGreater(Container.NumItems,0)</visible>
				<control type="label">
					<left>1064</left>
					<top>214</top>
					<width>740</width>
					<height>27</height>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[ListItem.Genre]</label>
				</control>
				<control type="textbox" id="5251">
					<left>1060</left>
					<top>238</top>
					<width>750</width>
					<height>190</height>
					<font>ttl_104</font>
					<textcolor>clear</textcolor>
					<label>$VAR[VidInfo_Title]</label>
				</control>
				<control type="label">
					<left>1060</left>
					<top>238</top>
					<width>760</width>
					<height>130</height>
					<font>ttl_104</font>
					<textcolor>cream</textcolor>
					<label>$VAR[VidInfo_Title]</label>
					<visible>!Integer.IsGreater(Container(5251).NumPages,1)</visible>
				</control>
				<control type="textbox">
					<left>1062</left>
					<top>226</top>
					<width>750</width>
					<height>166</height>
					<font>ttl_72</font>
					<textcolor>cream</textcolor>
					<label>$VAR[VidInfo_Title]</label>
					<visible>Integer.IsGreater(Container(5251).NumPages,1)</visible>
				</control>
				<control type="label">
					<left>1066</left>
					<top>392</top>
					<width>750</width>
					<height>32</height>
					<font>lbln_24</font>
					<textcolor>meta</textcolor>
					<label>$VAR[VidInfo_Meta]</label>
				</control>
				<control type="textbox" id="5252">
					<left>1066</left>
					<top>444</top>
					<width>745</width>
					<height>164</height>
					<font>body_28</font>
					<textcolor>body</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<autoscroll delay="9000" time="3000" repeat="10000">true</autoscroll>
				</control>
				<!-- a plot cut by the box ends with "…" just past the column on its last line (Kodi can't add one to a
				     textbox) until the box starts to scroll (9 s at rest, LESSONS Cue 0.9.1) -->
				<control type="label">
					<left>1813</left>
					<top>566</top>
					<width>48</width>
					<height>41</height>
					<font>body_28</font>
					<textcolor>body</textcolor>
					<label>…</label>
					<visible>Integer.IsGreater(Container(5252).NumPages,1) + Integer.IsEqual(Container(5252).CurrentPage,1) + !System.IdleTime(9)</visible>
				</control>
				<control type="textbox">
					<left>1064</left>
					<top>632</top>
					<width>740</width>
					<height>120</height>
					<font>hand_46</font>
					<textcolor>ink</textcolor>
					<label>$VAR[VidInfo_Sentence]</label>
				</control>
			</control>
			<!-- the strip -->
			<control type="list" id="525">
				<left>52</left>
				<top>782</top>
				<width>1812</width>
				<height>298</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">260</scrolltime>
				<preloaditems>2</preloaditems>
				<onup>9310</onup>
				<ondown>noop</ondown>
				<include>Lib_OpenLeft</include>
				<include>Lib_OpenRight</include>
				<viewtype label="31481">bigwrap</viewtype>
				<visible>$EXP[KSV_ShowPage]</visible>
				<itemlayout width="360" height="298" condition="Container.Content(episodes)">
					<include content="KSV_StripStill">
						<param name="focused" value="false"/><param name="lift" value="false"/><param name="dim" value="$VAR[KSV_Dim]"/>
					</include>
				</itemlayout>
				<focusedlayout width="360" height="298" condition="Container.Content(episodes)">
					<include content="KSV_StripStill">
						<param name="focused" value="true"/><param name="lift" value="Control.HasFocus(525)"/><param name="dim" value="white"/>
					</include>
				</focusedlayout>
				<itemlayout width="200" height="298">
					<include content="KSV_StripPoster">
						<param name="focused" value="false"/><param name="lift" value="false"/><param name="dim" value="$VAR[KSV_Dim]"/>
					</include>
				</itemlayout>
				<focusedlayout width="200" height="298">
					<include content="KSV_StripPoster">
						<param name="focused" value="true"/><param name="lift" value="Control.HasFocus(525)"/><param name="dim" value="white"/>
					</include>
				</focusedlayout>
			</control>
		</control>
	</include>

	<!-- ================================================================ 526 postcards -->
	<!-- 4 x 3 across the spread (cell 453 x 300; the gutter falls between columns 2 and 3): Land prints 380 x 214 -> 408 x 242 -->
	<include name="KSV_Postcard">
		<include content="KSV_BackWord">
			<param name="left" value="22"/><param name="top" value="14"/><param name="width" value="408"/><param name="height" value="242"/>
		</include>
		<control type="group">
			<left>22</left>
			<top>14</top>
			<width>408</width>
			<height>242</height>
			<visible>!ListItem.IsParentFolder</visible>
			<include>KS_TiltItem</include>
			<control type="group">
				<width>408</width>
				<height>242</height>
				<include content="KS_TiltFocus" condition="$PARAM[focused]"><param name="focus" value="$PARAM[lift]"/></include>
				<include content="KSV_WidePrint">
					<param name="kind" value="Land"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
				</include>
			</control>
		</control>
		<control type="label">
			<left>24</left>
			<top>256</top>
			<width>404</width>
			<height>44</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>hand_34</font>
			<textcolor>$PARAM[color]</textcolor>
			<selectedcolor>$PARAM[color]</selectedcolor>
			<label>$INFO[ListItem.Label]</label>
			<visible>!ListItem.IsParentFolder</visible>
		</control>
	</include>
	<include name="VidView_526_Postcards">
		<control type="panel" id="526">
			<left>52</left>
			<top>176</top>
			<width>1812</width>
			<height>904</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<preloaditems>2</preloaditems>
			<onup>9310</onup>
			<ondown>noop</ondown>
			<include>Lib_OpenLeft</include>
			<include>Lib_OpenRight</include>
			<viewtype label="31482">bigwide</viewtype>
			<itemlayout width="453" height="300">
				<include content="KSV_Postcard">
					<param name="focused" value="false"/><param name="lift" value="false"/><param name="dim" value="$VAR[KSV_Dim]"/><param name="color" value="ink_faint"/>
				</include>
			</itemlayout>
			<focusedlayout width="453" height="300">
				<include content="KSV_Postcard">
					<param name="focused" value="true"/><param name="lift" value="Control.HasFocus(526)"/><param name="dim" value="white"/><param name="color" value="ink_bold"/>
				</include>
			</focusedlayout>
		</control>
	</include>

	<!-- ================================================================ 527 a contact sheet (0.9.15) -->
	<!-- the lab's index print: ten small prints to a row across the spread (cell 181 x 300; Search prints 150 x 225 ->
	     170 x 245), the year in mono under each, the focused one lifted with its name. Genres / years / people: the
	     name is written on the print (Kodi's stand-in icons draw nothing over it). -->
	<include name="KSV_SheetPrint">
		<include content="KSV_BackWord">
			<param name="left" value="6"/><param name="top" value="16"/><param name="width" value="170"/><param name="height" value="245"/>
		</include>
		<control type="group">
			<left>6</left>
			<top>16</top>
			<width>170</width>
			<height>245</height>
			<visible>!ListItem.IsParentFolder</visible>
			<include>KS_TiltItem</include>
			<control type="group">
				<width>170</width>
				<height>245</height>
				<include content="KS_TiltFocus" condition="$PARAM[focused]"><param name="focus" value="$PARAM[lift]"/></include>
				<include content="KS_Print_Search">
					<param name="art" value="$VAR[KS_PosterArt]"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="title" value="$INFO[ListItem.Label]"/>
				</include>
			</control>
		</control>
	</include>
	<include name="VidView_527_Sheet">
		<control type="panel" id="527">
			<left>52</left>
			<top>186</top>
			<width>1810</width>
			<height>900</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">260</scrolltime>
			<preloaditems>2</preloaditems>
			<onup>9310</onup>
			<ondown>noop</ondown>
			<include>Lib_OpenLeft</include>
			<include>Lib_OpenRight</include>
			<viewtype label="31488">wide</viewtype>
			<visible>$EXP[KSV_ShowSheet]</visible>
			<itemlayout width="181" height="300">
				<include content="KSV_SheetPrint">
					<param name="focused" value="false"/><param name="lift" value="false"/><param name="dim" value="$VAR[KSV_Dim]"/>
				</include>
				<control type="label">
					<left>0</left>
					<top>262</top>
					<width>181</width>
					<height>28</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>mono_20</font>
					<textcolor>label</textcolor>
					<selectedcolor>label</selectedcolor>
					<label>$INFO[ListItem.Year]</label>
					<visible>!ListItem.IsParentFolder</visible>
				</control>
			</itemlayout>
			<focusedlayout width="181" height="300">
				<include content="KSV_SheetPrint">
					<param name="focused" value="true"/><param name="lift" value="Control.HasFocus(527)"/><param name="dim" value="white"/>
				</include>
				<control type="label">
					<left>-10</left>
					<top>258</top>
					<width>201</width>
					<height>36</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>hand_34</font>
					<textcolor>ink_bold</textcolor>
					<selectedcolor>ink_bold</selectedcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.Label]</label>
					<visible>!ListItem.IsParentFolder</visible>
				</control>
			</focusedlayout>
		</control>
	</include>

	<!-- ================================================================ music: 532 album pages -->
	<variable name="KSV_TracksPath">
		<value condition="String.IsEqual(Container(532).ListItem.DBType,album) + !String.IsEmpty(Container(532).ListItem.DBID) + Control.IsVisible(532)">musicdb://albums/$INFO[Container(532).ListItem.DBID]/</value>
		<value>musicdb://songs/?xsp=%7B%22rules%22%3A%7B%22and%22%3A%5B%7B%22field%22%3A%22title%22%2C%22operator%22%3A%22is%22%2C%22value%22%3A%5B%22ks-none%22%5D%7D%5D%7D%2C%22type%22%3A%22songs%22%7D</value>
	</variable>
	<expression name="KSV_TracksReady">String.IsEqual(ListItem.DBType,album) + Integer.IsGreater(Container(5321).NumItems,0) + String.IsEqual(Container(5321).ListItemAbsolute(0).Album,ListItem.Label)</expression>
	<expression name="KSV_ArtistHasFanart">String.IsEqual(ListItem.DBType,artist) + !String.IsEmpty(ListItem.Art(fanart))</expression>
	<variable name="KSV_MusicTitle">
		<value condition="ListItem.IsParentFolder">$LOCALIZE[31384]</value>
		<value condition="String.IsEqual(ListItem.DBType,song) + !String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="KSV_AlbumMeta">
		<value condition="String.IsEqual(ListItem.DBType,song)">$INFO[ListItem.Artist]$INFO[ListItem.Year,  ·  ,]$INFO[ListItem.Duration,  ·  ,]$INFO[ListItem.Genre,  ·  ,]</value>
		<value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Artist]$INFO[ListItem.Year,  ·  ,]$INFO[ListItem.Genre,  ·  ,]</value>
		<value>$INFO[ListItem.Genre]</value>
	</variable>
	<variable name="KSV_TracksLine">
		<value condition="Integer.IsGreater(Container(5321).NumItems,10)">the first ten of $INFO[Container(5321).NumItems] tracks</value>
		<value condition="Integer.IsEqual(Container(5321).NumItems,1)">$INFO[Container(5321).NumItems] track</value>
		<value condition="Integer.IsGreater(Container(5321).NumItems,0)">$INFO[Container(5321).NumItems] tracks</value>
	</variable>
	<include name="KSV_StripInstant">
		<include content="KSV_BackWord">
			<param name="left" value="14"/><param name="top" value="10"/><param name="width" value="234"/><param name="height" value="280"/>
		</include>
		<control type="group">
			<left>14</left>
			<top>10</top>
			<width>234</width>
			<height>280</height>
			<visible>!ListItem.IsParentFolder</visible>
			<include>KS_TiltItem</include>
			<control type="group">
				<width>234</width>
				<height>280</height>
				<include content="KS_TiltFocus" condition="$PARAM[focused]"><param name="focus" value="$PARAM[lift]"/></include>
				<include content="KS_Print_Instant">
					<param name="art" value="$VAR[KS_SquareArt]"/>
					<param name="dim" value="$PARAM[dim]"/>
					<param name="lift" value="$PARAM[lift]"/>
