<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library (Includes_Views_Video.xml). Kodi id contract (Estuary Omega MyVideoNav.xml + CGUIWindowVideoNav):
	  <views> containers (Kodi remembers the view per node; the first visible "list" view is the default),
	  3 sort by / 4 sort order (hidden buttons the option words click), 14 watched toggle (SendClick only).
	Keepsake ids: 521 film prints, 522 series prints, 523 seasons, 524 episodes, 50 list,
	9000 header word (the other page), 9310 option words, 5210-5219 / 5291 / 5292 / 9174 helpers.
	Focus: the view; Up from the top row = header words. Back = Kodi's parent folder; from the start folder
	(opened from Home with "return") Back goes Home.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>paper</backgroundcolor>
	<views>521,522,523,524,50,525,526,527</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the option words instead -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9310)</onload>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>VidView_Window</include>
	</controls>
</window>
