<?xml version="1.0" encoding="UTF-8"?>
<!--
	The diary (custom window 1161, mockups/KeepsakeDiary.html): every film you watched, newest first, as an
	album timeline. A custom window with its own content list, not a MyVideoNav view: Kodi's "unwatched only"
	filter (Omar's movies watched mode) would empty a library node of watched films.
	Pieces: Includes_Views_Video.xml (VidView_520_Diary, VidView_DiaryOverlay, VidView_DiaryHeader).
	Back = Home (opened from Home's "films" / "this year").
-->
<window type="window" id="1161">
	<defaultcontrol always="true">520</defaultcontrol>
	<menucontrol>9300</menucontrol>
	<backgroundcolor>paper</backgroundcolor>
	<include>Anim_WindowOpenClose</include>
	<controls>
		<include>KS_Page</include>
		<include>VidView_520_Diary</include>
		<include>Diary_TopPatch</include>
		<include>VidView_DiaryOverlay</include>
		<include>VidView_DiaryHeader</include>
		<include content="Lib_Panel">
			<param name="is_video" value="false"/>
			<param name="section" value="the diary"/>
			<param name="back_view" value="520"/>
		</include>
	</controls>
</window>
