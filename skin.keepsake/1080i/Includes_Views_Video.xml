		<value>$INFO[ListItem.TVShowTitle]$INFO[ListItem.Season,  ·  season ,]$INFO[ListItem.Episode,  ·  episode ,]$INFO[ListItem.Premiered,  ·  aired ,]</value>
	</variable>
	<variable name="VidView_EpHistory">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsEqual(ListItem.Property(TotalEpisodes),1) + Integer.IsEqual(ListItem.Property(WatchedEpisodes),0)">$INFO[ListItem.Property(TotalEpisodes)] episode, not seen yet.</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsEqual(ListItem.Property(TotalEpisodes),1)">Its only episode seen.</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + Integer.IsEqual(ListItem.Property(WatchedEpisodes),0)">$INFO[ListItem.Property(TotalEpisodes)] episodes, none seen yet.</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) + String.IsEqual(ListItem.Property(WatchedEpisodes),ListItem.Property(TotalEpisodes))">All $INFO[ListItem.Property(TotalEpisodes)] episodes seen.</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$INFO[ListItem.Property(WatchedEpisodes)] of $INFO[ListItem.Property(TotalEpisodes)] episodes seen.</value>
		<value condition="String.IsEqual(ListItem.DBType,set) + Integer.IsEqual(ListItem.Property(Total),1)">$INFO[ListItem.Property(Watched)] of $INFO[ListItem.Property(Total)] film seen.</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$INFO[ListItem.Property(Watched)] of $INFO[ListItem.Property(Total)] films seen.</value>
		<value condition="ListItem.IsResumable">You stopped $VAR[KS_MinutesIn] $VAR[KS_LP_Rel].</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,1)">Watched $INFO[ListItem.PlayCount] times, last on $VAR[KS_LP_LongY].</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEmpty(ListItem.LastPlayed)">Watched on $VAR[KS_LP_LongY].</value>
		<value condition="Integer.IsGreater(ListItem.PlayCount,0)">Watched.</value>
		<value>Not watched yet.</value>
	</variable>
	<variable name="VidView_EpDim">
		<value condition="Control.HasFocus(524)">dim_print</value>
		<value>white</value>
	</variable>

	<!-- ================================================================== empty folder -->
	<include name="VidView_Empty">
		<control type="group">
			<left>112</left>
			<top>262</top>
			<width>1200</width>
			<height>200</height>
			<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			<animation effect="slide" start="0,0" end="0,300" time="0" condition="Control.IsVisible(526)">Conditional</animation>
			<!-- with a ".." item: below the contact sheet's back print (527) and under the list's ".." row (50), not on them -->
			<animation effect="slide" start="0,0" end="0,330" time="0" condition="Control.IsVisible(527) + Container.HasParent">Conditional</animation>
			<animation effect="slide" start="0,0" end="0,64" time="0" condition="Control.IsVisible(50) + Container.HasParent">Conditional</animation>
			<control type="textbox">
				<left>0</left>
				<top>0</top>
				<width>1200</width>
				<height>110</height>
				<font>hand_46</font>
				<textcolor>ink_faint</textcolor>
				<label>$VAR[VidView_EmptyText]</label>
			</control>
		</control>
	</include>
	<variable name="VidView_EmptyText">
		<value condition="$EXP[VidView_IsDiary]">No pages yet: the diary fills itself as you watch.</value>
		<value condition="System.Setting(hidewatched)">Nothing left unwatched here. Choose "all" above to see everything.</value>
		<value>This page is empty.</value>
	</variable>

