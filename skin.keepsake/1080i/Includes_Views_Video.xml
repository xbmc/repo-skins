			<param name="visible" value="$EXP[VidView_IsFilms]"/>
			<param name="note" value="$VAR[VidView_FilmNote]"/>
		</include>
		<include content="VidView_Wall">
			<param name="id" value="522"/>
			<param name="label" value="prints"/>
			<param name="visible" value="Container.Content(tvshows)"/>
			<param name="note" value="$VAR[VidView_SeriesNote]"/>
		</include>
		<include>VidView_523_Seasons</include>
		<include>VidView_524_Episodes</include>
		<include>VidView_525_Page</include>
		<include>VidView_526_Postcards</include>
		<include>VidView_527_Sheet</include>
		<include>View_50_List</include>
		<include>VidView_Empty</include>
		<include>VidView_Header</include>
		<include content="Lib_Panel">
			<param name="is_video" value="true"/>
			<param name="section" value="[LOWERCASE]$VAR[VidView_Title][/LOWERCASE]"/>
