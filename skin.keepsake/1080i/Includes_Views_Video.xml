<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video library views (MyVideoNav). Mockups: KeepsakeDiary.html (520), KeepsakeUnwatched.html (the print walls).
	  520 the diary     films you watched, newest first (custom window 1161, its own content list): a vertical
	                    album timeline, prints alternating left / right of the gutter, date stamps, gutter dates,
	                    handwritten notes, month dividers written in the gutter (static overlay, see below)
	  521 prints        any other film / set / music video list: a wall of poster prints, 6 across
	  522 series        tv shows: poster prints with "4 of 10 watched"
	  523 seasons       a row of season prints under the show's title
	  524 episodes      a strip of small prints stamped with when you watched each, the focused episode below
	                    (0.9.15: films, sets, series, music videos too, as poster prints six to the strip)
	  50  list          everything else (genres, years, files): rows on the left page, the print on the right
	Header (VidView_Header): handwritten page title, DM Mono label line, option words (grouplist 9000),
	LCD clock. Diary / films: the other page's word ("the unwatched" / "the diary").
	Hidden Kodi buttons 3 (sort by) and 4 (sort order) are clicked by the option words.
	Diary month dividers: the fixedlist keeps focus on slot 1 (slot 0 for the first item), so the screen slot of
	ListItemNoWrap(k) is known; hidden labels 5210-5219 hold each slot's "Month Year" and a divider is shown where
	two neighbours differ (String.IsEqual(Control.GetLabel(a),Control.GetLabel(b))), hidden while scrolling.
-->
<includes>
	<!-- ================================================================== expressions -->
	<expression name="VidView_IsDiary">Window.IsActive(1161)</expression>
	<expression name="VidView_IsFilms">Container.Content(movies) | Container.Content(sets) | Container.Content(musicvideos)</expression>
	<expression name="VidView_DiarySV">!Skin.HasSetting(keepsake.notime) + String.IsEqual(Container(9174).ListItem.DBID,Container(520).ListItem.DBID) + !String.IsEmpty(Container(9174).ListItem.Property(lastplayed))</expression>
	<expression name="VidView_DiaryLongTitle">Integer.IsGreater(Container(5291).NumPages,1)</expression>
	<expression name="VidView_EpLongTitle">Integer.IsGreater(Container(5292).NumPages,1)</expression>
	<expression name="VidView_IsLibraryVideo">Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)</expression>

	<!-- ================================================================== header -->
	<variable name="VidView_Title">
		<value condition="$EXP[VidView_IsDiary]">the diary</value>
		<value condition="String.StartsWith(Container.FolderPath,videodb://movies/titles)">films</value>
		<value condition="String.StartsWith(Container.FolderPath,videodb://tvshows/titles/) + Container.Content(tvshows)">series</value>
		<value condition="Container.Content(seasons) | Container.Content(episodes)">$INFO[ListItem.TVShowTitle]</value>
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value>$LOCALIZE[3]</value>
	</variable>
	<variable name="VidView_LabelLine">
		<value condition="$EXP[VidView_IsDiary]">films  ·  $INFO[Container.NumItems] watched  ·  [COLOR label_hi]newest first[/COLOR]</value>
		<value condition="Container.Content(episodes)">$INFO[Container.FolderName,,  ·  ]$VAR[VidView_EpisodesN]</value>
		<value condition="Container.Content(seasons)">$VAR[VidView_SeasonsN]</value>
		<value condition="Container.Content(tvshows)">$INFO[Container.NumItems] series</value>
		<value condition="Container.Content(movies)">$VAR[VidView_FilmsN]</value>
		<value condition="Integer.IsEqual(Container.NumItems,1)">$INFO[Container.NumItems] item</value>
		<value>$INFO[Container.NumItems] items</value>
	</variable>
	<variable name="VidView_FilmsN">
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 film</value>
		<value>$INFO[Container.NumItems] films</value>
	</variable>
	<variable name="VidView_SeasonsN">
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 season</value>
		<value>$INFO[Container.NumItems] seasons</value>
	</variable>
	<variable name="VidView_EpisodesN">
		<value condition="Integer.IsEqual(Container.NumItems,1)">1 episode</value>
		<value>$INFO[Container.NumItems] episodes</value>
	</variable>
	<variable name="VidView_SortOrderWord">
		<value condition="Container.SortDirection(descending)">descending</value>
		<value>ascending</value>
	</variable>

	<include name="VidView_Header">
		<!-- title + the other page's word on one baseline -->
		<control type="grouplist">
			<left>112</left>
			<top>33</top>
			<width>1180</width>
			<height>130</height>
			<orientation>horizontal</orientation>
			<itemgap>90</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label" id="9390">
				<width max="1180">auto</width>
				<height>118</height>
				<font>hand_92</font>
				<textcolor>ink</textcolor>
				<label>[LOWERCASE]$VAR[VidView_Title][/LOWERCASE]</label>
			</control>
		</control>
		<control type="label">
			<left>118</left>
			<top>161</top>
			<width>500</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label</textcolor>
			<label>$VAR[VidView_LabelLine]</label>
		</control>
		<include>KS_Clock</include>
		<include content="Lib_PenWords">
			<param name="onup" value="9000"/>
			<param name="ondown" value="50"/>
			<param name="onright" value="9310"/>
			<param name="onback" value="50"/>
			<param name="pick_focus" value="Lib_PickFocusVideo"/>
		</include>

		<!-- focusable header words: the other page (diary / films) and the options (sort, order, view, watched) -->
		<control type="grouplist" id="9000">
			<left>508</left>
			<top>72</top>
			<width>760</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>0</itemgap>
			<usecontrolcoords>true</usecontrolcoords>
			<onup>noop</onup>
			<ondown>9310</ondown>
			<onback>50</onback>
			<control type="button" id="9301">
				<top>0</top>
				<width>auto</width>
				<height>74</height>
				<textoffsetx>4</textoffsetx>
				<font>hand_52</font>
				<textcolor>ink_ghost</textcolor>
				<include>KS_PenWordLook</include>
				<label>$LOCALIZE[31385]</label>
				<onclick>ActivateWindow(1160)</onclick>
				<visible>$EXP[VidView_IsDiary]</visible>
			</control>
			<control type="button" id="9302">
				<top>0</top>
				<width>auto</width>
				<height>74</height>
				<textoffsetx>4</textoffsetx>
				<font>hand_52</font>
				<textcolor>ink_ghost</textcolor>
				<include>KS_PenWordLook</include>
				<label>$LOCALIZE[31386]</label>
				<onclick>ActivateWindow(1161)</onclick>
				<visible>String.StartsWith(Container.FolderPath,videodb://movies/titles)</visible>
			</control>
		</control>
		<control type="grouplist" id="9310">
			<left>1068</left>
			<top>150</top>
			<width>760</width>
			<height>48</height>
			<orientation>horizontal</orientation>
			<itemgap>6</itemgap>
			<onup>9830</onup>
			<onleft>9830</onleft>
			<onright>noop</onright>
			<ondown>50</ondown>
			<onback>50</onback>
			<!-- fixed widths first (nothing judders), the sort word last (auto). The view word is a pen word now
			     (Lib_PenWords, under the title). -->
			<control type="button" id="9322">
				<width>270</width>
				<include>VidView_OptionLook</include>
				<label>$VAR[VidView_WatchedWord]</label>
				<onclick>SendClick(14)</onclick>
				<visible>$EXP[VidView_IsLibraryVideo]</visible>
			</control>
			<control type="button" id="9323">
				<width>190</width>
				<include>VidView_OptionLook</include>
				<label>$VAR[VidView_SortOrderWord]</label>
				<onclick>SendClick(4)</onclick>
				<visible>Control.IsEnabled(4)</visible>
			</control>
			<control type="button" id="9324">
				<width>auto</width>
				<include>VidView_OptionLook</include>
				<label>sort: $INFO[Container.SortMethod]</label>
				<onclick>SendClick(3)</onclick>
				<visible>Control.IsEnabled(3)</visible>
			</control>
		</control>
		<control type="button" id="3">
			<description>Sort by (Kodi)</description>
			<include>KS_Hidden</include>
		</control>
		<control type="button" id="4">
			<description>Sort order (Kodi)</description>
			<include>KS_Hidden</include>
		</control>
	</include>
	<variable name="VidView_WatchedWord">
		<value condition="System.Setting(hidewatched)">unwatched only</value>
		<value>all</value>
	</variable>
	<include name="VidView_OptionLook">
		<height>48</height>
		<font>lbl_20</font>
		<textcolor>label_hi</textcolor>
		<focusedcolor>on_tape</focusedcolor>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>18</textoffsetx>
		<include>KS_TapeRowTexture</include>
		<texturenofocus />
	</include>

	<!-- ================================================================== the diary (520) -->
	<!-- one side of the timeline. params: x (print left), note_x, note_align, tick_x, focused (true/false) -->
	<include name="VidView_DiarySide">
		<definition>
			<!-- dotted gutter above this item's date -->
			<control type="image">
				<left>958</left>
				<top>90</top>
				<width>4</width>
				<height>86</height>
				<aspectratio>center</aspectratio>
				<texture colordiffuse="dotted">ks/dots_v.png</texture>
			</control>
			<control type="label">
				<left>900</left>
				<top>182</top>
				<width>120</width>
				<height>27</height>
				<align>center</align>
				<font>lbl_20</font>
				<textcolor>$PARAM[date_color]</textcolor>
				<label>$VAR[KS_LP_Gutter]</label>
			</control>
			<control type="image">
				<left>$PARAM[tick_x]</left>
				<top>195</top>
				<width>30</width>
				<height>2</height>
				<texture colordiffuse="$PARAM[tick_color]">common/white.png</texture>
			</control>
			<control type="group">
				<left>$PARAM[x]</left>
				<top>80</top>
				<width>388</width>
				<height>231</height>
				<include>KS_TiltItem</include>
				<control type="group">
					<width>388</width>
					<height>231</height>
					<include condition="$PARAM[focused]">KS_TiltFocus</include>
					<include content="KS_Print_Diary">
						<param name="art" value="$VAR[KS_LandscapeArt]"/>
						<param name="stamp" value="$VAR[KS_LP_Stamp]"/>
						<param name="stamped" value="!String.IsEmpty(ListItem.LastPlayed)"/>
						<param name="lift" value="$PARAM[lift]"/>
						<param name="title" value="$INFO[ListItem.Label]"/>
					</include>
				</control>
			</control>
			<!-- the note (the focused print's note moves to the detail block while the diary has focus) -->
			<control type="group">
				<visible>$PARAM[note_visible]</visible>
				<control type="label">
					<left>$PARAM[note_x]</left>
					<top>131</top>
					<width>360</width>
					<height>27</height>
					<align>$PARAM[note_align]</align>
					<font>lbln_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[ListItem.Title]</label>
				</control>
				<control type="textbox">
					<left>$PARAM[note_x]</left>
					<top>158</top>
					<width>360</width>
					<height>96</height>
					<align>$PARAM[note_align]</align>
					<font>hand_40</font>
					<textcolor>ink2</textcolor>
					<label>$VAR[KS_DiaryNote]</label>
				</control>
			</control>
		</definition>
	</include>
	<include name="VidView_DiaryItem">
		<param name="focused">false</param>
		<definition>
			<!-- odd items on the left page, even items on the right -->
			<control type="group">
				<visible>Integer.IsOdd(ListItem.CurrentItem)</visible>
				<include content="VidView_DiarySide">
					<param name="x" value="472"/>
					<param name="note_x" value="92"/>
					<param name="note_align" value="right"/>
					<param name="tick_x" value="868"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="date_color" value="$PARAM[date_color]"/>
					<param name="tick_color" value="$PARAM[tick_color]"/>
					<param name="note_visible" value="$PARAM[note_visible]"/>
				</include>
			</control>
			<control type="group">
				<visible>!Integer.IsOdd(ListItem.CurrentItem)</visible>
				<include content="VidView_DiarySide">
					<param name="x" value="1060"/>
					<param name="note_x" value="1490"/>
					<param name="note_align" value="left"/>
					<param name="tick_x" value="1022"/>
					<param name="focused" value="$PARAM[focused]"/>
					<param name="lift" value="$PARAM[lift]"/>
					<param name="date_color" value="$PARAM[date_color]"/>
					<param name="tick_color" value="$PARAM[tick_color]"/>
					<param name="note_visible" value="$PARAM[note_visible]"/>
				</include>
			</control>
		</definition>
	</include>
	<!-- the item above the top slot hangs into the header (prints are 231 tall on a 128 pitch): a patch of the
	     same paper covers its side. Its index = CurrentItem - Position - 1. (Inside the list's own layout
	     Container(520).ListItemNoWrap(k) / CurrentItem resolve to the drawn item, so it can't hide itself.) -->
	<expression name="Diary_TopLeft">Integer.IsGreater(Container(520).CurrentItem,Container(520).Position) + !Integer.IsEqual(Container(520).CurrentItem,1) + [[Integer.IsEqual(Container(520).Position,1) + Integer.IsOdd(Container(520).CurrentItem)] | [!Integer.IsEqual(Container(520).Position,1) + !Integer.IsOdd(Container(520).CurrentItem)]]</expression>
	<expression name="Diary_TopRight">Integer.IsGreater(Container(520).CurrentItem,Container(520).Position) + !Integer.IsEqual(Container(520).CurrentItem,1) + [[Integer.IsEqual(Container(520).Position,1) + !Integer.IsOdd(Container(520).CurrentItem)] | [!Integer.IsEqual(Container(520).Position,1) + Integer.IsOdd(Container(520).CurrentItem)]]</expression>
	<include name="Diary_TopPatch">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture diffuse="ks/mask_top_left.png">ks/paper_spread.jpg</texture>
			<visible>$EXP[Diary_TopLeft]</visible>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture diffuse="ks/mask_top_right.png">ks/paper_spread.jpg</texture>
			<visible>$EXP[Diary_TopRight]</visible>
		</control>
	</include>

	<include name="VidView_520_Diary">
		<control type="fixedlist" id="520">
			<left>0</left>
			<top>176</top>
			<width>1920</width>
			<height>904</height>
			<orientation>vertical</orientation>
			<focusposition>1</focusposition>
			<movement>1</movement>
			<scrolltime tween="cubic" easing="out">240</scrolltime>
			<preloaditems>2</preloaditems>
			<onup>9301</onup>
			<include>Lib_OpenLeft</include>
			<include>Lib_OpenRight</include>
			<itemlayout width="1920" height="128">
				<include content="VidView_DiaryItem">
					<param name="lift" value="false"/>
					<param name="date_color" value="ink_dim"/>
					<param name="tick_color" value="rule_strong"/>
					<param name="note_visible" value="true"/>
				</include>
			</itemlayout>
			<focusedlayout width="1920" height="128">
				<include content="VidView_DiaryItem">
					<param name="focused" value="true"/>
					<param name="lift" value="Control.HasFocus(520)"/>
					<param name="date_color" value="ink_bold"/>
					<param name="tick_color" value="ink"/>
					<param name="note_visible" value="!Control.HasFocus(520)"/>
				</include>
			</focusedlayout>
			<content target="videos" sortby="lastplayed" sortorder="descending" browse="never">$VAR[KS_Path_Watched]</content>
		</control>
	</include>

	<!-- the sticky month above the timeline + month dividers in the gutter + the focused print's details -->
	<include name="VidView_DiaryOverlay">
		<control type="group">
			<visible>Control.IsVisible(520)</visible>
			<!-- Skin Variables: the exact time of the focused film's last play -->
			<control type="group">
				<control type="list" id="9174">
					<left>-40</left>
					<top>-40</top>
					<width>1</width>
					<height>1</height>
					<itemlayout width="1" height="1"/>
					<focusedlayout width="1" height="1"/>
					<content target="videos">plugin://script.skinvariables/?info=get_dbitem_movie_details&amp;dbid=$INFO[Container(520).ListItem.DBID]</content>
				</control>
			</control>
			<control type="textbox" id="5291">
				<left>1500</left>
				<top>427</top>
				<width>340</width>
				<height>82</height>
				<font>ttl_64</font>
				<textcolor>clear</textcolor>
				<label>$INFO[Container(520).ListItem.Title]</label>
			</control>
		</control>
		<!-- month dividers, sticky month, the focused print's details (generated: _src/make_diary.py) -->
		<include>Diary_Overlay</include>
	</include>
	<include name="VidView_DiaryDetail">
		<definition>
			<control type="label">
				<left>0</left>
				<top>1</top>
				<width>340</width>
				<height>27</height>
				<align>$PARAM[align]</align>
				<font>lbl_20</font>
				<textcolor>label_hi</textcolor>
				<label>$VAR[KS_CLP_Long]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>31</top>
				<width>340</width>
				<height>82</height>
				<align>$PARAM[align]</align>
				<font>ttl_64</font>
				<textcolor>cream</textcolor>
				<label>$INFO[Container(520).ListItem.Title]</label>
				<visible>!$EXP[VidView_DiaryLongTitle]</visible>
			</control>
			<control type="textbox">
				<left>0</left>
				<top>34</top>
				<width>340</width>
				<height>100</height>
				<align>$PARAM[align]</align>
				<font>ttt_40</font>
				<textcolor>cream</textcolor>
				<label>$INFO[Container(520).ListItem.Title]</label>
				<visible>$EXP[VidView_DiaryLongTitle]</visible>
			</control>
			<control type="group">
				<animation effect="slide" end="0,30" time="0" condition="$EXP[VidView_DiaryLongTitle]">Conditional</animation>
				<control type="image">
					<left>$PARAM[x]</left>
					<top>104</top>
					<width>200</width>
					<height>22</height>
					<texture colordiffuse="ink">ks/pen_line.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>135</top>
					<width>340</width>
					<height>27</height>
					<align>$PARAM[align]</align>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[Container(520).ListItem.Year]$INFO[Container(520).ListItem.Duration(mins),  ·  , min]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>162</top>
					<width>340</width>
					<height>27</height>
					<align>$PARAM[align]</align>
					<font>lbl_20</font>
					<textcolor>label</textcolor>
					<label>$INFO[Container(520).ListItem.Director]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>193</top>
					<width>340</width>
					<height>96</height>
					<align>$PARAM[align]</align>
					<font>hand_40</font>
					<textcolor>ink</textcolor>
					<label>$VAR[VidView_DiaryFocusNote]</label>
				</control>
			</control>
		</definition>
	</include>
	<variable name="VidView_DiaryFocusNote">
		<value condition="$EXP[VidView_DiarySV] + Integer.IsGreater(Container(520).ListItem.PlayCount,1)">$VAR[KS_CTimeWord], at $VAR[KS_T_DIA_Clock]</value>
		<value condition="$EXP[VidView_DiarySV]">$VAR[KS_T_DIA_That], $VAR[KS_T_DIA_Clock]</value>
		<value>$VAR[KS_CDiaryNote]</value>
	</variable>

	<!-- the diary's own header (custom window 1161) -->
	<include name="VidView_DiaryHeader">
		<control type="label">
			<left>112</left>
			<top>33</top>
			<width>400</width>
			<height>118</height>
			<font>hand_92</font>
			<textcolor>ink</textcolor>
			<label>$LOCALIZE[31386]</label>
		</control>
		<control type="grouplist" id="9300">
			<left>508</left>
			<top>72</top>
			<width>760</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>34</itemgap>
			<onup>noop</onup>
			<ondown>520</ondown>
			<onright>9830</onright>
			<onback>520</onback>
			<control type="button" id="9301">
				<width>auto</width>
				<height>74</height>
				<textoffsetx>4</textoffsetx>
				<font>hand_52</font>
				<textcolor>ink_ghost</textcolor>
				<include>KS_PenWordLook</include>
				<label>$LOCALIZE[31385]</label>
				<onclick>ReplaceWindow(1160)</onclick>
			</control>
			<control type="button" id="9303">
				<width>auto</width>
				<height>74</height>
				<textoffsetx>4</textoffsetx>
				<font>hand_52</font>
				<textcolor>ink_ghost</textcolor>
				<include>KS_PenWordLook</include>
				<label>$LOCALIZE[31387]</label>
				<onclick>ActivateWindow(Videos,videodb://movies/titles/,return)</onclick>
			</control>
		</control>
		<control type="label">
			<left>118</left>
			<top>161</top>
			<width>700</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label</textcolor>
			<label>films  ·  $INFO[Container(520).NumItems] watched  ·  [COLOR label_hi]newest first[/COLOR]</label>
		</control>
		<include content="Lib_PenWords">
			<param name="view_visible" value="false"/>
			<param name="onup" value="9300"/>
			<param name="ondown" value="520"/>
			<param name="onback" value="520"/>
		</include>
		<include>KS_Clock</include>
		<control type="textbox">
			<left>112</left>
			<top>262</top>
