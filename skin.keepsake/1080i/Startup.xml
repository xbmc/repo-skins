<?xml version="1.0" encoding="UTF-8"?>
<!--
	Startup: black page + wordmark for the instant before Home. No splash timer.
	Goes to Kodi's configured startup window (default Home), like Estuary, so Omar's
	"Settings > Interface > Startup window" keeps working.
-->
<window>
	<!-- 0.9.17: the region's day/month order for the date tables (see Home.xml) -->
	<onload>SetProperty(keepsake.monthday,$INFO[System.Date(MMMM D)],home)</onload>
	<onload>SetProperty(keepsake.monthyear,$INFO[System.Date(MMMM YYYY)],home)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls>
		<include>KS_Background</include>
		<control type="label">
			<left>page_margin</left>
			<top>460</top>
			<width>page_width</width>
			<height>140</height>
			<font>ttl_84</font>
			<label>$LOCALIZE[31024]</label>
		</control>
	</controls>
</window>
