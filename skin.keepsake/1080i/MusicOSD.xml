<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music OSD: the words, written in pen at the foot of now playing (MusicVisualisation.xml shows the song).
	Kodi id contract (Estuary Omega MusicOSD.xml): defaultcontrol 602 (603 when pause isn't possible), 87 seek
	stepper (hidden; Left/Right step), 200 group; 602 play/pause, 603 stop, 600 previous, 607 next (no 601/606),
	70054 shuffle, 70053 repeat, 70051 queue. Not shipped: 608 record, 70040-70050 PVR / RDS, 70052 rating,
	70055 lyrics. Order (rule 6): pause, stop, previous, next | shuffle, repeat, queue. Fixed widths (rule 5).
	Keepsake ids: · 202, 70060 visualiser / the photo (while a visualisation add-on is set in Kodi; skin bool
	keepsake.np.viz), 70061 presets (Visualiser mode + Visualisation.HasPresets: Kodi's preset list in DialogSelect;
	it has focus when the OSD opens over such a visualiser). Hidden words pass Left / Right on to their neighbours.
	Left/Right walk the row and wrap; Up = seek stepper; Back closes the OSD.
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<onload condition="Skin.HasSetting(keepsake.np.viz) + Visualisation.Enabled + Visualisation.HasPresets">SetFocus(70061)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<include>Anim_OSDSlideUp</include>
	<controls>
		<control type="image">
			<left>0</left>
			<bottom>0</bottom>
			<width>1920</width>
			<height>260</height>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="shade">common/gradient_bottom.png</texture>
		</control>
		<control type="button" id="87">
			<description>seek stepper</description>
			<include>KS_Hidden</include>
			<onup>200</onup>
			<ondown>200</ondown>
			<onleft>StepBack</onleft>
			<onright>StepForward</onright>
		</control>
		<control type="image">
			<left>1060</left>
			<top>690</top>
			<width>760</width>
			<height>22</height>
			<texture colordiffuse="ink_faint">ks/pen_line.png</texture>
			<visible>Control.HasFocus(87)</visible>
			<include>Anim_FadeVisible</include>
		</control>
		<control type="label">
			<left>1068</left>
			<top>738</top>
			<width>740</width>
			<height>27</height>
			<font>lbl_20</font>
			<textcolor>label_hi</textcolor>
			<label>$LOCALIZE[31390]</label>
			<visible>Control.HasFocus(87)</visible>
		</control>

		<control type="grouplist" id="200">
			<left>108</left>
			<top>962</top>
			<width>1704</width>
			<height>100</height>
			<orientation>horizontal</orientation>
			<itemgap>22</itemgap>
			<onup>87</onup>
			<include content="OSD_PenWord">
				<param name="id" value="602"/>
				<param name="label" value="$VAR[OSD_PlayWord]"/>
				<param name="width" value="112"/>
				<param name="onclick" value="PlayerControl(Play)"/>
				<param name="onleft" value="70061"/>
				<param name="onright" value="603"/>
				<param name="visible" value="Player.PauseEnabled"/>
			</include>
			<include content="OSD_PenWord">
				<param name="id" value="603"/>
				<param name="label" value="stop"/>
				<param name="width" value="92"/>
				<param name="onclick" value="PlayerControl(Stop)"/>
				<param name="onleft" value="602"/>
				<param name="onright" value="600"/>
			</include>
			<include content="OSD_PenWord">
				<param name="id" value="600"/>
				<param name="label" value="previous"/>
				<param name="width" value="146"/>
				<param name="onclick" value="PlayerControl(Previous)"/>
				<param name="onleft" value="603"/>
				<param name="onright" value="607"/>
			</include>
			<include content="OSD_PenWord">
				<param name="id" value="607"/>
				<param name="label" value="next"/>
				<param name="width" value="92"/>
				<param name="onclick" value="PlayerControl(Next)"/>
				<param name="onleft" value="600"/>
				<param name="onright" value="70054"/>
			</include>
			<control type="label" id="201">
				<width>96</width>
				<height>74</height>
				<font>hand_46</font>
				<textcolor>ink_dot</textcolor>
				<align>center</align>
				<label>·</label>
			</control>
			<include content="OSD_TextButton">
				<param name="id" value="70054"/>
				<param name="width" value="150"/>
				<param name="caption" value="shuffle"/>
				<param name="value" value="$VAR[Music_OSDShuffleValue]"/>
				<param name="onclick" value="PlayerControl(Random)"/>
				<param name="onleft" value="607"/>
				<param name="onright" value="70053"/>
				<param name="visible" value="!MusicPartyMode.Enabled"/>
			</include>
			<include content="OSD_TextButton">
				<param name="id" value="70053"/>
				<param name="width" value="144"/>
				<param name="caption" value="repeat"/>
				<param name="value" value="$VAR[Music_OSDRepeatValue]"/>
				<param name="onclick" value="PlayerControl(Repeat)"/>
				<param name="onleft" value="70054"/>
				<param name="onright" value="70051"/>
				<param name="visible" value="!MusicPartyMode.Enabled"/>
			</include>
			<include content="OSD_TextButton">
				<param name="id" value="70051"/>
				<param name="width" value="160"/>
				<param name="caption" value="queue"/>
				<param name="value" value="$VAR[Music_OSDQueueValue]"/>
				<param name="onclick" value="ActivateWindow(musicplaylist)"/>
				<param name="onleft" value="70053"/>
				<param name="onright" value="70060"/>
				<param name="visible" value="Integer.IsGreater(Playlist.Length(music),0)"/>
			</include>
			<control type="label" id="202">
				<width>96</width>
				<height>74</height>
				<font>hand_46</font>
				<textcolor>ink_dot</textcolor>
				<align>center</align>
				<label>·</label>
				<visible>Visualisation.Enabled</visible>
			</control>
			<include content="OSD_PenWord">
				<param name="id" value="70060"/>
				<param name="label" value="$VAR[Music_VizWord]"/>
				<param name="width" value="181"/>
				<param name="onclick" value="Skin.ToggleSetting(keepsake.np.viz)"/>
				<param name="onleft" value="70051"/>
				<param name="onright" value="70061"/>
				<param name="visible" value="Visualisation.Enabled"/>
			</include>
			<include content="OSD_PenWord">
				<param name="id" value="70061"/>
				<param name="label" value="$LOCALIZE[31477]"/>
				<param name="width" value="141"/>
				<param name="onclick" value="ActivateWindow(visualisationpresetlist)"/>
				<param name="onleft" value="70060"/>
				<param name="onright" value="602"/>
				<param name="visible" value="$EXP[Music_VizPresets]"/>
			</include>
		</control>
	</controls>
</window>
