<?xml version="1.0" encoding="UTF-8"?>
<!--
    skin.keepsake - black photo album palette (docs/skin.keepsake/DESIGN.md, mockups KeepsakeHome/Diary/Info/Unwatched).
    Format AARRGGBB. Semantic names only; never hard-code hex in windows.
-->
<colors>
	<!-- album paper (the page itself is media/ks/paper_spread.jpg; these are for flat fills) -->
	<color name="paper">ff121110</color>
	<color name="paper_deep">ff0b0a0a</color>
	<color name="paper_raised">ff1c1a18</color>
	<color name="paper_card">ff191715</color>

	<!-- white gel pen (handwriting) -->
	<color name="ink">ebf2efe8</color>          <!-- .hand 92 % -->
	<color name="ink_bold">fffbf8f1</color>     <!-- .hand b, focused words -->
	<color name="ink2">ccf2efe8</color>         <!-- notes .80 -->
	<color name="ink_soft">a8f2efe8</color>     <!-- .66 -->
	<color name="ink_faint">94f2efe8</color>    <!-- unfocused pen words .58 -->
	<color name="ink_ghost">6bf2efe8</color>    <!-- the other page's word .42 -->
	<color name="ink_dim">8cf2efe8</color>      <!-- .55 -->
	<color name="ink_dot">4af2efe8</color>      <!-- nav dots .58 x .5 -->

	<!-- type -->
	<color name="cream">ffefe6d6</color>        <!-- Fraunces titles -->
	<color name="body">d1f2efe8</color>         <!-- plot .82 -->
	<color name="meta">ffc9c2b8</color>         <!-- DM Mono meta line -->
	<color name="label">ff8c8780</color>        <!-- DM Mono small caps -->
	<color name="label_hi">ffb5afa6</color>     <!-- emphasised label -->

	<!-- the date stamp / LCD -->
	<color name="stamp">f5ff6a1f</color>
	<color name="stamp_g1">5cff7828</color>
	<color name="stamp_g2">24ff5a14</color>
	<color name="stamp_haze">2eff4a0a</color>
	<color name="stamp_under">47000000</color>  <!-- dark under-glow, 28 % -->

	<!-- prints, tape -->
	<color name="print">fff4f1ea</color>
	<color name="on_print">ff1a1816</color>     <!-- text on a white print / card -->
	<color name="tape">fff2ead4</color>
	<color name="on_tape">ff15130f</color>      <!-- ink on the focused-row tape -->
	<color name="dim_print">ffbdbcb8</color>    <!-- unfocused photos: brightness ~.74 (fadediffuse multiply) -->
	<color name="dim_print_more">ff8a8986</color>

	<!-- lines -->
	<color name="rule">26f2efe8</color>
	<color name="rule_strong">4df2efe8</color>
	<color name="dotted">73f2efe8</color>

	<!-- shades -->
	<color name="shade">ff0b0a0a</color>
	<color name="shade_tab">d90b0a0a</color>
	<color name="track">40f2efe8</color>
	<color name="shadow">b3000000</color>
	<color name="veil">d90b0a0a</color>         <!-- page dim behind modal dialogs -->
	<color name="video_dim">8c000000</color>

	<!-- utility -->
	<color name="white">ffffffff</color>
	<color name="black">ff000000</color>
	<color name="clear">00ffffff</color>
	<color name="disabled">ff5a5650</color>
</colors>
