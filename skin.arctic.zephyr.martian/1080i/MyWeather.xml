        <control type="group">
            <include>Animation.Common</include>
            <include content="Furniture_Scrollbar">
                <param name="onleft" value="9100" />
                <param name="onright" value="9100" />
                <param name="jumpbar" value="false" />
            </include>
            <control type="image">
                <visible>!Container(9100).OnNext + !Container(9100).OnPrevious</visible>
                <top>190</top>
                <left>930</left>
                <include>arrowdimensions</include>
                <texture colordiffuse="Dark2" flipy="true">common/arrow-small.png</texture>
                <include>Animation.DelayFadeIn2</include>
