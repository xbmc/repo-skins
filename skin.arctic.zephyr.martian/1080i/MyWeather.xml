                </focusedlayout>
                <content>
                    <item id="0">
                       <label>31094</label>
                       <property name="content">Daily</property>
                    </item>
                    <item id="1">
                        <label>31093</label>
                        <property name="content">Hourly</property>
                        <visible>!String.IsEmpty(Window.Property(Hourly.IsFetched))</visible>
                    </item>
                    <item id="2">
                        <label>$INFO[Window.Property(Map.1.Heading)]</label>
                        <property name="content">Map1</property>
                       	<onclick condition="String.IsEmpty(Window.Property(Play.map1))">SetProperty(Play.map1,true)</onclick>                       
                       	<onclick condition="!String.IsEmpty(Window.Property(Play.map1))">ClearProperty(Play.map1)</onclick>                       
                        <visible>!String.IsEmpty(Window.Property(Map.1.Area)) + !String.IsEmpty(Window.Property(Map.IsFetched))</visible>
                    </item>
                    <item id="3">
                        <label>$INFO[Window.Property(Map.2.Heading)]</label>
                        <property name="content">Map2</property>
                       	<onclick condition="String.IsEmpty(Window.Property(Play.map2))">SetProperty(Play.map2,true)</onclick>                       
