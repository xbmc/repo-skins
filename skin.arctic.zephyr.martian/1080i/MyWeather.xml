            <control type="grouplist" id="9000">
                <include content="Def9000GroupList">
                    <param name="onback" value="9100" />
                </include>
                <!-- Weather Options -->
                <control type="button" id="9001" description="Weather Location">
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>$LOCALIZE[184]:</label>
                    <label2>$INFO[Weather.Location]</label2>
                    <onclick>Weather.LocationNext</onclick>
                </control>
                <control type="radiobutton" id="9002" description="Show weather overlay">
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>31234</label>
                    <visible>$EXP[HasWeatherFanartSingle] | $EXP[HasWeatherFanartMulti]</visible>
                    <selected>!Skin.HasSetting(weather.hidefanart) + [$EXP[HasWeatherFanartSingle] | $EXP[HasWeatherFanartMulti]]</selected>
