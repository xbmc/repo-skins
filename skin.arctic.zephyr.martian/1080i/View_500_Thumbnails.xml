<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include name="View_500_Thumbnails">
        <control type="group">
            <include>Animation.Common</include>
            <visible>Control.IsVisible(500)</visible>
            <control type="group">
                <control type="panel" id="500">
                    <visible>$EXP[Exp_View_500] | Window.IsVisible(pictures) | Window.IsVisible(programs)</visible>
                    <top>206</top>
                    <left>70</left>
                    <width>1800</width>
                    <height>680</height>
                    <onleft condition="!Skin.HasSetting(global.kioskmode)">9000</onleft>
                    <onright>1635</onright>
                    <onup>500</onup>
                    <ondown>500</ondown>
                    <preloaditems>0</preloaditems>
                    <pagecontrol>1635</pagecontrol>
                    <orientation>vertical</orientation>
                    <viewtype label="21371">list</viewtype>
                    <include>ScrolltimeViewsList</include>
                    <itemlayout height="340" width="299.33">
                        <control type="group">
                            <height>280</height>
                            <width>280</width>
                            <include content="include.widget.thumb">
                                <param name="id" value="500"/>
                                <param name="height" value="280"/>
                            </include>
                        </control>
                        <control type="label">
                            <left>15</left>
                            <right>30</right>
                            <bottom>20</bottom>
                            <height>50</height>
                            <align>center</align>
                            <font>Tiny</font>
                            <label>$INFO[ListItem.Label]</label>
                            <textcolor>Dark1</textcolor>
                            <selectedcolor>Dark1</selectedcolor>
                        </control>
                    </itemlayout>
                    <focusedlayout height="340" width="299.33">
                        <control type="group">
                            <height>280</height>
                            <width>280</width>
                            <include content="include.widget.thumb">
                                <param name="id" value="500"/>
                                <param name="height" value="280"/>
                                <param name="focused" value="true" />
                            </include>
                        </control>
                        <control type="label">
                            <left>15</left>
                            <right>30</right>
                            <bottom>20</bottom>
                            <height>50</height>
                            <align>center</align>
                            <font>Tiny</font>
                            <label>$INFO[ListItem.Label]</label>
                            <textcolor>Dark1</textcolor>
                            <selectedcolor>Dark1</selectedcolor>
                        </control>
                    </focusedlayout>
                </control>
            </control>
            <include content="Furniture_Scrollbar">
                <param name="id" value="1635" />
            </include>
        </control>
    </include>
</includes>