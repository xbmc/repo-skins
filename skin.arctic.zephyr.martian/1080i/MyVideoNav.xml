<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<window id="6">
    <defaultcontrol always="true">50</defaultcontrol>
    <backgroundcolor>0</backgroundcolor>
    <menucontrol>9000</menucontrol>
    <include>View_IDs</include>
    <include>Blur_OnLoad_Action</include>
    <include>Generator_BuildViewTypes_Onload</include>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + $EXP[TrailerIsPlaying] + !Skin.HasSetting(trailer.dont.stop.on.unfocus) + !Window.Next(FullScreenVideo)">ClearProperty(TrailerPath,home)</onunload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer) + $EXP[TrailerIsPlaying] + !Skin.HasSetting(trailer.dont.stop.on.unfocus) + !Window.Next(FullScreenVideo)">Stop</onunload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer)">ClearProperty(listitem.trailer,home)</onunload>
    <controls>
        <include>GlobalBackground</include>
        <include>Furniture_Header</include>
        <include>Furniture_NowPlaying</include>
        <include>Furniture_Clock</include>
        <include>Furniture_Flags</include>
        <include>Furniture_Weather</include>
        <include>Furniture_Jumpbar</include>
        <include>View_Includes</include>

        <include>MovieSetInfo</include>
        
        <include content="DialogInfoOverlay">
            <param name="headerinfo" value="$INFO[ListItem.Title]" />
            <param name="plotinfo" value="$INFO[ListItem.Tagline,[B],[/B][CR][CR]]$VAR[LabelPlot]" />
            <param name="ondirection" value="50" />
        </include>
        <include content="View_SideBlade">
            <control type="grouplist" id="9000">
                <include content="Def9000GroupList" />
                <include>View_SideBlade_ViewMode</include>
                <include>View_SideBlade_Common</include>
                <control type="radiobutton" id="14">
                    <description>Hide watched</description>
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>31133</label>
                </control>
                <include>View_Options</include>
                <!-- Other Options -->
                <control type="button" id="55554">
                    <include>DefContextMenuLabel</include>
                    <label>14230</label>
                    <visible>Control.IsVisible(11) | Control.IsVisible(16) | Control.IsVisible(20) | Control.IsVisible(6148) | Control.IsVisible(9099)</visible>
                </control>
                <control type="button" id="9098">
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>14247</label>
                    <onclick>CleanLibrary(video)</onclick>
                    <visible>Control.IsEnabled(20)</visible>
                </control>
                <control type="togglebutton" id="20">
                    <description>Update</description>
                    <align>left</align>
                    <label>653</label>
                    <altlabel>13353</altlabel>
                    <include>DefContextButtonGradient</include>
                    <usealttexture>Library.IsScanningVideo</usealttexture>
                    <visible>Control.IsEnabled(20)</visible>
                </control>
                <control type="radiobutton" id="16">
                    <description>PartyMode</description>
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>589</label>
                    <visible>Container.Content(MusicVideos)</visible>
                </control>
                <include>View_SideBlade_Playlist</include>
                <control type="radiobutton" id="11">
                    <description>Unlock Shares</description>
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
                    <label>20336</label>
                    <onclick>mastermode</onclick>
                    <selected>system.ismaster</selected>
                    <visible>system.haslocks</visible>
                </control>
                <control type="button" id="9099">
                    <include>DefContextButtonGradient</include>
                    <align>left</align>
	                <label>10140</label>
	                <onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
	                <visible>!String.IsEmpty(Container.PluginName)</visible>
	            </control>    
                <include>View_SideBlade_NowPlaying</include>
            </control>
        </include>
    </controls>
</window>
