<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include name="ProgressCircle">
        <definition>
            <control type="group">
                <top>495</top>
                <left>415</left>
                <width>159</width>
                <height>159</height>
                <visible>$EXP[ShowProgressInfo]</visible>
                <visible>!ListItem.IsParentFolder + !String.IsEqual(ListItem.DBType,set)</visible>
                <control type="image" description="Back">
                    <width>159</width>
                    <height>159</height>
                    <texture diffuse="diffuse/diffuse_progress_big.png" border="0">progress/back3.png</texture>
                </control>
                <control type="group">
                    <visible>Container.Content(movies) | String.IsEqual(ListItem.DBType,episode)</visible>
                    <control type="image">
                        <visible>ListItem.IsResumable</visible>
                        <width>159</width>
                        <height>159</height>
                        <texture diffuse="diffuse/diffuse_progress_big.png" colordiffuse="$VAR[ColorHighlight]">$INFO[ListItem.PercentPlayed,progress/circle/p,.png]</texture>
                    </control>
                    <control type="image">
                        <visible>String.Contains(ListItem.Overlay,OverlayWatched.png) + !ListItem.IsResumable</visible>
                        <width>159</width>
                        <height>159</height>
                        <texture diffuse="diffuse/diffuse_progress_big.png" colordiffuse="$VAR[ColorHighlight]">progress/circle/p100.png</texture>
                    </control>
                </control>
                <control type="image">
                    <width>159</width>
                    <height>159</height>
                    <texture diffuse="diffuse/diffuse_progress_big.png" colordiffuse="$VAR[ColorHighlight]">$VAR[Def_PercentWatched,progress/circle/p,.png]</texture>
                    <visible>String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)</visible>
                    <include>Animation.SwitchText</include>
                </control>
                <control type="label">
                    <include>Animation.SwitchText</include>
                    <width>159</width>
                    <centertop>49%</centertop>
                    <align>center</align>
                    <label>$VAR[ProgressCircleLabel]</label>
                    <font>Progress</font>
                    <textcolor>PanelWhite70</textcolor>
                    <selectedcolor>PanelWhite70</selectedcolor>
                </control>
            </control>
        </definition>
    </include>

    <include name="PosterDiscCase">
        <control type="group">
            <left>1568</left>
            <top>548</top>
            <visible>!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | !String.IsEmpty(ListItem.Art(season.poster)) | !String.IsEmpty(ListItem.Art(thumb)) + String.IsEqual(ListItem.DBType,musicvideo)</visible>
            <control type="image">
                <visible>!String.IsEmpty(ListItem.Art(discart)) + Skin.HasSetting(discartfanart) + !Container.OnNext + !Container.OnPrevious</visible>
                <top>103</top>
                <width>235</width>
                <height>235</height>
                <left>-117</left>
                <fadetime>1000</fadetime>
                <texture diffuse="diffuse/diffuse_cd.png">$INFO[ListItem.Art(discart)]</texture>
                <animation type="Visible" reversible="false">
                    <effect type="fade" start="0" end="100" time="0" delay="450"/>
                    <effect type="slide" start="117" end="0" tween="sine" easing="out" time="600" delay="500"/>
                </animation>
                <animation type="Hidden" reversible="false">
                    <effect type="fade" start="100" end="0" time="0"/>
                </animation>
                <animation type="WindowOpen" reversible="false">
                    <effect type="fade" start="0" end="100" time="0" delay="450"/>
                    <effect type="slide" start="117" end="0" tween="sine" easing="out" time="600" delay="500"/>
                </animation>
                <animation type="WindowClose" reversible="false">
                    <effect type="slide" start="0" end="117" tween="sine" easing="out" time="250"/>
                    <effect type="fade" start="100" end="0" time="150"/>
                </animation>
            </control>
            <control type="image">
                <width>242</width>
                <height>342</height>
                <fadetime>PosterFanartFadetime</fadetime>
                <texture background="true">$VAR[PosterImage]</texture>
                <visible>!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | !String.IsEmpty(ListItem.Art(season.poster))</visible>
            </control>
            <control type="image">
                <width>278</width>
                <height>370</height>
                <left>-20</left>
                <top>-9</top>
                <fadetime>PosterFanartFadetime</fadetime>
                <texture>misc/poster_glass2.png</texture>
                <visible>!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(tvshow.poster)) | !String.IsEmpty(ListItem.Art(season.poster))</visible>
            </control>
            <control type="image">
                <top>100</top>
                <width>242</width>
                <height>242</height>
                <fadetime>PosterFanartFadetime</fadetime>
                <aspectratio>scale</aspectratio>
                <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                <visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster))</visible>
            </control>
            <control type="image">
                <top>98</top>
                <left>-1</left>
                <width>244</width>
                <height>245</height>
                <fadetime>PosterFanartFadetime</fadetime>
                <texture>misc/br-case.png</texture>
                <visible>String.IsEmpty(ListItem.Art(poster)) + String.IsEmpty(ListItem.Art(tvshow.poster)) + String.IsEmpty(ListItem.Art(season.poster))</visible>
            </control>
        </control>
    </include>
    
    <include name="View_508_Content">
        <control type="group">
            <height>650</height>
            <width>538</width>
            <control type="label">
                <top>14</top>
                <aligny>center</aligny>
                <height>64</height>
                <font>MediumBold</font>
                <textcolor>PanelWhite100</textcolor>
                <selectedcolor>PanelWhite100</selectedcolor>
                <label>$INFO[ListItem.Label]</label>
                <include condition="Skin.HasSetting(labels.autoscroll)">LabelScroll</include>
            </control>
            <control type="label">
                <top>56</top>
                <height>64</height>
                <aligny>center</aligny>
                <font>Tiny</font>
                <textcolor>PanelWhite100</textcolor>
                <selectedcolor>PanelWhite100</selectedcolor>
                <label>$VAR[LabelGenre]</label>
            </control>
            <control type="textbox">
                <top>136</top>
                <height>366</height>
                <font>TinyPlot</font>
                <textcolor>PanelWhite70</textcolor>
                <selectedcolor>PanelWhite70</selectedcolor>
                <label>$VAR[LabelPlot]</label>
                <align>justify</align>
            </control>
            <control type="label">
                <posy>570</posy>
                <width>450</width>
                <font>Tiny</font>
                <textcolor>PanelWhite70</textcolor>
                <label>$VAR[RatingAndVotesLabel]</label>
                <selectedcolor>PanelWhite70</selectedcolor>
                <visible>!ListItem.IsParentFolder</visible>
            </control>
            <include>ProgressCircle</include>
            <control type="group">
                <control type="group">
                    <top>460</top>
                    <width>1050</width>
                    <visible>!ListItem.IsParentFolder</visible>
                    <include content="Def_Flag">
                        <param name="Star" value="Flagstar1" />
                        <param name="color" value="$VAR[ColorStarsPanel]" />
                    </include>
                    <include content="Def_Flag">
                        <param name="Star" value="Flagstar2" />
                        <param name="left" value="50" />
                        <param name="color" value="$VAR[ColorStarsPanel]" />
                    </include>
                    <include content="Def_Flag">
                        <param name="Star" value="Flagstar3" />
                        <param name="left" value="100" />
                        <param name="color" value="$VAR[ColorStarsPanel]" />
                    </include>
                    <include content="Def_Flag">
                        <param name="Star" value="Flagstar4" />
                        <param name="left" value="150" />
                        <param name="color" value="$VAR[ColorStarsPanel]" />
                    </include>
                    <include content="Def_Flag">
                        <param name="Star" value="Flagstar5" />
                        <param name="left" value="200" />
                        <param name="color" value="$VAR[ColorStarsPanel]" />
                    </include>
                </control>
            </control>
        </control>
    </include>
    
    <include name="View_508_Layout">
        <control type="image">
            <right>111</right>
            <width>1160</width>
            <height>646</height>
            <aspectratio aligny="center" align="center">scale</aspectratio>
            <texture diffuse="diffuse/bigwiderolodex_new.png" border="0" background="true" fallback="$VAR[Image_Fallback_Icon]">$VAR[FanartImage]</texture>
            <visible>true</visible>
        </control>
        <control type="group">
            <visible>Skin.HasSetting(508.noscrolling)</visible>
            <left>59</left>
            <include>View_508_Content</include>
        </control>
    </include>

    <include name="View_508_Fanart">
        <description>List View (id=508)</description>
        <control type="group">
            <visible>Control.IsVisible(508)</visible>
            <include>Animation.Common</include>
            <control type="group">
                <left>70</left>
                <control type="group">
                    <top>185</top>
                    <left>-26</left>
                    <control type="image">
                        <left>17</left>
                        <top>1</top>
                        <width>1813</width>
                        <height>30</height>
                        <texture background="true">common/$VAR[background_top]</texture>
                    </control>
                    <control type="image">
                        <left>17</left>
                        <top>679</top>
                        <width>1813</width>
                        <height>30</height>
                        <texture background="true" flipy="true">common/$VAR[background_top]</texture>
                    </control>
                    <control type="image">
                        <left>9</left>
                        <top>33</top>
                        <width>30</width>
                        <height>650</height>
                        <texture background="true">common/$VAR[background_side]</texture>
                    </control>
                    <control type="image">
                        <left>1796</left>
                        <top>33</top>
                        <width>30</width>
                        <height>650</height>
                        <texture background="true" flipx="true">common/$VAR[background_side]</texture>
                    </control>
                    <control type="image">
                        <width>1758</width>
                        <height>647</height>
                        <top>32</top>
                        <left>36</left>
                        <texture colordiffuse="Panel" diffuse="diffuse/pvrinfo.png" background="true" border="12">common/white.png</texture>
                    </control>
                    <control type="image">
                        <right>SidePad</right>
                        <width>1160</width>
                        <height>647</height>
                        <top>32</top>
                        <texture colordiffuse="Fallback" border="5" background="true">common/box.png</texture>
                    </control>
                </control>
                <control type="wraplist" id="508">
                    <visible>$EXP[Exp_View_508]</visible>
                    <top>217</top>
                    <left>-20</left>
                    <width>1980</width>
                    <height>646</height>
                    <onleft condition="!Skin.HasSetting(global.kioskmode)">9000</onleft>
                    <onright>1600</onright>
                    <onup>500</onup>
                    <ondown>500</ondown>
                    <preloaditems>2</preloaditems>
                    <pagecontrol>1600</pagecontrol>
                    <orientation>vertical</orientation>
                    <viewtype label="31265">list</viewtype>
                    <include>ScrolltimeViewsList</include>
                    <itemlayout height="646" width="1900">
                        <include>View_508_Layout</include>
                    </itemlayout>
                    <focusedlayout height="646" width="1900">
                        <include>View_508_Layout</include>
                    </focusedlayout>
                </control>
                <control type="image">
                    <left>10</left>
                    <top>216</top>
                    <right>SidePad</right>
                    <bottom>216</bottom>
                    <texture colordiffuse="Box2" border="4" background="true" infill="false">common/box21.png</texture>
                    <visible>Skin.HasSetting(global.showborders)</visible>
                </control>
				<include content="Furniture_Scrollbar">
				    <param name="id" value="1600" />
				    <param name="height" value="648"/>
				</include>
            </control>
            <control type="group">
                <include content="IndicatorPoster" condition="!Skin.HasSetting(hide.markers)">
                    <param name="right" value="71" />
                    <param name="top" value="207" />
                </include>
                <control type="group">
                    <visible>!Skin.HasSetting(508.noscrolling)</visible>
                    <left>109</left>
                    <top>217</top>
                    <include>View_508_Content</include>
                </control>
                <include>PosterDiscCase</include>
                <control type="image">
                    <include>Animation.DelayFadeIn</include>
                    <top>190</top>
                    <left>930</left>
                    <include>arrowdimensions</include>
                    <texture colordiffuse="Dark2" flipy="true">common/arrow-small.png</texture>
                    <animation effect="zoom" center="auto" pulse="true" start="100" end="170" time="200" delay="2000" condition="ListItem.IsParentFolder">Conditional</animation>
                </control>
                <control type="image">
                    <include>Animation.DelayFadeIn</include>
                    <top>875</top>
                    <left>930</left>
                    <include>arrowdimensions</include>
                    <texture colordiffuse="Dark2" flipy="false">common/arrow-small.png</texture>
                    <animation effect="zoom" center="auto" pulse="true" start="100" end="170" time="200" delay="2000" condition="ListItem.IsParentFolder">Conditional</animation>
                </control>
            </control>
        </control>
    </include>
</includes>