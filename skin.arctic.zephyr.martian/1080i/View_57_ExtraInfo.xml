<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include name="View_57_ExtraInfo">
        <description>List View (id=57)</description>
        <control type="group">
            <include>Animation.Common</include>
            <visible>Control.IsVisible(57)</visible>
            <control type="group">
                <control type="list" id="57">
                    <visible>$EXP[Exp_View_57]</visible>
                    <top>PosterPad</top>
                    <height>PosterH</height>
                    <right>SidePad</right>
                    <width>1100</width>
                    <onleft condition="!Skin.HasSetting(global.kioskmode)">9000</onleft>
                    <onright>1612</onright>
                    <onup>57</onup>
                    <ondown>57</ondown>
                    <pagecontrol>1612</pagecontrol>
                    <viewtype label="31147">list</viewtype>
                    <include>ScrolltimeViewsList</include>
                    <itemlayout condition="!$EXP[ShowListInfo57]" width="1100" height="64">
                        <include>50itemlayout</include>
                    </itemlayout>
                    <focusedlayout condition="!$EXP[ShowListInfo57]" width="1100" height="64">
                        <include>50focuslayout</include>
                    </focusedlayout>
                    <itemlayout condition="$EXP[ShowListInfo57]" width="1100" height="91">
                        <include>50itemlayout_info</include>
                    </itemlayout>
                    <focusedlayout condition="$EXP[ShowListInfo57]" width="1100" height="91">
                        <include>50focuslayout_info</include>
                    </focusedlayout>
                </control>
                <include content="Furniture_Scrollbar">
                    <param name="id" value="1612" />
                </include>
            </control>
            <include content="Fanart_Info">
                <param name="posx" value="70"/>
            </include>
        </control>
    </include>

    <include name="View_57_ExtraInfo_LowList">
        <description>List View (id=57)</description>
        <control type="group">
            <include>Animation.Common</include>
            <visible>Control.IsVisible(57)</visible>
            <control type="group">
                <include content="def_top" condition="$EXP[ShowListInfo57]">
                    <param name="top" value="370" />
                </include>
                <top>320</top>
                <control type="fixedlist" id="57">
                    <visible>$EXP[Exp_View_57]</visible>
                    <top>PosterPad</top>
                    <include content="def_height" condition="$EXP[ShowListInfo57]">
                        <param name="height" value="270" />
                    </include>
                    <height>320</height>
                    <right>SidePad</right>
                    <width>1100</width>
                    <onleft condition="!Skin.HasSetting(global.kioskmode)">9000</onleft>
                    <onright>60</onright>
                    <onup>57</onup>
                    <ondown>57</ondown>
                    <include content="def_focusposition" condition="$EXP[ShowListInfo57]">
                        <param name="focusposition" value="1" />
                    </include>
                    <focusposition>2</focusposition>
                    <include content="def_movement" condition="$EXP[ShowListInfo57]">
                        <param name="movement" value="1" />
                    </include>
                    <movement>2</movement>
                    <pagecontrol>60</pagecontrol>
                    <viewtype label="31147">list</viewtype>
                    <include>ScrolltimeViewsList</include>
                    <itemlayout condition="!$EXP[ShowListInfo57]" width="1100" height="64">
                        <include>50itemlayout</include>
                    </itemlayout>
                    <focusedlayout condition="!$EXP[ShowListInfo57]" width="1100" height="64">
                        <control type="group">
                            <visible>Control.HasFocus(57)</visible>
                            <include>50focuslayout</include>
                        </control>
                        <control type="group">
                            <visible>!Control.HasFocus(57)</visible>
                            <include>50itemlayout</include>
                        </control>
                    </focusedlayout>
                    <itemlayout condition="$EXP[ShowListInfo57]" width="1100" height="90">
                        <include>50itemlayout_info</include>
                    </itemlayout>
                    <focusedlayout condition="$EXP[ShowListInfo57]" width="1100" height="90">
                        <control type="group">
                            <visible>Control.HasFocus(57)</visible>
                            <include>50focuslayout_info</include>
                        </control>
                        <control type="group">
                            <visible>!Control.HasFocus(57)</visible>
                            <include>50itemlayout_info</include>
                        </control>
                    </focusedlayout>
                </control>
                <include content="Furniture_Scrollbar" condition="$EXP[ShowListInfo57]">
                    <param name="top" value="216"/>
                    <param name="height" value="270"/>
                </include>
                <include content="Furniture_Scrollbar" condition="!$EXP[ShowListInfo57]">
                    <param name="top" value="216"/>
                    <param name="height" value="325"/>
                </include>
            </control>
            <include content="LowList_Info" condition="$EXP[ShowListInfo57]">
                <param name="left" value="70"/>
                <param name="bottom" value="165"/>
                <param name="group_height" value="298"/>
            </include>
            <include content="LowList_Info" condition="!$EXP[ShowListInfo57]">
                <param name="left" value="70"/>
            </include>
        </control>
    </include>

    <include name="LowList_Info">
        <param name="bottom" default="199"/>
        <param name="group_height" default="332"/>
        <definition>
        <control type="group">
            <left>$PARAM[left]</left>
            <width>642</width>
            <bottom>$PARAM[bottom]</bottom>
            <height>660</height>
            <control type="group">
                <left>12</left>
                <right>12</right>
                <posy>319</posy>
                <height>$PARAM[group_height]</height>
                <control type="label">
                    <top>10</top>
                    <aligny>center</aligny>
                    <height>64</height>
                    <font>MediumBold</font>
                    <textcolor>Dark1</textcolor>
                    <selectedcolor>Dark1</selectedcolor>
                    <label>$VAR[LabelDirector]</label>
                </control>
                <control type="label">
                    <top>50</top>
                    <height>64</height>
                    <aligny>center</aligny>
                    <font>Tiny</font>
                    <textcolor>Dark1</textcolor>
                    <selectedcolor>Dark1</selectedcolor>
                    <label>$VAR[LabelGenre]</label>
                </control>
                <control type="textbox">
                    <top>124</top>
                    <bottom>25</bottom>
                    <align>justify</align>
                    <font>TinyPlot</font>
                    <textcolor>Dark2</textcolor>
                    <selectedcolor>Dark1</selectedcolor>
                    <label>$VAR[LabelPlotBox]</label>
                </control>
            </control>
        </control>
        </definition>
    </include>

    <include name="Fanart_Info">
        <param name="top" value="$PARAM[top]" default="206"/>
        <param name="width_condition" value="$PARAM[width_condition]" default="$EXP[ShowProgressInfo]"/>
        <param name="visible" value="$PARAM[visible]" default="true"/>
        <param name="visible_progress" value="$PARAM[visible_progress]" default="true"/>
        <param name="infobox_height" value="$PARAM[infobox_height]" default="300"/>
        <definition>
        <control type="group">
            <left>$PARAM[posx]</left>
            <width>642</width>
            <top>$PARAM[top]</top>
            <height>660</height>
            <control type="group">
                <height>370</height>
                <visible>[!Skin.HasSetting(57list.low) + Control.IsVisible(57)] | !Control.IsVisible(57)</visible>
                <visible>[!Skin.HasSetting(56media.low) + Control.IsVisible(56)] | !Control.IsVisible(56)</visible>
                <control type="group">
                    <visible>$PARAM[visible]</visible>
                    <control type="image">
                        <width>100%</width>
                        <height>100%</height>
                        <texture border="10" infill="false">common/$VAR[nofocus-shadow10]</texture>
                    </control>
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <right>10</right>
                        <bottom>10</bottom>
                        <texture colordiffuse="Fallback" border="4" background="true">common/diffuse_box.png</texture>
                    </control>
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <right>10</right>
                        <bottom>10</bottom>
                        <fadetime>PosterFanartFadetime</fadetime>
                        <aspectratio align="center" aligny="center" scalediffuse="false">scale</aspectratio>
                        <texture diffuse="diffuse/widgetfanart_new.png" background="true" fallback="$VAR[Image_Fallback_Icon]">$VAR[LandscapeImage_Parent]</texture>
                    </control>
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <right>10</right>
                        <bottom>10</bottom>
                        <texture colordiffuse="Box2" border="4" background="true" infill="false">common/box21.png</texture>
                        <visible>Skin.HasSetting(global.showborders)</visible>
                    </control>
                </control>
            </control>
            <control type="group">
                <left>10</left>
                <right>10</right>
                <posy>370</posy>
                <height>$PARAM[infobox_height]</height>
                <control type="group">
                    <visible>$PARAM[width_condition]</visible>
                    <width>520</width>
                    <control type="label">
                        <top>8</top>
                        <aligny>center</aligny>
                        <height>64</height>
                        <font>MediumBold</font>
                        <textcolor>Dark1</textcolor>
                        <selectedcolor>Dark1</selectedcolor>
                        <label>$VAR[LabelDirector]</label>
                    </control>
                    <control type="label">
                        <top>48</top>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>Tiny</font>
                        <textcolor>Dark1</textcolor>
                        <selectedcolor>Dark1</selectedcolor>
                        <label>$VAR[LabelGenre]</label>
                    </control>
                </control>
                <control type="group">
                    <visible>!$PARAM[width_condition]</visible>
                    <width>100%</width>
                    <control type="label">
                        <top>8</top>
                        <aligny>center</aligny>
                        <height>64</height>
                        <font>MediumBold</font>
                        <textcolor>Dark1</textcolor>
                        <selectedcolor>Dark1</selectedcolor>
                        <label>$VAR[LabelDirector]</label>
                    </control>
                    <control type="label">
                        <top>48</top>
                        <height>64</height>
                        <aligny>center</aligny>
                        <font>Tiny</font>
                        <textcolor>Dark1</textcolor>
                        <selectedcolor>Dark1</selectedcolor>
                        <label>$VAR[LabelGenre]</label>
                    </control>
                </control>
                <control type="textbox">
                    <top>126</top>
                    <bottom>25</bottom>
                    <align>justify</align>
                    <font>TinyPlot</font>
                    <textcolor>Dark2</textcolor>
                    <selectedcolor>Dark1</selectedcolor>
                    <label>$VAR[LabelPlotBox]</label>
                </control>
            </control>
            <control type="group">
                <top>360</top>
                <left>526</left>
                <width>155</width>
                <height>155</height>
                <visible>$EXP[ShowProgressInfo] + !ListItem.IsParentFolder + !String.IsEqual(ListItem.DBType,set) + !Window.IsVisible(MyMusicNav.xml) + $PARAM[visible_progress]</visible>
                <control type="group">
                    <control type="image" description="Back">
                        <centertop>44%</centertop>
                        <width>139</width>
                        <height>139</height>
                        <texture diffuse="diffuse/diffuse_progress.png" border="0">progress/back3.png</texture>
                    </control>
                    <control type="group">
                        <visible>!ListItem.IsParentFolder + [Container.Content(movies) | Container.Content(episodes)]</visible>
                        <include>Animation.SwitchText</include>
                        <control type="image">
                            <visible>ListItem.IsResumable</visible>
                            <centertop>44%</centertop>
                            <width>139</width>
                            <height>139</height>
                            <texture diffuse="diffuse/diffuse_progress.png" colordiffuse="$VAR[ColorHighlight]">$INFO[ListItem.PercentPlayed,progress/circle/p,.png]</texture>
                        </control>
                        <control type="image">
                            <visible>String.Contains(ListItem.Overlay,OverlayWatched.png) + !ListItem.IsResumable</visible>
                            <centertop>44%</centertop>
                            <width>139</width>
                            <height>139</height>
                            <texture diffuse="diffuse/diffuse_progress.png" colordiffuse="$VAR[ColorHighlight]">progress/circle/p100.png</texture>
                        </control>
                    </control>
                </control>
                <control type="image">
                    <visible>!ListItem.IsParentFolder + [Container.Content(tvshows) | Container.Content(seasons)]</visible>
                    <width>139</width>
                    <height>139</height>
                    <centertop>44%</centertop>
                    <texture diffuse="diffuse/diffuse_progress.png" colordiffuse="$VAR[ColorHighlight]">$VAR[Def_PercentWatched,progress/circle/p,.png]</texture>
                    <visible>String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)</visible>
                    <include>Animation.SwitchText</include>
                </control>
                <control type="label">
                    <include>Animation.SwitchText</include>
                    <width>140</width>
                    <centertop>43%</centertop>
                    <align>center</align>
                    <label>$VAR[ProgressCircleLabel]</label>
                    <font>Progress</font>
                    <textcolor>Dark2</textcolor>
                </control>
            </control>
        </control>
        </definition>
    </include>
</includes>