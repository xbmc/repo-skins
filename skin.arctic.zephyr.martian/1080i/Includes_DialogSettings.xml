		</control>
		<control type="group" id="102">
			<height>70</height>
			<width>100%</width>
			<visible>Player.TempoEnabled</visible>
			<control type="button" id="1002">
				<onup>101</onup>
				<ondown>103</ondown>
                <onfocus condition="Player.Rewinding | Player.Forwarding">PlayerControl(Play)</onfocus>
                <onleft condition="Player.Paused">PlayerControl(Play)</onleft>
                <onright condition="Player.Paused">PlayerControl(Play)</onright>
                <onleft>PlayerControl(TempoDown)</onleft>
                <onright>PlayerControl(TempoUp)</onright>
				<width>800</width>
				<height>70</height>
				<align>left</align>
				<include>DefContextButtonGradient</include>
				<label>31907</label>
			</control>
			<include content="Def_Tempo_Setting">
				<param name="textcolor" value="Black70" />
				<param name="slidercolor" value="Black12" />
				<param name="visible" value="!Control.HasFocus(1002)" />
			</include>
			<include content="Def_Tempo_Setting">
				<param name="textcolor" value="Selected" />
				<param name="slidercolor" value="Dark2" />
				<param name="visible" value="Control.HasFocus(1002)" />
			</include>
		</control>
