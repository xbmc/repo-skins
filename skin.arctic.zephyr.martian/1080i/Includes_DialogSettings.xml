	<include name="DialogVideoSettingsContent">
		<control type="button" id="101">
			<align>left</align>
			<width>800</width>
			<textwidth>580</textwidth>
			<include>DefContextButtonGradient</include>
			<label>38031</label>
			<label2>$INFO[VideoPlayer.VideoResolution,, ]$VAR[HDSD]$VAR[Label_Video_Codec,  •  ,]$VAR[Label_Video_Aspect,  •  ,]$VAR[Label_Video_3D,  •  ,]$VAR[Label_Video_HdrType_Detailed,  •  ,]</label2>
			<onclick>DialogSelectVideo</onclick>
