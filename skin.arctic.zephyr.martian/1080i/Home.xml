<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<window id="0">
    <defaultcontrol>300</defaultcontrol>
    <backgroundcolor>0</backgroundcolor>
    <include>Blur_OnLoad_Action</include>
    <include>Generator_BuildViewTypes_Onload</include>
    <onload>RunScript(script.skinshortcuts,type=buildxml)</onload>
    <onload>Skin.SetString(Wikipedia.Format.Link,[COLOR=$VAR[ColorHighlight]]{}[/COLOR])</onload>
    <onload condition="[!$EXP[HomeIsMultiWidgets] | $EXP[HomeIsCleanMinimal]] + !Window.Previous(1190)">SetFocus(300)</onload>
    <onload condition="!$EXP[HomeIsMultiWidgets]">SetProperty(TMDbHelper.WidgetContainer,301,home)</onload>
    <onload>ClearProperty(TMDbHelper.HideView,Home)</onload>
    <onunload>ClearProperty(TMDbHelper.WidgetContainer,home)</onunload>
    <onunload condition="Skin.HasSetting(home.netflix.autoplay.trailer)">ClearProperty(listitem.trailer,home)</onunload>
    <controls>
        <include>GlobalBackground</include>

        <!-- Hidden Lists -->
        <include>HomeBackgroundPlaylist</include>
        <include>MovieSetInfo</include>
        <include>AlbumInfo</include>

        <!-- Other Menus And Widgets -->
        <include condition="$EXP[HomeIsVerticalMultiWidgets]">HomeVerticalMenuWidgets</include>
        <include condition="$EXP[HomeIsVertical]">HomeVerticalMenu</include>
        <include condition="$EXP[HomeIsSpotlight]">HomeWidgetInfo</include>
        <include condition="$EXP[HomeIsClassic]">HomeClassicWidgets</include>
    
        <!-- Fade Out On HomeIsModernMultiWidgets -->
        <control type="group">
            <include condition="$EXP[HomeIsModernMultiWidgets]">Animation.HomeIsModernMultiWidgets</include>
            <include condition="$EXP[HomeIsModernMultiWidgets]">HomeWidgetInfoWidgets</include>
            <include condition="!Skin.HasSetting(home.vertical)">HomeHeader</include>
            <include condition="!Skin.HasSetting(home.vertical) | Skin.HasSetting(homemenu.netflix)">HomeNextRecording</include>
            <include condition="[!Skin.HasSetting(home.vertical) | Skin.HasSetting(homemenu.netflix)] + !Skin.HasSetting(home.hide.nowplaying)">HomeNowPlaying</include>
        	<include condition="![Skin.HasSetting(home.vertical) | $EXP[HomeIsModernMultiWidgets]] | Skin.HasSetting(homemenu.netflix)">HomeWeatherWidget</include>
        </control>
        
        <control type="group">
            <include condition="$EXP[HomeIsModernMultiWidgets]">Animation.FadeHomeRow</include>
            <include condition="!Skin.HasSetting(home.vertical) + !Skin.HasSetting(home.classicwidgets)">HomeRow</include>
        </control>
        
        <!-- Submenus -->
        <include condition="!Skin.HasSetting(home.vertical) + Skin.HasSetting(home.submenu2) + !Skin.HasSetting(home.showicons)">HomeSubMenu2</include>
        <include condition="!Skin.HasSetting(home.vertical) + [!Skin.HasSetting(home.submenu2) | Skin.HasSetting(home.showicons)] | Skin.HasSetting(home.vertical) + $EXP[HomeMenuShowIconsOnly]">HomeSubMenu</include>

        <!-- Background And Furniture For Dialogs -->
        <control type="group">
            <include>Animation.FadeIn</include>
            <include>Animation.FadeOut</include>
			<include>Animation.BackgroundHideView</include>
            <visible>$EXP[InfoDialogsActive]</visible>
            <include condition="$EXP[InfoDialogsExtendedBackground]">GlobalBackgroundExtended</include>
        </control>
    </controls>
</window>