<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include name="View_514_Albums">
        <description>List View (id=514)</description>
        <control type="group">
            <include>Animation.Common</include>
            <visible>Control.IsVisible(514)</visible>
            <control type="group">
                <control type="label">
                    <visible>Skin.HasSetting(NotShowClearart514) | [!$EXP[TitleClearlogoAvailable] + !Skin.HasSetting(NotShowClearart514)]</visible>
                    <top>220</top>
                    <include condition="!Skin.HasSetting(514NoCenter)">CenterInfo</include>
                    <left>SidePad</left>
                    <description>Header Label</description>
                    <textcolor>Dark1</textcolor>
                    <font>MediumBold</font>
                    <label fallback="19055">$VAR[Label_View_514_Title]</label>
                </control>
                <control type="image" description="clearlogo">
                    <animation effect="slide" start="0,0" end="-735,0" time="200" condition="Skin.HasSetting(514NoCenter)">Conditional</animation>
                    <visible>!Skin.HasSetting(NotShowClearart514) + $EXP[TitleClearlogoAvailable]</visible>
                    <top>180</top>
                    <height>ClearLogoMaxHeight</height>
                    <width>ClearLogoMaxWidth</width>
                    <centerleft>50%</centerleft>
                    <aspectratio align="center" aligny="top">keep</aspectratio>
                    <texture background="true">$VAR[ClearLogoTopVar]</texture>
                    <fadetime>ClearArtFadetime</fadetime>
                </control>
                <control type="grouplist">
                    <visible>!ListItem.IsParentFolder + ![$EXP[IsVideoAssets] + String.IsEmpty(ListItem.DBTYPE)]</visible>
                    <left>SidePad</left>
                    <top>620</top>
                    <height>600</height>
                    <itemgap>15</itemgap>
                    <orientation>vertical</orientation>
                    <control type="label">
                        <height>36</height>
                        <font>Tiny</font>
                        <animation effect="slide" start="0,0" end="100,0" time="200" condition="!Skin.HasSetting(514NoCenter)">Conditional</animation>
                        <include condition="!Skin.HasSetting(514NoCenter)">CenterInfo</include>
                        <textcolor>Dark1</textcolor>
                        <label fallback="19055">$VAR[Label_View_514_GenreAlbum]</label>
                    </control>
                    <control type="textbox">
                        <visible>[!String.IsEmpty(ListItem.Property(Artist_Description)) + Container.Content(artists)] | [!String.IsEmpty(ListItem.Property(Album_Description)) + Container.Content(albums)] | [!String.IsEmpty(ListItem.Plot) + [Container.Content(movies) | Container.Content(tvshows) | Container.Content(sets) | Container.Content(episodes) | Container.Content(seasons) | Container.Content(musicvideos) | $EXP[IsVideoAssets]]] | [!String.IsEmpty(Container.ShowPlot) + Container.Content(seasons)]</visible>
                        <left>SidePad</left>
                        <include condition="!Skin.HasSetting(514NoCenter)">CenterInfo</include>
                        <animation effect="slide" start="0,0" end="100,0" time="200" condition="!Skin.HasSetting(514NoCenter)">Conditional</animation>
                        <font>Tiny</font>
                        <height min="36" max="103">auto</height>
                        <textcolor>Dark2</textcolor>
                        <selectedcolor>Dark2</selectedcolor>
                        <label>$VAR[LabelArtistAlbumDescription]</label>
                    </control>
                    <control type="label">
                        <height>36</height>
                        <font>Tiny</font>
                        <animation effect="slide" start="0,0" end="100,0" time="200" condition="!Skin.HasSetting(514NoCenter)">Conditional</animation>
                        <include condition="!Skin.HasSetting(514NoCenter)">CenterInfo</include>
                        <textcolor>Dark2</textcolor>
                        <label>$VAR[Label_View_514_YearDurationRating]</label>
                    </control>
                </control>
            </control>
            <include content="Furniture_Scrollbar_Horizontal">
                <param name="id" value="1617" />
                <param name="bottom" value="474"/>
            </include>
	        <control type="list" id="514">
		        <visible>$EXP[Exp_View_514]</visible>
		        <top>306</top>
		        <left>70</left>
		        <width>1800</width>
		        <height>330</height>
		        <onup condition="!Skin.HasSetting(global.kioskmode)">9000</onup>
		        <ondown>1617</ondown>
		        <onleft>514</onleft>
		        <onright>514</onright>
		        <preloaditems>1</preloaditems>
		        <pagecontrol>1617</pagecontrol>
		        <orientation>horizontal</orientation>
		        <viewtype label="31240">list</viewtype>
		        <include>ScrolltimeViewsList</include>
		        <itemlayout height="330" width="299.66">
		            <control type="group">
		                <top>5</top>
		                <height>280</height>
		                <width>280</width>
		                <include content="include.widget.thumb">
		                    <param name="id" value="514"/>
		                    <param name="height" value="280"/>
		                    <param name="top" value="260"/>
		                    <param name="reflections" value="Skin.HasSetting(show.reflections)"/>
		                </include>
		            </control>
		        </itemlayout>
		        <focusedlayout height="330" width="299.66">
		            <control type="group">
		                <top>5</top>
		                <height>280</height>
		                <width>280</width>
		                <include content="include.widget.thumb">
		                    <param name="id" value="514"/>
		                    <param name="height" value="280"/>
		                    <param name="top" value="260"/>
		                    <param name="reflections" value="Skin.HasSetting(show.reflections)"/>
		                    <param name="focused" value="true" />
		                </include>
		            </control>
		        </focusedlayout>
	        </control>
        </control>
    </include>
</includes>
