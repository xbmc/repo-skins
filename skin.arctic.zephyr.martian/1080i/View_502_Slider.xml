<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include name="View_502_Slider">
        <control type="group">
            <include>Animation.Common</include>
            <visible>Control.IsVisible(502)</visible>
            <control type="group">
                <top>PosterPad</top>
                <left>SidePad</left>
                <right>SidePad</right>
                <height>640</height>
                <control type="image">
                    <left>-8</left>
                    <right>-8</right>
                    <top>-8</top>
                    <bottom>-8</bottom>
                    <texture border="15" colordiffuse="Panel">common/rounded-shadow8.png</texture>
                </control>
                <control type="image">
                    <aspectratio scalediffuse="false">scale</aspectratio>
                    <animation effect="fade" start="100" end="33" time="0" condition="true">Conditional</animation>
                    <texture border="5" colordiffuse="Panel" diffuse="diffuse/wall-fanart.png">$VAR[LandscapeImage]</texture>
                </control>                
                <control type="wraplist" id="502">
                    <top>0</top>
                    <left>0</left>
                    <width>1760</width>
                    <right>0</right>
                    <top>0</top>
                    <bottom>0</bottom>
                    <onup condition="!Skin.HasSetting(global.kioskmode)">9000</onup>
                    <ondown>1641</ondown>
                    <focusposition>0</focusposition>
                    <onleft>51</onleft>
                    <onright>51</onright>
                    <preloaditems>0</preloaditems>
                    <pagecontrol>1641</pagecontrol>
                    <orientation>horizontal</orientation>
                    <viewtype label="31525">list</viewtype>
                    <include>ScrolltimeViewsList</include>
                    <itemlayout height="640" width="1452">
                        <control type="image">
                            <top>0</top>
                            <right>-330</right>
                            <height>648</height>
                            <aspectratio scalediffuse="true">keep</aspectratio>
                            <texture background="true" diffuse="diffuse/lovefilmthumb.png">$VAR[LandscapeImage]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout height="640" width="1452">
                        <control type="image">
                            <top>0</top>
                            <right>-330</right>
                            <height>648</height>
                            <aspectratio scalediffuse="true">keep</aspectratio>
                            <texture background="true" diffuse="diffuse/lovefilmthumb.png">$VAR[LandscapeImage]</texture>
                        </control>
                    </focusedlayout>
                </control>
                <control type="image">
                    <left>0</left>
                    <right>0</right>
                    <bottom>0</bottom>
                    <height>70</height>
                    <texture border="15" colordiffuse="df000000">common/white.png</texture>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1760</width>
                    <height>640</height>
                    <texture colordiffuse="Box2" border="4" background="true" infill="false">common/box21.png</texture>
                    <visible>Skin.HasSetting(global.showborders)</visible>
                </control>
                <control type="group">
                    <left>30</left>
                    <right>100</right>
                    <top>560</top>
                    <bottom>30</bottom>
                    <control type="label">
                        <top>10</top>
                        <aligny>center</aligny>
                        <height>64</height>
                        <font>Tiny</font>
                        <scroll>true</scroll>
                        <textcolor>PanelWhite70</textcolor>
                        <selectedcolor>PanelWhite70</selectedcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <top>10</top>
                        <align>right</align>
                        <height>64</height>
                        <font>Tiny</font>
                        <scroll>true</scroll>
                        <textcolor>PanelWhite70</textcolor>
                        <selectedcolor>PanelWhite70</selectedcolor>
                        <label>$INFO[ListItem.Size]</label>
                        <right>-60</right>
                    </control>
                </control>
            </control>            
            <include content="Furniture_Scrollbar_Horizontal">
                <param name="id" value="1641" />
                <param name="jumpbar" value="false" />
            </include>
        </control>
    </include>
</includes>