<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<!-- Groove / Home TV row, step 3 (nothing in progress): unwatched episodes, no specials, newest first.
     Better than videodb://recentlyaddedepisodes/, which also lists watched episodes.
     Own name on purpose: _src/fork_engine.py rewrites groove_new_episodes.xsp from Nocturne. -->
<smartplaylist type="episodes">
    <name>New episodes</name>
    <match>all</match>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <rule field="season" operator="greaterthan">
        <value>0</value>
    </rule>
    <limit>24</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
