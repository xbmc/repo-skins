<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="skin.groove" version="1.0.11" name="Groove" provider-name="KarmaMole">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<!-- Required (Omar, 2026-10-21): encodes the Search query for the library paths (get_encoded_string with
		     unencoded_paths, which arrived in 2.1.21; the official repository carries 2.1.33, Omar's box 2.2.9). -->
		<import addon="script.skinvariables" version="2.1.21"/>
		<!-- Optional (SPEC 15): every one is guarded with System.AddonIsEnabled / HasAddon and has a fallback. -->
		<!-- Film / TV / music colours, blur, TV next up, trailers. 4.0.0 = no newer than the official repo (LESSONS). -->
		<import addon="plugin.video.themoviedb.helper" version="4.0.0" optional="true"/>
		<!-- script.karmamole.helper and service.vizpalette are imported once they are published (M6): an optional import
		     of an add-on no repository carries is flagged by the official review. The skin guards them already. -->
	</requires>
	<extension point="xbmc.gui.skin" debugging="false" effectslowdown="1">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080i"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Groove - the record collector's skin. The art is the only light.</summary>
		<description lang="en_GB">A near-black listening room (or a warm paper one by day) where whatever has focus glows and tints the room in its own colours. Thin line icons that say one word when you land on them. Music first: flip through a crate, a cover wall, a shelf of spines or an arc of sleeves, travel the collection by decade, spin a wheel of genres, and watch the record slide out of its sleeve and turn. Films and TV get the same cinema glow. Built for the NVIDIA Shield (Kodi 21 Omega).</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/KarmaMole/kodi-skins</source>
		<website>https://karmamole.github.io/kodi-skins/#groove</website>
		<news>v1.0.11 - Wheel, set and subtitle counts say "1 album", "1 film", "1 result".&#10;v1.0.10 - Empty pages no longer print "Nothing here yet" over the Back tile.</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
			<screenshot>resources/screenshot-06.jpg</screenshot>
		</assets>
	</extension>
</addon>
