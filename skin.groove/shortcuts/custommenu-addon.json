{
    "infolabels": {
        "path": "Skin.String(CustomMenu.{item}.Path)"
    },
    "operations": [
        {
            "regex": {
                "path": {
                    "regex": "(?is)^\\s*RunScript\\(\\s*\"?script://",
                    "value": "RunScript(",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "path": {
                    "regex": "(?is)^\\s*RunScript\\(\\s*\"?([^\",)/\\s]+)/?\"?\\s*\\)\\s*$",
                    "value": "RunAddon(\\1)",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "path": {
                    "regex": "(?is)^\\s*PlayMedia\\(\\s*\"?favourites://\"?\\s*\\)\\s*$",
                    "value": "ActivateWindow(favouritesbrowser)",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "addon_a": {
                    "regex": "(?is)^.*?plugin://([^/?\"\\s,)]+).*$",
                    "value": "\\1",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "addon_a": {
                    "regex": "(?s)^.*[(/:\\s\"',].*$",
                    "value": "",
                    "input": "{addon_a}"
                }
            }
        },
        {
            "regex": {
                "addon_b": {
                    "regex": "(?is)^\\s*run(?:addon|script)\\(\\s*\"?([^\",)/\\s]+)/?\"?\\s*[,)].*$",
                    "value": "\\1",
                    "input": "{path}"
                }
            }
        },
        {
            "regex": {
                "addon_b": {
                    "regex": "(?s)^.*[(/:\\s\"',].*$",
                    "value": "",
                    "input": "{addon_b}"
                }
            }
        },
        {
            "regex": {
                "addon": {
                    "regex": "^$",
                    "value": "{addon_b}",
                    "input": "{addon_a}"
                }
            }
        }
    ],
    "actions": [
        [
            {
                "rules": [
                    "!String.IsEmpty(Skin.String(CustomMenu.{item}.Path))"
                ],
                "value": [
                    "Skin.SetString(CustomMenu.{item}.Path,{path})"
                ]
            }
        ],
        [
            {
                "rules": [
                    "{addon}!="
                ],
                "value": [
                    "Skin.SetString(CustomMenu.{item}.Addon,{addon})"
                ]
            },
            {
                "rules": [
                    "{addon}=="
                ],
                "value": [
                    "Skin.Reset(CustomMenu.{item}.Addon)"
                ]
            }
        ]
    ]
}
