<?xml version="1.0" encoding="UTF-8"?>
<!--
	TV / Radio timers and timer rules (Kodi uses this file for TVTimers, TVTimerRules, RadioTimers,
	RadioTimerRules). SPEC 5: Minimal. Builder F, M4.
	Kodi id contract (Estuary Omega MyPVRTimers.xml + GUIWindowPVRBase.h): view container 50,
	menucontrol 9000, sort 3 / 4, header labels 29 / 30, hide-disabled radio 8.
-->
<window>
	<defaultcontrol always="true">9100</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<views>50</views>
	<controls>
		<include>Groove_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Misc_PVRFrame">
				<param name="title" value="$VAR[Misc_PVRTimersTitle]"/>
				<param name="options" value="Misc_PVROptions_Timers"/>
			</include>
			<include content="Misc_PVRList">
				<param name="label2" value="$INFO[ListItem.Date]"/>
				<param name="empty_label" value="$LOCALIZE[31925]"/>
			</include>
			<control type="label">
				<left>list_panel_x</left>
				<top>1010</top>
				<width>list_panel_w</width>
				<height>28</height>
				<font>font_fact_label</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$INFO[PVR.NextTimer]</label>
			</control>
		</control>
	</controls>
</window>
