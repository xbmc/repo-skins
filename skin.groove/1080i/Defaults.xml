<?xml version="1.0" encoding="UTF-8"?>
<!--
	Control defaults (Kodi applies these to every control of the type unless overridden).
	Focus language (Groove M4): the lit row, groove/row_focus.png tinted ink (a 12 % band + a solid edge), readable in
	the Dark and the Light room; buttons that draw their own textures keep them.
	Colours are names from colors/defaults.xml; light = live accent (setting 1).
-->
<includes>
	<default type="image">
		<aspectratio>stretch</aspectratio>
	</default>
	<default type="label">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<selectedcolor>$VAR[ink]</selectedcolor>
		<align>left</align>
		<aligny>center</aligny>
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>
	<default type="fadelabel">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<align>left</align>
	</default>
	<default type="textbox">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<align>left</align>
	</default>
	<default type="button">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<alttexturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</alttexturefocus>
		<alttexturenofocus />
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<radiowidth>26</radiowidth>
		<radioheight>26</radioheight>
		<textureradioonfocus colordiffuse="$VAR[ink]">fork/dot_on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[ink]">fork/dot_on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="$VAR[line_strong]">fork/dot_off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="$VAR[line_strong]">fork/dot_off.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="white_40">fork/dot_on.png</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="white_40">fork/dot_off.png</textureradiooffdisabled>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<spinwidth>24</spinwidth>
		<spinheight>24</spinheight>
		<textureup colordiffuse="$VAR[ink2]">icons/chevron-right.png</textureup>
		<texturedown colordiffuse="$VAR[ink2]" flipx="true">icons/chevron-right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ink]">icons/chevron-right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ink]" flipx="true">icons/chevron-right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[disabled]">icons/chevron-right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[disabled]" flipx="true">icons/chevron-right.png</texturedowndisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<width>24</width>
		<height>24</height>
		<textureup colordiffuse="$VAR[ink2]">icons/chevron-right.png</textureup>
		<texturedown colordiffuse="$VAR[ink2]" flipx="true">icons/chevron-right.png</texturedown>
		<textureupfocus colordiffuse="$VAR[ink]">icons/chevron-right.png</textureupfocus>
		<texturedownfocus colordiffuse="$VAR[ink]" flipx="true">icons/chevron-right.png</texturedownfocus>
		<textureupdisabled colordiffuse="$VAR[disabled]">icons/chevron-right.png</textureupdisabled>
		<texturedowndisabled colordiffuse="$VAR[disabled]" flipx="true">icons/chevron-right.png</texturedowndisabled>
		<align>right</align>
		<reverse>yes</reverse>
		<subtype>text</subtype>
	</default>
	<default type="sliderex">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<sliderwidth>240</sliderwidth>
		<sliderheight>6</sliderheight>
		<texturesliderbar colordiffuse="$VAR[line_strong]">groove/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[line]">groove/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[ink2]">groove/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ink]">groove/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[disabled]">groove/white.png</textureslidernibdisabled>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
	</default>
	<default type="slider">
		<texturesliderbar colordiffuse="$VAR[line_strong]">groove/white.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="$VAR[line]">groove/white.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="$VAR[ink2]">groove/white.png</textureslidernib>
		<textureslidernibfocus colordiffuse="$VAR[ink]">groove/white.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="$VAR[disabled]">groove/white.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>
	<default type="colorbutton">
		<font>font13</font>
		<textcolor>$VAR[ink2]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus />
		<colorwidth>60</colorwidth>
		<colorheight>30</colorheight>
		<texturecolormask>groove/white.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="$VAR[disabled]">groove/white.png</texturecolordisabledmask>
		<textoffsetx>24</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="edit">
		<font>font13</font>
		<textcolor>$VAR[ink]</textcolor>
		<focusedcolor>$VAR[ink]</focusedcolor>
		<disabledcolor>$VAR[disabled]</disabledcolor>
		<invalidcolor>$VAR[ink]</invalidcolor>
		<texturefocus border="8,0,0,0" colordiffuse="$VAR[ink]">groove/row_focus.png</texturefocus>
		<texturenofocus border="10" colordiffuse="$VAR[line_strong]">common/rect_outline_1.png</texturenofocus>
		<textoffsetx>24</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="progress">
		<texturebg colordiffuse="$VAR[line_strong]">groove/white.png</texturebg>
		<lefttexture />
		<midtexture colordiffuse="$VAR[ink]">groove/white.png</midtexture>
		<righttexture />
		<overlaytexture />
	</default>
	<default type="scrollbar">
		<texturesliderbackground colordiffuse="$VAR[line]">groove/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="$VAR[ink2]">groove/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="$VAR[ink]">groove/white.png</texturesliderbarfocus>
		<textureslidernib />
		<textureslidernibfocus />
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>
	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
