<?xml version="1.0" encoding="UTF-8"?>
<!--
	Settings hub (window "settings"), the shared Groove "page" (SPEC 6, M4): the room, the window header (gear + word),
	one column of rows with a line icon each (Dlg_IndexListLayout: icon 40 at x 24, label, hint right) and, at the
	right, what the focused entry holds plus a few facts. No Kodi-owned ids; entries copied from Estuary Omega's
	Settings.xml, Groove's Skin settings first.
	Focus: list 9000 (rest); Up / Down walk it (wraps); Back closes (Kodi). No window-level animation (MOTION 3).
-->
<window>
	<defaultcontrol>9000</defaultcontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<controls>
		<include>Groove_Page</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Groove_TopBar">
				<param name="title" value="$LOCALIZE[5]"/>
				<param name="icon" value="icons/settings.png"/>
			</include>
			<control type="list" id="9000">
				<left>72</left>
				<top>150</top>
				<width>880</width>
				<height>896</height>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<include>Anim_ScrollRow</include>
				<include content="Dlg_IndexListLayout">
					<param name="width" value="880"/>
					<param name="height" value="64"/>
					<param name="list_id" value="9000"/>
				</include>
				<content>
					<item>
						<label>$LOCALIZE[31021]</label>
						<label2>$LOCALIZE[31024]</label2>
						<icon>icons/skin.png</icon>
						<property name="help">$LOCALIZE[31880]</property>
						<onclick>ActivateWindow(skinsettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14200]</label>
						<icon>icons/play.png</icon>
						<property name="help">$LOCALIZE[31881]</property>
						<onclick>ActivateWindow(PlayerSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14211]</label>
						<icon>icons/albums.png</icon>
						<property name="help">$LOCALIZE[31882]</property>
						<onclick>ActivateWindow(MediaSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14206]</label>
						<icon>icons/view.png</icon>
						<property name="help">$LOCALIZE[31883]</property>
						<onclick>ActivateWindow(InterfaceSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<icon>icons/addons.png</icon>
						<property name="help">$LOCALIZE[31884]</property>
						<onclick>ActivateWindow(addonbrowser)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14036]</label>
						<icon>icons/update.png</icon>
						<property name="help">$LOCALIZE[31885]</property>
						<onclick>ActivateWindow(ServiceSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13000]</label>
						<icon>icons/system.png</icon>
						<property name="help">$LOCALIZE[31886]</property>
						<onclick>ActivateWindow(SystemSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[10003]</label>
						<icon>icons/files.png</icon>
						<property name="help">$LOCALIZE[31887]</property>
						<onclick>ActivateWindow(filemanager)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[138]</label>
						<icon>icons/info.png</icon>
						<property name="help">$LOCALIZE[31888]</property>
						<onclick>ActivateWindow(systeminfo)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[31855]</label>
						<icon>icons/liner.png</icon>
						<property name="help">$LOCALIZE[31889]</property>
						<onclick>ActivateWindow(eventlog)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[13200]</label>
						<icon>icons/artists.png</icon>
						<property name="help">$LOCALIZE[31890]</property>
						<onclick>ActivateWindow(Profiles)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[14204]</label>
						<icon>icons/livetv.png</icon>
						<property name="help">$LOCALIZE[31891]</property>
						<onclick>ActivateWindow(PVRSettings)</onclick>
					</item>
					<item>
						<label>$LOCALIZE[15016]</label>
						<icon>icons/games.png</icon>
						<property name="help">$LOCALIZE[31892]</property>
						<onclick>ActivateWindow(GameSettings)</onclick>
						<visible>System.GetBool(gamesgeneral.enable)</visible>
					</item>
				</content>
			</control>
			<!-- what the focused entry holds -->
			<control type="group">
				<left>1104</left>
				<top>166</top>
				<width>720</width>
				<control type="label">
					<left>0</left>
					<top>0</top>
					<width>720</width>
					<height>48</height>
					<font>font_caption</font>
					<label>$INFO[Container(9000).ListItem.Label]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>64</top>
					<width>640</width>
					<height>160</height>
					<font>font_body</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[Container(9000).ListItem.Property(help)]</label>
				</control>
				<control type="group">
					<top>560</top>
					<include content="Dlg_FactRow"><param name="top" value="0"/><param name="label" value="Kodi"/><param name="value" value="$INFO[System.BuildVersion]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="48"/><param name="label" value="Groove"/><param name="value" value="$INFO[System.AddonVersion(skin.groove)]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="96"/><param name="label" value="$LOCALIZE[31894]"/><param name="value" value="$INFO[Network.IPAddress]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="144"/><param name="label" value="$LOCALIZE[31895]"/><param name="value" value="$INFO[System.ScreenResolution]"/><param name="valuew" value="520"/></include>
					<include content="Dlg_FactRow"><param name="top" value="192"/><param name="label" value="$LOCALIZE[31896]"/><param name="value" value="$INFO[System.Uptime]"/><param name="valuew" value="520"/></include>
				</control>
			</control>
		</control>
	</controls>
</window>
