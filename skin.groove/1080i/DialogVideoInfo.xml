<?xml version="1.0" encoding="UTF-8"?>
<!--
	Film / show / episode / collection information: cinema glow (screens/DialogVideoInfo.md, SPEC 10).
	Full-bleed backdrop drawn into the room, clearlogo (ink silhouette in Light), icon line (runtime, rating, 4K,
	HDR10 / DV / HLG, resume %), three lines of plot, icon buttons, cast row. Pieces: Includes_VideoInfo.xml.
	Kodi ids: 8 play / browse, 9 resume, 11 trailer, 50 cast; 6 7 10 12 13 14 15 offscreen (More card).
	Focus: opens on Resume (9) or Play (8); Down -> cast; More -> card (Back -> More); Read the plot -> page (Back ->
	More); Back on the buttons closes. No window-level animation: the room stays, the content fades in.
-->
<window>
	<defaultcontrol always="true">9930</defaultcontrol>
	<controls>
		<include>Groove_Room</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include>VidInfo_Stage</include>
			<include>VidInfo_Buttons</include>
			<include>VidInfo_Cast</include>
		</control>
		<include content="VidView_MiniPlayer">
			<param name="down" value="9930"/>
			<param name="back" value="9930"/>
		</include>
		<include>VidInfo_MoreCard</include>
		<include>VidInfo_ReadingPage</include>
	</controls>
</window>
