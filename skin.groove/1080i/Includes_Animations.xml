		<animation type="Visible" condition="Skin.HasSetting(groove.reducemotion)">
			<effect type="fade" start="0" end="100" time="80"/>
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="80"/>
		</animation>
	</include>

	<include name="Anim_GlowFadetime">
		<include condition="!Skin.HasSetting(groove.reducemotion)">Anim_GlowFadetime_Normal</include>
		<include condition="Skin.HasSetting(groove.reducemotion)">Anim_GlowFadetime_Reduced</include>
	</include>

	<include name="Anim_GlowFadetime_Normal">
		<fadetime>400</fadetime>
	</include>

	<include name="Anim_GlowFadetime_Reduced">
		<fadetime>150</fadetime>
	</include>

	<include name="Anim_ArtFadetime">
		<include condition="!Skin.HasSetting(groove.reducemotion)">Anim_ArtFadetime_Normal</include>
		<include condition="Skin.HasSetting(groove.reducemotion)">Anim_ArtFadetime_Reduced</include>
	</include>

	<include name="Anim_ArtFadetime_Normal">
		<fadetime>300</fadetime>
	</include>

	<include name="Anim_ArtFadetime_Reduced">
		<fadetime>120</fadetime>
	</include>

	<include name="Anim_GlowLayer">
		<animation type="Visible" condition="!Skin.HasSetting(groove.reducemotion)">
			<effect type="fade" start="0" end="100" time="400" tween="sine" easing="out"/>
		</animation>
		<animation type="Visible" condition="Skin.HasSetting(groove.reducemotion)">
			<effect type="fade" start="0" end="100" time="150"/>
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="in"/>
		</animation>
	</include>

	<include name="Anim_ScrollRow">
		<include condition="!Skin.HasSetting(groove.reducemotion)">Anim_ScrollRow_Normal</include>
		<include condition="Skin.HasSetting(groove.reducemotion)">Anim_Scroll_Reduced</include>
	</include>

	<include name="Anim_ScrollRow_Normal">
		<scrolltime tween="cubic" easing="out">200</scrolltime>
