	</include>

	<include name="Anim_ScrollPanel_Normal">
		<scrolltime tween="cubic" easing="out">220</scrolltime>
	</include>

	<include name="Anim_ScrollText">
		<include condition="!Skin.HasSetting(groove.reducemotion)">Anim_ScrollRow_Normal</include>
		<include condition="Skin.HasSetting(groove.reducemotion)">Anim_Scroll_Reduced</include>
	</include>

	<include name="Anim_Scroll_Reduced">
		<scrolltime>0</scrolltime>
	</include>

	<include name="Anim_HomeLift">
		<param name="open"/>
		<param name="lift" default="390"/>
		<param name="t" default="300"/>
		<definition>
			<animation type="Conditional" condition="[$PARAM[open]] + !Skin.HasSetting(groove.reducemotion)" reversible="true">
