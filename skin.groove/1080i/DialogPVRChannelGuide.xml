<?xml version="1.0" encoding="UTF-8"?>
<!--
	Programme list for one channel, opened from live TV (SPEC 5: Minimal). Builder F, M4.
	Kodi id contract (Estuary Omega DialogPVRChannelGuide.xml): list 11, scrollbar 60, header label 2.
-->
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>screen_w</width>
			<height>screen_h</height>
			<!-- own fades: without them Kodi draws this dim over the dialog (seen on Shield 2026-10-18) -->
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<texture colordiffuse="$VAR[dim_dialog]">groove/white.png</texture>
		</control>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_DialogCard</include>
			<control type="label" id="2">
				<description>header label</description>
				<left>page_margin</left>
				<top>topbar_item_top</top>
				<width>1300</width>
				<height>topbar_item_h</height>
				<font>font_title</font>
				<label>$LOCALIZE[19069]$INFO[Container(11).ListItem.StartDate,  ·  ,]</label>
			</control>
			<include>Groove_Clock</include>
			<include content="Groove_Rule">
				<param name="top" value="topbar_rule_y"/>
				<param name="color" value="$VAR[line]"/>
			</include>
			<control type="list" id="11">
				<left>page_margin</left>
				<top>168</top>
				<width>list_w</width>
				<height>858</height>
				<onup>11</onup>
				<ondown>11</ondown>
				<onleft>noop</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<include content="Misc_PVRRowLayouts">
					<param name="list_id" value="11"/>
					<param name="width" value="1080"/>
					<param name="number" value="$INFO[ListItem.StartTime]"/>
					<param name="text_x" value="120"/>
					<param name="label" value="$INFO[ListItem.Label]"/>
					<param name="label2" value="$INFO[ListItem.Genre]"/>
					<param name="progress" value="ListItem.HasEpg + !ListItem.IsRecording"/>
				</include>
			</control>
			<include content="Groove_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1196"/>
				<param name="top" value="168"/>
				<param name="height" value="858"/>
				<param name="onleft" value="11"/>
				<param name="onright" value="11"/>
			</include>
			<control type="group">
				<left>list_panel_x</left>
				<top>168</top>
				<width>list_panel_w</width>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>list_panel_w</width>
					<height>300</height>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<fadetime>120</fadetime>
					<texture background="true">$INFO[Container(11).ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>0</left>
					<top>320</top>
					<width>list_panel_w</width>
					<height>40</height>
					<font>font_tray</font>
					<label>$INFO[Container(11).ListItem.Label]$INFO[Container(11).ListItem.EpisodeName,  ·  ,]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>364</top>
					<width>list_panel_w</width>
					<height>28</height>
					<font>font_fact_label</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[Container(11).ListItem.StartTime]$INFO[Container(11).ListItem.EndTime, - ,]$INFO[Container(11).ListItem.Duration,  ·  ,]</label>
				</control>
				<control type="textbox">
					<left>0</left>
					<top>408</top>
					<width>list_panel_w</width>
					<height>424</height>  <!-- 13 lines exactly: no half-clipped line at the bottom -->
					<font>font_body_s</font>
					<label>$INFO[Container(11).ListItem.Plot]</label>
					<autoscroll delay="6000" time="3000" repeat="10000">true</autoscroll>  <!-- standard Kodi plot scroll: wait 6s, roll, pause 10s, repeat -->
				</control>
			</control>
		</control>
	</controls>
</window>
