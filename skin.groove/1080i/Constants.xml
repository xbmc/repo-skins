<?xml version="1.0" encoding="UTF-8"?>
<!--
	Constants: every pixel value used more than twice. Source: docs/skin.groove/DESIGN.md section 5
	and the approved mockups (1920x1080 design space).
	Naming: snake_case, prefixed by area (page_, topbar_, menu_, button_, focus_, poster_, spot_,
	home_, list_, dialog_, settings_, osd_).
-->
<includes>
	<!-- Page grid -->
	<constant name="page_margin">96</constant>            <!-- left/right margin -->
	<constant name="page_width">1728</constant>           <!-- 1920 - 2 x 96 -->
	<constant name="screen_w">1920</constant>
	<constant name="screen_h">1080</constant>
	<constant name="rule_h">1</constant>                  <!-- hairline thickness -->

	<!-- Top bar (DESIGN 7.4) -->
	<constant name="topbar_h">120</constant>
	<constant name="topbar_rule_y">119</constant>
	<constant name="topbar_item_top">36</constant>        <!-- top of the 48px tall menu label box -->
	<constant name="topbar_item_h">48</constant>
	<constant name="topbar_underline_y">84</constant>     <!-- 3px accent underline under the active label -->
	<constant name="topbar_underline_h">3</constant>
	<constant name="topbar_index_w">20</constant>         <!-- mono_14 "01" -->
	<constant name="topbar_label_x">30</constant>         <!-- index 20 + gap 10 -->
	<constant name="topbar_icon">26</constant>
	<constant name="topbar_icon_top">47</constant>
	<constant name="content_top">168</constant>           <!-- first content below the bar (Home, views) -->

	<!-- Top menu x positions: label widths measured from HankenGrotesk-Bold 26 with Pillow
	     (Home 69, Movies 85, TV Shows 118, Music 71 px) + 30 for the index, 56 between items -->
	<constant name="menu_x_home">96</constant>
	<constant name="menu_x_movies">251</constant>
	<constant name="menu_x_tv">422</constant>
	<constant name="menu_x_music">626</constant>
	<constant name="menu_x_search">783</constant>
	<constant name="menu_x_gear">865</constant>
	<constant name="menu_w_home">99</constant>
	<constant name="menu_w_movies">115</constant>
	<constant name="menu_w_tv">148</constant>
	<constant name="menu_w_music">101</constant>
	<constant name="menu_label_w_home">69</constant>
	<constant name="menu_label_w_movies">85</constant>
	<constant name="menu_label_w_tv">118</constant>
	<constant name="menu_label_w_music">71</constant>

	<!-- Buttons (DESIGN 7.6), widths measured from the button fonts + padding 32 / 28 -->
	<constant name="button_h">58</constant>
	<constant name="button_w_play">140</constant>
	<constant name="button_w_details">130</constant>
	<constant name="button_w_trailer">128</constant>
	<constant name="button_x_details">156</constant>      <!-- 140 + 16 -->
	<constant name="button_x_trailer">302</constant>      <!-- 156 + 130 + 16 -->

	<!-- Focus frame geometry (DESIGN 7.2): frame = item rect expanded 7px on every side -->
	<constant name="focus_out">-7</constant>
	<constant name="focus_grow">14</constant>

	<!-- Posters / rows -->
	<constant name="poster_m_w">168</constant>            <!-- Home newest row -->
	<constant name="poster_m_h">252</constant>
	<constant name="poster_m_pitch">192</constant>        <!-- 168 + gap 24 -->
	<constant name="marker_s">12</constant>               <!-- unwatched square in rows -->
	<constant name="marker_tab">22</constant>             <!-- watched tab in rows -->
	<constant name="progress_h">4</constant>

	<!-- Home spotlight (HomeTuned.dc.html) -->
	<constant name="spot_text_w">704</constant>
	<constant name="spot_img_x">864</constant>
	<constant name="spot_img_w">960</constant>
	<constant name="spot_img_h">540</constant>
	<constant name="spot_fact_w">176</constant>           <!-- 704 / 4 cells -->
	<constant name="spot_fact_h">84</constant>
	<constant name="home_row_y">760</constant>            <!-- rule above "Newest additions" -->
	<constant name="home_row_poster_y">60</constant>      <!-- posters, relative to the row top -->
	<constant name="home_row_pitch">340</constant>        <!-- second row below the first ("both" mode) -->

	<!-- Lists (view 50, dialogs, settings) -->
	<constant name="list_row_h">66</constant>
	<constant name="list_top">200</constant>              <!-- view 50 top inside library windows -->
	<constant name="list_w">1080</constant>               <!-- view 50 list width; art panel to the right -->
	<constant name="list_text_x">28</constant>
	<constant name="list_bar_w">4</constant>              <!-- accent bar on the focused row -->
	<constant name="list_panel_x">1264</constant>         <!-- focused-item art panel -->
	<constant name="list_panel_w">560</constant>

	<!-- Dialogs -->
	<constant name="dialog_pad">40</constant>
	<constant name="dialog_header_h">88</constant>
	<constant name="dialog_button_w">300</constant>
	<constant name="dialog_row_h">64</constant>
	<constant name="dialog_content_top">112</constant>     <!-- first content row under the dialog header rule -->
	<constant name="dialog_inset">24</constant>           <!-- list inset inside dialogs -->
	<constant name="toast_w">560</constant>
	<constant name="below_bar_top">136</constant>         <!-- sub-nav / toasts just under the top rule -->
	<constant name="subnav_h">40</constant>
	<constant name="subnav_left">86</constant>         <!-- page margin minus the button text inset, so text lines up at x 96 -->
	<constant name="kb_key_w">84</constant>               <!-- keyboard key (generator: _src/make_keyboard.py) -->
	<constant name="kb_key_h">72</constant>
	<constant name="skinsettings_w">1100</constant>
	<constant name="offscreen">-3000</constant>

	<!-- Settings windows (Settings.dc.html) -->
	<constant name="settings_cat_w">380</constant>
	<constant name="settings_list_x">560</constant>
	<constant name="settings_list_w">1264</constant>      <!-- 1824 - 560 -->
	<constant name="settings_row_h">72</constant>

	<!-- OSD (DESIGN 7.10) -->
	<constant name="osd_progress_y">948</constant>
	<constant name="osd_controls_y">984</constant>
	<constant name="osd_icon">32</constant>
	<constant name="osd_icon_btn">56</constant>
</includes>
