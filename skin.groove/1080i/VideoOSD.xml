<?xml version="1.0" encoding="UTF-8"?>
<!--
	Video OSD: the shared Groove playback layout (screens/VideoOSD.md, Includes_VideoOSD.xml). Always dark.
	Top strip: clearlogo / title, episode line, clock + "ends". Bottom: progress line (seek stepper 87 over it) and the
	icon rail in fixed slots: 602 Play/Pause, 603 Stop, 70044 Chapters (disabled, never hidden, when there is nothing
	to seek), 70049 Audio, 70046 Subtitles, 70048 Settings, 70043 Info. Nothing ever moves (rule 5); no seek buttons
	(rule 6: Left/Right seek on the line and without the OSD).
	Focus: opens on 602 (603 when pause is unavailable); Up -> the line 87 (Left/Right step, Down back); ends stop.
	Back closes the OSD (Kodi). OSD auto-hide: Custom_1152. No window-level animation: the strips slide/fade.
-->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<controls>
		<include>VOSD_Window</include>
	</controls>
</window>
