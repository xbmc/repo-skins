			<left>56</left>
			<top>720</top>
			<width>1864</width>
			<height>360</height>
			<orientation>horizontal</orientation>
			<focusposition>0</focusposition>
			<movement>7</movement>
			<onup>9930</onup>
			<onback>9930</onback>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<preloaditems>2</preloaditems>
			<include>Anim_ScrollRow</include>
			<itemlayout width="184" height="360">
				<control type="group">
					<left>40</left>
					<top>40</top>
					<width>160</width>
					<height>240</height>
					<include content="VidInfo_CastFace"><param name="dim" value="true"/><param name="lit" value="false"/></include>
				</control>
			</itemlayout>
			<focusedlayout width="184" height="360">
				<include content="VidView_CardLight">
					<param name="list" value="50"/>
					<param name="gx" value="-72"/><param name="gy" value="-128"/><param name="gw" value="384"/><param name="gh" value="576"/>
					<param name="cx" value="0"/><param name="cy" value="80"/><param name="cw" value="240"/><param name="ch" value="360"/>
					<param name="fx" value="0"/><param name="fy" value="0"/><param name="fw" value="240"/><param name="fh" value="320"/>
				</include>
				<control type="group">
					<left>40</left>
					<top>40</top>
					<width>160</width>
					<height>240</height>
					<include content="Anim_FocusCover"><param name="center" value="80,120"/></include>
					<include content="VidInfo_CastFace"><param name="dim" value="!Control.HasFocus(50)"/><param name="lit" value="Control.HasFocus(50)"/></include>
				</control>
			</focusedlayout>
		</control>
	</include>
	<!-- a portrait (or a collection's poster); no photo: a blank portrait with the artists icon. params: dim, lit -->
	<include name="VidInfo_CastFace">
		<definition>
			<control type="image">
				<left>-96</left>
				<top>-60</top>
				<right>-96</right>
				<bottom>-120</bottom>
				<texture border="96,60,96,120" colordiffuse="$VAR[shadow]">groove/shadow_square.png</texture>
			</control>
			<control type="group">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture colordiffuse="$VAR[surface_raised]">groove/white.png</texture>
				</control>
				<control type="image">
					<left>48</left>
					<top>88</top>
					<width>64</width>
					<height>64</height>
					<texture colordiffuse="$VAR[icon_rest]">icons/artists.png</texture>
					<visible>String.IsEmpty(ListItem.Art(thumb)) + String.IsEmpty(ListItem.Art(poster))</visible>
				</control>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<include>Anim_ArtFadetime</include>
				<texture background="true" colordiffuse="$VAR[dim_cover]">$VAR[VidInfo_CastArt]</texture>
				<visible>$PARAM[dim] + [!String.IsEmpty(ListItem.Art(thumb)) | !String.IsEmpty(ListItem.Art(poster))]</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<include>Anim_ArtFadetime</include>
				<texture background="true">$VAR[VidInfo_CastArt]</texture>
				<visible>!$PARAM[dim] + [!String.IsEmpty(ListItem.Art(thumb)) | !String.IsEmpty(ListItem.Art(poster))]</visible>
			</control>
			<include content="Groove_Rim">
				<param name="visible" value="$PARAM[lit]"/>
			</include>
		</definition>
	</include>

	<!-- ============================================================ More card -->
	<!-- Kodi's secondary actions on a Groove card; rows hide when Kodi's button is disabled. Always "visible" (a hidden
	     static list never fills, LESSONS), faded in while it has focus. -->
	<include name="VidInfo_MoreCard">
		<control type="group" id="9944">
			<include content="Dlg_FadeGate"><param name="show" value="Control.HasFocus(9945)"/></include>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="$VAR[dim_dialog]">groove/white.png</texture>
			</control>
			<!-- the card hugs its rows (Kodi hides the rows whose button is disabled) -->
			<control type="group">
				<left>620</left>
				<top>220</top>
				<width>680</width>
				<height>640</height>
				<control type="group">
					<visible>Integer.IsLessOrEqual(Container(9945).NumItems,3)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="320"/>
					</include>
				</control>
				<control type="group">
					<visible>Integer.IsEqual(Container(9945).NumItems,4)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="384"/>
					</include>
				</control>
				<control type="group">
					<visible>Integer.IsEqual(Container(9945).NumItems,5)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="448"/>
					</include>
				</control>
				<control type="group">
					<visible>Integer.IsEqual(Container(9945).NumItems,6)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="512"/>
					</include>
				</control>
				<control type="group">
					<visible>Integer.IsEqual(Container(9945).NumItems,7)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="576"/>
					</include>
				</control>
				<control type="group">
					<visible>Integer.IsGreaterOrEqual(Container(9945).NumItems,8)</visible>
					<include content="Dlg_Card">
						<param name="width" value="680"/>
						<param name="height" value="640"/>
					</include>
				</control>
				<control type="label">
					<left>40</left>
					<top>0</top>
					<width>600</width>
					<height>88</height>
					<aligny>center</aligny>
					<font>font_label</font>
					<textcolor>$VAR[ink]</textcolor>
					<label>$LOCALIZE[31258]</label>
				</control>
				<control type="image">
					<left>40</left>
					<top>88</top>
					<width>600</width>
					<height>2</height>
					<texture colordiffuse="$VAR[line]">groove/white.png</texture>
				</control>
				<control type="list" id="9945">
					<left>16</left>
					<top>104</top>
					<width>648</width>
					<height>512</height>
					<onup>9945</onup>
					<ondown>9945</ondown>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onback>9935</onback>
					<include>Anim_ScrollRow</include>
					<include content="Dlg_IndexListLayout">
						<param name="width" value="648"/>
						<param name="height" value="64"/>
						<param name="list_id" value="9945"/>
					</include>
					<content>
						<item>
							<label>$LOCALIZE[31811]</label>
							<icon>icons/liner.png</icon>
							<onclick>SetFocus(9942)</onclick>
							<visible>!String.IsEmpty(ListItem.Plot)</visible>
						</item>
						<item>
							<label>$LOCALIZE[31815]</label>
							<icon>icons/films.png</icon>
