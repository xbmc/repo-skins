			<left>56</left>
			<top>560</top>
			<width>1300</width>
			<height>144</height>
			<orientation>horizontal</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<itemgap>0</itemgap>
			<control type="image" id="9969">
				<width>40</width>
				<height>8</height>
				<texture />
			</control>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<onup condition="Control.IsVisible(9950)">9950</onup>
			<ondown condition="$EXP[VidInfo_HasCast]">50</ondown>
			<include content="Groove_IconButton">
				<param name="id" value="9"/>
				<param name="top" value="40"/>
				<param name="onup" value="9950"/>
				<param name="ondown" value="50"/>
				<param name="gid" value="9961"/>
				<param name="icon" value="icons/play.png"/>
				<param name="label" value="$VAR[VidInfo_ResumeLabel]"/>
				<param name="visible" value="$EXP[VidInfo_ShowResume]"/>
			</include>
			<include content="Groove_IconButton">
				<param name="id" value="8"/>
				<param name="top" value="40"/>
				<param name="onup" value="9950"/>
				<param name="ondown" value="50"/>
				<param name="gid" value="9962"/>
				<param name="icon" value="$VAR[VidInfo_PlayIcon]"/>
				<param name="label" value="$VAR[VidInfo_PlayLabel]"/>
				<param name="width" value="216"/>
			</include>
			<include content="Groove_IconButton">
				<param name="id" value="11"/>
				<param name="top" value="40"/>
				<param name="onup" value="9950"/>
				<param name="ondown" value="50"/>
				<param name="gid" value="9963"/>
				<param name="icon" value="icons/trailer.png"/>
				<param name="label" value="$LOCALIZE[31262]"/>
				<param name="visible" value="!String.IsEmpty(ListItem.Trailer)"/>
			</include>
			<include content="Groove_IconButton">
				<param name="id" value="9935"/>
				<param name="top" value="40"/>
				<param name="onup" value="9950"/>
				<param name="ondown" value="50"/>
				<param name="gid" value="9965"/>
				<param name="icon" value="icons/more.png"/>
				<param name="label" value="$LOCALIZE[31258]"/>
				<param name="onclick" value="SetFocus(9945,0,absolute)"/>
			</include>
		</control>
		<!-- Kodi's other buttons, offscreen (enabled / disabled by Kodi; clicked from the More card) -->
		<control type="group">
			<left>-3000</left>
			<top>-3000</top>
			<control type="button" id="6"><include>Groove_Hidden</include></control>
			<control type="button" id="7"><include>Groove_Hidden</include></control>
			<control type="button" id="10"><include>Groove_Hidden</include></control>
			<control type="button" id="12"><include>Groove_Hidden</include></control>
			<control type="button" id="13"><include>Groove_Hidden</include></control>
			<control type="button" id="14"><include>Groove_Hidden</include></control>
			<control type="button" id="15"><include>Groove_Hidden</include></control>
		</control>
	</include>

	<!-- ============================================================ cast row -->
