		<control type="group" id="9940">
			<include content="Dlg_FadeGate"><param name="show" value="Control.HasFocus(9942)"/></include>
			<animation type="Conditional" condition="!Control.HasFocus(9942) + !Skin.HasSetting(groove.reducemotion)" reversible="true">
				<effect type="slide" start="0,0" end="0,80" time="300" tween="cubic" easing="in"/>
			</animation>
			<include>Groove_Room</include>
			<include content="Groove_Glow">
				<param name="art" value="$VAR[VidView_PosterArt]"/>
				<param name="wash_x" value="1000"/><param name="wash_y" value="-300"/><param name="wash_s" value="1200"/>
				<param name="halo_x" value="1160"/><param name="halo_y" value="-140"/><param name="halo_s" value="880"/>
