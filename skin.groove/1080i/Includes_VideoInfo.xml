				<aligny>center</aligny>
				<font>font_tray</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$VAR[VidInfo_CastHeader]</label>
				<visible>!Control.HasFocus(50)</visible>
			</control>
		</control>
