<?xml version="1.0" encoding="UTF-8"?>
<!--
	DialogVideoInfo = cinema glow (skin-developer, M3 2026-10-21). Screen: docs/skin.groove/screens/DialogVideoInfo.md,
	board 02-home-films (backdrop, clearlogo, icon line).
	Kodi ids (Estuary Omega / CGUIDialogVideoInfo): 8 play (from start when 9 exists; browses folders), 9 resume,
	11 trailer, 50 cast (or a collection's films), 6 refresh, 7 user rating, 10 choose art, 12 fanart, 13 director,
	14 versions, 15 extras. 6/7/10/12/13/14/15 sit offscreen: the More card clicks them and reads Control.IsEnabled.
	Groove ids: 9930 button row (9931 face groups 9961-9965), 9935 More, 9945 More card list, 9940 reading page group,
	9941 plot textbox, 9942 its scroll line (focus target), 9950 mini player.
	Focus: buttons (rest, default 9) <-> cast 50 (Down / Up); More -> card 9945 (Back: 9935); Read the plot -> 9942
	(Back: 9935). Back on the buttons closes the dialog.
-->
<includes>
	<expression name="VidInfo_ShowResume">Control.IsEnabled(9) + !$EXP[VidView_IsFolderType]</expression>
	<expression name="VidInfo_HasCast">Integer.IsGreater(Container(50).NumItems,0)</expression>

	<variable name="VidInfo_PlayLabel">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">$LOCALIZE[31824]</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">$LOCALIZE[31829]</value>
		<value condition="$EXP[VidInfo_ShowResume]">$LOCALIZE[31257]</value>
		<value>$LOCALIZE[31261]</value>
	</variable>
	<variable name="VidInfo_PlayIcon">
		<value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">icons/episodes.png</value>
		<value condition="String.IsEqual(ListItem.DBType,set)">icons/films.png</value>
		<value condition="$EXP[VidInfo_ShowResume]">icons/previous.png</value>
		<value>icons/play.png</value>
	</variable>
	<variable name="VidInfo_ResumeLabel">
		<value>$LOCALIZE[31260]$INFO[ListItem.PercentPlayed,  ,%]</value>
	</variable>
	<variable name="VidInfo_CastHeader">
		<value condition="String.IsEqual(ListItem.DBType,set)">$LOCALIZE[31256]</value>
		<value>$LOCALIZE[31810]</value>
	</variable>
	<variable name="VidInfo_CastArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<!-- the cast member under focus: "Oscar Isaac · Miguel O'Hara" (a set's film: "Title · 2019") -->
	<variable name="VidInfo_CastCaption">
		<value condition="!String.IsEmpty(Container(50).ListItem.Label2)">$INFO[Container(50).ListItem.Label][COLOR $VAR[ink2]]  ·  $INFO[Container(50).ListItem.Label2][/COLOR]</value>
		<value condition="!String.IsEmpty(Container(50).ListItem.Year)">$INFO[Container(50).ListItem.Label][COLOR $VAR[ink2]]  ·  $INFO[Container(50).ListItem.Year][/COLOR]</value>
		<value>$INFO[Container(50).ListItem.Label]</value>
	</variable>
	<variable name="VidInfo_EndsLine">
		<value condition="ListItem.IsResumable + !String.IsEmpty(ListItem.EndTimeResume)">$LOCALIZE[31825] $INFO[ListItem.EndTimeResume]</value>
		<value condition="!String.IsEmpty(ListItem.EndTime) + !$EXP[VidView_IsFolderType]">$LOCALIZE[31825] $INFO[ListItem.EndTime]</value>
	</variable>

	<!-- ============================================================ the stage -->
	<include name="VidInfo_Stage">
		<include content="VidView_CinemaGlow">
			<param name="visible" value="!String.IsEmpty(ListItem.Art(fanart)) | !String.IsEmpty(ListItem.Art(tvshow.fanart)) | !String.IsEmpty(ListItem.Art(landscape))"/>
		</include>
		<!-- no backdrop: the poster lit at the right in its own light -->
		<control type="group">
			<visible>String.IsEmpty(ListItem.Art(fanart)) + String.IsEmpty(ListItem.Art(tvshow.fanart)) + String.IsEmpty(ListItem.Art(landscape))</visible>
			<include content="Groove_Glow">
				<param name="art" value="$VAR[VidView_PosterArt]"/>
				<param name="wash_x" value="900"/><param name="wash_y" value="-260"/><param name="wash_s" value="1200"/>
				<param name="halo_x" value="1080"/><param name="halo_y" value="-80"/><param name="halo_s" value="840"/>
			</include>
			<control type="group">
				<left>1304</left>
				<top>120</top>
				<width>400</width>
				<height>600</height>
				<include content="VidView_ArtCard">
					<param name="art" value="$VAR[VidView_PosterArt]"/>
					<param name="lit" value="true"/>
					<param name="noart" value="$EXP[VidView_NoPoster]"/>
					<param name="title" value="$VAR[VidView_ItemTitle]"/>
				</include>
			</control>
		</control>
		<include content="VidView_Logo">
			<param name="left" value="96"/>
			<param name="top" value="104"/>
			<param name="width" value="600"/>
			<param name="height" value="196"/>
		</include>
		<control type="label">
			<left>96</left>
			<top>304</top>
			<width>1200</width>
			<height>48</height>
			<aligny>center</aligny>
			<font>font_caption</font>
			<textcolor>$VAR[ink]</textcolor>
			<shadowcolor>$VAR[text_shadow]</shadowcolor>
			<label>$VAR[VidView_EpisodeLine]</label>
			<visible>String.IsEqual(ListItem.DBType,episode)</visible>
		</control>
		<!-- icon line, then "Ends 11:21 PM" right after its last fact (DEVICE_AUDIT m5) -->
		<include content="VidView_FactLinePacked">
			<param name="left" value="96"/>
			<param name="top" value="360"/>
			<param name="ends" value="$VAR[VidInfo_EndsLine]"/>
			<param name="ends_visible" value="!$EXP[VidView_IsFolderType] + $EXP[VidView_HasRuntime] + [[ListItem.IsResumable + !String.IsEmpty(ListItem.EndTimeResume)] | !String.IsEmpty(ListItem.EndTime)]"/>
		</include>
		<control type="textbox">
			<left>96</left>
			<top>430</top>
			<width>1000</width>
			<height>120</height>
			<font>font_body</font>
			<textcolor>$VAR[ink]</textcolor>
			<shadowcolor>$VAR[text_shadow]</shadowcolor>
			<label>$INFO[ListItem.Plot]</label>
		</control>
	</include>

