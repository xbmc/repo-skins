				<onleft>noop</onleft>
				<onright>noop</onright>
				<onback>9935</onback>
			</control>
			<control type="group">
				<left>1300</left>
				<top>228</top>
				<width>524</width>
				<include content="Dlg_FactRow">
					<param name="top" value="0"/>
					<param name="label" value="$LOCALIZE[31818]"/>
					<param name="value" value="$INFO[ListItem.Genre]"/>
					<param name="valuew" value="344"/>
				</include>
