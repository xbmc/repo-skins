<?xml version="1.0" encoding="UTF-8"?>
<!--
	Expressions: every boolean used in more than one place. Use as $EXP[Name].
	Skin setting names are documented in docs/skin.groove/SETTINGS.md.
	Rule (SPEC section 7): an empty string / unset bool always means the default.
-->
<includes>

	<!-- Setting 2: corners -->
	<expression name="IsRounded">false</expression>

	<expression name="FocusOutlineMedium">String.IsEqual(Skin.String(groove.focusoutline),medium)</expression>

	<!-- Setting 4: artwork background (empty = faint). Forced off without TMDb Helper. Wired in M2 (T15). -->
	<expression name="ArtBackgroundOn">false</expression>

	<!-- 1.0.7: Home can refocus the remembered rail icon (a hidden icon or a cleared custom item can't) -->
	<expression name="Home_RefocusValid">[[String.IsEmpty(Window(Home).Property(groove.home)) | String.IsEqual(Window(Home).Property(groove.home),music)] + !Skin.HasSetting(HideMenu.Music)] | [String.IsEqual(Window(Home).Property(groove.home),films) + !Skin.HasSetting(HideMenu.Movies)] | [String.IsEqual(Window(Home).Property(groove.home),tv) + !Skin.HasSetting(HideMenu.TVShows)] | [String.IsEqual(Window(Home).Property(groove.home),search) + !Skin.HasSetting(HideMenu.Search)] | String.IsEqual(Window(Home).Property(groove.home),settings) | [String.IsEqual(Window(Home).Property(groove.home),custom1) + $EXP[CustomMenu1On]] | [String.IsEqual(Window(Home).Property(groove.home),custom2) + $EXP[CustomMenu2On]] | [String.IsEqual(Window(Home).Property(groove.home),custom3) + $EXP[CustomMenu3On]]</expression>
</includes>
