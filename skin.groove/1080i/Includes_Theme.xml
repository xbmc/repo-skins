	<!-- The glow colour (SPEC section 11): first source with a value wins. Every source is optional.
	     1 script.karmamole.helper  Window(Home).Property(Groove.Color.Main)   AARRGGBB, focused item after 400 ms rest
	     2 TMDb Helper           Window(Home).Property(TMDbHelper.ListItem.Colors.Main)  (setting groove.notmdbcolours off)
	     3 service.vizpalette    Window(Home).Property(VizPalette.Color1)   AARRGGBB, while music plays
	     4 glow_fallback         warm white (Dark) / warm sand (Light) -->
	<variable name="glow">
		<value condition="$EXP[HasGrooveHelper] + !String.IsEmpty(Window(Home).Property(Groove.Color.Main))">$INFO[Window(Home).Property(Groove.Color.Main)]</value>
		<value condition="!Skin.HasSetting(groove.notmdbcolours) + Skin.HasSetting(TMDbHelper.EnableColors) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Colors.Main))">$INFO[Window(Home).Property(TMDbHelper.ListItem.Colors.Main)]</value>
		<value condition="Player.HasAudio + $EXP[HasVizPalette] + !String.IsEmpty(Window(Home).Property(VizPalette.Color1))">$INFO[Window(Home).Property(VizPalette.Color1)]</value>
		<value condition="$EXP[GrooveLight]">lt_glow_fallback</value>
		<value>dk_glow_fallback</value>
	</variable>
	<!-- room wash alpha = Glow strength x room (DESIGN 12.3: Dark 25/40/60 %, Light 14/22/32 %) -->
	<variable name="wash">
		<value condition="$EXP[GrooveLight] + String.IsEqual(Skin.String(groove.glow),soft)">lt_wash_soft</value>
		<value condition="$EXP[GrooveLight] + String.IsEqual(Skin.String(groove.glow),vivid)">lt_wash_vivid</value>
		<value condition="$EXP[GrooveLight]">lt_wash_medium</value>
		<value condition="String.IsEqual(Skin.String(groove.glow),soft)">dk_wash_soft</value>
		<value condition="String.IsEqual(Skin.String(groove.glow),vivid)">dk_wash_vivid</value>
		<value>dk_wash_medium</value>
	</variable>
	<!-- The playing album's colour (HELPER_API 6): helper > TMDb Helper image_colors of this cover (Timers.xml
	     groove_np_colours) > vizpalette accent > vizpalette dominant > fallback. Now Playing (NP_Glow), the Liner
	     notes and Home's Music stage while music plays all read it. -->
	<variable name="glow_playing">
		<value condition="$EXP[HasGrooveHelper] + !String.IsEmpty(Window(Home).Property(Groove.Player.Color.Main))">$INFO[Window(Home).Property(Groove.Player.Color.Main)]</value>
		<value condition="!Skin.HasSetting(groove.notmdbcolours) + !String.IsEmpty(Window(Home).Property(TMDbHelper.GroovePlayer.Colors.Main)) + String.IsEqual(Window(Home).Property(groove.np.colorsrc),Player.Art(thumb))">$INFO[Window(Home).Property(TMDbHelper.GroovePlayer.Colors.Main)]</value>
		<value condition="$EXP[HasVizPalette] + !String.IsEmpty(Window(Home).Property(VizPalette.Color3))">$INFO[Window(Home).Property(VizPalette.Color3)]</value>
		<value condition="$EXP[HasVizPalette] + !String.IsEmpty(Window(Home).Property(VizPalette.Color1))">$INFO[Window(Home).Property(VizPalette.Color1)]</value>
		<value condition="$EXP[GrooveLight]">lt_glow_fallback</value>
		<value>dk_glow_fallback</value>
	</variable>
