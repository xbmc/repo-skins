<?xml version="1.0" encoding="UTF-8"?>
<!--
	Games / game add-ons (SPEC 5: Minimal, Misc_MediaWindow). Builder F, M4. Omar doesn't use games:
	correct, navigable, Back always works.
	Kodi id contract (Estuary Omega MyGames.xml): view container 50, menucontrol 9000, hidden sort
	buttons 3 / 4, get more 621, add-on settings 624.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<views>50</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the sub-nav instead (as MyVideoNav/MyMusicNav) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<controls>
		<include>Groove_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Misc_MediaWindow">
				<param name="icon" value="icons/games.png"/>
				<param name="index" value="08"/>
				<param name="title" value="$LOCALIZE[15016]"/>
				<param name="sub" value="$INFO[Container.FolderName]"/>
				<param name="extra" value="Misc_Extra_Games"/>
			</include>
		</control>
	</controls>
</window>
