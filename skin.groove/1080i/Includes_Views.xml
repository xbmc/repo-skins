<?xml version="1.0" encoding="UTF-8"?>
<!--
	Library views and the generic list window (SPEC 6).
	View ids: 50 List (M1, generic fallback) | 500 Poster Showcase | 501 Big Poster | 502 Wall |
	503 Episodes | 504 Albums | 505 Big Album (M2). Every view gates itself with Container.Content.
	Header bar (grouplist 9000) replaces Estuary's side blade; uses Kodi's media-window ids
	(3 = sort by, 4 = sort order, 10 = watched filter in video windows).
-->
<includes>
	<!-- ============================================================ View 50 -->
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Anim_VisibleFade</include>
			<control type="list" id="50">
				<left>96</left>
				<top>190</top>
				<width>1000</width>
				<height>792</height>
				<onup>9000</onup>
				<ondown>9000</ondown>
				<onleft>9000</onleft>
				<onright>60</onright>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="535">list</viewtype>
				<include content="Groove_ListLayout">
					<param name="width" value="1000"/>
					<param name="height" value="64"/>
					<param name="list_id" value="50"/>
				</include>
			</control>
			<include content="Groove_Scrollbar">
				<param name="id" value="60"/>
				<param name="left" value="1120"/>
				<param name="top" value="190"/>
				<param name="height" value="792"/>
				<param name="onleft" value="50"/>
				<param name="onright" value="SetProperty(groove.lib.from,view,home)"/>
				<param name="onright2" value="SetFocus(9801,0,absolute)"/>
			</include>
			<!-- the focused item, lit on the wall to the right -->
			<control type="group">
				<left>1240</left>
				<top>190</top>
				<visible>!ListItem.IsParentFolder + [!String.IsEmpty(ListItem.Art(poster)) | !String.IsEmpty(ListItem.Art(thumb))]</visible>
				<control type="group">
					<left>80</left>
					<top>0</top>
					<width>400</width>
					<height>600</height>
					<visible>!String.IsEmpty(ListItem.Art(poster))</visible>
					<include content="Groove_ArtParts">
						<param name="art" value="$INFO[ListItem.Art(poster)]"/>
						<param name="lit" value="true"/>
					</include>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>560</width>
					<height>600</height>
					<aspectratio aligny="center">keep</aspectratio>
					<fadetime>150</fadetime>
					<texture background="true" colordiffuse="white">$INFO[ListItem.Art(thumb)]</texture>
					<visible>String.IsEmpty(ListItem.Art(poster))</visible>
				</control>
				<control type="label">
					<left>0</left>
					<top>630</top>
					<width>560</width>
					<height>56</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font_caption</font>
					<textcolor>$VAR[ink]</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>690</top>
					<width>560</width>
					<height>32</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font_small</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins),  ·  , $LOCALIZE[31221]]$INFO[ListItem.Genre,  ·  ,]</label>
				</control>
			</control>
		</control>
	</include>
</includes>
