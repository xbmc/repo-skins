<?xml version="1.0" encoding="UTF-8"?>
<!--
	Favourites browser (SPEC 5: Minimal, Misc_MediaWindow). Builder F, M4.
	Kodi id contract (Estuary Omega MyFavourites.xml): view container 50, menucontrol 9000, hidden sort
	buttons 3 / 4. Favourites are edited from the context menu (Kodi's own items).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<views>50</views>
	<!-- empty folder: Kodi can't focus an empty view, so land on the sub-nav instead (as MyVideoNav/MyMusicNav) -->
	<onload condition="Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating">SetFocus(9000)</onload>
	<controls>
		<include>Groove_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Misc_MediaWindow">
				<param name="icon" value="icons/favourites.png"/>
				<param name="index" value="09"/>
				<param name="title" value="$LOCALIZE[1036]"/>
			</include>
		</control>
	</controls>
</window>
