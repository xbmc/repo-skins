<?xml version="1.0" encoding="UTF-8"?>
<!--
	Music building blocks (Builder C). Prefix: Music_ (includes, variables, expressions), music_ (constants).
	Used by MyMusicNav, Includes_Views_Music, DialogMusicInfo, MusicVisualisation, MusicOSD,
	MyPlaylist, MyMusicPlaylistEditor. Home may reuse Music_NowPlayingBar (SPEC 4.2 "music playing").
	Sources: mockups Music.dc.html / MusicStage.dc.html / OSD.dc.html, DESIGN 5-7, DATA 4.9-4.11.

	TMDb Helper (optional, guarded by $EXP[ArtBackgroundOn] which includes System.AddonIsEnabled):
	- Library + info dialog: the TMDb Helper image monitor blurs the focused item / info item
	  (MyMusicNav.xml and DialogMusicInfo.xml are both monitored windows) using
	  Window(Home).Property(TMDbHelper.Blur.SourceImage) = Art(thumb), output
	  Window(Home).Property(TMDbHelper.ListItem.BlurImage) (+ .Original = source path).
	  Needs Skin.HasSetting(TMDbHelper.EnableBlur).
	- Now playing: no list item, so the cover is blurred on demand with
	  RunScript(plugin.video.themoviedb.helper,blur_image=<path>,prefix=GroovePlayer)
	  -> Window(Home).Property(TMDbHelper.GroovePlayer.BlurImage) (checked in tmdbhelper 6.17.x
	  script/method/image_functions.py + monitor/images.py).
-->
<includes>
	<!-- ============================================================ constants -->
	<!-- Albums grid (view 504): 7 columns, cover 219, column gap 32, row gap 30 (Music.dc.html).
	     The panel is padded 14 px on every side of each cell so the focus frame (+7) and the
	     5 % zoom (+6) are not clipped by the container. -->
	<constant name="music_tile">219</constant>
	<constant name="music_cell_w">251</constant>          <!-- 219 + 32 -->
	<constant name="music_cell_h">310</constant>          <!-- 219 + 12 + 25 + 3 + 21 + 30 -->
	<constant name="music_pad">14</constant>
	<constant name="music_grid_left">82</constant>        <!-- 96 - 14 -->
	<constant name="music_grid_top">146</constant>        <!-- 160 - 14 -->
	<constant name="music_grid_w">1757</constant>         <!-- 7 x 251 -->
	<constant name="music_grid_h">838</constant>          <!-- clip at y 984 (top of the now-playing bar) -->
	<!-- Big Album (view 505): 380 squares, gap 28, focus slot 2 at x 504, top 230 (MusicStage.dc.html).
	     Item content is offset (20, 130) inside the container so the focused item's soft shadow,
	     zoom and frame fit; the container's left edge (76) hides the item before slot 1. -->
	<constant name="music_big">380</constant>
	<constant name="music_big_pitch">408</constant>       <!-- 380 + 28 -->
	<constant name="music_big_left">76</constant>
	<constant name="music_big_top">100</constant>
	<constant name="music_big_w">1844</constant>
	<constant name="music_big_h">668</constant>
	<constant name="music_big_pad_x">20</constant>
	<constant name="music_big_pad_y">130</constant>
	<constant name="music_details_x">504</constant>
	<constant name="music_details_y">662</constant>
	<!-- Lists / panels -->
	<constant name="music_list_top">250</constant>
	<constant name="music_list_h">594</constant>          <!-- 12 rows of 66, ends at 952 -->
	<constant name="music_panel_x">1264</constant>
	<constant name="music_panel_art">560</constant>
	<!-- Header tabs (inside the 120 px top bar, Music.dc.html) -->
	<constant name="music_tab_top">47</constant>  <!-- centre 65 = the header date's centre (Groove_Clock) -->
	<constant name="music_tab_h">36</constant>
	<!-- Now-playing bar (DESIGN 7.9) -->
	<constant name="music_np_top">984</constant>
	<constant name="music_np_h">96</constant>
	<!-- Now playing window / OSD (OSD.dc.html geometry) -->
	<constant name="music_np_cover">560</constant>
	<constant name="music_np_text_x">720</constant>
	<constant name="music_np_text_w">1104</constant>
	<constant name="music_progress_y">806</constant>
	<constant name="music_osd_y">900</constant>
	<constant name="music_osd_btn">72</constant>
	<constant name="music_osd_btn_f">88</constant>
	<constant name="music_osd_y_f">892</constant>

	<!-- ========================================================== expressions -->
	<expression name="Music_IsPlaying">Player.HasAudio</expression>

	<!-- ============================================================ variables -->

	<!-- Title for any item; the ".." parent item (filelists.showparentdiritems = on) reads "Back" -->
	<variable name="Music_ItemLabel">
		<value condition="ListItem.IsParentFolder">$LOCALIZE[31605]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>

	<!-- Now playing kicker -->
	<variable name="Music_NPKicker">
		<value condition="Player.Paused">$LOCALIZE[112]$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
		<value>$LOCALIZE[31017]$INFO[Playlist.Position(music),  ·  ,]$INFO[Playlist.Length(music), / ,]</value>
	</variable>
	<!-- Queue window (MyPlaylist) -->
	<variable name="Music_QueueTitle">
		<value condition="Window.IsActive(videoplaylist)">$LOCALIZE[31907]</value>
		<value>$LOCALIZE[31288]</value>
	</variable>
	<variable name="Music_QueueIndex">
		<value condition="Window.IsActive(videoplaylist)">02</value>
		<value>04</value>
	</variable>
	<variable name="Music_QueueShuffleLabel">
		<value condition="Playlist.IsRandom">$LOCALIZE[31908]</value>
		<value>$LOCALIZE[31909]</value>
	</variable>

	<!-- ================================================================ cover -->
	<!-- Square cover with corner mask (picked at window load, DESIGN 7.1) and an optional opaque
	     dim (colordiffuse). Fallback = raised tile with the name, covered by the art when it loads.
	     Sits inside a group of the cover size.
	     params: art, title, mask_round (default 219 grid mask), diffuse (default white = undimmed),
	             fadetime (embedded MP3 art loads slowly: default 160) -->
	<include name="Music_Cover">
		<param name="art">$INFO[ListItem.Art(thumb)]</param>
		<param name="title">$INFO[ListItem.Label]</param>
		<param name="mask_round">masks/square_round8.png</param>
		<param name="diffuse">white</param>
		<param name="fadetime">160</param>
		<param name="parent_icon">40</param>
		<param name="parent_caption">false</param>
		<definition>
			<include content="Music_ParentTile">
				<param name="icon" value="$PARAM[parent_icon]"/>
				<param name="caption_visible" value="$PARAM[parent_caption]"/>
			</include>
			<control type="group">
			<left>0</left>
			<top>0</top>
			<right>0</right>
			<bottom>0</bottom>
			<visible>!ListItem.IsParentFolder</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<texture colordiffuse="$VAR[surface_raised]">groove/white.png</texture>
			</control>
			<control type="textbox">
				<left>16</left>
				<top>14</top>
				<right>16</right>
				<height>52</height>
				<font>font_label_xs</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$PARAM[title]</label>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" diffuse="$PARAM[mask_round]" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>false</visible>
			</control>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<aspectratio>scale</aspectratio>
				<fadetime>$PARAM[fadetime]</fadetime>
				<texture background="true" colordiffuse="$PARAM[diffuse]">$PARAM[art]</texture>
				<visible>true</visible>
			</control>
			</control>
		</definition>
	</include>

	<!-- ".." parent item tile (same look as Builder B's VidView_ParentTile): hairline box + back
	     chevron + optional "UP ONE LEVEL" caption. Inside the cover group. params: icon, caption_visible -->
	<include name="Music_ParentTile">
		<param name="icon">40</param>
		<param name="caption_visible">false</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>0</top>
				<right>0</right>
				<bottom>0</bottom>
				<visible>ListItem.IsParentFolder</visible>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<right>0</right>
					<bottom>0</bottom>
					<texture border="10" colordiffuse="$VAR[line_strong]">$VAR[ButtonOutline]</texture>
				</control>
				<control type="image">
					<centerleft>50%</centerleft>
					<centertop>50%</centertop>
					<width>$PARAM[icon]</width>
					<height>$PARAM[icon]</height>
					<texture colordiffuse="$VAR[ink2]">icons/back.png</texture>
				</control>
				<control type="label">
					<left>0</left>
					<right>0</right>
					<bottom>24</bottom>
					<height>22</height>
					<align>center</align>
					<font>font_caps</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$LOCALIZE[31910]</label>
					<visible>$PARAM[caption_visible]</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ===================================================== now-playing bar -->
	<!-- Bottom bar when audio plays (Music.dc.html / DESIGN 7.9). Not focusable.
	     params: visible (default: audio is playing) -->
	<include name="Music_NowPlayingBar">
		<param name="visible">$EXP[Music_IsPlaying]</param>
		<definition>
			<control type="group">
				<left>0</left>
				<top>music_np_top</top>
				<width>screen_w</width>
				<height>music_np_h</height>
				<visible>$PARAM[visible]</visible>
				<include>Anim_FadeVisible</include>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>screen_w</width>
					<height>music_np_h</height>
					<texture colordiffuse="$VAR[ground]">groove/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>screen_w</width>
					<height>rule_h</height>
					<texture colordiffuse="$VAR[line_strong]">common/hairline.png</texture>
				</control>
				<control type="group">
					<left>page_margin</left>
					<top>18</top>
					<width>60</width>
					<height>60</height>
					<include content="Music_Cover">
						<param name="art" value="$INFO[Player.Art(thumb)]"/>
						<param name="title" value=""/>
						<param name="mask_round" value="masks/square_round8.png"/>
					</include>
				</control>
				<control type="label">
					<left>184</left>
					<top>20</top>
					<width>420</width>
					<height>20</height>
					<font>font_caps</font>
					<textcolor>$VAR[ink]</textcolor>
					<label>$VAR[Music_NPKicker]</label>
				</control>
				<control type="grouplist">
					<left>184</left>
					<top>42</top>
					<width>420</width>
					<height>32</height>
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width max="300">auto</width>
						<height>32</height>
						<font>font_label_xs</font>
						<textcolor>$VAR[ink]</textcolor>
						<label>$INFO[MusicPlayer.Title]</label>
					</control>
					<control type="label">
						<width max="400">auto</width>
						<height>32</height>
						<font>font_label_xs</font>
						<textcolor>$VAR[ink2]</textcolor>
						<label>$INFO[MusicPlayer.Artist,  ·  ,]</label>
					</control>
				</control>
				<control type="progress">
					<left>632</left>
					<top>47</top>
					<width>1014</width>
					<height>2</height>
					<texturebg colordiffuse="$VAR[line_strong]">groove/white.png</texturebg>
					<midtexture colordiffuse="$VAR[ink]">groove/white.png</midtexture>
					<info>Player.Progress</info>
				</control>
				<control type="label">
					<left>1674</left>
					<top>33</top>
					<width>150</width>
					<height>30</height>
					<align>right</align>
					<font>font_small_22</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[Player.Time]$INFO[Player.Duration, / ,]</label>
				</control>
			</control>
		</definition>
	</include>

	<!-- ========================================================== music OSD -->
	<!-- Play queue page caption: "1 item" / "12 items · 45:10" (1.0.4: was "1 items") -->
	<variable name="Music_PlaylistSub">
		<value condition="Integer.IsEqual(Container.NumItems,1)">$LOCALIZE[31911]$INFO[Container.TotalTime,  ·  ,]</value>
		<value>$INFO[Container.NumItems,, $LOCALIZE[31912]]$INFO[Container.TotalTime,  ·  ,]</value>
	</variable>

	<!-- ============================================== text rows (lists 50/100) -->
	<!-- Generic text row (genres, years, roots, files, playlist editor): label left, label2 right.
	     params: width, list_id, condition (layout selection) -->
	<include name="Music_RowLayout">
		<param name="width">1080</param>
		<param name="list_id">50</param>
		<param name="condition">true</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<control type="label">
					<left>list_text_x</left>
					<top>0</top>
					<right>200</right>
					<height>66</height>
					<font>font_label_m</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$VAR[Music_ItemLabel]</label>
				</control>
				<control type="label">
					<right>list_text_x</right>
					<top>0</top>
					<width>180</width>
					<height>66</height>
					<align>right</align>
					<font>font_small_22</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="$VAR[line]">common/hairline.png</texture>
				</control>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>66</height>
					<texture border="64,0,64,0" colordiffuse="$VAR[focus_glow]">fork/glow_bar.png</texture>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>list_bar_w</width>
					<height>66</height>
					<texture colordiffuse="$VAR[ink]">fork/tick.png</texture>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="label">
					<left>list_text_x</left>
					<top>0</top>
					<right>200</right>
					<height>66</height>
					<font>font_label_m</font>
					<textcolor>$VAR[ink]</textcolor>
					<scroll>true</scroll>
					<label>$VAR[Music_ItemLabel]</label>
				</control>
				<control type="label">
					<right>list_text_x</right>
					<top>0</top>
					<width>180</width>
					<height>66</height>
					<align>right</align>
					<font>font_small_22</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
				<control type="image">
					<left>0</left>
					<bottom>0</bottom>
					<width>$PARAM[width]</width>
					<height>rule_h</height>
					<texture colordiffuse="$VAR[line]">common/hairline.png</texture>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<!-- Song row: track no (or ▶ when playing) · title · artist · duration.
	     params: width (1080), list_id, number (infolabel for the left column), condition -->
	<include name="Music_SongLayout">
		<param name="width">1080</param>
		<param name="list_id">50</param>
		<param name="number">$INFO[ListItem.TrackNumber]</param>
		<param name="condition">true</param>
		<definition>
			<itemlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<include content="Music_SongRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="number" value="$PARAM[number]"/>
					<param name="title_font" value="font_label_m"/>
					<param name="title_color" value="$VAR[ink2]"/>
					<param name="scroll" value="false"/>
				</include>
			</itemlayout>
			<focusedlayout width="$PARAM[width]" height="66" condition="$PARAM[condition]">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>66</height>
					<texture border="64,0,64,0" colordiffuse="$VAR[focus_glow]">fork/glow_bar.png</texture>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>list_bar_w</width>
					<height>66</height>
					<texture colordiffuse="$VAR[ink]">fork/tick.png</texture>
					<visible>Control.HasFocus($PARAM[list_id])</visible>
				</control>
				<include content="Music_SongRow">
					<param name="width" value="$PARAM[width]"/>
					<param name="number" value="$PARAM[number]"/>
					<param name="title_font" value="font_label_m"/>
					<param name="title_color" value="$VAR[ink]"/>
					<param name="scroll" value="true"/>
				</include>
			</focusedlayout>
		</definition>
	</include>
	<include name="Music_SongRow">
		<param name="width">1080</param>
		<param name="number">$INFO[ListItem.TrackNumber]</param>
		<param name="title_font">font_label_m</param>
		<param name="title_color">$VAR[ink2]</param>
		<param name="scroll">false</param>
		<definition>
			<control type="label">
				<left>list_text_x</left>
				<top>0</top>
				<width>52</width>
				<height>66</height>
				<font>font_small_22</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>[UPPERCASE]$PARAM[number][/UPPERCASE]</label>
				<visible>!ListItem.IsPlaying</visible>
			</control>
			<!-- playing marker: an icon, not a glyph (Jost has no U+25B6; device audit 2026-10-21) -->
			<control type="image">
				<left>list_text_x</left>
				<top>19</top>
				<width>28</width>
				<height>28</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="$VAR[ink]">icons/play.png</texture>
				<visible>ListItem.IsPlaying</visible>
			</control>
			<control type="label">
				<left>92</left>
				<top>0</top>
				<width>480</width>
				<height>66</height>
				<font>$PARAM[title_font]</font>
				<textcolor>$PARAM[title_color]</textcolor>
				<scroll>$PARAM[scroll]</scroll>
				<label>$VAR[Music_ItemLabel]</label>
				<visible>String.IsEmpty(ListItem.Title)</visible>
			</control>
			<control type="label">
				<left>92</left>
				<top>0</top>
				<width>480</width>
				<height>66</height>
				<font>$PARAM[title_font]</font>
				<textcolor>$PARAM[title_color]</textcolor>
				<scroll>$PARAM[scroll]</scroll>
				<label>$INFO[ListItem.Title]</label>
				<visible>!String.IsEmpty(ListItem.Title)</visible>
			</control>
			<control type="label">
				<left>596</left>
				<top>0</top>
				<right>150</right>
				<height>66</height>
				<font>font_body_xs</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$INFO[ListItem.Artist]$INFO[ListItem.TVShowTitle]</label>
			</control>
			<control type="label">
				<right>list_text_x</right>
				<top>0</top>
				<width>110</width>
				<height>66</height>
				<align>right</align>
				<font>font_small_22</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$INFO[ListItem.Duration]</label>
			</control>
			<control type="image">
				<left>0</left>
				<bottom>0</bottom>
				<width>$PARAM[width]</width>
				<height>rule_h</height>
				<texture colordiffuse="$VAR[line]">common/hairline.png</texture>
			</control>
		</definition>
	</include>

	<!-- Focused-item panel to the right of a 1080 px list: 560 cover + title + meta (fixed heights) -->
	<include name="Music_ListPanel">
		<param name="top">music_list_top</param>
		<definition>
			<control type="group">
				<left>1290</left>
				<top>$PARAM[top]</top>
				<visible>!ListItem.IsParentFolder</visible>
				<control type="image">
					<left>-160</left>
					<top>-150</top>
					<width>760</width>
					<height>740</height>
					<texture colordiffuse="$VAR[focus_glow]">fork/glow_warm.png</texture>
				</control>
				<control type="group">
					<left>40</left>
					<top>0</top>
					<width>440</width>
					<height>440</height>
					<include content="Groove_CoverParts">
						<param name="art" value="$INFO[ListItem.Art(thumb)]"/>
						<param name="lit" value="true"/>
						<param name="label" value="$VAR[Music_ItemLabel]"/>
					</include>
				</control>
				<control type="label">
					<left>0</left>
					<top>470</top>
					<width>520</width>
					<height>56</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font_title</font>
					<textcolor>$VAR[ink]</textcolor>
					<label>$VAR[Music_ItemLabel]</label>
				</control>
				<control type="label">
					<left>0</left>
					<top>530</top>
					<width>520</width>
					<height>30</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font_caps</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$INFO[ListItem.Artist]$INFO[ListItem.Album,  ·  ,]$INFO[ListItem.Year,  ·  ,]</label>
				</control>
			</control>
		</definition>
	</include>
</includes>
