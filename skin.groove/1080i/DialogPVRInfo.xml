<?xml version="1.0" encoding="UTF-8"?>
<!--
	PVR programme / recording info (Kodi uses this file for PVRGuideInfo and PVRRecordingInfo).
	SPEC 5: Minimal (Groove_GenericDialog). Builder F, M4.
	Kodi id contract (Estuary Omega DialogPVRInfo.xml / GUIDialogPVRGuideInfo): buttons in grouplist
	9000 - 5 switch to channel, 10 play programme, 8 play recording, 6 record (Kodi sets the label),
	9 add timer, 11 set reminder, 4 find similar. Kodi hides the ones that don't apply.
-->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_DialogCard</include>
			<control type="group">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>1680</width>
				<height>820</height>
				<include content="Groove_GenericDialog">
					<param name="width" value="1680"/>
					<param name="height" value="820"/>
					<param name="header_label" value="$INFO[ListItem.Title]$INFO[ListItem.Year,  (,)]"/>
				</include>
				<control type="image">
					<left>dialog_pad</left>
					<top>dialog_content_top</top>
					<width>400</width>
					<height>400</height>
					<aspectratio align="left" aligny="top">keep</aspectratio>
					<fadetime>120</fadetime>
					<texture background="true">$INFO[ListItem.Icon]</texture>
				</control>
				<control type="label">
					<left>480</left>
					<top>dialog_content_top</top>
					<width>1160</width>
					<height>30</height>
					<font>font_fact_label</font>
					<label>$INFO[ListItem.ChannelName]$INFO[ListItem.Season,  ·  S,]$INFO[ListItem.Episode,E,]$INFO[ListItem.EpisodeName,  ·  ,]</label>
				</control>
				<control type="label">
					<left>480</left>
					<top>148</top>
					<width>1160</width>
					<height>30</height>
					<font>font_fact_label</font>
					<textcolor>$VAR[ink2]</textcolor>
					<label>$VAR[Misc_PVRMeta]$INFO[ListItem.Rating,  ·  , / 10]$INFO[ListItem.ParentalRatingCode,  ·  ,]</label>
				</control>
				<control type="textbox">
					<left>480</left>
					<top>196</top>
					<width>1160</width>
					<height>471</height>  <!-- 13 lines exactly: no half-clipped line at the bottom -->
					<font>font_body</font>
					<label>$INFO[ListItem.Plot]$INFO[ListItem.Director,[CR][CR]$LOCALIZE[20339]  ,]$INFO[ListItem.Cast,[CR]$LOCALIZE[206]  ,]</label>
					<autoscroll time="3000" delay="6000" repeat="8000">true</autoscroll>
				</control>
				<control type="grouplist" id="9000">
					<left>dialog_pad</left>
					<top>720</top>
					<width>1600</width>
					<height>dialog_row_h</height>
					<orientation>horizontal</orientation>
					<itemgap>12</itemgap>
					<onleft>9000</onleft>
					<onright>9000</onright>
					<onup>noop</onup>
					<ondown>noop</ondown>
					<include content="Groove_DialogButton">
						<param name="id" value="5"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[19165]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="10"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[19190]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="8"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[19687]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo) | Window.IsActive(PVRRecordingInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="6"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[264]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="9"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[19061]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="11"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[826]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo)"/>
					</include>
					<include content="Groove_DialogButton">
						<param name="id" value="4"/>
						<param name="width" value="216"/>
						<param name="label" value="$LOCALIZE[19003]"/>
						<param name="visible" value="Window.IsActive(PVRGuideInfo) | Window.IsActive(PVRRecordingInfo)"/>
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
