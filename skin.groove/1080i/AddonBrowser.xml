<?xml version="1.0" encoding="UTF-8"?>
<!--
	Add-on browser (M4, Builder E; SPEC 5 Minimal): page header, mono sub-nav replacing Estuary's
	side blade, view 50 list with the add-on icon / summary panel.
	Kodi ids from Estuary Omega: view 50, menucontrol 9000, radiobuttons 7 (hide foreign) /
	8 (hide incompatible), buttons 9 (check repository updates) / 5 (add-on settings),
	3 / 4 sort buttons (hidden; the SORT sub-nav item clicks 3).
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<menucontrol>9000</menucontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<views>50</views>
	<controls>
		<include>Groove_Page</include>
		<!-- M4: content group -->
		<control type="group">
			<include>Anim_WindowContent</include>
			<include content="Groove_TopBar">
				<param name="index" value="SYS"/>
				<param name="title" value="$LOCALIZE[24001]"/>
				<param name="icon" value="icons/addons.png"/>
				<param name="sub" value="$INFO[Container.FolderName]"/>
			</include>
			<include>View_50_List</include>
			<!-- empty folder / still loading -->
			<control type="label">
				<left>page_margin</left>
				<top>list_top</top>
				<width>list_w</width>
				<height>66</height>
				<textoffsetx>56</textoffsetx>
				<font>font_fact_label</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$LOCALIZE[31012]</label>
				<visible>Integer.IsEqual(Container.NumItems,0) + !Container.IsUpdating</visible>
			</control>
			<!-- last repository check, bottom-left -->
			<control type="label">
				<left>page_margin</left>
				<top>1036</top>
				<width>1100</width>
				<height>24</height>
				<font>font_fact_label</font>
				<textcolor>$VAR[ink2]</textcolor>
				<label>$INFO[Window(AddonBrowser).Property(Updated),$LOCALIZE[12014]  ,]</label>
			</control>
			<control type="grouplist" id="9000">
				<left>subnav_left</left>
				<top>below_bar_top</top>
				<width>1500</width>
				<height>subnav_h</height>
				<orientation>horizontal</orientation>
				<itemgap>28</itemgap>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<onup>noop</onup>
				<ondown>50</ondown>
				<onback>50</onback>
				<include content="Groove_SubNavButton">
					<param name="id" value="6053"/>
					<param name="label" value="$LOCALIZE[31010]: $INFO[Container.SortMethod]"/>
					<param name="onclick" value="SendClick(3)"/>
					<param name="visible" value="Control.IsEnabled(3)"/>
				</include>
				<control type="radiobutton" id="7">
					<description>Hide foreign</description>
					<include>Dlg_SubNavRadio</include>
					<label>$LOCALIZE[25001]</label>
					<visible>Control.IsEnabled(7)</visible>
				</control>
				<control type="radiobutton" id="8">
					<description>Hide incompatible</description>
					<include>Dlg_SubNavRadio</include>
					<label>$LOCALIZE[24999]</label>
					<visible>Control.IsEnabled(8)</visible>
				</control>
				<include content="Groove_SubNavButton">
					<param name="id" value="9"/>
					<param name="label" value="$LOCALIZE[24034]"/>
				</include>
				<include content="Groove_SubNavButton">
					<param name="id" value="5"/>
					<param name="label" value="$LOCALIZE[10004]"/>
				</include>
			</control>
			<control type="button" id="3">
				<description>Sort by (Kodi)</description>
				<include>Groove_Hidden</include>
			</control>
			<control type="button" id="4">
				<description>Sort order (Kodi)</description>
				<include>Groove_Hidden</include>
			</control>
		</control>
	</controls>
</window>
