		<value condition="String.StartsWith(Skin.String(CustomRow.3.Path),musicdb://) | String.StartsWith(Skin.String(CustomRow.3.Path),library://music/) | String.StartsWith(Skin.String(CustomRow.3.Path),plugin://plugin.audio.) | String.StartsWith(Skin.String(CustomRow.3.Path),special://musicplaylists/) | String.Contains(Skin.String(CustomRow.3.Path),/playlists/music/)">music</value>
