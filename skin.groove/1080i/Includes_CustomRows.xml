	<!-- <content> of row n (put inside the row's list) -->
	<include name="CustomRow_Content">
		<definition>
			<content target="$VAR[CustomRow_Target$PARAM[row]]" limit="40" browse="never">$VAR[CustomRow_Path$PARAM[row]]</content>
		</definition>
	</include>

	<!-- Home: the three add-on probes (1 px, always processed; put once in Home.xml) -->
	<include name="CustomRows_Probes">
		<control type="list" id="9884">
			<left>0</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content>$VAR[CustomRow_Probe1]</content>
		</control>
		<control type="list" id="9885">
			<left>0</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
