<?xml version="1.0" encoding="UTF-8"?>
<!--
	Custom rows on Home (opt-in; nothing shows until a row is set up in Skin settings > Custom rows).
	GENERATED by tools/customrows/make_customrows.py - edit the generator, not this file.
	Home lists 9881 / 9882 / 9883 (rows 1-3, drawn by this skin's own row look), settings favourites list 9889.
	Skin strings CustomRow.<n>.Path / .Label / .Target (/ .Icon) are written by script.skinvariables
	(set_shortcut browser, run_dialog menus, run_executebuiltin rules in shortcuts/customrows-favourite.json).
	The row lists have NO onclick: Kodi's list provider opens folders in the <content target> window and plays
	files (with the user's video select action), favourites included (CDirectoryProvider::OnClick, Omega).
	Keep the lists always visible (a hidden container never loads); gate their decorations on CustomRow<n>On.
-->
<includes>
	<expression name="CustomRow1On">Integer.IsGreater(Container(9881).NumItems,0)</expression>
	<expression name="CustomRow2On">Integer.IsGreater(Container(9882).NumItems,0)</expression>
	<expression name="CustomRow3On">Integer.IsGreater(Container(9883).NumItems,0)</expression>
	<expression name="CustomRowsFocus">Control.HasFocus(9881) | Control.HasFocus(9882) | Control.HasFocus(9883)</expression>
	<expression name="CustomRowsAnyOn">Integer.IsGreater(Container(9881).NumItems,0) | Integer.IsGreater(Container(9882).NumItems,0) | Integer.IsGreater(Container(9883).NumItems,0)</expression>

	<!-- folder target of row n: what the picker stored, else a guess from the path -->
	<variable name="CustomRow_Target1">
		<value condition="!String.IsEmpty(Skin.String(CustomRow.1.Target))">$INFO[Skin.String(CustomRow.1.Target)]</value>
		<value condition="String.StartsWith(Skin.String(CustomRow.1.Path),musicdb://) | String.StartsWith(Skin.String(CustomRow.1.Path),library://music/) | String.StartsWith(Skin.String(CustomRow.1.Path),plugin://plugin.audio.) | String.StartsWith(Skin.String(CustomRow.1.Path),special://musicplaylists/) | String.Contains(Skin.String(CustomRow.1.Path),/playlists/music/)">music</value>
		<value condition="String.StartsWith(Skin.String(CustomRow.1.Path),plugin://plugin.program.) | String.StartsWith(Skin.String(CustomRow.1.Path),plugin://script.)">programs</value>
		<value>videos</value>
	</variable>
	<variable name="CustomRow_Target2">
		<value condition="!String.IsEmpty(Skin.String(CustomRow.2.Target))">$INFO[Skin.String(CustomRow.2.Target)]</value>
