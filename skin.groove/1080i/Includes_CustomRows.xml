	<!-- row n's path: plugin:// rows only once their probe found the add-on installed (a missing add-on would make
	     Kodi offer to download it on every Home visit); other paths as stored. Never empty: Kodi's list provider
	     ignores a path that turns empty and keeps showing the old items, so a cleared row (or a probe with nothing
	     to probe) points at special://skin/shortcuts/customrows-none.xsp, a smart playlist that is always empty. -->
	<variable name="CustomRow_Path1">
		<value condition="String.IsEmpty(Skin.String(CustomRow.1.Path))">special://skin/shortcuts/customrows-none.xsp</value>
		<value condition="!String.StartsWith(Skin.String(CustomRow.1.Path),plugin://) | String.IsEmpty(Skin.String(CustomRow.1.Addon))">$INFO[Skin.String(CustomRow.1.Path)]</value>
		<value condition="Integer.IsGreater(Container(9884).NumItems,0)">$INFO[Skin.String(CustomRow.1.Path)]</value>
		<value>special://skin/shortcuts/customrows-none.xsp</value>
	</variable>
	<variable name="CustomRow_Probe1">
		<value condition="String.StartsWith(Skin.String(CustomRow.1.Path),plugin://) + !String.IsEmpty(Skin.String(CustomRow.1.Addon))">plugin://script.skinvariables/?info=get_dbitem_addon_details&amp;dbid=$INFO[Skin.String(CustomRow.1.Addon)]</value> <!-- kdk-ignore: xml-validation; an add-on id (plugin://<id>/ of the stored path, shortcuts/customrows-addon.json): never holds & or spaces -->
		<value>special://skin/shortcuts/customrows-none.xsp</value>
	</variable>
	<variable name="CustomRow_Path2">
		<value condition="String.IsEmpty(Skin.String(CustomRow.2.Path))">special://skin/shortcuts/customrows-none.xsp</value>
		<value condition="!String.StartsWith(Skin.String(CustomRow.2.Path),plugin://) | String.IsEmpty(Skin.String(CustomRow.2.Addon))">$INFO[Skin.String(CustomRow.2.Path)]</value>
