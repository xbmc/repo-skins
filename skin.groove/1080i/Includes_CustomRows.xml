			<height>1</height>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content>$VAR[CustomRow_Probe3]</content>
		</control>
	</include>

	<!-- settings: hidden data list of Kodi's favourites (put once in SkinSettings.xml) -->
	<include name="CustomRows_FavData">
		<control type="list" id="9889">
			<left>0</left>
			<top>0</top>
			<width>1</width>
			<height>1</height>
			<itemlayout width="1" height="1"/>
			<focusedlayout width="1" height="1"/>
			<content>favourites://</content>
		</control>
	</include>

	<!-- settings: the onclick of row n's button (param row = 1 | 2 | 3): Kodi's select dialog with
	     Add-on, playlist or library... / A favourite... (when there are favourites) / Rename... / Clear (when set) -->
	<include name="CustomRows_SettingsClick">
		<definition>
			<onclick condition="String.IsEmpty(Skin.String(CustomRow.$PARAM[row].Path)) + !Integer.IsGreater(Container(9889).NumItems,0)">RunScript(script.skinvariables,run_dialog=select,heading=$PARAM[heading],separator=|,"list=$LOCALIZE[31945]",executebuiltin_0=route=set_shortcut=CustomRow.$PARAM[row]&amp;use_rawpath=True||sleep=0.5||route=run_executebuiltin=special://skin/shortcuts/customrows-addon.json&amp;use_rules=True&amp;row=$PARAM[row])</onclick>
			<onclick condition="String.IsEmpty(Skin.String(CustomRow.$PARAM[row].Path)) + Integer.IsGreater(Container(9889).NumItems,0)">RunScript(script.skinvariables,run_dialog=select,heading=$PARAM[heading],separator=|,"list=$LOCALIZE[31945]|$LOCALIZE[31946]",executebuiltin_0=route=set_shortcut=CustomRow.$PARAM[row]&amp;use_rawpath=True||sleep=0.5||route=run_executebuiltin=special://skin/shortcuts/customrows-addon.json&amp;use_rules=True&amp;row=$PARAM[row],executebuiltin_1=RunScript(script.skinvariables,run_dialog=select,heading=$LOCALIZE[1036],separator=|,"list=$VAR[CustomRows_FavList]",executebuiltin=RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/customrows-favourite.json,use_rules,row=$PARAM[row],list=9889,index={{x}},heading=$PARAM[heading],msg=$LOCALIZE[31949],msgaddon=$LOCALIZE[31956])))</onclick>
			<onclick condition="!String.IsEmpty(Skin.String(CustomRow.$PARAM[row].Path)) + !Integer.IsGreater(Container(9889).NumItems,0)">RunScript(script.skinvariables,run_dialog=select,heading=$PARAM[heading],separator=|,"list=$LOCALIZE[31945]|$LOCALIZE[31947]|$LOCALIZE[31948]",executebuiltin_0=route=set_shortcut=CustomRow.$PARAM[row]&amp;use_rawpath=True||sleep=0.5||route=run_executebuiltin=special://skin/shortcuts/customrows-addon.json&amp;use_rules=True&amp;row=$PARAM[row],executebuiltin_1=Skin.SetString(CustomRow.$PARAM[row].Label),executebuiltin_2=Skin.Reset(CustomRow.$PARAM[row].Path)||Skin.Reset(CustomRow.$PARAM[row].Label)||Skin.Reset(CustomRow.$PARAM[row].Target)||Skin.Reset(CustomRow.$PARAM[row].Icon)||Skin.Reset(CustomRow.$PARAM[row].Addon))</onclick>
			<onclick condition="!String.IsEmpty(Skin.String(CustomRow.$PARAM[row].Path)) + Integer.IsGreater(Container(9889).NumItems,0)">RunScript(script.skinvariables,run_dialog=select,heading=$PARAM[heading],separator=|,"list=$LOCALIZE[31945]|$LOCALIZE[31946]|$LOCALIZE[31947]|$LOCALIZE[31948]",executebuiltin_0=route=set_shortcut=CustomRow.$PARAM[row]&amp;use_rawpath=True||sleep=0.5||route=run_executebuiltin=special://skin/shortcuts/customrows-addon.json&amp;use_rules=True&amp;row=$PARAM[row],executebuiltin_1=RunScript(script.skinvariables,run_dialog=select,heading=$LOCALIZE[1036],separator=|,"list=$VAR[CustomRows_FavList]",executebuiltin=RunScript(script.skinvariables,run_executebuiltin=special://skin/shortcuts/customrows-favourite.json,use_rules,row=$PARAM[row],list=9889,index={{x}},heading=$PARAM[heading],msg=$LOCALIZE[31949],msgaddon=$LOCALIZE[31956])),executebuiltin_2=Skin.SetString(CustomRow.$PARAM[row].Label),executebuiltin_3=Skin.Reset(CustomRow.$PARAM[row].Path)||Skin.Reset(CustomRow.$PARAM[row].Label)||Skin.Reset(CustomRow.$PARAM[row].Target)||Skin.Reset(CustomRow.$PARAM[row].Icon)||Skin.Reset(CustomRow.$PARAM[row].Addon))</onclick>
