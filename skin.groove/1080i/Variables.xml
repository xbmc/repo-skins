<?xml version="1.0" encoding="UTF-8"?>
<!--
	Variables: labels / textures / colours that switch on conditions. Use as $VAR[Name].
	Colours are returned as NAMES from colors/defaults.xml (never hex in windows).
	Note: $VAR works in colordiffuse="" and <textcolor>/<focusedcolor>, NOT in diffuse="" or border="".
-->
<includes>
	<!-- ===================================================================== colours -->

	<!-- Rules: solid greys on the flat page, white-alpha over the artwork background (DESIGN 2.2) -->
	<variable name="ColorRule">
		<value condition="$EXP[ArtBackgroundOn]">$VAR[line]</value>
		<value>$VAR[line]</value>
	</variable>
	<!-- Mono captions: promoted to text_secondary over artwork (DESIGN 2.5) -->
	<variable name="ColorCaption">
		<value condition="$EXP[ArtBackgroundOn]">$VAR[ink2]</value>
		<value>$VAR[ink2]</value>
	</variable>

	<!-- ==================================================================== textures -->

	<!-- Frames for controls that must ALWAYS show focus (buttons, dialogs): never empty -->
	<variable name="FocusFrameAlways">
		<value condition="$EXP[FocusOutlineMedium] + $EXP[IsRounded]">focus/outline_3_round.png</value>
		<value condition="$EXP[FocusOutlineMedium]">focus/outline_3.png</value>
		<value condition="$EXP[IsRounded]">focus/outline_2_round.png</value>
		<value>focus/outline_2.png</value>
	</variable>

	<variable name="ButtonOutline">
		<value condition="$EXP[IsRounded]">common/rect_outline_1_round8.png</value>
		<value>common/rect_outline_1.png</value>
	</variable>

	<!-- ====================================================================== labels -->

	<variable name="ClockLabel">
		<value>$INFO[System.Time]</value>
	</variable>

	<!-- Poster/thumb for any list item (view 50 art panel, dialogs) -->
	<variable name="ListItemArt">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>

	<!-- Library page title (MyVideoNav / MyMusicNav header) -->
	<variable name="LibraryTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="Window.IsActive(Music)">$LOCALIZE[2]</value>
		<value>$LOCALIZE[3]</value>
	</variable>
</includes>
