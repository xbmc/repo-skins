<?xml version="1.0" encoding="UTF-8"?>
<!--
	The Library panel, the view picker and the clean-library confirmation, drawn as Groove cards
	(docs/skin.groove/screens/LibraryPanel.md, screens/README.md section 6). Engine from Nocturne 0.9.6: all three live
	INSIDE the library windows (MyMusicNav, MyVideoNav), so Kodi's own ids (3 sort by, 4 sort order, 14 watched toggle),
	Control.IsVisible(<view>) and Container.SetViewMode() work exactly as they do for the header icons.

	Ids: 9800 panel group, 9801 panel list (static rows, up to 9: Sets shows only over films), 9850 picker group, 9851 picker list,
	     9890 confirm group, 9893 its grouplist (9891 No - first and focused, 9892 Yes).
	Opening: SetFocus(9801,0,absolute) / SetFocus(9851,n,absolute) / SetFocus(9891). The cards are always "visible"
	(a hidden static list never fills its rows and can't take focus) and fade in / out on focus (Conditional fades), so
	focus never lands on something unseen.
	Where you came from: Window(Home).Property(groove.lib.from) = view | header, (groove.pick.from) = panel | header.
	Back on a card = a numeric onback to where you came from (the view keeps its item).
	Clean library: Kodi's CleanLibrary() builtin does NOT ask (LESSONS), so the card asks first, "No" focused.

	Contract with the windows (MyMusicNav: music lane; MyVideoNav: video lane):
	  Lib_Panel   params is_video (true|false), kind (music|video), section, view_name, order_click,
	              pick_focus (include of conditional SetFocus(9851,n,absolute) lines), header_back (Options icon id)
	  Lib_Picker  params items (include: Lib_PickerItemLayout + <content>), section, header_back (View icon id)
	  Lib_PickerItemLayout  param current (condition: this item is the view on show)
	  Previews: media/groove/views/{dark,light}/<view>.png (_src/make_view_previews.py, schematic, no real art).
-->
<includes>
	<!-- ============================================================ shared -->
	<!-- Options reach v2 (2026-10-29): an ITEM menu in Videos / Music (one of Kodi's buttons 1001-1020 reads Add to /
	     Remove from favourites, 14076 / 14077: Kodi's resume prompt, the select-action chooser, Play using... and the
	     Manage... submenu use the same dialog and never carry it) gets one extra first row, DialogContextMenu 990,
	     that opens this panel on View. Not over the information dialogs (the panel lives in the media window). -->
	<expression name="Lib_CtxRow">[Window.IsActive(videos) | Window.IsActive(music)] + !Window.IsVisible(movieinformation) + !Window.IsVisible(musicinformation) + !Window.IsVisible(songinformation) + [String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1001),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1002),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1003),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1004),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1005),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1006),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1007),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1008),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1009),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1010),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1011),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1012),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1013),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1014),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1015),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1016),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1017),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1018),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1019),$LOCALIZE[14077]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14076]) | String.IsEqual(Control.GetLabel(1020),$LOCALIZE[14077])]</expression>
	<expression name="Lib_LibraryActions">!Container.Content(addons) + String.IsEmpty(Container.PluginName)</expression>

	<variable name="Lib_SortOrder">
		<value condition="Container.SortDirection(descending)">$LOCALIZE[585]</value>
		<value>$LOCALIZE[584]</value>
	</variable>
	<variable name="Lib_UpdateVideo">
		<value condition="Library.IsScanningVideo">$LOCALIZE[31612]</value>
		<value>$LOCALIZE[31622]</value>
	</variable>
	<variable name="Lib_UpdateMusic">
		<value condition="Library.IsScanningMusic">$LOCALIZE[31612]</value>
		<value>$LOCALIZE[31622]</value>
	</variable>
	<variable name="Lib_Unwatched">
		<value condition="System.Setting(hidewatched)">$LOCALIZE[31295]</value>
		<value>$LOCALIZE[31296]</value>
	</variable>
	<variable name="Lib_PreviewDir">
		<value condition="$EXP[GrooveLight]">light</value>
		<value>dark</value>
	</variable>

	<!-- Open the panel from a view edge (builtins only: they run in order). Horizontal lists run these only at their
	     ends; vertical lists / panels at the first / last column (LESSONS library panel). -->
	<include name="Lib_OpenLeft">
		<onleft>SetProperty(groove.lib.from,view,home)</onleft>
		<onleft>SetFocus(9801,0,absolute)</onleft>
	</include>
	<include name="Lib_OpenRight">
		<onright>SetProperty(groove.lib.from,view,home)</onright>
		<onright>SetFocus(9801,0,absolute)</onright>
	</include>
	<!-- back to whichever view is showing (music 500-503 / 50, video 500 / 510 / 50): the first matching numeric wins -->
	<include name="Lib_BackToView">
		<onback condition="Control.IsVisible(500)">500</onback>
		<onback condition="Control.IsVisible(501)">501</onback>
		<onback condition="Control.IsVisible(502)">502</onback>
		<onback condition="Control.IsVisible(503)">503</onback>
		<onback condition="Control.IsVisible(510)">510</onback>
		<onback condition="Control.IsVisible(520)">520</onback>
		<onback condition="Control.IsVisible(521)">521</onback>
		<onback condition="Control.IsVisible(522)">522</onback>
		<onback>50</onback>
	</include>
	<!-- Show only while a card has focus: a Conditional fade (normal / reduced twins, fades only). -->
	<include name="Lib_FadeGate">
		<animation effect="fade" start="100" end="0" time="140" tween="cubic" easing="out" condition="![$PARAM[show]] + !Skin.HasSetting(groove.reducemotion)">Conditional</animation>
		<animation effect="fade" start="100" end="0" time="60" condition="![$PARAM[show]] + Skin.HasSetting(groove.reducemotion)">Conditional</animation>
	</include>
	<!-- the room behind a card: veiled (dark: 80 % of the deep ground; light: 70 % paper) -->
	<include name="Lib_Dim">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="$VAR[dim_dialog]">groove/white.png</texture>
		</control>
	</include>
	<!-- A floating card: drop shadow + surface + 2 px line edge. params: left, top, width, height, visible -->
	<include name="Lib_Card">
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<visible>$PARAM[visible]</visible>
				<control type="image">
					<left>-96</left>
					<top>-60</top>
					<width>$PARAM[shadow_w]</width>
					<height>$PARAM[shadow_h]</height>
					<texture border="96,60,96,120" colordiffuse="$VAR[shadow]">groove/shadow_square.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture colordiffuse="$VAR[surface]">groove/white.png</texture>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>$PARAM[width]</width>
					<height>$PARAM[height]</height>
					<texture border="4" colordiffuse="$VAR[line]">groove/card_edge.png</texture>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============================================================ the library panel -->
	<!-- Panel rows: icon 40 at x 24, label at 88 (ink2 -> ink on focus), value right-aligned at 616 (font_small, ink2).
	     Focused row: 8 % fill + the icon's soft light. -->
	<include name="Lib_PanelRow">
		<param name="focused">false</param>
		<definition>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>616</width>
				<height>64</height>
				<texture colordiffuse="$VAR[focus_fill]">groove/white.png</texture>
				<visible>$PARAM[focused] + Control.HasFocus(9801)</visible>
			</control>
			<control type="image">
				<left>-26</left>
				<top>-26</top>
				<width>116</width>
				<height>116</height>
				<texture colordiffuse="$VAR[focus_glow]">groove/glow_radial.png</texture>
				<visible>$PARAM[focused] + Control.HasFocus(9801)</visible>
			</control>
			<control type="image">
				<left>12</left>
				<top>12</top>
				<width>40</width>
				<height>40</height>
				<texture colordiffuse="$VAR[ink2]">$INFO[ListItem.Icon]</texture>
