	<include name="Lib_PickFocusMusic">
		<onclick condition="Control.IsVisible(500) + Container.Content(albums)">SetFocus(9851,0,absolute)</onclick>
		<onclick condition="Control.IsVisible(501) + Container.Content(albums)">SetFocus(9851,1,absolute)</onclick>
		<onclick condition="Control.IsVisible(502) + Container.Content(albums)">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(503) + Container.Content(albums)">SetFocus(9851,3,absolute)</onclick>
