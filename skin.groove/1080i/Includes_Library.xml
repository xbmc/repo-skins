					<animation effect="slide" start="0,0" end="0,64" time="0" condition="Integer.IsEqual(Container(9801).NumItems,8)">Conditional</animation>
					<animation effect="slide" start="0,0" end="0,96" time="0" condition="Integer.IsEqual(Container(9801).NumItems,7)">Conditional</animation>
					<animation effect="slide" start="0,0" end="0,128" time="0" condition="Integer.IsEqual(Container(9801).NumItems,6)">Conditional</animation>
					<animation effect="slide" start="0,0" end="0,160" time="0" condition="Integer.IsEqual(Container(9801).NumItems,5)">Conditional</animation>
					<animation effect="slide" start="0,0" end="0,192" time="0" condition="Integer.IsLessOrEqual(Container(9801).NumItems,4)">Conditional</animation>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="736"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="916"/>
						<param name="visible" value="Integer.IsGreaterOrEqual(Container(9801).NumItems,10)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="672"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="852"/>
						<param name="visible" value="Integer.IsEqual(Container(9801).NumItems,9)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="608"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="788"/>
						<param name="visible" value="Integer.IsEqual(Container(9801).NumItems,8)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="544"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="724"/>
						<param name="visible" value="Integer.IsEqual(Container(9801).NumItems,7)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="480"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="660"/>
						<param name="visible" value="Integer.IsEqual(Container(9801).NumItems,6)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="416"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="596"/>
						<param name="visible" value="Integer.IsEqual(Container(9801).NumItems,5)"/>
					</include>
					<include content="Lib_Card">
						<param name="left" value="0"/><param name="top" value="0"/><param name="width" value="640"/><param name="height" value="352"/>
						<param name="shadow_w" value="832"/><param name="shadow_h" value="532"/>
						<param name="visible" value="Integer.IsLessOrEqual(Container(9801).NumItems,4)"/>
					</include>
					<!-- header row: the options icon + "Library", the section on the right -->
					<control type="image">
						<left>24</left>
						<top>16</top>
						<width>40</width>
						<height>40</height>
						<texture colordiffuse="$VAR[ink]">icons/options.png</texture>
					</control>
					<control type="label">
						<left>88</left>
						<top>0</top>
						<width>300</width>
						<height>72</height>
						<aligny>center</aligny>
						<font>font_label</font>
						<textcolor>$VAR[ink]</textcolor>
						<label>$LOCALIZE[31608]</label>
					</control>
					<control type="label">
						<left>316</left>
						<top>0</top>
						<width>300</width>
						<height>72</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>font_small</font>
						<textcolor>$VAR[ink2]</textcolor>
						<label>$PARAM[section]</label>
					</control>
					<control type="image">
						<left>24</left>
						<top>71</top>
						<width>592</width>
						<height>1</height>
						<texture colordiffuse="$VAR[line_hair]">groove/white.png</texture>
					</control>
