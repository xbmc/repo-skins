						</focusedlayout>
						<content>
							<item>
								<label>$LOCALIZE[31635]</label>
								<label2>$PARAM[view_name]</label2>
								<icon>icons/view.png</icon>
								<onclick>SetProperty(groove.pick.from,panel,home)</onclick>
								<include content="$PARAM[pick_focus]"/>
