		<onclick condition="Control.IsVisible(50) + Container.Content(artists)">SetFocus(9851,2,absolute)</onclick>
		<onclick condition="Control.IsVisible(500) + Container.Content(songs)">SetFocus(9851,0,absolute)</onclick>
