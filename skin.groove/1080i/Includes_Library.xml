				<width>240</width>
				<height>64</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>font_small</font>
				<textcolor>$VAR[ink2]</textcolor>
				<selectedcolor>$VAR[ink2]</selectedcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</definition>
	</include>

	<!-- params: is_video, kind (video | music), section (right-hand caption), view_name, order_click, pick_focus,
	     header_back (the header's Options icon: Back returns there when the panel was opened from it) -->
