				<control type="group">
					<left>128</left>
					<top>354</top>
					<animation effect="slide" start="0,0" end="160,0" time="0" condition="Integer.IsEqual(Container(9851).NumItems,4)">Conditional</animation>
					<animation effect="slide" start="0,0" end="320,0" time="0" condition="Integer.IsEqual(Container(9851).NumItems,3)">Conditional</animation>
