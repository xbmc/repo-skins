			</control>
			<control type="image">
				<left>12</left>
				<top>12</top>
				<width>40</width>
				<height>40</height>
				<texture colordiffuse="$VAR[ink]">$INFO[ListItem.Icon]</texture>
				<visible>$PARAM[focused] + Control.HasFocus(9801)</visible>
			</control>
			<control type="label">
				<left>76</left>
				<top>0</top>
				<width>300</width>
				<height>64</height>
				<aligny>center</aligny>
				<font>font_label</font>
				<textcolor>$VAR[ink2]</textcolor>
				<selectedcolor>$VAR[ink2]</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>![$PARAM[focused] + Control.HasFocus(9801)]</visible>
			</control>
			<control type="label">
				<left>76</left>
				<top>0</top>
				<width>300</width>
				<height>64</height>
				<aligny>center</aligny>
				<font>font_label</font>
				<textcolor>$VAR[ink]</textcolor>
				<selectedcolor>$VAR[ink]</selectedcolor>
				<label>$INFO[ListItem.Label]</label>
				<visible>$PARAM[focused] + Control.HasFocus(9801)</visible>
			</control>
