						<onright>noop</onright>
						<onback condition="String.IsEqual(Window(Home).Property(groove.lib.from),header)">$PARAM[header_back]</onback>
						<include>Lib_BackToView</include>
						<include>Anim_ScrollRow</include>
						<itemlayout width="616" height="64">
							<include content="Lib_PanelRow"/>
						</itemlayout>
						<focusedlayout width="616" height="64">
							<include content="Lib_PanelRow">
								<param name="focused" value="true"/>
