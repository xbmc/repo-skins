								<visible>Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)</visible>
							</item>
							<item>
								<label>$LOCALIZE[31638]</label>
								<label2>$VAR[Lib_Unwatched]</label2>
								<icon>icons/filter.png</icon>
								<onclick>SendClick(14)</onclick>
								<visible>$PARAM[is_video] + [Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(musicvideos)] + !String.StartsWith(Container.FolderPath,videodb://inprogresstvshows)</visible>
							</item>
							<item>
								<label>$LOCALIZE[31637]</label>
								<label2>$VAR[Lib_SortOrder]</label2>
								<icon>icons/sort.png</icon>
								<onclick>$PARAM[order_click]</onclick>
								<visible>Control.IsEnabled(3) + !String.IsEmpty(Container.SortMethod)</visible>
							</item>
							<!-- Sets (films only, when the library has sets): the sets list in this same window. Focus goes
							     back to the view first (the panel closes), then the update: Back walks set -> sets -> films. -->
							<item>
								<label>$LOCALIZE[20434]</label>
								<icon>icons/films.png</icon>
								<onclick>SetFocus(50)</onclick>
								<onclick>Container.Update(videodb://movies/sets/)</onclick>
								<visible>$PARAM[is_video] + [Container.Content(movies) | String.IsEqual(Container.FolderPath,videodb://movies/titles/)] + Library.HasContent(moviesets)</visible>
							</item>
							<item>
								<label>$LOCALIZE[31639]</label>
								<icon>icons/search.png</icon>
								<onclick>ActivateWindow(1150)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[31640]</label>
