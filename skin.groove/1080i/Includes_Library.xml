							<item>
								<label>$LOCALIZE[31622]</label>
								<icon>icons/update.png</icon>
								<onclick>UpdateLibrary(music)</onclick>
								<visible>!$PARAM[is_video] + $EXP[Lib_LibraryActions] + !Library.IsScanningMusic</visible>
