								<icon>icons/system.png</icon>
								<onclick>ActivateWindow(MediaSettings)</onclick>
							</item>
							<item>
								<label>$LOCALIZE[31622]</label>
								<label2>$VAR[Lib_UpdateVideo]</label2>
								<icon>icons/update.png</icon>
								<onclick>UpdateLibrary(video)</onclick>
								<visible>$PARAM[is_video] + $EXP[Lib_LibraryActions] + Library.IsScanningVideo</visible>
							</item>
