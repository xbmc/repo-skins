<?xml version="1.0" encoding="UTF-8"?>
<!-- Clears Window(Home).Property(groove.fsseen) once nothing is playing, re-arming the play-start
     curtain (Custom_1153_PlayCurtain.xml). Opens itself, clears, and closes again at once. -->
<window type="dialog" id="1154">
	<visible>!Player.HasMedia + !String.IsEmpty(Window(Home).Property(groove.fsseen))</visible>
	<onload>ClearProperty(groove.fsseen,home)</onload>
	<controls/>
</window>
