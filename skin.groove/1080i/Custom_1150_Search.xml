<?xml version="1.0" encoding="UTF-8"?>
<!--
	Groove Search, custom window 1150 (screens/Custom_1150_Search.md). Opened from Home's Search icon and the library
	panel: ActivateWindow(1150). No Kodi-owned ids. Pieces: Includes_Search.xml.
	Flow: opens on the query line; when it is empty the keyboard opens at once (9099's onfocus: Select on an edit opens
	Kodi's keyboard, SendClick doesn't). Done -> the rows fill. Down / Up hop rows from any item (rule 3), Left / Right
	walk a row and stop at its ends. Back from a row -> the query line; Back from the query line closes the window.
	Up from the query line -> the mini player while music plays. No window-level animation (MOTION 3).
-->
<window type="window" id="1150">
	<defaultcontrol always="true">9099</defaultcontrol>
	<backgroundcolor>ground_static</backgroundcolor>
	<!-- the encoded query (Includes_Search.xml) must not outlive the window: a stale one would show old rows -->
	<onunload>ClearProperty(Groove.Search.Encoded,home)</onunload>
	<controls>
		<control type="button" id="9099">
			<left>-100</left>
			<top>-100</top>
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<onfocus>SetFocus(9001)</onfocus>
			<onfocus condition="!$EXP[Search_HasQuery]">Action(Select)</onfocus>
			<visible allowhiddenfocus="true">false</visible>
		</control>
		<include>Groove_Room</include>
		<control type="group">
			<include>Anim_WindowContent</include>
			<include>Search_Page</include>
		</control>
		<include content="VidView_MiniPlayer">
			<param name="down" value="9001"/>
			<param name="back" value="9001"/>
		</include>
	</controls>
</window>
