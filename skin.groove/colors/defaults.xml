<?xml version="1.0" encoding="UTF-8"?>
<!--
	skin.groove palette (docs/skin.groove/DESIGN.md section 2 + "Light room"). AARRGGBB.

	TWO ROOMS, ONE SET OF XML (docs/skin.groove/CONVENTIONS.md section 4):
	  every room token exists twice here, dk_<token> (Dark room, the approved mockups) and lt_<token> (Light room),
	  and 1080i/Includes_Theme.xml defines a variable <token> that returns one of the two names.
	  Windows ONLY write $VAR[<token>] (textcolor, colordiffuse, [COLOR], params). Never dk_/lt_ directly, never hex.
	  The Light room switches back to Dark by itself over fullscreen video, games, slideshows and the visualiser
	  (expression GrooveLight), so playback chrome is always dark.

	Static colours (same in both rooms) are the only names a window may use without $VAR:
	  white, black, clear, white_NN (alpha multipliers for art), dim_video, ground_static.

	Light values: final (visual-designer, DESIGN.md section 12 "Light room", boards 11-13). Each lt_ alpha was set
	by matching its dk_ twin's L* distance from the ground, then checked on the boards. The designer edits only
	the lt_ values (and dk_ if the dark palette moves).
-->
<colors>
	<!-- ===================================================== room tokens: Dark -->
	<color name="dk_ground">ff221f1c</color>          <!-- room_centre: flat fills on the ground -->
	<color name="dk_ground_edge">ff191715</color>     <!-- room_edge -->
	<color name="dk_surface">ff2b2724</color>         <!-- dialog card fill -->
	<color name="dk_surface_raised">ff35302c</color>  <!-- fallback art block, keys -->
	<color name="dk_ink">ebffffff</color>             <!-- 92 %: primary text, focused icons -->
	<color name="dk_ink2">8cffffff</color>            <!-- 55 %: secondary text -->
	<color name="dk_ink3">4dffffff</color>            <!-- 30 %: rest-state tray icons, faint text -->
	<color name="dk_ink_faint">14ffffff</color>       <!-- 8 %: the big year numeral -->
	<color name="dk_icon_rest">73ffffff</color>       <!-- 45 %: unfocused rail icons -->
	<color name="dk_header_rest">33ffffff</color>     <!-- 20 %: library header while the view has focus -->
	<color name="dk_rim">99ffffff</color>             <!-- 2 px focus rim on the focused cover -->
	<color name="dk_line">29ffffff</color>            <!-- progress track, timeline baseline -->
	<color name="dk_line_strong">40ffffff</color>     <!-- control borders, slider bars -->
	<color name="dk_line_hair">1affffff</color>       <!-- wheel slice separators, row rules -->
	<color name="dk_focus_glow">33ffffff</color>      <!-- white radial behind a focused icon / lit row (20 %) -->
	<color name="dk_focus_fill">1affffff</color>      <!-- flat focus fill where a radial can't sit (keys) -->
	<color name="dk_on_lit">ff1c1916</color>          <!-- text on an ink-coloured (lit) fill -->
	<color name="dk_disabled">4dffffff</color>
	<color name="dk_text_shadow">80000000</color>     <!-- label shadow over art -->
	<color name="dk_shadow">8c000000</color>          <!-- tint for shadow textures -->
	<color name="dk_dim_cover">ff707070</color>       <!-- colordiffuse multiply on unfocused covers -->
	<color name="dk_dim_stage">ff616161</color>       <!-- Now Playing stage behind an open overlay -->
	<color name="dk_dim_dialog">cc141210</color>      <!-- the room dimmed behind a dialog -->
	<color name="dk_scrim_soft">8c191715</color>      <!-- lighter scrim (tabs over art) -->
	<color name="dk_glow_fallback">ffe8d9c4</color>   <!-- warm white glow when no colour source is available -->

	<color name="dk_art_pool">00ffffff</color>   <!-- pool under a focused cover (Light only, gated) (DESIGN 12.3) -->
	<color name="dk_logo_tint">ffffffff</color>   <!-- colordiffuse on every clearlogo (ink silhouettes in Light) (DESIGN 12.3) -->
	<color name="dk_halo">e6ffffff</color>   <!-- alpha on the art halo / tint layer (DESIGN 12.3) -->
	<color name="dk_ring_fill">09ffffff</color>   <!-- wheel slice fill (DESIGN 12.3) -->
	<color name="dk_ring_fill_focus">29ffffff</color>   <!--  (DESIGN 12.3) -->
	<color name="dk_ring_edge">1affffff</color>   <!-- wheel slice outline (DESIGN 12.3) -->
	<color name="dk_ring_edge_focus">bfffffff</color>   <!--  (DESIGN 12.3) -->
	<color name="dk_wash_soft">40ffffff</color>   <!-- room wash alpha, Glow strength Soft (DESIGN 12.3) -->
	<color name="dk_wash_medium">66ffffff</color>   <!-- Medium (default) (DESIGN 12.3) -->
	<color name="dk_wash_vivid">99ffffff</color>   <!-- Vivid (DESIGN 12.3) -->
	<color name="dk_shade_1">ffa6a6a6</color>   <!-- depth shade 1: multiply on overlapping records (crate, spines), M2 music views -->
	<color name="dk_shade_2">ff8c8c8c</color>   <!-- depth shade 2: multiply on overlapping records (crate, spines), M2 music views -->
	<color name="dk_shade_3">ff6e6e6e</color>   <!-- depth shade 3: multiply on overlapping records (crate, spines), M2 music views -->
	<color name="dk_shade_4">ff575757</color>   <!-- depth shade 4: multiply on overlapping records (crate, spines), M2 music views -->
	<color name="dk_shade_5">ff424242</color>   <!-- depth shade 5: multiply on overlapping records (crate, spines), M2 music views -->
	<!-- music playback lane (skin-developer M3, MOTION 3.2): objects that overlap multiply, never alpha -->
	<color name="dk_veil_stage">9effffff</color>   <!-- the room drawn over the Now Playing stage behind Up next (62 %) -->
	<color name="dk_rim_soft">59ffffff</color>     <!-- 35 % rim on the Now Playing sleeve (board B3) -->
	<color name="dk_stack_0">ff999999</color>      <!-- Up next fan, card at depth 0 (0.60 - 0.08 x depth) -->
	<color name="dk_stack_1">ff858585</color>
	<color name="dk_stack_2">ff707070</color>
	<color name="dk_stack_3">ff5c5c5c</color>
	<color name="dk_stack_4">ff474747</color>
	<color name="dk_stack_5">ff333333</color>
	<!-- ===================================================== room tokens: Light (final, visual-designer 2026-10-21, DESIGN.md section 12) -->
	<color name="lt_ground">ffede7dd</color>           <!-- warm paper, not pure white: room_centre (leaves headroom for light) -->
	<color name="lt_ground_edge">ffe3dcd0</color>      <!-- room_edge -->
	<color name="lt_surface">fff7f3ec</color>          <!-- dialog card: lighter paper over the veiled room -->
	<color name="lt_surface_raised">ffe6e0d5</color>   <!-- fallback art block / keys: a sleeve-card tone, reads on paper and card -->
	<color name="lt_ink">f21d1a17</color>              <!-- 95 %: warm near-black ink -->
	<color name="lt_ink2">b81d1a17</color>             <!-- 72 %: >= 4.6:1 over the tinted pool (B11 worst pixel) -->
	<color name="lt_ink3">661d1a17</color>             <!-- 40 % -->
	<color name="lt_ink_faint">1f1d1a17</color>        <!-- 12 %: the big year numeral -->
	<color name="lt_icon_rest">8f1d1a17</color>        <!-- 56 %: 3.6:1 on paper -->
	<color name="lt_header_rest">471d1a17</color>      <!-- 28 % -->
	<color name="lt_rim">9e1d1a17</color>              <!-- 62 %: a 2 px ink keyline (a white rim vanishes on paper) -->
	<color name="lt_line">3b1d1a17</color>             <!-- 23 % -->
	<color name="lt_line_strong">571d1a17</color>      <!-- 34 % -->
	<color name="lt_line_hair">241d1a17</color>        <!-- 14 % -->
	<color name="lt_focus_glow">d9ffffff</color>       <!-- 85 % WHITE: the lamp; lifts the paper toward white under the focused icon -->
	<color name="lt_focus_fill">141d1a17</color>       <!-- 8 % ink where a radial can't sit (keys) -->
	<color name="lt_on_lit">ffede7dd</color>           <!-- paper on an ink fill -->
	<color name="lt_disabled">661d1a17</color>         <!-- 40 % -->
	<color name="lt_text_shadow">00000000</color>      <!-- dark ink on paper casts no text shadow -->
	<color name="lt_shadow">594a3b2c</color>           <!-- 35 % warm umber: shadows on paper are darker paper, not black -->
	<color name="lt_dim_cover">94f0f0f0</color>        <!-- ALPHA 58 % + rgb x0.94: covers fade toward the paper (a multiply muddies them); needs the hollow shadow_square -->
	<color name="lt_dim_stage">8cf0f0f0</color>        <!-- alpha 55 % + rgb x0.94 -->
	<color name="lt_dim_dialog">b3ede7dd</color>       <!-- 70 % paper veil: dims by bleaching -->
	<color name="lt_scrim_soft">8cede7dd</color>       <!-- 55 % paper -->
	<color name="lt_glow_fallback">ffc8ae88</color>    <!-- warm sand: the cast/tint colour when no colour source exists -->

	<color name="lt_art_pool">ccffffff</color>
	<color name="lt_logo_tint">f21d1a17</color>
	<color name="lt_halo">94ffffff</color>
	<color name="lt_ring_fill">0d1d1a17</color>
	<color name="lt_ring_fill_focus">3b1d1a17</color>
	<color name="lt_ring_edge">241d1a17</color>
	<color name="lt_ring_edge_focus">db1d1a17</color>
	<color name="lt_wash_soft">24ffffff</color>
	<color name="lt_wash_medium">38ffffff</color>
	<color name="lt_wash_vivid">52ffffff</color>
	<color name="lt_shade_1">fff2f2f2</color>
	<color name="lt_shade_2">ffe6e6e6</color>
	<color name="lt_shade_3">ffd6d6d6</color>
	<color name="lt_shade_4">ffc7c7c7</color>
	<color name="lt_shade_5">ffb8b8b8</color>
	<color name="lt_veil_stage">8cffffff</color>   <!-- 55 % paper over the stage (MOTION 3.2) -->
	<color name="lt_rim_soft">591d1a17</color>     <!-- 35 % ink keyline -->
	<color name="lt_stack_0">ffe6e6e6</color>      <!-- lighter shade on paper: deepest card FFB8B8B8 (MOTION 3.2) -->
	<color name="lt_stack_1">ffdedede</color>
	<color name="lt_stack_2">ffd6d6d6</color>
	<color name="lt_stack_3">ffcccccc</color>
	<color name="lt_stack_4">ffc2c2c2</color>
	<color name="lt_stack_5">ffb8b8b8</color>
	<!-- ===================================================== static (both rooms) -->
	<color name="white">ffffffff</color>
	<color name="black">ff000000</color>
	<color name="clear">00ffffff</color>
	<color name="ground_static">ff221f1c</color>      <!-- window <backgroundcolor> (takes no $VAR) -->
	<color name="dim_video">a6000000</color>          <!-- scrims over live video: always dark -->
	<color name="white_10">1affffff</color>           <!-- alpha multipliers for art / white masks -->
	<color name="white_20">33ffffff</color>
	<color name="white_30">4dffffff</color>
	<color name="white_40">66ffffff</color>
	<color name="white_45">73ffffff</color>
